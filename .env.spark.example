# Optional Apache Spark settings: merge the required values into .env.local.
# This example is not loaded automatically. Do not overwrite existing credentials.
# Current bounded jobs execute synchronously in the dedicated pipeline service;
# the Spark session is initialized lazily, not in unrelated API services.
DEPO_SPARK_ENABLED=false
# Optional read-side integration. Neo4j Spark connector 6.0 requires Spark
# 4.0–4.1 and Scala 2.13. Use the official coordinate below only with that
# supported runtime; do not put credentials in source control.
DEPO_SPARK_NEO4J_ENABLED=false
DEPO_SPARK_NEO4J_PACKAGE=org.neo4j.connectors:spark:6.0.0-s_2.13
DEPO_HADOOP_HOME=D:\DEPO\runtime\hadoop
NEO4J_URI=
NEO4J_USER=
NEO4J_PASS=
NEO4J_DATABASE=ontology
DEPO_SPARK_HOME=D:\DEPO\runtime\spark-4.1.2-bin-hadoop3
DEPO_JAVA_HOME=D:\DEPO\runtime\jdk-21\jdk-21.0.12.1+1
DEPO_SPARK_MASTER=local[2]
DEPO_SPARK_OUTPUT_ROOT=D:\DEPO\data\spark
CEIM_SERVICE_URL=http://127.0.0.1:8018/api/v1
