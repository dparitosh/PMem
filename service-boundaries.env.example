# Root deployment manifest for the DEPO runtime boundaries.
# Copy this to `service-boundaries.env` and edit the values for the target machine.

# Backend API service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend UI service
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# Browser-facing host name or IP
APP_HOST=127.0.0.1
PREPARE_NEO4J_INDEXES_ON_STARTUP=true

# Frontend-to-backend binding
REACT_APP_BACKEND_URL=http://127.0.0.1:8000

# Browser origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change_me
NEO4J_DATABASE=neo4j
OLLAMA_BASE_URL=http://localhost:11434
