# Root deployment manifest for the DEPO runtime boundaries.
# Copy this to `service-boundaries.env` and edit the values for the target machine.

# Backend API service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend UI service
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_PORTS=3000

# Browser-facing host name or IP
APP_HOST=127.0.0.1
PREPARE_NEO4J_INDEXES_ON_STARTUP=true

# Frontend-to-backend binding
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
# Optional APIM gateway for new standalone semantic-service UI calls. Existing
# pages stay on BACKEND_URL until their legacy route is migrated and tested.
REACT_APP_API_GATEWAY_URL=
REACT_APP_ONTOLOGY_SERVICE_URL=
REACT_APP_GRAPH_SERVICE_URL=
REACT_APP_INGESTION_SERVICE_URL=
REACT_APP_OSLC_SERVICE_URL=

# Optional ontology-agentic service. Enable only when the service is deployed.
REACT_APP_AGENTIC_ENABLED=false
REACT_APP_AGENTIC_SERVICE_URL=http://127.0.0.1:8012

# OpenAPI-first semantic service boundaries. These do not require Redis/Celery.
ONTOLOGY_SERVICE_URL=http://127.0.0.1:8011/api/v1
GRAPH_SERVICE_URL=http://127.0.0.1:8013/api/v1
INGESTION_SERVICE_URL=http://127.0.0.1:8014/api/v1
OSLC_SERVICE_URL=http://127.0.0.1:8015
OSLC_ENABLED=true
OSLC_TRS_ENABLED=true
# Optional configured peer. The outbound client never accepts arbitrary hosts.
OSLC_REMOTE_BASE_URL=
OSLC_REMOTE_TOKEN=
OSLC_CLIENT_TIMEOUT_SECONDS=20
OSLC_SYNC_STORAGE=data/oslc_service/syncs
# QIF always publishes through the OpenAPI ontology and graph services.
QIF_PUBLISH_MODE=services
SERVICE_REQUEST_TIMEOUT_SECONDS=30

# Browser origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for destructive /api/v1/admin operations
ADMIN_API_KEY=replace-with-a-long-random-secret

# Maximum request upload sizes
MAX_IMPORT_UPLOAD_BYTES=524288000
MAX_3DXML_FILE_SIZE=524288000

# External services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change_me
NEO4J_DATABASE=neo4j
OLLAMA_BASE_URL=http://localhost:11434
# Isolated local development only. Production should use false/true respectively.
SANDBOX_MODE=true
NEO4J_TLS_VERIFY=false
