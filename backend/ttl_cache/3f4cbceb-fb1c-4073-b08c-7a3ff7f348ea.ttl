step:entityType a owl:DatatypeProperty ;
    rdfs:label "STEP entity type" ;
    rdfs:domain step:Entity ;
    rdfs:range xsd:string .

step:fileSchema a owl:DatatypeProperty ;
    rdfs:label "STEP file schema" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

step:mapsToAp242BusinessObjectClass a owl:ObjectProperty ;
    rdfs:label "maps to AP242 business object class" ;
    rdfs:comment "Alignment from AP242 AIM/STEP entity classes to AP242 MBD business-object data model classes." ;
    rdfs:domain owl:Class ;
    rdfs:range owl:Class .

step:rawArgs a owl:DatatypeProperty ;
    rdfs:label "raw STEP arguments" ;
    rdfs:domain step:Entity ;
    rdfs:range xsd:string .

step:references a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:comment "Preserves STEP #id references as RDF object edges for traceability and graph traversal." ;
    rdfs:domain step:Entity ;
    rdfs:range step:Entity .

step:representsStepEntity a owl:ObjectProperty ;
    rdfs:label "represents STEP entity" ;
    rdfs:domain owl:Thing ;
    rdfs:range step:Entity .

step:sourceFormat a owl:DatatypeProperty ;
    rdfs:label "STEP source format" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

step:stepId a owl:DatatypeProperty ;
    rdfs:label "STEP id" ;
    rdfs:domain step:Entity ;
    rdfs:range xsd:integer .

pmi:Datum a owl:Class ;
    rdfs:label "Datum" ;
    rdfs:subClassOf step:Entity .

