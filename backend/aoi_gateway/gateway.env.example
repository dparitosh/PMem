# Separate gateway process only. Never commit the filled file.
AOI_GATEWAY_TOKEN=<generate-a-private-random-token-at-least-32-characters>
AOI_WRAPPER_DIR=E:/App/PMem/data/aoi-gateway/vendor
AOI_USERNAME=<customer-AOI-username>
AOI_PASSWORD=<customer-AOI-password>
# Public aliases used by PMem, not user-supplied deployment names.
AOI_MODEL=aoi-chat
AOI_EMBED_MODEL=aoi-embedding
# Confirm these existing IIF sample deployment names with your AOI operator.
AOI_LLM_MODEL_NAME=gpt-4o
AOI_LLM_DEPLOYMENT=DevelopementAndTestingGPT4oLLM
AOI_EMBED_MODEL_NAME=text-embedding-ada-002
AOI_EMBED_DEPLOYMENT=DevelopementAndTestingEmbedder
AOI_EMBEDDING_DIMENSIONS=1536
AOI_REQUEST_TIMEOUT_SECONDS=45
AOI_STARTUP_TIMEOUT_SECONDS=45
