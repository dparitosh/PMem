# ========== ON-PREMISES NEO4J CONFIGURATION TEMPLATE ==========
# Use this template to configure the application for on-premises Neo4j deployment
# Replace all values marked with YOUR_* with your actual credentials

# ============================================================
# PRIMARY NEO4J CONFIGURATION (REQUIRED)
# ============================================================

# For on-premises with TLS (Recommended for Enterprise):
# NEO4J_URI=bolt+s://your-server-ip:7687
# 
# For on-premises without TLS (Community Edition):
# NEO4J_URI=bolt://localhost:7687
# 
# For on-premises with non-standard port:
# NEO4J_URI=bolt://192.168.1.100:7688

NEO4J_URI=bolt://localhost:7687

# Authentication Credentials
NEO4J_USER=neo4j
NEO4J_PASS=YOUR_ACTUAL_PASSWORD_HERE

# Database Name - CRITICAL!
# Find your actual database name by running in Neo4j Browser:
#   SHOW DATABASES;
# Common names: neo4j, spdms, production
# DEFAULT: neo4j

NEO4J_DATABASE=neo4j

# ============================================================
# TLS/ENCRYPTION SETTINGS
# ============================================================

# Set to true if using bolt+s:// or self-signed certificates
# Set to false if using bolt:// without encryption
NEO4J_ENCRYPTED=false

# For self-signed certificates, set this to false
NEO4J_TRUST_SYSTEM_CA=false

# Optional: Path to custom CA certificate (for self-signed)
# NEO4J_CUSTOM_CA_PATH=/etc/neo4j/ca-cert.pem

# ============================================================
# CONNECTION POOL CONFIGURATION
# ============================================================

# Maximum number of connections in pool (default: 50)
# Increase for high-concurrency scenarios
NEO4J_MAX_POOL_SIZE=50

# Connection acquisition timeout in seconds (default: 60)
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# Socket connection timeout in seconds (default: 30)
NEO4J_CONNECTION_TIMEOUT=30

# Keep-alive socket connections (default: true)
NEO4J_SOCKET_KEEP_ALIVE=true

# Socket connection timeout in seconds (default: 15)
NEO4J_SOCKET_CONNECTION_TIMEOUT=15

# Query execution timeout in seconds (default: 30)
# Increase if you have long-running queries
NEO4J_QUERY_TIMEOUT=30

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Frontend CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000

# Ontology storage directory
ONTOLOGY_STORAGE_DIR=./ontology_uploads

# ============================================================
# OLLAMA LLM CONFIGURATION (OPTIONAL)
# ============================================================

# Set to 'ollama' for local Ollama instance
USE_LLM=ollama

# Ollama API endpoint
# For local: http://localhost:11434
# For remote: http://192.168.1.100:11434
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Ollama API key (if required)
OLLAMA_API_KEY=

# Model name (common: llama2, llama3, mistral)
LLM_MODEL_NAME=llama3

# Chat execution timeouts for Ollama/APIM-backed answers
CHAT_REQUEST_TIMEOUT_SECONDS=900
CHAT_STREAM_TIMEOUT_SECONDS=900
CHAT_JOB_TTL_SECONDS=3600
CHAT_JOB_MAX_COUNT=200
SESSION_LOCK_TIMEOUT_SECONDS=30

# Embedding model name
EMBED_MODEL_NAME=nomic-embed-text:latest

# ============================================================
# AZURE OPENAI CONFIGURATION (ALTERNATIVE TO OLLAMA)
# ============================================================

# Leave empty if using Ollama instead
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional OSLC interoperability
OSLC_ENABLED=true
OSLC_BASE_URL=http://localhost:8000
OSLC_PROVIDER_ID=depo
OSLC_PROVIDER_TITLE=DEPO Semantic Platform
OSLC_MAX_PAGE_SIZE=200
OSLC_TRS_ENABLED=true

# ============================================================
# FEATURES STATUS (Do NOT Enable)
# ============================================================

# Digital Thread Tracer has been disabled due to Neo4j compatibility issues
# DO NOT enable: ENABLE_DIGITAL_THREAD_TRACER
# This feature is incompatible with on-premises deployments

# ============================================================
# VERIFICATION CHECKLIST
# ============================================================
# Before starting the application:
#
# [ ] NEO4J_URI is reachable (test: telnet hostname 7687)
# [ ] NEO4J_USER and NEO4J_PASS are correct
# [ ] NEO4J_DATABASE exists (run: SHOW DATABASES;)
# [ ] Neo4j service is running (check: systemctl status neo4j)
# [ ] Firewall allows port 7687 (or your custom port)
# [ ] No "trace" or other hardcoded database references
#
# ============================================================
