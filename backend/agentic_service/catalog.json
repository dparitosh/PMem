{
  "agents": [
    {"id": "ontology-intake", "name": "Ontology Intake", "tools": ["engineering.inspect", "ontology.generate", "ontology.agent.intake"], "approval_required": false, "system_prompt": "Inspect only the selected RDF/OWL artifact. Return factual counts and parser warnings. Never infer missing semantics or mutate data."},
    {"id": "ontology-structure-review", "name": "Ontology Structure Review", "tools": ["ontology.agent.review"], "approval_required": false, "system_prompt": "Review only observable ontology structure. Report machine-readable issues. Do not fabricate axioms, recommendations, approvals, or writes."},
    {"id": "semantic-bridge-planner", "name": "Semantic Bridge Planner", "tools": ["ontology.agent.bridge-plan"], "approval_required": false, "system_prompt": "Prepare a review-only mapping plan from supplied metadata. Keep entity, attribute, relationship, and metadata counts separate. Never approve or publish mappings."},
    {"id": "ontology-export", "name": "Ontology Export", "tools": ["ontology.export"], "approval_required": true, "system_prompt": "Export only after the existing human approval contract is satisfied. Do not alter ontology semantics."},
    {"id": "ontology-orchestrator", "name": "Ontology Orchestrator", "tools": ["ontology.agent.orchestrate"], "approval_required": false, "system_prompt": "Run intake, structural review, and Bridge planning in order. Preserve evidence. Stop before approval or publication."},
    {"id": "context-analyst", "name": "Business Context Analyst", "tools": ["context.upsert", "context.search", "context.where_used"], "approval_required": false},
    {"id": "ontology-governor", "name": "Ontology Governor", "tools": ["ontology.register", "ontology.transition", "ontology.export", "ontology.merge.preview", "ontology.merge.apply", "engineering.publish"], "approval_required": true},
    {"id": "engineering-parser", "name": "Engineering Parser", "tools": ["engineering.inspect", "profile.inspect", "profile.execute"], "approval_required": false},
    {"id": "graph-analyst", "name": "Graph Analyst", "tools": ["graph.analytics", "graph.neighborhood", "context.search", "context.where_used", "oslc.graph_rag"], "approval_required": false},
    {"id": "oslc-link-agent", "name": "OSLC Link Agent", "tools": ["oslc.remote.catalog", "oslc.remote.query", "oslc.remote.sync"], "approval_required": false},
    {"id": "schema-set-agent", "name": "Engineering Schema-Set Agent", "tools": ["schema-set.standards", "schema-set.upload", "qif.task.status", "qif.task.commit"], "approval_required": false},
    {"id": "data-product-governor", "name": "Data Product Governor", "tools": ["data.catalog.products", "data.product.preview", "data.product.publish"], "approval_required": true},
    {"id": "ceim-mapper", "name": "CEIM Mapper", "tools": ["ceim.contract", "ceim.normalize.batch"], "approval_required": false},
    {"id": "data-quality-monitor", "name": "Data Quality Monitor", "tools": ["pipeline.telemetry", "pipeline.transform"], "approval_required": false}
  ],
  "tools": [
    {"id": "ontology.register", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/register", "mutates": true, "input_kind": "multipart"},
    {"id": "ontology.transition", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/{ontology_id}/transition", "mutates": true},
    {"id": "ontology.export", "transport": "openapi", "service": "ingestion", "method": "GET", "path": "/ontology/{ontology_id}/export", "mutates": false},
    {"id": "oslc.graph_rag", "transport": "openapi", "service": "agentic", "method": "POST", "path": "/oslc/graph-rag", "mutates": false},
    {"id": "ontology.generate", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/generate", "mutates": false},
    {"id": "ontology.merge.preview", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/merges/preview", "mutates": false},
    {"id": "ontology.merge.apply", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/merges/{preview_id}/apply", "mutates": true},
    {"id": "context.upsert", "transport": "openapi", "service": "ontology", "method": "POST", "path": "/ontologies/business-context/objects", "mutates": true},
    {"id": "context.search", "transport": "openapi", "service": "ontology", "method": "GET", "path": "/ontologies/business-context/search", "mutates": false},
    {"id": "context.where_used", "transport": "openapi", "service": "ontology", "method": "GET", "path": "/ontologies/business-context/objects/{object_id}/where-used", "mutates": false},
    {"id": "engineering.inspect", "transport": "openapi", "service": "ingestion", "method": "POST", "path": "/schema-conversions/inspect", "mutates": false, "input_kind": "multipart"},
    {"id": "engineering.publish", "transport": "openapi", "service": "ingestion", "method": "POST", "path": "/engineering-workflows", "mutates": true, "input_kind": "multipart"}
    ,{"id": "profile.inspect", "transport": "openapi", "service": "ingestion", "method": "POST", "path": "/source-profiles/inspect", "mutates": false, "input_kind": "multipart"}
    ,{"id": "profile.execute", "transport": "openapi", "service": "ingestion", "method": "POST", "path": "/source-profiles/{profile_id}/execute", "mutates": false, "input_kind": "multipart"}
    ,{"id": "graph.analytics", "transport": "openapi", "service": "graph", "method": "GET", "path": "/graph/ontologies/{ontology_id}/analytics", "mutates": false}
    ,{"id": "graph.neighborhood", "transport": "openapi", "service": "graph", "method": "GET", "path": "/graph/ontologies/{ontology_id}/neighborhood", "mutates": false}
    ,{"id": "oslc.remote.catalog", "transport": "openapi", "service": "oslc", "method": "GET", "path": "/oslc/remote/catalog", "mutates": false}
    ,{"id": "oslc.remote.query", "transport": "openapi", "service": "oslc", "method": "POST", "path": "/oslc/remote/query/{resource_type}", "mutates": false}
    ,{"id": "oslc.remote.sync", "transport": "openapi", "service": "oslc", "method": "POST", "path": "/oslc/remote/sync/{resource_type}", "mutates": true}
    ,{"id": "qif.catalog", "transport": "openapi", "service": "qif", "method": "GET", "path": "/qif/catalog", "mutates": false}
    ,{"id": "qif.reference.task", "transport": "openapi", "service": "qif", "method": "POST", "path": "/qif/tasks/reference", "mutates": false, "input_kind": "form"}
    ,{"id": "qif.task.status", "transport": "openapi", "service": "qif", "method": "GET", "path": "/qif/tasks/{task_id}", "mutates": false}
    ,{"id": "qif.task.commit", "transport": "openapi", "service": "qif", "method": "POST", "path": "/qif/tasks/{task_id}/commit", "mutates": true}
    ,{"id": "schema-set.standards", "transport": "openapi", "service": "qif", "method": "GET", "path": "/qif/schema-sets/standards", "mutates": false}
    ,{"id": "schema-set.upload", "transport": "openapi", "service": "qif", "method": "POST", "path": "/qif/schema-sets/upload", "mutates": false, "input_kind": "multipart"}
    ,{"id": "data.catalog.products", "transport": "openapi", "service": "catalog", "method": "GET", "path": "/catalog/products", "mutates": false}
    ,{"id": "data.product.preview", "transport": "openapi", "service": "data_products", "method": "POST", "path": "/data-products/preview", "mutates": false}
    ,{"id": "data.product.publish", "transport": "openapi", "service": "data_products", "method": "POST", "path": "/data-products/publish", "mutates": true}
    ,{"id": "ceim.contract", "transport": "openapi", "service": "ceim", "method": "GET", "path": "/ceim/contract", "mutates": false}
    ,{"id": "ceim.normalize.batch", "transport": "openapi", "service": "ceim", "method": "POST", "path": "/ceim/normalize/batch", "mutates": false}
    ,{"id": "pipeline.telemetry", "transport": "openapi", "service": "data_pipeline", "method": "GET", "path": "/pipeline/telemetry", "mutates": false}
    ,{"id": "pipeline.transform", "transport": "openapi", "service": "data_pipeline", "method": "POST", "path": "/pipeline/jobs/transform", "mutates": true}
    ,{"id": "ontology.agent.orchestrate", "transport": "openapi", "service": "agentic", "method": "POST", "path": "/ontology-agents/orchestrate", "mutates": false}
    ,{"id": "ontology.agent.intake", "transport": "openapi", "service": "agentic", "method": "POST", "path": "/ontology-agents/intake", "mutates": false}
    ,{"id": "ontology.agent.review", "transport": "openapi", "service": "agentic", "method": "POST", "path": "/ontology-agents/review", "mutates": false}
    ,{"id": "ontology.agent.bridge-plan", "transport": "openapi", "service": "agentic", "method": "POST", "path": "/ontology-agents/bridge-plan", "mutates": false}
  ],
  "mcp_servers": [
    {"id": "semantica", "transport": "stdio", "command": "python", "args": ["-m", "semantica.mcp_server"], "environment": ["SEMANTICA_KG_PATH"], "operations": ["ontology", "reasoning", "validation"]}
  ],
  "workflows": [
    {"id": "engineering-governed-publish", "name": "Engineering schema to governed ontology", "steps": [
      {"agent_id": "ontology-intake", "tool_id": "engineering.inspect"},
      {"agent_id": "ontology-governor", "tool_id": "engineering.publish", "approval_required": true}
    ]},
    {"id": "business-context-enrichment", "name": "Business object context enrichment", "steps": [
      {"agent_id": "context-analyst", "tool_id": "context.upsert"},
      {"agent_id": "context-analyst", "tool_id": "context.where_used"}
    ]},
    {"id": "ontology-review-and-bridge-plan", "name": "Ontology intake, structure review and Semantic Bridge planning", "steps": [
      {"agent_id": "ontology-orchestrator", "tool_id": "ontology.agent.orchestrate"}
    ]}
  ]
}
