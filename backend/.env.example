# Backend service binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Settings
# Add the deployed frontend origin for customer or cloud VM access.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://<frontend-host>:3000

# ========== NEO4J DATABASE CONFIGURATION ==========
# Supports Neo4j Aura and on-prem Neo4j through the official Python driver.
# URI examples:
#   Neo4j Aura:                neo4j+s://<instance>.databases.neo4j.io
#   On-prem Enterprise TLS:    bolt+s://<host>:7687
#   On-prem Community no TLS:  bolt://<host>:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change_me
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_QUERY_TIMEOUT=300
NEO4J_ENCRYPTED=false
NEO4J_TRUST_SYSTEM_CA=true
# NEO4J_CUSTOM_CA_PATH=/path/to/ca-cert.pem

# Ontology Storage Configuration
# Leave empty to use default: {project_root}/ontology_uploads
ONTOLOGY_STORAGE_DIR=

# ========== CORE LLM / EMBEDDING CONFIGURATION ==========
# Values: ollama or azure
USE_LLM=ollama
USE_EMBEDDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
LLM_MODEL_NAME=mistral
EMBED_MODEL_NAME=nomic-embed-text:latest
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=
AZURE_OPENAI_EMBEDDINGS_VERSION=

# ========== UNSTRUCTURED / DOCUMENT LLM CONFIGURATION ==========
USE_UNSTRUCTURED_LLM=false
UNSTRUCTURED_LLM_TYPE=azure
UNSTRUCTURED_APIM_ENDPOINT=
UNSTRUCTURED_APIM_SUBSCRIPTION_KEY=
UNSTRUCTURED_APIM_API_VERSION=2024-02-15-preview
UNSTRUCTURED_AZURE_OPENAI_ENDPOINT=
UNSTRUCTURED_AZURE_OPENAI_API_KEY=
UNSTRUCTURED_AZURE_OPENAI_DEPLOYMENT=gpt-4-vision
UNSTRUCTURED_AZURE_OPENAI_API_VERSION=2024-02-15-preview
UNSTRUCTURED_OLLAMA_BASE_URL=http://localhost:11434
UNSTRUCTURED_OLLAMA_API_KEY=
UNSTRUCTURED_LLM_MODEL_NAME=llava:7b

# ========== GRAPH / DOCUMENT EMBEDDING INDEXES ==========
NEO4J_EMBEDDING_INDEX=graph_embeddings
NEO4J_GRAPH_VECTOR_INDEX=graph_embedding
NEO4J_GRAPH_KEYWORD_INDEX=keyword_index
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_TOKENS=512
EMBEDDING_MAX_RELS=40
NEO4J_DOCUMENT_INDEX=datasheet_index
NEO4J_DOCUMENT_NODE_LABEL=DocumentChunk
PDF_ZOOM_LEVEL=2.0
WORD_PAGE_WIDTH=800
PPT_SLIDE_DPI=150
DOCUMENT_CHUNK_SIZE=400
DOCUMENT_CHUNK_OVERLAP=50
DOCUMENT_TEMP_DIR=temp_documents
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# Optional domain model path
AP242_DOMAIN_MODEL_PATH=
# Optional OSLC interoperability
OSLC_ENABLED=true
OSLC_BASE_URL=http://localhost:8000
OSLC_PROVIDER_ID=depo
OSLC_PROVIDER_TITLE=DEPO Semantic Platform
OSLC_MAX_PAGE_SIZE=200
OSLC_TRS_ENABLED=true

