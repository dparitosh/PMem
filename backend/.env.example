# Service boundary defaults
# Backend and frontend are started independently like separate services.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_HOST=127.0.0.1

# Index creation runs after the API is available, so startup does not wait for Neo4j.
# Set false when indexes are managed centrally by an administrator.
PREPARE_NEO4J_INDEXES_ON_STARTUP=true

# CORS Settings
# Add the deployed frontend origin for customer or cloud VM access.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://<frontend-host>:3000

# ========== NEO4J DATABASE CONFIGURATION ==========
# Supports Neo4j Aura and on-prem Neo4j through the official Python driver.
# URI examples:
#   Neo4j Aura:                neo4j+s://<instance>.databases.neo4j.io
#   On-prem Enterprise TLS:    bolt+s://<host>:7687
#   On-prem Community no TLS:  bolt://<host>:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=change_me
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_QUERY_TIMEOUT=300
NEO4J_ENCRYPTED=false
# Local sandbox only. Keep certificate verification enabled outside isolated development.
SANDBOX_MODE=true
NEO4J_TLS_VERIFY=false
NEO4J_TRUST_SYSTEM_CA=true
# NEO4J_CUSTOM_CA_PATH=/path/to/ca-cert.pem

# Ontology Storage Configuration
# Leave empty to use default: {project_root}/ontology_uploads
ONTOLOGY_STORAGE_DIR=

# ========== CORE LLM / EMBEDDING CONFIGURATION ==========
# Values: ollama or azure
USE_LLM=ollama
USE_EMBEDDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
LLM_MODEL_NAME=mistral

# Chat execution timeouts for Ollama/APIM-backed answers
CHAT_REQUEST_TIMEOUT_SECONDS=900
CHAT_STREAM_TIMEOUT_SECONDS=900
CHAT_JOB_TTL_SECONDS=3600
CHAT_JOB_MAX_COUNT=200
SESSION_LOCK_TIMEOUT_SECONDS=30
EMBED_MODEL_NAME=nomic-embed-text:latest

# ========== GRAPH-NATIVE AGENT MEMORY ==========
# Optional durable memory inspired by neo4j-labs/agent-memory.
# Disabled by default so customer releases do not persist chat/mapping memory
# until the operator explicitly enables it.
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_SCOPE=project
AGENT_MEMORY_QUERY_TIMEOUT=5
# Defaults to the same Neo4j database if left blank.
AGENT_MEMORY_NEO4J_DATABASE=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=
AZURE_OPENAI_EMBEDDINGS_VERSION=

# ========== UNSTRUCTURED / DOCUMENT LLM CONFIGURATION ==========
USE_UNSTRUCTURED_LLM=false
UNSTRUCTURED_LLM_TYPE=azure
UNSTRUCTURED_APIM_ENDPOINT=
UNSTRUCTURED_APIM_SUBSCRIPTION_KEY=
UNSTRUCTURED_APIM_API_VERSION=2024-02-15-preview
UNSTRUCTURED_AZURE_OPENAI_ENDPOINT=
UNSTRUCTURED_AZURE_OPENAI_API_KEY=
UNSTRUCTURED_AZURE_OPENAI_DEPLOYMENT=gpt-4-vision
UNSTRUCTURED_AZURE_OPENAI_API_VERSION=2024-02-15-preview
UNSTRUCTURED_OLLAMA_BASE_URL=http://localhost:11434
UNSTRUCTURED_OLLAMA_API_KEY=
UNSTRUCTURED_LLM_MODEL_NAME=llava:7b

# ========== GRAPH / DOCUMENT EMBEDDING INDEXES ==========
NEO4J_EMBEDDING_INDEX=graph_embeddings
NEO4J_GRAPH_VECTOR_INDEX=graph_embedding
NEO4J_GRAPH_KEYWORD_INDEX=keyword_index
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_TOKENS=512
EMBEDDING_MAX_RELS=40
NEO4J_DOCUMENT_INDEX=datasheet_index
NEO4J_DOCUMENT_NODE_LABEL=DocumentChunk
PDF_ZOOM_LEVEL=2.0
WORD_PAGE_WIDTH=800
PPT_SLIDE_DPI=150
DOCUMENT_CHUNK_SIZE=400
DOCUMENT_CHUNK_OVERLAP=50
DOCUMENT_TEMP_DIR=temp_documents
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# Optional domain model path
AP242_DOMAIN_MODEL_PATH=
# Optional OSLC interoperability
OSLC_ENABLED=true
OSLC_BASE_URL=http://localhost:8000
OSLC_PROVIDER_ID=depo
OSLC_PROVIDER_TITLE=DEPO Semantic Platform
OSLC_MAX_PAGE_SIZE=200
OSLC_TRS_ENABLED=true

# ========== MICROSERVICE / INTEROPERABILITY CONFIGURATION ==========
# Use private HTTPS URLs in a deployed environment.  The ingestion service
# calls these boundaries; it never imports their application internals.
ONTOLOGY_SERVICE_URL=http://127.0.0.1:8011/api/v1
GRAPH_SERVICE_URL=http://127.0.0.1:8013/api/v1
INGESTION_SERVICE_URL=http://127.0.0.1:8014/api/v1
OSLC_SERVICE_URL=http://127.0.0.1:8015/api/v1
QIF_SERVICE_URL=http://127.0.0.1:8010/api/v1
DATA_CATALOG_URL=http://127.0.0.1:8016/api/v1
DATA_PRODUCT_SERVICE_URL=http://127.0.0.1:8017/api/v1
DATA_PRODUCT_ALLOWED_ARTIFACT_ROOTS=
DATA_PRODUCT_APPROVAL_TOKEN=
AGENTIC_APPROVAL_TOKEN=
AGENTIC_CATALOG_PATH=
AGENTIC_TOOL_TIMEOUT_SECONDS=30
AGENTIC_MAX_UPLOAD_BYTES=26214400
SERVICE_REQUEST_TIMEOUT_SECONDS=30
ONTOLOGY_SERVICE_STORAGE=

# Optional outbound OSLC peer.  Keep this blank until a trusted peer and a
# least-privilege bearer token are provisioned.
OSLC_REMOTE_BASE_URL=
OSLC_REMOTE_TOKEN=
OSLC_CLIENT_TIMEOUT_SECONDS=20

# Select the only graph store that has a configured, supported write adapter.
# Neo4j uses Bolt/Cypher today.  Oracle and RapidMiner are configuration-ready
# but deliberately stay write-disabled until their canonical provider adapter
# and authenticated endpoint contract are supplied.
SEMANTIC_GRAPH_PROVIDER=neo4j
RAPIDMINER_SEMANTIC_GRAPH_URL=
RAPIDMINER_USER=
RAPIDMINER_TOKEN=
RAPIDMINER_SEMANTIC_GRAPH_DATABASE=
ORACLE_SEMANTIC_GRAPH_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SEMANTIC_GRAPH_MODEL=

