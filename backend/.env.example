# ========== NEO4J DATABASE CONFIGURATION ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your-password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

# ========== MAIN LLM CONFIGURATION (Chat, Reasoning, Tool Calling) ==========
# Set to "azure" or "ollama"
USE_LLM=ollama
USE_EMBEDDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
LLM_MODEL_NAME=llama3:latest
EMBED_MODEL_NAME=nomic-embed-text:latest

# Azure OpenAI Configuration (Main LLM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=
AZURE_OPENAI_EMBEDDINGS_VERSION=2024-02-15-preview

# ========== NEO4J VECTOR INDEX CONFIGURATION ==========
NEO4J_EMBEDDING_INDEX=graph_embeddings
NEO4J_GRAPH_VECTOR_INDEX=graph_embedding
NEO4J_GRAPH_KEYWORD_INDEX=keyword_index
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_TOKENS=512
EMBEDDING_MAX_RELS=40

# ========== UNSTRUCTURED/DOCUMENT LLM CONFIGURATION ==========
# Use a separate LLM for document processing (vision-capable model)
# This allows different models for documents vs. tool-calling
# Set to true if you want different LLM for documents than core LLM
USE_UNSTRUCTURED_LLM=false
UNSTRUCTURED_LLM_TYPE=azure

# APIM Gateway for Document Processing (Azure API Management - RECOMMENDED)
# Routes through unified APIM endpoint with governance and rate limiting
UNSTRUCTURED_APIM_ENDPOINT=https://your-apim.azure-api.net/your-deployment
UNSTRUCTURED_APIM_SUBSCRIPTION_KEY=your-subscription-key
UNSTRUCTURED_APIM_API_VERSION=2024-02-15-preview

# Fallback: Direct Azure OpenAI for Document Processing (if APIM not used)
# Only used if UNSTRUCTURED_APIM_ENDPOINT is not configured
UNSTRUCTURED_AZURE_OPENAI_ENDPOINT=
UNSTRUCTURED_AZURE_OPENAI_API_KEY=
UNSTRUCTURED_AZURE_OPENAI_DEPLOYMENT=gpt-4-vision
UNSTRUCTURED_AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Ollama for Document Processing (vision model like llava)
# Example: llava:7b, llava:13b (must have vision capability)
UNSTRUCTURED_OLLAMA_BASE_URL=http://localhost:11434
UNSTRUCTURED_OLLAMA_API_KEY=
UNSTRUCTURED_LLM_MODEL_NAME=llava:7b

# ========== DOCUMENT PIPELINE CONFIGURATION ==========
NEO4J_DOCUMENT_INDEX=datasheet_index
NEO4J_DOCUMENT_NODE_LABEL=DocumentChunk
DOCUMENT_CHUNK_SIZE=400           # Characters per chunk
DOCUMENT_CHUNK_OVERLAP=50         # Overlap between chunks
DOCUMENT_TEMP_DIR=temp_documents  # Temporary file storage

# Format-Specific Configuration
PDF_ZOOM_LEVEL=2.0              # Image zoom for PDF pages (1.0-3.0)
WORD_PAGE_WIDTH=800             # Image width for Word documents
PPT_SLIDE_DPI=150               # Image DPI for PowerPoint slides

# ========== DOCUMENT UPLOAD CONSTRAINTS ==========
MAX_FILE_SIZE_MB=50              # Maximum file size (MB)
MAX_FILES_PER_UPLOAD=10          # Maximum files per batch
