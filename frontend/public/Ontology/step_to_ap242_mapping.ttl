    rr:class ap242:PartView
  ] ;
  
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "representation_id" ]
  ] .

# TripleMap 4: MAPPED_ITEM → AP242 Occurrence
<#OccurrenceTripleMap>
  rml:logicalSource [
    rml:source "step_entities.ttl" ;
    rml:iterator "//*[entity_type='MAPPED_ITEM']"
  ] ;
  
  rr:subjectMap [
    rr:template "http://example.org/ap242/occurrence/{entity_id}" ;
    rr:class ap242:Occurrence
  ] ;
  
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "item_id" ]
  ] .