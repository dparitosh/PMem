## Use one gateway URL in customer environments.  For local development the
## service URLs below default to 127.0.0.1:8010–8019 when omitted.
VITE_API_GATEWAY_URL=
# VITE_QIF_SERVICE_URL=http://127.0.0.1:8010
# VITE_ONTOLOGY_SERVICE_URL=http://127.0.0.1:8011
# VITE_AGENTIC_SERVICE_URL=http://127.0.0.1:8012
# VITE_GRAPH_SERVICE_URL=http://127.0.0.1:8013
# VITE_INGESTION_SERVICE_URL=http://127.0.0.1:8014
# VITE_OSLC_SERVICE_URL=http://127.0.0.1:8015
# VITE_CATALOG_SERVICE_URL=http://127.0.0.1:8016
# VITE_DATA_PRODUCT_SERVICE_URL=http://127.0.0.1:8017
# VITE_DATA_PIPELINE_SERVICE_URL=http://127.0.0.1:8019
# VITE_BACKEND_URL=  # Legacy aggregate API only; leave empty for service topology.
# Optional low-code/no-code ontology agent component adapter
REACT_APP_AGENTIC_ENABLED=false
REACT_APP_AGENTIC_SERVICE_URL=http://127.0.0.1:8012
# Set VITE_API_GATEWAY_URL when using a LAN IP, cloud VM, reverse proxy, or
# customer API Management gateway. Configure this before building the frontend.
REACT_APP_API_VERSION=v1
REACT_APP_ENV=development
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
REACT_APP_REQUEST_TIMEOUT=900000
REACT_APP_SIRIUS_WEB_URL=http://localhost:8080
