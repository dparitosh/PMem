# ========== BACKEND SERVER CONFIGURATION ==========
# Backend API base URL - Change this based on your deployment environment
REACT_APP_BACKEND_URL=http://localhost:8000
# API version to use (v1 is current)
REACT_APP_API_VERSION=v1
# Neo4j database connection (optional, for graph features)
REACT_APP_NEO4J_URL=bolt://localhost:7687

# ========== HEALTH & STATUS ENDPOINTS ==========
# Health check endpoint
REACT_APP_API_HEALTH=/health
# Readiness check endpoint
REACT_APP_API_READY=/ready
REACT_APP_API_GRAPH_METRICS=/graph-metrics
REACT_APP_API_ONTOLOGIES_AVAILABLE=/ontologies/available
REACT_APP_API_NEO4J_HEALTH=/health/neo4j

# ========== CORE GRAPH ENDPOINTS ==========
# Get entire graph data for visualization
REACT_APP_API_GRAPHVIS=/graphvis
# Filter graph by text search
REACT_APP_API_GRAPHFILTER=/graphfilter
# Multi-criteria graph filtering
REACT_APP_API_GRAPHFILTER_MULTI=/graphfilter-multi
# Traverse graph from a specific node
REACT_APP_API_GRAPHTRAVERSE=/graphtraverse
REACT_APP_API_GRAPHTRAVERSE_NODE=/graphtraverse/{node_id}
REACT_APP_API_COMPARATIVE_SEARCH=/comparative-search
REACT_APP_API_SCHEMA_GRAPH=/schema-graph
REACT_APP_API_INSTANCE_GRAPH=/instance-graph
REACT_APP_API_STEP_PARTS=/ontology/step/parts
REACT_APP_API_ONTOLOGY_GRAPH=/ontology/{ontology}
REACT_APP_API_ONTOLOGY_GRAPH_BY_TYPE=/ontology/{ontology_type}
REACT_APP_API_ONTOLOGY_INSTANCES=/ontology/{ontology}/instances
REACT_APP_API_ONTOLOGY_INSTANCES_BY_TYPE=/ontology/{ontology_type}/instances
REACT_APP_API_ONTOLOGY_STEP_PART=/ontology/step/{part}
REACT_APP_API_ONTOLOGY_STEP_PART_BY_NAME=/ontology/step/{part_name}
REACT_APP_API_ONTOLOGY_MBSE_INSTANCES=/ontology/mbse-instances
REACT_APP_API_ONTOLOGY_OPTIONS=/ontology/options
REACT_APP_API_ONTOLOGY_REGISTERED_ROOT=/ontology/registered
REACT_APP_API_GRAPHVIS_BY_ONTOLOGY=/graphvis/by-ontology/{prefix}
REACT_APP_API_ONTOLOGIES_LIST=/ontologies/list

# ========== SCHEMA & METADATA ENDPOINTS ==========
# Get database schema information
REACT_APP_API_SCHEMA=/schema
# AP242 rotor shaft PMI data
REACT_APP_API_AP242_ROTOR_PMI=/ap242/rotor-shaft-pmi
# AP242 search endpoint
REACT_APP_API_AP242_SEARCH=/ap242/search
REACT_APP_API_REPORTS=/reports

# ========== CHAT & CONVERSATION ENDPOINTS ==========
# Send chat query to AI assistant
REACT_APP_API_CHAT=/chat
# Stream chat responses
REACT_APP_API_CHAT_STREAM=/chat-stream
REACT_APP_API_CHAT_SAMPLE_QUERIES=/chat/sample-queries

# ========== ONTOLOGY MANAGEMENT ENDPOINTS (v1) ==========
# Upload ontology file (XSD, XMI)
REACT_APP_API_ONTOLOGY_UPLOAD=/api/v1/ontology/upload
# List all registered ontologies
REACT_APP_API_ONTOLOGY_REGISTERED=/api/v1/ontology/registered
# Get specific ontology details
REACT_APP_API_ONTOLOGY_GET=/api/v1/ontology
# Get data dictionary for ontology
REACT_APP_API_ONTOLOGY_DATA_DICTIONARY=/api/v1/ontology/{ontology}/data-dictionary
REACT_APP_API_ONTOLOGY_PREFIX_DATA_DICTIONARY=/api/v1/ontology/{prefix}/data-dictionary
# Get mapping rules for ontology
REACT_APP_API_ONTOLOGY_MAPPINGS=/api/v1/ontology/{ontology}/mappings/{type}
REACT_APP_API_ONTOLOGY_PREFIX_MAPPINGS=/api/v1/ontology/{prefix}/mappings/{source_format}
# Map entity using ontology
REACT_APP_API_ONTOLOGY_MAP_ENTITY=/api/v1/ontology/{ontology}/map-entity
REACT_APP_API_ONTOLOGY_PREFIX_MAP_ENTITY=/api/v1/ontology/{prefix}/map-entity
REACT_APP_API_ONTOLOGY_AP239_DATA_DICTIONARY=/api/v1/ontology/ap239/data-dictionary
REACT_APP_API_ONTOLOGY_AP239_MAPPINGS=/api/v1/ontology/ap239/mappings/{source_format}
REACT_APP_API_ONTOLOGY_AP239_MAP_ENTITY=/api/v1/ontology/ap239/map-entity
REACT_APP_API_ONTOLOGY_AP239_DOMAIN_PIPELINES=/api/v1/ontology/ap239/domain-pipelines
REACT_APP_API_ONTOLOGY_AP242_DATA_DICTIONARY=/api/v1/ontology/ap242/data-dictionary
REACT_APP_API_ONTOLOGY_AP242_MAPPINGS=/api/v1/ontology/ap242/mappings/{source_format}
REACT_APP_API_ONTOLOGY_PIPELINE_DOMAINS=/api/v1/ontology/pipelines/domains
REACT_APP_API_ONTOLOGY_PIPELINE_DOMAIN=/api/v1/ontology/pipelines/domain/{domain_name}
REACT_APP_API_ONTOLOGY_PIPELINE_PROCESS=/api/v1/ontology/pipelines/process
REACT_APP_API_ONTOLOGY_EXTRACT_3DXML=/api/v1/ontology/extract-3dxml
REACT_APP_API_ONTOLOGY_3DXML_STATUS=/api/v1/ontology/3dxml/status/{task_id}
REACT_APP_API_ONTOLOGY_3DXML_FORMATS=/api/v1/ontology/3dxml/formats
REACT_APP_API_ONTOLOGY_ALIGNMENT_OPTIONS=/ontology-mappings
REACT_APP_API_ONTOLOGY_MERGE=/api/v1/ontology/merge
REACT_APP_API_ONTOLOGY_CLEANUP_OLD_XSD=/api/v1/ontology/cleanup-old-xsd

# ========== DATA IMPORT ENDPOINTS (v1) ==========
# Upload data file for import
REACT_APP_API_IMPORT_UPLOAD=/api/v1/import/upload
# Get import task status
REACT_APP_API_IMPORT_STATUS=/api/v1/import/status/{task_id}
# Preview parsed data before import
REACT_APP_API_IMPORT_PREVIEW=/api/v1/import/preview/{task_id}
# Commit parsed data to database
REACT_APP_API_IMPORT_COMMIT=/api/v1/import/commit/{task_id}
REACT_APP_API_IMPORT_PRE_COMMIT=/api/v1/import/pre-commit/{task_id}
# Cancel import task
REACT_APP_API_IMPORT_CANCEL=/api/v1/import/cancel/{task_id}
# Get generated OWL ontology
REACT_APP_API_IMPORT_OWL=/api/v1/import/owl/{task_id}
# Convert schema format
REACT_APP_API_IMPORT_CONVERT_SCHEMA=/api/v1/import/convert-schema
# Parse schema from file
REACT_APP_API_IMPORT_PARSE_SCHEMA=/api/v1/import/parse-schema
# Process pipeline stages 4-7
REACT_APP_API_IMPORT_PROCESS_STAGES=/api/v1/import/process-stages-4-7
# Get supported file formats
REACT_APP_API_IMPORT_FORMATS=/api/v1/import/formats
# Query OLLAMA LLM
REACT_APP_API_IMPORT_OLLAMA_QUERY=/api/v1/import/ollama/query
# Check OLLAMA health
REACT_APP_API_IMPORT_OLLAMA_HEALTH=/api/v1/import/ollama/health
REACT_APP_API_IMPORT_MAP_ONTOLOGY=/api/v1/import/map-ontology
REACT_APP_API_IMPORT_TASKS=/api/v1/import/tasks

# ========== INGESTION ENDPOINTS (v1) ==========
# Ingest data into database
REACT_APP_API_INGEST_DATA=/api/v1/ingest-data
REACT_APP_API_INGEST_DATA_ROOT=/api/v1/ingest-data

# ========== DOCUMENT/FILE ENDPOINTS ==========
# Get supported file formats
REACT_APP_API_DOCUMENTS_FORMATS=/api/v1/documents/supported-formats
# Upload documents (batch)
REACT_APP_API_DOCUMENTS_UPLOAD=/api/v1/documents/upload
# Upload single document
REACT_APP_API_DOCUMENTS_UPLOAD_SINGLE=/api/v1/documents/upload-single
# Document service health check
REACT_APP_API_DOCUMENTS_HEALTH=/api/v1/documents/health

# ========== ADMIN ENDPOINTS (v1) ==========
REACT_APP_API_ADMIN_HEALTH=/api/v1/admin/health
REACT_APP_API_ADMIN_CLEAN_SCHEMA=/api/v1/admin/clean-schema
REACT_APP_API_ADMIN_SCHEMA_STATS=/api/v1/admin/schema-stats
REACT_APP_API_ADMIN_RESET_DATABASE=/api/v1/admin/reset-database

# ========== RECOMMENDATION ENDPOINTS ==========
REACT_APP_API_RECOMMENDATIONS_CHANGE_IMPACT=/recommendations/change-impact
REACT_APP_API_RECOMMENDATIONS_SIMILAR_PARTS=/recommendations/similar-parts
REACT_APP_API_RECOMMENDATIONS_MANUFACTURING=/recommendations/manufacturing
REACT_APP_API_RECOMMENDATIONS_HEALTH=/recommendations/health

# ========== ONTOLOGY MAPPER ENDPOINTS ==========
REACT_APP_API_ONTOLOGY_MAPPER_OPTIONS=/ontology-mapper/options
REACT_APP_API_ONTOLOGY_MAPPER_MAPPINGS=/ontology-mapper/{mapping_type}/mappings
REACT_APP_API_ONTOLOGY_MAPPER_DATA_DICTIONARY=/ontology-mapper/{mapping_type}/data-dictionary
REACT_APP_API_ONTOLOGY_MAPPER_VOCABULARY=/ontology-mapper/{mapping_type}/vocabulary
REACT_APP_API_ONTOLOGY_MAPPER_STATS=/ontology-mapper/{mapping_type}/stats

# ========== INTEGRATION / WEBHOOK ENDPOINTS ==========
REACT_APP_API_TRACE_DIGITAL_THREAD=/trace/digital-thread
REACT_APP_API_EMBEDDINGS_BUILD=/embeddings/build
REACT_APP_API_WEBHOOKS_NEO4J_V1=/api/v1/webhooks/neo4j
REACT_APP_API_WEBHOOKS_NEO4J_LEGACY=/api/webhooks/neo4j

# ========== LEGACY DEPRECATED ENDPOINTS (Fallback) ==========
# These are kept for backward compatibility with older API versions
# Prefer v1 endpoints above
REACT_APP_API_ONTOLOGY_UPLOAD_LEGACY=/api/ontology/upload
REACT_APP_API_ONTOLOGY_REGISTERED_LEGACY=/api/ontology/registered
REACT_APP_API_IMPORT_UPLOAD_LEGACY=/api/import/upload
REACT_APP_API_IMPORT_STATUS_LEGACY=/api/import/status/{task_id}
REACT_APP_API_IMPORT_PREVIEW_LEGACY=/api/import/preview/{task_id}
REACT_APP_API_IMPORT_PRE_COMMIT_LEGACY=/api/import/pre-commit/{task_id}
REACT_APP_API_IMPORT_COMMIT_LEGACY=/api/import/commit/{task_id}
REACT_APP_API_IMPORT_CANCEL_LEGACY=/api/import/cancel/{task_id}
REACT_APP_API_IMPORT_TASKS_LEGACY=/api/import/tasks
REACT_APP_API_DATA_IMPORT_UPLOAD=/data-import/upload
REACT_APP_API_DATA_IMPORT_STATUS=/data-import/status/{task_id}
REACT_APP_API_DATA_IMPORT_PREVIEW=/data-import/preview/{task_id}
REACT_APP_API_DATA_IMPORT_PRE_COMMIT=/data-import/pre-commit/{task_id}
REACT_APP_API_DATA_IMPORT_COMMIT=/data-import/commit/{task_id}
REACT_APP_API_DATA_IMPORT_CANCEL=/data-import/cancel/{task_id}
REACT_APP_API_DATA_IMPORT_TASKS=/data-import/tasks

# ========== ENVIRONMENT & DEBUG ==========
# Environment: development, staging, production
REACT_APP_ENV=development
# Enable debug logging
REACT_APP_DEBUG=false
# Log level: error, warn, info, debug, trace
REACT_APP_LOG_LEVEL=info
# Request timeout in milliseconds
REACT_APP_REQUEST_TIMEOUT=30000

# ========== UI CONFIGURATION ==========
# Maximum nodes to render in graph visualization (prevents memory issues)
REACT_APP_GRAPH_MAX_NODES=2000
# Enable graph animation and transitions
REACT_APP_GRAPH_ANIMATION_ENABLED=true
# Auto-load graph on component mount
REACT_APP_AUTO_LOAD_GRAPH=true
