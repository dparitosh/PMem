REACT_APP_BACKEND_URL=http://127.0.0.1:8000
HOST=0.0.0.0
# Override REACT_APP_BACKEND_URL at launch time when using a LAN IP, cloud VM,
# reverse proxy, or customer host. The checked-in launcher scripts do this for you.
REACT_APP_API_VERSION=v1
REACT_APP_ENV=development
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
REACT_APP_REQUEST_TIMEOUT=900000
REACT_APP_SIRIUS_WEB_URL=http://localhost:8080
