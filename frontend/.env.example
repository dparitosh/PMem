# ========== BACKEND SERVER CONFIGURATION ==========
# Backend API base URL - Change this based on your deployment environment
REACT_APP_BACKEND_URL=http://localhost:8000
# API version to use (v1 is current)
REACT_APP_API_VERSION=v1
# Neo4j database connection (optional, for graph features)
REACT_APP_NEO4J_URL=bolt://localhost:7687

# ========== HEALTH & STATUS ENDPOINTS ==========
# Health check endpoint
REACT_APP_API_HEALTH=/health
# Readiness check endpoint
REACT_APP_API_READY=/ready

# ========== CORE GRAPH ENDPOINTS ==========
# Get entire graph data for visualization
REACT_APP_API_GRAPHVIS=/graphvis
# Filter graph by text search
REACT_APP_API_GRAPHFILTER=/graphfilter
# Multi-criteria graph filtering
REACT_APP_API_GRAPHFILTER_MULTI=/graphfilter-multi
# Traverse graph from a specific node
REACT_APP_API_GRAPHTRAVERSE=/graphtraverse

# ========== SCHEMA & METADATA ENDPOINTS ==========
# Get database schema information
REACT_APP_API_SCHEMA=/schema
# AP242 rotor shaft PMI data
REACT_APP_API_AP242_ROTOR_PMI=/ap242/rotor-shaft-pmi
# AP242 search endpoint
REACT_APP_API_AP242_SEARCH=/ap242/search

# ========== CHAT & CONVERSATION ENDPOINTS ==========
# Send chat query to AI assistant
REACT_APP_API_CHAT=/chat
# Stream chat responses
REACT_APP_API_CHAT_STREAM=/chat-stream

# ========== ONTOLOGY MANAGEMENT ENDPOINTS (v1) ==========
# Upload ontology file (XSD, XMI)
REACT_APP_API_ONTOLOGY_UPLOAD=/api/v1/ontology/upload
# List all registered ontologies
REACT_APP_API_ONTOLOGY_REGISTERED=/api/v1/ontology/registered
# Get specific ontology details
REACT_APP_API_ONTOLOGY_GET=/api/v1/ontology
# Get data dictionary for ontology
REACT_APP_API_ONTOLOGY_DATA_DICTIONARY=/api/v1/ontology/{ontology}/data-dictionary
# Get mapping rules for ontology
REACT_APP_API_ONTOLOGY_MAPPINGS=/api/v1/ontology/{ontology}/mappings/{type}
# Map entity using ontology
REACT_APP_API_ONTOLOGY_MAP_ENTITY=/api/v1/ontology/{ontology}/map-entity

# ========== DATA IMPORT ENDPOINTS (v1) ==========
# Upload data file for import
REACT_APP_API_IMPORT_UPLOAD=/api/v1/import/upload
# Get import task status
REACT_APP_API_IMPORT_STATUS=/api/v1/import/status/{task_id}
# Preview parsed data before import
REACT_APP_API_IMPORT_PREVIEW=/api/v1/import/preview/{task_id}
# Commit parsed data to database
REACT_APP_API_IMPORT_COMMIT=/api/v1/import/commit/{task_id}
# Cancel import task
REACT_APP_API_IMPORT_CANCEL=/api/v1/import/cancel/{task_id}
# Get generated OWL ontology
REACT_APP_API_IMPORT_OWL=/api/v1/import/owl/{task_id}
# Convert schema format
REACT_APP_API_IMPORT_CONVERT_SCHEMA=/api/v1/import/convert-schema
# Parse schema from file
REACT_APP_API_IMPORT_PARSE_SCHEMA=/api/v1/import/parse-schema
# Process pipeline stages 4-7
REACT_APP_API_IMPORT_PROCESS_STAGES=/api/v1/import/process-stages-4-7
# Get supported file formats
REACT_APP_API_IMPORT_FORMATS=/api/v1/import/formats
# Query OLLAMA LLM
REACT_APP_API_IMPORT_OLLAMA_QUERY=/api/v1/import/ollama/query
# Check OLLAMA health
REACT_APP_API_IMPORT_OLLAMA_HEALTH=/api/v1/import/ollama/health

# ========== INGESTION ENDPOINTS (v1) ==========
# Ingest data into database
REACT_APP_API_INGEST_DATA=/api/v1/ingestion/ingest-data

# ========== DOCUMENT/FILE ENDPOINTS ==========
# Get supported file formats
REACT_APP_API_DOCUMENTS_FORMATS=/api/v1/documents/supported-formats
# Upload documents (batch)
REACT_APP_API_DOCUMENTS_UPLOAD=/api/v1/documents/upload
# Upload single document
REACT_APP_API_DOCUMENTS_UPLOAD_SINGLE=/api/v1/documents/upload-single
# Document service health check
REACT_APP_API_DOCUMENTS_HEALTH=/api/v1/documents/health

# ========== ADMIN ENDPOINTS (v1) ==========
# Add admin endpoints configuration as needed
# REACT_APP_API_ADMIN_USERS=/api/v1/admin/users
# REACT_APP_API_ADMIN_SETTINGS=/api/v1/admin/settings

# ========== LEGACY DEPRECATED ENDPOINTS (Fallback) ==========
# These are kept for backward compatibility with older API versions
# Prefer v1 endpoints above
REACT_APP_API_ONTOLOGY_UPLOAD_LEGACY=/api/ontology/upload
REACT_APP_API_ONTOLOGY_REGISTERED_LEGACY=/api/ontology/registered
REACT_APP_API_IMPORT_UPLOAD_LEGACY=/api/import/upload
REACT_APP_API_IMPORT_STATUS_LEGACY=/api/import/status/{task_id}

# ========== ENVIRONMENT & DEBUG ==========
# Environment: development, staging, production
REACT_APP_ENV=development
# Enable debug logging
REACT_APP_DEBUG=false
# Log level: error, warn, info, debug, trace
REACT_APP_LOG_LEVEL=info
# Request timeout in milliseconds
REACT_APP_REQUEST_TIMEOUT=30000

# ========== UI CONFIGURATION ==========
# Maximum nodes to render in graph visualization (prevents memory issues)
REACT_APP_GRAPH_MAX_NODES=2000
# Enable graph animation and transitions
REACT_APP_GRAPH_ANIMATION_ENABLED=true
# Auto-load graph on component mount
REACT_APP_AUTO_LOAD_GRAPH=true
