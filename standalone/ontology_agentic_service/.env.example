# Standalone ontology HTTP API
ONTOLOGY_AGENTIC_HOST=127.0.0.1
ONTOLOGY_AGENTIC_PORT=8012
ONTOLOGY_AGENTIC_RELOAD=false
ONTOLOGY_AGENTIC_DATA_DIR=./data
ONTOLOGY_AGENTIC_OUTPUT_DIR=./output
ONTOLOGY_AGENTIC_AGENT_SPECS_DIR=./iif_bundle/AgentsRegistry/Agents
ONTOLOGY_AGENTIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# IIF external HTTP tool connection
ONTOLOGY_API_BASE_URL=http://127.0.0.1:8012

# Optional ontology API security; disabled for local development
ONTOLOGY_API_SECURITY_ENABLED=false
ONTOLOGY_API_TOKEN=
ONTOLOGY_API_ALLOWED_INPUT_ROOTS=./data
ONTOLOGY_API_ALLOWED_OUTPUT_ROOTS=./output
ONTOLOGY_API_ALLOW_BASE_URL_OVERRIDE=false

# Optional Neo4j MCP; disabled by default
NEO4J_MCP_ENABLED=false
NEO4J_MCP_URL=http://127.0.0.1:8080/mcp
NEO4J_MCP_ARGS=[]
NEO4J_MCP_ENV_JSON={}
NEO4J_MCP_SECURITY_ENABLED=false
NEO4J_MCP_ALLOW_WRITES=false
NEO4J_MCP_ALLOWED_TOOLS=
