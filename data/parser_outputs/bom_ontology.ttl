bom:SameTimeMachiningRelationship a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "SameTimeMachiningRelationship" ;
    oslc:describes bom:SameTimeMachiningRelationship ;
    oslc:property [ a oslc:Property ;
            oslc:name "Placement" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition bom:SameTimeMachiningRelationship_Placement ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'SameTimeMachiningRelationship'." ;
