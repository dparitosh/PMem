bom:ActualActivity a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "ActualActivity" ;
    oslc:describes bom:ActualActivity ;
    oslc:property [ a oslc:Property ;
            oslc:name "ActualEndDate" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition bom:ActualActivity_ActualEndDate ],
        [ a oslc:Property ;
            oslc:name "ActualStartDate" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition bom:ActualActivity_ActualStartDate ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'ActualActivity'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:ActualActivity_ActualStartDate ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:ActualActivity_ActualEndDate ] .

