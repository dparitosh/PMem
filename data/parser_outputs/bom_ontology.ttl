bom:LocalizedString a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "LocalizedString" ;
    oslc:describes bom:LocalizedString ;
    oslc:property [ a oslc:Property ;
            oslc:name "lang" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition bom:LocalizedString_lang ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'LocalizedString'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:LocalizedString_lang ] .

bom:LocalizedString_lang a owl:DatatypeProperty ;
    rdfs:label "lang" ;
    dc:source "bom / bom" ;
    rdfs:comment "Attribute 'lang' of LocalizedString. use=optional." ;
    rdfs:domain bom:LocalizedString ;
    rdfs:range xsd:language .

