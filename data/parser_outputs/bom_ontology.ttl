bom:MaterialPropertyDefinition a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "MaterialPropertyDefinition" ;
    oslc:describes bom:MaterialPropertyDefinition ;
    oslc:property [ a oslc:Property ;
            oslc:name "Name" ;
            oslc:occurs oslc:Exactly-one ;
            oslc:propertyDefinition bom:prop_common_name ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'MaterialPropertyDefinition'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:prop_common_name ] .

bom:MatingDefinition a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "MatingDefinition" ;
    oslc:describes bom:MatingDefinition ;
    oslc:property [ a oslc:Property ;
            oslc:name "MatingType" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition bom:MatingDefinition_MatingType ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'MatingDefinition'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:MatingDefinition_MatingType ] .

bom:MatingDefinition_MatingType a owl:ObjectProperty ;
