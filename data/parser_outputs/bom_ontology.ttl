bom:CartesianPoint a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "CartesianPoint" ;
    oslc:describes bom:CartesianPoint ;
    oslc:property [ a oslc:Property ;
            oslc:name "Coordinates" ;
            oslc:occurs oslc:Exactly-one ;
            oslc:propertyDefinition bom:CartesianPoint_Coordinates ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'CartesianPoint'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:CartesianPoint_Coordinates ] .

