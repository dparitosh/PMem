bom:AddElement a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "AddElement" ;
    oslc:describes bom:AddElement ;
    oslc:property [ a oslc:Property ;
            oslc:name "CurrentDesignObject" ;
            oslc:occurs oslc:Exactly-one ;
            oslc:propertyDefinition bom:AddElement_CurrentDesignObject ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'AddElement'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:AddElement_CurrentDesignObject ] .

