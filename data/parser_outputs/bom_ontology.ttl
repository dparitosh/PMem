        owl:Class ;
    rdfs:label "QualitativeUncertainty" ;
    oslc:describes bom:QualitativeUncertainty ;
    oslc:property [ a oslc:Property ;
            oslc:name "UncertaintyValue" ;
            oslc:occurs oslc:Exactly-one ;
            oslc:propertyDefinition bom:QualitativeUncertainty_UncertaintyValue ] ;
    dc:source "bom / bom" ;
    rdfs:comment "Class from bom. Source complexType 'QualitativeUncertainty'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty bom:QualitativeUncertainty_UncertaintyValue ] .

