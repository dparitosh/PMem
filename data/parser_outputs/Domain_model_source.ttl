               <xsd:element name="ExternalOwlObject" type="ExternalOwlObject" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="ExternalRefBaseObject" type="ExternalRefBaseObject" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="ExternalUnit" type="ExternalUnit" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="File" type="File" minOccurs="0" maxOccurs="unbounded"/>
