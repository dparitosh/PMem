               </xsd:element>
               <xsd:element name="RequirementSatisfactionAssertion" type="RequirementSatisfactionAssertion" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="RetentionPeriod" type="RetentionPeriod" minOccurs="0" maxOccurs="unbounded"/>
