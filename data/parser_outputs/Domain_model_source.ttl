               <xsd:element name="Justification" type="Justification" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="LifeCycleStage" type="LifeCycleStage" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Location" type="Location" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="ManagedResource" type="ManagedResource" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Market" type="Market" minOccurs="0" maxOccurs="unbounded"/>
