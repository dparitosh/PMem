               <xsd:element name="ComponentPlacement" type="ComponentPlacement" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="ConditionEvaluationParameter" type="ConditionEvaluationParameter" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="ConfiguredAssemblyEffectivity" type="ConfiguredAssemblyEffectivity" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Contract" type="Contract" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Document" type="Document" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Effectivity" type="Effectivity" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Envelope" type="Envelope" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Environment" type="Environment" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Event" type="Event" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="Evidence" type="Evidence" minOccurs="0" maxOccurs="unbounded"/>
