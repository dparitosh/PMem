<http://depo-onto.local/source#type/Class> a owl:Class ;
    rdfs:label "Class" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="Class">
      <xsd:complexContent>
