               <xsd:element name="SuppliedObjectRelationship" type="SuppliedObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
         </xsd:extension>
      </xsd:complexContent>
   </xsd:complexType>
   """ ;
    rdfs:subClassOf <http://depo-onto.local/source#type/BaseObject> .

<http://depo-onto.local/source#type/Classification> a owl:Class ;
