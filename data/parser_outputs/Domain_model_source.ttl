<http://depo-onto.local/source#type/IndividualPart> a owl:Class ;
    rdfs:label "IndividualPart" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="IndividualPart">
      <xsd:complexContent>
         <xsd:extension base="BaseRootObject">
            <xsd:sequence>
               <xsd:element name="ClassifiedAs" minOccurs="0">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="Classification" type="Classification" maxOccurs="unbounded"/>
                     </xsd:sequence>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="Description" minOccurs="0">
                  <xsd:complexType>
                     <xsd:group ref="DescriptorSelect"/>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="Id" type="Id" minOccurs="0"/>
               <xsd:element name="Name" minOccurs="0">
                  <xsd:complexType>
                     <xsd:group ref="DescriptorSelect"/>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="RequirementSatisfactionAssertion" type="RequirementSatisfactionAssertion" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="SameAs" minOccurs="0">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="Proxy" type="Proxy" maxOccurs="unbounded"/>
                     </xsd:sequence>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="Versions">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="IndividualPartVersion" type="IndividualPartVersion" maxOccurs="unbounded"/>
                     </xsd:sequence>
