               <xsd:element name="WorkOrder" type="WorkOrder" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="WorkRequest" type="WorkRequest" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:choice>
         </xsd:extension>
      </xsd:complexContent>
   </xsd:complexType>
   """ ;
    rdfs:subClassOf <http://depo-onto.local/source#type/DataContainer> .

<http://depo-onto.local/source#type/Acknowledgement> a owl:Class ;
    rdfs:label "Acknowledgement" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="Acknowledgement">
      <xsd:complexContent>
         <xsd:extension base="BaseObject">
            <xsd:sequence>
               <xsd:element name="Definition">
                  <xsd:complexType>
                     <xsd:group ref="ProxyItemSelect"/>
