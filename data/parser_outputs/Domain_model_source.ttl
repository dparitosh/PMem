    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="AnalysisDisciplineDefinition">
      <xsd:complexContent>
         <xsd:extension base="BaseObject">
            <xsd:sequence>
               <xsd:element name="AdditionalContexts" minOccurs="0">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="ViewContext" type="Reference" maxOccurs="unbounded"/>
                     </xsd:sequence>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="ClassifiedAs" minOccurs="0">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="Classification" type="Classification" maxOccurs="unbounded"/>
