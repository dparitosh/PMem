                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="Versions" minOccurs="0">
                  <xsd:complexType>
                     <xsd:sequence>
                        <xsd:element name="CollectionVersion" type="CollectionVersion" maxOccurs="unbounded"/>
                     </xsd:sequence>
                  </xsd:complexType>
               </xsd:element>
               <xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
