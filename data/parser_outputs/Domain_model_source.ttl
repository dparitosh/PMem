               <xsd:element name="TypeOfPersonAssignment" type="TypeOfPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
               <xsd:element name="WorkRequestAssignment" type="WorkRequestAssignment" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
         </xsd:extension>
      </xsd:complexContent>
   </xsd:complexType>
   """ ;
    rdfs:subClassOf <http://depo-onto.local/source#type/BaseObject> .

