<http://depo-onto.local/source#type/CartesianTransformation> a owl:Class ;
    rdfs:label "CartesianTransformation" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="CartesianTransformation">
      <xsd:complexContent>
         <xsd:extension base="BaseRootObject">
            <xsd:sequence>
               <xsd:element name="RotationMatrix" type="xsd:string"/>
               <xsd:element name="Scale" type="xsd:double" minOccurs="0"/>
               <xsd:element name="TranslationVector" type="xsd:string"/>
               <xsd:element name="ObservationAssignment" type="ObservationAssignment" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
         </xsd:extension>
      </xsd:complexContent>
   </xsd:complexType>
   """ ;
    rdfs:subClassOf <http://depo-onto.local/source#type/BaseRootObject> .

<http://depo-onto.local/source#type/CausalConsequence> a owl:Class ;
    rdfs:label "CausalConsequence" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="CausalConsequence">
