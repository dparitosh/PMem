    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://standards.iso.org/iso/ts/10303/-4439/ed-2/tech/xml-schema/domain_model" name="AP239DataContainer">
      <xsd:complexContent>
         <xsd:extension base="DataContainer">
            <xsd:choice minOccurs="0" maxOccurs="unbounded">
               <xsd:element name="Activity" type="Activity" minOccurs="0" maxOccurs="unbounded"/>
