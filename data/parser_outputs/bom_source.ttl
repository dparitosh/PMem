    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FilamentLaminate">
		<xsd:complexContent>
			<xsd:extension base="ConstituentPart">
				<xsd:sequence>
					<xsd:element name="MadeFrom" type="cmn:Reference"/>
					<xsd:element name="ShapeCrossSection" type="cmn:Reference" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/ConstituentPart> .

<http://depo-onto.local/source#type/FileRelationship> a owl:Class ;
    rdfs:label "FileRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FileRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="RelationType">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ModelPropertyAssignment" type="ModelPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyDefinitionAssignment" type="PropertyDefinitionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyValueAssignment" type="PropertyValueAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/FinalSolution> a owl:Class ;
    rdfs:label "FinalSolution" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FinalSolution">
		<xsd:complexContent>
			<xsd:extension base="AlternativeSolution">
				<xsd:sequence>
					<xsd:element name="Specifications">
						<xsd:complexType>
							<xsd:group ref="FinalDefinitionSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Status">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AlternativeSolution> .

<http://depo-onto.local/source#type/FormatProperty> a owl:Class ;
    rdfs:label "FormatProperty" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FormatProperty">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="CharacterCode" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DataFormat" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="SizeFormat" type="RectangularSize" minOccurs="0"/>
					<xsd:element name="SuppliedObjectRelationship" type="SuppliedObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

<http://depo-onto.local/source#type/FrozenAssignment> a owl:Class ;
    rdfs:label "FrozenAssignment" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FrozenAssignment">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ActivityMethodAssignment" type="ActivityMethodAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="AssignmentObjectRelationship" type="AssignmentObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionAssignment" type="ConditionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
