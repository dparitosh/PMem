<http://depo-onto.local/source#type/Document> a owl:Class ;
    rdfs:label "Document" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Document">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DocumentTypes">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id"/>
					<xsd:element name="Name">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="SameAs" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ProxySelect" minOccurs="0" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Versions">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="DocumentVersion" type="DocumentVersion" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ActivityMethodAssignment" type="ActivityMethodAssignment" minOccurs="0" maxOccurs="unbounded"/>
