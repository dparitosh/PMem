					<xsd:element name="Segments">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="InterpolatedConfigurationSegment" type="InterpolatedConfigurationSegment" minOccurs="2" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/RepresentationItem> .

<http://depo-onto.local/source#type/InterpolationTypeEnum> a owl:Class ;
