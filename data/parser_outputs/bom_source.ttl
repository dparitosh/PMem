							<xsd:sequence>
								<xsd:element name="PlannedCharacteristic" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
