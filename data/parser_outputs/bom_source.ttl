<http://depo-onto.local/source#type/NumericalContext> a owl:Class ;
    rdfs:label "NumericalContext" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="NumericalContext">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="Accuracy" type="xsd:double"/>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="SignificantDigits" type="xsd:integer" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

