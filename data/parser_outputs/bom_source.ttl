<http://depo-onto.local/source#type/EvaluationResultEnum> a owl:Class ;
    rdfs:label "EvaluationResultEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="EvaluationResultEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="fail"/>
			<xsd:enumeration value="pass"/>
			<xsd:enumeration value="undefined"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/EvaluationStatusEnum> a owl:Class ;
