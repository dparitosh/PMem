<http://depo-onto.local/source#type/FaceBasedSheetRepresentation> a owl:Class ;
    rdfs:label "FaceBasedSheetRepresentation" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="FaceBasedSheetRepresentation">
		<xsd:complexContent>
			<xsd:extension base="CompositeSheetRepresentation">
				<xsd:sequence>
					<xsd:element name="FaceSurface" type="cmn:Reference"/>
					<xsd:element name="InnerBounds" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Loop" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="OuterBound" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/CompositeSheetRepresentation> .

<http://depo-onto.local/source#type/FilamentLaminate> a owl:Class ;
