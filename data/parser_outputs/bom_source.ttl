			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="AngleReferences">
						<xsd:complexType>
							<xsd:group ref="AngleSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Basis" type="cmn:Reference"/>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Name" minOccurs="0">
