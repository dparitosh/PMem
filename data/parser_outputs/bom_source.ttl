<http://depo-onto.local/source#type/SuppliedObjectRelationship> a owl:Class ;
    rdfs:label "SuppliedObjectRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SuppliedObjectRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/SupplierSolution> a owl:Class ;
    rdfs:label "SupplierSolution" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SupplierSolution">
		<xsd:complexContent>
			<xsd:extension base="AlternativeSolution">
				<xsd:sequence>
					<xsd:element name="ProbabilityRate" type="xsd:double" minOccurs="0"/>
					<xsd:element name="Supplier" type="cmn:Reference"/>
					<xsd:element name="CertificationAssignment" type="CertificationAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AlternativeSolution> .

<http://depo-onto.local/source#type/SurfaceCondition> a owl:Class ;
    rdfs:label "SurfaceCondition" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SurfaceCondition">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ConditionType" type="xsd:string"/>
					<xsd:element name="DefinedIn" type="cmn:Reference"/>
					<xsd:element name="Id" type="Id"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/SurfaceCurve> a owl:Class ;
    rdfs:label "SurfaceCurve" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SurfaceCurve">
		<xsd:complexContent>
			<xsd:extension base="Curve">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Curve> .

<http://depo-onto.local/source#type/SurfaceWithDirection> a owl:Class ;
    rdfs:label "SurfaceWithDirection" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SurfaceWithDirection">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="DefiningSurface" type="cmn:Reference"/>
					<xsd:element name="MaterialDirection" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/SystemBreakdown> a owl:Class ;
    rdfs:label "SystemBreakdown" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="SystemBreakdown">
		<xsd:complexContent>
			<xsd:extension base="Breakdown">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Breakdown> .

<http://depo-onto.local/source#type/TechnicalSolution> a owl:Class ;
    rdfs:label "TechnicalSolution" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TechnicalSolution">
		<xsd:complexContent>
			<xsd:extension base="AlternativeSolution">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AlternativeSolution> .

<http://depo-onto.local/source#type/ThicknessLaminateTable> a owl:Class ;
    rdfs:label "ThicknessLaminateTable" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ThicknessLaminateTable">
		<xsd:complexContent>
			<xsd:extension base="ZoneStructuralMakeup">
				<xsd:sequence>
					<xsd:element name="TableComponents">
						<xsd:complexType>
							<xsd:group ref="ThicknessLaminateTableComponentSelect" minOccurs="2" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/ZoneStructuralMakeup> .

<http://depo-onto.local/source#type/ThicknessSizeDimension> a owl:Class ;
    rdfs:label "ThicknessSizeDimension" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ThicknessSizeDimension">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="Id" type="Id"/>
					<xsd:element name="Thickness" type="NumericalValue"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/ThreeDGeometrySet> a owl:Class ;
    rdfs:label "ThreeDGeometrySet" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ThreeDGeometrySet">
		<xsd:complexContent>
			<xsd:extension base="ConstituentShapeRepresentation">
				<xsd:sequence>
					<xsd:element name="BasisRole">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="BasisSurface" type="cmn:Reference"/>
					<xsd:element name="DefiningBoundary">
						<xsd:complexType>
							<xsd:group ref="GeometricBoundingCurveSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ThreeDGeometry" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/ConstituentShapeRepresentation> .

<http://depo-onto.local/source#type/TimeIntervalAssignment> a owl:Class ;
    rdfs:label "TimeIntervalAssignment" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TimeIntervalAssignment">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="AssignedTimeInterval" type="TimeInterval"/>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Role">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ActivityMethodAssignment" type="ActivityMethodAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="AssignmentObjectRelationship" type="AssignmentObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionAssignment" type="ConditionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ModelPropertyAssignment" type="ModelPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyDefinitionAssignment" type="PropertyDefinitionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyValueAssignment" type="PropertyValueAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/TimeIntervalEffectivity> a owl:Class ;
    rdfs:label "TimeIntervalEffectivity" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TimeIntervalEffectivity">
		<xsd:complexContent>
			<xsd:extension base="Effectivity">
				<xsd:sequence>
					<xsd:element name="EffectivityPeriod" type="xsd:duration"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Effectivity> .

<http://depo-onto.local/source#type/TimeIntervalRelationship> a owl:Class ;
    rdfs:label "TimeIntervalRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TimeIntervalRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="RelationType">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/TimeIntervalWithBounds> a owl:Class ;
    rdfs:label "TimeIntervalWithBounds" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TimeIntervalWithBounds">
		<xsd:complexContent>
			<xsd:extension base="TimeInterval">
				<xsd:sequence>
					<xsd:element name="Duration" type="xsd:duration" minOccurs="0"/>
					<xsd:element name="PrimaryBound" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="EventOrDateSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="SecondaryBound" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="EventOrDateSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/TimeInterval> .

<http://depo-onto.local/source#type/TimeIntervalWithId> a owl:Class ;
    rdfs:label "TimeIntervalWithId" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TimeIntervalWithId">
		<xsd:complexContent>
			<xsd:extension base="TimeInterval">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/TimeInterval> .

<http://depo-onto.local/source#type/ToolAttachmentPointFrame> a owl:Class ;
    rdfs:label "ToolAttachmentPointFrame" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ToolAttachmentPointFrame">
		<xsd:complexContent>
