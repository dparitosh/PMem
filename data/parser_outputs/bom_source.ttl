				<xsd:sequence>
					<xsd:element name="AssertedBy" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="DateAndPersonOrganization" type="DateAndPersonOrganization" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
