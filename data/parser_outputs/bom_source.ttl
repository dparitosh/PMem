    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/KinematicPairValue> a owl:Class ;
    rdfs:label "KinematicPairValue" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="KinematicPairValue">
		<xsd:complexContent>
			<xsd:extension base="RepresentationItem">
				<xsd:sequence>
					<xsd:element name="ActualPointOnCurve1" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="ActualPointOnCurve2" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="ActualPointOnSurface1" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="ActualPointOnSurface2" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="ActualRotation" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="SimpleOrSpatialRotationSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActualTranslation" type="xsd:string" minOccurs="0"/>
					<xsd:element name="AppliesToPair" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/RepresentationItem> .

<http://depo-onto.local/source#type/KinematicPathDefinedByNodes> a owl:Class ;
    rdfs:label "KinematicPathDefinedByNodes" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="KinematicPathDefinedByNodes">
