<http://depo-onto.local/source#type/LinkMotionAlongPath> a owl:Class ;
    rdfs:label "LinkMotionAlongPath" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LinkMotionAlongPath">
		<xsd:complexContent>
			<xsd:extension base="GeometricRepresentation">
				<xsd:sequence>
					<xsd:element name="TimeUnit" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="LinkMotionDecompositionRelationship" type="LinkMotionDecompositionRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="LinkMotionRelationship" type="LinkMotionRelationship" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/GeometricRepresentation> .

<http://depo-onto.local/source#type/LinkMotionDecompositionRelationship> a owl:Class ;
    rdfs:label "LinkMotionDecompositionRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LinkMotionDecompositionRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/LinkMotionRelationship> a owl:Class ;
    rdfs:label "LinkMotionRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LinkMotionRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="RelationType">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="TranformationOperator" type="LinkMotionTransformation"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/LinkMotionTransformation> a owl:Class ;
    rdfs:label "LinkMotionTransformation" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LinkMotionTransformation">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="TransformItem1" type="cmn:Reference"/>
					<xsd:element name="TransformItem2" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/LocalizedString> a owl:Class ;
    rdfs:label "LocalizedString" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LocalizedString" mixed="true">
		<xsd:complexContent mixed="true">
			<xsd:extension base="cmn:BaseObject">
				<xsd:attribute name="lang" type="xsd:language" use="optional"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/Loop> a owl:Class ;
    rdfs:label "Loop" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Loop">
		<xsd:complexContent>
			<xsd:extension base="DetailedGeometricModelItem">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/DetailedGeometricModelItem> .

<http://depo-onto.local/source#type/LotEffectivity> a owl:Class ;
    rdfs:label "LotEffectivity" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LotEffectivity">
		<xsd:complexContent>
			<xsd:extension base="Effectivity">
				<xsd:sequence>
					<xsd:element name="LotSize" type="ValueWithUnit"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Effectivity> .

<http://depo-onto.local/source#type/LowOrderKinematicPair> a owl:Class ;
    rdfs:label "LowOrderKinematicPair" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LowOrderKinematicPair">
		<xsd:complexContent>
			<xsd:extension base="KinematicPair">
				<xsd:sequence>
					<xsd:element name="Kind" type="LowOrderKinematicPairTypeEnum"/>
					<xsd:element name="LowerLimitActualRotationX" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitActualRotationY" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitActualRotationZ" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitActualTranslationX" type="xsd:string" minOccurs="0"/>
					<xsd:element name="LowerLimitActualTranslationY" type="xsd:string" minOccurs="0"/>
					<xsd:element name="LowerLimitActualTranslationZ" type="xsd:string" minOccurs="0"/>
					<xsd:element name="UpperLimitActualRotationX" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitActualRotationY" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitActualRotationZ" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitActualTranslationX" type="xsd:string" minOccurs="0"/>
					<xsd:element name="UpperLimitActualTranslationY" type="xsd:string" minOccurs="0"/>
					<xsd:element name="UpperLimitActualTranslationZ" type="xsd:string" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/KinematicPair> .

<http://depo-onto.local/source#type/LowOrderKinematicPairTypeEnum> a owl:Class ;
    rdfs:label "LowOrderKinematicPairTypeEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LowOrderKinematicPairTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="cylindrical_pair"/>
			<xsd:enumeration value="fully_constrained_pair"/>
			<xsd:enumeration value="planar_pair"/>
			<xsd:enumeration value="prismatic_pair"/>
			<xsd:enumeration value="revolute_pair"/>
			<xsd:enumeration value="spherical_pair"/>
			<xsd:enumeration value="spherical_pair_with_pin"/>
			<xsd:enumeration value="unconstrained_pair"/>
			<xsd:enumeration value="universal_pair"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/LowOrderKinematicPairWithMotionCoupling> a owl:Class ;
    rdfs:label "LowOrderKinematicPairWithMotionCoupling" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LowOrderKinematicPairWithMotionCoupling">
		<xsd:complexContent>
			<xsd:extension base="KinematicPair">
				<xsd:sequence>
					<xsd:element name="Bevel" type="xsd:double" minOccurs="0"/>
					<xsd:element name="GearRatio" type="xsd:double" minOccurs="0"/>
					<xsd:element name="HelicalAngle" type="xsd:double" minOccurs="0"/>
					<xsd:element name="Kind" type="LowOrderKinematicPairWithMotionCouplingTypeEnum"/>
					<xsd:element name="LowerLimitActualRotation" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitRackDisplacement" type="xsd:string" minOccurs="0"/>
					<xsd:element name="Pitch" type="xsd:string" minOccurs="0"/>
					<xsd:element name="Radius1" type="xsd:string" minOccurs="0"/>
					<xsd:element name="Radius2" type="xsd:string" minOccurs="0"/>
					<xsd:element name="UpperLimitActualRotation" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitRackDisplacement" type="xsd:string" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/KinematicPair> .

<http://depo-onto.local/source#type/LowOrderKinematicPairWithMotionCouplingTypeEnum> a owl:Class ;
    rdfs:label "LowOrderKinematicPairWithMotionCouplingTypeEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LowOrderKinematicPairWithMotionCouplingTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="gear_pair"/>
			<xsd:enumeration value="linear_flexible_and_pinion_pair"/>
			<xsd:enumeration value="rack_and_pinion_pair"/>
			<xsd:enumeration value="screw_pair"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/MakeFromRelationship> a owl:Class ;
    rdfs:label "MakeFromRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MakeFromRelationship">
		<xsd:complexContent>
			<xsd:extension base="PartViewRelationship">
				<xsd:sequence>
					<xsd:element name="Priority" type="xsd:integer" minOccurs="0"/>
					<xsd:element name="Quantity" type="ValueWithUnit" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/PartViewRelationship> .

<http://depo-onto.local/source#type/Market> a owl:Class ;
    rdfs:label "Market" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Market">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="MarketSegmentType" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Name" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="SameAs" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ProxySelect" minOccurs="0" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

<http://depo-onto.local/source#type/MatedPartAssociation> a owl:Class ;
    rdfs:label "MatedPartAssociation" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MatedPartAssociation">
		<xsd:complexContent>
			<xsd:extension base="NextAssemblyOccurrenceUsage">
				<xsd:sequence>
					<xsd:element name="MatedPartRelationship" type="MatedPartRelationship" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/NextAssemblyOccurrenceUsage> .

<http://depo-onto.local/source#type/MatedPartRelationship> a owl:Class ;
    rdfs:label "MatedPartRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MatedPartRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="MatedShapes" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="AssemblyJoint" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="MatingMaterials" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="QuantifiedOccurrence" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="MatingType" type="MatingTypeEnum"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/MaterialIdentification> a owl:Class ;
    rdfs:label "MaterialIdentification" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MaterialIdentification">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="Id" type="Id"/>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="MaterialPropertyAssignment" type="MaterialPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SecurityClassificationAssignment" type="SecurityClassificationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SuppliedObjectRelationship" type="SuppliedObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/MaterialPropertyAssignment> a owl:Class ;
    rdfs:label "MaterialPropertyAssignment" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MaterialPropertyAssignment">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="AssignedProperty" type="MaterialPropertyValue"/>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Definitional" type="xsd:boolean" minOccurs="0"/>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Role">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ActivityMethodAssignment" type="ActivityMethodAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="AssignmentObjectRelationship" type="AssignmentObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionAssignment" type="ConditionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ModelPropertyAssignment" type="ModelPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyDefinitionAssignment" type="PropertyDefinitionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyValueAssignment" type="PropertyValueAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/MaterialPropertyDefinition> a owl:Class ;
    rdfs:label "MaterialPropertyDefinition" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MaterialPropertyDefinition">
