<http://depo-onto.local/source#type/DeltaChange> a owl:Class ;
    rdfs:label "DeltaChange" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="DeltaChange">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="ChangeActivities" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="DeltaChangeActivity" type="DeltaChangeActivity" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DescribedChange" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id"/>
					<xsd:element name="Name" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

<http://depo-onto.local/source#type/Descriptor> a owl:Class ;
    rdfs:label "Descriptor" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Descriptor">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="DescriptionContext" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="IdentificationContextSelect" minOccurs="0" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Text">
						<xsd:complexType>
							<xsd:group ref="MultiLingualStringSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ContractAssignment" type="ContractAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DescriptorRelationship" type="DescriptorRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SecurityClassificationAssignment" type="SecurityClassificationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/DescriptorRelationship> a owl:Class ;
    rdfs:label "DescriptorRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="DescriptorRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
