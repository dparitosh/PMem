			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AxisPlacement> .

<http://depo-onto.local/source#type/ToolCentrePointFrame> a owl:Class ;
    rdfs:label "ToolCentrePointFrame" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ToolCentrePointFrame">
		<xsd:complexContent>
			<xsd:extension base="AxisPlacement">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AxisPlacement> .

<http://depo-onto.local/source#type/ToolPartRelationship> a owl:Class ;
    rdfs:label "ToolPartRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ToolPartRelationship">
		<xsd:complexContent>
			<xsd:extension base="PartViewRelationship">
				<xsd:sequence>
					<xsd:element name="Placement" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="TransformationSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/PartViewRelationship> .

<http://depo-onto.local/source#type/TransformedGeometricModel> a owl:Class ;
    rdfs:label "TransformedGeometricModel" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TransformedGeometricModel">
		<xsd:complexContent>
			<xsd:extension base="GeometricModel">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/GeometricModel> .

<http://depo-onto.local/source#type/TransitionCodeEnum> a owl:Class ;
    rdfs:label "TransitionCodeEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TransitionCodeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="cont_same_gradient"/>
			<xsd:enumeration value="cont_same_gradient_same_curvature"/>
			<xsd:enumeration value="continuous"/>
			<xsd:enumeration value="discontinuous"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/TrimmedCurve> a owl:Class ;
    rdfs:label "TrimmedCurve" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="TrimmedCurve">
		<xsd:complexContent>
			<xsd:extension base="Curve">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Curve> .

<http://depo-onto.local/source#type/Unit> a owl:Class ;
    rdfs:label "Unit" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Unit">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="Kind" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Name">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Prefix" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Quantity" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

<http://depo-onto.local/source#type/ValueLimit> a owl:Class ;
    rdfs:label "ValueLimit" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ValueLimit">
		<xsd:complexContent>
			<xsd:extension base="NumericalValue">
				<xsd:sequence>
					<xsd:element name="Qualifier" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
