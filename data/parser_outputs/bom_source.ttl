					<xsd:element name="TParameter" type="xsd:double"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/InterpolatedConfigurationSequence> a owl:Class ;
