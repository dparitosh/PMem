    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="InterpolationTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="undefined_interpolation_type"/>
			<xsd:enumeration value="discontinuous_interpolation_type"/>
			<xsd:enumeration value="synchronous_interpolation_type"/>
			<xsd:enumeration value="linear_interpolation_type"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/KinematicLink> a owl:Class ;
