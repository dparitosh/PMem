			<xsd:enumeration value="invalid"/>
			<xsd:enumeration value="not_evaluatable"/>
			<xsd:enumeration value="to_be_evaluated"/>
			<xsd:enumeration value="valid"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/Event> a owl:Class ;
    rdfs:label "Event" ;
