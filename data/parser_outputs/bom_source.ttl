					<xsd:element name="ParameterUnit" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/GeometricRepresentation> .

<http://depo-onto.local/source#type/InterpolatedConfigurationSegment> a owl:Class ;
