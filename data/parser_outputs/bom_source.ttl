<http://depo-onto.local/source#type/Effectivity> a owl:Class ;
    rdfs:label "Effectivity" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Effectivity">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseRootObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ConcernedOrganizations" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Organization" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="EffectivityContext" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="EndDefinition" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="EventOrDateSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="SameAs" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ProxySelect" minOccurs="0" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="StartDefinition" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="EventOrDateSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="VersionId" type="Id" minOccurs="0"/>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionAssignment" type="ConditionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityRelationship" type="EffectivityRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SuppliedObjectRelationship" type="SuppliedObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseRootObject> .

<http://depo-onto.local/source#type/Condition> a owl:Class ;
    rdfs:label "Condition" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="Condition">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ConditionType">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="Parameters">
						<xsd:complexType>
							<xsd:group ref="ParameterSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="SameAs" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ProxySelect" minOccurs="0" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionRelationship" type="ConditionRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ModelPropertyAssignment" type="ModelPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyDefinitionAssignment" type="PropertyDefinitionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyValueAssignment" type="PropertyValueAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SuppliedObjectRelationship" type="SuppliedObjectRelationship" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/PartViewRelationship> a owl:Class ;
    rdfs:label "PartViewRelationship" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="PartViewRelationship">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="ClassifiedAs" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Classification" type="cmn:Reference" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Description" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Id" type="Id" minOccurs="0"/>
					<xsd:element name="MaterialIdentification" type="MaterialIdentification" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="Related" type="cmn:Reference"/>
					<xsd:element name="RelationType">
						<xsd:complexType>
							<xsd:group ref="ClassSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ActivityAssignment" type="ActivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ActivityMethodAssignment" type="ActivityMethodAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ApprovalAssignment" type="ApprovalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="CertificationAssignment" type="CertificationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ConditionAssignment" type="ConditionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateAndPersonAssignment" type="DateAndPersonAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DateTimeAssignment" type="DateTimeAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="DocumentAssignment" type="DocumentAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EffectivityAssignment" type="EffectivityAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="EventAssignment" type="EventAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="FrozenAssignment" type="FrozenAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="InformationUsageRightAssignment" type="InformationUsageRightAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="ModelPropertyAssignment" type="ModelPropertyAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="OrganizationOrPersonInOrganizationAssignment" type="OrganizationOrPersonInOrganizationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyDefinitionAssignment" type="PropertyDefinitionAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="PropertyValueAssignment" type="PropertyValueAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="SecurityClassificationAssignment" type="SecurityClassificationAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="TimeIntervalAssignment" type="TimeIntervalAssignment" minOccurs="0" maxOccurs="unbounded"/>
					<xsd:element name="WorkRequestAssignment" type="WorkRequestAssignment" minOccurs="0" maxOccurs="unbounded"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/RepresentationItem> a owl:Class ;
    rdfs:label "RepresentationItem" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="RepresentationItem" abstract="true">
		<xsd:complexContent>
			<xsd:extension base="cmn:BaseObject">
				<xsd:sequence>
					<xsd:element name="External" type="ExternalItem" minOccurs="0"/>
					<xsd:element name="Name" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="DescriptorSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/cmn:BaseObject> .

<http://depo-onto.local/source#type/ConstituentPart> a owl:Class ;
    rdfs:label "ConstituentPart" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ConstituentPart">
		<xsd:complexContent>
			<xsd:extension base="PartView">
				<xsd:sequence>
					<xsd:element name="Weight" type="NumericalValue" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/PartView> .

<http://depo-onto.local/source#type/GeometricRepresentation> a owl:Class ;
    rdfs:label "GeometricRepresentation" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="GeometricRepresentation" abstract="true">
		<xsd:complexContent>
			<xsd:extension base="Representation"/>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Representation> .

<http://depo-onto.local/source#type/DetailedGeometricModelItem> a owl:Class ;
    rdfs:label "DetailedGeometricModelItem" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="DetailedGeometricModelItem" abstract="true">
		<xsd:complexContent>
			<xsd:extension base="RepresentationItem">
				<xsd:sequence/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/RepresentationItem> .

<http://depo-onto.local/source#type/ExternalGeometricModel> a owl:Class ;
    rdfs:label "ExternalGeometricModel" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ExternalGeometricModel">
		<xsd:complexContent>
			<xsd:extension base="GeometricModel">
				<xsd:sequence>
					<xsd:element name="ExternalFile" type="cmn:Reference"/>
					<xsd:element name="ParameterValues" minOccurs="0">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="PropertyValue" type="PropertyValue" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/GeometricModel> .

