<http://depo-onto.local/source#type/HighOrderKinematicPair> a owl:Class ;
    rdfs:label "HighOrderKinematicPair" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="HighOrderKinematicPair">
		<xsd:complexContent>
			<xsd:extension base="KinematicPair">
				<xsd:sequence>
					<xsd:element name="CurveOrSurface1">
						<xsd:complexType>
							<xsd:group ref="ExternalCurveOrSurfaceSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="CurveOrSurface2" minOccurs="0">
						<xsd:complexType>
							<xsd:group ref="ExternalCurveOrSurfaceSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="Kind" type="HighOrderKinematicPairTypeEnum"/>
					<xsd:element name="LowerLimitPitch" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitRoll" type="xsd:double" minOccurs="0"/>
					<xsd:element name="LowerLimitYaw" type="xsd:double" minOccurs="0"/>
					<xsd:element name="Model1" type="cmn:Reference"/>
					<xsd:element name="Model2" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="Orientation" type="xsd:boolean" minOccurs="0"/>
					<xsd:element name="Range1" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="Range2" type="cmn:Reference" minOccurs="0"/>
					<xsd:element name="UpperLimitPitch" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitRoll" type="xsd:double" minOccurs="0"/>
					<xsd:element name="UpperLimitYaw" type="xsd:double" minOccurs="0"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/KinematicPair> .

<http://depo-onto.local/source#type/HighOrderKinematicPairTypeEnum> a owl:Class ;
    rdfs:label "HighOrderKinematicPairTypeEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="HighOrderKinematicPairTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="linear_flexible_and_planar_curve_pair"/>
			<xsd:enumeration value="point_on_surface_pair"/>
			<xsd:enumeration value="point_on_planar_curve_pair"/>
			<xsd:enumeration value="planar_curve_pair"/>
			<xsd:enumeration value="rolling_curve_pair"/>
			<xsd:enumeration value="sliding_curve_pair"/>
			<xsd:enumeration value="rolling_surface_pair"/>
			<xsd:enumeration value="sliding_surface_pair"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/Id> a owl:Class ;
