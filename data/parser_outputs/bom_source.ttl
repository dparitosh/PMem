	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/Pcurve> .

<http://depo-onto.local/source#type/DeleteElement> a owl:Class ;
    rdfs:label "DeleteElement" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="DeleteElement">
		<xsd:complexContent>
			<xsd:extension base="DeltaChangeActivity">
				<xsd:sequence>
					<xsd:element name="PreviousDesignObject">
						<xsd:complexType>
							<xsd:group ref="DeltaChangeManagementObjectSelect" maxOccurs="unbounded"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
