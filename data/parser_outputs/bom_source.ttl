<http://depo-onto.local/source#type/ModifySingleElement> a owl:Class ;
    rdfs:label "ModifySingleElement" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="ModifySingleElement">
		<xsd:complexContent>
			<xsd:extension base="DeltaChangeActivity">
				<xsd:sequence>
					<xsd:element name="CurrentDesignObject">
						<xsd:complexType>
							<xsd:group ref="DeltaChangeManagementObjectSelect"/>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="PreviousDesignObject">
						<xsd:complexType>
							<xsd:group ref="DeltaChangeManagementObjectSelect"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/DeltaChangeActivity> .

<http://depo-onto.local/source#type/MomentsOfInertia> a owl:Class ;
    rdfs:label "MomentsOfInertia" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MomentsOfInertia">
		<xsd:complexContent>
			<xsd:extension base="ShapeDependentProperty">
				<xsd:sequence>
					<xsd:element name="InertiaValue">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="NumericalValue" type="NumericalValue" maxOccurs="9"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ReferenceAxisPlacement" type="cmn:Reference"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/ShapeDependentProperty> .

