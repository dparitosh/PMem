						<xsd:complexType>
							<xsd:group ref="ClassSelect" minOccurs="0"/>
						</xsd:complexType>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/AssemblyDefinition> .

<http://depo-onto.local/source#type/MatingTypeEnum> a owl:Class ;
    rdfs:label "MatingTypeEnum" ;
    src:sourceXml """<xsd:simpleType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="MatingTypeEnum">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="bolted_joint"/>
			<xsd:enumeration value="brazing"/>
			<xsd:enumeration value="clasping"/>
			<xsd:enumeration value="clinching"/>
			<xsd:enumeration value="clipping"/>
			<xsd:enumeration value="doweling"/>
			<xsd:enumeration value="flanging"/>
			<xsd:enumeration value="foam_injection"/>
			<xsd:enumeration value="gluing"/>
			<xsd:enumeration value="laser_welding"/>
			<xsd:enumeration value="press_fit"/>
			<xsd:enumeration value="riveting"/>
			<xsd:enumeration value="sewing"/>
			<xsd:enumeration value="spot_welding"/>
			<xsd:enumeration value="stapling"/>
			<xsd:enumeration value="welding"/>
			<xsd:enumeration value="soldering"/>
			<xsd:enumeration value="friction_welding"/>
		</xsd:restriction>
	</xsd:simpleType>
	""" .

<http://depo-onto.local/source#type/MeasureQualification> a owl:Class ;
