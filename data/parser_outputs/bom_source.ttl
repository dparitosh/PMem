<http://depo-onto.local/source#type/DirectionOfFiberOrientationWithinAPly> a owl:Class ;
    rdfs:label "DirectionOfFiberOrientationWithinAPly" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="DirectionOfFiberOrientationWithinAPly">
