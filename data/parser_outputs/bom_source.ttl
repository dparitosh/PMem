					<xsd:element name="Segments">
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="PathSegment" type="PathSegment" maxOccurs="unbounded"/>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="TStart" type="xsd:double"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	""" ;
    rdfs:subClassOf <http://depo-onto.local/source#type/RepresentationItem> .

<http://depo-onto.local/source#type/LaidOrientationAngle> a owl:Class ;
    rdfs:label "LaidOrientationAngle" ;
    src:sourceXml """<xsd:complexType xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://standards.iso.org/iso/ts/10303/-3001/-ed-2/tech/xml-schema/bo_model" xmlns:cmn="http://standards.iso.org/iso/ts/10303/-3000/-ed-2/tech/xml-schema/common" name="LaidOrientationAngle">
