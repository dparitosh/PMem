Domain_model:RiskEvent a oslc:ResourceShape,
        owl:Class ;
    rdfs:label "RiskEvent" ;
    oslc:describes Domain_model:RiskEvent ;
    oslc:property [ a oslc:Property ;
            oslc:name "Probability" ;
            oslc:occurs oslc:Zero-or-one ;
            oslc:propertyDefinition Domain_model:RiskEvent_Probability ] ;
    dc:source "Domain_model / Domain_model" ;
    rdfs:comment "Class from Domain_model. Source complexType 'RiskEvent'." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty Domain_model:RiskEvent_Probability ] .

