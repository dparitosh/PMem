    <packagedElement xmi:id="_18_4_1_8e001ed_1513262749843_799028_62496" xmi:uuid="1d25ed27-fcfd-454d-808f-514ae046d936" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1513333863492_712542_112835" xmi:uuid="e52ade33-73a7-435b-b3d4-47d61812914f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513262749843_799028_62496"/>
        <body>An EvaluatedRequirement represents a record of the comparison between the property defining the requirement and a measurement of the property exhibited by the product satisfying the requirement. The EvaluatedRequirement can be used as explicit evidence supporting the verification that the requirement has been satisfied.</body>
      </ownedComment>
      <name>EvaluatedRequirement</name>
      <generalization xmi:id="_18_4_1_8e001ed_1513262749843_466630_62502" xmi:uuid="1fa538e0-f3db-4633-a2a8-0ce5f7624f14" xmi:type="uml:Generalization">
