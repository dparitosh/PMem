    <packagedElement xmi:id="_18_4_1_e120334_1499417193231_102983_23823" xmi:uuid="e1812fdb-002b-4cd4-95fa-e67b8ecae57c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455705324928_549242_42649" xmi:uuid="17164de4-bca7-46de-b06e-fee40e39a04f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193231_102983_23823"/>
        <body>A RequirementTracingRelationship is a type of RequirementViewRelationship. It identifies a tracing relationship. &lt;example&gt;A requirement on the performance of a catalytic converter in a car may be traced from a more general emissions requirement. A requirement may trace to many other requirements and vice versa - this is achieved by creating multiple instances of the tracing relationship entity.&lt;/example&gt;</body>
      </ownedComment>
      <name>RequirementTracingRelationship</name>
      <generalization xmi:id="_18_4_1_e120334_1499417194027_912775_28790" xmi:uuid="c4f416a4-1501-4808-9468-0021c5bf3beb" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193235_212010_23827"/>
      </generalization>
