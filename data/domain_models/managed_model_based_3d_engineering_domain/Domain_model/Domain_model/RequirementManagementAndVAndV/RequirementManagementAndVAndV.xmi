    <packagedElement xmi:id="_18_4_1_e120334_1499417193228_408448_23819" xmi:uuid="8da33ebc-54b7-44df-adf6-d2a7768ce9a5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455705030418_187055_42631" xmi:uuid="af6cea7a-b5ef-4972-a93f-e0174c5d7a53" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193228_408448_23819"/>
        <body>A RequirementSatisfactionAssertion is a relationship between an item (specified in RequirementAssignmentSelect) and a Requirement (via the RequirementView), asserting that the item satisfies the identified requirement. &lt;example&gt;A data type used to represent a vehicle's engine with a power output of 160BHP could be asserted to satisfy a requirement "the vehicle shall have a maximum power output of at least 150BHP".&lt;/example&gt; </body>
      </ownedComment>
      <name>RequirementSatisfactionAssertion</name>
      <generalization xmi:id="_18_4_1_e120334_1499417194022_794249_28766" xmi:uuid="25834c08-57b8-4fcc-bd57-3241757050e4" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_e120334_1499417193259_964911_23867"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194022_385291_28767" xmi:uuid="72d480e5-49a7-415a-a9f7-322c725dc8e1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455705066766_24343_42632" xmi:uuid="c8adaf5c-7124-4f97-a0a7-228c8ea845b7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194022_385291_28767"/>
          <body> the identifier or set of identifiers for the RequirementSatisfactionAssertion. &lt;note&gt;This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194767_100370_34670" xmi:uuid="663b8a8a-cc1e-43d8-a852-3a453bcc56e4" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193742_708399_27286"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194023_546765_28768" xmi:uuid="93cafb4d-5aa5-4b64-93a3-cfa260de8d03" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455705080020_985622_42633" xmi:uuid="04d63430-6761-4ae9-8e1c-1ac50343d6ed" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194023_546765_28768"/>
          <body> the text or the set of texts that provide further information about the RequirementSatisfactionAssertion. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194767_495197_34673" xmi:uuid="b4145cdb-7985-4153-9e4c-bd5518d8ec1a" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193596_591532_26213"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194023_191245_28769" xmi:uuid="7a7455fa-cbe3-459d-a3b8-14b5ba120dd7" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455705089677_720846_42634" xmi:uuid="7e2e60f7-a34e-4f8f-9fe1-5fbf967ba404" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194023_191245_28769"/>
          <body> the classifications of the RequirementSatisfactionAssertion. The value of this attribute need not be specified.</body>
        </ownedComment>
