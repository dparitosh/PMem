    <packagedElement xmi:id="_18_4_1_e120334_1499417193228_495821_23818" xmi:uuid="56aab8dd-e8ab-4f91-92ab-7072fd4a4f6d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455704888163_739322_42624" xmi:uuid="b2ae83c5-5d24-4456-be68-5f14708bdb8d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193228_495821_23818"/>
        <body>A RequirementRelationship is a type of relationship that is used to relate previous Requirement (related) to the Requirement that replaces it (relating).</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551200217499_725788_128213" xmi:uuid="bc3f8f64-2a54-4625-a3f0-f10b1ac865df" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>RequirementRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332068802_75350_42718" xmi:uuid="07f81a31-2d5b-4a3e-9709-e9ad0f0df1a6" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121230_383535_163024" xmi:uuid="2dcb8929-bf60-4d40-a05c-39252d029ee3" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121231_611363_163025" xmi:uuid="8534c3ed-b3c4-4764-baae-7b216e185e5d" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//RequirementRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Requirement and the relating Requirement shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:RequirementRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121233_597657_163026" xmi:uuid="619182ab-e64c-457a-9214-0a6456c91bbd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121233_125105_163027" xmi:uuid="c79b5681-4d3a-43f1-ba66-b1f0e431fe28" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459332100100_23695_42720" xmi:uuid="b3914485-0bcf-48c2-8160-2f91f0042824" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332068802_75350_42718"/>
          <body>the related Requirement and the relating Requirement shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193228_495821_23818"/>
        <specification xmi:id="_18_4_1_271a0567_1509116638057_632379_31550" xmi:uuid="15687988-dd05-45f7-b825-dd69dd4289c7" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1705504974585_858136_151212" xmi:uuid="14822abc-7235-4f19-a511-69fde69c305f" xmi:type="uml:Generalization">
