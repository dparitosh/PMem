    <packagedElement xmi:id="_18_4_1_e120334_1499417193231_399808_23824" xmi:uuid="4cc17a8b-a1c9-4aa8-b6b1-0c3360de71cf" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1526655816683_608686_232053" xmi:uuid="2a6c4736-161d-436e-a284-e7cfada89c35" xmi:type="uml:Comment">
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Requirement_version-of_product"/>
        <body>Requirement.Versions provides the mapping of Requirement_version.of_product</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455705373486_744056_42650" xmi:uuid="b724e359-7936-44cc-9785-b5708a7c33f5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193231_399808_23824"/>
        <body>A RequirementVersion is the identification of a specific version of a requirement. &lt;note&gt; This entity is used to record different versions of a requirement. In this case, the word "version" implies "revision" - that is a specific release of a requirement. &lt;/note&gt;&lt;example&gt; A given requirement might have versions 1.0, 1.1, 1.2 and 2.0.&lt;/example&gt;</body>
      </ownedComment>
      <name>RequirementVersion</name>
