    <packagedElement xmi:id="_18_4_1_e120334_1499417193235_212010_23827" xmi:uuid="fe8a4b66-af15-4ba1-aa0f-84dabbcd1b95" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455705814448_41179_42672" xmi:uuid="a74595e8-eb64-4bd1-861e-7289bd4776b9" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193235_212010_23827"/>
        <body> A RequirementViewRelationship is a type of relationship that is used to relate previous view (related) of a requirement version to the view that replaces it (relating).</body>
      </ownedComment>
      <name>RequirementViewRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332177303_202752_42724" xmi:uuid="fa92b51d-54a5-4691-af31-d3a5919b69a4" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121225_657486_163020" xmi:uuid="511266c7-1009-47bf-ac44-f7be328f8104" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121226_899782_163021" xmi:uuid="b0f15b8d-676a-43c4-8209-4cb34b1fe26e" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//RequirementViewRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related RequirementView and the relating RequirementView shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:RequirementViewRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459332209198_167535_42726" xmi:uuid="9800aeeb-8b42-44c1-8801-891b86ed0116" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332177303_202752_42724"/>
          <body>the related RequirementView and the relating RequirementView shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121226_766761_163022" xmi:uuid="b3380726-960c-4701-b728-899b0efd5d33" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121226_286196_163023" xmi:uuid="14c6566a-76a2-4ad0-bad2-b8430a28de0b" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193235_212010_23827"/>
        <specification xmi:id="_18_4_1_271a0567_1509116755758_303765_31576" xmi:uuid="063b5782-3814-4f4c-a6da-4dd6e5c42d8f" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
