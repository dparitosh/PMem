    <packagedElement xmi:id="_18_4_1_e120334_1499417193744_498673_27297" xmi:uuid="bd5ef99f-dfcf-40fe-b025-e1876b02f47f" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_e120334_1499417194537_253453_32494"/>
      <memberEnd xmi:idref="_18_4_1_e120334_1499417194030_641581_28806"/>
