    <packagedElement xmi:id="_18_4_1_e120334_1499417193090_743362_23544" xmi:uuid="19003e60-c2c6-41e6-93cd-95b0e24ceeed" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456414813539_838178_43106" xmi:uuid="dea6a17f-865a-4c88-8eef-e7dbe61ad6ea" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193090_743362_23544"/>
        <body>An EvaluatedCharacteristic is a set of properties resulting from an evaluation or intended evaluation of product data. An EvaluatedCharacteristic object associates evaluation data with one or several PlannedCharacteristic objects for the purposes of traceability.</body>
      </ownedComment>
      <name>EvaluatedCharacteristic</name>
      <ownedRule xmi:id="_18_4_1_271a0567_1589530578768_703243_89978" xmi:uuid="9877eb06-8003-491a-aa7d-8e5ef14a17ee" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_271a0567_1594046701968_894550_91639" xmi:uuid="bca2ded2-8972-47c7-a68e-5c7896d35f47" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1589530578768_703243_89978"/>
          <body>the PropertyValue or set of PropertyValue of PlannedCharacteristic and MeasuredCharacteristic shall refer to the same PropertyDefinition.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759853_695781_151362" xmi:uuid="f4cad6dc-412c-4410-8053-245611ce19c9" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759853_898309_151363" xmi:uuid="7bee8336-6df2-43dd-9b83-2b555f04f38a" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//EvaluatedCharacteristic[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="planned_reference_uidRef" value="PlannedCharacteristic/@uidRef"/&gt; &lt;sch:let name="planned_reference" value="//*[@uid = $planned_reference_uidRef]"/&gt; &lt;sch:let name="planned_def" value="$planned_reference/PlannedCharacteristics/Definition/PropertyDefinition/@uidRef"/&gt; &lt;sch:let name="measured_reference_uidRef" value="ActualCharacteristic/@uidRef"/&gt; &lt;sch:let name="measured_reference" value="//*[@uid = $measured_reference_uidRef]"/&gt; &lt;sch:let name="measured_def" value="$measured_reference/MeasuredCharacteristics/Definition/PropertyDefinition/@uidRef"/&gt; &lt;sch:assert test="$measured_def = $planned_def"&gt; The PropertyValue or set of PropertyValue of PlannedCharacteristic and MeasuredCharacteristic shall refer to the same PropertyDefinition. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -planned_def:&lt;sch:value-of select="$planned_def"/&gt; -measured_def:&lt;sch:value-of select="$measured_def"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193090_743362_23544"/>
        <specification xmi:id="_18_4_1_271a0567_1589530578769_65329_89979" xmi:uuid="8205f321-448c-4363-b901-5b7c0483b95a" xmi:type="uml:OpaqueExpression">
          <body>self.ActualCharacteristic.MeasuredCharacteristics.Definition = self.PlannedCharacteristic.PlannedCharacteristics.Definition</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193658_827903_26736" xmi:uuid="71f67110-d710-45c2-8f0d-5595a406f694" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456414834124_569305_43107" xmi:uuid="0aa5b279-d192-41fa-88e3-e7a68ee1e498" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193658_827903_26736"/>
          <body> the identifier or set of identifiers for the EvaluatedCharacteristic. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193657_438647_26733"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193658_761260_26737" xmi:uuid="c88043ca-b7a7-40ad-b320-32026d25af59" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456414853865_819842_43108" xmi:uuid="c33a19d8-2b02-4b8e-9802-b5ca4dcab3c3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193658_761260_26737"/>
          <body> the words or set of words by which the EvaluatedCharacteristic is known. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multiple names in different contexts as well as multi-linguism.&lt;/note&gt;</body>
        </ownedComment>
