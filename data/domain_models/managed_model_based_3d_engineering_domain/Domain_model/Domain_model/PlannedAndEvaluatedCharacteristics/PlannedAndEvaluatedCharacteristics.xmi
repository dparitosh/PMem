        </ownedComment>
        <name>ActualCharacteristic</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193147_187035_23662"/>
        <association xmi:idref="_18_4_1_e120334_1499417193657_52916_26734"/>
