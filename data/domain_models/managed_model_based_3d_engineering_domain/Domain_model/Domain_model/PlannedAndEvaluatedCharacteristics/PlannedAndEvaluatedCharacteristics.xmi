      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193659_91974_26741" xmi:uuid="56b7a2f9-4a37-49e9-a798-434530265895" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456414916432_614826_43112" xmi:uuid="584db546-209c-4b44-953e-81cb27d67021" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193659_91974_26741"/>
          <body> the result of the evaluation. One of the following values shall be used: &lt;ul&gt;&lt;li&gt;'fail': the evaluation has failed; &lt;/li&gt;&lt;li&gt;'pass': the evaluation has passed; &lt;/li&gt;&lt;li&gt;'undefined': the evaluation result is neither 'fail' nor 'pass'.&lt;/li&gt;&lt;/ul&gt; </body>
        </ownedComment>
        <name>EvaluationResult</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193296_611643_23928"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8db01ea_1517820741127_526600_79587"/>
