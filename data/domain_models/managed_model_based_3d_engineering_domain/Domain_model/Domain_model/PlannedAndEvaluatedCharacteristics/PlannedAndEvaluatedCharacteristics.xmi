    <packagedElement xmi:id="_18_4_1_e120334_1499417193180_693086_23736" xmi:uuid="838dfd2b-3aea-4e48-bfa1-8b6bbaa0db63" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456415192418_724264_43123" xmi:uuid="499c3180-85c5-4ca2-9533-82c7db520042" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193180_693086_23736"/>
        <body>A PlannedCharacteristic is a means to associate design intent information based on manufacturing capabilities and component characteristics with an allocated requirement. A PlannedCharacteristic is a set of properties planned to be valid for all occurrences of the designed product under the conditions defined in the allocated requirement. &lt;note&gt; A PlannedCharacteristics may be used as basis for the evaluation of a product against its requirements by using EvaluatedCharacteristic.&lt;/note&gt; </body>
      </ownedComment>
      <name>PlannedCharacteristic</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193907_730054_28208" xmi:uuid="d68f38b7-8220-4074-997e-563fab7501db" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456415214936_390265_43124" xmi:uuid="0bc812ea-c02f-4973-96d0-b105c0d6b8d7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193907_730054_28208"/>
          <body> the words or set of words by which the PlannedCharacteristic is known. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multiple names in different contexts as well as multi-linguism.&lt;/note&gt;</body>
        </ownedComment>
        <name>Name</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194673_228434_33771" xmi:uuid="debf3986-fcac-4754-8d6a-098aa4b81b60" xmi:type="uml:LiteralInteger"/>
