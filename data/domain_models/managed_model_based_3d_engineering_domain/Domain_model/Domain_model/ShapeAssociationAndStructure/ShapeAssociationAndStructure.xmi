            <annotatedElement xmi:idref="_18_4_1_271a0567_1527174041841_447687_78401"/>
            <body>if the input is a PartInformationSelect then extract the Geometric_model of the DefiningGeometry attribute of the input else null.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1527174041826_175120_78399"/>
          <specification xmi:id="_18_4_1_271a0567_1527174041842_195706_78402" xmi:uuid="ecf25af4-9384-4a28-883b-de6fcdd1e078" xmi:type="uml:OpaqueExpression">
            <body>output = if input.oclIsKindOf(PartInformationSelect) then input.DefiningGeometry.geometricModel else null endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1527174087593_472849_78403" xmi:uuid="3d076304-a3bc-4e3c-95bf-220fc301e59d" xmi:type="uml:Port">
