    <packagedElement xmi:id="_18_4_1_af4021f_1713871290654_784026_140163" xmi:uuid="a96b21f5-1727-4f71-932e-acee3e9aa732" xmi:type="uml:Package">
      <name>Functions</name>
      <packagedElement xmi:id="_18_4_1_af4021f_1713871354609_323248_140172" xmi:uuid="23d8ee4d-a432-4c8d-91bd-9dea55455bcd" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_af4021f_1713871502399_498800_140176" xmi:uuid="df5d0479-10c4-47f0-9999-75adcea18be2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1713871354609_323248_140172"/>
          <body>The AcyclicOccurrenceShapeElement function determines whether the graph of instances of the entity data type OccurrenceShapeElement established by the attribute definition contains a cycle. The function returns TRUE if no cycle has been detected. Otherwise, it returns FALSE.</body>
        </ownedComment>
        <name>AcyclicOccurrenceShapeElement</name>
        <ownedRule xmi:id="_18_4_1_af4021f_1713871354629_321979_140174" xmi:uuid="447263d8-7761-46ec-a9bf-9d97de5bdee8" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_af4021f_1713871533815_548095_140179" xmi:uuid="afb0414d-bc23-447a-a081-f5a797ef70c2" xmi:type="uml:Comment">
            <ownedComment xmi:id="_18_4_1_af4021f_1713871760198_135703_140190" xmi:uuid="34eb35d1-5f13-492e-9231-48956fdc2814" xmi:type="uml:Comment">
              <body>&lt;xsl:function name="local-fn:AcyclicOccurrenceShapeElement"&gt; &lt;xsl:param name="dataContainer"/&gt; &lt;xsl:param name="occurrenceShapeElementUIDList"/&gt; &lt;xsl:variable name="occurrenceShapeElementUID" select="$occurrenceShapeElementUIDList[1]"/&gt; &lt;xsl:variable name="occurrence" select="$dataContainer/descendant::*[@uid =$occurrenceShapeElementUID]"/&gt; &lt;xsl:choose&gt; &lt;xsl:when test="count($occurrence/Definition)=0"&gt; &lt;xsl:value-of select="true()"/&gt; &lt;/xsl:when&gt; &lt;xsl:otherwise&gt; &lt;xsl:choose&gt; &lt;xsl:when test="some $i in $occurrenceShapeElementUIDList satisfies $i eq $occurrence/Definition/@uidRef"&gt; &lt;xsl:value-of select="false()"/&gt; &lt;/xsl:when&gt; &lt;xsl:otherwise&gt; &lt;xsl:value-of select="local-fn:AcyclicOccurrenceShapeElement($dataContainer , insert-before($occurrenceShapeElementUIDList, 0, $occurrence/Definition/@uidRef))"/&gt; &lt;/xsl:otherwise&gt; &lt;/xsl:choose&gt; &lt;/xsl:otherwise&gt; &lt;/xsl:choose&gt; &lt;/xsl:function&gt;</body>
            </ownedComment>
            <body>Schematron</body>
          </ownedComment>
          <constrainedElement xmi:idref="_18_4_1_af4021f_1713871354609_323248_140172"/>
          <specification xmi:id="_18_4_1_af4021f_1713871354629_305666_140175" xmi:uuid="9df8fdf9-0b8a-4409-986f-60beacefe5ad" xmi:type="uml:OpaqueExpression"/>
        </ownedRule>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193158_621792_23689" xmi:uuid="ab77d5ce-2489-4ff3-a78b-c1adfd04ae4f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1456218417246_307178_42996" xmi:uuid="7b027638-bee0-4f39-aaa8-fcd29ec97610" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193158_621792_23689"/>
        <body>An OccurrenceShapeElement is a type of ShapeElement. An OccurrenceShapeElement represents an element of the shape of an Occurrence. It might be defined by a PartShapeElement, a ShapeFeatureDefinition or another OccurrenceShapeElement from which it inherits all its characteristics.</body>
      </ownedComment>
      <name>OccurrenceShapeElement</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1533023907984_912327_88460" xmi:uuid="7c5d6bec-a368-4dcf-a04f-901d2bf628eb" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1713871144931_273814_139951" xmi:uuid="00c72271-855b-4575-9bb9-81900b13da05" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1713871154451_419940_139952" xmi:uuid="c6d35c71-8d50-40fc-ba9d-4a745af3a7de" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="names" value="child::Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:let name="followingAndPrecedingNames" value="following-sibling::ShapeElement[local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]/Name/descendant::*[self::CharacterString or self::LocalizedString] union preceding-sibling::ShapeElement[local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]/Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:assert test="count($names) = 0 or not(some $i in $names, $j in $followingAndPrecedingNames satisfies ($i eq $j))"&gt;(OccurrenceShapeElement.UR2: &lt;sch:value-of select="$uid"/&gt;) the name of the OccurrenceShapeElement shall be unique for the associated ElementOf.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1533024103492_69860_88462" xmi:uuid="ca5c6574-e43c-45ee-921e-6afd85647e7a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1533023907984_912327_88460"/>
          <body>The Name of the OccurrenceShapeElement shall be unique for the associated ElementOf. </body>
        </ownedComment>
        <name>UR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193158_621792_23689"/>
        <specification xmi:id="_18_4_1_8db01ea_1533023907984_676778_88461" xmi:uuid="972f1e25-033e-4808-9353-bff143283539" xmi:type="uml:OpaqueExpression">
          <body>OccurrenceShapeElement::allInstances()-&gt;isUnique(Sequence{Name, ElementOf})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_271a0567_1539264859342_522436_97755" xmi:uuid="8004082e-3baa-4e4b-82b6-4ba16b406ea9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_271a0567_1539264878279_642127_97757" xmi:uuid="37df1a3d-f1ac-481d-b3a8-787883132202" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539264982612_912572_97772" xmi:uuid="4fabb338-464d-4f0c-916e-dc867ca924d9" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1539264878279_642127_97757"/>
            <body>acyclic_occurrence_shape_element(SELF,definition)</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_271a0567_1539264859342_522436_97755"/>
          <body>A list of OccurrenceShapeElement instances linked by their Definition attribute values shall not be cyclic. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1713871190222_772086_139955" xmi:uuid="e83021e6-8ead-4a07-b85c-bdbd4f515ed8" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1713871199062_978212_139956" xmi:uuid="fabfeccc-cbf5-4493-a472-3c7f14ea5695" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="local-fn:AcyclicOccurrenceShapeElement(//DataContainer,$uid) = true()"&gt;(OccurrenceShapeElement.WR1 &lt;sch:value-of select="$uid"/&gt;) a list of OccurrenceShapeElement instances linked by their Definition attribute values shall not be cyclic.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193158_621792_23689"/>
        <specification xmi:id="_18_4_1_271a0567_1539264859342_62306_97756" xmi:uuid="00aecc75-2d9a-484f-82d8-c3b342dc08b8" xmi:type="uml:OpaqueExpression">
          <body>self.Definition-&gt;closure(Definition)-&gt;excludes(self)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1533023757624_769441_88457" xmi:uuid="8cd8edc0-2f13-4726-a9ef-2088ac38c2f9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1533023899140_756260_88459" xmi:uuid="422732fc-72cf-4d2d-985c-56f593a8328c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1533023757624_769441_88457"/>
          <body>There shall be at most one OccurrenceShapeElement of a particular Definition for an ElementOf. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1713870850465_900910_139945" xmi:uuid="e82460ec-aabc-4c31-bf3d-6e1344c5635e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1713870867634_98159_139948" xmi:uuid="e2557257-9d7a-4eb0-8304-51ba646f7313" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="definitionRef" value="child::Definition/@uidRef"&gt;&lt;/sch:let&gt; &lt;sch:assert test="not(child::Definition) or (count(following-sibling::ShapeElement[@uid and local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]/Definition[@uidRef=$definitionRef]) = 0 and count(preceding-sibling::ShapeElement[@uid and local-fn:testXsiTypeOccurrenceShapeElement(@xsi:type)=true()]/Definition[@uidRef=$definitionRef]) = 0 )"&gt;(OccurrenceShapeElement.UR1 &lt;sch:value-of select="$uid"/&gt;) there shall be at most one OccurrenceShapeElement of a particular Definition for an ElementOf.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
