    <packagedElement xmi:id="_18_4_1_e120334_1499417193244_138840_23841" xmi:uuid="7188eccb-e197-4c21-bfd4-0a48b1fc2820" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1551200538638_197608_129040" xmi:uuid="c3f28dfb-8dc0-4fdb-a266-2c3c59ce38d1" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1456415484661_581750_43135" xmi:uuid="d2702726-f204-4b46-9aa5-84408fd7b640" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193244_138840_23841"/>
        <body>A ShapeElementRelationship is an association between two ShapeElement objects.</body>
      </ownedComment>
      <name>ShapeElementRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332298453_297239_42730" xmi:uuid="f51c6538-2890-4900-8de4-78348df1c523" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459332333861_941072_42732" xmi:uuid="52a86f9a-52c2-4fe1-8eac-36ba90d6624b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332298453_297239_42730"/>
          <body>the related ShapeElement and the relating ShapeElement shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121977_256140_163212" xmi:uuid="6b9c842f-741e-4d00-a5da-1d526c01d99a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121977_473362_163213" xmi:uuid="b7e345bb-31a3-42c7-9725-57a97c1b6778" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ShapeElementRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related ShapeElement and the relating ShapeElement shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ShapeElementRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121977_677596_163214" xmi:uuid="ecd37cac-dc3c-4c58-9e85-238566ed2feb" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121977_285818_163215" xmi:uuid="c0bae7ad-5270-4866-85fd-b95d456a30b4" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193244_138840_23841"/>
        <specification xmi:id="_18_4_1_271a0567_1509116816755_351736_31590" xmi:uuid="43f4234d-6a2c-46b1-b3ff-f2a7c52703d8" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_271a0567_1527152190506_403555_102559" xmi:uuid="fb3a41f4-d0ca-4ed0-8dc0-0983973a6a20" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1713965755778_13603_138041" xmi:uuid="2ab42549-d1ec-49cb-86f2-49f4cba7741f" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_91401df_1713965768505_28691_138042" xmi:uuid="fb885ee4-c741-4db1-9219-ef7314ded1d2" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElementRelationship[@uid and child::RepresentedGeometry]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="parent::ShapeElement/parent::*/DefiningGeometry"&gt;(ShapeElementRelationship_WR2 &lt;sch:value-of select="$uid"/&gt;) if RepresentedGeometry is set then the object pointed out by the ElementOf of the Relating ShapeElement shall have a DefiningGeometry.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_271a0567_1527155406922_689835_112571" xmi:uuid="e9bf18c5-68ce-41bc-8796-1b009da2b293" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1527152190506_403555_102559"/>
          <body>If RepresentedGeometry is set then the object pointed out by the &lt;a&gt;&lt;path&gt;./4_info_reqs_ShapeAssociationAndStructure.htm#ShapeElement.ElementOf&lt;/path&gt; ElementOf&lt;/a&gt; of the Relating ShapeElement shall have a &lt;a&gt;&lt;path&gt;./4_info_reqs_ProductDataManagement.htm#AssemblyViewRelationship.DefiningGeometry&lt;/path&gt; DefiningGeometry&lt;/a&gt;. &lt;note&gt;The RepresentedGeometry of a ShapeElementRelationship is part of the &lt;a&gt;&lt;path&gt;./4_info_reqs_ProductDataManagement.htm#AssemblyViewRelationship.DefiningGeometry&lt;/path&gt; DefiningGeometry&lt;/a&gt; of which the Relating ShapeElement is an &lt;a&gt;&lt;path&gt;./4_info_reqs_ShapeAssociationAndStructure.htm#ShapeElement.ElementOf&lt;/path&gt; ElementOf&lt;/a&gt;.&lt;/note&gt;</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193244_138840_23841"/>
        <specification xmi:id="_18_4_1_271a0567_1527152190506_166931_102560" xmi:uuid="fa2fccbd-df18-4d42-9649-9fc8211de9ea" xmi:type="uml:OpaqueExpression">
          <body>not(self.RepresentedGeometry.oclIsUndefined()) implies not(self.Relating.ElementOf.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::AssemblyViewRelationship).DefiningGeometry.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
