          <annotatedElement xmi:idref="_18_4_1_271a0567_1527174041826_175120_78399"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>GetGeometricModel</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1527174041841_447687_78401" xmi:uuid="226b472b-820f-4a3a-b280-1d28b9ab36fb" xmi:type="uml:Constraint">
