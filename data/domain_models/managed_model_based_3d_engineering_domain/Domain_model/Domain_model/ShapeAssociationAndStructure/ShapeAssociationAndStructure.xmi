  <sysml:NestedConnectorEnd xmi:id="_18_4_1_8db01ea_1513870605089_567702_69336" xmi:uuid="f326d2d0-fa39-013a-046d-52540000fd3c">
    <propertyPath xmi:idref="_18_4_1_8db01ea_1513870567269_694810_69051"/>
    <base_ConnectorEnd xmi:idref="_18_4_1_8db01ea_1513870605077_862400_69330"/>
