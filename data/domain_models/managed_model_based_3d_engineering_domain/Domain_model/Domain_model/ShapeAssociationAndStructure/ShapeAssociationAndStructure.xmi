    <packagedElement xmi:id="_18_4_1_8db01ea_1505465344410_911545_27512" xmi:uuid="75f18e36-24a8-4c09-ab45-36092e2ab6fb" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1513270089729_213477_63907" xmi:uuid="2dbc147f-31c1-40e4-a2ed-f4d1be568685" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1505465344410_911545_27512"/>
        <body>A ShapeFeatureDefinitionElementRelationship is a type of ShapeElementRelationship that relates two ShapeFeatureDefinitionElements.</body>
      </ownedComment>
      <name>ShapeFeatureDefinitionElementRelationship</name>
      <ownedRule xmi:id="_18_4_1_271a0567_1517484913990_395165_122144" xmi:uuid="d0cf2640-b402-400d-bb12-f6c5bba678e7" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1713965953245_697296_138072" xmi:uuid="443688be-0883-40e6-8bf0-c9f7736e545f" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_91401df_1713965963990_442873_138073" xmi:uuid="442fc709-7966-4763-8263-97d13b877a8c" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElementRelationship[@uid and local-fn:testXsiTypeShapeFeatureDefinitionElementRelationship(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatedUid" value="child::Related/@uidRef"/&gt; &lt;sch:let name="elementOfTheRelated" value="//*[@uid=$relatedUid]/parent::*/@uid"/&gt; &lt;sch:let name="parentRelUid" value="child::ParentRelationship/@uidRef"/&gt; &lt;sch:let name="relatedOfParentRelationship " value="//*[@uid=$parentRelUid]/child::Related/@uidRef"/&gt; &lt;sch:let name="elementOfRelating " value="parent::*/parent::*/@uid"/&gt; &lt;sch:let name="relatingParentRelationship" value="//*[@uid=$parentRelUid]/parent::*/@uid"/&gt; &lt;sch:assert test="not(child::ParentRelationship) or ($elementOfTheRelated eq $relatedOfParentRelationship and $elementOfRelating eq $relatingParentRelationship)" &gt;(ShapeFeatureDefinitionElementRelationship.WR1 &lt;sch:value-of select="$uid"/&gt;)if the ParentRelationship is defined, then the ElementOf (&lt;sch:value-of select="$elementOfTheRelated"/&gt;) of the Related (&lt;sch:value-of select="$relatedUid"/&gt;) attribute shall be the same instance as the Related (&lt;sch:value-of select="$relatedOfParentRelationship"/&gt;) instance of the ParentRelationship (&lt;sch:value-of select="$parentRelUid"/&gt;) and the ElementOf (&lt;sch:value-of select="$elementOfRelating"/&gt;) of the Relating attribute shall be the same instance as the Relating (&lt;sch:value-of select="$relatingParentRelationship"/&gt;)instance of the ParentRelationship&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_271a0567_1517485360490_612494_122162" xmi:uuid="f4f255e2-d64e-4f3e-86a7-5024974fc1fe" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1517565737976_687035_122524" xmi:uuid="c7d99501-222c-46b1-b4b1-fade73f171b8" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1517485360490_612494_122162"/>
            <body>EXPRESS WR: ((Related.ElementOf :=: ParentRelationship\ShapeFeatureDefinitionRelationship.Related) OR (Related.ElementOf :=: ParentRelationship\ShapeFeatureDefinitionElementRelationship.related)) AND ((Relating.ElementOf :=: ParentRelationship\ShapeFeatureDefinitionRelationship.Relating) OR (Relating.ElementOf :=: ParentRelationship\ShapeFeatureDefinitionElementRelationship.relating));</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_271a0567_1517484913990_395165_122144"/>
          <body>if the ParentRelationship is defined, then the &lt;a&gt;&lt;path&gt;./4_info_reqs_ShapeAssociationAndStructure.htm#ShapeFeatureDefinitionElement.ElementOf&lt;/path&gt; ElementOf&lt;/a&gt; of the Related attribute shall be the same instance as the Related instance of the ParentRelationship and the &lt;a&gt;&lt;path&gt;./4_info_reqs_ShapeAssociationAndStructure.htm#ShapeFeatureDefinitionElement.ElementOf&lt;/path&gt; ElementOf&lt;/a&gt; of the Relating attribute shall be the same instance as the Relating instance of the ParentRelationship.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_8db01ea_1505465344410_911545_27512"/>
        <specification xmi:id="_18_4_1_271a0567_1517484914000_967707_122145" xmi:uuid="3a388c82-6bdc-41f8-8110-bf48f635e22d" xmi:type="uml:OpaqueExpression">
          <body>((self.Related.ElementOf = self.ParentRelationship.oclAsType(ShapeFeatureDefinitionRelationship).Related) or (self.Related.ElementOf = self.ParentRelationship.oclAsType(ShapeFeatureDefinitionElementRelationship).Related)) and ((self.Relating.ElementOf = self.ParentRelationship.oclAsType(ShapeFeatureDefinitionRelationship).Relating) or (self.Relating.ElementOf = self.ParentRelationship.oclAsType(ShapeFeatureDefinitionElementRelationship).Relating))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1505468722727_48409_28929" xmi:uuid="3f0eb758-4c4c-413e-840c-011db94801ae" xmi:type="uml:Generalization">
