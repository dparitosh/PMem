    <packagedElement xmi:id="_18_4_1_8db01ea_1505465188750_78459_27335" xmi:uuid="446c32a1-782c-418a-b64f-f82ed6906654" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1513269790087_264849_63904" xmi:uuid="9c1ab524-6b27-4e14-8af9-7a4623023662" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1505465188750_78459_27335"/>
        <body>A ShapeFeatureDefinitionElement is a type of ShapeElement that represents a part of the shape of a ShapeFeatureDefinition. </body>
      </ownedComment>
      <name>ShapeFeatureDefinitionElement</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1512555427940_891051_42340" xmi:uuid="f29a4ebc-2384-43ca-ac98-0c158c0b26d7" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512555474163_595364_42344" xmi:uuid="3bb25c68-3988-4d81-a86d-e8b3f4bc07ee" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1517565699153_361172_122521" xmi:uuid="66a89122-e1c4-44e8-a67d-97455f7d503a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1512555474163_595364_42344"/>
            <body>EXPRESS UR: SELF\ShapeElement.Name, ElementOf</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1512555427940_891051_42340"/>
          <body> The Name of the ShapeFeatureDefinitionElement shall be unique for the ElementOf. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1713965866698_120616_138058" xmi:uuid="54d608af-4704-4c93-bc5a-20114aa9cfdf" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_91401df_1713965901227_822926_138059" xmi:uuid="04d2b1ba-83f7-4401-a6ec-f8e7bd44ecfe" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypeShapeFeatureDefinitionElement(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="names" value="child::Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:let name="followingAndPrecedingNames" value="following-sibling::ShapeElement[local-fn:testXsiTypeShapeFeatureDefinitionElement(@xsi:type)=true()]/Name/descendant::*[self::CharacterString or self::LocalizedString] union preceding-sibling::ShapeElement[local-fn:testXsiTypeShapeFeatureDefinitionElement(@xsi:type)=true()]/Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:assert test="count($names) = 0 or not(some $i in $names, $j in $followingAndPrecedingNames satisfies ($i eq $j))"&gt;(ShapeFeatureDefinitionElement.UR1 &lt;sch:value-of select="$uid"/&gt;) the Name of the ShapeFeatureDefinitionElement shall be unique for the ElementOf. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_8db01ea_1505465188750_78459_27335"/>
        <specification xmi:id="_18_4_1_8db01ea_1512555427942_282586_42341" xmi:uuid="5429a91a-c9b5-438c-807b-3caa16b840c8" xmi:type="uml:OpaqueExpression">
          <body>ShapeFeatureDefinitionElement::allInstances()-&gt;isUnique(Sequence{Name, ElementOf})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
