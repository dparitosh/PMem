          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_643096_29451"/>
          <body>contact with which a connection is achieved by axial force, separation being restricted by friction [IEV ref 581-27-04].</body>
        </ownedComment>
        <name>push_on_contact_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680886362_866294_60802" xmi:uuid="7f9c74f8-9396-4b70-aa49-2ec501646307" xmi:type="uml:Slot">
