    <packagedElement xmi:id="_18_4_1_e120334_1499417193159_532460_23691" xmi:uuid="8f44616a-0a76-41d2-8177-dc1a3e07ab91" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455612887536_51961_42537" xmi:uuid="37d584fa-72c6-4b6c-90ee-15ae5ae1e831" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193159_532460_23691"/>
        <body>An OccurrenceTerminal is a type of OccurrenceContactFeature that can be joined with another OccurrenceTerminal for the purpose of transporting information, energy or matter. </body>
      </ownedComment>
      <name>OccurrenceTerminal</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1512404247115_683412_42634" xmi:uuid="7fcf7ae0-026f-4775-84f6-2fcce0700fe6" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365827_440639_149319" xmi:uuid="a0e7552a-b07d-4c27-9380-398549555b8e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365827_281727_149320" xmi:uuid="ad87d2b4-7f59-44b3-b07d-6776d26a07b3" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='OccurrenceTerminal']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="associatedTransportFeatureRef" value="child::AssociatedTransportFeature/@uidRef"/&gt; &lt;sch:let name="occurence" value="ancestor::Occurrence[position()=1]/@uid"/&gt; &lt;sch:let name="occurenceATF" value="//*[@uid = $associatedTransportFeatureRef]/ancestor::Occurrence[position()=1]/@uid"/&gt; &lt;sch:assert test="count($associatedTransportFeatureRef) = 0 or ($occurence eq $occurenceATF)"&gt;(OccurrenceTerminal.WR1 &lt;sch:value-of select="$uid"/&gt;) in the case that the AssociatedTransportFeature is defined then the reference OccurrenceTransportFeature shall refer to the same Occurrence as the OccurrenceTerminal. [AssociatedTransportFeature Occurrence &lt;sch:value-of select="$occurence"/&gt; / OccurrenceTerminal Occurrence &lt;sch:value-of select="$occurenceATF"/&gt; ]&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1512404366459_847737_42639" xmi:uuid="bd3605a1-fde5-4210-a88f-cd2c37dd47c4" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1512404247115_683412_42634"/>
          <body>in the case that the AssociatedTransportFeature is defined then the reference OccurrenceTransportFeature shall refer to the same Occurrence as the OccurrenceTerminal. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193159_532460_23691"/>
        <specification xmi:id="_18_4_1_8db01ea_1512404247116_816660_42635" xmi:uuid="08518789-f20e-44cf-93e6-9a582fbdbd44" xmi:type="uml:OpaqueExpression">
          <body>not self.AssociatedTransportFeature.oclIsUndefined() implies self-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined()) = self.AssociatedTransportFeature-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined()) </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1502196396024_155085_46643" xmi:uuid="3f67cb35-974c-4a72-9199-2dfb5e1b287c" xmi:type="uml:Generalization">
