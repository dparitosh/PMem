    <packagedElement xmi:id="_18_4_1_e120334_1499417193059_500180_23488" xmi:uuid="1be7c4c7-6774-4659-8bbd-e143ea415842" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1454431685986_773153_42736" xmi:uuid="6fbb9073-256d-423d-a096-03dee38c5970" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193059_500180_23488"/>
        <body>A CrossSectionalAlternativePartShapeElement is a type of CrossSectionalPartShapeElement that is an alternative between one or more CrossSectionalOccurrenceShapeElement or CrossSectionalPartShapeElement for the same purpose. At one position on a specific HarnessSegment, there is exactly one CrossSectionalOccurrenceShapeElement or CrossSectionalPartShapeElement. &lt;example&gt; A splice connecting two wires at a HarnessNode where each WireOccurrence has the same purpose and does not change the cross section of the HarnessSegment.&lt;/example&gt;</body>
      </ownedComment>
      <name>CrossSectionalAlternativePartShapeElement</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193554_998081_25933" xmi:uuid="516fb0f6-d11a-4a7b-928c-6145dba76c64" xmi:type="uml:Generalization">
