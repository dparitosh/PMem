    <packagedElement xmi:id="_18_4_1_e120334_1499417193167_780693_23710" xmi:uuid="3f637b30-abb1-4e0f-a407-5188098e7370" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455613466960_632881_42539" xmi:uuid="265c5a94-e621-4fc4-8611-a80e68da6b83" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193167_780693_23710"/>
        <body>A PartTerminal is a type of PartContactFeature that can be used within an assembly as the definition of an OccurrenceTerminal that can be joined with another OccurrenceTerminal to transport information, energy or matter. </body>
      </ownedComment>
      <name>PartTerminal</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1512403404466_512704_42120" xmi:uuid="c23342f0-3dcd-4f08-a1a1-2215b993aab9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365839_930739_149323" xmi:uuid="d7bd7a4f-2eaf-4646-a533-0a066ed62384" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365839_105670_149324" xmi:uuid="94d97316-aed3-44a5-ba29-38153c3959f8" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='PartTerminal']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="associatedTransportFeatureUid" value="child::AssociatedTransportFeature/@uidRef"/&gt; &lt;sch:assert test="not(child::DomainType) or not(//*[@uid=$associatedTransportFeatureUid]/DomainType) or DomainType eq //*[@uid=$associatedTransportFeatureUid]/DomainType"&gt;(PartTerminal.WR2 &lt;sch:value-of select="$uid"/&gt;) the optional DomainType shall have the same value as the one from the AssociatedTransportFeature if defined.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1512403491597_296090_42123" xmi:uuid="f1efacd6-88ab-44d8-83e2-e99dca89e298" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539246920933_930697_102516" xmi:uuid="078914e9-35fd-4e94-96ab-0f9f509c2a33" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1512403491597_296090_42123"/>
            <body>DomainType :=: AssociatedTransportFeature.DomainType;</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1512403404466_512704_42120"/>
          <body>the optional DomainType shall have the same value as the one from the AssociatedTransportFeature if defined. </body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193167_780693_23710"/>
        <specification xmi:id="_18_4_1_8db01ea_1512403404466_166092_42121" xmi:uuid="4f059042-a909-4b3b-9282-4acf6125b99e" xmi:type="uml:OpaqueExpression">
          <body>not self.AssociatedTransportFeature.DomainType.oclIsUndefined() implies self.DomainType = self.AssociatedTransportFeature.DomainType</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1512402575656_411872_42113" xmi:uuid="d7cfafed-a586-4193-9866-8efa4b0af76e" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365834_233724_149321" xmi:uuid="c70ab012-5d71-4058-b62a-e0fedda6377e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365834_96391_149322" xmi:uuid="04b24848-96f7-48be-84fc-d5b0ab8570a4" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='PartTerminal']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="associatedTransportFeatureUid" value="child::AssociatedTransportFeature/@uidRef"/&gt; &lt;sch:assert test="not(child::AssociatedTransportFeature) or ancestor::PartView/@uid eq //*[@uid=$associatedTransportFeatureUid]/ancestor::PartView/@uid"&gt;(PartTerminal.WR1 &lt;sch:value-of select="$uid"/&gt;) the optional chain of ElementOfs of the PartTerminal shall end in the same PartView as the optional chain of ElementOfs of the AssociatedTransportFeatures.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1512403360509_721446_42119" xmi:uuid="d7e32e2a-c7a5-46fc-97c6-f111469aca3f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1512402575656_411872_42113"/>
          <body>the optional chain of ElementOfs of the PartTerminal shall end in the same PartView as the optional chain of ElementOfs of the AssociatedTransportFeatures. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193167_780693_23710"/>
        <specification xmi:id="_18_4_1_8db01ea_1512402575656_884666_42114" xmi:uuid="a7d71876-d493-46ae-b53b-cb262644e407" xmi:type="uml:OpaqueExpression">
          <body>self-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined()) = self.AssociatedTransportFeature-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined()) </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1502368218688_684653_48635" xmi:uuid="012c530b-d7c8-4e8e-9b8e-a93892ded700" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_8db01ea_1502367439757_727889_48488"/>
      </generalization>
