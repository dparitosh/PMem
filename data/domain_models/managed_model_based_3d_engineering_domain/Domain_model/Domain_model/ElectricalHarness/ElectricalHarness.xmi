      <ownedAttribute xmi:id="_18_4_1_8db01ea_1502181906049_343399_37518" xmi:uuid="68547626-7092-4122-ae77-643c7066e2e6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512401984370_3838_41599" xmi:uuid="4a6da4e4-20f6-4fc6-a9ab-80863425915d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1502181906049_343399_37518"/>
          <body>the category for the joint assembly method for this ContactFeatureDefinitionFitRelationship. The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>JointType</name>
