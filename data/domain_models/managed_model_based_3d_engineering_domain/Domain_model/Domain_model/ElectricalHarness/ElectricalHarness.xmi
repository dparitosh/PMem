    <packagedElement xmi:id="_18_4_1_e120334_1499417193179_767652_23732" xmi:uuid="d4137f5c-88f5-49c3-8701-3c87335aafdd" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1512404558077_798789_42644" xmi:uuid="7be8626f-b170-45b7-8ff6-8967b563823b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193179_767652_23732"/>
        <body>A PartConnectivityDefinition is a type of PartShapeElement that defines a connection between two or more PartTerminals or OccurrenceTerminals within an AssemblyDefinition but without stating the details how these terminals are connected with each other. </body>
      </ownedComment>
      <name>PartConnectivityDefinition</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1512404636522_187757_42646" xmi:uuid="f414055d-1ae9-4032-a756-e1ca4eaec711" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365872_585679_149333" xmi:uuid="2583f51a-2616-4532-a87e-ee5dd454c631" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365873_806392_149334" xmi:uuid="9937a9c5-9cba-4e62-ad36-60f0cef04d08" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='PartConnectivityDefinition']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="connectedTerminalsUidRefs" value="child::ConnectedTerminals/child::*/@uidRef"/&gt; &lt;sch:let name="partView" value="ancestor::PartView/@uid"/&gt; &lt;sch:let name="partsTerminalsPartView" value="for $i in $connectedTerminalsUidRefs return //*[@uid=$i and substring-after(@xsi:type,':')='PartTerminal']/ancestor::PartView/@uid"/&gt; &lt;sch:let name="occurrenceTerminals" value="for $i in $connectedTerminalsUidRefs return //*[@uid=$i and substring-after(@xsi:type,':')='OccurrenceTerminal']"/&gt; &lt;sch:let name="occurrenceTerminalsOccurence" value="for $i in $occurrenceTerminals return if (count($i/ancestor::Occurrence[@uid and substring-after(@xsi:type,':')='SpecifiedOccurrence']) = 0) then $i/ancestor::Occurrence[@uid]/@uid else local-fn:MainUpperUsage(//DataContainer, $i/ancestor::Occurrence[@uid and substring-after(@xsi:type,':')='SpecifiedOccurrence'][position()=1]/@uid)"/&gt; &lt;sch:let name="resultOccurrenceTerminal" value="for $i in $occurrenceTerminalsOccurence return (some $j in //PartView[child::ViewOccurrenceRelationship/Related/@uidRef=$i]/@uid satisfies ($j eq $partView))"/&gt; &lt;sch:assert test="((every $j in $partsTerminalsPartView satisfies ($j eq $partView)) != false()) and (every $i in $resultOccurrenceTerminal satisfies ($i != false()))"&gt;(PartConnectivityDefinition.WR1 &lt;sch:value-of select="$uid"/&gt; ) each terminal (&lt;sch:value-of select="$connectedTerminalsUidRefs"/&gt;) in the set of ConnectedTerminals shall be accessible within the PartView or AssemblyDefinition (&lt;sch:value-of select="$partView"/&gt;) that can be reached by the ElementOf. In the case the terminal is of type OccurrenceTerminal then a potential chain of ElementOfs has to be followed until a Occurrence is reached. If this Occurrence is of type SpecifiedOccurrence a potential chain of UpperUsages is to be followed to a top Occurrence that shall be related to the same AssemblyDefinition by a NextAssemblyOccurrenceUsage. In the case the terminal is of type PartTerminal then following a potential chain of ElementOfs shall lead to the same AssemblyDefinition.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1512404752438_506618_42649" xmi:uuid="f85a7c71-e10b-45d3-bc71-0497676f7923" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1549030535292_612232_114414" xmi:uuid="94193809-5921-4874-a1a9-c2d7af28fa31" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1512404752438_506618_42649"/>
            <body>terminal_usage_check( main_ElementOf(ElementOf), ConnectedTerminals);</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1512404636522_187757_42646"/>
          <body>each terminal in the set of ConnectedTerminals shall be accessible within the PartView or AssemblyDefinition that can be reached by the ElementOf. In the case the terminal is of type OccurrenceTerminal then a potential chain of ElementOfs has to be followed until a Occurrence is reached. If this Occurrence is of type SpecifiedOccurrence a potential chain of UpperUsages is to be followed to a top Occurrence that shall be related to the same AssemblyDefinition by a NextAssemblyOccurrenceUsage. In the case the terminal is of type PartTerminal then following a potential chain of ElementOfs shall lead to the same AssemblyDefinition. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193179_767652_23732"/>
        <specification xmi:id="_18_4_1_8db01ea_1512404636523_420558_42647" xmi:uuid="600e7009-abbb-4517-9f3d-53fb15c063b1" xmi:type="uml:OpaqueExpression">
          <body>self.ConnectedTerminals-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined())-&gt;includes(self-&gt;closure(ElementOf)-&gt;select(e | e.ElementOf.oclIsUndefined()))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193872_749359_28021" xmi:uuid="22fe0131-dd0f-4962-8960-4fae815a2907" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193167_537105_23709"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193905_857064_28197" xmi:uuid="27e3b1d8-0db6-4386-952a-0518f16637a3" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512404615252_325225_42645" xmi:uuid="9776e586-6421-4c51-965a-b8850daa0810" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193905_857064_28197"/>
          <body> the set of PartTerminals or OccurrenceTerminals that are connected with each other. </body>
        </ownedComment>
