    <packagedElement xmi:id="_18_4_1_e120334_1499417193116_591246_23603" xmi:uuid="a1a02395-17e5-419e-b645-56bb52c389a2" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1453375576514_314280_48081" xmi:uuid="2bf3b23a-969e-4ad7-b171-dab60c324c23" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193116_591246_23603"/>
        <body>A HarnessSegment is a type of PartShapeElement that represents an Edge from a ConnectedEdgeWithLengthSetRepresentation for a WiringHarnessAssemblyDesign. </body>
      </ownedComment>
      <name>HarnessSegment</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1522747266630_592526_66507" xmi:uuid="70a58d39-d539-49e3-b61a-074deb8eab2f" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1522747303680_718281_66509" xmi:uuid="778b7f2d-ceeb-4c53-9be8-9ff7fe9d1ee1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1522747266630_592526_66507"/>
          <body>An Edge shall be used at most once by a HarnessSegment within a WiringHarnessAssemblyDesign. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365785_809923_149307" xmi:uuid="9d838d2f-48d8-4655-8578-bf7a1213f75a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365785_906837_149308" xmi:uuid="798726ef-4343-4322-9af0-e85c39ce7273" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign']/ShapeElement[@uid or substring-after(@xsi:type,':')='HarnessSegment']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="edge" value="child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:let name="followingAndPrecedingHarnessNodeEdges" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessSegment']/child::RepresentedGeometry/@uidRef union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessSegment']/child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:assert test="not(some $i in $followingAndPrecedingHarnessNodeEdges satisfies ($i eq $edge))"&gt;(HarnessSegment.UR1: &lt;sch:value-of select="$uid"/&gt;) An Edge shall be used at most once by a HarnessSegment within a WiringHarnessAssemblyDesign&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193116_591246_23603"/>
        <specification xmi:id="_18_4_1_8db01ea_1522747266631_691765_66508" xmi:uuid="f7447300-602b-4c6c-9844-f400ee2a9b68" xmi:type="uml:OpaqueExpression">
          <body>HarnessSegment::allInstances()-&gt;isUnique(Sequence{RepresentedGeometry, ElementOf})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460639501457_405042_48876" xmi:uuid="d500e907-cf2b-4956-8532-3fe5cb80046b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_2_8db01ea_1460639528661_281473_48879" xmi:uuid="0ed16afa-1e15-4412-9543-17939e10be44" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460639501457_405042_48876"/>
          <body>the RepresentedGeometry shall be founded in the ElementOf.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365790_937360_149309" xmi:uuid="7862d79b-41f8-483e-8790-6c2e84500e44" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365790_212855_149310" xmi:uuid="97c1ca00-a84a-4da5-a512-76f8542f3210" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='HarnessSegment']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="edgeRef" value="child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:let name="topologyRef" value="parent::*/Topology/@uidRef"/&gt; &lt;sch:let name="reps" value="local-fn:UsingRepresentations(//DataContainer,//RepresentationItem[@uid=$edgeRef])"/&gt; &lt;sch:assert test="some $j in $reps satisfies ($j eq $topologyRef)"&gt;(HarnessSegment.WR1: &lt;sch:value-of select="$uid"/&gt;) the RepresentedGeometry (&lt;sch:value-of select="$edgeRef"/&gt;) shall be found in the ElementOf.Topology (&lt;sch:value-of select="$topologyRef"/&gt;). (&lt;sch:value-of select="$edgeRef"/&gt;) is used in the following Representations:(&lt;sch:value-of select="$reps"/&gt;)&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193116_591246_23603"/>
        <specification xmi:id="_18_4_1_8db01ea_1513241421463_470387_44292" xmi:uuid="3466f57f-b9be-44f9-b399-97631279fdde" xmi:type="uml:OpaqueExpression">
          <body>Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::Representation::allInstances()-&gt;select(i | i.Items-&gt;includes(self.RepresentedGeometry))-&gt;includes(self.ElementOf.Topology) </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193720_266323_27174" xmi:uuid="982cb287-55c1-4322-8797-44a85c4fde5f" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193167_537105_23709"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193721_53166_27175" xmi:uuid="3890a3f3-3ae1-4576-a0b2-7f6618c6cfc0" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8db01ea_1455611523629_191637_42526" xmi:uuid="1451dcd5-be26-45b3-aa1a-42de15ae75a0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193721_53166_27175"/>
          <body>the cross-sectional structure for the Edge. The value of this attribute need not be specified.</body>
