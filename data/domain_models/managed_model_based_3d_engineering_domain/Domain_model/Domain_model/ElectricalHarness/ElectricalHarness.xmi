    <packagedElement xmi:id="_18_4_1_e120334_1499417193288_397213_23914" xmi:uuid="d4b44b84-3d74-4a0d-aac4-e7b21389d832" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455617640124_343361_42709" xmi:uuid="d03bb372-1876-4d2a-bf12-60d37658db32" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193288_397213_23914"/>
        <body>A WiringHarnessAssemblyDesign is a type of AssemblyDefinition. A WiringHarnessAssemblyDesign is a design view of a wiring harness assembly that is designed to allow for installation and removal as a unit. It contains any number of wire harness components that include connectors, contacts, wires, cables, and protections.</body>
      </ownedComment>
      <name>WiringHarnessAssemblyDesign</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193381_182805_24645" xmi:uuid="dc41152b-5cb1-4827-bda6-6cc1a791d314" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193021_203823_23401"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194120_420732_29193" xmi:uuid="2f0fbd67-0184-4c56-9a15-a0ce75ce266f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8db01ea_1455617675203_476801_42710" xmi:uuid="6b7d4691-fa98-40c9-8561-2dea01ad0512" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194120_420732_29193"/>
          <body>the topological structure of the harness consisting of segments and nodes. The value of this attribute need not be specified. &lt;note&gt;A node of the harness is represented by a Vertex, while a segment of the harness is represented by an Edge.&lt;/note&gt;</body>
        </ownedComment>
        <name>Topology</name>
        <visibility>public</visibility>
        <type href="../Topology/Topology.xmi#_18_4_1_e120334_1499417193054_780176_23475"/>
