    <packagedElement xmi:id="_18_4_1_e120334_1499417193034_713560_23435" xmi:uuid="462083c0-e76b-459f-b359-a1213c4892f9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1453816558160_315942_42493" xmi:uuid="37017a52-e082-4b7f-b4f6-5c49275555b9" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193034_713560_23435"/>
        <body>A CableOccurrenceTerminalLocationGroup is a type of OccurrenceTerminal that represents the grouping of CableOccurrenceTerminals on one of the ends, or at intermediate positions between the ends, of a CableOccurrence. The CableOccurrenceTerminalLocationGroups at the ends of the cable are named "end a" and "end b" respectively. CableOccurrenceTerminalLocationGroups in the middle of the cable shall start with the letters "intermediate" followed by arbitrary text.</body>
      </ownedComment>
      <name>CableOccurrenceTerminalLocationGroup</name>
      <ownedRule xmi:id="_18_4_1_65b021e_1673624353912_944792_173473" xmi:uuid="37cb254d-0eae-47bc-942c-9a1451deca32" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365799_745286_149311" xmi:uuid="4d227a57-0081-4c6f-acb7-131f6f9cf491" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365799_381594_149312" xmi:uuid="2aa0883a-1f65-420d-96b2-1c27bab3ff7d" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="names" value="child::Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:let name="followingAndPrecedingNames" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']/Name/descendant::*[self::CharacterString or self::LocalizedString] union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']/Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:assert test="count($names) = 0 or not(some $i in $names, $j in $followingAndPrecedingNames satisfies ($i eq $j))"&gt;(CableOccurrenceTerminalLocationGroup.UR1: &lt;sch:value-of select="$uid"/&gt;) the Names (&lt;sch:value-of select="$names"/&gt;) of CableOccurrenceTerminalLocationGroup shall be unique for a CableOccurrence.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1673624353914_777461_173475" xmi:uuid="816c47cf-a1e1-42f4-a199-ef806b9c9f77" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1673624353912_944792_173473"/>
          <body>the Names of CableOccurrenceTerminalLocationGroup shall be unique for a CableOccurrence. &lt;note&gt; This ensures that the CableOccurrenceTerminalLocationGroups at the ends of the cable with the name 'end a' and 'end b' are used only ones. &lt;/note&gt;</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193034_713560_23435"/>
        <specification xmi:id="_18_4_1_65b021e_1673624353914_452790_173474" xmi:uuid="192a8b16-1ebf-4d18-a002-f4b05b918e33" xmi:type="uml:OpaqueExpression">
          <body>CableOccurrenceTerminalLocationGroup::allInstances()-&gt;isUnique(Sequence{ElementOf, Name})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193448_160161_25144" xmi:uuid="d23f6833-e485-4155-89f5-c7c9f9b7a8eb" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193159_532460_23691"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8db01ea_1503567186121_355528_25461" xmi:uuid="c8c1bb5a-6836-4db9-ae35-4f4e614acac8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1513085361707_708383_114494" xmi:uuid="454b788c-60e7-4044-b3d0-c06d09e707cc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1503567186121_355528_25461"/>
          <body> an inherited attribute that shall have a value of type CableOccurrence.</body>
        </ownedComment>
