      <memberEnd xmi:idref="_18_4_1_8db01ea_1524664778377_121587_72994"/>
      <ownedEnd xmi:id="_18_4_1_8db01ea_1524664815463_820767_73000" xmi:uuid="3a80ce16-e711-485e-9991-9676f61d446f" xmi:type="uml:Property">
