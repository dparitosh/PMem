    <packagedElement xmi:id="_18_4_1_e120334_1499417193303_319098_23941" xmi:uuid="6f6bae7f-0ce7-478a-b5bd-362db99db14e" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_0_2_8db01ea_1456223850533_577174_43075" xmi:uuid="c106dfce-3afc-439b-bd1d-22442bc2df78" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193303_319098_23941"/>
        <body>The TerminalJointTypeEnum provides predefined joint types for PartTerminals.</body>
      </ownedComment>
      <name>TerminalJointTypeEnum</name>
      <ownedAttribute xmi:id="_18_4_1_8db01ea_1513680505903_350996_60781" xmi:uuid="e2afcaca-a32f-4c41-8bb0-62a048198b74" xmi:type="uml:Property">
        <name>arm_mapping</name>
        <visibility>private</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-general_terminal_joint_type_enumeration"/>
        <isReadOnly>true</isReadOnly>
      </ownedAttribute>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_852654_29441" xmi:uuid="5ec9af8c-2e52-4f41-b1e3-8313723c97a2" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375655972_955527_36420" xmi:uuid="e39f11b9-46f8-476a-8179-c94be23a6793" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_852654_29441"/>
          <body>or crimp contact, contact having a conductor barrel designed to be crimped [IEV ref 581-22-05].</body>
        </ownedComment>
        <name>crimp_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680728110_275056_60782" xmi:uuid="47bcd5bf-12c2-4afb-ac4e-2afb9b79e037" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680728132_215932_60783" xmi:uuid="a6f4355a-bafc-4f67-89e7-e22014923d0c" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-crimp_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_387097_29442" xmi:uuid="e135d92a-ed3a-4b5d-8fcc-dec21e1a3dad" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375669698_608783_36421" xmi:uuid="3e596881-9608-42f7-8424-3bb42a2d404d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_387097_29442"/>
          <body>or fusion splice, a splice accomplished by the application of localised heat sufficient to fuse or melt the ends of two lengths of optical fibre, to produce a continuous single optical fibre [IEV ref 731-05-06].</body>
        </ownedComment>
        <name>fusion_fibre_splice</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680772282_886219_60784" xmi:uuid="c6cccbcc-1a9f-432e-8adb-f6474b17713f" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680772292_227476_60785" xmi:uuid="59e90302-2a60-47bc-8f11-9f99fd7ef82c" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-fusion_fibre_splice"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_483033_29443" xmi:uuid="c4d755ac-f5db-4901-ba93-4ff806d647dd" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375697477_257876_36422" xmi:uuid="64ca100d-e650-451b-8639-e991694d48fd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_483033_29443"/>
          <body>or insulation displacement termination, termination having slots with precisely controlled sides, which are intended to accept a wire and to displace its insulation, deform its conductor and to produce a gas-tight solderless connection [IEV ref 581-23-39].</body>
        </ownedComment>
        <name>insulation_displacement_termination</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680792865_253996_60786" xmi:uuid="98bd9615-ca06-4cc6-bb18-d77a5f099e3f" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680792875_480708_60787" xmi:uuid="0f80b662-3a9f-4f94-81ac-0473be044147" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-insulation_displacement_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_708499_29444" xmi:uuid="004c1fed-167f-41c5-b4f4-cd2cf451ca44" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375710650_429971_36423" xmi:uuid="addbd9ad-df61-4564-ad5e-96c4e28b0a9b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_708499_29444"/>
          <body>a screw-type terminal designed for clamping a cable lug or bar directly or indirectly by means of a screw or nut [IEV ref 442-06-16].</body>
        </ownedComment>
        <name>lug_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680807857_667843_60788" xmi:uuid="f7bd1d46-fe59-47ad-9cb4-83e5b8e229e0" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680807865_785147_60789" xmi:uuid="bdea8c04-b30e-4b60-a2ce-60333a7bde31" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-lug_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_639757_29445" xmi:uuid="de3c905c-a4c3-44fb-bc75-8465a23ddf3b" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375722824_107590_36424" xmi:uuid="ae83616b-00f2-4f95-8e18-ae821ed86561" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_639757_29445"/>
          <body>a terminal, in which the conductor is clamped against the base of a slot in a threaded stud by means of a nut, by a suitably shaped washer under the nut, by a central peg if the nut is a cap nut, or by an equally effective means for transmitting the pressure from the nut to the conductor within the slot [IEV ref 442-06-14].</body>
        </ownedComment>
        <name>mantle_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680818242_129648_60790" xmi:uuid="15061567-7f53-41f4-b092-9ad3c02fb578" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680818250_443786_60791" xmi:uuid="9894c6d6-138c-4f69-adb8-06cd8c0e6ebb" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-mantle_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194164_453431_29446" xmi:uuid="075ae30e-cf5e-451f-8a7c-be806bdce6d9" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375735271_274112_36425" xmi:uuid="3c2cbcde-0672-474f-b736-0ab3399a1967" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194164_453431_29446"/>
          <body>or mechanical splice, a fibre splice accomplished by fixtures or materials, rather than by thermal fusion [IEV ref 731-05-07].</body>
        </ownedComment>
        <name>mechanical_fibre_splice</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680829615_646105_60792" xmi:uuid="a77b31a8-5c52-4e70-ae5f-0a5abe30a3f0" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680829622_54435_60793" xmi:uuid="9f8c793f-ef63-4c77-944d-b76e5b1661ed" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-mechanical_fibre_splice"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194165_883881_29447" xmi:uuid="08f10fb2-1556-4f56-8d9a-21459b4defc0" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512375797096_226716_36426" xmi:uuid="57d58415-44e6-4598-a92b-392cc8c11870" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_883881_29447"/>
          <body>insulation displacement termination that can be terminated only once [IEV ref 581-23-41].</body>
        </ownedComment>
        <name>non_reusable_insulation_displacement_termination</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680838610_160213_60794" xmi:uuid="26b245c2-bb33-4829-a38d-54a62c1ecf89" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680838612_160575_60795" xmi:uuid="e06f398c-834f-47ab-8008-77a53c5930b1" xmi:type="uml:InstanceValue">
