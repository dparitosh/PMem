          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_317536_29452"/>
          <body>contact having elastic properties to provide a force to its mating part [IEV ref 581-22-09].</body>
        </ownedComment>
        <name>resilient_contact_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680899937_50600_60804" xmi:uuid="19926444-5d94-4d86-8479-658ea1cda087" xmi:type="uml:Slot">
