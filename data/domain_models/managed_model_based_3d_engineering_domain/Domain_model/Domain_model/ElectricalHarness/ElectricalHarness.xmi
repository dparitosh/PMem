    <packagedElement xmi:id="_18_4_1_e120334_1499417193287_447340_23912" xmi:uuid="ead2f7df-b94a-4163-bba6-2476879a0855" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455617219801_567941_42650" xmi:uuid="d376e60e-a0d9-46eb-89e6-24cba93a72e2" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193287_447340_23912"/>
        <body>A WireOccurrence is a type of QuantifiedOccurrence. A WireOccurrence is an occurrence of a wire that is defined by a PartView of a particular length and that has wire as one of its PartTypes. &lt;note&gt;Either Quantity or Criterion or both shall be defined.&lt;/note&gt;</body>
      </ownedComment>
      <name>WireOccurrence</name>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460451148444_512130_45936" xmi:uuid="00bb1b22-d1b2-473d-bc29-2bcf99051f16" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_2_8db01ea_1460451183341_746455_45939" xmi:uuid="ccf08db3-8bde-4eff-a221-f4bf2e2826f0" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1517565613953_451628_122518" xmi:uuid="346f96c2-7ec8-4250-aef3-2f14fcc3c090" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_0_2_8db01ea_1460451183341_746455_45939"/>
            <body>EXPRESS WR: wire IN SELF.Definition.ViewOf.VersionOf.PartTypes</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460451148444_512130_45936"/>
          <body>a WireOccurrence shall belong to a Part that contains wire as one of its PartTypes.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365752_590703_149297" xmi:uuid="d24eaf5c-eb9a-498d-a643-84e39ac22a98" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365752_72020_149298" xmi:uuid="b70043c0-ab80-4889-b53f-44f1dcc9d338" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='WireOccurrence']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="part" value="ancestor::Part"/&gt; &lt;sch:assert test="$part/PartTypes[PartCategoryEnum ='wire']"&gt;(WireOccurrence.WR1: &lt;sch:value-of select="$uid"/&gt;) a WireOccurrence shall belong to a Part that contains wire as one of its PartTypes.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193287_447340_23912"/>
        <specification xmi:id="_18_4_1_8db01ea_1513084502796_843632_80508" xmi:uuid="56911f20-ce4d-4b8c-a000-0aafe18f8736" xmi:type="uml:OpaqueExpression">
          <body>self.Definition.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartView).ViewOf.VersionOf.PartTypes-&gt;exists(pt | pt.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnumProxy).value = Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnum::wire)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460451047793_819541_45932" xmi:uuid="8015fd74-3884-48ae-bda6-ca1d5ca75603" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365758_416311_149299" xmi:uuid="a3d33797-2f96-4c45-92f9-4f65145951e1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365758_957100_149300" xmi:uuid="b084f3e5-43f4-47d2-8bd4-babffe7a25b9" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='WireOccurrence']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="part" value="ancestor::Part"/&gt; &lt;sch:assert test="$part/PartTypes[PartCategoryEnum ='raw_material_by_length']"&gt;(WireOccurrence.WR1: &lt;sch:value-of select="$uid"/&gt;) a WireOccurrence shall belong to a Part that contains raw material by length as one of its PartTypes.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_2_8db01ea_1460451088322_519828_45935" xmi:uuid="b4328363-7841-42cf-be2f-d9d979758b87" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1517565566995_58605_122515" xmi:uuid="bf255b36-cd2d-4959-8ab2-86eb5afd0747" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_0_2_8db01ea_1460451088322_519828_45935"/>
            <body>EXPRESS WR: raw material by length IN SELF.Definition.ViewOf.VersionOf.PartTypes</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460451047793_819541_45932"/>
          <body>a WireOccurrence shall belong to a Part that contains raw material by length as one of its PartTypes </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193287_447340_23912"/>
        <specification xmi:id="_18_4_1_8db01ea_1513084458913_356698_80507" xmi:uuid="a96d0c5c-bfc1-4b14-9f43-f0345556e4c5" xmi:type="uml:OpaqueExpression">
          <body>self.Definition.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartView).ViewOf.VersionOf.PartTypes-&gt;exists(pt | pt.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnumProxy).value = Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnum::raw_material_by_length)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_65b021e_1673623843902_891860_173448" xmi:uuid="b11eac30-ed96-4fd1-a08e-0bfc522f1436" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1673623857641_427669_173452" xmi:uuid="af21c68f-6c87-499d-8acf-1215d955e5eb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1673623843902_891860_173448"/>
          <body>the WireOccurrenceTerminals that are defined for a WireOccurrence shall be in sync to an associated EdgeBoundedCurveWithLength or a Path in such a way that the CableOccurrenceTerminalLocationGroup with the name 'end a' corresponds to the start of the Edge or Path and the 'end b' corresponds to end of the Edge or Path.</body>
        </ownedComment>
        <name>IP1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193287_447340_23912"/>
        <specification xmi:id="_18_4_1_65b021e_1673623843905_839919_173449" xmi:uuid="92e7342b-a7d2-422f-b4c4-4374f0669bd8" xmi:type="uml:OpaqueExpression">
          <body>The WireOccurrenceTerminals that are defined for a WireOccurrence shall be in sync to an associated EdgeBoundedCurveWithLength or a Path in such a way that the CableOccurrenceTerminalLocationGroup with the name 'end a' corresponds to the start of the Edge or Path and the 'end b' corresponds to end of the Edge or Path.</body>
          <language>English</language>
        </specification>
      </ownedRule>
