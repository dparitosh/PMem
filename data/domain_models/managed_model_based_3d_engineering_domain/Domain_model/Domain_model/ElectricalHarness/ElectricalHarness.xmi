    <packagedElement xmi:id="_18_4_1_e120334_1499417193116_246492_23602" xmi:uuid="6876b9f0-efd6-4977-a282-412d4facc484" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455610064075_480873_42465" xmi:uuid="738d9275-6d3c-4078-a17e-8d27acb961aa" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193116_246492_23602"/>
        <body>A HarnessNode is a type of PartShapeElement that represents a Vertex from a ConnectedEdgeWithLengthSetRepresentation for a WiringHarnessAssemblyDesign.</body>
      </ownedComment>
      <name>HarnessNode</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1522745479722_792914_66504" xmi:uuid="40351481-5e45-4db9-947b-638b90e09861" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1522745519952_77338_66506" xmi:uuid="64b99b7d-2a27-4958-b98f-740a16c827f2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1522745479722_792914_66504"/>
          <body>A Vertex shall be used at most once by a HarnessNode within a WiringHarnessAssemblyDesign. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365772_126332_149303" xmi:uuid="b67788b1-9478-4876-8fc5-a3a080ea645f" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365772_8611_149304" xmi:uuid="6d782969-0557-4573-9bce-e9d30f52a54c" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign']/ShapeElement[@uid or substring-after(@xsi:type,':')='HarnessNode']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="vertex" value="child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:let name="followingAndPrecedingHarnessNodeVertices" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessNode']/child::RepresentedGeometry/@uidRef union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessNode']/child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:assert test="not(some $i in $followingAndPrecedingHarnessNodeVertices satisfies ($i eq $vertex))"&gt;(HarnessNode.UR1: &lt;sch:value-of select="$uid"/&gt;) A Vertex shall be used at most once by a HarnessNode within a WiringHarnessAssemblyDesign.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193116_246492_23602"/>
        <specification xmi:id="_18_4_1_8db01ea_1522745479722_456828_66505" xmi:uuid="0e4dc0aa-ef5a-4b08-a394-5d7af7300261" xmi:type="uml:OpaqueExpression">
          <body>HarnessNode::allInstances()-&gt;isUnique(Sequence{RepresentedGeometry, ElementOf})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_2_8db01ea_1458211588191_668036_43694" xmi:uuid="e7abc1cc-14cc-4923-a6bd-354e3d2f9cb3" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365776_207280_149305" xmi:uuid="bf271a7d-9cf8-46b1-90d6-5063d41625a2" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365776_33543_149306" xmi:uuid="3b755e98-9f3f-4b07-8b40-6cbe7c9b18a5" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='HarnessNode']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="vertexRef" value="child::RepresentedGeometry/@uidRef"/&gt; &lt;sch:let name="topologyRef" value="parent::*/Topology/@uidRef"/&gt; &lt;sch:let name="reps" value="local-fn:UsingRepresentations(//DataContainer,//RepresentationItem[@uid=$vertexRef])"/&gt; &lt;sch:assert test="some $j in $reps satisfies ($j eq $topologyRef)"&gt;(HarnessNode.WR1: &lt;sch:value-of select="$uid"/&gt;) the RepresentedGeometry (&lt;sch:value-of select="$vertexRef"/&gt;) shall be found in the ElementOf.Topology (&lt;sch:value-of select="$topologyRef"/&gt;). (&lt;sch:value-of select="$vertexRef"/&gt;) is used in the following Representations:(&lt;sch:value-of select="$reps"/&gt;)&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_2_8db01ea_1458211683830_936010_43697" xmi:uuid="c3fd0c26-e1f0-4c8f-9af1-7ce3a7a34401" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539696118773_494785_138290" xmi:uuid="26a08ad1-4e50-4bd9-acc8-4ba282d200f5" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_0_2_8db01ea_1458211683830_936010_43697"/>
            <body>ElementOf.topology IN using_representations(RepresentedGeometry)</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1458211588191_668036_43694"/>
          <body>the RepresentedGeometry shall be founded in the ElementOf. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193116_246492_23602"/>
        <specification xmi:id="_18_4_1_8db01ea_1513241395755_552262_44291" xmi:uuid="9e86283e-49d6-4a48-9823-05e17fdf96d3" xmi:type="uml:OpaqueExpression">
          <body>Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::Representation::allInstances()-&gt;select(i | i.Items-&gt;includes(self.RepresentedGeometry))-&gt;includes(self.ElementOf.Topology) </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193719_931542_27165" xmi:uuid="2fedab08-3d5c-4540-a784-32011d00bf01" xmi:type="uml:Generalization">
