    <packagedElement xmi:id="_18_4_1_91401df_1714992901140_227486_134201" xmi:uuid="c0c6b2dc-7c52-4654-98ed-1fc17ed50d6b" xmi:type="uml:Package">
      <name>Functions</name>
      <packagedElement xmi:id="_18_4_1_91401df_1714993248729_14889_134234" xmi:uuid="23fc820e-004e-410c-aa66-a0cda8826aa7" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_91401df_1714993347188_375446_134258" xmi:uuid="543c08e1-5fef-430e-8dd4-09c678b48e29" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1714993248729_14889_134234"/>
          <body>The MainUpperUsage function determines the final instance of a potential list of instances of entity data type SpecifiedOccurrence that are linked by the attribute UpperUsage. The function returns the final Occurrence that is not of type SpecifiedOccurrence.</body>
        </ownedComment>
        <name>MainUpperUsage</name>
        <ownedRule xmi:id="_18_4_1_91401df_1714993248735_956047_134236" xmi:uuid="0ff4ae27-96aa-42ec-b270-f25ef2e3a23f" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_91401df_1714993288432_595342_134239" xmi:uuid="fa63c294-0b0d-487a-8b95-0875b3558269" xmi:type="uml:Comment">
            <ownedComment xmi:id="_18_4_1_91401df_1714993299129_956557_134240" xmi:uuid="a0068578-8e69-4687-8823-b30f4895022e" xmi:type="uml:Comment">
              <body>&lt;xsl:function name="local-fn:MainUpperUsage"&gt; &lt;xsl:param name="dataContainer"/&gt; &lt;xsl:param name="occurrenceUID"/&gt; &lt;xsl:variable name="occurrence" select="$dataContainer/descendant::*[@uid =$occurrenceUID]"/&gt; &lt;xsl:choose&gt; &lt;xsl:when test="count ($occurrence/UpperUsage) = 1"&gt; &lt;xsl:value-of select="local-fn:MainUpperUsage($dataContainer , $occurrence/UpperUsage/@uidRef)"/&gt; &lt;/xsl:when&gt; &lt;xsl:otherwise&gt; &lt;xsl:value-of select="$occurrenceUID"/&gt; &lt;/xsl:otherwise&gt; &lt;/xsl:choose&gt; &lt;/xsl:function&gt;</body>
            </ownedComment>
            <body>Schematron</body>
          </ownedComment>
          <constrainedElement xmi:idref="_18_4_1_91401df_1714993248729_14889_134234"/>
          <specification xmi:id="_18_4_1_91401df_1714993248735_748944_134237" xmi:uuid="b1df943d-a1e4-4171-b477-bff975ebc752" xmi:type="uml:OpaqueExpression"/>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:id="_18_4_1_91401df_1714992932897_442440_134208" xmi:uuid="97edbe87-56ea-4685-a2bf-6e48b0b06d87" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_91401df_1714993096448_255094_134212" xmi:uuid="9c3a8835-f023-42fc-8ec0-1103c38ae0ed" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1714992932897_442440_134208"/>
          <body>The function UsingRepresentations returns the set of Representations in which a RepresentationItem is used. A RepresentationItem is used in a Representation if it is: - referenced in the set of items of the Representation, or - referenced by a RepresentationItem used in the Representation. A RepresentationItem is used in a Representation if it is referenced directly, or indirectly, by a Representation_item in the set of items of the Representation.</body>
        </ownedComment>
        <name>UsingRepresentations</name>
        <ownedRule xmi:id="_18_4_1_91401df_1714992932906_829949_134210" xmi:uuid="83c9d505-e416-455e-9dcc-3e33e3ccc7ac" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_91401df_1714993270472_806348_134238" xmi:uuid="38ce16bf-ce6e-4579-9069-f8d9bd128c4c" xmi:type="uml:Comment">
            <ownedComment xmi:id="_18_4_1_91401df_1714993109761_484440_134213" xmi:uuid="d1035b79-bb45-4607-8e64-9e62cf04cbb9" xmi:type="uml:Comment">
              <body>&lt;xsl:function name="local-fn:UsingRepresentations"&gt; &lt;xsl:param name="dataContainer"/&gt; &lt;xsl:param name="repItem"/&gt; &lt;xsl:variable name="directRep" select="$dataContainer/descendant::Representation[child::Items/RepresentationItem[@uidRef=$repItem/@uid]]/@uid"/&gt; &lt;xsl:variable name="indirectRep" select= "for $i in $dataContainer/descendant::RepresentationItem[descendant::*[@uidRef=$repItem/@uid]] return local-fn:UsingRepresentations($dataContainer,$i)"/&gt; &lt;xsl:sequence select="$directRep union $indirectRep"/&gt; &lt;/xsl:function&gt;</body>
            </ownedComment>
            <body>Schematron</body>
          </ownedComment>
          <constrainedElement xmi:idref="_18_4_1_91401df_1714992932897_442440_134208"/>
          <specification xmi:id="_18_4_1_91401df_1714992932906_750344_134211" xmi:uuid="db8d83f7-f2fb-4f76-b160-cdeebd2fcd72" xmi:type="uml:OpaqueExpression"/>
        </ownedRule>
      </packagedElement>
    </packagedElement>
