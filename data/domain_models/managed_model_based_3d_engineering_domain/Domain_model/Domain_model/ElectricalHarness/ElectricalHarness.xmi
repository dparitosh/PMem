    <packagedElement xmi:id="_18_4_1_e120334_1499417193033_917030_23433" xmi:uuid="991968d7-2ad1-43e2-9491-85bbbd3e9c52" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1453813805699_492809_42468" xmi:uuid="e3db81b0-55a9-476b-bac1-a961ce2b4155" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193033_917030_23433"/>
        <body>A CableOccurrence is a type of QuantifiedOccurrence that is an occurrence of a PartView having a specified length. This PartView shall be associated with a Part that is categorized as cable and also as raw_material_by_length (PartTypes). </body>
      </ownedComment>
      <name>CableOccurrence</name>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460381052633_96379_44646" xmi:uuid="47a77a17-b3ce-4ee0-8666-872445ab762f" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_2_8db01ea_1460382342068_185912_44659" xmi:uuid="526e8b37-5e23-4807-a765-89eda51bd84e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1517565486416_660641_122507" xmi:uuid="24e809b1-dc02-4c0d-82dd-7a39f785b02f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_0_2_8db01ea_1460382342068_185912_44659"/>
            <body>EXPRESS WR: raw_material_by_length IN SELF.Definition.ViewOf.VersionOf.PartTypes</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460381052633_96379_44646"/>
          <body>a CableOccurrence shall belong to a Part that PartTypes contains raw_material_by_length.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365851_943999_149327" xmi:uuid="d9762887-2d12-45d3-b54e-fe90bc8eca5d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365851_951209_149328" xmi:uuid="8fe5034b-a962-4a15-b80d-c07deeed7138" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='CableOccurrence']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="part" value="ancestor::Part"/&gt; &lt;sch:assert test="$part/PartTypes[PartCategoryEnum ='raw_material_by_length']"&gt;(CableOccurrence.WR1: &lt;sch:value-of select="$uid"/&gt;) a CableOccurrence shall belong to a Part that PartTypes contains raw_material_by_length.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193033_917030_23433"/>
        <specification xmi:id="_18_4_1_8db01ea_1513083788112_113605_80505" xmi:uuid="12eeda2b-08f0-4f6f-b314-02c836f62cb6" xmi:type="uml:OpaqueExpression">
          <body>self.Definition.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartView).ViewOf.VersionOf.PartTypes-&gt;exists(pt | pt.oclAsType(Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnumProxy).value = Application_protocols::AP242::Domain_model::ProductDataManagement::PartCategoryEnum::raw_material_by_length)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_65b021e_1673624048584_251572_173457" xmi:uuid="d8d80347-be16-4df5-a9e5-730b0ccacf2d" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1673624076380_480208_173463" xmi:uuid="8426d667-2b5e-4b78-9780-fe66348c5f15" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1673624048584_251572_173457"/>
          <body>the CableOccurrenceTerminalLocationGroups that are defined for a CableOccurrence shall be in sync to an associated EdgeBoundedCurveWithLength or a Path in such a way that the CableOccurrenceTerminalLocationGroup with the name 'end a' corresponds to the start of the Edge or Path and the 'end b' corresponds to end of the Edge or Path.</body>
        </ownedComment>
        <name>IP1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193033_917030_23433"/>
        <specification xmi:id="_18_4_1_65b021e_1673624048586_902820_173458" xmi:uuid="119e92a2-66aa-4653-b2b4-4f73b9de3702" xmi:type="uml:OpaqueExpression">
          <body>The CableOccurrenceTerminalLocationGroups that are defined for a CableOccurrence shall be in sync to an associated EdgeBoundedCurveWithLength or a Path in such a way that the CableOccurrenceTerminalLocationGroup with the name 'end a' corresponds to the start of the Edge or Path and the 'end b' corresponds to end of the Edge or Path.</body>
          <language>English</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460382779152_502926_44671" xmi:uuid="df6bf95c-65a2-40b2-b3b6-f5ac685754db" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365863_948181_149331" xmi:uuid="8eedf37d-add4-4aac-a321-2679bf16bd44" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365863_357446_149332" xmi:uuid="82147f9f-9286-4734-a9ae-cbb24ad90b6d" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='CableOccurrence']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="part" value="ancestor::Part"/&gt; &lt;sch:assert test="$part/PartTypes[PartCategoryEnum ='cable']"&gt;(CableOccurrence.WR1: &lt;sch:value-of select="$uid"/&gt;) a CableOccurrence shall belong to a Part that PartTypes contains cable&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_2_8db01ea_1460382811158_194566_44674" xmi:uuid="c6a69e79-610d-448d-afef-bed6e119e70c" xmi:type="uml:Comment">
