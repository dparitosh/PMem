    <packagedElement xmi:id="_18_4_1_8db01ea_1502118002264_176939_36755" xmi:uuid="c5fdb9b0-01cc-4eec-9a76-1553fd17b0a5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1512401681929_655473_41596" xmi:uuid="02df8a45-8b64-4987-baa8-c13a524300b1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1502118002264_176939_36755"/>
        <body>A ContactFeatureDefinitionFitRelationship is a type of ShapeFeatureDefinitionFitRelationship that is a relationship between two instances of the entity data type ContactFeatureDefinition that fit together. </body>
      </ownedComment>
      <name>ContactFeatureDefinitionFitRelationship</name>
      <generalization xmi:id="_18_4_1_8db01ea_1502118065182_676470_36847" xmi:uuid="4005fb07-f34d-43aa-b20e-abc0c1494f63" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_8db01ea_1524661095734_842894_71770"/>
      </generalization>
      <generalization xmi:id="_18_4_1_8db01ea_1505468717447_598137_28924" xmi:uuid="d5a37d4a-aa79-4f2c-8c55-3288a05d56f5" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_8db01ea_1505468259607_937157_28699"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8db01ea_1502118107222_231581_36861" xmi:uuid="2501a0b0-fc09-4434-a979-cca7679562fb" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512401717591_615932_41597" xmi:uuid="5dbf57c1-9eb0-476a-9dd5-9de97a0d7058" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1502118107222_231581_36861"/>
          <body>an inherited attribute that shall be of type ContactFeatureDefinition that is a part of the relationship. </body>
        </ownedComment>
