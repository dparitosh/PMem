        <annotatedElement xmi:idref="_18_4_1_8db01ea_1502369321169_378187_49175"/>
        <body>An OccurrenceShapeFeature is a type of OccurrenceShapeElement that is a definitional part of the shape of an Occurrence or of another OccurrenceShapeFeature.</body>
      </ownedComment>
      <name>OccurrenceShapeFeature</name>
      <ownedRule xmi:id="_18_4_1_af4021f_1720688738713_91119_131833" xmi:uuid="37c2faec-7156-43a3-aae8-d49c306e89f7" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1720688760565_967056_131835" xmi:uuid="d767e5ad-c46c-40ce-8241-c9c7490b5ca9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1720688738713_91119_131833"/>
          <body>the inherited attribute ProductDefinitional must not be explicitly provided. It is implicitly set to TRUE.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1720688767351_999840_131836" xmi:uuid="dd4511a5-ff7d-4270-b72b-6b92c1fb50bf" xmi:type="uml:Comment">
