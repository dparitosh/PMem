  <sysml:NestedConnectorEnd xmi:id="_18_4_1_271a0567_1540919468045_940752_217768" xmi:uuid="91786140-fa36-013a-045c-52540000fd3c">
    <propertyPath xmi:idref="_18_4_1_8db01ea_1515663044153_716523_50544"/>
