    <packagedElement xmi:id="_18_4_1_8db01ea_1502118751764_747860_37404" xmi:uuid="b5c09b89-a88b-462a-be9b-734655218370" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1513241525140_426481_44293" xmi:uuid="24ae61cf-fc40-4aa7-8694-671248e86ff1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1502118751764_747860_37404"/>
        <body>A PartFeature is a type of PartShapeElement that represents an external shape feature of a PartView.</body>
      </ownedComment>
      <name>PartFeature</name>
      <ownedRule xmi:id="_18_4_1_af4021f_1720688889219_100346_131838" xmi:uuid="f97c324d-554c-431f-87b7-5228039662ed" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1720688905863_215119_131840" xmi:uuid="4fcaaa00-faa1-46cb-bfdc-4ba7e28af4ed" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1720688889219_100346_131838"/>
          <body>the inherited attribute ProductDefinitional must not be explicitly provided. It is implicitly set to TRUE.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1720688914669_267315_131841" xmi:uuid="cc15df4b-4c0c-4d52-be97-d8ea40b40988" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1720688926870_541203_131842" xmi:uuid="534c2f93-0a4c-4a5d-adde-a403c6bdb2f0" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypePartFeature(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="count(child::ProductDefinitional) = 0"&gt;PartFeature.WR1 &lt;sch:value-of select="$uid"/&gt;) the inherited attribute ProductDefinitional must not be explicitly provided. It is implicitly set to TRUE.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
