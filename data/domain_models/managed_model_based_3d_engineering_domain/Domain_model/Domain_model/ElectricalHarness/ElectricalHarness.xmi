      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_8db01ea_1508747114540_339645_31403" xmi:uuid="e40709cd-c5a5-4d68-a2b9-f6c4d6fba331" xmi:type="uml:Port">
