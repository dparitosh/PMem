            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-push_on_contact_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
