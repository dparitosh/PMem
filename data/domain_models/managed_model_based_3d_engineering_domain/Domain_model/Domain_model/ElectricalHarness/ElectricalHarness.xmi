    <packagedElement xmi:id="_18_4_1_8db01ea_1505142659090_284211_33213" xmi:uuid="14612dd8-be61-403e-8eba-a8d6a179b2e0" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_8db01ea_1505142659090_556308_33214"/>
      <memberEnd xmi:idref="_18_4_1_8db01ea_1505142644224_823000_33198"/>
      <ownedEnd xmi:id="_18_4_1_8db01ea_1505142659090_556308_33214" xmi:uuid="eb0548e7-c103-47d3-956c-80a19de7f440" xmi:type="uml:Property">
