    <packagedElement xmi:id="_18_4_1_e120334_1499417193287_952620_23913" xmi:uuid="0c7dfd39-f603-49bb-b739-b9ffd1914b0e" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455617337503_856744_42651" xmi:uuid="91512ecc-a39c-4ee6-827a-a8cc48239497" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193287_952620_23913"/>
        <body>A WireOccurrenceTerminal is a type of OccurrenceTerminal for the identification of a terminal on a WireOccurrence. The terminal may be located at one of the ends or somewhere in the middle of the wire. The WireOccurrenceTerminals at the ends of the wire shall be named "end a" and "end b" respectively. WireOccurrenceTerminals in the middle of the wire shall start with the letters "intermediate" followed by arbitrary text.</body>
      </ownedComment>
      <name>WireOccurrenceTerminal</name>
      <ownedRule xmi:id="_18_4_1_65b021e_1673624296425_1_173468" xmi:uuid="c36ed15f-346e-4753-9f57-81ab423bf5a9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714980365819_359659_149317" xmi:uuid="3813464e-79ec-42a8-8561-6af438784306" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714980365820_650174_149318" xmi:uuid="d2530d95-450a-40a0-beee-ceab01c60b80" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='WireOccurrenceTerminal']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="names" value="child::Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:let name="followingAndPrecedingNames" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='WireOccurrenceTerminal']/Name/descendant::*[self::CharacterString or self::LocalizedString] union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='WireOccurrenceTerminal']/Name/descendant::*[self::CharacterString or self::LocalizedString]"/&gt; &lt;sch:assert test="count($names) = 0 or not(some $i in $names, $j in $followingAndPrecedingNames satisfies ($i eq $j))"&gt;(WireOccurrenceTerminal.UR1: &lt;sch:value-of select="$uid"/&gt;) the Names of WireOccurrenceTerminal shall be unique for a WireOccurrence.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1673624296426_23858_173470" xmi:uuid="3b7c2fbc-5cce-4ab9-b363-7798443d4938" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1673624296425_1_173468"/>
          <body>the Names of WireOccurrenceTerminal shall be unique for a WireOccurrence. &lt;note&gt; This ensures that the WireOccurrenceTerminals at the ends of the wire with the name 'end a' and 'end b' are used only ones. &lt;/note&gt;</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193287_952620_23913"/>
        <specification xmi:id="_18_4_1_65b021e_1673624296426_848750_173469" xmi:uuid="338a5bf9-0aa2-44be-811e-c8bc7d720bab" xmi:type="uml:OpaqueExpression">
          <body>WireOccurrenceTerminal::allInstances()-&gt;isUnique(Sequence{ElementOf, Name})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1503492160236_797792_24478" xmi:uuid="f20aacff-693a-45e8-82e2-376b811e4c5d" xmi:type="uml:Generalization">
