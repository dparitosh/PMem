        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_8db01ea_1502117683867_254625_36555"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194672_77689_33757" xmi:uuid="9e7f93e3-ab21-4056-939b-aeed9f30703b" xmi:type="uml:LiteralInteger">
          <value>2</value>
        </lowerValue>
