          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194165_855245_29448" xmi:uuid="252ab73a-09eb-4800-85c7-7ea1b9155167" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512376375493_720419_37031" xmi:uuid="746bf8a3-aa1b-4274-936d-a1b5fe21bb79" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_855245_29448"/>
          <body>a permanent joint whose purpose is to couple optical power between two optical fibres [IEV ref 731-05-05]. &lt;note&gt;Associated terms : to splice, splicing.&lt;/note&gt;</body>
        </ownedComment>
        <name>optical_fiber_splice</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680849915_297725_60796" xmi:uuid="aeeec139-422b-429c-8104-8db202754179" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680849927_254855_60797" xmi:uuid="5ef7c370-9f42-4da5-8c1a-1e96eb1800e8" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-optical_fibre_splice"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194165_664548_29449" xmi:uuid="ae19171f-3e3c-4f4d-b7f0-f68bb4c1c19f" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512376489044_954233_37032" xmi:uuid="4ecc86e0-4717-4f2b-bccf-198de907f9a4" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_664548_29449"/>
          <body>a screw type terminal, in which the conductor(s) is (are) inserted into a hole or cavity, where it is clamped under the shank of the screw [IEV ref 442-06-22]. &lt;note&gt;The clamping pressure can be applied directly by the shank of the screw or through an intermediate part to which pressure is applied by the shank of the screw.&lt;/note&gt;</body>
        </ownedComment>
        <name>pillar_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680859072_476581_60798" xmi:uuid="97da2f99-54ca-4cc6-b8b8-2381908b1ae0" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1513680505903_350996_60781"/>
          <value xmi:id="_18_4_1_8db01ea_1513680859077_848307_60799" xmi:uuid="d8dc0a62-113e-410a-b2fc-e0908b23c383" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-general_terminal_joint_type_enumeration-pillar_terminal"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194165_530224_29450" xmi:uuid="83683866-480e-469a-914c-299a24f40585" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_8db01ea_1512376528492_974557_37033" xmi:uuid="d2722406-ce75-4135-9a25-bd5c8667862a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194165_530224_29450"/>
          <body>or pin contact or male contact, contact member intended to make electric engagement on its outer surface for mating with the inner surface of another contact member [IEV ref 151-12-18].</body>
        </ownedComment>
        <name>pin_terminal</name>
        <slot xmi:id="_18_4_1_8db01ea_1513680871185_93680_60800" xmi:uuid="ac9a9fb2-7384-4305-b94c-96947335fa5a" xmi:type="uml:Slot">
