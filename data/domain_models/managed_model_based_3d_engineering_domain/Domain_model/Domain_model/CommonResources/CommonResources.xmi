    <packagedElement xmi:id="_18_4_1_e120334_1499417193241_985227_23835" xmi:uuid="c9a06b9c-6510-4b79-bbd8-ffddbac264ce" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455722611286_435809_43115" xmi:uuid="cdbd5a7f-ecad-45fa-a0d4-25573930d5d1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193241_985227_23835"/>
        <body>A SerialEffectivity is a type of Effectivity for which the domain of applicability is defined as a possibly open-ended interval of serial numbers. A 'start' value shall always be specified for SerialEffectivity, an 'end' value may be specified.</body>
      </ownedComment>
      <name>SerialEffectivity</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193643_484767_26583" xmi:uuid="31feaaeb-1fb1-4ac0-93c6-017c2f2048ef" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193084_102089_23537"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194047_168897_28877" xmi:uuid="38dc774c-888d-491c-bb84-07707ab9f47a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455722635691_997303_43116" xmi:uuid="db43a871-9dda-43be-b223-c010989e9c76" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194047_168897_28877"/>
          <body>the last valid serial number. The value of this attribute need not be specified. If the value for this attribute is not specified, the interval of applicability has no upper bound or it is implicitly defined via an EffectivityRelationship with &lt;a&gt;&lt;path&gt;./4_info_reqs_CommonResources.htm#EffectivityRelationship.RelationType&lt;/path&gt; RelationType&lt;/a&gt; 'inheritance'.</body>
        </ownedComment>
        <name>EndId</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193119_518292_23608"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194785_929990_34859" xmi:uuid="ee2f8e99-6f0e-4048-bfc5-0162380eb14d" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193747_436378_27314"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194047_255741_28878" xmi:uuid="038e33ad-40f2-4c4b-87a3-f6a599f1e7a8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455722646220_322515_43117" xmi:uuid="07ecee41-d5ae-40fc-b2cf-d54993bf13d1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194047_255741_28878"/>
          <body> the first valid serial number.</body>
        </ownedComment>
