    <packagedElement xmi:id="_18_4_1_e120334_1499417193092_291817_23549" xmi:uuid="e74ee7f9-810f-4945-a707-505df9ad1bc1" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455732494876_282353_43290" xmi:uuid="2cd1806a-c189-4305-9173-0660c318de24" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193092_291817_23549"/>
        <body>An ExchangeContext is a context that provides the default language and/or context used for identifications and descriptions where the strings are used as opposed to the explicit objects.</body>
      </ownedComment>
      <name>ExchangeContext</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193669_280554_26792" xmi:uuid="1977e16d-6029-4fe4-8909-a72164e8e688" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759328_429246_151328" xmi:uuid="1b7aeae3-6e86-493e-8361-e7f021674d1f" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759329_818387_151329" xmi:uuid="67153197-6e6f-4b64-9e4d-3fb89d649967" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExchangeContext[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="followingAndPreceding" value="following-sibling::ExchangeContext union preceding-sibling::ExchangeContext"/&gt; &lt;sch:assert test="count($followingAndPreceding) = 0"&gt; There should only be one instance of an ExchangeContext in a data exchange file. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_45e01bd_1513334506326_221621_71449" xmi:uuid="fed17f9a-dd20-444a-8836-126d6d358f85" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193669_280554_26792"/>
          <body>there should only be one instance of an ExchangeContext in a data exchange file.</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193092_291817_23549"/>
        <specification xmi:id="_18_4_1_e120334_1499417194475_631313_31983" xmi:uuid="0644eece-713f-469c-b8ab-3787ecc730ed" xmi:type="uml:OpaqueExpression">
          <body>ExchangeContext::allInstances().size() = 1</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459328307673_833414_42564" xmi:uuid="4f362d87-0e4f-4d33-9ae0-145e25597a55" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671446778399_678446_162945" xmi:uuid="06a9c351-8f25-4171-9ace-b8e9caff7b4b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446783951_182105_162946" xmi:uuid="8ce2aa46-6f6f-4e64-a2b9-a4e64c8f0f77" xmi:type="uml:Comment">
            <body>WR1: EXISTS(DefaultLanguage) OR EXISTS (IdentificationContext);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459328350971_469415_42566" xmi:uuid="723ed9d0-36ed-483d-8774-a4985c131858" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459328307673_833414_42564"/>
          <body> at least one of the attributes DefaultLanguage or IdentificationContext shall be specified.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759335_324753_151330" xmi:uuid="e71d7c19-c926-4f6f-b423-60f29c4260f7" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759335_374284_151331" xmi:uuid="a3b2d71e-ae69-4489-9603-4aebc09781da" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExchangeContext[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="DefaultLanguage or IdentificationContext"&gt; At least one of the attributes DefaultLanguage or IdentificationContext shall be specified. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193092_291817_23549"/>
        <specification xmi:id="_18_4_1_271a0567_1509033826487_224206_30398" xmi:uuid="ec0127c9-b906-4f03-82b8-5c86ff56ef87" xmi:type="uml:OpaqueExpression">
          <body>not(self.DefaultLanguage.oclIsUndefined()) or not(self.IdentificationContext.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1669375106303_522569_163599" xmi:uuid="7472bb35-3fff-42c0-be31-9450d0f9c123" xmi:type="uml:Generalization">
