    <packagedElement xmi:id="_18_4_1_e120334_1499417193141_415278_23646" xmi:uuid="79c10280-053a-40b4-a094-9c9bdb50b57d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455732905627_689106_43310" xmi:uuid="c2c31730-86d5-42ab-9da7-3df0659597e2" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193141_415278_23646"/>
        <body>A LocalizedString is a text-based string. The language in which the string is expressed is optionally identified.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1515576506051_736393_265269" xmi:uuid="d1947ca5-b8fb-444d-87e3-bd3e34fe3bc6" xmi:type="uml:Comment">
        <body>WR: encapsulated: SIZEOF(USEDIN(SELF,''))=1; Comment: there is no need of this OCL constraint because the SysML language intrinsically handles this concept of unicity of usage when the attribute is defined as PartProperty (in SysML, Aggregation as Composite in UML).</body>
      </ownedComment>
      <name>LocalizedString</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193808_161311_27669" xmi:uuid="fc1d9c9c-20bd-4021-b85d-0f32fafac333" xmi:type="uml:Generalization">
