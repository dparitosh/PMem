        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193271_720836_23882"/>
        <body>A TimeIntervalRelationship is an association between two TimeInterval objects. &lt;note&gt; Such information is conveyed using Effectivity, RetentionPeriod, and Duration respectively. &lt;/note&gt;</body>
      </ownedComment>
      <name>TimeIntervalRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332569691_205084_42739" xmi:uuid="8b756c66-7575-4dc7-8d6d-6d1a9b7c1b8d" xmi:type="uml:Constraint">
