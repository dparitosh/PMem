            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150294_54594_32324"/>
            <body>set the id to be the sub-string after the '#' character in the input string.</body>
          </ownedComment>
          <name>id</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149897_794232_32236"/>
          <specification xmi:id="_18_4_1_290014c_1504705150329_297257_32445" xmi:uuid="564cf3fe-35a4-4c74-9e25-7b9c9b781158" xmi:type="uml:OpaqueExpression">
            <body>id = input.substring(input.indexOf('#')+1, input.size())</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
