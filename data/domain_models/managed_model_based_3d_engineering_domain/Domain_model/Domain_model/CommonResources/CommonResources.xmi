        <name>CheckKindSIUnit</name>
        <ownedRule xmi:id="_18_4_1_290014c_1534945255485_607324_92827" xmi:uuid="1ab7a543-916e-45f2-aa89-f6fc2cc1339b" xmi:type="uml:Constraint">
