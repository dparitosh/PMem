            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150244_966259_32277"/>
            <body>if the input is a ClassStringProxy then the output string is the value of this, otherwise the output string is '/IGNORE/'. </body>
          </ownedComment>
          <name>outStr</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149882_414916_32228"/>
