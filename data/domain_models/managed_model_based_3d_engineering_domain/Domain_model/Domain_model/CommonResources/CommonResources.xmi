    <packagedElement xmi:id="_18_4_1_e120334_1499417193279_665004_23896" xmi:uuid="c24d9283-f32c-408d-a4e0-70a13102548b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455703972946_509105_42581" xmi:uuid="fc11c781-00ed-431a-b7f6-3f72f9062d11" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193279_665004_23896"/>
        <body>A Unit is a quantity chosen as a standard in terms of which other quantities may be expressed. The types of units supported by this standard are SI units as well as derived or conversion-based units as defined in ISO 10303-41.</body>
      </ownedComment>
      <name>Unit</name>
      <generalization xmi:id="_18_4_1_e120334_1499417194106_58677_29136" xmi:uuid="96967904-fbfd-4f19-8670-f275475c5698" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193280_938492_23897"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194106_575297_29137" xmi:uuid="02a9cee7-c0c1-4e68-b5f1-4bd774a857ea" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455703995107_382834_42582" xmi:uuid="387044c4-993c-4559-832b-77042edb14a4" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194106_575297_29137"/>
          <body> the words or set of words by which the Unit is known. &lt;note&gt;This attribute supports multiple names in different contexts as well as multi-linguism.&lt;/note&gt;</body>
        </ownedComment>
        <name>Name</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193042_855579_23449"/>
        <association xmi:idref="_18_4_1_e120334_1499417193491_548986_25430"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194106_702556_29138" xmi:uuid="19c1dd95-a922-4af4-bbce-0f03b8bf08b2" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455704018974_912133_42583" xmi:uuid="95374dab-0626-42b9-b918-9cb54a0c85ee" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194106_702556_29138"/>
          <body> specifies the system in which the Unit is defined. Where applicable the following value shall be used: 'SI system'. &lt;example&gt;'SI system'.&lt;/example&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Kind</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193042_855579_23449"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194831_387794_35338" xmi:uuid="8ec640a6-d27c-4bf2-ad9a-2f0e9137ea2a" xmi:type="uml:LiteralInteger"/>
        <association xmi:idref="_18_4_1_e120334_1499417193507_432459_25518"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194106_588776_29139" xmi:uuid="40bd91d7-28d4-42c9-b0bc-ffb1323c4922" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455704047560_123573_42584" xmi:uuid="7673f078-d3c3-4d80-b3e7-abe1d5eb76b9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194106_588776_29139"/>
          <body> the specification of the ratio with the unit specified by the name. Where applicable, the following values shall be used: exa, peta, tera, giga, mega, kilo, hecto, deca, deci, centi, milli, micro, nano, pico, femto, atto. &lt;example&gt; 'milli' specifies that the unit is 0.001 times the unit specified by the name.&lt;/example&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Prefix</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193042_855579_23449"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194832_518306_35341" xmi:uuid="8be22565-8f81-4af8-851b-1601b2d271fb" xmi:type="uml:LiteralInteger"/>
        <association xmi:idref="_18_4_1_e120334_1499417193497_774171_25459"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194107_391469_29140" xmi:uuid="179775c0-ef1a-450d-9da3-6a008fc441c5" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455704069054_412941_42585" xmi:uuid="b45c2b50-e21e-45fc-ad3f-d82d8666b32c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194107_391469_29140"/>
          <body> the type of property that the Unit shall be used for. The value of this attribute need not be specified. &lt;example&gt; The unit 'metre' is used to measure quantities of type 'length'.&lt;/example&gt;</body>
        </ownedComment>
