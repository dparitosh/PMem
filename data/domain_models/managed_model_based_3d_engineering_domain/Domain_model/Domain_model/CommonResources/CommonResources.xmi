      <packagedElement xmi:id="_18_4_1_271a0567_1513689853299_21041_269089" xmi:uuid="711b129e-d3d1-4001-be75-0dfca553557d" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_290014c_1527251418036_108562_68732" xmi:uuid="e32f2082-1cb1-46b5-9dff-357cc500d8d7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1513689853299_21041_269089"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ExternalSourceSelector</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1513689853299_449857_269090" xmi:uuid="a4bfd9dd-95bd-4a87-bfb9-3c7e6b5825c4" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1666259670716_145658_165461" xmi:uuid="e5a44e34-e4e6-4b4c-80a3-994fe0f0582e" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1513689853299_449857_269090"/>
            <body>set the output id to null if input is null, otherwise if input is of type IdentifierProxyString it is set to input.value, otherwise if input is of type Identifier it is set to input.Id, otherwise if input is of type IdentifierProxyString it is set to input.Id.value, otherwise if input is of type Identifier it is set to input.Id.Id, otherwise it is set to input.Id(1).Id.</body>
          </ownedComment>
          <name>id</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1513689853299_21041_269089"/>
          <specification xmi:id="_18_4_1_271a0567_1513689853331_360786_269096" xmi:uuid="6796680d-5d96-4581-a573-a80dedd7b838" xmi:type="uml:OpaqueExpression">
            <body>id = if input.oclIsUndefined() then null else if input.oclIsTypeOf(IdentifierProxyString) then input.value else if input.oclIsTypeOf(Identifier) then input.Id else if input.Id.oclIsTypeOf(IdentifierProxyString) then input.Id.value else if input.Id.oclIsTypeOf(Identifier) then input.Id.Id else input.Id(1).Id endif endif endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_271a0567_1513689853299_299301_269091" xmi:uuid="c88048e8-65ab-4433-81f1-434af3fb22bb" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1666259680911_667708_165464" xmi:uuid="532bd827-40cf-4fc5-a89b-31d47794ce4f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1513689853299_299301_269091"/>
            <body>set the type to null if input is null, otherwise if input is of type Document or DocumentVersion it is set to 'Document', otherwise if input is of type DigitalFile it is set to 'URL', otherwise it is set to 'Unknown'.</body>
          </ownedComment>
          <name>type</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1513689853299_21041_269089"/>
          <specification xmi:id="_18_4_1_271a0567_1513689853331_914949_269097" xmi:uuid="3c37a330-8a01-4ddd-aff4-adba8f7d703c" xmi:type="uml:OpaqueExpression">
            <body>type = if input.oclIsUndefined() then null else if input.oclIsTypeOf(Document) or input.oclIsTypeOf(DocumentVersion) then 'Document' else if input.oclIsTypeOf(DigitalFile) then 'URL' else 'Unknown' endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1513689853315_341871_269093" xmi:uuid="6ba6ca1b-61e3-4034-a6ab-6bafee2e890d" xmi:type="uml:Port">
