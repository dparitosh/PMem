    <packagedElement xmi:id="_18_4_1_e120334_1499417193269_197274_23880" xmi:uuid="dd5c7767-3963-4acf-a37e-76a0a66ac474" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455730509233_746182_43250" xmi:uuid="0631db48-1d26-4a81-a238-399d83b0c23f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193269_197274_23880"/>
        <body>A TimeIntervalAssignment is an association of a TimeInterval with some product data. The TimeIntervalAssignment shall neither be used to convey effectivity information, i.e., information concerning valid use of product data, nor to convey retention information, nor duration information. &lt;note&gt; Such information is conveyed using Effectivity, RetentionPeriod, and Duration respectively. &lt;/note&gt;</body>
      </ownedComment>
      <name>TimeIntervalAssignment</name>
