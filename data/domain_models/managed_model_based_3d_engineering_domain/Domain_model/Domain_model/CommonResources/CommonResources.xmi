    <packagedElement xmi:id="_18_4_1_8e001ed_1513076037046_217523_42175" xmi:uuid="88ef9a51-49b7-4ffb-bf1b-a5d362748d3b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1513076037683_323043_42384" xmi:uuid="a60ce053-6eb0-4b65-84e9-99e4722c3dc1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513076037046_217523_42175"/>
        <body>A StateHypothesisToConfirmationRelationship is a relationship representing the fact that a StateObserved (via StateDefinitionHypothesisAssignment) has moved from being hypothesized as conforming to a StateDefinition to being confirmed (via StateDefinitionConfirmedAssignment) as conforming to a StateDefinition.</body>
      </ownedComment>
      <name>StateHypothesisToConfirmationRelationship</name>
      <generalization xmi:id="_18_4_1_8e001ed_1513160452168_324862_59344" xmi:uuid="49d4aedd-f6de-49c0-8252-66077f9755ce" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_8e001ed_1513156083559_699192_56384"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513161316657_359697_59520" xmi:uuid="1bef7fbc-79ee-4364-93cc-846ebd6e8c9b" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513161316667_288686_59522" xmi:uuid="6a4c004a-f9c0-497b-9b3f-9e0987ea269a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513161316657_359697_59520"/>
          <body>one object of StateDefinitionConfirmedAssignment that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
        </ownedComment>
        <name>ConfirmedState</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_8e001ed_1513076037042_133494_42168"/>
        <association xmi:idref="_18_4_1_8e001ed_1513161342674_616554_59540"/>
        <redefinedProperty xmi:idref="_18_4_1_8e001ed_1513156083562_721224_56386"/>
