        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193236_543690_23828"/>
        <body>A RetentionPeriod is the definition of a period of time that product data needs to be maintained due to organizational policy or legal requirements.</body>
      </ownedComment>
      <name>RetentionPeriod</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193777_218494_27493" xmi:uuid="0ed35812-f827-402a-8bd4-fc515b45777c" xmi:type="uml:Generalization">
