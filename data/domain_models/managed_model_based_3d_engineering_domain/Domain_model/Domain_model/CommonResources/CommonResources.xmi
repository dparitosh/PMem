          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ModelPropertyAssignmentSelector</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1550567745122_723851_222949" xmi:uuid="636c6d57-9c8e-46cf-8859-a492cda2c589" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676025706739_392516_169979" xmi:uuid="fe959adf-2a88-415e-aafe-8a9f372f2e31" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1550567745122_723851_222949"/>
            <body>if the input is a IndividualPartViewRelationship, ShapeElement, ShapeElementRelationship or ViewOccurrenceRelationship then the output is set to this input otherwise the output is set to null.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1550567745114_194142_222948"/>
          <specification xmi:id="_18_4_1_271a0567_1550567745137_520566_222956" xmi:uuid="7004ff6b-df56-43db-b382-9dd99e2f4d33" xmi:type="uml:OpaqueExpression">
            <body>outAssignedShapePropertySelect = if input.oclIsUndefined () then null else if Set{IndividualPartViewRelationship, ShapeElement, ShapeElementRelationship, ViewOccurrenceRelationship}-&gt;includes(input.oclType()) then input else null endif endif </body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
