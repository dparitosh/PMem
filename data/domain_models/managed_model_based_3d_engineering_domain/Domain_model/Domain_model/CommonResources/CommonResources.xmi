            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150257_453855_32289"/>
            <body>the org output is set to null if input is null, otherwise if input is of type Organization it is set to input.org, otherwise it is set to null. </body>
          </ownedComment>
          <name>org</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149886_900140_32230"/>
          <specification xmi:id="_18_4_1_290014c_1504705150322_594368_32380" xmi:uuid="654936ac-0f0c-488d-8695-f0ea310321cd" xmi:type="uml:OpaqueExpression">
            <body>org = if input.oclIsUndefined () then null else if input.oclIsTypeOf (Organization) then input.org else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1504705150257_522882_32290" xmi:uuid="d432aab2-8b5e-4c37-860c-1422145834af" xmi:type="uml:Constraint">
