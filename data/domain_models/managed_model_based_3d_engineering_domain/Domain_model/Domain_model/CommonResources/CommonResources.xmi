      <ownedComment xmi:id="_18_0_5_45e01bd_1455732696618_508931_43302" xmi:uuid="2f703ccd-41bd-4ec3-8785-64ac734fa4bf" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193118_267249_23607"/>
        <body>An IdentifierRelationship is a relationship between two Identifier objects.</body>
      </ownedComment>
      <name>IdentifierRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329163711_750395_42591" xmi:uuid="db41b581-5694-4f13-a2cf-dcf8656f705d" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121389_835026_163056" xmi:uuid="3374767b-61a1-44a9-a5be-658c57b2e0c5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121390_231081_163057" xmi:uuid="3c5734ee-7538-4b91-830c-8d84b436f88b" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//IdentifierRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Identifier and the relating Identifier shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:IdentifierRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459329197684_74279_42593" xmi:uuid="44e83838-798b-4ec0-a906-2726c89a6260" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329163711_750395_42591"/>
          <body>the related Identifier and the relating Identifier shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121390_167367_163058" xmi:uuid="801f7e81-a687-4015-8a9c-8ecc1e77dacd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121390_912093_163059" xmi:uuid="096bba67-0eac-4b3e-a3a7-f7bb008ed172" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193118_267249_23607"/>
        <specification xmi:id="_18_4_1_271a0567_1509114133343_160473_31204" xmi:uuid="d8659ed7-e5fc-42d1-8178-3bb209b8cc2a" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
