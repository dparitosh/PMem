        <general href="../AnalysisManagement/AnalysisManagement.xmi#_18_4_1_8e001ed_1513956354107_801842_71341"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193531_773091_25749" xmi:uuid="4b2bc684-3beb-4fbc-9272-90e511b6e028" xmi:type="uml:Generalization">
