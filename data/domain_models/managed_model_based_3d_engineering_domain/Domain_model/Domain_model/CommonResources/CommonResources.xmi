    <packagedElement xmi:id="_18_4_1_e120334_1499417193100_167127_23567" xmi:uuid="a0dfccbb-245f-4ab2-a577-d269b5466b6b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454497349825_991379_43139" xmi:uuid="c5d10498-efee-4ec2-8764-0481afd7c9c7" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193100_167127_23567"/>
        <body>An ExternalOwlObject is an item that is not included in the data exchange file and is defined by an URI.</body>
      </ownedComment>
      <name>ExternalOwlObject</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193682_451794_26887" xmi:uuid="5cd12687-1528-4eae-9be4-eb0f08cda844" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759175_748518_151308" xmi:uuid="14a363dd-ef3c-45cc-ad63-817fc295e8a8" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759175_217754_151309" xmi:uuid="f083ebf2-14ca-447b-ae3d-bedca3dae2bf" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExternalOwlObject[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="followingAndPrecedingIds" value="following-sibling::ExternalOwlObject/Individual union preceding-sibling::ExternalOwlObject/Individual"/&gt; &lt;sch:assert test="not(some $i in Individual, $j in $followingAndPrecedingIds satisfies ($i eq $j))"&gt; The URI shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:Individual -attribute_value:&lt;sch:value-of select="Individual"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
