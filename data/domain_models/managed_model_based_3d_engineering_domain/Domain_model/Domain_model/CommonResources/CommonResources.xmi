    <packagedElement xmi:id="_18_4_1_e120334_1499417193160_768362_23694" xmi:uuid="5f25c58a-a455-4b77-9a80-2e1a937b03b3" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455720200397_220497_43063" xmi:uuid="aef59a75-9a86-4d1c-bbd2-ee3b709815f4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193160_768362_23694"/>
        <body>An OrCondition is a type of Condition and represents a Boolean condition. The condition evaluates to true if at least one of its operands are true.</body>
      </ownedComment>
