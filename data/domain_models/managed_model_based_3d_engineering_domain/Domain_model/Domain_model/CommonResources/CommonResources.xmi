        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193154_41251_23680"/>
        <body>A NumericalContext is a context in which the number of significant digits and uncertainties may be defined. These number of significant digits and uncertainties apply to the NumericalValue objects that are used in that context.</body>
      </ownedComment>
      <name>NumericalContext</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193843_123148_27846" xmi:uuid="70c733bb-bfd1-43c4-8c60-a9281022a16e" xmi:type="uml:Property">
