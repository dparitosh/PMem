    <packagedElement xmi:id="_18_4_1_e120334_1499417193270_573457_23881" xmi:uuid="9f269517-4529-4178-8d72-bcf73c87164f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455726831271_463117_43183" xmi:uuid="b0d3b488-57e1-4059-a37e-5d1b1f052f1c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193270_573457_23881"/>
        <body>A TimeIntervalEffectivity is a type of Effectivity for which the domain of applicability is defined as a Duration.</body>
      </ownedComment>
      <name>TimeIntervalEffectivity</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332434396_169642_42736" xmi:uuid="9a226198-30ae-4171-935a-a6d34df47b81" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671462086025_355639_163081" xmi:uuid="20a20866-43dd-41e1-904a-1e3711c69237" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671462095350_249902_163082" xmi:uuid="76aaefcc-d00e-47ef-b581-070f7bd577a2" xmi:type="uml:Comment">
            <body>WR1: EXISTS(SELF\DatedEffectivity.StartDefinition) OR EXISTS(SELF\DatedEffectivity.EndDefinition);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459332510064_984121_42738" xmi:uuid="8ae9fb27-90ca-4b75-ba50-ecb5f28f0eb5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332434396_169642_42736"/>
          <body> one of the inherited attributes startDefinition or endDefinition shall be set.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759202_779199_151314" xmi:uuid="bbaa296e-2382-46f5-b9b0-e95ae85af0e0" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759202_594255_151315" xmi:uuid="203679b2-3d84-4fb1-b395-e858f552e774" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//Effectivity[@uid and substring-after(@xsi:type,':')='TimeIntervalEffectivity']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="StartDefinition or EndDefinition"&gt; At least one of the attributes StartDefinition or EndDefinition shall be set. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193270_573457_23881"/>
        <specification xmi:id="_18_4_1_271a0567_1509093354373_406722_30247" xmi:uuid="7261811e-a597-4a86-b647-6ca2cf40d0fd" xmi:type="uml:OpaqueExpression">
          <body>not(self.StartDefinition.oclIsUndefined()) xor not(self.EndDefinition.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193643_511791_26584" xmi:uuid="d13b3d7e-0324-4fad-95ed-a6863c04a0d0" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193061_500967_23497"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194098_480617_29095" xmi:uuid="cefdbd8d-cfc5-4276-8798-50e3a59765fb" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455726842317_445813_43184" xmi:uuid="d93dfec2-8f72-463e-99b8-1363018712a1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194098_480617_29095"/>
          <body> the Duration that defines the domain of validity.</body>
        </ownedComment>
        <name>EffectivityPeriod</name>
