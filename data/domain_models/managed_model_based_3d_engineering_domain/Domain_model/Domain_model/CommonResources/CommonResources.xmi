    <packagedElement xmi:id="_18_4_1_e120334_1499417193207_70429_23785" xmi:uuid="732ba06c-89db-402c-89cb-ae5954e8dce8" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1550740788497_286362_169736" xmi:uuid="0b0e421f-1101-41f7-877a-84d622a0a095" xmi:type="uml:Comment">
        <body>SMRLv9 Bug 7300 - Select mapping issue: extend ARM SELECT property_assignment_select</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455699161410_929553_42485" xmi:uuid="a1474597-0fdd-4397-a383-d907860caa85" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193207_70429_23785"/>
        <body>A PropertyDefinitionAssignment is a mechanism to assign a PropertyDefinition to an object. &lt;example&gt; A property "mass" defined in "kg" may be assigned to a Part.&lt;/example&gt;</body>
      </ownedComment>
      <name>PropertyDefinitionAssignment</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193974_683218_28550" xmi:uuid="dbc3d516-e84e-40d2-bc48-896537069608" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_45e01bd_1513335543949_713200_71800" xmi:uuid="280faa30-e2ec-4325-bf10-fd3e502014bd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193974_683218_28550"/>
          <body>the combination of the AssignedPropertyDefinition and the AssignedTo shall be unique.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759227_388542_151320" xmi:uuid="5353c8e4-e9f4-4fe7-87cf-c454c84c2d23" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759227_906228_151321" xmi:uuid="4b85d13f-218b-44b4-993b-b044e91c26ba" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PropertyDefinitionAssignment[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="assignedToUid" value="../@uid"/&gt; &lt;sch:let name="assignedPropDefUid" value="AssignedPropertyDefinition/PropertyDefinition/@uidRef"/&gt; &lt;sch:assert test="not(//PropertyDefinitionAssignment[@uid and ../@uid = $assignedToUid and AssignedPropertyDefinition/PropertyDefinition/@uidRef = $assignedPropDefUid and @uid != $uid])"&gt; The combination of the related part and the relating part shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:AssignedToAndAssignedPropertyDefinitionUids -attribute_value:&lt;sch:value-of select="concat($assignedToUid, ',', $assignedPropDefUid)"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671466834950_383997_163154" xmi:uuid="68862e46-2e75-4e92-9684-9bd6062004e2" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671466841812_135593_163155" xmi:uuid="e232589c-7822-47e8-af6e-3139cbf6dd43" xmi:type="uml:Comment">
            <body>UR1: AssignedTo, AssignedPropertyDefinition;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193207_70429_23785"/>
        <specification xmi:id="_18_4_1_e120334_1499417194728_139311_34310" xmi:uuid="5a5c47eb-1a46-45c2-8b4f-d5fafbe1b266" xmi:type="uml:OpaqueExpression">
          <body>PropertyDefinitionAssignment::allInstances()-&gt;isUnique(Sequence{AssignedTo, AssignedPropertyDefinition})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
