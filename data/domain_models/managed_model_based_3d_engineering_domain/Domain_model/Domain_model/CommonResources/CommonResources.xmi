    <packagedElement xmi:id="_18_4_1_e120334_1499417193100_264857_23566" xmi:uuid="a41e0dc4-7928-4077-8807-244d09f6c754" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454497316651_367388_43137" xmi:uuid="43c7f643-8357-4691-b358-4b349c257618" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193100_264857_23566"/>
        <body>An ExternalOwlClass is a type of Class that represents a reference to a class that is not included in the data exchange file and is defined by an URI.</body>
      </ownedComment>
      <name>ExternalOwlClass</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193682_308030_26883" xmi:uuid="a0c7a94b-8a4e-48f6-8bb5-388ee01ef728" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759311_367936_151326" xmi:uuid="4a9a8f79-2044-4111-99ca-868b60047b1b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759311_688523_151327" xmi:uuid="793a80f8-e3ff-4af5-8002-49c8910a16e5" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExternalOwlClass[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="followingAndPrecedingIds" value="following-sibling::ExternalOwlClass/Class union preceding-sibling::ExternalOwlClass/Class"/&gt; &lt;sch:assert test="not(some $i in Class, $j in $followingAndPrecedingIds satisfies ($i eq $j))"&gt; The URI shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:Class -attribute_value:&lt;sch:value-of select="Class"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671466717428_651069_163148" xmi:uuid="4c7d1489-05f3-4543-b89a-2482e7eb0ebd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671466724162_222152_163149" xmi:uuid="98c0b15e-0c0d-4c26-87ea-7a181fc5cb02" xmi:type="uml:Comment">
            <body>UR1: Class;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_45e01bd_1513334705454_866058_71466" xmi:uuid="ef9d4741-1ea9-4ba0-b313-e25eddca3775" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193682_308030_26883"/>
          <body>the URI shall be unique.</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193100_264857_23566"/>
        <specification xmi:id="_18_4_1_e120334_1499417194485_398419_32061" xmi:uuid="424fa7df-1fcb-4b5a-a1bd-8261051ac85d" xmi:type="uml:OpaqueExpression">
          <body>ExternalOwlClass::allInstances()-&gt;isUnique(Class)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
