        <ownedComment xmi:id="_18_0_5_45e01bd_1455695081338_549605_42431" xmi:uuid="fb3c7c1a-7e9d-479f-8a85-cd9d1e63ed6a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193833_557832_27789"/>
          <body> specifies the qualifier for the MeasureQualification. A qualifier may be either an ExternalTypeQualifier, a PrecisionQualifier, a PreDefinedTypeQualifier or an UncertaintyQualifier.</body>
        </ownedComment>
