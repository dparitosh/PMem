    <packagedElement xmi:id="_18_4_1_e120334_1499417193209_684159_23787" xmi:uuid="875ace19-c08b-4b79-bb1f-6e1cdd8ff465" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455699535014_834548_42501" xmi:uuid="d100712e-82da-42b5-81bd-0e2273dd07e1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193209_684159_23787"/>
        <body>A PropertyDefinitionRelationship is a relationship between two PropertyDefinition objects. &lt;example&gt; A PropertyDefinitionRelationship may be used to indicate that the value of one PropertyDefinition can be derived from the value of another PropertyDefinition.&lt;/example&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551200085313_404699_128054" xmi:uuid="dc8f1879-2f55-40b4-8de3-272a84a5922b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>PropertyDefinitionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459331597408_207358_42703" xmi:uuid="6a5a76dc-31aa-4a17-abca-25e9a9bb9aa5" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459331634097_897827_42705" xmi:uuid="30e9e552-554b-4e41-bcfa-ed4f7edffaa2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331597408_207358_42703"/>
          <body>the related PropertyDefinitionSelect and the relating PropertyDefinitionSelect shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121423_393485_163074" xmi:uuid="5b12e27d-0436-4dfb-95fd-23d9dc027f40" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121423_704526_163075" xmi:uuid="3a42d978-2a25-4502-a705-e093cbcf7547" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121423_393223_163072" xmi:uuid="5e4162eb-0a3c-4e3f-a926-f7ef352a33aa" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121423_984985_163073" xmi:uuid="37e8a646-4410-411c-89ef-c914a833c474" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PropertyDefinitionRelationship[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="uidRelating" value="../@uid"/&gt; &lt;sch:let name="uidRelated" value="Related/*/@uidRef"/&gt; &lt;sch:assert test="not(../@uid = Related/*/@uidRef)"&gt; The related PropertyDefinition and the relating PropertyDefinition shall be different. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:PropertyDefinitionRelationship.WR1 -relating:&lt;sch:value-of select="$uidRelating"/&gt; -related:&lt;sch:value-of select="$uidRelated"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193209_684159_23787"/>
        <specification xmi:id="_18_4_1_271a0567_1509116394220_988461_31496" xmi:uuid="37ff72b9-6bc7-4543-987d-cf86da7dc3e6" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193706_383954_27083" xmi:uuid="14d6d4c5-7866-40d0-ada5-61add8cf7b4c" xmi:type="uml:Generalization">
