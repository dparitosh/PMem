    <packagedElement xmi:id="_18_4_1_e120334_1499417193283_976319_23905" xmi:uuid="f111fb04-05f2-49c9-8965-accb15ba49a2" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455704286175_85122_42599" xmi:uuid="8c5d8a34-25b5-4a85-b843-dabfda94fe96" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193283_976319_23905"/>
        <body>A ValueWithUnit is a type of PropertyValue with either a single numerical measure, or a range of numerical measures with upper, lower, or upper and lower bounds.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_290014c_1514469729099_381577_49461" xmi:uuid="ca5b9217-88e6-4229-8cd6-6f8a54710904" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_290014c_1515170665748_569102_141648"/>
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Value_with_unit-value_component"/>
        <body>Domain ValueWithUnit object is abstract. The quantity information of the value is not defined in Domain ValueWithUnit object, but in its subtypes. ARM Numerical_item_with_unit object is also abstract and has an attribute to specify the quantity information. Thus, this quantity information cannot be provided from a direct mapping from a Domain attribute. This direct mapping will be possible in the subtypes mapping. In this case, the ARM value_component is set as /IGNORE/ accordingly to the methodology. NOTE: Numerical_item_with_unit is a subtype of measure_item and Value_with_unit. ValueWithUnit is a subtype of PropertyValue.</body>
      </ownedComment>
      <name>ValueWithUnit</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193982_838917_28590" xmi:uuid="842a6040-b6af-41cb-946d-00a94408b45a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193210_153036_23790"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194112_122288_29161" xmi:uuid="d25e28e2-8b18-472c-958b-c6ec9219b007" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455704304487_622564_42600" xmi:uuid="ce15585e-6287-491b-8203-3e56ac435c23" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194112_122288_29161"/>
          <body> specifies the number of decimal digits that are relevant for the use of the ValueWithUnit. If present, the numerical measure or range may be specified using more digits than the significant digits but shall not be specified using less digits. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>SignificantDigits</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#INTEGER"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194835_62768_35372" xmi:uuid="4994b5c8-c3e7-471b-96fc-30080e571007" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194112_546756_29162" xmi:uuid="5dc7dd14-34c4-4bb7-964e-77a377197db7" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455704315156_894777_42601" xmi:uuid="275c7556-4792-482b-990d-799aac858d68" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194112_546756_29162"/>
          <body> specifies the unit in which the ValueWithUnit is expressed.</body>
        </ownedComment>
