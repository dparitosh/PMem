          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332569691_205084_42739"/>
          <body>the related TimeInterval and the relating TimeInterval shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121498_969785_163098" xmi:uuid="727391fd-1064-4365-986d-bb02195a67d8" xmi:type="uml:Comment">
