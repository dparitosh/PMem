            <body>result = if input.oclIsUndefined then null else Date_time(date_component=Calendar_date(year_component=input.subString(1,4), month_component=input.subString(6,7), day_component=input.subString(9-10), time_component=Local_time(hour_component=input.subString(12,13), minute_component=input.subString(15,16), second_component=input.subString(18,19), zone=Time_offset(sense=exact)))) endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_290014c_1504705150290_338015_32321" xmi:uuid="5d63b61d-dae5-470e-b1d7-9d64f139c1b5" xmi:type="uml:Port">
