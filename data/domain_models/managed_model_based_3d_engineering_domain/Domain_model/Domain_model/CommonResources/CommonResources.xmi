      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193566_751238_26016" xmi:uuid="5fafc3dd-cf2d-4bc2-b53b-c878178f747e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8e001ed_1453885876113_533591_42421" xmi:uuid="82858bc1-2b1b-427f-96ba-dc98cedabb6c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193566_751238_26016"/>
          <body>the identifier or set of identifiers for the DateTimeAssignment. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193119_518292_23608"/>
