          <constrainedElement xmi:idref="_18_4_1_290014c_1534945255479_284458_92826"/>
          <specification xmi:id="_18_4_1_290014c_1534945255493_414832_92831" xmi:uuid="9a0306e0-3524-44b7-af63-5e948eaea105" xmi:type="uml:OpaqueExpression">
            <body>si_unit = if input.oclIsUndefined() then 'undefined' elseif input in ('SI', 'SI derived unit','Unspecified SI derived unit') then true else false endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
