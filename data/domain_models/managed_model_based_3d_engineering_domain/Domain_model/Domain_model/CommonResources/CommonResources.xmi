        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513093145422_184044_52778"/>
        <body>A StateDefinitionRelationship is an association between two or more StateDefinition objects. &lt;note&gt; Relationships between StateDefinition entities may be used to support fault diagnosis.&lt;/note&gt;</body>
      </ownedComment>
      <name>StateDefinitionRelationship</name>
      <generalization xmi:id="_18_4_1_65b021e_1721221107843_606931_148848" xmi:uuid="fc61c90c-d53f-494c-b7bf-5ab319e6968b" xmi:type="uml:Generalization">
