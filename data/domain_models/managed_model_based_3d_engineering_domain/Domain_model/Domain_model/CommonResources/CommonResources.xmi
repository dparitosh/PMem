    <packagedElement xmi:id="_18_4_1_e120334_1499417193061_500967_23497" xmi:uuid="1a1a3d5d-329f-42d4-81b5-fe7b4cb79e8b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455719203742_222670_43018" xmi:uuid="2f3fda40-d256-4770-b7de-661041d0df15" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193061_500967_23497"/>
        <body>A DatedEffectivity is a type of Effectivity for which the domain of applicability is defined by its attributes StartDefinition or EndDefinition.</body>
      </ownedComment>
      <name>DatedEffectivity</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459327053450_146160_42531" xmi:uuid="859a0f79-a1e7-45a7-9a50-763cbeb3b72a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671446737274_819542_162941" xmi:uuid="0eedf15e-9b6b-4a50-af0a-c0bd1dd90dac" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446745518_195802_162942" xmi:uuid="8c7abcd2-53f2-4a0c-b5b4-fc189d0067af" xmi:type="uml:Comment">
            <body>WR1: EXISTS(SELF\DatedEffectivity.StartDefinition) OR EXISTS(SELF\DatedEffectivity.EndDefinition);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759283_955423_151324" xmi:uuid="30c5aa78-631d-488a-a70d-23d17d28fc58" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759283_857576_151325" xmi:uuid="d3db966b-a456-406f-8323-a3c29239b4ed" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//Effectivity[@uid and substring-after(@xsi:type,':')='DatedEffectivity']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="StartDefinition or EndDefinition"&gt; At least one of the attributes StartDefinition or EndDefinition shall be set. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459327129550_682939_42533" xmi:uuid="ebe18abe-26c9-43fe-9445-3fc76fde0c46" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327053450_146160_42531"/>
          <body> at least one of the attributes StartDefinition or EndDefinition shall be set.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193061_500967_23497"/>
        <specification xmi:id="_18_4_1_271a0567_1509091509595_586819_30165" xmi:uuid="7ad8011b-1e8e-4daf-b1d2-6ad4a4ccc516" xmi:type="uml:OpaqueExpression">
          <body>not(self.StartDefinition.oclIsUndefined()) or not(self.EndDefinition.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193561_129903_25984" xmi:uuid="135a3165-d509-4d81-9929-2c63a16f95d8" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193084_102089_23537"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_271a0567_1522139008201_39949_194575" xmi:uuid="b74c3569-3be5-4b7e-9ee5-2695058d19d0" xmi:type="uml:Port">
        <name>datedEffectivity</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Dated_effectivity"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_271a0567_1529932883046_701801_84092" xmi:uuid="ec951d66-ca49-4071-9556-f7430d49c426" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_271a0567_1529932883046_227995_84094" xmi:uuid="f1e71473-c988-48f6-b597-bb7b271d1502" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1529932883046_701801_84092"/>
          <body> the DateTimeString or Event that defines the upper bound of the interval of applicability. The value of this attribute need not be specified. If the value for this attribute is not specified, the interval of applicability has no upper bound.</body>
        </ownedComment>
        <name>EndDefinition</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193091_49380_23547"/>
        <lowerValue xmi:id="_18_4_1_271a0567_1529932883046_556226_84095" xmi:uuid="0905eebc-d666-4650-819c-f41861599734" xmi:type="uml:LiteralInteger"/>
