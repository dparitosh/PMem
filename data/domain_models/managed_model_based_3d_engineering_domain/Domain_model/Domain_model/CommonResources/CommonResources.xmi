    <packagedElement xmi:id="_18_4_1_e120334_1499417193103_699870_23575" xmi:uuid="a6fbbc61-be2d-4293-b640-13b414b5322f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_290014c_1513846792492_448838_50390" xmi:uuid="61091d68-413a-40ad-8055-acf929c6ae66" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_290014c_1513176263548_388357_55092"/>
        <body>Exntern_context_dependent_unit is a subtype of Unit. Domain Unit object maps to ARM Unit object, but it should be noted that Domain Unit object covers the case of both derived and conversion Unit as well. Thus, the mapping of Domain ExternalUnit Object doesn't map to External_conversion_based_unit but to External_context_dependent_unit ARM object.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455694730793_901870_42419" xmi:uuid="e2c98937-9031-416e-bade-a79dd177a31b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193103_699870_23575"/>
        <body>An ExternalUnit is an external specification of a quantity.</body>
      </ownedComment>
      <name>ExternalUnit</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193688_654232_26925" xmi:uuid="559976cc-f44e-4fc2-911b-02cde28bde21" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_45e01bd_1513334882325_16504_71481" xmi:uuid="793da0c5-65b2-4b57-b0fb-be30c361aedb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193688_654232_26925"/>
          <body>the attribute SameAs shall be unique.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759220_394276_151318" xmi:uuid="8201d01a-9d9a-4cc1-82ba-bc9348ea7e56" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759220_168470_151319" xmi:uuid="6f2f4673-6878-4603-bc87-70e02f680422" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExternalUnit[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="sameAsExternalItem" value="if(SameAs/Proxy/Individual/ExternalItem/@uidRef) then SameAs/Proxy/Individual/ExternalItem/@uidRef else ()"/&gt; &lt;sch:let name="sameAsExternalOwlObject" value="if(SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()"/&gt; &lt;sch:let name="sameAsProxyString" value="if(SameAs/Proxy/Individual/ProxyString) then SameAs/Proxy/Individual/ProxyString else ()"/&gt; &lt;sch:let name="sameAs" value="$sameAsExternalItem union $sameAsExternalOwlObject union $sameAsProxyString"/&gt; &lt;sch:let name="followingAndPrecedingExternalItem" value="(if(following-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalItem/@uidRef) then following-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalItem/@uidRef else ()) union (if(preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalItem/@uidRef) then preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalItem/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingExternalOwlObject" value="(if(following-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then following-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()) union (if(preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingProxyString" value="(if(following-sibling::ExternalUnit/SameAs/Proxy/Individual/ProxyString) then following-sibling::ExternalUnit/SameAs/Proxy/Individual/ProxyString else ()) union (if(preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ProxyString) then preceding-sibling::ExternalUnit/SameAs/Proxy/Individual/ProxyString else ())"/&gt; &lt;sch:let name="followingAndPreceding" value="$followingAndPrecedingExternalItem union $followingAndPrecedingExternalOwlObject union $followingAndPrecedingProxyString"/&gt; &lt;sch:assert test="not(some $i in $sameAs, $j in $followingAndPreceding satisfies ($i eq $j))"&gt; The attribute SameAs shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:SameAs -attribute_value:&lt;sch:value-of select="$sameAs"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671464522556_384702_163122" xmi:uuid="fd3abcb8-e444-42fc-a905-ea3d4fa11cb5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671464522556_740560_163123" xmi:uuid="2316ccda-ebf8-44e1-a830-af3428683c1f" xmi:type="uml:Comment">
            <body>UR1: SameAs;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193103_699870_23575"/>
        <specification xmi:id="_18_4_1_e120334_1499417194489_4380_32098" xmi:uuid="cc83ad46-e17a-4a43-b0e9-886b01d111eb" xmi:type="uml:OpaqueExpression">
          <body>ExternalUnit::allInstances()-&gt;isUnique(SameAs)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193688_775733_26922" xmi:uuid="178d0da9-396e-46b0-858f-8f5b1162e572" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193280_938492_23897"/>
      </generalization>
