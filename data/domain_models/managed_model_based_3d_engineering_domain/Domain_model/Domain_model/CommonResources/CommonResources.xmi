    <packagedElement xmi:id="_18_4_1_e120334_1499417193094_795693_23554" xmi:uuid="5f841b3e-4a2e-4be4-af7d-c2cb47d9e813" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454497170087_384508_43133" xmi:uuid="d5497454-db21-4839-b338-fc86994816b9" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193094_795693_23554"/>
        <body> An ExternalClassSystem is a scheme used to define the categorization of an item. &lt;example&gt;A dictionary collecting the conventional definitions of technical properties is an example of an ExternalClassSystem. &lt;/example&gt;</body>
      </ownedComment>
      <name>ExternalClassSystem</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193672_956051_26818" xmi:uuid="06e1cc8a-4d7b-44d2-ae78-eedb3a2603c0" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759370_930164_151332" xmi:uuid="7b8d4089-3a83-4a08-9089-f96261ffe31b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759370_162060_151333" xmi:uuid="12bedc9e-dede-49ea-96eb-44d47a5d1470" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ExternalClassSystem[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="id" value="if (Id/@id) then (Id/@id) else (concat(Id/Identifier/@id, Id/Identifier/@idRoleRef, Id/Identifier/@idContextRef)) "/&gt; &lt;sch:let name="source" value="if (Source/*/@uidRef) then (Source/*/@uidRef) else if (Source/Identifier) then (concat(Source/Identifier/@id, Source/Identifier/@idRoleRef, Source/Identifier/@idContextRef)) else Source/IdentifierString"/&gt; &lt;sch:assert test="not(//ExternalClassSystem[@uid and (if (Id/@id) then (Id/@id) else (concat(Id/Identifier/@id, Id/Identifier/@idRoleRef, Id/Identifier/@idContextRef))) = $id and (if (Source/*/@uidRef) then (Source/*/@uidRef) else if (Source/Identifier) then (concat(Source/Identifier/@id, Source/Identifier/@idRoleRef, Source/Identifier/@idContextRef)) else Source/IdentifierString) = $source and @uid != $uid])"&gt; The combination of id and source shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:Id,Source -attribute_value:&lt;sch:value-of select="$id"/&gt;,&lt;sch:value-of select="$source"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671466557109_857891_163137" xmi:uuid="a5020b10-6075-4418-86df-4921eb27d797" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671466557109_949011_163138" xmi:uuid="53e301bd-54e9-4003-9b1e-4c21a00aa2cf" xmi:type="uml:Comment">
            <body>UR1: Id, Source;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_45e01bd_1513334634224_908444_71461" xmi:uuid="c85e7547-bde0-4b1e-b106-0d8b31789f8d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193672_956051_26818"/>
          <body>the combination of Id and Source shall be unique.</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193094_795693_23554"/>
        <specification xmi:id="_18_4_1_e120334_1499417194477_126259_32004" xmi:uuid="b04e2e35-bec5-46d0-b23f-01272bb35a61" xmi:type="uml:OpaqueExpression">
          <body>ExternalClassSystem::allInstances()-&gt;isUnique(Sequence{Id, Source})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193672_97806_26815" xmi:uuid="0ba8bb1a-cb68-40dd-b88b-187bc356fa29" xmi:type="uml:Generalization">
