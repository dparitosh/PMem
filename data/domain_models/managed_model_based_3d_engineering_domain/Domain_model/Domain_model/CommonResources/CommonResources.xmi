    <packagedElement xmi:id="_18_4_1_e120334_1499417193037_867604_23443" xmi:uuid="5f12a81e-8eea-4210-bb51-a071ae05b302" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_45e01bd_1517569757354_622185_505408" xmi:uuid="6c81c482-e863-4486-ad57-e269c6fa1a04" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193037_867604_23443"/>
        <body>A model artefact that allows a generic data type to be used as a class object for a select. The CharacterStringProxy allows to represent a character as a string. &lt;note&gt;As it is a modelling artefact, it may not be represented in the implementation form if the implementation languages have more efficient representation of the type in the select.&lt;/note&gt;</body>
      </ownedComment>
      <name>CharacterStringProxy</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193460_132607_25232" xmi:uuid="216c5a75-9adc-4a48-81b3-fd3bda3f86ba" xmi:type="uml:Generalization">
