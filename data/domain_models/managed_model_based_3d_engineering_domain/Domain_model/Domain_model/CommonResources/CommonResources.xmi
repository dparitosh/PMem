    <packagedElement xmi:id="_18_4_1_e120334_1499417193150_468176_23671" xmi:uuid="4d0cb5de-6181-4dca-b337-45f7c47ca2bc" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455697213550_586591_42453" xmi:uuid="1caad162-55d7-4a7c-a731-d204275be7ec" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193150_468176_23671"/>
        <body>A MomentsOfInertia is a type of ShapeDependentProperty that describes the matrix of inertia of a rigid body.</body>
      </ownedComment>
      <name>MomentsOfInertia</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193839_858011_27821" xmi:uuid="dd116041-8047-41f2-b031-8048dd115b71" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193242_683026_23838"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193839_657469_27822" xmi:uuid="6fd3016f-2029-4e10-a636-8c9b7d32c01c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455697248443_645049_42454" xmi:uuid="6e9b9f14-3823-4f65-a8e3-d39b330c6869" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193839_657469_27822"/>
          <body> the GeometricCoordinateSpace in which the property is applicable. &lt;note&gt; The values of geometry related properties are specified relative to a GeometricCoordinateSpace. &lt;/note&gt;&lt;example&gt;The referenceAxisPlacement for the MomentsOfInertia is defined within the coordinate space. A MomentsOfInertia object may be specified in different coordinate spaces for different purposes.&lt;/example&gt;</body>
        </ownedComment>
        <name>DefinedIn</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193112_722991_23591"/>
        <association xmi:idref="_18_4_1_e120334_1499417193710_135506_27106"/>
        <redefinedProperty xmi:idref="_18_4_1_e120334_1499417194052_749179_28893"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193840_790158_27823" xmi:uuid="8b9a5c4f-e874-443f-a376-12be2d7aef40" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455697293280_568679_42455" xmi:uuid="52da87a9-5cef-4676-bdb0-8dec7429d1fd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193840_790158_27823"/>
          <body> the 9 inertia coefficients. &lt;note&gt; The matrix defined by the InertiaValue is symmetric with respect to the main diagonal. For that reason, the values of the coefficients are equal, if mirrored along this diagonal. As a consequence, there are 6 different values in the InertiaValue.&lt;/note&gt;</body>
        </ownedComment>
        <name>InertiaValue</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193021_629503_23400"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194618_964446_33239" xmi:uuid="fdc2a198-796b-42f5-b606-893c0550833e" xmi:type="uml:LiteralUnlimitedNatural">
          <value>3</value>
        </upperValue>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193379_136354_24635"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193840_557565_27824" xmi:uuid="d5c18a68-26a7-4177-85d1-d1787943256a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455697315331_491436_42456" xmi:uuid="df3520c2-7cdc-4c29-85b2-d157f1432070" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193840_557565_27824"/>
          <body> the AxisPlacement which was used to calculate the InertiaValue.</body>
        </ownedComment>
        <name>ReferenceAxisPlacement</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
