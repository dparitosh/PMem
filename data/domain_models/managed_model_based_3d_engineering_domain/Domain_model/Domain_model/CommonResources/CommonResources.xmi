      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194052_749179_28893" xmi:uuid="78332608-7f20-4a68-91d5-b636bd87096f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455703686796_202058_42568" xmi:uuid="dbf09cf8-2b88-439e-8749-57f12cd42afd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194052_749179_28893"/>
          <body> specifies the GeometricCoordinateSpace in which the property is applicable. &lt;note&gt; The values of geometry-related properties are specified relative to a GeometricCoordinateSpace. &lt;/note&gt;&lt;example&gt;A CentreOfMass may be specified in different coordinate spaces for different dimensioning applications.&lt;/example&gt; The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>DefinedIn</name>
        <visibility>public</visibility>
