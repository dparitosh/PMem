      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193808_987532_27670" xmi:uuid="f9270f63-35ab-486a-8649-ef6a28fac852" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455732918157_441419_43311" xmi:uuid="86d40bf0-53bd-4b3f-901e-106b5e64d464" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193808_987532_27670"/>
          <body> the language in which the text is expressed. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Language</name>
