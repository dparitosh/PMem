          <annotatedElement xmi:idref="_18_4_1_290014c_1504705149886_900140_32230"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ContextSelector</name>
        <ownedRule xmi:id="_18_4_1_290014c_1504705150257_453855_32289" xmi:uuid="126341a5-a9f8-4c6c-be10-c1d6d53c7084" xmi:type="uml:Constraint">
