    <packagedElement xmi:id="_18_4_1_e120334_1499417193271_708558_23883" xmi:uuid="b2681b34-7fb5-40b7-8d0e-195201d8f8d5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455730779894_233825_43264" xmi:uuid="0cdbdcc8-ba75-4439-8faf-3f73a8f3a839" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193271_708558_23883"/>
        <body>A TimeIntervalWithBounds is a type of TimeInterval. A TimeIntervalWithBounds is bounded either on one side or both sides. &lt;note&gt; If neither SecondaryBound nor Duration are specified, the time interval begins at the point in time identified by PrimaryBound and has no specified end point.&lt;/note&gt;</body>
      </ownedComment>
      <name>TimeIntervalWithBounds</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459333130066_81466_42752" xmi:uuid="0271cc6e-06ea-404b-aa77-71eed446c642" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459333171150_602855_42754" xmi:uuid="0b8e80d0-ca46-4513-be81-51b2ccc691da" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333130066_81466_42752"/>
          <body> either a Duration or a SecondaryBound can be specified.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759191_879294_151312" xmi:uuid="18ea7771-caf1-4a30-a5f8-fd9da982f0ca" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759191_783825_151313" xmi:uuid="b6a6be8b-32fe-44fb-bdd7-76b6927e8f9c" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Duration) or not(SecondaryBound)"&gt; Either a Duration or a SecondaryBound can be specified. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671462141257_835476_163083" xmi:uuid="53ca5803-1fb1-4f90-a3bd-c0551cf16883" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671462149012_987990_163084" xmi:uuid="b07ee188-c03e-44d7-8e04-253f64fe9069" xmi:type="uml:Comment">
            <body>WR1: NOT (EXISTS (SecondaryBound) AND EXISTS (Duration));</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193271_708558_23883"/>
        <specification xmi:id="_18_4_1_271a0567_1509106584142_717046_30322" xmi:uuid="a0e8c4c2-40bc-44dd-aac9-4c3708b19774" xmi:type="uml:OpaqueExpression">
          <body>self.SecondaryBound.oclIsUndefined() or self.Duration.oclIsUndefined()</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459333178354_556674_42755" xmi:uuid="9c66fca2-8d21-469d-9779-124a49529c10" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671462164049_433195_163085" xmi:uuid="5d5f97ff-32e8-41fc-a354-b06c88efa0a5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671462170441_261050_163086" xmi:uuid="ac62f6ea-4999-47ff-a445-e5504331d7df" xmi:type="uml:Comment">
            <body>WR2: EXISTS (PrimaryBound) OR EXISTS (SecondaryBound);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459333212200_801540_42757" xmi:uuid="c52e9424-38be-4df4-bd19-0a793dd209a9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333178354_556674_42755"/>
          <body> at least one bound has to be specified.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759184_443179_151310" xmi:uuid="f28cd4d4-7b0a-4702-903f-ba4fe8e19fe0" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759184_315936_151311" xmi:uuid="2156cfa3-b398-44ee-b957-35ca40ab5f3c" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="PrimaryBound or SecondaryBound"&gt; At least one bound has to be specified. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193271_708558_23883"/>
        <specification xmi:id="_18_4_1_271a0567_1509106908448_733301_30361" xmi:uuid="4a736099-0016-430d-9c26-a74efbcf1989" xmi:type="uml:OpaqueExpression">
          <body>not(self.PrimaryBound.oclIsUndefined()) or not(self.SecondaryBound.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417194095_984676_29081" xmi:uuid="7edf7f77-fd1e-4909-9682-40abd870cfdb" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193269_987360_23879"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194100_229334_29104" xmi:uuid="fa8127bf-2510-4579-9af1-af4f9104c7b0" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455730804599_198878_43265" xmi:uuid="3c5df83b-764b-4d23-8124-b6ae1c32dd4c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194100_229334_29104"/>
          <body> the length of the time interval from the PrimaryBound. The value of this attribute need not be specified. &lt;note&gt; If positive, the TimeIntervalWithBounds defines a lower bounded time interval, else an upper bounded time interval.&lt;/note&gt;</body>
        </ownedComment>
        <name>Duration</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193082_21699_23532"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194827_819638_35294" xmi:uuid="742b73ef-3b99-45ba-9746-61293536c49b" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193637_859343_26546"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194100_142956_29105" xmi:uuid="7a6a283a-0eeb-4508-8a6b-4a47a2bc7b89" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455730817274_691836_43266" xmi:uuid="9db6d684-04ba-4460-bafe-9789f38ace41" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194100_142956_29105"/>
          <body> the bound of the TimeIntervalWithBounds from which the length of the time interval is measured. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>PrimaryBound</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193091_49380_23547"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194827_309956_35297" xmi:uuid="4cedb4b8-ea5c-4aca-a400-08953a5675c3" xmi:type="uml:LiteralInteger"/>
        <association xmi:idref="_18_4_1_e120334_1499417193665_735313_26775"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194101_687324_29106" xmi:uuid="b8c9c3e1-4053-4ccb-9153-68ca6ad24440" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455730828907_3318_43267" xmi:uuid="d1673474-f936-406b-8694-9d45744fa7bb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194101_687324_29106"/>
          <body> the other bound of the TimeIntervalWithBounds. The value of this attribute need not be specified.</body>
        </ownedComment>
