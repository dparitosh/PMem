    <packagedElement xmi:id="_18_4_1_e120334_1499417193242_683026_23838" xmi:uuid="96a01be3-dd77-420c-9a8a-ea6d3925499f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455703573885_786513_42562" xmi:uuid="9f18aa3c-06fd-4945-b829-8b971ce1700c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193242_683026_23838"/>
        <body>A ShapeDependentProperty is a characteristic of the shape, or of a portion of the shape of an object. This object is either a Part, an occurrence of a Part in the product structure or the physical realization of a Part. &lt;note&gt; A ShapeDependentProperty is independent of the representations of the shape.&lt;/note&gt;</body>
      </ownedComment>
      <name>ShapeDependentProperty</name>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194050_61151_28888" xmi:uuid="2f59d0d9-e877-45b8-b25a-2ed4536c8bf6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455703605127_478418_42563" xmi:uuid="0c3d71ae-0fa5-4a08-9c2a-5aaf1d601474" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194050_61151_28888"/>
          <body> the identifier or set of identifiers for the ShapeDependentProperty. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193119_518292_23608"/>
