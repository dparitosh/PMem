    <packagedElement xmi:id="_18_4_1_8e001ed_1513076037047_308480_42178" xmi:uuid="d647ce6c-a734-4f3f-9155-8c43e0632476" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1513076037684_106707_42396" xmi:uuid="51a0c2d5-92f7-456a-9d92-1c85883655e5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513076037047_308480_42178"/>
        <body>A StatePredictedToObserved is a type of StateRelationship. It specifies the relationship between two individual states, one of which is a StatePredicted to a second state which is a StateObserved.</body>
      </ownedComment>
