        <ownedComment xmi:id="_18_4_1_271a0567_1529932907555_23050_84104" xmi:uuid="c789d305-779d-442e-a24b-fef8b7b51a97" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1529932907539_345407_84102"/>
          <body> the DateTimeString or Event that defines the lower bound of the interval of applicability. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>StartDefinition</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193091_49380_23547"/>
        <lowerValue xmi:id="_18_4_1_271a0567_1529932907555_666835_84105" xmi:uuid="82568967-5fc8-4545-9fdf-beeeb8b6ea69" xmi:type="uml:LiteralInteger"/>
