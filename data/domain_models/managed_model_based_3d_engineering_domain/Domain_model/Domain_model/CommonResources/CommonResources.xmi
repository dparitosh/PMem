        <ownedComment xmi:id="_18_4_1_8e001ed_1513161331990_8424_59532" xmi:uuid="1f41d78c-bc39-41b9-bb46-8ac406474a1a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513161331990_971519_59530"/>
          <body>the other object of StateDefinitionHypothesisAssignment that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
        </ownedComment>
