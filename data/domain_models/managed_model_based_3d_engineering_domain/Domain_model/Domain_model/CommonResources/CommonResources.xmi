          </ownedComment>
          <name>complex</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149884_414486_32229"/>
          <specification xmi:id="_18_4_1_290014c_1504705150321_942175_32370" xmi:uuid="63c04eba-8d16-4efe-8f77-9a56fbf8696b" xmi:type="uml:OpaqueExpression">
            <body>complex = if input.oclIsUndefined () then null else if input.oclIsTypeOf(IdentifierSet) then input.elements else if input.oclIsTypeOf(Identifier) then input else null endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
