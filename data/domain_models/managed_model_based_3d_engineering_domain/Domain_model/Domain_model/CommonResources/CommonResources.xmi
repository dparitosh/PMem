            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150251_196150_32283"/>
            <body>set simple to null if input is null, else if input is of type IdentifierStringProxy it is set to input.value, otherwise it is set to '/IGNORE/'.</body>
          </ownedComment>
          <name>simple</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149884_414486_32229"/>
