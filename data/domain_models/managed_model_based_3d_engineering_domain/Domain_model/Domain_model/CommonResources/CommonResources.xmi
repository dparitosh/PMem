    <packagedElement xmi:id="_18_4_1_e120334_1499417193052_628492_23470" xmi:uuid="baf39346-bf38-4010-9bdd-cc9630573f7c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455718926346_45243_43002" xmi:uuid="7af6343d-a0ab-4913-a1da-751574f25133" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193052_628492_23470"/>
        <body>A ConditionRelationship is a relationship between two instances of Condition.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551280897017_629824_97483" xmi:uuid="9fff24e4-4c96-4c80-829f-9377c5148311" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_290014c_1550847735853_401544_98065"/>
        <body>These flowports are not bound to the ARM target because only an activity property type can be assigned to it.</body>
      </ownedComment>
      <name>ConditionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459326540220_982338_42522" xmi:uuid="cf8ccf2c-5703-4866-88fd-4eeb36f5dff3" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_831174_163050" xmi:uuid="50f336b8-a3f4-4ef7-91ff-5f7dc40eaa33" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_298037_163051" xmi:uuid="bd93e9f8-cda1-4a7b-a304-1b07c92bfb3e" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459326583650_27779_42524" xmi:uuid="9abb3be3-14bd-4d95-9089-db91150ee04d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326540220_982338_42522"/>
          <body>the related Condition and the relating Condition shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121345_840417_163048" xmi:uuid="f11b4b45-a7a0-4b83-b716-a43a6a315fe1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_720369_163049" xmi:uuid="47279030-eac1-4733-b627-ab8d6d1744e0" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ConditionRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Condition and the relating Condition shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ConditionRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193052_628492_23470"/>
        <specification xmi:id="_18_4_1_271a0567_1509112549154_132397_30852" xmi:uuid="49ff8d61-96eb-4a35-8a11-0ae297f908d3" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1721221107295_971723_148800" xmi:uuid="2077eae0-bffc-4c3e-9334-1e042fde9c97" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_65b021e_1719937007191_236673_147578"/>
      </generalization>
