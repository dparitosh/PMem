          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>DescribeSelector</name>
        <ownedRule xmi:id="_18_4_1_290014c_1504705150282_454888_32313" xmi:uuid="26043b66-afdb-4d26-870c-8782cffce9ed" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1666259559922_465147_165451" xmi:uuid="b374a6ff-7a4e-4f91-b6ed-16df5222f49a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150282_454888_32313"/>
            <body>set the output complex to null if input is null, otherwise if input is of type DescriptorSelect it is set to inputs.elements, otherwise if input is of type Descriptor it is set to input, otherwise it is set to null.</body>
          </ownedComment>
          <name>complex</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149893_633269_32234"/>
          <specification xmi:id="_18_4_1_290014c_1504705150326_726286_32424" xmi:uuid="b9db4fc4-fcf7-4fde-b751-88309c7d73b7" xmi:type="uml:OpaqueExpression">
            <body>complex = if input.oclIsUndefined () then null else if input.oclIsTypeOf(DescriptorSet) then input.elements else if input.oclIsTypeOf(Descriptor) then input else null endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1504705150282_163781_32314" xmi:uuid="79f0f6a1-15dc-44a8-99ad-d3b906ec43ab" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1666259570962_582782_165454" xmi:uuid="d6a82381-8d84-4d86-8116-5252d23f38f3" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150282_163781_32314"/>
            <body>set the output language to null if input is null, otherwise if input is of type LocalizedString it is set to input.language, otherwise it is set to null.</body>
          </ownedComment>
          <name>language</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149893_633269_32234"/>
          <specification xmi:id="_18_4_1_290014c_1504705150326_616781_32425" xmi:uuid="81dd7b12-5049-4ff6-9df8-5a45d71f34a4" xmi:type="uml:OpaqueExpression">
            <body>language = if input.oclIsUndefined () then null else if input.oclIsTypeOf(LocalizedString) then input.Language else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1504705150282_626679_32312" xmi:uuid="b8c27e61-44e2-4cbf-b640-96ad42f7e48e" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1666259580806_125134_165457" xmi:uuid="264a7fb4-a6d4-4c82-9b94-6629ba30091d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1504705150282_626679_32312"/>
            <body>set the output simple to null if input is null, otherwise if input is of type DescriptorSelect it is set to inputs.elements, otherwise if input is of type Descriptor it is set to input, otherwise it is set to null.</body>
          </ownedComment>
          <name>simple</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1504705149893_633269_32234"/>
          <specification xmi:id="_18_4_1_290014c_1504705150326_549661_32423" xmi:uuid="d495307a-846b-4279-bb28-e2994863f278" xmi:type="uml:OpaqueExpression">
            <body>simple = if input.oclIsUndefined () then null else if input.oclIsTypeOf(CharactererStringProxy) then input.value else if input.oclIsTypeOf(LocalizedString) then input.Text else '/IGNORE/' endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_290014c_1504705150282_965791_32315" xmi:uuid="f6af1b25-5ea0-4632-9e40-5af292a21af5" xmi:type="uml:Port">
