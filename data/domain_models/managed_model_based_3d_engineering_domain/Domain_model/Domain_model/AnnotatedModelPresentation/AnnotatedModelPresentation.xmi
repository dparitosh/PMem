        <general xmi:idref="_18_4_1_91401df_1619595333854_639499_90730"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_91401df_1620130692008_625490_95507" xmi:uuid="ab5112cd-c7fd-41c9-85d9-a74fa597f2e6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1621585081772_566334_91507" xmi:uuid="b808332e-642d-40bd-b3ce-7d37000d58c9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1620130692008_625490_95507"/>
          <body>specifies a role of the ClippingOperator for the CameraModel3D. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Clipping</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_91401df_1620131196729_590039_95689"/>
