        <ownedComment xmi:id="_18_4_1_af4021f_1649404680731_602617_150593" xmi:uuid="65eb9b08-4f21-4eae-a643-3e9744594a7c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1649404566260_899377_150573"/>
          <body>the intensity of the blue component shall be a real number between 0.0 and 1.0., inclusive.</body>
        </ownedComment>
