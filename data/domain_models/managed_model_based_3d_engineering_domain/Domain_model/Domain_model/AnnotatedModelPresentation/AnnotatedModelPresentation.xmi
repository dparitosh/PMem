        <ownedComment xmi:id="_18_4_1_91401df_1621585107605_957292_91508" xmi:uuid="a429619a-a15f-489f-bcb1-b765c78ec653" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1620130733000_123346_95514"/>
          <body>specifies a role of the AppearanceAssignment for the CameraModel3D. The value of this attribute need not be specified.</body>
        </ownedComment>
