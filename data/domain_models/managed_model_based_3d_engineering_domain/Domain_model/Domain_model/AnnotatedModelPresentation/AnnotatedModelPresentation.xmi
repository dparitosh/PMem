        <annotatedElement xmi:idref="_18_4_1_91401df_1619511522626_524628_94846"/>
        <body>A Callout is a type of RepresentationItem. A Callout is a human-interpretable collection of annotation element that presents product requirements or information used to interpret the annotated model. </body>
      </ownedComment>
      <name>Callout</name>
      <generalization xmi:id="_18_4_1_91401df_1619516455501_506118_95235" xmi:uuid="63bf796e-0d66-4683-ba2e-8dce54c6fe45" xmi:type="uml:Generalization">
