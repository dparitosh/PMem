            <body>&lt;sch:rule context="//*[ @uid and substring-after(@xsi:type,':')='UserDefinedColour']/Red"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="red" value="."/&gt; &lt;sch:assert test="(xs:decimal($red) ge 0.0) and (xs:decimal($red) le 1.0)"&gt;(UserDefinedColour.WR1: &lt;sch:value-of select="$uid"/&gt;) the intensity of the red component (&lt;sch:value-of select="$red"/&gt;) shall be a real number between 0.0 and 1.0., inclusive.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_91401df_1620055788718_576580_94092"/>
        <specification xmi:id="_18_4_1_af4021f_1649404497057_524183_150566" xmi:uuid="3f3658e6-f3b2-4c23-9534-a809b5fdc83b" xmi:type="uml:OpaqueExpression">
