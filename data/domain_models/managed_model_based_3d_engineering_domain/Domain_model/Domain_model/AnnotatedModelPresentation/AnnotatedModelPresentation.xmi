    <packagedElement xmi:id="_18_4_1_91401df_1716554902976_969084_133964" xmi:uuid="1f268eb0-8991-4b5d-942f-09e160576e85" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1716555378318_995048_133987" xmi:uuid="252a231c-84e3-456c-acff-e792ad04e10b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1716554902976_969084_133964"/>
        <body>A SurfaceSideEnum specifies the sides of a surface to which a surface style is applied.</body>
      </ownedComment>
      <name>SurfaceSideEnum</name>
      <ownedLiteral xmi:id="_18_4_1_91401df_1716555411924_129911_133988" xmi:uuid="f46408b8-ee25-4bf7-9679-28b86bcddb92" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1716555449179_993384_133990" xmi:uuid="41b4031e-0734-4117-8940-8f3caa7542ad" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1716555411924_129911_133988"/>
          <body>the side of a surface which is in the same direction as the surface normal.</body>
        </ownedComment>
        <name>positive</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1716555451459_503172_133991" xmi:uuid="7ed9a1a2-6a5b-4c42-95e5-062298fe710a" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1716555464858_281820_133993" xmi:uuid="3b61068f-11fa-406f-8001-ceddb7cb6351" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1716555451459_503172_133991"/>
          <body>the side of a surface which is in the opposite direction than the surface normal.</body>
        </ownedComment>
        <name>negative</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1716555467768_578857_133994" xmi:uuid="5a80f436-c42b-4ac9-9f83-ddeb3795d9af" xmi:type="uml:EnumerationLiteral">
