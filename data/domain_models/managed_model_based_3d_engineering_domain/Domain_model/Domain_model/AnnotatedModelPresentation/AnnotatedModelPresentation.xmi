      <ownedAttribute xmi:id="_18_4_1_91401df_1619773795376_356649_98084" xmi:uuid="b25e6e45-39e8-4c3a-8ebe-d3cf25fda758" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1620303326117_758263_91734" xmi:uuid="fe087cec-4e6d-4473-befb-26cdfeac317c" xmi:type="uml:Comment">
