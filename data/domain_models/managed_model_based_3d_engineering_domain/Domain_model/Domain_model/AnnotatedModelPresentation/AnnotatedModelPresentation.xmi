      <ownedComment xmi:id="_18_4_1_af4021f_1649234028665_294563_148505" xmi:uuid="a0191250-ed5c-4a5e-9adc-6d7ba9a17ed8" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1649233046776_937737_148287"/>
        <body>A CalloutRelationship is a logical relationship between two annotation groups which appear on an annotated model.</body>
