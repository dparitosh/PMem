      <ownedComment xmi:id="_18_4_1_91401df_1620303795548_830133_91741" xmi:uuid="0365d4ef-d5a3-4085-862c-86b4bfb44df3" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1619612757504_76440_91226"/>
        <body>A CameraModel3D is a type of DetailedGeometricModelItem. A CameraModel3D contains the information needed to create the projection from a three-dimensional representation to a two-dimensional picture of that representation.</body>
      </ownedComment>
      <name>CameraModel3D</name>
      <ownedRule xmi:id="_18_4_1_91401df_1649420344411_866252_150753" xmi:uuid="6280a01a-a752-48f5-97fe-f6bae96dad99" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1649420541207_734519_150763" xmi:uuid="62ef7cc6-cecd-416b-a7e7-06a8acc8e2ad" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1649420344411_866252_150753"/>
          <body>if the HiddenLineRemoval is not set, then the HiddenElementAppearance shall not be set as well.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651562041423_274051_147506" xmi:uuid="afd94d92-37ef-44cf-b3b7-4478680c3a4e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651562180028_879898_147509" xmi:uuid="581ad456-54a2-4b98-afe3-527d3b9489e9" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationItem[ @uid and substring-after(@xsi:type,':')='CameraModel3D' and not(.//HiddenLineRemoval)]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(./HiddenElementAppearance)"&gt;(CameraModel3D : &lt;sch:value-of select="$uid"/&gt;) If the HiddenLineRemoval is not set, then the HiddenElementAppearance shall not be set as well.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_91401df_1619612757504_76440_91226"/>
        <specification xmi:id="_18_4_1_91401df_1649420344427_792797_150754" xmi:uuid="9e3ba2c3-5f00-41d0-ac10-9d44055bbf7a" xmi:type="uml:OpaqueExpression">
          <body>self.HiddenLineRemoval.oclIsUndefined() implies self.HiddenElementAppearance.oclIsUndefined()</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_91401df_1619686590047_365231_91442" xmi:uuid="1e1b95a3-5fa5-40e9-9469-a961bf531991" xmi:type="uml:Generalization">
