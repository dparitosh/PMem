          <annotatedElement xmi:idref="_18_4_1_af4021f_1649404497050_934375_150565"/>
          <body>the intensity of the red component shall be a real number between 0.0 and 1.0., inclusive.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651566823416_141559_151267" xmi:uuid="afcccc9c-7090-40b6-8d35-b7bfb93c764f" xmi:type="uml:Comment">
