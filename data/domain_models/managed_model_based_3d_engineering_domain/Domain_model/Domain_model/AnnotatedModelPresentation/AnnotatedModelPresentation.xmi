      <ownedComment xmi:id="_18_4_1_91401df_1621593832880_122435_92557" xmi:uuid="772e951e-c1d8-412d-8c2b-26fd9d0ca0cb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1620055788718_576580_94092"/>
        <body>A UserDefinedColour is a type of Colour that has its definition established without referencing any standard.</body>
      </ownedComment>
      <name>UserDefinedColour</name>
      <ownedRule xmi:id="_18_4_1_af4021f_1649404622674_437409_150585" xmi:uuid="01577166-585e-45c4-9301-7488fa71c891" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1651566909139_547520_151277" xmi:uuid="b74d1290-1ece-443b-b1d8-62145266daa5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651566969947_658926_151278" xmi:uuid="d575ea4c-32a3-4c9d-8046-fa05ec2f76a8" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//*[ @uid and substring-after(@xsi:type,':')='UserDefinedColour']/Blue"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="blue" value="."/&gt; &lt;sch:assert test="(xs:decimal($blue) ge 0.0) and (xs:decimal($blue) le 1.0)"&gt;(UserDefinedColour.WR3: &lt;sch:value-of select="$uid"/&gt;) the intensity of the blue component (&lt;sch:value-of select="$blue"/&gt;) shall be a real number between 0.0 and 1.0., inclusive.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1649404661726_592295_150592" xmi:uuid="e063ef6e-0bcb-4587-9908-a95259997be0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1649404622674_437409_150585"/>
          <body>the intensity of the green component shall be a real number between 0.0 and 1.0, inclusive.</body>
        </ownedComment>
        <name>WR3</name>
        <constrainedElement xmi:idref="_18_4_1_91401df_1620055788718_576580_94092"/>
        <specification xmi:id="_18_4_1_af4021f_1649404622675_409874_150586" xmi:uuid="51f12113-ac9c-4e87-b34e-023f69efd7ae" xmi:type="uml:OpaqueExpression">
          <body>(self.Blue &gt;= 0) and (self.Blue &lt;= 1)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_af4021f_1649404497050_934375_150565" xmi:uuid="d4fb8f9d-7f81-4fca-8b15-3e207452d3fc" xmi:type="uml:Constraint">
