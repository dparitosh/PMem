    <packagedElement xmi:id="_18_4_1_e120334_1499417193123_611981_23611" xmi:uuid="01bb978d-5895-457b-899f-39e3bbedf319" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455109163788_62870_42249" xmi:uuid="ad6ed9fa-3ca1-42a0-a8b2-d8b24af77670" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193123_611981_23611"/>
        <body>An IndividualAssemblyRelationship is a relation between two IndividualPartView objects representing a view of the assembly. Both related objects shall share at least one ViewContext.</body>
      </ownedComment>
      <name>IndividualAssemblyRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329223261_302509_42594" xmi:uuid="0fc3fb22-114b-4e67-9931-df5f54cadc0b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121318_102534_163044" xmi:uuid="28457583-91b2-4c25-9f9a-e5ac3117efa3" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121318_972405_163045" xmi:uuid="a49cada5-52d3-4e18-a12f-86c28c007a31" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//IndividualAssemblyRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related IndividualAssembly and the relating IndividualAssembly shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:IndividualAssemblyRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121318_717227_163046" xmi:uuid="e8a54a27-8045-46e2-b7a1-ed4594548a0e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121318_786644_163047" xmi:uuid="83475683-5605-4dcf-9c42-6893ef77231d" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459329256277_784781_42596" xmi:uuid="f745b995-7d5f-4e6b-9ad5-875690cdab62" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329223261_302509_42594"/>
          <body>the related IndividualPartView and the relating IndividualPartView shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193123_611981_23611"/>
        <specification xmi:id="_18_4_1_271a0567_1509114261412_465804_31232" xmi:uuid="b8c6ae82-1ff7-4471-8b40-cf634fc46b1a" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
