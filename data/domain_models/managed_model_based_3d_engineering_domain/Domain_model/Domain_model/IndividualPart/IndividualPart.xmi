    <packagedElement xmi:id="_18_4_1_290014c_1515329489995_483449_159456" xmi:uuid="b59538f1-3245-4dc7-b501-183c0edf9e46" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_290014c_1515329489995_743891_159457"/>
      <memberEnd xmi:idref="_18_4_1_290014c_1515329489915_295436_159327"/>
      <ownedEnd xmi:id="_18_4_1_290014c_1515329489995_743891_159457" xmi:uuid="b914b3ba-847c-4c7b-aa6d-6634421766e7" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193022_106808_23406"/>
        <association xmi:idref="_18_4_1_290014c_1515329489995_483449_159456"/>
