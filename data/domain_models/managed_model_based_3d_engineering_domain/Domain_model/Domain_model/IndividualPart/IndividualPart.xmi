    <packagedElement xmi:id="_18_4_1_271a0567_1548177809272_10086_305922" xmi:uuid="48597856-ebdf-4acc-bc7a-f7b69bca5223" xmi:type="uml:Package">
      <name>Constraints</name>
      <packagedElement xmi:id="_18_4_1_271a0567_1548178092750_941405_305943" xmi:uuid="441f0d2a-23b5-4b6d-b782-fbc5bbafd2ea" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_271a0567_1554302026659_251019_114917" xmi:uuid="fb4830ac-db89-420f-a23c-c93d2fb58af3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1548178092750_941405_305943"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>IndividualOrPartViewSelectCastToProductAsIndividualView</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1548178092766_723835_305945" xmi:uuid="3ccfb6e9-2eba-494b-b505-ecea69dfe684" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676048213045_388744_171460" xmi:uuid="d61d40c4-9007-4bbf-9a6a-0622a26f5400" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1548178092766_723835_305945"/>
            <body>if the input is a PartView then cast the input.partView as a Product_as_individual_view else return the input.individualPartView.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1548178092750_941405_305943"/>
          <specification xmi:id="_18_4_1_271a0567_1548178092766_981862_305946" xmi:uuid="db7dd5a5-8736-41c5-a8cf-ed1406684c18" xmi:type="uml:OpaqueExpression">
            <body>output = if input.oclIsTypeOf(PartView) then input.partView.oclAsType(Product_as_individual_view) else input.individualPartView endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1548178166855_670787_305947" xmi:uuid="8ff79489-1069-41ab-8a0a-d01471104100" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1676048189419_987174_171458" xmi:uuid="c7158a01-e695-4795-8615-534a67a63913" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1548178166855_670787_305947"/>
            <body>the input.</body>
          </ownedComment>
