    <packagedElement xmi:id="_18_4_1_e120334_1499417193127_114269_23616" xmi:uuid="6e6fa0e0-44b9-462e-8134-0c3a78db2c28" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455110065733_550719_42278" xmi:uuid="70abaa16-0df7-409a-8dc9-f4ac5abd3934" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193127_114269_23616"/>
        <body>An IndividualPartVersionRelationship is a relationship between two instances of IndividualPartVersion. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551193098753_346220_117184" xmi:uuid="f5aa27b7-e411-4ab4-8e81-0183aa8ec9ee" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>IndividualPartVersionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329354515_694298_42605" xmi:uuid="18f1047f-4856-4ec8-9166-38095f1bb324" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459329381225_543961_42607" xmi:uuid="2517a8cc-7542-4c73-a37b-6c0a49fbc0bc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329354515_694298_42605"/>
          <body>the related IndividualPartVersion and the relating IndividualPartVersion shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_641191_163042" xmi:uuid="e400fe56-cf6e-45f0-b464-ada6bc5ecda0" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_855493_163043" xmi:uuid="b233b70e-27ef-4e13-8fca-14d99198c5b5" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121310_153872_163040" xmi:uuid="ec8b1c37-199c-4315-b634-ccab55640350" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_893188_163041" xmi:uuid="1cf45965-8ca1-41a9-b66a-93230cd6bb40" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//IndividualPartVersionRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related IndividualPartVersion and the relating IndividualPartVersion shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:IndividualPartVersionRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193127_114269_23616"/>
        <specification xmi:id="_18_4_1_271a0567_1509114547981_214269_31255" xmi:uuid="1ecb3c0e-a855-4dde-acf5-f464422d962d" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
