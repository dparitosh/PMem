      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193924_711316_28299" xmi:uuid="fdd50b45-409e-43dc-a5a2-5f9043b6f0f0" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455121767184_896683_42685" xmi:uuid="fc345e78-733a-41b0-aa32-47441b572e42" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193924_711316_28299"/>
          <body> the identifier or set of identifiers for the ProcessOperationDefinition. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
