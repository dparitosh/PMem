    <packagedElement xmi:id="_18_4_1_e120334_1499417193194_993329_23767" xmi:uuid="157e89bd-712a-4bfa-985e-c643d053474b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455124251100_494521_42328" xmi:uuid="302d9c8e-ec39-4435-83c4-7edf9acc06b7" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193194_993329_23767"/>
        <body>A ProcessStateRelationship is a type of PartViewRelationship that is a relationship between two PartView objects where the Relating PartView is an in-process-item definition of a specific version of a Part. It characterizes a state of the PartVersion that occurs before the state identified by the Related PartView. &lt;note&gt;A ProcessStateRelationship may be used to characterize intermediate states of the PartVersion, if this PartVersion is one of the produced outputs of a ProcessPlan.&lt;/note&gt;</body>
      </ownedComment>
      <name>ProcessStateRelationship</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193888_492579_28112" xmi:uuid="1f4cd050-6111-4efb-8f2c-73dc7406598f" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193173_498774_23718"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547136299580_389212_105342" xmi:uuid="a832e023-41b5-4a9d-84e2-3563295d91fd" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547136299581_936810_105344" xmi:uuid="ad23bdd5-6f62-4822-a888-c11e4bd5e66b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547136299580_389212_105342"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'process state'.</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
        <defaultValue xmi:id="_18_4_1_8e001ed_1547136319948_117691_105348" xmi:uuid="4b162713-5acd-4d17-8a58-58171c34858c" xmi:type="uml:LiteralString">
          <value>process state</value>
        </defaultValue>
        <redefinedProperty href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193889_502917_28117"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523973520446_837378_164382" xmi:uuid="f282bab7-3caa-481f-b791-913ccd613ac5" xmi:type="uml:Property">
