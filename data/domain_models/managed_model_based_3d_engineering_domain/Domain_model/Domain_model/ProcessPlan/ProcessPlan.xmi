    <packagedElement xmi:id="_18_4_1_e120334_1499417193484_313374_25390" xmi:uuid="9efb0621-225d-4547-814b-58a45e69aa06" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_e120334_1499417194309_267122_30714"/>
      <memberEnd xmi:idref="_18_4_1_e120334_1499417193931_297848_28332"/>
      <ownedEnd xmi:id="_18_4_1_e120334_1499417194309_267122_30714" xmi:uuid="787216a6-0b92-4575-80e3-547bce207f2e" xmi:type="uml:Property">
