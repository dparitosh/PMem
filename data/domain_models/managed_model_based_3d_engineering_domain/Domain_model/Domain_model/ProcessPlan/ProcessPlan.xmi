    <packagedElement xmi:id="_18_4_1_e120334_1499417193273_840908_23887" xmi:uuid="1692e47b-2ee6-4377-a72e-80c352977ab9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455124536642_318794_42331" xmi:uuid="fe575da8-139c-4e11-9f6d-dbcf0d24436c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193273_840908_23887"/>
        <body>A ToolPartRelationship is a type of PartViewRelationship that is a relationship between two PartView objects. It establishes a relationship between a part (Related) and a tool (Relating) that is used to produce the part. &lt;example&gt;This relationship is, by default, valid only in the application contexts that are relevant for both related PartView objects.&lt;/example&gt;</body>
      </ownedComment>
      <name>ToolPartRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459333235400_412771_42758" xmi:uuid="b6f63671-428e-40ad-811c-2e9231ef6a11" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459333278448_763198_42760" xmi:uuid="1e177ff5-93ad-4d67-8b9d-43eab69b1dce" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333235400_412771_42758"/>
          <body> in the case that Placement is of type GeometricRepresentationRelationshipWithPlacementTransformation this relationship should not be definitional.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758841_607772_151290" xmi:uuid="2d8f8c61-32c8-4aaa-884a-aec2faadd601" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758842_725552_151291" xmi:uuid="7eb8f152-afec-4db9-a8a3-bb82eee4a824" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ToolPartRelationship']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="reference_uidRef" value="Placement/*/@uidRef"/&gt; &lt;sch:assert test="not(substring-after(//*[@uid=$reference_uidRef]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $reference_uidRef]/Definitional=false()"&gt; In the case that Placement is of type GeometricRepresentationRelationshipWithPlacementTransformation this relationship should not be definitional. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -reference:&lt;sch:value-of select="$reference_uidRef"/&gt; -attribute_value:&lt;sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671462217852_180839_163087" xmi:uuid="73c090b7-ceef-4cb7-bf14-01a8bf265c4d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671462230525_668102_163088" xmi:uuid="ce5e56ad-d28e-4dd7-b604-b932e704329a" xmi:type="uml:Comment">
            <body>WR1: NOT (SCHEMA_NAME + '.' + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(Placement)) OR (Placement.Definitional = FALSE);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193273_840908_23887"/>
        <specification xmi:id="_18_4_1_271a0567_1510240837441_799969_29644" xmi:uuid="02a31c69-e277-422e-9648-83cd89c3a9d6" xmi:type="uml:OpaqueExpression">
          <body>self.Placement.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation) implies (self.Placement.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation).Definitional = DataTypes::Boolean::False)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193888_547248_28110" xmi:uuid="24fd4817-0af4-40d0-bc5c-7974da0ae9b1" xmi:type="uml:Generalization">
