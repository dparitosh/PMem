        <lowerValue xmi:id="_18_4_1_e120334_1499417194926_487532_36347" xmi:uuid="0b67c2b0-4739-4416-bb3b-ce9e0336ed62" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194926_972122_36346" xmi:uuid="add7bc1f-3341-4318-9ee0-25cbee72b02e" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_e120334_1499417193484_313374_25390"/>
      </ownedEnd>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193237_227142_23831" xmi:uuid="9fd99f5b-4596-46ce-96c7-10218e2f73c0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455124371737_95913_42329" xmi:uuid="43b63360-5e62-4de0-a8ff-ad1d5a3fea6a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193237_227142_23831"/>
        <body>A SameTimeMachiningRelationship is a type of OccurrenceRelationship relationship between two Occurrence objects that specifies that those two objects shall be manufactured together within the same ProcessOperationOccurrence. &lt;example&gt;The following figure shows an example for this case.&lt;/example&gt; &lt;figure&gt;&lt;name&gt;sametimemachiningrelationship.png&lt;/name&gt; Illustration of SameTimeMachiningRelationship&lt;/figure&gt;</body>
      </ownedComment>
      <name>SameTimeMachiningRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459332232906_976213_42727" xmi:uuid="d1b2de83-ddbb-4bf7-830a-06ae91548b08" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758857_456745_151292" xmi:uuid="26f21c57-13ae-4f4f-beb4-cc8ca5717859" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758858_644371_151293" xmi:uuid="82b81f00-cf3c-4c54-8241-8137105ec327" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='SameTimeMachiningRelationship']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="reference_uidRef" value="Placement/*/@uidRef"/&gt; &lt;sch:assert test="not(substring-after(//*[@uid=$reference_uidRef]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $reference_uidRef]/Definitional=false()"&gt; If the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to false. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -reference:&lt;sch:value-of select="$reference_uidRef"/&gt; -attribute_value:&lt;sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671456605370_376511_163073" xmi:uuid="5d0a6bac-b11e-41f1-82ab-07cfb17454b4" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671456612404_167015_163074" xmi:uuid="0ab52c88-381e-4b1d-8eca-d540d4c90bc6" xmi:type="uml:Comment">
            <body>WR1: NOT (SCHEMA_NAME + '.' + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(Placement)) OR (Placement.Definitional = FALSE);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459332272206_945853_42729" xmi:uuid="658a3305-059f-4088-bd24-6d12f338b9c2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332232906_976213_42727"/>
          <body> if the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to true.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193237_227142_23831"/>
        <specification xmi:id="_18_4_1_271a0567_1510240415763_526245_29617" xmi:uuid="db1aa61f-a6d0-4311-8bf4-2042dae577a9" xmi:type="uml:OpaqueExpression">
          <body>self.Placement.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation) implies (self.Placement.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation).Definitional = DataTypes::Boolean::False)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193851_557416_27900" xmi:uuid="f30867cb-a9e9-4de0-90d2-cdd61a2d93c8" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193157_128516_23688"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194041_805446_28854" xmi:uuid="0f1d5faa-c9c2-49b1-9498-29c2eab9676c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455124476432_421838_42330" xmi:uuid="71a9851b-e274-4aff-8d88-104adb80413c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194041_805446_28854"/>
          <body> the GeometricRepresentationRelationship or the CartesianTransformation that specify the transformation information which is used to locate and orient the constituent in the coordinate space of the AssemblyDefinition. &lt;note&gt;The transformation is needed to position the related Occurrence with respect to the relating Occurrence for the same time machining process.&lt;/note&gt; In the case of a CartesianTransformation, or a GeometricRepresentationRelationshipWithCartesianTransformation, the scale factor shall be omitted or set to 1.0. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Placement</name>
        <visibility>public</visibility>
        <type href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193275_408791_23889"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194782_882539_34824" xmi:uuid="c4ef2c63-aa36-4813-83e7-77ee0acd7454" xmi:type="uml:LiteralInteger"/>
        <association xmi:idref="_18_4_1_e120334_1499417194041_597130_28853"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547138527938_231195_109882" xmi:uuid="870239c3-d582-40f6-b387-e5eaaed60e48" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547138527940_422724_109884" xmi:uuid="0918f1b3-9234-4b3d-84a6-d3f42ca413ee" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547138527938_231195_109882"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'same time machining'.</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
        <defaultValue xmi:id="_18_4_1_8e001ed_1547138568241_518838_109888" xmi:uuid="dc67a658-8662-46a2-91ad-eebf53c8b197" xmi:type="uml:LiteralString">
          <value>same time machining</value>
        </defaultValue>
        <redefinedProperty href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193852_213424_27904"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_271a0567_1522403410051_989229_127947" xmi:uuid="39612811-8430-42d9-b597-2ba8aa2f2c1d" xmi:type="uml:Property">
        <name>same_time_machining_relationship</name>
        <visibility>private</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Same_time_machining_relationship"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_271a0567_1522403410171_978283_127951"/>
        <redefinedProperty href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_271a0567_1522402293450_684749_125277"/>
      </ownedAttribute>
