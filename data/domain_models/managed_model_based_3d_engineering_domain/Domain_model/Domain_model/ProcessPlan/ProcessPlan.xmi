          <ownedComment xmi:id="_18_4_1_65b021e_1671209121878_20772_163155" xmi:uuid="6c5ccaa9-12a3-4535-b420-9d877c721cc8" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121878_370794_163152" xmi:uuid="67800d89-bc16-4c58-955e-8091582dd91d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121878_504132_163153" xmi:uuid="f7b053ce-d8c2-45ea-91b8-4723010b8184" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ProcessOperationOccurrenceRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related ProcessOperationOccurrence and the relating ProcessOperationOccurrence shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ProcessOperationOccurrenceRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459331051365_55040_42684" xmi:uuid="ec7c21ec-0958-4732-bca7-b95720d38406" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331015963_938068_42682"/>
          <body>the related ProcessOperationOccurrence and the relating ProcessOperationOccurrence shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193190_858485_23762"/>
        <specification xmi:id="_18_4_1_271a0567_1509115993024_627943_31413" xmi:uuid="a498f200-17f5-420b-a240-e2ebf351b759" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1721221107623_495180_148829" xmi:uuid="062d2aac-4fc9-484c-a116-7bb052f4aecb" xmi:type="uml:Generalization">
