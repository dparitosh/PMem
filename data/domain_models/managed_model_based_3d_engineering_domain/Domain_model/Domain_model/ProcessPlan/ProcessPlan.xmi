          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193934_96111_28344"/>
          <body> the interval of time within which both ProcessOperationOccurrence objects have to take place in order to be declared as simultaneous. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>CycleTime</name>
        <visibility>public</visibility>
