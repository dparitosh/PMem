      <ownedComment xmi:id="_18_0_5_45e01bd_1455122869417_887260_42296" xmi:uuid="fc40ba76-a7cc-4a50-9069-f3469a4b324f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193190_858485_23762"/>
        <body>A ProcessOperationOccurrenceRelationship is a relationship between two ProcessOperationOccurrence objects.</body>
      </ownedComment>
      <name>ProcessOperationOccurrenceRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459331015963_938068_42682" xmi:uuid="aec03533-c9df-49b3-aea4-3c599001f440" xmi:type="uml:Constraint">
