    <packagedElement xmi:id="_18_4_1_e120334_1499417193143_568242_23651" xmi:uuid="262cee79-be03-41f8-902d-75d28750d34a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456498537103_94371_42691" xmi:uuid="3ac5f09d-723d-44ff-b46c-fe51abb67e6a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193143_568242_23651"/>
        <body>A MakeFromRelationship is a type of PartViewRelationship that is a relationship between a PartView which provides the definition of a raw material, or of a semi-finished part and a PartView which provides the definition of an object manufactured out of that material, or semi-finished part. The inherited attribute Related specifies the raw material or the semi-finished part, and the inherited attribute Relating specifies the manufactured part. </body>
      </ownedComment>
      <name>MakeFromRelationship</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193818_988505_27705" xmi:uuid="77c3fd0c-4bf3-419e-8309-1951d92405ea" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193173_498774_23718"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193818_304356_27706" xmi:uuid="fd0ef567-2681-4e4d-bb99-60177766671d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456498561768_953707_42692" xmi:uuid="d03d182f-c3ae-442b-a4b4-0fdc960e2a00" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193818_304356_27706"/>
          <body> an integer that ranks the preference for use of the related PartVersion among all instances of MakeFromRelationship that have the same value for the inherited relating attribute. This value is an integer that only has meaning when comparing it with corresponding values for MakeFromRelationship sharing the same relating PartView object. It is a relative ranking value, not an absolute ranking. A lower value indicates a higher preference for the related PartView object, and a higher value indicates a lower preference. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Priority</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#INTEGER"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194599_777294_33051" xmi:uuid="433adb28-a7ed-41fd-a48b-04d3513cc030" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193818_813410_27707" xmi:uuid="4e6e3550-a09f-4924-add9-77ae5322c5c1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456498580491_69187_42693" xmi:uuid="6992e07e-cd38-4a1e-9e57-be379ebccb1e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193818_813410_27707"/>
          <body> the ValueWithUnit that specifies the amount of the related PartVersion that is used to produce the relating PartVersion. The value of this attribute need not be specified. It may be specified when the related PartVersion is a countable material.</body>
        </ownedComment>
        <name>Quantity</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193283_976319_23905"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194599_538005_33054" xmi:uuid="a83b9eac-8106-466d-b722-c73d5a073a9c" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193817_669097_27704"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547135695194_473716_105314" xmi:uuid="3c207a2a-e261-4aa8-a906-23f7d8e8dd81" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547135695196_336673_105316" xmi:uuid="715ac548-2b32-451c-a0f4-63678d25d2a6" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547135695194_473716_105314"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'make from'.</body>
        </ownedComment>
