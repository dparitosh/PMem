    <packagedElement xmi:id="_18_4_1_e120334_1499417193045_934247_23451" xmi:uuid="fa37708e-a37c-44a2-966e-891c17ca7efb" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456414699991_993914_43103" xmi:uuid="a709c442-118e-489f-a9eb-7bdf5c986f6c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193045_934247_23451"/>
        <body>A CoatingLayer is a type of ShapeElement defining one layer of covering applied to a surface. &lt;note&gt; Each CoatingLayer is one specific aspect of a part's shape. &lt;/note&gt;&lt;note&gt; Sequences of CoatingLayer objects can be defined using ShapeElementRelationship with relationType 'coating layer sequence'. &lt;/note&gt;&lt;example&gt;A layer of paint, applied to a part, is an example of CoatingLayer.&lt;/example&gt;</body>
      </ownedComment>
      <name>CoatingLayer</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193512_977761_25547" xmi:uuid="5cc6150d-8a86-4ba3-abcc-60d848681429" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193512_85007_25548" xmi:uuid="519c5b05-61e1-4f9a-9048-b5e4f44fe167" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8e001ed_1456396672279_484894_43551" xmi:uuid="5b186ba3-f5d5-419c-908b-789d920fb502" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193512_85007_25548"/>
          <body>the thickness of the CoatingLayer. The value of this attribute need not be specified.</body>
        </ownedComment>
