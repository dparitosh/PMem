    <packagedElement xmi:id="_18_4_1_e120334_1499417193263_585718_23870" xmi:uuid="d2cd820b-ee43-4239-aae0-58ce7e774e63" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456415646347_669569_43153" xmi:uuid="193b8a52-f31e-4279-8692-98e56f5c9488" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193263_585718_23870"/>
        <body> A SurfaceCondition is a definition of a characteristic or property of a surface of a part.</body>
      </ownedComment>
      <name>SurfaceCondition</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193622_981646_26426" xmi:uuid="45dae711-ae6d-4f5b-8b29-fbc0ac149464" xmi:type="uml:Generalization">
        <general href="../DocumentManagement/DocumentManagement.xmi#_18_4_1_e120334_1499417193076_372354_23525"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193777_743380_27504" xmi:uuid="ad390ddb-d267-4477-9d5e-bd11a6669697" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_e120334_1499417193131_678926_23622"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194089_786517_29054" xmi:uuid="d72b1f94-b693-4870-a479-297c63b76669" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456415666166_623591_43154" xmi:uuid="59ee4a59-2ffc-437b-8ddf-033f56e13851" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194089_786517_29054"/>
          <body> the identifier or set of identifiers for the SurfaceCondition. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193737_207420_27259"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194089_612065_29055" xmi:uuid="718d8e78-3893-4ed0-ba36-bd5a00ca3b0d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456415711172_322604_43155" xmi:uuid="84dc6911-dcba-4c00-a873-7d6c77ef400a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194089_612065_29055"/>
          <body> the type of the SurfaceCondition. Where applicable, the following values shall be used: &lt;ul&gt;&lt;li&gt;'contact ratio': the SurfaceCondition specifies the measure of the quality of contact of a shape on a reference surface; &lt;/li&gt;&lt;li&gt;'hardness': the SurfaceCondition defines the hardness of a material on its surface. The hardness represents the resistance of a surface to deformation by external forces; &lt;/li&gt;&lt;li&gt;'tactile appearance': the SurfaceCondition specifies the appearance of a surface of a part regarding the sense of touch; &lt;/li&gt;&lt;li&gt;'treatment result': the SurfaceCondition is a result of a certain treatment; &lt;/li&gt;&lt;li&gt;'visual appearance': the SurfaceCondition specifies the appearance of a surface of a part regarding the optical impression; &lt;/li&gt;&lt;li&gt;'surface texture': the SurfaceCondition characterizes of irregularities of the surface of a shape or of a portion of a shape. Such an irregularity has a negligible impact on its dimensions but may impact some of its mechanical or functional characteristics.&lt;/li&gt;&lt;/ul&gt; </body>
        </ownedComment>
        <name>ConditionType</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193305_456853_23946"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194090_346052_29056" xmi:uuid="2091e97e-c35f-4432-98cb-651f315b423b" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456415721723_525631_43156" xmi:uuid="336aeca2-82e9-4b5b-8632-f823dff878cd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194090_346052_29056"/>
          <body> the AssemblyViewRelationship, BreakdownElementView, IndividualPartView, Occurrence, PartView or ShapeElement for which a SurfaceCondition is provided.</body>
        </ownedComment>
        <name>AssignedTo</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_290014c_1536243317049_974047_183301"/>
        <association xmi:idref="_18_4_1_e120334_1499417194049_87982_28884"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194090_82529_29057" xmi:uuid="0660ba26-0d28-4002-bb1a-185316c2bece" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456415733950_862872_43157" xmi:uuid="7a8223bd-52e4-4072-8c3a-e375ef45dbef" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194090_82529_29057"/>
          <body> the DigitalFile in which the details of the SurfaceCondition are defined.</body>
        </ownedComment>
