          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193561_586505_25980"/>
          <body> the words or set of words by which the DataEnvironment is known. &lt;note&gt;This attribute supports multiple names in different contexts as well as multi-linguism.&lt;/note&gt;</body>
        </ownedComment>
        <name>Name</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193560_628490_25978"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193561_77299_25981" xmi:uuid="f9f59689-32d8-4e2e-9ad0-4a00d84bf5af" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455117130327_601457_42528" xmi:uuid="443b2feb-6e40-489f-a684-b02283e861c3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193561_77299_25981"/>
          <body> the text or the set of texts that provide further information about the DataEnvironment. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
