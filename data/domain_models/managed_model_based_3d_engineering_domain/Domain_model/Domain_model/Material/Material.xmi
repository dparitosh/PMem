        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193146_400744_23658"/>
        <body> A MaterialPropertyDefinition is a type of PropertyDefinition that is a characteristic that depends on material aspects. It is the definition of a MaterialPropertyValue.</body>
      </ownedComment>
      <name>MaterialPropertyDefinition</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193827_850641_27760" xmi:uuid="40386724-b30c-4972-9f7b-b645450b4203" xmi:type="uml:Generalization">
