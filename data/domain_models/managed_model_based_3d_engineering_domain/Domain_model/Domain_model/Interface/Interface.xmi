        <ownedComment xmi:id="_18_4_1_8e001ed_1516268932960_123216_54281" xmi:uuid="bb85c44d-a497-4bc2-a7af-585cfd94bc5a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516268932957_453108_54267"/>
          <body> the text or the set of texts that provide further information about the InterfaceConnection. The value of this attribute need not be specified.</body>
