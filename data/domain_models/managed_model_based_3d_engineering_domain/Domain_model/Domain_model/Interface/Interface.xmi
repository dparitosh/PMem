    <packagedElement xmi:id="_18_4_1_8e001ed_1516269585495_477644_54534" xmi:uuid="2c95b610-240c-4723-8d61-f884883c79d5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1516269585496_710204_54535" xmi:uuid="766c8e75-6a69-415e-9a6e-832532eff94f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1516269585495_477644_54534"/>
        <body>An InterfaceConnectorOccurrence is an occurrence of an InterfaceConnectorDefinition. The InterfaceConnectorOccurrence represents the place where a product used in an assembly can interact with other products in the assembly. The interaction is represented by an InterfaceConnection. </body>
      </ownedComment>
      <name>InterfaceConnectorOccurrence</name>
      <generalization xmi:id="_18_4_1_8e001ed_1516269585497_837896_54542" xmi:uuid="2c4e7b69-2c17-44b7-8500-8505935c19ba" xmi:type="uml:Generalization">
