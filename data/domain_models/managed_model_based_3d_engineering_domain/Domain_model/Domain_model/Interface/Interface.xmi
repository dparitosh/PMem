      <memberEnd xmi:idref="_18_4_1_8e001ed_1516638070763_90099_93176"/>
      <memberEnd xmi:idref="_18_4_1_8e001ed_1516638064124_361593_92412"/>
      <ownedEnd xmi:id="_18_4_1_8e001ed_1516638070763_90099_93176" xmi:uuid="915c977c-5fed-482d-814d-5bcdcffcc85e" xmi:type="uml:Property">
