    <packagedElement xmi:id="_18_4_1_8e001ed_1516272437233_237593_55816" xmi:uuid="852359dd-b533-4e1f-8822-2202ce8c2ff2" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1516272437234_566324_55817" xmi:uuid="659faf93-1019-4f79-8623-d378754d16dd" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437233_237593_55816"/>
        <body>An InterfaceDefinitionConnection is an interconnection between a connected pair of InterfaceConnectorDefinitions or, if the point of interconnection is not specified, the interconnection between a pair of views (PartView) on products. &lt;example&gt;A socket in the wall provides access to the domestic electricity supply. An appliance such as a television has a power lead and plug that fits into the socket. An instance of the InterfaceDefinitionConnection entity data type identifies this fitting of the plug into the socket.&lt;/example&gt; </body>
      </ownedComment>
      <name>InterfaceDefinitionConnection</name>
      <generalization xmi:id="_18_4_1_8e001ed_1516272437236_286271_55824" xmi:uuid="1c5703a7-459a-4858-9d61-e35c8c16567a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_8e001ed_1516206776728_920844_103901"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1516272437234_649527_55818" xmi:uuid="e302b57f-fbfd-46cc-995f-13593ed03a05" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1516272437237_938533_55827" xmi:uuid="dcbc1aca-3d2c-4436-a28f-5693d4eb3cba" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437234_649527_55818"/>
          <body> the identifier or set of identifiers for the InterfaceDefinitionConnection. &lt;note&gt;This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8e001ed_1516272437290_822082_55850"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1516272437235_791555_55819" xmi:uuid="c703e804-140e-4a13-a3f0-f50caaf07cdd" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1516272437237_84679_55831" xmi:uuid="7684fb88-e173-42fa-b6d5-08069986b2e4" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437235_791555_55819"/>
          <body> the text or the set of texts that provide further information about the InterfaceDefinitionConnection. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_8e001ed_1516272437237_216846_55832" xmi:uuid="1ad2afdd-9009-4a59-a877-4ae5073d6afe" xmi:type="uml:LiteralInteger"/>
