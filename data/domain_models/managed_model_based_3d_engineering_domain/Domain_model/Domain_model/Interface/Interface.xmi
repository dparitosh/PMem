        <ownedComment xmi:id="_18_4_1_8e001ed_1516272437237_850086_55835" xmi:uuid="8743e092-6a60-4e3b-9876-13e246d15f6f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437235_979820_55820"/>
          <body> the classifications of the InterfaceDefinitionConnection. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>ClassifiedAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_8e001ed_1516272437237_191467_55836" xmi:uuid="051c1b1a-4bc8-4c21-8ae0-cba6778774b8" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_8e001ed_1516272437237_217062_55834" xmi:uuid="027d81b2-1226-430a-8b4a-be9db2405bb0" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
