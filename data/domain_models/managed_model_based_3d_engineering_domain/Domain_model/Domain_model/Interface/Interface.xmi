      <ownedAttribute xmi:id="_18_4_1_8e001ed_1516272437236_176363_55822" xmi:uuid="ee93c3a4-ac7e-422a-a16d-197d3ffca38f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1516272437237_492564_55843" xmi:uuid="ba35378b-a5c5-42d6-b019-3d1c57787173" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437236_176363_55822"/>
          <body>one of the instances of the connected pair of InterfaceConnectorDefinitions, or if the point of interconnection is not specified, the interconnection between a pair of PartView. </body>
        </ownedComment>
        <name>Connecting</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_8e001ed_1516272841171_672965_56089"/>
