      <ownedAttribute xmi:id="_18_4_1_8e001ed_1516272437235_549829_55821" xmi:uuid="f8969119-6d74-4ad6-8298-5ae2b3d4fafc" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1516272437237_324634_55839" xmi:uuid="fc4f7e85-1fca-423e-aa14-cb083dd6970b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1516272437235_549829_55821"/>
          <body> the object or set of objects held externally to the exchange file for which this object is a proxy. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>SameAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193214_230770_23795"/>
