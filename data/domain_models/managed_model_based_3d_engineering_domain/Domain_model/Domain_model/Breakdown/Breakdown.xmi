    <packagedElement xmi:id="_18_4_1_e120334_1499417193028_787109_23423" xmi:uuid="d0b25211-ea70-4079-9384-12a6bd6744c7" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454492956320_541821_42969" xmi:uuid="067cc022-e34c-46fe-9bf7-e8dbfc86c0f9" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193028_787109_23423"/>
        <body>A BreakdownElementRelationship is an association between two different instances of BreakdownElement. &lt;example&gt; For example, the fact that a BreakdownElement is parent to a child element is represented by this entity.&lt;/example&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551110632916_827551_154214" xmi:uuid="24150dfa-8873-44d9-b536-6f950401e17b" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>BreakdownElementRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459325892501_656427_42485" xmi:uuid="167b30a6-91dd-4145-93fc-f9d9fbf6954d" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121907_701571_163174" xmi:uuid="23d3551b-fae0-4adc-83d4-797731f53f42" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121907_129236_163175" xmi:uuid="c9975308-f206-4a9a-9708-968254de5ddc" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121907_748104_163172" xmi:uuid="309b03c8-3c87-4e29-b1b8-ae3b8da69cab" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121907_471660_163173" xmi:uuid="c814f1ef-78f1-4027-bb9b-0a4ff8f434ca" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//BreakdownElementRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related BreakdownElement and the relating BreakdownElement shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:BreakdownElementRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459325926153_703596_42487" xmi:uuid="8f009c62-ff20-4059-ba23-659c9f692250" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325892501_656427_42485"/>
          <body>the related BreakdownElement and the relating BreakdownElement shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193028_787109_23423"/>
        <specification xmi:id="_18_4_1_271a0567_1509111801846_321614_30493" xmi:uuid="7c5f46fd-ca47-4fd8-aebc-be4498e3bfe8" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
