      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193360_159453_24428" xmi:uuid="4f9a2016-2232-4273-8e15-a362f7522e01" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454491989842_534600_42928" xmi:uuid="9f4cb746-25d8-478b-ae22-d2e242862b8c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193360_159453_24428"/>
          <body> the identifier or set of identifiers for the AlternativeSolutionRelationship. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
