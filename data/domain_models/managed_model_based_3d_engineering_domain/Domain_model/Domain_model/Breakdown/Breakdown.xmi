    <packagedElement xmi:id="_18_4_1_271a0567_1526374671388_519827_111162" xmi:uuid="b5e14ab9-2619-4980-8493-e71d974803e1" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1526374671388_901719_111163"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1526374669574_254552_110824"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1526374671388_901719_111163" xmi:uuid="b325ca50-9e22-412f-89d8-d27e60fe1e02" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193033_264769_23432"/>
