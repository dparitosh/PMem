    <packagedElement xmi:id="_18_4_1_e120334_1499417193294_431130_23923" xmi:uuid="2db6a5b1-ee83-4e1d-94fd-45fbcd492c6a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454496314974_348179_43090" xmi:uuid="43ec5e6f-a7a4-4646-b8ee-ffe5bc165460" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193294_431130_23923"/>
        <body>A ZonalBreakdown is a type of Breakdown that identifies a partitioning of a product into a set of BreakdownElement objects that are classified to be zonal objects. A ZonalBreakdown is a view of the spatial distribution of a product by means of parent-child relationships. Not all aspects of the product need to be included in a ZonalBreakdown. &lt;example&gt;A ZonalBreakdown provides a decomposition of an aircraft in terms of spaces or high-level conceptual parts, such as 'wing', which might further decompose into lower-level zones such as 'inner-wing' and 'outer wing'. &lt;/example&gt;&lt;note&gt;Parent-child relationships are represented by BreakdownElementViewRelationship objects.&lt;/note&gt;</body>
      </ownedComment>
      <name>ZonalBreakdown</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193406_771578_24851" xmi:uuid="f35c4fc0-9b99-48f5-9daf-5d9d4fc84600" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193026_693334_23417"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523460836554_356490_85429" xmi:uuid="8509e57a-0c67-495e-8e73-270ecda538fd" xmi:type="uml:Port">
        <name>zonalBreakdown</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Zone_breakdown"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547138861421_161684_109903" xmi:uuid="d6cf44d1-a671-44fb-bd91-b872c2b118a3" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547138861424_738983_109905" xmi:uuid="e4d05047-ef6b-451e-bb07-e3a197184cdc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547138861421_161684_109903"/>
          <body>the inherited attribute BreakdownType. The value of BreakdownType shall be 'zonal'.</body>
        </ownedComment>
