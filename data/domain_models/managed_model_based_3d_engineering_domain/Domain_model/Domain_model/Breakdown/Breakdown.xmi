      <ownedRule xmi:id="_18_0_5_45e01bd_1459326091956_547797_42499" xmi:uuid="7c6c1c54-452a-42ee-a40b-5e4a98bd23ac" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121915_266897_163180" xmi:uuid="9947030d-a60a-4c97-9216-6962a3346a75" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121915_783532_163181" xmi:uuid="597e9a60-1d2d-43fc-af31-9ef20bca433c" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//BreakdownRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Breakdown and the relating Breakdown shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:BreakdownRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121916_514635_163182" xmi:uuid="c52bd9e3-31b6-47c3-8de6-648cdc5df1cb" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121916_479386_163183" xmi:uuid="2a07c67a-836c-4a4b-abd2-4d6224834d47" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459326122112_643669_42501" xmi:uuid="c66e8fc2-52be-4667-a677-30f98e5e2537" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326091956_547797_42499"/>
          <body>the related Breakdown and the relating Breakdown shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193031_121288_23428"/>
        <specification xmi:id="_18_4_1_271a0567_1509111936899_367290_30535" xmi:uuid="ba7b29e8-5690-400f-ab27-cd67deb914ff" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
