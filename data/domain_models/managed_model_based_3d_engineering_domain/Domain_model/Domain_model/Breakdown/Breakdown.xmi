        <name>ClassifiedAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194206_550135_29838" xmi:uuid="929ff70d-6ca7-4c88-8c83-2cac9ae269df" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194206_888800_29837" xmi:uuid="b3c310e1-b4ed-4500-a924-ce93ecf373cb" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
