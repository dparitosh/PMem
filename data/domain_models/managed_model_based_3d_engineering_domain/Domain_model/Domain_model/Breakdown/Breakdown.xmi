            <annotatedElement xmi:idref="_18_4_1_2aed05bf_1523291897971_110238_84371"/>
            <body>the Breakdown_element extracted from the input.</body>
          </ownedComment>
          <name>breakdownElement</name>
          <visibility>private</visibility>
          <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Breakdown_element"/>
