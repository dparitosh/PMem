          <visibility>private</visibility>
          <type xmi:idref="_18_4_1_e120334_1499417193028_555907_23420"/>
          <aggregation>composite</aggregation>
        </ownedAttribute>
        <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523291897971_110238_84371" xmi:uuid="a0df9af2-f28c-4b13-91c1-f0affeb743ae" xmi:type="uml:Port">
