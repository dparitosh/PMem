    <packagedElement xmi:id="_18_4_1_e120334_1499417193033_264769_23432" xmi:uuid="e018c8c4-f673-40bf-b38a-b7e9f4df20cc" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454494633879_886777_43047" xmi:uuid="50c6a7bb-9558-43d3-8250-ffcef59ce83f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193033_264769_23432"/>
        <body> A BreakdownVersionRelationship is a relationship between two BreakdownVersion objects the meaning of which is defined by the attribute RelationType. &lt;note&gt; Such relationship may exist between two BreakdownVersion objects of the same Breakdown object or of different Breakdown objects.&lt;/note&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551186268350_454749_110146" xmi:uuid="68a897a3-d0e0-461a-a1a4-76528e1698eb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_271a0567_1525093563400_165302_128634"/>
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>BreakdownVersionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459326156947_763866_42502" xmi:uuid="a37444f1-c76f-4e84-a494-aa36ddd01404" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459326187517_520041_42504" xmi:uuid="685b347a-b01f-4460-a895-9d4a249b6192" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326156947_763866_42502"/>
          <body>the related BreakdownVersion and the relating BreakdownVersion shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121912_67441_163176" xmi:uuid="92c4f8fb-f13b-4546-93e2-7f410378a6c8" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121912_30415_163177" xmi:uuid="eb6e2d2f-8c9e-456c-a823-259af0403e25" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//BreakdownVersionRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related BreakdownVersion and the relating BreakdownVersion shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:BreakdownVersionRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121912_925385_163178" xmi:uuid="f4443e8b-495e-4ea9-88e5-c175bda32253" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121912_586631_163179" xmi:uuid="f82b7859-9c7f-4b2c-b0fa-188e21b9e0f4" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193033_264769_23432"/>
        <specification xmi:id="_18_4_1_271a0567_1509111981674_204663_30545" xmi:uuid="24a3dcf1-1f56-48fe-b099-5de890e5b5ec" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
