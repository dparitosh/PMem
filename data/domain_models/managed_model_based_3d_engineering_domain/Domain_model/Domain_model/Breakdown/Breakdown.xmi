    <packagedElement xmi:id="_18_4_1_e120334_1499417193028_555907_23420" xmi:uuid="3b46ae5d-c0bb-4786-9b40-c36036a6d05c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456298848661_390104_42865" xmi:uuid="c2f2d612-c6c0-4170-91c1-be478344c96b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193028_555907_23420"/>
      </ownedComment>
      <name>BreakdownElementOrAlternativeSolutionSelect</name>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_2aed05bf_1515511978062_572384_76732" xmi:uuid="02d8a22d-4a05-4e81-8e59-e7e46455cf84" xmi:type="uml:Port">
        <name>breakdownElementOrAlternativeSolutionSelect</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-breakdown_item"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193026_693334_23417" xmi:uuid="3bcd0fdd-138d-48db-8f6b-2d9df5022585" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454492253154_570951_42934" xmi:uuid="7bd757b9-f053-4269-8ec4-150f54f0adef" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193026_693334_23417"/>
        <body>A Breakdown is a partitioning of a product into a structured set of BreakdownElement objects. A Breakdown is, thus, a view of the product; it does not need to describe all aspects of that product. &lt;note&gt; Parent-child relationships are represented by BreakdownElementViewRelationship objects that relate BreakdownElementView objects. &lt;/note&gt;&lt;note&gt; A Breakdown may be instantiated by itself or by one of its sub-classes FunctionalBreakdown, PhysicalBreakdown, SystemBreakdown or ZonalBreakdown.&lt;/note&gt;</body>
      </ownedComment>
      <name>Breakdown</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459325595184_545521_42474" xmi:uuid="fd20bfc7-bd1f-4322-80de-8e77e9747ff4" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459325664971_875596_42476" xmi:uuid="ba2a621e-67a7-4a34-86c5-53c659b29b45" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325595184_545521_42474"/>
          <body> if a Breakdown object is not an object of one of the sub-classes of Breakdown, BreakdownType shall not have one of the values 'physical', 'functional', 'zonal' or 'system', defining only the sub-classes cases.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1720436281235_400877_147503" xmi:uuid="f9dc198a-361e-406c-8a26-714024c1bfc5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1720436281235_597248_147504" xmi:uuid="bd5ad04c-475e-4ecf-9e25-e6ee7ac6029d" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//Breakdown[@uid]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="xsitype" value="@xsi:type"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="attribute_name" value="BreakdownType/name()"/&gt; &lt;sch:let name="typeClassString" value="if(BreakdownType/ClassString) then BreakdownType/ClassString/text() else ()"/&gt; &lt;sch:let name="typeClass" value="if(BreakdownType/Class/@uidRef) then BreakdownType/Class/@uidRef else ()"/&gt; &lt;sch:let name="typeExternalOwlClass" value="if(BreakdownType/ExternalOwlClass/@uidRef) then BreakdownType/ExternalOwlClass/@uidRef else ()"/&gt; &lt;sch:assert test="$xsitype or $typeExternalOwlClass or $typeClass or ($typeClassString != 'physical' and $typeClassString != 'functional' and $typeClassString != 'system' and $typeClassString != 'zonal')"&gt; If a Breakdown object is not an object of one of the sub-classes of Breakdown, BreakdownType shall not have one of the values 'physical', 'functional', 'zonal' or 'system', defining only the sub-classes cases. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:Breakdown.WR1 -attribute_name:&lt;sch:value-of select="$attribute_name"/&gt; -attribute_value:&lt;sch:value-of select="$typeClassString"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671446269151_178422_162909" xmi:uuid="fa18d513-0430-430e-8070-3178ffa9fece" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446277371_92567_162910" xmi:uuid="c01f48ac-d635-4c7f-9d2b-f8b035cbdc63" xmi:type="uml:Comment">
            <body>WR1: NOT(TYPEOF(SELF) = [SCHEMA_NAME + 'BREAKDOWN']) OR ((SELF.BreakdownType &lt;&gt; 'physical') AND (SELF.BreakdownType &lt;&gt; 'functional') AND (SELF.BreakdownType &lt;&gt; 'zonal') AND (SELF.BreakdownType &lt;&gt; 'system'));</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193026_693334_23417"/>
        <specification xmi:id="_18_4_1_271a0567_1509366344607_608448_31531" xmi:uuid="0f461e1b-9a8f-4602-9a9c-e39badf5801a" xmi:type="uml:OpaqueExpression">
          <body>not(self.BreakdownType.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'physical') and not(self.BreakdownType.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'functional') and not(self.BreakdownType.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'zonal') and not(self.BreakdownType.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'system')</body>
          <language>OCL2.0</language>
