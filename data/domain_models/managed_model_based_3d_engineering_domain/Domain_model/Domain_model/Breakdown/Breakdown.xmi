    <packagedElement xmi:id="_18_4_1_e120334_1499417193031_113800_23427" xmi:uuid="7aa4dea1-f9a5-4283-a610-416e049b6ff2" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454493982455_843750_43006" xmi:uuid="2308286d-c492-48ea-b819-873dc1c3c4d1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193031_113800_23427"/>
        <body>A BreakdownElementViewRelationship is an association between two BreakdownElementView objects. &lt;note&gt; Such a relationship may exist between two BreakdownElementView objects of the same BreakdownElementVersion object or of different BreakdownElementVersion objects.&lt;/note&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551173870386_572_109774" xmi:uuid="2fe27a9f-aeb0-4a77-9896-b0373a473db4" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>BreakdownElementViewRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459326018862_839362_42491" xmi:uuid="e0e83577-7798-4b9c-8b17-62bb5397f9ea" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121895_658948_163162" xmi:uuid="36433110-1482-4031-a49c-915d98576d0a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121895_178754_163163" xmi:uuid="b91ef63c-90d8-436a-b074-164ce76fbaaf" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121894_363669_163160" xmi:uuid="4aa4dbfe-438a-47a9-9895-5b0985d1bce8" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121895_153952_163161" xmi:uuid="14a2c7ae-6d02-4291-901e-ce1208002752" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//BreakdownElementViewRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related BreakdownElementView and the relating BreakdownElementView shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:BreakdownElementViewRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459326057153_545311_42493" xmi:uuid="9d1ab2da-82e9-439f-a22a-f34818426717" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326018862_839362_42491"/>
          <body>the related BreakdownElementView and the relating BreakdownElementView shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193031_113800_23427"/>
        <specification xmi:id="_18_4_1_271a0567_1509111892648_695641_30519" xmi:uuid="1d956288-f816-4aba-88c1-bc2d882eb5c3" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
