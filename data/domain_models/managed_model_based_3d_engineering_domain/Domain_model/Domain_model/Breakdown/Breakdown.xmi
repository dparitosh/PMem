    <packagedElement xmi:id="_18_4_1_e120334_1499417193357_838453_24405" xmi:uuid="f6ea7051-68d6-42a6-af06-bdf9bc42dd5f" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_e120334_1499417194202_506304_29802"/>
      <memberEnd xmi:idref="_18_4_1_e120334_1499417193357_697134_24412"/>
      <ownedEnd xmi:id="_18_4_1_e120334_1499417194202_506304_29802" xmi:uuid="2e613b78-81c2-4cca-a733-5665073fe708" xmi:type="uml:Property">
