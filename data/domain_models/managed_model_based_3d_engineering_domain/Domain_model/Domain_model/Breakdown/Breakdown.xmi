        <ownedComment xmi:id="_18_4_1_290014c_1527251129865_595810_68705" xmi:uuid="9dcdd683-f2ed-4060-8507-1973faf08049" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_2aed05bf_1523291646642_648078_84340"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>BreakdownElementOrAlternativeSolutionSelector</name>
        <ownedRule xmi:id="_18_4_1_2aed05bf_1523291646671_664876_84342" xmi:uuid="510733ff-5eb8-4365-91ef-d9f184031280" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676023664472_646088_168437" xmi:uuid="44f4336b-41b5-48e5-91e1-9d0c8288f98d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_2aed05bf_1523291646671_664876_84342"/>
            <body>if the input is a BreakdownElement then the breakdownElement output is this input, otherwise the breakdownElement is null.</body>
          </ownedComment>
          <name>breakdownElement</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1523291646642_648078_84340"/>
          <specification xmi:id="_18_4_1_2aed05bf_1523291646672_321458_84343" xmi:uuid="875c51f9-d3f7-44b4-97f1-29e5382ce6d0" xmi:type="uml:OpaqueExpression">
            <body>breakdownElement = if input.oclIsUndefined () then null else if input.oclIsTypeOf(BreakdownElement) then input.breakdownElement else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_271a0567_1524040600299_231907_128383" xmi:uuid="c406fc45-45f5-49e1-bc12-559143e0b0b2" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676023631767_700217_168434" xmi:uuid="c283f17c-0363-4907-8283-93b95d1f9fcf" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1524040600299_231907_128383"/>
            <body>if the input is a AlternativeSolution then the alternativeSolution output is this input, otherwise the alternativeSolution is null.</body>
          </ownedComment>
          <name>alternativeSolution</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1523291646642_648078_84340"/>
          <specification xmi:id="_18_4_1_271a0567_1524040600300_759866_128384" xmi:uuid="ea1fa478-48ae-4fa8-b747-b09a1057a4ba" xmi:type="uml:OpaqueExpression">
            <body>alternativeSolution = if input.oclIsUndefined () then null else if input.oclIsTypeOf(AlternativeSolution) then input.alternativeSolution else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523291823007_476336_84366" xmi:uuid="5a11e341-03dd-4da7-9bab-cbbd8fc70511" xmi:type="uml:Port">
