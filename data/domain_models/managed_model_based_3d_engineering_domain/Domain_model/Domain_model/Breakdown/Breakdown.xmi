    <packagedElement xmi:id="_18_4_1_e120334_1499417193264_379756_23873" xmi:uuid="7021287c-10f4-4c61-8308-716d1360960c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454496240649_551696_43088" xmi:uuid="416beb22-459b-47d8-819c-4332da4203cd" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193264_379756_23873"/>
        <body>A SystemBreakdown is a type of Breakdown that identifies a partitioning of a product into a structured set of BreakdownElement objects that are classified to be system objects. A SystemBreakdown is a view of the systems of a product by means of parent-child relationships. Not all systems of the product need to be included in a SystemBreakdown. &lt;example&gt;A SystemBreakdown provides a decomposition of an aircraft in terms of high-level systems, such as 'fuel system' or 'flight control system'; the second example may further decompose into low-level systems such as 'autopilot system' and 'instrument landing system'. &lt;/example&gt;&lt;note&gt;Parent-child relationships are represented by BreakdownElementViewRelationship objects.&lt;/note&gt;</body>
      </ownedComment>
      <name>SystemBreakdown</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193406_455714_24855" xmi:uuid="254b3170-10d7-4f42-a83b-6e9b73dd0b8d" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193026_693334_23417"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523440423420_194057_77528" xmi:uuid="21c811df-8bdc-4d70-badd-9b856d7fe49a" xmi:type="uml:Port">
        <name>systemBreakdown</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-System_breakdown"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547138646309_397561_109889" xmi:uuid="f1e59f94-8bf8-450a-8697-3e061692c579" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547138646312_68661_109891" xmi:uuid="1b24d9bc-c508-4fc1-a031-f16950202232" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547138646309_397561_109889"/>
          <body>the inherited attribute BreakdownType. The value of BreakdownType shall be 'system'.</body>
        </ownedComment>
