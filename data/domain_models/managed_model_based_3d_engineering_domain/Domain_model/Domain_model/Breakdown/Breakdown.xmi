      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193360_77688_24430" xmi:uuid="5fa0340c-5c75-4973-8bd8-ae71ec164ff1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454492013357_310920_42930" xmi:uuid="0441ddd1-da54-4b44-918d-a05200771938" xmi:type="uml:Comment">
