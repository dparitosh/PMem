        <ownedAttribute xmi:id="_18_4_1_2aed05bf_1523291969723_277890_84376" xmi:uuid="8441d90f-7c9c-4ebe-b94b-9887f493e152" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1676023610330_956999_168433" xmi:uuid="70674755-30d2-4bf4-a99b-0bf26e90abdb" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_2aed05bf_1523291969723_277890_84376"/>
            <body>the Alternative_solution extracted from the input.</body>
          </ownedComment>
          <name>alternativeSolution</name>
          <visibility>private</visibility>
