    <packagedElement xmi:id="_18_4_1_e120334_1499417193028_653637_23422" xmi:uuid="a798fd56-ce37-4202-bbc2-3963199fb099" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454492703944_523835_42962" xmi:uuid="39da06fe-2950-451b-ab0b-4b646c7c2c24" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193028_653637_23422"/>
        <body>A BreakdownElementRealization is a relationship between an AlternativeSolution or a BreakdownElement and the BreakdownElement or the Occurrence that realizes that solution or element. &lt;example&gt;A pump realizes the 'provide fuel to engine' element in a functional breakdown for a ship.&lt;/example&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551097324295_481799_135288" xmi:uuid="ae976067-6462-4938-8cf0-2c527d18445b" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>BreakdownElementRealization</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459325804892_589486_42482" xmi:uuid="cabf54ca-25b1-41b5-99dc-3b0cacc32769" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459325847967_152726_42484" xmi:uuid="62327a59-a2da-4b26-baad-63fdfe67edf3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325804892_589486_42482"/>
          <body> the Relating and the Related shall be different objects.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_766057_163164" xmi:uuid="c41c8ae6-5dba-4b94-a5f9-e3c152c8f33c" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_959584_163165" xmi:uuid="e19400fa-7640-423a-ae5e-54f8d944c741" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//BreakdownElementRealization[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The Related and the Relating shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:BreakdownElementRealization.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_306004_163166" xmi:uuid="eb7cad8f-a1c1-49d0-aac0-9affbfd2f7e2" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_495090_163167" xmi:uuid="82cb47cc-575b-43c5-bcea-a10e5b20c3ee" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193028_653637_23422"/>
        <specification xmi:id="_18_4_1_271a0567_1509111757886_416054_30481" xmi:uuid="16eb7359-ec09-4e69-b3dc-21a4292f563a" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
