      <packagedElement xmi:id="_18_4_1_2aed05bf_1515590553900_257677_100383" xmi:uuid="d8889a86-1956-40ec-a8af-5d76e093a81c" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_290014c_1527251725572_950219_73896" xmi:uuid="cdcf2718-1a12-4e59-871a-4a64098bb234" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_2aed05bf_1515590553900_257677_100383"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>SelectBreakdownElement</name>
        <ownedRule xmi:id="_18_4_1_2aed05bf_1515590553913_54905_100385" xmi:uuid="169fdcc1-9353-4e3f-8903-0be33397f9ab" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676023835106_716789_168452" xmi:uuid="cdefc3b3-4e77-4bb6-bd99-df91b4a89020" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_2aed05bf_1515590553913_54905_100385"/>
            <body>if the input in is a Functional_element_definition or Physical_element_definition then the output is this input, otherwise the output is null.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1515590553900_257677_100383"/>
          <specification xmi:id="_18_4_1_2aed05bf_1515590553913_314537_100386" xmi:uuid="e61f3671-5191-48de-84ea-ddea5306a549" xmi:type="uml:OpaqueExpression">
            <body>out = if Set{Functional_element_definition, Physical_element_definition}-&gt;Exists(input.oclType() = self) then input else null end if</body>
            <language>English</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_2aed05bf_1515590599037_884162_100387" xmi:uuid="f071db7e-b1da-47ab-af29-d09f9b9cc4aa" xmi:type="uml:Port">
