        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193082_550704_23533"/>
        <body>An Edge is a type of TopologicalRepresentationItem that is an oriented, bounded, one-dimensional manifold connecting two vertices. The topological sense of the Edge is from the EdgeStart to the EdgeEnd.</body>
      </ownedComment>
      <name>Edge</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193639_691149_26557" xmi:uuid="4d43869d-807e-4175-94bb-f65321a5ad77" xmi:type="uml:Generalization">
