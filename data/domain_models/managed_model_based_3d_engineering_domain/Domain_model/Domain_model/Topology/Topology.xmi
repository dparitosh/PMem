      <ownedConnector xmi:id="_18_4_1_8db01ea_1508487616983_351613_30566" xmi:uuid="f6412b72-e2a8-4dbd-baad-113a5bc966e3" xmi:type="uml:Connector">
        <visibility>public</visibility>
        <end xmi:id="_18_4_1_8db01ea_1508487616983_794294_30567" xmi:uuid="c5e8f2d9-b291-46bf-8b58-84cc626fa993" xmi:type="uml:ConnectorEnd">
