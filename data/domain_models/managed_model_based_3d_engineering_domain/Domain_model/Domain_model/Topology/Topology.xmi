    <packagedElement xmi:id="_18_4_1_e120334_1499417193174_913820_23720" xmi:uuid="29454f74-64f1-4b81-a2a7-18a7d1722fe6" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1513241900011_677448_44299" xmi:uuid="86b3251e-447b-4f80-959f-488ac2fb27bb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193174_913820_23720"/>
        <body>A Path is a type of TopologicalRepresentationItem consisting of an ordered collection of Edges, such that the start Vertex of each Edge coincides with the end Vertex of its predecessor. The path is ordered from the EdgeStart of its first Edge to the EdgeEnd of its last Edge An individual Edge can only be referenced once by an individual Path. An Edge can be referenced by multiple Paths. An Edge can exist independently of a Path.</body>
      </ownedComment>
      <name>Path</name>
      <ownedRule xmi:id="_18_0_2_8db01ea_1463066423936_843015_49931" xmi:uuid="6a55824b-e2bc-4296-9d52-d7992635b7a9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1713966165297_510413_138395" xmi:uuid="6059dec4-1946-4964-915e-41519b761543" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_91401df_1713966174760_741937_138396" xmi:uuid="5f79af48-59e0-43c5-9f66-8dc306a074df" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='Path']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="edgeList" value="child::EdgeList/Edge/@uidRef"/&gt; &lt;sch:assert test="every $j in for $i in $edgeList return ( (if ((child::OrientationList/Boolean[index-of($edgeList, $i)]) eq 'true' ) then //*[@uid=$i]/EdgeEnd/@uidRef else //*[@uid=$i]/EdgeStart/@uidRef) eq (if (child::OrientationList/Boolean[1+index-of($edgeList, $i) ] eq 'true') then //*[@uid=$edgeList[1+index-of($edgeList, $i)]]/EdgeStart/@uidRef else //*[@uid=$edgeList[1+index-of($edgeList, $i)]]/EdgeEnd/@uidRef )) satisfies $j=true()"&gt;(Path.WR1 &lt;sch:value-of select="$uid"/&gt;) the end Vertex of each Edge (&lt;sch:value-of select="$edgeList"/&gt;) shall be the same as the start Vertex of its successor.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_2_8db01ea_1463066462740_880452_49933" xmi:uuid="aff8512d-6819-4113-9123-77989e3484c7" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539248044785_115872_102817" xmi:uuid="38769a0b-ebbc-4d98-ae01-1e96503d80f2" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_0_2_8db01ea_1463066462740_880452_49933"/>
            <body>path_aligned(SELF)</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1463066423936_843015_49931"/>
          <body>the end Vertex of each Edge shall be the same as the start Vertex of its successor. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193174_913820_23720"/>
        <specification xmi:id="_18_4_1_8db01ea_1513345488287_637166_76181" xmi:uuid="6f772fd5-5b12-4125-b0bb-f8242b31876f" xmi:type="uml:OpaqueExpression">
          <body>Sequence{1..self.EdgeList-&gt;size()-1} -&gt;forAll(i | self.EdgeList-&gt;asSequence()-&gt;at(i).EdgeEnd = self.EdgeList-&gt;asSequence()-&gt;at(i+1).EdgeStart)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1551372925394_394938_121458" xmi:uuid="1113f1fa-a8db-4117-8d53-255df6d4ae97" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193179_295269_23733"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193538_513155_25804" xmi:uuid="403f2c8f-9e50-49ec-b841-a26b7e635671" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193054_349108_23474"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193891_979096_28128" xmi:uuid="88c97c0a-af34-414d-9c42-71e23f418def" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193274_958104_23888"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193891_374344_28129" xmi:uuid="d90c1327-8046-415e-8ec3-950fe4f7b49a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8db01ea_1455614174210_576474_42554" xmi:uuid="df3bf343-a8c4-480e-b823-b78c86f95c0c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193891_374344_28129"/>
          <body>the list of unique Edge entities which are concatenated together to form this Path.</body>
        </ownedComment>
        <name>EdgeList</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193082_550704_23533"/>
        <isOrdered>true</isOrdered>
        <upperValue xmi:id="_18_4_1_e120334_1499417194660_101070_33640" xmi:uuid="74c785cd-b5fe-4c88-9a3e-859229d7e6c4" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_e120334_1499417193638_437391_26552"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193892_711933_28130" xmi:uuid="f8fe3a47-d1f2-4a45-a1e5-67dda3b8feed" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8db01ea_1455614250230_99385_42555" xmi:uuid="ecd502a4-5672-46b1-a4c1-ecb6b96d032c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193892_711933_28130"/>
          <body>the list of Boolean values that specifies the orientation of each Edge in the Path. If TRUE, the topological orientation as used coincides with the orientation, from start Vertex to end Vertex, of the Edge, if FALSE the vertices are reversed in order.</body>
        </ownedComment>
        <name>OrientationList</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#BOOLEAN"/>
