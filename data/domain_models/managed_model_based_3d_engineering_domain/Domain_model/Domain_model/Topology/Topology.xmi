    </packagedElement>
    <packagedElement xmi:id="_18_4_1_8db01ea_1508421408060_124764_39166" xmi:uuid="f3ced419-3f44-498a-8be3-03e556640004" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_8db01ea_1508421408060_89060_39167"/>
      <memberEnd xmi:idref="_18_4_1_8db01ea_1508421407998_720226_39162"/>
      <ownedEnd xmi:id="_18_4_1_8db01ea_1508421408060_89060_39167" xmi:uuid="c395fa1e-20b3-4444-8a76-a27d3a4cd582" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193053_334749_23473"/>
        <association xmi:idref="_18_4_1_8db01ea_1508421408060_124764_39166"/>
      </ownedEnd>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193054_780176_23475" xmi:uuid="fddf9c8f-6022-40c5-b5bd-c67af64e5f1c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1456410689306_853004_43445" xmi:uuid="51f621de-973d-4b0d-a41c-7412d15b9f33" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <body>An EdgeBasedTopologicalRepresentationWithLengthConstraint is a type of GeometricRepresentation that has as its items one ConnectedEdgeSet and as needed additional Paths and VertexPoints that are within the domain of the ConnectedEdgeSet. An EdgeBasedTopologicalRepresentationWithLengthConstraint might define a sub-domain of another EdgeBasedTopologicalRepresentationWithLengthConstraint by using a ConnectedEdgeSubSet. In this case both EdgeBasedTopologicalRepresentationWithLengthConstraints shall share the same RepresentationContext. The geometry of an EdgeBasedTopologicalRepresentationWithLengthConstraint is defined by unspecific points and curves that are independent of any specific coordinates. Only the lengths of the curves are constrained to specific values.</body>
      </ownedComment>
      <name>EdgeBasedTopologicalRepresentationWithLengthConstraint</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1588667482726_162898_88228" xmi:uuid="2937f930-1a8a-438b-abea-e21d320ced66" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1588667521029_407159_88232" xmi:uuid="4b185423-19f9-4a0c-a82f-ffb27a11cc5c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1588667482726_162898_88228"/>
          <body>if the SingleSet is of type ConnectedEdgeSubSet then the ParentEdgeSet shall be an item within the same RepresentationContext of this Representation. &lt;note&gt;SingleSet: an OCL variable that provides the single ConnectedEdgeSet. &lt;/note&gt;</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1588667482728_939039_88229" xmi:uuid="ebc4b24b-8a9b-49be-8c83-a27e96e4e5d5" xmi:type="uml:OpaqueExpression">
          <ownedComment xmi:id="_18_4_1_271a0567_1590320067343_61489_95293" xmi:uuid="d499bb1d-c6bd-46e6-9afb-83231147724b" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1588667482728_939039_88229"/>
            <body>NOT ('TOPOLOGY_SCHEMA.CONNECTED_EDGE_SUB_SET' IN TYPEOF (single_set[1])) XOR item_in_context(single_set[1]\connected_edge_sub_set.parent_edge_set, SELF\representation.context_of_items) with single_set : SET[1:1] OF Connected_edge_set := QUERY( item &lt;* SELF.items| ('ELEMENTAL_TOPOLOGY_ARM.CONNECTED_EDGE_SET' IN TYPEOF(item)) );</body>
          </ownedComment>
          <body>let SingleSet : Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet = self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet))-&gt;asSequence()-&gt;at(1).oclAsType(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet) in if SingleSet.oclIsTypeOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet) then self.ContextOfItems.Items-&gt;includes(SingleSet.ParentEdgeSet) else true endif</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1588861318671_792210_89663" xmi:uuid="7c3f75ed-5099-485f-879c-9dfb80196f14" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1588861344553_119113_89667" xmi:uuid="74387059-5553-4de8-ac6f-5571fb51f9f5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1588861318671_792210_89663"/>
          <body>if the SingleSet is of type ConnectedEdgeSubSet then all its edges shall be of type EdgeBoundedCurveWithLength or of type SubEdge. &lt;note&gt;SingleSet: an OCL variable that provides the single ConnectedEdgeSet. &lt;/note&gt;</body>
        </ownedComment>
        <name>WR4</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1588861318671_378818_89664" xmi:uuid="2abb9689-2a9c-472e-901f-36f2f9c9cb69" xmi:type="uml:OpaqueExpression">
          <ownedComment xmi:id="_18_4_1_271a0567_1590320027454_626106_95291" xmi:uuid="c3cf43d1-5914-4306-8c20-eebd54a384c3" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1588861318671_378818_89664"/>
            <body>NOT ('TOPOLOGY_SCHEMA.CONNECTED_EDGE_SUB_SET' IN TYPEOF(single_set[1]) ) XOR ( SIZEOF ( QUERY ( ed &lt;* single_set[1].connected_edges | NOT ( ('EDGE_BASED_TOPOLOGICAL_REPRESENTATION_WITH_LENGTH_CONSTRAINT_MIM.EDGE_BOUNDED_CURVE_WITH_LENGTH' IN TYPEOF(ed) ) OR ('TOPOLOGY_SCHEMA.SUB_EDGE' IN TYPEOF(ed) ) ) ) ) = 0 ); with single_set : SET[1:1] OF Connected_edge_set := QUERY( item &lt;* SELF.items| ('ELEMENTAL_TOPOLOGY_ARM.CONNECTED_EDGE_SET' IN TYPEOF(item)) );</body>
          </ownedComment>
          <body>let SingleSet : Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet = self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet))-&gt;asSequence()-&gt;at(1).oclAsType(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet) in if SingleSet.oclIsTypeOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet) then SingleSet.ConnectedEdges-&gt;forAll(e |e.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::EdgeBoundedCurveWithLength) or e.oclIsTypeOf(Application_protocols::AP242::Domain_model::Topology::SubEdge)) else true endif</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1588859582083_810508_89307" xmi:uuid="82995fec-c8dc-499e-9019-cfdd85a3173e" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1588859648527_168550_89321" xmi:uuid="457da97d-ee22-492f-9e64-ec8a57730cfb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1588859582083_810508_89307"/>
          <body>if the SingleSet is not of type ConnectedEdgeSubSet then all its edges shall be of type EdgeBoundedCurveWithLength. &lt;note&gt;SingleSet: an OCL variable that provides the single ConnectedEdgeSet. &lt;/note&gt;</body>
        </ownedComment>
        <name>WR3</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1588859582083_543837_89308" xmi:uuid="a6a53bad-e6d6-43a9-91b7-62adea5750ad" xmi:type="uml:OpaqueExpression">
          <ownedComment xmi:id="_18_4_1_271a0567_1590320044828_887029_95292" xmi:uuid="5dbea002-3888-414a-bf9c-472cb3f664c0" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1588859582083_543837_89308"/>
            <body>('TOPOLOGY_SCHEMA.CONNECTED_EDGE_SUB_SET' IN TYPEOF (single_set[1])) XOR ( SIZEOF ( QUERY ( ed &lt;* single_set[1].connected_edges | NOT ('EDGE_BASED_TOPOLOGICAL_REPRESENTATION_WITH_LENGTH_CONSTRAINT_MIM.EDGE_BOUNDED_CURVE_WITH_LENGTH' IN TYPEOF(ed)) ) ) = 0 ); with single_set : SET[1:1] OF Connected_edge_set := QUERY( item &lt;* SELF.items| ('ELEMENTAL_TOPOLOGY_ARM.CONNECTED_EDGE_SET' IN TYPEOF(item)) );</body>
          </ownedComment>
          <body>let SingleSet : Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet = self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet))-&gt;asSequence()-&gt;at(1).oclAsType(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet) in if not SingleSet.oclIsTypeOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSubSet) then SingleSet.ConnectedEdges-&gt;forAll(e |e.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::EdgeBoundedCurveWithLength)) else true endif</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1588862015490_17267_89692" xmi:uuid="8b925b1d-3e59-4bd6-be7b-918a204ec9dc" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1588864192723_894707_89723" xmi:uuid="1ed6932b-a701-4d2c-8b11-e2da544d71be" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1588862015490_17267_89692"/>
          <body>all VertexPoints in the direct items shall have a VertexGeometry of type PointOnCurve. </body>
        </ownedComment>
        <name>WR6</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1588862015490_430452_89693" xmi:uuid="e11c034d-d65e-4373-bf29-a8b4d7150413" xmi:type="uml:OpaqueExpression">
          <ownedComment xmi:id="_18_4_1_271a0567_1590320145583_202973_95294" xmi:uuid="495752cf-922c-45d9-bf1c-bd7642bea3df" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1588862015490_430452_89693"/>
            <body>SIZEOF ( QUERY ( vp &lt;* SELF.items | ('TOPOLOGY_SCHEMA.VERTEX_POINT' IN TYPEOF(vp) ) AND NOT ( 'GEOMETRY_SCHEMA.POINT_ON_CURVE' IN TYPEOF(vp.vertex_geometry) ) ) ) = 0;</body>
          </ownedComment>
          <body>self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::VertexPoint))-&gt;forAll(vp | vp.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::VertexPoint).VertexGeometry.oclIsTypeOf(Application_protocols::AP242::Domain_model::CompositeStructuralShapeAndStructure::PointOnCurve))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460462398889_52022_47565" xmi:uuid="b901ba53-d79d-44a4-9693-75d67c691b18" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_2_8db01ea_1460462436797_526184_47568" xmi:uuid="d35895ff-db72-4a6a-81d7-962ecb8ce163" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460462398889_52022_47565"/>
          <body>the items attribute shall contain a single ConnectedEdgeSet.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1513007290161_310582_57474" xmi:uuid="65fb7541-682c-4cea-9fd9-f41ab9716659" xmi:type="uml:OpaqueExpression">
          <body>self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet))-&gt;size() = 1</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_8db01ea_1588861806174_957700_89687" xmi:uuid="ec2e11fc-4aca-4acc-b5c9-8c90bccae129" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1588861977225_755824_89691" xmi:uuid="1e6136f0-7531-46ad-a1db-74ab6e6024eb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1588861806174_957700_89687"/>
          <body>all Paths in the direct items shall be defined by Edges of the SingleSet or a Subedges of it. &lt;note&gt;SingleSet: an OCL variable that provides the single ConnectedEdgeSet. &lt;/note&gt;</body>
        </ownedComment>
        <name>WR5</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193054_780176_23475"/>
        <specification xmi:id="_18_4_1_8db01ea_1588861806174_127283_89688" xmi:uuid="cbd17562-9ea4-4e1d-818b-928589cc5ab1" xmi:type="uml:OpaqueExpression">
          <ownedComment xmi:id="_18_4_1_271a0567_1590320008528_58435_95290" xmi:uuid="7b28271f-52e0-4543-bfe9-68d2ffa5a6fa" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_8db01ea_1588861806174_127283_89688"/>
            <body>SIZEOF ( QUERY ( pa &lt;* SELF.items | ('TOPOLOGY_SCHEMA.PATH' IN TYPEOF(pa)) AND NOT ( SIZEOF ( QUERY ( oe &lt;* pa\path.edge_list | NOT (oe.edge_definition IN single_set[1].connected_edges ) OR NOT (oe.edge_definition\subedge.parent_edge IN single_set[1].connected_edges ) ) ) = 0 ) ) ) = 0; with single_set : SET[1:1] OF Connected_edge_set := QUERY( item &lt;* SELF.items| ('ELEMENTAL_TOPOLOGY_ARM.CONNECTED_EDGE_SET' IN TYPEOF(item)) );</body>
          </ownedComment>
          <body>let SingleSet : Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet = self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet))-&gt;asSequence()-&gt;at(1).oclAsType(Application_protocols::AP242::Domain_model::Topology::ConnectedEdgeSet) in self.Items-&gt;select(i | i.oclIsKindOf(Application_protocols::AP242::Domain_model::Topology::Path))-&gt;forAll(p | p.oclAsType(Application_protocols::AP242::Domain_model::Topology::Path).EdgeList-&gt;forAll(e | SingleSet.ConnectedEdges-&gt;includes(e)))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193538_775630_25807" xmi:uuid="295feec7-6f26-466f-bb4d-eda7b8755d73" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193113_970216_23593"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193538_803849_25809" xmi:uuid="a517d3c7-c29b-4c46-8fa1-358deca2fa8e" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193115_770781_23599"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193538_261568_25810" xmi:uuid="cb07bf5f-dc27-4900-b63a-a979cb0f7bf4" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_2_8db01ea_1455006284134_221478_45372" xmi:uuid="df2e866b-3efd-4cf2-a5f8-5aa0620c9c3c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193538_261568_25810"/>
          <body>an inherited set attribute whose members shall be of type ConnectedEdgeSet, Path or VertexPoint only.</body>
        </ownedComment>
