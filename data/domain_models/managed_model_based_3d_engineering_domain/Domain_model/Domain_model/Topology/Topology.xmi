        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193053_777197_23472"/>
        <body>A ConnectedEdgeSet is a type of TopologicalRepresentationItem that is a set of Edges arcwise connected via their common vertices.</body>
      </ownedComment>
      <name>ConnectedEdgeSet</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193537_326269_25794" xmi:uuid="23c97018-7fc1-45a5-bfa4-90f5254e5e50" xmi:type="uml:Generalization">
