      <memberEnd xmi:idref="_18_4_1_8db01ea_1504535841552_820075_43488"/>
      <memberEnd xmi:idref="_18_4_1_8db01ea_1504535841536_741715_43454"/>
      <ownedEnd xmi:id="_18_4_1_8db01ea_1504535841552_820075_43488" xmi:uuid="3b5d4136-008a-4f8c-9bd7-ab6b3e752871" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193174_913820_23720"/>
        <association xmi:idref="_18_4_1_8db01ea_1504535841552_888551_43487"/>
