    <packagedElement xmi:id="_18_4_1_e120334_1499417193220_296861_23807" xmi:uuid="7df058c5-b16d-4315-8acf-456ead5729e3" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455717007669_362606_42951" xmi:uuid="cf029010-0b18-4e45-a57d-dd22b2166b69" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193220_296861_23807"/>
        <body>A ReplacedUsageRelationship is a type of OccurrenceRelationship is a relationship between two Occurrence objects where the relating Occurrence is replaced by the related Occurrence.</body>
      </ownedComment>
      <name>ReplacedUsageRelationship</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193851_502694_27899" xmi:uuid="d98cdadd-c17c-4e90-adbf-e4e28fc1e67c" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193157_128516_23688"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547137915812_682389_109854" xmi:uuid="7758ab78-67fd-4389-9761-257c8383f3ba" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547137915814_251806_109856" xmi:uuid="b06d1ecd-f979-4c7b-be39-8e00a0001a65" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547137915812_682389_109854"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'replaced usage'.</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
        <defaultValue xmi:id="_18_4_1_8e001ed_1547138026017_576321_109860" xmi:uuid="d632276d-455c-4264-a358-648f24114daf" xmi:type="uml:LiteralString">
          <value>replaced usage</value>
        </defaultValue>
        <redefinedProperty xmi:idref="_18_4_1_e120334_1499417193852_213424_27904"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194003_453191_28678" xmi:uuid="fb710e48-d2f2-4eb2-aee0-52666a986d7e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455717024489_205181_42952" xmi:uuid="44128b2e-2467-47ca-ae3e-55a070a5c1f3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194003_453191_28678"/>
          <body> the object that identifies the context in which the replacement is applicable. In the case where the usageContext refers to a ProcessOperationInputOrOutput, the relating Occurrence shall be referred by the element attribute of the ProcessOperationInputOrOutput. In the case where usageContext refers to a ViewOccurrenceRelationship, the relating Occurrence shall be referred by the related attribute of the ViewOccurrenceRelationship. In the case where usageContext refers to a BreakdownElementRealization, the relating Occurrence object of the ReplacedUsageRelationship shall be referred to as related by the BreakdownElementRealization.</body>
        </ownedComment>
        <name>UsageContext</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193159_822160_23692"/>
        <association xmi:idref="_18_4_1_e120334_1499417193856_372541_27922"/>
      </ownedAttribute>
