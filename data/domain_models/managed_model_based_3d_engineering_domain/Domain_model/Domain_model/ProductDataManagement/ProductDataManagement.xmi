      <generalization xmi:id="_18_4_1_e120334_1499417193384_707923_24677" xmi:uuid="af82c92e-188e-4bb7-b5bd-dc1e2e57fadf" xmi:type="uml:Generalization">
        <general href="../RequirementManagementAndVAndV/RequirementManagementAndVAndV.xmi#_18_4_1_e120334_1499417193226_546395_23815"/>
      </generalization>
      <generalization xmi:id="_18_4_1_65b021e_1721221107190_456707_148791" xmi:uuid="fe772d24-d6fc-427a-82c3-3462c660c751" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_65b021e_1719937007191_236673_147578"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193384_450790_24679" xmi:uuid="929ce1d0-ae93-4ca4-a669-80c675927e4a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455713428132_594518_42843" xmi:uuid="e8ccca7c-671c-4b98-a484-b5b5ce16958e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193384_450790_24679"/>
          <body>one object of AssemblyDefinition that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
        </ownedComment>
        <name>Relating</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193021_203823_23401"/>
        <association xmi:idref="_18_4_1_e120334_1499417193380_591636_24641"/>
        <redefinedProperty xmi:idref="_18_4_1_e120334_1499417194117_989408_29181"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193385_558963_24680" xmi:uuid="28055c4e-4227-48e7-b96f-ecc60f4dbdb0" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455713397666_524171_42842" xmi:uuid="48622b68-384f-45bc-ac0f-b6906983b661" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193385_558963_24680"/>
          <body>the set of GeometricRepresentationRelationshipWithPlacementTransformation or the CartesianTransformation that specify the transformation information which are used to locate and orient the constituent in the coordinate space of the AssemblyDefinitions. In the case of a CartesianTransformation, the scale factor shall be omitted or set to 1.0. The value of this attribute need not be specified. &lt;example&gt;The set of GeometricModels that provide additional shapes for the PartView. These additional shapes do not define the primary geometry of a PartView. In the context of electrical wiring harness, a single GeometricModel of the definition of an Occurrence can be map to several models of a WiringHarnessAssemblyDesign: &lt;ul&gt;&lt;li&gt;GeometricModels for the 3D representation, &lt;/li&gt;&lt;li&gt;GeometricModels for the 2D representation (Formboard), &lt;/li&gt;&lt;li&gt;ConnectedEdgeWithLengthSetRepresentation for the topological structure of a harness.&lt;/li&gt;&lt;/ul&gt;&lt;/example&gt;</body>
        </ownedComment>
        <name>Placement</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_290014c_1596467343170_607522_93209"/>
