    <packagedElement xmi:id="_18_4_1_e120334_1499417193064_533009_23504" xmi:uuid="a8611e0f-1455-4743-ad6e-c7c149526898" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1513257736074_525976_57664" xmi:uuid="40f91b04-c1b2-4949-ab81-6db14d3468ec" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193064_533009_23504"/>
        <body>A DefinitionalPartViewUsage is a type of PartViewRelationship where all the elements of the Related PartView are then available to the Relating PartView. These elements are specifically all PartShapeElements, properties and NextAssemblyOccurrenceUsages on the Related PartView. These elements are either direct or indirect. A direct element references explicitly a PartView. An indirect element is available to a PartView via a DefinitionalPartViewUsage of another PartView. &lt;note&gt; A related PartView can be a definitional constituent of the relating PartView only once. &lt;/note&gt; All DefinitionalPartViewUsages must describe an acyclic graph.</body>
      </ownedComment>
      <name>DefinitionalPartViewUsage</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193569_107856_26035" xmi:uuid="ab319c68-c318-4e30-a1ed-9d81186875fa" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1513257794634_808522_57665" xmi:uuid="c4d12899-17f4-4389-bc70-0cba240ac82f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193569_107856_26035"/>
          <body>the combination of Related and Relating shall be unique within a population of DefinitionalPartViewUsages. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758531_474872_151278" xmi:uuid="c615efc7-6189-4d1c-8551-b9ed3ba7d81d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758532_832928_151279" xmi:uuid="467b665e-8a15-4f58-a51f-a6e0fca6a154" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='DefinitionalPartViewUsage']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatingUid" value="../@uid"/&gt; &lt;sch:let name="relatedUid" value="Related/@uidRef"/&gt; &lt;sch:assert test="not(//*[@uid and substring-after(@xsi:type,':')='DefinitionalPartViewUsage' and ../@uid = $relatingUid and Related/@uidRef = $relatedUid and @uid != $uid])"&gt; The combination of the related part version and the relating part version shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:RelatingAndRelatedUids -attribute_value:&lt;sch:value-of select="concat($relatingUid, ',', $relatedUid)"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193064_533009_23504"/>
        <specification xmi:id="_18_4_1_e120334_1499417194384_565840_31295" xmi:uuid="524d4c37-609b-4453-80ff-ee29db901172" xmi:type="uml:OpaqueExpression">
          <body>DefinitionalPartViewUsage::allInstances()-&gt;isUnique(Sequence{Relating, Related})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193382_394112_24651" xmi:uuid="2a54ac56-b4e1-46b5-a6f3-388bcd331651" xmi:type="uml:Generalization">
