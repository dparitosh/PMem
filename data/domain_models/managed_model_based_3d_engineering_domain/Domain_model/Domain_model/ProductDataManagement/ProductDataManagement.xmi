    <packagedElement xmi:id="_18_4_1_e120334_1499417193202_531622_23781" xmi:uuid="53868a4b-f0c4-4768-90b6-3e9fe47b2251" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455716767330_613085_42946" xmi:uuid="f5ad5d79-eece-482c-bcb3-6a5ff938d11b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193202_531622_23781"/>
        <body>A PromissoryAssemblyOccurrenceUsage is a type of AssemblyOccurrenceRelationship. A PromissoryAssemblyOccurrenceUsage is a relationship between the occurrence of a constituent of an assembly and a view of the assembly itself. The relationship describes the intention to use the occurrence of a constituent of an assembly in an assembly. There may not be any geometric information provided for the constituent or the assembly that are associated by a PromissoryAssemblyOccurrenceUsage. &lt;example&gt;In early design stages, the PromissoryAssemblyOccurrenceUsage may be used to create preliminary BOMs for prototyping.&lt;/example&gt;</body>
      </ownedComment>
      <name>PromissoryAssemblyOccurrenceUsage</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193384_567680_24678" xmi:uuid="8a861d92-5ffb-44cc-9e0d-f4df1d2b8298" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193022_645728_23404"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547136394469_473621_105349" xmi:uuid="3f32ebf8-ee4b-46a0-86f6-5f6b45b9ee6a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547136394472_379379_105351" xmi:uuid="7294979d-e36c-4bbe-846f-d655409ba353" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547136394469_473621_105349"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'promissory assembly occurrence'.</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
