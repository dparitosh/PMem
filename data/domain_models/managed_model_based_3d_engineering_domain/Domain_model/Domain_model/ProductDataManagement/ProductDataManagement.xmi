    <packagedElement xmi:id="_18_4_1_e120334_1499417193220_376180_23806" xmi:uuid="8793fec2-85c1-44d1-8c4c-2128341cff8a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455716953750_792676_42950" xmi:uuid="f97a670e-4256-4612-b6ba-db6c964356df" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193220_376180_23806"/>
        <body>A ReplacedPartViewRelationship is a type of PartViewRelationship where the Relating PartView is replaced by the Related PartView. Each ReplacedPartViewRelationship shall be referenced by an Effectivity that defines the start of the validity of the replacement. &lt;note&gt;A ReplacedPartViewRelationship may be used to build up version sequences of PartView objects.&lt;/note&gt;</body>
      </ownedComment>
      <name>ReplacedPartViewRelationship</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193888_925449_28113" xmi:uuid="7531ed77-8761-4708-b2de-f16067ffd77d" xmi:type="uml:Generalization">
