      <ownedComment xmi:id="_18_0_5_45e01bd_1455716362351_657271_42939" xmi:uuid="34b8c576-daea-429d-8ddf-a694a0539fa1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193173_498774_23718"/>
        <body>A PartViewRelationship is a relation between PartView objects.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551198430887_834107_126509" xmi:uuid="f451c1cd-05ba-4fd9-9039-9859132b2fb6" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>PartViewRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330499502_257959_42657" xmi:uuid="e60a5aab-c8a1-4fc1-b4a8-f4ebaf46090c" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121217_449940_163016" xmi:uuid="5c1e0780-dabd-4485-831b-c6c149256521" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121218_717337_163017" xmi:uuid="a9dc467f-ab27-4e66-a6ef-c7319b26a989" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PartViewRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related PartView and the relating PartView shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:PartViewRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330540376_251962_42659" xmi:uuid="bf3bd147-e397-4854-9bb1-3f2184ce5597" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330499502_257959_42657"/>
          <body>the related PartView and the relating PartView shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121218_927167_163018" xmi:uuid="d12c72fc-98ed-4abe-8d8f-b11808b380bc" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121218_243675_163019" xmi:uuid="48b7819e-d656-48bd-abe2-0d470d489038" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193173_498774_23718"/>
        <specification xmi:id="_18_4_1_271a0567_1509115818661_533996_31371" xmi:uuid="c5967472-0781-4808-b429-da0d57de218f" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
