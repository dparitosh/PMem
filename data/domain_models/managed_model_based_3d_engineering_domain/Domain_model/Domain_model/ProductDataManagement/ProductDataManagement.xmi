    <packagedElement xmi:id="_18_4_1_e120334_1499417193138_994075_23638" xmi:uuid="c0099b66-5c44-402e-b1e2-df8868beb2ea" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455714239436_295769_42867" xmi:uuid="7d8a84a7-0301-4531-ad8e-847ef472e72c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193138_994075_23638"/>
        <body>A LifeCycleStage is a general stage in the product life cycle to which the concerned items belong.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_290014c_1516893704822_222086_104204" xmi:uuid="eab2eb9c-5209-4f1f-a9b0-0ecaf30c7461" xmi:type="uml:Comment">
        <body>LifeCycleStage data type is only used in ViewContext entity. See ViewContext Block's mapping parametric diagram in order to find the mapping of LifeCycleStageSelect.</body>
      </ownedComment>
      <name>LifeCycleStage</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193800_676464_27631" xmi:uuid="f6306761-c045-4b00-8d7d-8c04a36d0b15" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_8db01ea_1513266063013_735837_63060" xmi:uuid="d5913508-7d99-49ef-9426-182fa7fb2968" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193800_676464_27631"/>
          <body> the SameAs shall be unique. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671464426533_997176_163120" xmi:uuid="ecc652c1-d976-4216-a7eb-c2162a9161e4" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671464426536_70542_163121" xmi:uuid="defa4a0a-8822-4fdf-94cd-d9e55ae6bdcf" xmi:type="uml:Comment">
            <body>UR1: SameAs;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758604_473535_151286" xmi:uuid="f8279894-26c7-4894-8a3c-ee99416192f3" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758604_870876_151287" xmi:uuid="d7b79606-9eb1-4fe1-aacc-929b3d194f34" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//LifeCycleStage[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="sameAsExternalItem" value="if(SameAs/Proxy/Individual/ExternalItem/@uidRef) then SameAs/Proxy/Individual/ExternalItem/@uidRef else ()"/&gt; &lt;sch:let name="sameAsExternalOwlObject" value="if(SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()"/&gt; &lt;sch:let name="sameAsProxyString" value="if(SameAs/Proxy/Individual/ProxyString) then SameAs/Proxy/Individual/ProxyString else ()"/&gt; &lt;sch:let name="sameAs" value="$sameAsExternalItem union $sameAsExternalOwlObject union $sameAsProxyString"/&gt; &lt;sch:let name="followingAndPrecedingExternalItem" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingExternalOwlObject" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingProxyString" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString else ())"/&gt; &lt;sch:let name="followingAndPreceding" value="$followingAndPrecedingExternalItem union $followingAndPrecedingExternalOwlObject union $followingAndPrecedingProxyString"/&gt; &lt;sch:assert test="not(some $i in $sameAs, $j in $followingAndPreceding satisfies ($i eq $j))"&gt; The attribute SameAs shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:SameAs -attribute_value:&lt;sch:value-of select="$sameAs"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193138_994075_23638"/>
        <specification xmi:id="_18_4_1_e120334_1499417194585_126434_32901" xmi:uuid="c0694e07-e68b-45d6-bab8-2d9574bf5ffd" xmi:type="uml:OpaqueExpression">
          <body>LifeCycleStage::allInstances()-&gt;isUnique(SameAs)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193800_990239_27630" xmi:uuid="c1f59990-f771-4471-910b-5f2f5eeba022" xmi:type="uml:Generalization">
