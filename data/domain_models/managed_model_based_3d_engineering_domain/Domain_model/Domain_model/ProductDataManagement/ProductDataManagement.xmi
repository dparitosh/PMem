    <packagedElement xmi:id="_18_4_1_e120334_1499417193157_128516_23688" xmi:uuid="d0fb900a-ca08-4da0-98c0-b134d9178bc0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455714918617_957574_42880" xmi:uuid="2fb901f4-8e30-451e-9f3c-65e1d36cdef4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193157_128516_23688"/>
        <body>An OccurrenceRelationship is a relationship between two Occurrence objects. Predefined semantics are provided by the two subtypes ReplacedUsageRelationship and SameTimeMachiningRelationship. </body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551196254946_114477_124253" xmi:uuid="b79b1488-b113-4126-93aa-8477b270235a" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>OccurrenceRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330245136_611720_42645" xmi:uuid="079b08e9-0890-4593-85fc-4bbe30d36c4c" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121158_267754_162998" xmi:uuid="44dbfde1-2377-4342-adcd-7127c1a94e96" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121158_828095_162999" xmi:uuid="bc71a8a2-d4de-43b2-b406-73269022317c" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121156_936967_162996" xmi:uuid="67fcc3e4-044e-42b8-b21d-1428f5fadc47" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121157_499405_162997" xmi:uuid="92678370-9d47-4970-934b-5bfd854daa49" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//OccurrenceRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Occurrence and the relating Occurrence shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:OccurrenceRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330276942_37661_42647" xmi:uuid="ca635253-78f6-43de-8708-febc1278df7e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330245136_611720_42645"/>
          <body>the related Occurrence and the relating Occurrence must be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193157_128516_23688"/>
        <specification xmi:id="_18_4_1_271a0567_1509114963335_421288_31309" xmi:uuid="ba5533c5-787c-43eb-ac0c-7305f72d7d74" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
