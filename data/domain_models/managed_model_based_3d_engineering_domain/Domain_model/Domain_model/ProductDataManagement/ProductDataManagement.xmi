    <packagedElement xmi:id="_18_4_1_e120334_1499417193022_239766_23405" xmi:uuid="828461ac-ad40-429a-99c0-340a3d094e3c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455713465382_631530_42844" xmi:uuid="cf7712af-df29-4f07-8fe8-503e800175cb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193022_239766_23405"/>
        <body>An AssemblyOccurrenceRelationshipSubstitution is a relationship that indicates that one AssemblyOccurrenceRelationship may be substituted for another AssemblyOccurrenceRelationship. The subjects of the substitution are the related Occurrence objects of both AssemblyOccurrenceRelationship objects. The Relating AssemblyDefinition shall be the same in both AssemblyOccurrenceRelationship objects.</body>
      </ownedComment>
      <name>AssemblyOccurrenceRelationshipSubstitution</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459324877584_267876_42451" xmi:uuid="a49327b6-562d-40a6-aade-65a440509a06" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459324916760_916502_42453" xmi:uuid="4a5a6e7b-782e-4c0a-a71b-a26f4bd1d2aa" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324877584_267876_42451"/>
          <body>the related AssemblyOccurrenceRelationship and the relating AssemblyOccurrenceRelationship shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_869496_163010" xmi:uuid="c8420463-fc6f-414a-a800-3e8d217c0ae6" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_138703_163011" xmi:uuid="39ada7df-f968-4ad8-a128-9d8b1d5d301d" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121192_667339_163008" xmi:uuid="e839f96e-c2e1-4a52-820b-e1ea55e5e0e8" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_475773_163009" xmi:uuid="5e19c86b-8038-4e48-8417-0b8d99d5f49b" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//AssemblyOccurrenceRelationshipSubstitution[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related AssemblyOccurrenceRelationship and the relating AssemblyOccurrenceRelationship shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:AssemblyOccurrenceRelationshipSubstitution.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193022_239766_23405"/>
        <specification xmi:id="_18_4_1_271a0567_1509111382447_13293_30432" xmi:uuid="b7d666cc-5dd3-4496-8003-c99d9391d3c3" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
