    <packagedElement xmi:id="_18_4_1_e120334_1499417193203_250884_23782" xmi:uuid="e8971756-dc47-4e47-b78e-b38968d2949f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455716807349_104380_42947" xmi:uuid="9f7aaa09-e65d-4d6f-8c4d-5abdfd14e808" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193203_250884_23782"/>
        <body>A PromissoryAssemblyViewUsage is a type of AssemblyViewRelationship. A PromissoryAssemblyViewUsage is a relationship between a view of an assembly constituent and a view of the assembly itself. The relationship describes the intention to use the view of an assembly constituent in an assembly. There may not be any geometric information provided for the view or the assembly that are associated by a PromissoryAssemblyViewUsage.</body>
      </ownedComment>
      <name>PromissoryAssemblyViewUsage</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193389_242894_24714" xmi:uuid="4c8e46a9-2068-4911-8ba3-6ba23ebb850b" xmi:type="uml:Generalization">
