    <packagedElement xmi:id="_18_4_1_e120334_1499417193171_931282_23716" xmi:uuid="980198b0-014d-4c8a-97c2-e9f891a38f40" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1551198010713_611860_126083" xmi:uuid="2ec68b54-3f9b-4832-943a-2e68cb69334b" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1526463222259_366106_213244" xmi:uuid="b03978e4-e7ab-4698-882b-b45f0af3d772" xmi:type="uml:Comment">
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Part_view_definition-defined_version"/>
        <body>PartVersion.Views provides the mapping of Part_view_definition.defined_version</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455716210608_695635_42924" xmi:uuid="e1113a66-d942-42dd-b344-1db088d2e653" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193171_931282_23716"/>
        <body>A PartView is a view of a Part with respect to specific criteria.</body>
      </ownedComment>
      <name>PartView</name>
      <ownedRule xmi:id="_18_4_1_271a0567_1511358983045_628327_33795" xmi:uuid="a52d965c-c7c9-4e42-ac88-fc3bdda9897d" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_271a0567_1511359124559_508071_33810" xmi:uuid="9a91dba6-7451-4164-8ddd-8b6bbc02ba91" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1511358983045_628327_33795"/>
          <body>the auxiliaryGeometry can only exist if the definingGeometry exists. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209556702_428814_162893" xmi:uuid="9a9db255-0525-456b-94a7-a59ad3a887d9" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209556716_514533_162894" xmi:uuid="a70cc95a-0a43-4d77-bda5-cc9d18ff56b8" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PartView"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(AuxiliaryGeometry) or DefiningGeometry"&gt; PartView WR1 Error on entity &lt;sch:value-of select="$uid"/&gt;: the AuxiliaryGeometry can only exist if the DefiningGeometry exists. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671456343284_855726_163059" xmi:uuid="cd48848f-825d-4e88-b799-55139ea573dd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671456350004_102051_163060" xmi:uuid="018f8628-a2a0-4144-84ea-2d2a25752da3" xmi:type="uml:Comment">
            <body>WR1: NOT (EXISTS(AuxiliaryGeometry)) OR EXISTS(DefiningGeometry);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193171_931282_23716"/>
        <specification xmi:id="_18_4_1_271a0567_1511358983046_66546_33796" xmi:uuid="bbe0696a-8c21-4e43-8460-ca988179a6f8" xmi:type="uml:OpaqueExpression">
          <body>(self.AuxiliaryGeometry-&gt;size() &gt; 0) implies not(self.DefiningGeometry.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
