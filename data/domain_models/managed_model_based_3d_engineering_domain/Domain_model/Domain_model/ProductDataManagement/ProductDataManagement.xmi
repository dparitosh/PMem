    <packagedElement xmi:id="_18_4_1_271a0567_1523372823647_640345_206061" xmi:uuid="08e4c637-b511-4bd7-a505-1c500168289d" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1523372823648_724833_206062"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1523372818956_530663_205639"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1523372823648_724833_206062" xmi:uuid="242859bd-499a-4b1b-a141-792fb6d9be46" xmi:type="uml:Property">
