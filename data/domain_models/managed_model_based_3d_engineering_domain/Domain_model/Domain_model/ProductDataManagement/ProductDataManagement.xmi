      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194158_76360_29402" xmi:uuid="c81d003f-ddf9-4e63-86d9-bc89656179ac" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_2_8db01ea_1456247095992_694341_43119" xmi:uuid="300ac61e-8dbe-4000-aaf0-999f1c3146ab" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194158_76360_29402"/>
          <body>the part plays the role of a tool.</body>
        </ownedComment>
        <name>tool</name>
        <slot xmi:id="_18_4_1_271a0567_1523433022682_83292_226239" xmi:uuid="c638e1c2-3a18-44f9-9bd2-a6e99ed6ff23" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_271a0567_1523431782757_199677_226122"/>
          <value xmi:id="_18_4_1_271a0567_1523433022697_629339_226240" xmi:uuid="fd9c45b3-4dab-4af1-b269-528a18ee6e4f" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-part_category-tool"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194158_772495_29403" xmi:uuid="83d639a6-e6a4-49c0-b180-03d890ce89ab" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_2_8db01ea_1456247239680_167941_43127" xmi:uuid="eb950f95-2acb-40fc-999b-1cbb1183d45e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194158_772495_29403"/>
          <body>flexible cylindrical conductor, with or without an insulating covering, the length of which is large with respect to its cross-sectional dimensions [IEV ref 151-12-28]. &lt;note&gt; The cross-section of a wire may have any shape, but the term "wire" is not generally used for ribbons or tapes. &lt;/note&gt;</body>
        </ownedComment>
        <name>wire</name>
        <slot xmi:id="_18_4_1_271a0567_1523433034071_841553_226241" xmi:uuid="7feb9868-a311-44b0-9976-ed8c823fc3f4" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_271a0567_1523431782757_199677_226122"/>
