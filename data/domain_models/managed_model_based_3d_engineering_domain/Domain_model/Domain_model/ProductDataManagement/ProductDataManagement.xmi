            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-part_category-wire"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194159_596864_29404" xmi:uuid="4ede3988-d8c3-41fd-8658-eaa9049ce4b7" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_45e01bd_1512644047288_694633_248133" xmi:uuid="7fd0fc09-8328-4ab5-b229-7b1084bc01cf" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194159_596864_29404"/>
          <body>assembly with a harness topology, consisting of cables or wires to enable electrical or optical connectivity, grouped together in one or more harness segments, each between two harness nodes in which the cables or wires either switch to other harness nodes or in which the cables and wires ends in connectors, contact members or terminal lugs.</body>
        </ownedComment>
        <name>wiring_harness</name>
