        <ownedComment xmi:id="_18_0_2_8db01ea_1456411755370_307317_43474" xmi:uuid="6bd66825-9fd6-45ba-91df-d23077730790" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193998_413801_28658"/>
          <body>the constraint that has to be evaluated for the QuantifiedOccurrence. &lt;example&gt; 'as required for balance' and 'as required for lubrication' are examples for a criterion.&lt;/example&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
