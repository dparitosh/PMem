      <memberEnd xmi:idref="_18_4_1_271a0567_1523461032437_666134_252686"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1523461024597_444136_252137"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1523461032437_666134_252686" xmi:uuid="48e53dfc-9184-43b7-846a-80612e9dfc0d" xmi:type="uml:Property">
