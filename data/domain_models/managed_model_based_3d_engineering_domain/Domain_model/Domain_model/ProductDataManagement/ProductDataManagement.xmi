    <packagedElement xmi:id="_18_4_1_290014c_1525207182539_321827_155267" xmi:uuid="3a47aa6b-0365-4a55-8db9-e8fd303b1341" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_290014c_1525207182539_658513_155268"/>
      <memberEnd xmi:idref="_18_4_1_290014c_1525207182485_976946_155234"/>
      <ownedEnd xmi:id="_18_4_1_290014c_1525207182539_658513_155268" xmi:uuid="2a171a1b-daf6-43b2-8c0b-1e82f6f7f04d" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193154_583949_23682"/>
