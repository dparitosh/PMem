    <packagedElement xmi:id="_18_4_1_271a0567_1523349209261_708992_140273" xmi:uuid="ad116278-3292-4a2c-997a-5337683210bc" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1523349209261_115553_140274"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1523349201348_308949_139831"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1523349209261_115553_140274" xmi:uuid="2fa116e0-ee36-4a7a-a69c-bf95ce477328" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193163_499955_23702"/>
        <association xmi:idref="_18_4_1_271a0567_1523349209261_708992_140273"/>
