        <ownedRule xmi:id="_18_4_1_290014c_1516871621026_229083_62030" xmi:uuid="bff2761b-ef1a-4d66-bc73-09fe847843bb" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675673899756_61191_163710" xmi:uuid="eaf1e91b-09e7-4ec1-9535-1059c990e1d3" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621026_229083_62030"/>
            <body>if input is of type ApplicationDomain and input.SameAs is of type ProxyStringProxy, initial is set to input.SameAs.value, otherwise if input is of type ProxyStringProxy initial is set to input.value, otherwise initial is set to '/IGNORE/'. </body>
          </ownedComment>
          <name>initial</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1516871621013_13359_62023"/>
          <specification xmi:id="_18_4_1_290014c_1516871621060_398536_62056" xmi:uuid="8daa82f3-d5fb-4db2-ab47-ab4574144f26" xmi:type="uml:OpaqueExpression">
            <body>initial = if input.oclIsTypeOf (PredefinedApplicationDomainEnumProxy) then if not input.value.initialValue.oclIsUndefined () then input.value.initialValue else null endif else if input.oclIsTypeOf (ApplicationDomain) and input.SameAs.oclIsTypeOf (ProxyStringProxy) then input.SameAs.value else if input.oclIsTypeOf (ProxyStringProxy) then input.value else '/IGNORE/' endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1516871621023_615100_62028" xmi:uuid="c0799561-5f42-4a1e-9723-be285a34fb6f" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675673872658_957538_163708" xmi:uuid="6dec8903-c8e3-49d7-bd68-d195e0a2ab54" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621023_615100_62028"/>
            <body>if input is of type ApplicationDomain and input.SameAs is of type ProxyStringProxy, then set additional to input.SameAs.value, otherwise if input is of type ProxyStringProxy then set additional to input.value, otherwise set additional to '/IGNORE/'. </body>
          </ownedComment>
          <name>additional</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1516871621013_13359_62023"/>
          <specification xmi:id="_18_4_1_290014c_1516871621059_39562_62054" xmi:uuid="e9134a65-0c94-4893-86f4-1522a63147e7" xmi:type="uml:OpaqueExpression">
            <body>additional = if input.oclIsTypeOf (PredefinedApplicationDomainEnumProxy) then if not input.value.additionalValue.oclIsUndefined () then input.value.additionalValue else null endif else if input.oclIsTypeOf (ApplicationDomain) and input.SameAs.oclIsTypeOf (ProxyStringProxy) then input.SameAs.value else if input.oclIsTypeOf (ProxyStringProxy) then input.value else '/IGNORE/' endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1516871621025_311933_62029" xmi:uuid="db28914e-bf1a-4b8d-843f-d794ba9385b1" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675673881588_885774_163709" xmi:uuid="e49a3458-7246-4961-8ca5-80d94f021b96" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621025_311933_62029"/>
            <body>if input is of type ApplicationDomain and input.SameAs is not of type ProxyStringProxy, complex is set to input.SameAs.externalItem, otherwise if input is not of type proxyStringProxy complex is set to input.externalItem, otherwise complex is set to null. </body>
          </ownedComment>
          <name>complex</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1516871621013_13359_62023"/>
          <specification xmi:id="_18_4_1_290014c_1516871621059_936851_62055" xmi:uuid="79a49d72-94e9-4aab-bbf9-0a7b9d8bab72" xmi:type="uml:OpaqueExpression">
            <body>complex = if input.oclIsTypeOf (ApplicationDomain) and not input.SameAs.oclIsTypeOf (ProxyStringProxy) then input.SameAs.externalItem else if input.oclIsTypeOf (PredefinedApplicationDomainEnumProxy) then null else if not input.oclIsTypeOf (proxyStringProxy) then input.externalItem else null endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
