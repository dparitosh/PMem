    <packagedElement xmi:id="_18_4_1_e120334_1499417193170_235850_23714" xmi:uuid="7cfe9057-6f71-4dd6-9dd2-ef1c3c178844" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1551197386925_499119_125227" xmi:uuid="92cd3164-6c73-48d4-b155-68d6eac8a2ee" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455715940581_568457_42917" xmi:uuid="eeeb2d25-e6da-4fc8-93a3-9010cf8c4595" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193170_235850_23714"/>
        <body>A PartVersionRelationship is a relationship between two instances of PartVersion. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
      </ownedComment>
      <name>PartVersionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330438914_6081_42654" xmi:uuid="87c74cc9-66c6-4db1-9936-f67027331eb9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121200_329271_163012" xmi:uuid="6b4d021f-6cd0-42a2-8f09-2c11d09e37b1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121201_67898_163013" xmi:uuid="c2ae2be4-ba35-404a-b085-6c5e71dd2be7" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PartVersionRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related PartVersion and the relating PartVersion shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:PartVersionRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330469519_998262_42656" xmi:uuid="87b9a3a2-b4f3-4b05-888f-92c265f4ac26" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330438914_6081_42654"/>
          <body>the related PartVersion and the relating PartVersion shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121201_901745_163014" xmi:uuid="c43d969b-fc6b-4d30-927a-10bf81d58a83" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121201_508888_163015" xmi:uuid="6fc8ba8b-5e3d-4b51-9851-673482ee3a12" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193170_235850_23714"/>
        <specification xmi:id="_18_4_1_271a0567_1509115788289_527727_31361" xmi:uuid="f45004ec-b951-45f0-b033-451a55f4d8d9" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
