    <packagedElement xmi:id="_18_4_1_e120334_1499417193152_538462_23676" xmi:uuid="518a42b1-46b7-49c4-8ee8-d7e47c040bf9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455714589241_292670_42871" xmi:uuid="6a4c7a4b-0d46-42d7-9c3c-567706931a7a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193152_538462_23676"/>
        <body>A NextAssemblyOccurrenceUsage is a type of AssemblyOccurrenceRelationship that is a relationship where the attribute Related specifies an occurrence of a constituent of an assembly and the attribute Relating specifies a view of the immediate parent assembly of the constituent. &lt;note&gt;A constituent may be a single part or an assembly.&lt;/note&gt; &lt;example&gt;The assembly carburettor may be assembled from single parts. The power train assembly is assembled from other assemblies.&lt;/example&gt;</body>
      </ownedComment>
      <name>NextAssemblyOccurrenceUsage</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193384_97868_24672" xmi:uuid="c6980e35-1d63-498c-90b9-81d21d22ee55" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193022_645728_23404"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1547135859607_377143_105321" xmi:uuid="323430d4-ed26-4a55-972e-e9a7b89db25a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1547135859609_483097_105323" xmi:uuid="be17ef87-92a2-496a-af60-f242789ec03c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1547135859607_377143_105321"/>
          <body>the inherited attribute RelationType. The value of RelationType shall be 'next assembly occurrence'.</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
