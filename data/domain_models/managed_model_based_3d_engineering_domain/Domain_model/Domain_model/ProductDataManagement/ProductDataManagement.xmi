    <packagedElement xmi:id="_18_4_1_e120334_1499417193218_425021_23801" xmi:uuid="3b50158c-0be7-44a7-bcb8-b35ac122ddf9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455716888233_129152_42948" xmi:uuid="ea0dc2f3-6f34-4276-a511-43f5847b5c3c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193218_425021_23801"/>
        <body>A QuantifiedOccurrence is a type of DefinitionBasedOccurrence which is quantified, or whose quantity depends on certain constraints. &lt;example&gt; Radiator liquid or engine oil are examples for QuantifiedOccurrence objects. &lt;/example&gt;&lt;example&gt; In a TechnicalSolution for the front left brake a certain screw is used four times. &lt;/example&gt;&lt;example&gt; In a BOM where the exact amount of grease or glue can usually not be specified as a quantity, the specification of this grease or glue are examples for giving just a selection criterion instead of an exact quantity. &lt;/example&gt;&lt;example&gt; To minimize the concentricity error of a wheel, weights are attached to the rim; this set of weights is a QuantifiedOccurrence whose quantity is defined by a criterion. The quantity as well as the position of these weights depends on the concentricity behaviour of each specific wheel as manufactured and tested.&lt;/example&gt;</body>
      </ownedComment>
      <name>QuantifiedOccurrence</name>
      <ownedRule xmi:id="_18_0_2_8db01ea_1460036459309_906013_44326" xmi:uuid="b3bce171-390d-4075-a7db-f95d5f3d3ecb" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_2_8db01ea_1460036498355_278134_44329" xmi:uuid="1b1aab07-7a79-4273-94c5-82f486de7e7e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_2_8db01ea_1460036459309_906013_44326"/>
          <body>either Quantity or Criterion or both shall be defined</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209571953_443862_162903" xmi:uuid="4aff947e-a602-49be-8e6a-af7a4fc85816" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209571957_83628_162904" xmi:uuid="4305934d-38e7-4430-8894-d05d56f50ef8" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//Occurrence[substring-after(@xsi:type,':')= 'QuantifiedOccurrence']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="Quantity or Criterion"&gt; QuantifiedOccurrence WR1 Error on entity &lt;sch:value-of select="$uid"/&gt;: either Quantity or Criterion or both shall be defined. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671456542631_600822_163071" xmi:uuid="5402a58a-04d7-472a-8256-e877d7e49ff9" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671456555972_693997_163072" xmi:uuid="5ed65840-ae09-420b-957b-42183789316c" xmi:type="uml:Comment">
            <body>WR1: EXISTS(Quantity) OR EXISTS(Criterion);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193218_425021_23801"/>
        <specification xmi:id="_18_4_1_271a0567_1509096598646_947324_30435" xmi:uuid="2c0a1d51-b749-4e1c-b878-3332b1f1f5ea" xmi:type="uml:OpaqueExpression">
          <body>not(self.Quantity.oclIsUndefined()) or not(self.Criterion.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193569_400567_26038" xmi:uuid="f40a1bf1-b3c9-4fad-a304-77d43170d276" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193064_750412_23505"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193997_319996_28657" xmi:uuid="a353cb75-0a9b-4f22-9b7e-e373ba81a376" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455716918745_930490_42949" xmi:uuid="cdd3efce-ba6b-4501-86a5-3fc52c80553e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193997_319996_28657"/>
          <body>a ValueWithUnit specifying the quantity of occurrences. The value of this attribute need not be specified. &lt;note&gt; The quantity may be specified as a count measure, as a mass measure, as a length measure, as an area measure, or as a volume measure. &lt;/note&gt; &lt;example&gt; The quantity of engine oil used in a car may be in the range of 3.7 to 3.9 litres. This is expressed using ValueRange as the quantity.&lt;/example&gt;</body>
        </ownedComment>
        <name>Quantity</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193283_976319_23905"/>
