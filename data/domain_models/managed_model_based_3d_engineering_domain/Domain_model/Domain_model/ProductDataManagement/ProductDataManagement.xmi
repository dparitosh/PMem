    <packagedElement xmi:id="_18_4_1_e120334_1499417193045_776590_23453" xmi:uuid="b6762638-7325-47d8-be9d-e4e7b9e460ff" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455713965523_577836_42863" xmi:uuid="67ca159b-23d6-47f8-a1d8-1f17c5096eb5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193045_776590_23453"/>
        <body>A CollectionDefinition is a type of PartView that is the definition of a PartVersion that serves as a collector for Occurrence objects that are mounted in the same vehicle but may not be assembled together. &lt;example&gt;Brake pads on the left and right front brake from same supplier, locks and keys of the car all from one supplier, wooden panels in the interior from the same supplier (to ensure common structure of the wood) are examples for collections.&lt;/example&gt;</body>
      </ownedComment>
      <name>CollectionDefinition</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193512_46843_25554" xmi:uuid="bceb8a0a-c4e8-412d-b353-55558b8186d0" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193171_931282_23716"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193513_118406_25556" xmi:uuid="9b46c8bd-70e3-402a-a176-8409dbd4d39b" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455713981172_631426_42864" xmi:uuid="750d4d2f-2066-4a64-8471-3df6427a1fa7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193513_118406_25556"/>
          <body>the text that describes the rationale behind the CollectionDefinition. The value of this attribute need not be specified.</body>
        </ownedComment>
