      <packagedElement xmi:id="_18_4_1_271a0567_1525356023430_580363_342449" xmi:uuid="e518906b-0cdd-449c-8893-d2c5942b7a67" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_290014c_1527251688088_275866_73892" xmi:uuid="5d82d395-41bf-4a2f-9127-1979f56e536a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1525356023430_580363_342449"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>QuantifiedOccurrenceMappingCombinator</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1525356023602_642939_342450" xmi:uuid="c4ddd1b1-2d89-42d0-a291-dfb662e37921" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675678515770_4539_165810" xmi:uuid="a833f074-de68-4b84-a638-189dcc886781" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1525356023602_642939_342450"/>
            <body>set the output to the input inQuantifiedInstance if it is not undefined, otherwise set the output to the input inSelectedInstance if it is not undefined.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1525356023430_580363_342449"/>
          <specification xmi:id="_18_4_1_271a0567_1525356023666_731636_342455" xmi:uuid="1912a092-0e21-4248-ae19-927a56f5213f" xmi:type="uml:OpaqueExpression">
            <body>output = if not inQuantifiedInstance.oclIsUndefined() then inQuantifiedInstance else inSelectedInstance endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1525356023617_520812_342451" xmi:uuid="44da8022-03f4-47c9-bb84-1b02767ea424" xmi:type="uml:Port">
