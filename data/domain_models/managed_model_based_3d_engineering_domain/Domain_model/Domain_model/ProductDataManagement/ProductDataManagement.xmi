      </ownedAttribute>
      <ownedAttribute xmi:id="_19_0_4_b1702d9_1702993887602_272241_60158" xmi:uuid="fadaa477-3245-4fa2-91f1-be3a61bdbf48" xmi:type="uml:Property">
