    <packagedElement xmi:id="_18_4_1_271a0567_1523454611551_838261_247461" xmi:uuid="e63bd828-d57a-4f6a-816f-e8c65c815cc4" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1523454611551_248809_247462"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1523454596068_371037_246913"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1523454611551_248809_247462" xmi:uuid="471f9efc-9d17-4a30-ade6-619f25c57d6f" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193166_445667_23708"/>
        <association xmi:idref="_18_4_1_271a0567_1523454611551_838261_247461"/>
