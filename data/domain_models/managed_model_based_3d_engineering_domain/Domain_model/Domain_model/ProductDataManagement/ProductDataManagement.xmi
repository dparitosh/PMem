    <packagedElement xmi:id="_18_4_1_e120334_1499417193015_465238_23387" xmi:uuid="09134ad7-1fcb-4075-8135-aa733e4b19e5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456498187009_72247_42683" xmi:uuid="33e189bf-516c-47fe-9561-c6b837730c3a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193015_465238_23387"/>
        <body>An AlternatePartRelationship is a type of PartRelationship where the relating part represents the base part and the related part represents the alternate part. It specifies that any version of the alternate part, may be used in place of any version of the base part, regardless of its usages and of its versions. The relationship established by the AlternatePartRelationship is not symmetric: if part B is an alternate part for part A, part A is not implied to be an alternate part for part B. &lt;note&gt;If a part is an alternate for another part, it is understood that there is no interest in keeping track of which part, the base or any alternates specified, is used as a specific instance of the base part within a part structure.&lt;/note&gt;&lt;note&gt;An organization may track design changes for a base part, and establish effectivity conditions for the use of that base part in various assemblies to be manufactured. The use of an alternate part implies that an organization does not specify any specific version of the alternate part nor establish effectivities relating to it.&lt;/note&gt;&lt;note&gt;An AlternatePartRelationship for which the base part is an assembly involves that the entire part structure of the alternate part may be used in place of the base part and its part structure.&lt;/note&gt;&lt;note&gt;This concept usually refers to form, fit, function, and quality. Additional properties such as performance, noise, endurance, or reliability may also be considered as a prerequisite for the replacement.&lt;/note&gt;&lt;example&gt;Two bolts of the same size are parts. One bolt has a square head and the other has a hexagonal head. The two bolts are considered equivalent with respect to form, fit, and function: they both have sufficiently close physical shape, they take up the same space when used, and they both serve to fasten two things together. Thus, one of these two bolts could be considered to be an alternate part for the other bolt.&lt;/example&gt;</body>
      </ownedComment>
      <name>AlternatePartRelationship</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193354_89148_24382" xmi:uuid="a50fb079-1bfc-40e9-99ff-6056a29afd3b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758595_671230_151284" xmi:uuid="9a8dc433-e09f-4358-b8f2-443950b52b41" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758595_903236_151285" xmi:uuid="79c9feeb-e023-4810-bfba-7b8888ed6e3c" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='AlternatePartRelationship']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatingUid" value="../@uid"/&gt; &lt;sch:let name="relatedUid" value="Related/@uidRef"/&gt; &lt;sch:assert test="not(//*[@uid and substring-after(@xsi:type,':')='AlternatePartRelationship' and ../@uid = $relatingUid and Related/@uidRef = $relatedUid and @uid != $uid])"&gt; The combination of the related part and the relating part shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:RelatingAndRelatedUids -attribute_value:&lt;sch:value-of select="concat($relatingUid, ',', $relatedUid)"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671463681568_987562_163106" xmi:uuid="b58113df-61ec-4008-9841-44d108e6fbdb" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463690018_9934_163107" xmi:uuid="34900495-c9a0-424c-9c73-0a01a474e98b" xmi:type="uml:Comment">
            <body>UR1: SELF\PartRelationship.Relating, SELF\PartRelationship.Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1513262544955_489366_62958" xmi:uuid="d190dce4-b00f-4510-bc22-935e2bd62544" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193354_89148_24382"/>
          <body>the combination of the related part and the relating part shall be unique. </body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193015_465238_23387"/>
        <specification xmi:id="_18_4_1_e120334_1499417194200_61794_29793" xmi:uuid="117b05d1-e5c8-49b8-82a8-d24fecf1af69" xmi:type="uml:OpaqueExpression">
          <body>AlternatePartRelationship::allInstances() -&gt;isUnique(Sequence{Relating, Related})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1675863857546_805218_164064" xmi:uuid="1bd1d51a-4ec4-4ef4-bcd4-6d1b86467424" xmi:type="uml:Generalization">
        <general href="../WorkManagement/WorkManagement.xmi#_19_0_4_b1702d9_1665676763419_25158_58983"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193354_39251_24381" xmi:uuid="1f134bf2-cbeb-4650-b3fb-e69f07d42c09" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193166_445667_23708"/>
      </generalization>
      <generalization xmi:id="_18_4_1_8e001ed_1513959679239_992490_90869" xmi:uuid="269b528b-c6cb-4fee-9b54-6331df4d48df" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_8e001ed_1513076037040_166958_42165"/>
