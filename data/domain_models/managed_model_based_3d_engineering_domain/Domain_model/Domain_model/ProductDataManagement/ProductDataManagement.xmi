          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>LifecycleStageSelector</name>
        <ownedRule xmi:id="_18_4_1_290014c_1516871621048_693694_62046" xmi:uuid="cca05092-75c2-48e2-9165-601f9d44c339" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675678171218_386759_164505" xmi:uuid="b0c577a9-f54d-4e74-a3a3-b54acfdbec5f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621048_693694_62046"/>
            <body>if input is of type LifeCycleStage and input.SameAs is of type ProxyStringProxy then set simple to input.SameAs.value, otherwise if input is of type ProxyStringProxy then set simple to input.value, otherwise set simple to '/IGNORE/'. </body>
          </ownedComment>
          <name>simple</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1516871621018_251630_62026"/>
          <specification xmi:id="_18_4_1_290014c_1516871621067_790819_62087" xmi:uuid="2635cbc9-0974-4cd3-90b7-399a13734e2b" xmi:type="uml:OpaqueExpression">
            <body>simple = if input.oclIsTypeOf (LifeCycleStage) and input.SameAs.oclIsTypeOf (ProxyStringProxy) then input.SameAs.value else if input.oclIsTypeOf (ProxyStringProxy) then input.value else '/IGNORE/' endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_290014c_1516871621050_95290_62047" xmi:uuid="ec085b43-c7ae-45c6-b480-3763f4d8dff4" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675678156255_210180_164504" xmi:uuid="d91eba71-b83b-474d-878f-aa0f4eb79d1a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621050_95290_62047"/>
            <body>if input is of type LifeCycleStage and input.SameAS is not of type ProxyStringProxy then set complex to input.SameAs.externalItem, otherwise if input is not of type proxyStringProxy set it to input.externalItem, otherwise set it to null. </body>
          </ownedComment>
          <name>complex</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1516871621018_251630_62026"/>
          <specification xmi:id="_18_4_1_290014c_1516871621068_68655_62088" xmi:uuid="c2476cd1-cabb-4d63-89e2-2f129ebdfa19" xmi:type="uml:OpaqueExpression">
            <body>complex = if input.oclIsTypeOf (LifeCycleStage) and not input.SameAs.oclIsTypeOf (ProxyStringProxy) then input.SameAs.externalItem else if not input.oclIsTypeOf (proxyStringProxy) then input.externalItem else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_290014c_1516871621052_545024_62048" xmi:uuid="cb8ba26e-4329-40a2-9085-70ee87be05ae" xmi:type="uml:Port">
