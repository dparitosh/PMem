      <memberEnd xmi:idref="_18_4_1_271a0567_1523264537640_345929_166790"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1523264537876_233076_166939" xmi:uuid="3233246b-850e-4ddc-93cb-2fa24d87fdc6" xmi:type="uml:Property">
