    <packagedElement xmi:id="_18_4_1_e120334_1499417193017_495946_23392" xmi:uuid="472e492c-d53a-4f00-95af-d0e8adf43f00" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455713131714_79001_42835" xmi:uuid="008cfcd3-cba7-44e1-94f6-d401c5605adc" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193017_495946_23392"/>
        <body>An ApplicationDomain is an identification of the applications for which an object may be relevant.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_290014c_1516894008515_64662_104443" xmi:uuid="d00d41bc-cec3-4c25-8f0c-194834c58bd9" xmi:type="uml:Comment">
        <body>ApplicationDomain data type is only used in ViewContext entity. See ViewContext Block's mapping parametric diagram in order to find the mapping of ApplicationDomainSelect.</body>
      </ownedComment>
      <name>ApplicationDomain</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193362_738141_24446" xmi:uuid="430b7b36-719e-416a-a906-573cd8af659e" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758565_62048_151282" xmi:uuid="6500fc5a-7a75-4541-9b76-a0e6ef59556d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758566_774399_151283" xmi:uuid="9376523a-2845-44ff-8d1f-4f54bcf05d44" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ApplicationDomain[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="sameAsExternalItem" value="if(SameAs/Proxy/Individual/ExternalItem/@uidRef) then SameAs/Proxy/Individual/ExternalItem/@uidRef else ()"/&gt; &lt;sch:let name="sameAsExternalOwlObject" value="if(SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()"/&gt; &lt;sch:let name="sameAsProxyString" value="if(SameAs/Proxy/Individual/ProxyString) then SameAs/Proxy/Individual/ProxyString else ()"/&gt; &lt;sch:let name="sameAs" value="$sameAsExternalItem union $sameAsExternalOwlObject union $sameAsProxyString"/&gt; &lt;sch:let name="followingAndPrecedingExternalItem" value="(if(following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalItem/@uidRef) then following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalItem/@uidRef else ()) union (if(preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalItem/@uidRef) then preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalItem/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingExternalOwlObject" value="(if(following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()) union (if(preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ())"/&gt; &lt;sch:let name="followingAndPrecedingProxyString" value="(if(following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ProxyString) then following-sibling::ApplicationDomain/SameAs/Proxy/Individual/ProxyString else ()) union (if(preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ProxyString) then preceding-sibling::ApplicationDomain/SameAs/Proxy/Individual/ProxyString else ())"/&gt; &lt;sch:let name="followingAndPreceding" value="$followingAndPrecedingExternalItem union $followingAndPrecedingExternalOwlObject union $followingAndPrecedingProxyString"/&gt; &lt;sch:assert test="not(some $i in $sameAs, $j in $followingAndPreceding satisfies ($i eq $j))"&gt; The attribute SameAs shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:SameAs -attribute_value:&lt;sch:value-of select="$sameAs"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1513262803804_315973_62959" xmi:uuid="b07dc0ea-7638-4081-8879-d487f31f865b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193362_738141_24446"/>
          <body>the sameAs shall be unique. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671463729354_423437_163108" xmi:uuid="f20bf2ee-cd13-451f-b080-3d26cb58b14a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463736111_713365_163109" xmi:uuid="c6341099-db4c-4773-8151-0868789960c3" xmi:type="uml:Comment">
            <body>UR1: SameAs;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193017_495946_23392"/>
        <specification xmi:id="_18_4_1_e120334_1499417194207_858167_29852" xmi:uuid="9f304bbf-9c7c-42b0-9db4-10e4a03b7ae5" xmi:type="uml:OpaqueExpression">
          <body>ApplicationDomain::allInstances()-&gt;isUnique(SameAs)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193362_261055_24445" xmi:uuid="e4b6a367-1426-4a84-9e3a-3a88c4686408" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193017_120542_23393"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193362_420763_24447" xmi:uuid="8799a515-b946-47a9-a43a-01a6577b32ea" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455713147421_846342_42836" xmi:uuid="7855861d-17b8-4878-b540-396329bee26b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193362_420763_24447"/>
          <body> the object or set of objects held externally to the exchange file for which this object is a proxy. Where applicable the following values shall be used: &lt;ul&gt;&lt;li&gt;'assembly study': The object may be relevant for an assembly study; &lt;/li&gt; &lt;li&gt;'digital mock-up': The object may be relevant for digital mock-up; &lt;/li&gt; &lt;li&gt;'electrical design': The object may be relevant for the electrical design; &lt;/li&gt; &lt;li&gt;'mechanical design': The object may be relevant for the mechanical design; &lt;/li&gt; &lt;li&gt;'preliminary design': The object may be relevant for the preliminary design;&lt;/li&gt; &lt;li&gt;'process planning': The object may be relevant for the process planning; &lt;/li&gt; &lt;li&gt;'product support': The object may be relevant for the product support; &lt;/li&gt; &lt;li&gt;'not specific': The object is considered as not specific of any application domain.&lt;/li&gt; &lt;/ul&gt; </body>
        </ownedComment>
        <name>SameAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193214_230770_23795"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194207_579751_29853" xmi:uuid="e7c84ba8-e77d-4e20-86a9-8bbca37284c5" xmi:type="uml:LiteralUnlimitedNatural">
