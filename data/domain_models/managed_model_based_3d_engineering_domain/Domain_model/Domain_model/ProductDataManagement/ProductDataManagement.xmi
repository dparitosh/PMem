        <type xmi:idref="_18_4_1_e120334_1499417193168_61072_23712"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417195045_86369_37603" xmi:uuid="377e53f9-0f9d-4578-a772-b4fdf6cc2dd5" xmi:type="uml:LiteralInteger"/>
