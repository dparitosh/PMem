    <packagedElement xmi:id="_18_4_1_e120334_1499417193022_645728_23404" xmi:uuid="821c792a-da4b-4af1-bfc6-45a0776d834f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_290014c_1596637460066_421776_88930" xmi:uuid="23958a9b-315a-4b8a-95aa-97c3b51e8068" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_290014c_1596558271955_522559_97312"/>
        <annotatedElement xmi:idref="_18_4_1_290014c_1596558293114_205730_97350"/>
        <body>NOTE: Two alternatives exists to map CartesianTransformation: path through Geometric_composition_with_operator_transformation, but it is not recommended; path through Geometric_relationship_with_placement_transformation which is the recommended mapping.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1455713362956_744699_42841" xmi:uuid="3ed5bdf5-dfd2-4531-874d-e487727716f4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193022_645728_23404"/>
        <body>An AssemblyOccurrenceRelationship is the relation between an AssemblyDefinition and an Occurrence representing a constituent of the assembly. The AssemblyDefinition and the PartView that serves as 'definition' of the Occurrence shall share at least one ViewContext. &lt;note&gt; The constituent may also be an assembly.&lt;/note&gt; An AssemblyOccurrenceRelationship is a type of ViewOccurrenceRelationship. Each AssemblyOccurrenceRelationship is a NextAssemblyOccurrenceUsage or a PromissoryAssemblyOccurrenceUsage. </body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_290014c_1596560729074_927087_99869" xmi:uuid="c13c825c-95a2-4826-a0fd-ffedf70d0e78" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_271a0567_1524504164115_353016_78521"/>
        <annotatedElement xmi:idref="_18_4_1_290014c_1596560263054_40451_99268"/>
        <annotatedElement xmi:idref="_18_4_1_290014c_1596560366483_473857_99478"/>
        <body>NOTE: One single multi-leaf complex instance EXAMPLE: in express WR: drr :=: rr :=: gmr </body>
      </ownedComment>
      <name>AssemblyOccurrenceRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459324774379_238668_42448" xmi:uuid="2be39e27-a503-46e2-b20c-5cb60648ddf0" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459324811973_910778_42450" xmi:uuid="8d1cbaee-6263-4ddd-bec4-6055cb39f1ca" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324774379_238668_42448"/>
          <body> if the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to true.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671446019816_352604_162879" xmi:uuid="bb5bb84b-3cd0-4444-95ad-7ffc214ad58e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446048093_420243_162884" xmi:uuid="37620bdc-d1f0-4884-9a14-64f2ea087552" xmi:type="uml:Comment">
            <body>WR1: NOT(SCHEMA_NAME + '.' + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(Placement)) OR (SIZEOF(QUERY(ix &lt;* Placement | ix\RepresentationRelationship.Definitional = TRUE)) = 0);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295758522_399945_151276" xmi:uuid="d236caf1-55bb-4204-804b-5b52c7466ed7" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295758523_908412_151277" xmi:uuid="2b5dd616-fbf8-4ba1-aaea-b65700a59213" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ViewOccurrenceRelationship[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="reference_uidRef" value="Placement/*/@uidRef"/&gt; &lt;sch:let name="reference_xsitype" value="//*[@uid = $reference_uidRef]/@xsi:type"/&gt; &lt;sch:assert test="every $i in $reference_uidRef satisfies (not(substring-after(//*[@uid=$i]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $i]/Definitional=true())"&gt; If the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to true. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -attribute_name:&lt;sch:value-of select="//*[@uid = $reference_uidRef]/Definitional/name()"/&gt; -attribute_value:&lt;sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193022_645728_23404"/>
        <specification xmi:id="_18_4_1_271a0567_1509357871895_911613_30932" xmi:uuid="73ce82c2-8a47-44de-be5a-f7fdf57fb008" xmi:type="uml:OpaqueExpression">
          <body>self.Placement-&gt;forAll(p | p.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation) implies p.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricRepresentationRelationshipWithPlacementTransformation).Definitional = DataTypes::Boolean::True)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193384_184422_24676" xmi:uuid="21cf0788-15e3-49f2-8b20-2a7841376dff" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193239_422374_23834"/>
