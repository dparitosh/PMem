      <ownedAttribute xmi:id="_19_0_4_b1702d9_1702993887602_780934_60157" xmi:uuid="ddcbfbc0-7e84-40a0-ad9c-19384203deee" xmi:type="uml:Port">
        <name>alternatePartRelationship</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Alternate_part_relationship"/>
