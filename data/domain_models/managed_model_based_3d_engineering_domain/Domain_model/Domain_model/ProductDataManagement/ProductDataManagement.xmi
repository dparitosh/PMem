    <packagedElement xmi:id="_18_4_1_e120334_1499417193023_977979_23408" xmi:uuid="53a97994-a74c-4c10-86de-3294473985c7" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455713771678_363907_42855" xmi:uuid="e0cbb611-8771-4a50-833a-29bbec316ba1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193023_977979_23408"/>
        <body>An AssemblyViewRelationshipSubstitution is a relationship that indicates that one AssemblyViewRelationship may be substituted for another AssemblyViewRelationship. The subjects of the substitution are the related Occurrence objects of both AssemblyViewRelationship objects. The Relating AssemblyDefinition shall be the same in both AssemblyViewRelationship objects.</body>
      </ownedComment>
      <name>AssemblyViewRelationshipSubstitution</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459324954672_679457_42454" xmi:uuid="dacff5a5-00dd-40af-a043-ef91fb0f57f6" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459324988980_640514_42456" xmi:uuid="0816361f-f112-4757-a429-689d702c1c9c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324954672_679457_42454"/>
          <body>the related AssemblyViewRelationship and the relating AssemblyViewRelationship shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_78903_163006" xmi:uuid="792474dc-95dd-49b2-a821-ecd550432fbf" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_873620_163007" xmi:uuid="3b823d81-7ccf-4295-9f8f-97180db756e0" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121188_33048_163004" xmi:uuid="ee89f0ae-3d12-4f97-b571-9b9bfc19d476" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_879937_163005" xmi:uuid="96e39679-55a7-4959-8944-18d3b52f7374" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//AssemblyViewRelationshipSubstitution[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related AssemblyViewRelationship and the relating AssemblyViewRelationship shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:AssemblyViewRelationshipSubstitution.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193023_977979_23408"/>
        <specification xmi:id="_18_4_1_271a0567_1509111561761_824605_30457" xmi:uuid="5532a04e-3331-445a-9dd8-d308fb9f556d" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193391_828112_24723" xmi:uuid="4bb8a1d0-c15f-4af1-b04d-14fe78dd0392" xmi:type="uml:Generalization">
