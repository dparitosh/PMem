      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194150_106417_29348" xmi:uuid="849087b5-d408-489d-b9ad-6eee493373d7" xmi:type="uml:EnumerationLiteral">
