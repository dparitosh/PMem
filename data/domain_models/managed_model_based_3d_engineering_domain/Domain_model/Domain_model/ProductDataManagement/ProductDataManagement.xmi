    <packagedElement xmi:id="_18_4_1_e120334_1499417193166_445667_23708" xmi:uuid="6d8ccf3c-9dd9-4631-b462-4bef2a2b06b0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455715616501_249594_42896" xmi:uuid="1576d6f5-64f7-4cb2-8ddb-1b17e2b07f8d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193166_445667_23708"/>
        <body>A PartRelationship is a relationship between two Part objects.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551197054020_321291_124520" xmi:uuid="dd94eb7b-d075-45c1-b980-1bb54b946328" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>PartRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330366013_159412_42651" xmi:uuid="4ec77cb9-d83f-43ad-9795-0189a1b7f66a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330413787_334690_42653" xmi:uuid="2d68a2d5-5766-48d8-8d74-13394c769d06" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330366013_159412_42651"/>
          <body>the related Part and the relating Part shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121173_873566_163002" xmi:uuid="6c5497b7-9dff-4f2b-b4a9-1e870dc53211" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121174_511434_163003" xmi:uuid="24e2d70a-6cb8-45b1-b86b-470f6cf548a4" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121171_833779_163000" xmi:uuid="9144e3ed-37a4-4713-9c7f-ce8408e11e58" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121172_118269_163001" xmi:uuid="80019459-9a2a-4572-a3c2-45e23eb5ae06" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PartRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Part and the relating Part shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:PartRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193166_445667_23708"/>
        <specification xmi:id="_18_4_1_271a0567_1509115089692_158473_31340" xmi:uuid="63d22f8a-a31e-440a-b159-b4063db62519" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
