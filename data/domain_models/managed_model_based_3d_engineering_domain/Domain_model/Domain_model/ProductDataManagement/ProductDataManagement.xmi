            <annotatedElement xmi:idref="_18_4_1_290014c_1516871621052_545024_62048"/>
            <body>the input from which to select. </body>
          </ownedComment>
          <name>input</name>
          <visibility>private</visibility>
          <type xmi:idref="_18_4_1_e120334_1499417193139_97655_23639"/>
          <aggregation>composite</aggregation>
        </ownedAttribute>
        <ownedAttribute xmi:id="_18_4_1_290014c_1516871621054_85812_62049" xmi:uuid="fc6ed7d8-9dfc-4a8a-bdc6-5f9b536902b6" xmi:type="uml:Port">
