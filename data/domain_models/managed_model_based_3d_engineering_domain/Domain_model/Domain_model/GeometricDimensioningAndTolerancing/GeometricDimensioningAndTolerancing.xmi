    <packagedElement xmi:id="_18_4_1_af4021f_1601394052887_798517_101376" xmi:uuid="05abb9b0-cad7-420a-91c9-3aeafaa71039" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608106705607_612182_91143" xmi:uuid="4eb882b5-69f5-4f7c-912d-243bb4e8bf59" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052887_798517_101376"/>
        <body>A GeneralDatumReference is an occurrence of a Datum within a DatumSystem. Each GeneralDatumReference is either a DatumReferenceCompartment or a DatumReferenceElement.</body>
      </ownedComment>
      <name>GeneralDatumReference</name>
      <ownedRule xmi:id="_18_4_1_af4021f_1631871580934_974284_90925" xmi:uuid="a2242726-1ae1-48a7-b1b9-aeb7457f8a6c" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1631871652585_763387_90929" xmi:uuid="3116fbe8-1d6c-4de2-89a9-a6ac8f17ce28" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1631871580934_974284_90925"/>
          <body>either Base is specified or CommonDatumList specified at least 2 elements</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651674849269_688394_147897" xmi:uuid="b05d52f2-a058-4fc2-b674-ea3932c3327b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651674860144_964763_147900" xmi:uuid="d97cf60d-fa1b-43d2-950a-29962b2ac622" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//*[local-name()='DatumReferenceCompartment' or local-name()='DatumReferenceElement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test=" (not(./Base) and (count (./CommonDatumList/DatumReferenceElement) ge 2)) or ( ./Base and not(./CommonDatumList))"&gt; (GeneralDatumReference &lt;sch:value-of select="$uid"/&gt;) Either Base is specified or CommonDatumList specified at least 2 elements &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052887_798517_101376"/>
        <specification xmi:id="_18_4_1_af4021f_1631871580938_801732_90926" xmi:uuid="245a5023-9ecb-4f05-96ca-567d7a0ffbc2" xmi:type="uml:OpaqueExpression">
          <body> not(self.Base.oclIsUndefined()) xor (self.CommonDatumList-&gt;size() &gt;=2)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052948_115167_102404" xmi:uuid="a83bbce4-ac71-4c22-8779-bd0faf4877e9" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052910_261465_101644"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052913_582435_101729" xmi:uuid="ba24d2dc-c02b-40ab-ba49-60d5f1002855" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608106745200_350334_91144" xmi:uuid="9d6c155c-2a5b-4778-81ad-68a41a2af109" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052913_582435_101729"/>
          <body>specifies the used of a single Datum for the GeneralDatumReference. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Base</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052882_464614_101226"/>
        <lowerValue xmi:id="_18_4_1_af4021f_1601394052814_832945_100806" xmi:uuid="535bdc50-d72b-4f52-bb28-2cd610fba2b2" xmi:type="uml:LiteralInteger"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052949_168147_102476"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052857_208288_101037" xmi:uuid="7bc3d9e7-de6a-4f16-b397-15ed171190bf" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608106842057_42494_91145" xmi:uuid="47042af2-0bda-4a24-a1c8-76126bf06abe" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052857_208288_101037"/>
          <body>specifies the role of the datum modifier for the GeneralDatumReference. There shall exist at least one DatumReferenceModifier for the GeneralDatumReference. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Modifiers</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052859_588038_101072"/>
        <lowerValue xmi:id="_18_4_1_af4021f_1601394052881_81796_101191" xmi:uuid="9d552997-9622-40dd-8ea2-9cb095b6c25b" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_af4021f_1601394052940_930918_102112" xmi:uuid="fef110bd-80aa-480a-abad-03c58c87c413" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052888_709640_101415"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1631868884922_689439_90788" xmi:uuid="0e0df13b-c364-43b4-869d-daf6b511fbb7" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_af4021f_1631868991577_42677_90821" xmi:uuid="d8327d09-b97e-4666-b393-d3250404f289" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1631868884922_689439_90788"/>
          <body>specifies the list of DatumReferenceElement. Unless otherwise specified, a CommonDatumList shall be used in accordance with common datum as defined in ISO 5459. The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>CommonDatumList</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052813_441847_100779"/>
