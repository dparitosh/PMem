    <packagedElement xmi:id="_18_4_1_af4021f_1601394052858_410739_101058" xmi:uuid="1893a9ad-dadb-4e98-9f8d-4e81d0c0a2f3" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1614326643149_12112_90280" xmi:uuid="dc7880cc-bfcc-4c48-b1bf-e48d6324c1ff" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052858_410739_101058"/>
        <body>The OrientedToleranceZoneType is a list of modifier types that is used by OrientedToleranceZone to indicate the orientation of an "orientation plane". </body>
      </ownedComment>
      <name>OrientedToleranceZoneTypeEnum</name>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052913_664329_101724" xmi:uuid="b015bb3f-4ca9-4900-a33c-d3a6f1970019" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608131450144_111562_90501" xmi:uuid="6600337d-71e9-43eb-910a-92e4a3bcbb73" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052913_664329_101724"/>
          <body>indicates that the "orientation plane" is oriented perpendicular to the referenced datum.</body>
        </ownedComment>
        <name>perpendicular</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052852_318544_100921" xmi:uuid="0049c96c-6f6e-4ddb-8d34-bc17f3405e35" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608131459618_380827_90502" xmi:uuid="e0c9de7d-2c56-4c9c-868e-1914cfb59d3b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052852_318544_100921"/>
          <body>indicates that the "orientation plane" is oriented parallel to the referenced datum.</body>
        </ownedComment>
        <name>parallel</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052882_588084_101216" xmi:uuid="703e38ef-0494-4579-9536-82dd44039635" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608131470193_592160_90503" xmi:uuid="85522304-86aa-4179-8088-2e028ab1349d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052882_588084_101216"/>
          <body>indicates that the "orientation plane" is oriented under some specified angle to the referenced datum.</body>
        </ownedComment>
        <name>angular</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052732_437195_100601" xmi:uuid="1998ec57-8d2e-4f00-9c80-11a1fc849d89" xmi:type="uml:Association">
