    <packagedElement xmi:id="_18_4_1_af4021f_1601394052953_23292_102622" xmi:uuid="7f400dfc-de21-444f-b082-ffd62e808464" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606989327992_602270_93017" xmi:uuid="c56972ea-3986-4772-aafb-7b0fb9df38ed" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052953_23292_102622"/>
        <body>An AxisPlacementShapeElement is a type of ShapeElement that is associated with an AxisPlacement.</body>
      </ownedComment>
      <name>AxisPlacementShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052916_16089_101818" xmi:uuid="8227e821-24d0-4751-834c-791e03ed40da" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052879_257834_101126" xmi:uuid="d9ea39bf-dc1f-4c89-9b1e-9ec62d956f73" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_af4021f_1601394052854_501435_100952" xmi:uuid="188c2825-a040-4371-933a-821ee7e35ce1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052879_257834_101126"/>
          <body>specifies the associated AxisPlacement.</body>
        </ownedComment>
        <name>RepresentedGeometry</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
