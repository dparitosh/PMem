      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052813_441847_100779" xmi:uuid="7daff8eb-1d44-41f5-9f85-d82498615ed9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606999969810_795687_93560" xmi:uuid="41facdf9-9af6-40c4-a680-b72f6cd12591" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052813_441847_100779"/>
        <body>A DatumReferenceElement is a type of GeneralDatumReference that represents a single datum reference of a common datum with a DatumReferenceCompartment. Unless otherwise specified, the rules governing common datum defined in ISO 5459 shall apply. &lt;note&gt;Alternatively common datum can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>DatumReferenceElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052933_278294_101908" xmi:uuid="e3c21ca7-01d0-42e8-a6d7-5e2081c997db" xmi:type="uml:Generalization">
