    <packagedElement xmi:id="_18_4_1_af4021f_1601394052885_521651_101326" xmi:uuid="54ec43f4-dbd4-4a05-ab2b-3d42c3763f82" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606988956551_456026_93000" xmi:uuid="d13d17dd-53d8-4202-a61f-4fe1f60a9461" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052885_521651_101326"/>
        <body>An AngularLocation is a type of DimensionalLocation. An AngularLocation specifies that a spatial constraint exists between two ShapeElements that intersect or would intersect if projected. An AngularLocation is a measure of the angle defined by the two ShapeElements and their common intersection or projected intersection. &lt;note&gt;The application and use of an AngularLocation is illustrated in the Figure &lt;caption&gt;AngularLocation&lt;/caption&gt;. The Figure &lt;caption&gt;AngularLocation&lt;/caption&gt; also illustrates types of intersection (a and b) and virtual intersection (c and d).&lt;/note&gt; &lt;figure&gt;&lt;name&gt;AngularLocation.gif&lt;/name&gt;AngularLocation&lt;/figure&gt;</body>
      </ownedComment>
      <name>AngularLocation</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052859_827073_101068" xmi:uuid="b61e0332-0a47-443d-ae7f-52b5994bd8d6" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052956_761524_102717"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052941_677415_102142" xmi:uuid="513de04b-3de5-45a7-8546-150f32da8608" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606989013033_829672_93001" xmi:uuid="2ec53e4a-09a5-45a8-98d0-bf2597e0147c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052941_677415_102142"/>
          <body>an indication of the specific angle type at the point of intersection.</body>
        </ownedComment>
        <name>AngleSelection</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052811_522789_100710"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052949_358758_102473"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052700_620626_100402" xmi:uuid="4d766a6c-be05-495b-b318-67f036b3ec41" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606989028620_144325_93002" xmi:uuid="0a264dc1-a1e3-49d8-9378-7d96e4062a1a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052700_620626_100402"/>
          <body>an axis placement establishing the direction of positive measure of the AngularLocation. The angle extends in the XY plane from the X axis towards Y, about the origin. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Orientation</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
