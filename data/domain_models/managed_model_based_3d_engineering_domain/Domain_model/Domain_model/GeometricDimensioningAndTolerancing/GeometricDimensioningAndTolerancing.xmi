        <upperValue xmi:id="_18_4_1_af4021f_1631868926133_854302_90797" xmi:uuid="dc22e8f2-4c35-4956-84ba-46ffd34a54e5" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
