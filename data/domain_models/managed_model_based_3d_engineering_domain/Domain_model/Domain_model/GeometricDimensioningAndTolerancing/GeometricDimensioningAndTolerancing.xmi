    <packagedElement xmi:id="_18_4_1_af4021f_1601394052941_609221_102184" xmi:uuid="cce6ba41-5cee-40fb-ad64-851fa1f2168d" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052882_478036_101228"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052699_932201_100373"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052882_478036_101228" xmi:uuid="0d60b266-89f8-4b74-9f9c-5a6474648ea0" xmi:type="uml:Property">
