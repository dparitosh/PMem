      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052935_648987_101987" xmi:uuid="a69435ae-bceb-4f25-8c58-9287c21506e6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608110092884_573897_95013" xmi:uuid="cd60f244-87ef-48e0-94b3-a4ff047b8d28" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052935_648987_101987"/>
          <body>the distance from the ProjectionEnd to where the GeometricTolerance shall be measured.</body>
        </ownedComment>
