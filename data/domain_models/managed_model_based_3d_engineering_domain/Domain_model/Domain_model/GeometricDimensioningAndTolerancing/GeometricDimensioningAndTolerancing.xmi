    <packagedElement xmi:id="_18_4_1_af4021f_1601394052942_250068_102197" xmi:uuid="2c194fd5-f5f7-4ca5-8222-48e16da59388" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1614265834885_103577_91565" xmi:uuid="1d86739c-ba3b-4091-a0c6-b07096124356" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052942_250068_102197"/>
        <body>The UndefinedEdgeShapeDirectionEnum type specifies which neighbouring surface of an EdgeOfUndefinedShapeSize is affected. </body>
      </ownedComment>
      <name>UndefinedEdgeShapeDirectionEnum</name>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052938_400863_102075" xmi:uuid="6b704b0c-640d-4cd1-9d37-b7cd35b1f5c8" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608132255115_302128_90576" xmi:uuid="eca405a3-c79f-4014-ab01-9e06dc648190" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052938_400863_102075"/>
          <body>the neighbouring surface that includes the Oriented_edge with the .TRUE. orientation is affected.</body>
        </ownedComment>
        <name>true_neighbor</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052703_433507_100481" xmi:uuid="16ad423f-5e01-4cc8-9b5a-f18b032dc50d" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608132263348_930135_90577" xmi:uuid="12f6cef5-3841-42f3-958c-5766ddf3e6b0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052703_433507_100481"/>
          <body>the neighbouring surface that includes the Oriented_edge with the .FALSE. orientation is affected.</body>
        </ownedComment>
        <name>false_neighbor</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052942_404094_102212" xmi:uuid="ad14e2ba-1524-4a1b-acf7-a4c2bdec7433" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608132270567_647053_90578" xmi:uuid="9f49e653-d336-4484-8cb6-25543a05daf8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052942_404094_102212"/>
          <body>both neighbouring surfaces are affected.</body>
        </ownedComment>
        <name>both_neighbors</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052911_874476_101685" xmi:uuid="2d1e617c-6638-4113-b23e-90724c673452" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1607002016327_605691_94014" xmi:uuid="883ac218-e24f-4d4a-b27d-f001ea4f73a0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052911_874476_101685"/>
        <body>A DirectedOrOrientedToleranceZone is a type of ToleranceZone that includes additional direction or orientation information for the tolerance zone. A DirectedOrOrientedToleranceZone shall be either a ToleranceZoneWithDatum or an AffectedPlaneToleranceZone.</body>
      </ownedComment>
      <name>DirectedOrOrientedToleranceZone</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052951_145976_102558" xmi:uuid="ebe90397-a9c0-4743-ab4d-1a1952e8c9d0" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052887_827542_101374"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052944_11277_102287" xmi:uuid="93065f0a-bec6-4e2e-aa25-6251e080e719" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1607002054172_795508_94015" xmi:uuid="88dfb417-1fc5-41e1-941a-a1d539127cf1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052944_11277_102287"/>
          <body>an inherited attribute whose value shall be of type DimensionalLocation, DimensionalSize, LineProfileTolerance, ParallelismTolerance, PerpendicularityTolerance, PositionTolerance, StraightnessTolerance or SymmetryTolerance.</body>
        </ownedComment>
        <name>ZoneFor</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052936_895137_102029"/>
        <upperValue xmi:id="_18_4_1_af4021f_1601394052909_634790_101599" xmi:uuid="9a36a526-3db9-424a-8e22-3995be12163f" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_af4021f_1601394052885_81052_101316"/>
        <redefinedProperty xmi:idref="_18_4_1_af4021f_1601394052852_553078_100909"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1628686585620_977690_92856" xmi:uuid="2f26aa5f-ac1e-421c-b200-1dab1c45e178" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_91401df_1628686585620_917535_92857"/>
