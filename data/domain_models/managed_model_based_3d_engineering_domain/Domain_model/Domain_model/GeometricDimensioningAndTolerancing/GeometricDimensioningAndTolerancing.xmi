    <packagedElement xmi:id="_18_4_1_af4021f_1601394052885_467261_101298" xmi:uuid="1a6598e0-2f4b-42ee-b196-1a231c6c8327" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1607002153264_845117_94030" xmi:uuid="f6b7b419-1386-4491-bbae-c43d1265f95a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052885_467261_101298"/>
        <body>An EdgeOfUndefinedShapeSize is a type of GeometricDimension that represents an "edge of undefined shape" size as defined in ISO 13715.</body>
      </ownedComment>
      <name>EdgeOfUndefinedShapeSize</name>
      <ownedRule xmi:id="_18_4_1_91401df_1649683551652_123636_149931" xmi:uuid="a84972a6-e6d3-4c66-ae0f-ebb7709f97ab" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1649683622112_782603_149940" xmi:uuid="94bd9646-b7fd-4724-a68f-491aa6cab9f2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1649683551652_123636_149931"/>
          <body>a geometric edge object shall not have more than one EdgeOfUndefinedShapeSize for an orientation.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651681612150_279289_148052" xmi:uuid="fa3823d2-6dba-4593-bb32-a81549efe570" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651681620281_857624_148053" xmi:uuid="0a20718e-c438-4813-83d3-583f7745b151" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricDimension[substring-after(@xsi:type,':')='EdgeOfUndefinedShapeSize']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="isAppliedToRef" value="./IsAppliedTo/@uidRef"/&gt; &lt;sch:let name="orientation" value="./Orientation"/&gt; &lt;sch:assert test="not (($isAppliedToRef = following::GeometricDimension[substring-after(@xsi:type,':')='EdgeOfUndefinedShapeSize'][./Orientation=$orientation]/IsAppliedTo/@uidRef) or ($isAppliedToRef = preceding::GeometricDimension[substring-after(@xsi:type,':')='EdgeOfUndefinedShapeSize'][./Orientation=$orientation]/IsAppliedTo/@uidRef))"&gt; (EdgeOfUndefinedShapeSize &lt;sch:value-of select="$uid"/&gt;) A geometric edge object shall not have more than one EdgeOfUndefinedShapeSize for an orientation. &lt;sch:value-of select="$isAppliedToRef"/&gt; / &lt;sch:value-of select="$orientation"/&gt; &lt;/sch:assert&gt; &lt;/sch:rule&gt; </body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052885_467261_101298"/>
        <specification xmi:id="_18_4_1_91401df_1649683551654_578510_149932" xmi:uuid="f3dc8422-5f03-44dc-ad8a-4705ecec5c05" xmi:type="uml:OpaqueExpression">
          <body>EdgeOfUndefinedShapeSize::allInstances()-&gt;isUnique(Sequence{IsAppliedTo, Orientation})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052699_893001_100386" xmi:uuid="8bb9e52e-e2bd-4470-9cd0-db6d80261ea4" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052703_184496_100462"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052933_115360_101909" xmi:uuid="b6db3e9b-6bb7-450a-9f0a-8eb49cd75aa1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1607002167579_878813_94031" xmi:uuid="01ad4064-d60a-4ee3-9f4b-9d38a9129b6e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052933_115360_101909"/>
          <body>specifies which neighbouring surface of the edge is affected.</body>
        </ownedComment>
        <name>Orientation</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052942_250068_102197"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052936_848409_102035"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052810_339856_100698" xmi:uuid="6428f9b7-3913-4a52-8160-740630e45f80" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1607002175723_563226_94032" xmi:uuid="f8fa99b4-a538-4e81-b8b7-173e715603a0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052810_339856_100698"/>
          <body>specifies the affected geometric edge object.</body>
        </ownedComment>
        <name>IsAppliedTo</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052955_644995_102696"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052941_54574_102166"/>
        <redefinedProperty xmi:idref="_18_4_1_af4021f_1601394052854_369249_100958"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_91401df_1613732592578_828979_91941" xmi:uuid="61651ff1-e846-4278-84e9-24cef9a281f2" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1613732592588_687781_91943" xmi:uuid="1f22a57f-b7aa-4efd-82b5-8174d63bfca2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1613732592578_828979_91941"/>
          <body>the value of size of the element or of the distance between the two elements.</body>
        </ownedComment>
        <name>DimensionValue</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193282_361183_23902"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_91401df_1613732592768_371271_91946"/>
        <redefinedProperty xmi:idref="_18_4_1_af4021f_1601394052947_484561_102369"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052732_375739_100593" xmi:uuid="1b817e35-7db2-4a68-b0a5-ffdcb59ce60b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606990789098_545902_93057" xmi:uuid="072ecb61-06b2-4cc2-9dbc-c8fc787f1249" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052732_375739_100593"/>
        <body>A CoaxialityTolerance is a type of GeometricTolerance that constrains a centre point or plane of a surface of revolution, or of circular elements, about a datum feature. &lt;note&gt;Some tolerancing standards require the use of position tolerance for control of coaxiality. Unless otherwise specified, the rules governing coaxiality tolerance defined in ISO 1101 shall apply.&lt;/note&gt; &lt;note&gt;Alternatively coaxiality tolerance can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>CoaxialityTolerance</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052786_458408_100630" xmi:uuid="a92be293-fa31-4ef2-b11a-d29aad8087a5" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052703_463964_100493" xmi:uuid="599d1dc3-cf36-42f5-bbf8-4db555339e2e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606990804649_876805_93058" xmi:uuid="53ddad2d-b911-497f-96e5-ca5fc6f52dcb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052703_463964_100493"/>
          <body>specifies the role of the Datum_system for the CoaxialityTolerance.</body>
        </ownedComment>
        <name>DatumSystem</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052887_745486_101391"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052816_151550_100838"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052814_844718_100815" xmi:uuid="1d00c178-208a-4946-ad39-a037e594741f" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608108747673_747078_93869" xmi:uuid="75ef2c85-20d0-4cc3-83f2-718404a716e4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052814_844718_100815"/>
        <body>A MeasurementPath is a path, direction, or domain of applicability for a dimension or tolerance. The path is represented by a Curve. A MeasurementPath is a general term whose meaning depends on the context entity which is using it. &lt;example&gt;A surface may only need to be smooth in one direction.&lt;/example&gt; &lt;example&gt;A dimension of a fillet may be specified by its arc length, which is a measurement path.&lt;/example&gt;</body>
      </ownedComment>
      <name>MeasurementPath</name>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052933_782580_101907" xmi:uuid="88dded30-a409-4c26-9271-85fd21dcdf58" xmi:type="uml:Property">
