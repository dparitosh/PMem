          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052947_721520_102396"/>
          <body>indicates that least material requirement applies in accordance with ISO 2692 unless otherwise specified; &lt;note&gt;The symbol for least material requirement is Ⓛ.&lt;/note&gt;</body>
        </ownedComment>
        <name>least_material_requirement</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052857_233993_101036" xmi:uuid="5f96ccb5-2a0b-43d2-a2c6-1104c565d4dc" xmi:type="uml:EnumerationLiteral">
