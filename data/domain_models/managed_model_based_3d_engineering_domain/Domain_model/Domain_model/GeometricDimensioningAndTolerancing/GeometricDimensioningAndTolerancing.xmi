        </ownedComment>
        <name>minor_diameter</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052705_648375_100540" xmi:uuid="8715fde3-8541-41fd-874b-f66c4b62a824" xmi:type="uml:EnumerationLiteral">
