    <packagedElement xmi:id="_18_4_1_af4021f_1601394052703_101542_100483" xmi:uuid="ed627572-294f-4b2c-88c0-70a00f7a796b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608110891123_120582_95045" xmi:uuid="24325fb6-9223-460c-9e9f-c5bbc1274909" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052703_101542_100483"/>
        <body>A TargetPoint is a type of PlacedTarget that specifies a DatumTarget that is defined by a single implicit point. The position of the TargetPoint is defined by the placing AxisPlacement.</body>
      </ownedComment>
      <name>TargetPoint</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052952_583951_102587" xmi:uuid="a373dbaf-e8ec-48b4-985f-aa8f3482043a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052816_433253_100836"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1628686294614_535195_92693" xmi:uuid="edb0d73e-6fde-4160-b1e3-f12a982ee7d1" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1628686372232_565776_92736" xmi:uuid="99473a85-1e2a-4776-b529-7d8d8d8e37a9" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1628686294614_535195_92693"/>
        <body>A GeometricIntersection is a type of DerivedShapeElement that is the common intersection of two or more ShapeElements. &lt;note&gt;Since a GeometricIntersection is a derived shape, the use of intersection here is independent of any specific representation.&lt;/note&gt; &lt;example&gt;A GeometricIntersection is established by the intersection of two planar extensions from the adjacent sides of the block.&lt;/example&gt;</body>
      </ownedComment>
      <name>GeometricIntersection</name>
      <generalization xmi:id="_18_4_1_91401df_1628686395349_167739_92751" xmi:uuid="759ba05b-ca86-4f91-ac0c-c13889ef404c" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_91401df_1628683389691_681760_92212"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_91401df_1628686406366_127248_92752" xmi:uuid="5f173934-5060-4c10-8302-6df69066cf2a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1628686406366_794219_92754" xmi:uuid="9fc91c55-52fe-4d24-a247-4f7115551ea5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1628686406366_127248_92752"/>
          <body>an attribute inherited from the DerivedShapeElement shall be redeclared as the ShapeElement for the GeometricIntersection. There shall exist two or more ShapeElements for the GeometricIntersection.</body>
        </ownedComment>
        <name>DerivedFrom</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
        <lowerValue xmi:id="_18_4_1_91401df_1628686406366_190139_92755" xmi:uuid="0cca3c67-2f39-43a9-8996-ded3ee048cac" xmi:type="uml:LiteralInteger">
          <value>2</value>
        </lowerValue>
        <upperValue xmi:id="_18_4_1_91401df_1628686406366_719662_92753" xmi:uuid="f238c787-6a75-41f1-b516-30f188a605ca" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_91401df_1628686430530_21664_92762"/>
        <redefinedProperty xmi:idref="_18_4_1_91401df_1628683532684_164698_92259"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052786_418916_100634" xmi:uuid="edbdb1b8-117e-4181-a4aa-449a85acf43a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608107290309_970134_93809" xmi:uuid="d03103a1-1670-4207-9e09-53eface8b7ef" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
        <body>A GeometricTolerance is a specification of the allowed deviation of some element of the shape of a product from its theoretically exact shape.</body>
      </ownedComment>
      <name>GeometricTolerance</name>
      <ownedRule xmi:id="_18_4_1_91401df_1614678311624_659942_91152" xmi:uuid="57f386bd-98c9-4ed1-a027-169d1d01094b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1651766540337_650269_147484" xmi:uuid="2ecd8fae-c74c-409c-a66e-28c239e4e266" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651766551601_964113_147485" xmi:uuid="97dd3b38-31a9-42cf-ba04-6a5119a5c168" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricTolerance"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="areaUnitTypeRCS" value="./AreaUnitType='rectangular' or ./AreaUnitType='cylindrical' or ./AreaUnitType='spherical'"/&gt; &lt;sch:assert test="(not(./SecondUnitSize) and not ($areaUnitTypeRCS)) or (./SecondUnitSize and $areaUnitTypeRCS)"&gt;(GeometricTolerance &lt;sch:value-of select="$uid"/&gt;) A value for SecondUnitSize shall be provided if and only if the AreaUnitType is rectangular, cylindrical, or spherical. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1614678381364_25126_91155" xmi:uuid="965f5f6b-deeb-4a50-ba6e-4b1cf7107944" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614678311624_659942_91152"/>
          <body>a value for SecondUnitSize shall be provided if and only if the AreaUnitType is rectangular, cylindrical, or spherical. </body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
        <specification xmi:id="_18_4_1_91401df_1614678311624_558403_91153" xmi:uuid="0ef48f75-9ccd-44b8-93c1-2f93b6b984b1" xmi:type="uml:OpaqueExpression">
          <body>not (self.AreaUnitType.oclIsUndefined()) implies (self.AreaUnitType &lt;&gt;Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::rectangular and self.AreaUnitType &lt;&gt;Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::cylindrical and self.AreaUnitType &lt;&gt;Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::spherical) xor not(self.SecondUnitSize.oclIsUndefined())</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_91401df_1614679001986_57741_91168" xmi:uuid="84c1520e-4b93-4f92-8688-06872ed35599" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1614679074149_55915_91170" xmi:uuid="1a77ddd8-80d1-4352-ab52-695dac0b2e0e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614679001986_57741_91168"/>
          <body>the unit of UnequallyDisposedToleranceZoneDisplacement shall be a length measure. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651832152763_752014_147979" xmi:uuid="e1b80a4d-3a63-4b72-930e-963278fb7dbd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651832161208_860525_147980" xmi:uuid="350c4b87-2650-4553-afbb-592cd1e214c9" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricTolerance/UnequallyDisposedToleranceZoneDisplacement"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='length'"&gt;(GeometricTolerance &lt;sch:value-of select="$uid"/&gt;) The unit of UnequallyDisposedToleranceZoneDisplacement shall be a length measure. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR7</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
        <specification xmi:id="_18_4_1_91401df_1614679001986_454490_91169" xmi:uuid="685bb1a5-1c98-48ed-b66b-c17e2c915441" xmi:type="uml:OpaqueExpression">
          <body>self.UnequallyDisposedToleranceZoneDisplacement.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'length'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_91401df_1614678947210_239422_91165" xmi:uuid="ada9c24d-dd5e-45ea-a9d0-312f1c6d4e07" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1651830930587_463067_147926" xmi:uuid="41e763dd-5fd5-4a76-ab40-457da0f48ade" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651830944504_62021_147929" xmi:uuid="82cb3114-2611-4754-a1d2-53afc47dc334" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricTolerance[AreaUnitType='spherical']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="//ShapeElement[substring-after(@xsi:type,':')='OrientedToleranceZone' and ZoneFor/*/@uidRef=$uid]"&gt;(GeometricTolerance &lt;sch:value-of select="$uid"/&gt;) If the AreaUnitType is spherical, an OrientedToleranceZone shall be provided. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1614678996644_295915_91167" xmi:uuid="be784db4-ee1e-4c61-9710-c0b3ce02f914" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614678947210_239422_91165"/>
          <body>if the AreaUnitType is spherical, an OrientedToleranceZone shall be provided.</body>
        </ownedComment>
        <name>WR6</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
        <specification xmi:id="_18_4_1_91401df_1614678947210_595055_91166" xmi:uuid="060fed21-bb47-4d8c-b2e1-5a796085d7c1" xmi:type="uml:OpaqueExpression">
          <body>self.AreaUnitType = Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::spherical implies OrientedToleranceZone::allInstances()-&gt;exists(otz | otz.ZoneFor-&gt; includes (self))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_91401df_1614678865921_547369_91162" xmi:uuid="d1c1b084-1d32-4fdf-a5e2-c7fb79d0ad6b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1614678935927_502746_91164" xmi:uuid="4af89807-f6ba-4d81-8968-fedd6d668166" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614678865921_547369_91162"/>
          <body>if the AreaUnitType is spherical, the FirstUnitSize shall be a value of plane angle measure and the SecondUnitSize shall be a value of plane angle measure. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651829308856_944859_147247" xmi:uuid="d3ae859d-c692-40a7-a61b-648786113882" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651829322319_797245_147248" xmi:uuid="51cb2770-9204-4bbd-a2e0-1547a5a42c8f" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricTolerance[AreaUnitType='spherical']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="firstUnitSizeRef" value="./FirstUnitSize/Unit/@uidRef"/&gt; &lt;sch:let name="isFirstUnitSizePlaneAngle" value="//Unit[@uid=$firstUnitSizeRef]/Quantity/ClassString ='plane angle'"/&gt; &lt;sch:let name="secondUnitSizeRef" value="./SecondUnitSize/Unit/@uidRef"/&gt; &lt;sch:let name="isSecondUnitSizePlaneAngle" value="//Unit[@uid=$secondUnitSizeRef]/Quantity/ClassString ='plane angle'"/&gt; &lt;sch:assert test="$isFirstUnitSizePlaneAngle and $isSecondUnitSizePlaneAngle"&gt;(GeometricTolerance &lt;sch:value-of select="$uid"/&gt;) If the AreaUnitType is spherical, the FirstUnitSize shall be a value of plane angle measure and the SecondUnitSize shall be a value of plane angle measure. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR5</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
        <specification xmi:id="_18_4_1_91401df_1614678865921_281076_91163" xmi:uuid="a18e2525-7352-4858-84cc-50389f9587af" xmi:type="uml:OpaqueExpression">
          <body>self.AreaUnitType = Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::spherical implies ((self.FirstUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'plane angle') and (self.SecondUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'plane angle'))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_91401df_1614678769526_867002_91159" xmi:uuid="e6ad87c6-1461-4734-82d2-f36d6468429a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1614678844272_441355_91161" xmi:uuid="7038bc18-979c-48de-b5e8-82f6ca7c497b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614678769526_867002_91159"/>
          <body>if the AreaUnitType is rectangular, the FirstUnitSize shall be a length measure and the SecondUnitSize shall be a length measure.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651828457829_626550_147181" xmi:uuid="98fae27f-92a2-43d4-905e-e58ffb8a2440" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651828474019_19401_147184" xmi:uuid="e6bfe9c2-fa3f-4c30-a422-7a8b7791b0f2" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//GeometricTolerance[AreaUnitType='rectangular']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="firstUnitSizeRef" value="./FirstUnitSize/Unit/@uidRef"/&gt; &lt;sch:let name="isFirstUnitSizeLength" value="//Unit[@uid=$firstUnitSizeRef]/Quantity/ClassString ='length'"/&gt; &lt;sch:let name="secondUnitSizeRef" value="./SecondUnitSize/Unit/@uidRef"/&gt; &lt;sch:let name="isSecondUnitSizeLength" value="//Unit[@uid=$secondUnitSizeRef]/Quantity/ClassString ='length'"/&gt; &lt;sch:assert test="$isFirstUnitSizeLength and $isSecondUnitSizeLength"&gt;(GeometricTolerance &lt;sch:value-of select="$uid"/&gt;) If the AreaUnitType is rectangular, the FirstUnitSize shall be a length measure and the SecondUnitSize shall be a length measure. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR4</name>
