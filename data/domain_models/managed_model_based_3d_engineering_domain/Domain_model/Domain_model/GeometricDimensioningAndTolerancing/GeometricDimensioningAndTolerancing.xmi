          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052931_523821_101841"/>
          <body>the kind of shape of the ToleranceZone.</body>
        </ownedComment>
        <name>FormType</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052913_914930_101736"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052854_991801_100959"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052852_553078_100909" xmi:uuid="099421cf-68a0-4474-8481-54ba6c07cc25" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608111188379_820962_95069" xmi:uuid="996b862a-f809-4f1c-9708-cfdad1532e23" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052852_553078_100909"/>
          <body>the set of DimensionalLocation, DimensionalSize, GeneralDatumReference or GeometricTolerance objects for which the ToleranceZone defines the zone. There shall exist at least one DimensionalLocation, DimensionalSize, GeneralDatumReference or GeometricTolerance for the ToleranceZone.</body>
        </ownedComment>
        <name>ZoneFor</name>
        <visibility>public</visibility>
