      <ownedComment xmi:id="_18_4_1_91401df_1606834482211_533066_91231" xmi:uuid="030fc1d1-fd8e-4d7c-b85a-5a6a7eb221ac" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1606833619839_422528_91099"/>
        <body>A FilterNestingIndex is a specification of a nesting index for a filtering element of the toleranced feature. Unless otherwise specified the rules governing filter specification element defined in ISO 1101 shall apply.</body>
      </ownedComment>
      <name>FilterNestingIndex</name>
      <ownedAttribute xmi:id="_18_4_1_91401df_1606833260793_302775_91057" xmi:uuid="e0b14a47-cabb-4db3-b013-f47d770a4ef4" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608106517413_715518_90361" xmi:uuid="877b75e1-815c-43a3-846c-3e88e3606dc8" xmi:type="uml:Comment">
