      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052936_930201_102031" xmi:uuid="8be26e2c-70c1-483f-b304-2db6a6c66e1e" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608130546735_975120_90488" xmi:uuid="ee52756a-87a3-45e0-a102-8bc26b81633d" xmi:type="uml:Comment">
