          <body>self.AreaUnitType = Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::AreaUnitTypeEnum::rectangular implies ((self.FirstUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'length') and (self.SecondUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'length'))</body>
          <language>OCL2.0</language>
