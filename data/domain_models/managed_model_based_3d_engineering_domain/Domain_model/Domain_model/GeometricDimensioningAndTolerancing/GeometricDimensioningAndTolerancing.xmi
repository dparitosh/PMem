      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052905_505482_101503" xmi:uuid="3548a1fc-43da-4fab-8919-3fe6fa91147d" xmi:type="uml:EnumerationLiteral">
