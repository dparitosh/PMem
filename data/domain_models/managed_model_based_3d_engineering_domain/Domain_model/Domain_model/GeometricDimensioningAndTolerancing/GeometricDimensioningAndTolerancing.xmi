      <memberEnd xmi:idref="_18_4_1_91401df_1628683622825_504133_92266"/>
      <memberEnd xmi:idref="_18_4_1_91401df_1628683532684_164698_92259"/>
      <ownedEnd xmi:id="_18_4_1_91401df_1628683622825_504133_92266" xmi:uuid="686dbed2-1012-4c51-98b1-211cafeff86e" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_91401df_1628683389691_681760_92212"/>
        <association xmi:idref="_18_4_1_91401df_1628683622825_584706_92265"/>
