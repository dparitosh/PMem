          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052855_680730_100988"/>
          <body>indicates that maximum material requirement applies in accordance with ISO 2692 unless otherwise specified; &lt;note&gt;The symbol for maximum material requirement is Ⓜ.&lt;/note&gt;</body>
        </ownedComment>
        <name>maximum_material_requirement</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052947_721520_102396" xmi:uuid="dfe640a8-9420-4b0d-915b-016d133282a2" xmi:type="uml:EnumerationLiteral">
