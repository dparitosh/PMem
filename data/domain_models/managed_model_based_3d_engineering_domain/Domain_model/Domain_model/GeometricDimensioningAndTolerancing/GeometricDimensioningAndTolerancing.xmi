      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052950_544341_102513" xmi:uuid="29c4fe08-3815-402a-9f73-98104551fb01" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1607000115808_234766_93563" xmi:uuid="e5c0cae3-e465-4982-80ea-0ca93195e5ca" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052950_544341_102513"/>
          <body>specifies the role of the value for the DatumReferenceModifierWithValue.</body>
        </ownedComment>
        <name>ModifierValue</name>
