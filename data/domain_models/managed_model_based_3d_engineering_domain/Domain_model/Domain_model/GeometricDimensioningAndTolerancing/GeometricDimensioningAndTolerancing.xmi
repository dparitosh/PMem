        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052700_739724_100398"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052910_534201_101653"/>
      </ownedEnd>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052851_687259_100888" xmi:uuid="52a87e7c-36c8-45ab-8102-f2aa22df762d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608110833565_713129_95043" xmi:uuid="b2d80cd5-3d2d-4f22-8568-c79d291520fc" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052851_687259_100888"/>
        <body>A TargetCurve is a type of DatumTarget that is specified by a single curve.</body>
      </ownedComment>
      <name>TargetCurve</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052945_26541_102316" xmi:uuid="f9ea8172-38ad-403c-b982-44301ae3c89f" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052731_992120_100579"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052884_842565_101278" xmi:uuid="acc7ef60-fb7b-4141-9f15-28035f95f567" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608110848316_740143_95044" xmi:uuid="c396a5d0-39c7-4093-90dc-e13eab7e46b1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052884_842565_101278"/>
          <body>specifies the ShapeElement that represents the TargetCurve.</body>
        </ownedComment>
        <name>IsDefinedBy</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052909_840608_101607"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1606986975449_983700_92068" xmi:uuid="5373f59b-32a7-4a1f-845f-2b94a8e9f998" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606987362944_791884_92119" xmi:uuid="f407f816-a7ca-4e93-9a03-3cb05c9c9d94" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1606986975449_983700_92068"/>
        <body>An AllAroundShapeElementAlongCollectionPlane is a type of AllAroundShapeElement that represents the "all around" along a specified "collection plane" as defined in ISO 1101.</body>
      </ownedComment>
      <name>AllAroundShapeElementAlongCollectionPlane</name>
      <generalization xmi:id="_18_4_1_91401df_1606987052157_331937_92113" xmi:uuid="75e9f446-2a1f-4e3a-bbee-0f78a449bc3f" xmi:type="uml:Generalization">
