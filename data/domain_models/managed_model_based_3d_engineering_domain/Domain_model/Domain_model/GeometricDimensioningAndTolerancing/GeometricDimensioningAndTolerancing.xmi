    <packagedElement xmi:id="_18_4_1_af4021f_1601394052817_393664_100875" xmi:uuid="d0587830-cdb7-49c0-ae1c-8c9d11a3eeeb" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1614263959933_104214_91146" xmi:uuid="f09ea581-1e0c-46c4-b026-e15b04020fec" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052817_393664_100875"/>
        <body>The DirectedToleranceZoneType is an extensible list of modifier types that is used by DirectedToleranceZone to indicate the direction of an intersection plane. Unless otherwise specified the rules governing intersection plane defined in ISO 1101 shall apply.</body>
      </ownedComment>
      <name>DirectedToleranceZoneTypeEnum</name>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052817_520046_100860" xmi:uuid="e1441641-9eb7-4060-a8a4-5aa6c06b8356" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608128468638_76600_90406" xmi:uuid="171845b5-0e55-43fb-81ba-eec57301a116" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052817_520046_100860"/>
          <body>indicates that the "intersection plane" is directed perpendicular to the referenced datum.</body>
        </ownedComment>
        <name>perpendicular</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052813_180877_100799" xmi:uuid="29ed9728-d98e-4ac8-9d39-1f1ef8e436d9" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608128476261_312757_90407" xmi:uuid="1270b925-d596-421a-ab14-79d15f3bce2c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052813_180877_100799"/>
          <body>indicates that the "intersection plane" is directed parallel to the referenced datum.</body>
        </ownedComment>
        <name>parallel</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052945_205460_102297" xmi:uuid="1e173c35-8193-4c19-9b6c-0ff48b5f2cbf" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608128484697_650755_90408" xmi:uuid="127aba3f-96cc-44c1-a2be-c47f669b7a69" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052945_205460_102297"/>
          <body>indicates that the "intersection plane" is directed so that it includes the referenced datum.</body>
        </ownedComment>
        <name>including</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609841792200_490067_91439" xmi:uuid="66afd331-6244-4572-a864-b3e5c7d5560a" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609841806167_101389_91441" xmi:uuid="7a89d11c-1e9a-4ee2-a717-45800025c815" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609841792200_490067_91439"/>
          <body>indicates that the "intersection plane" is directed at an angle to the referenced datum.</body>
        </ownedComment>
        <name>angular</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609841813226_369331_91442" xmi:uuid="8fb9d21f-a118-4cf5-bf69-bc92ae72485a" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609841830010_380383_91444" xmi:uuid="ee8886fa-1f2b-4215-a658-d5708a866189" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609841813226_369331_91442"/>
          <body>indicates that the "intersection plane" is directed so that it is symmetrical to the referenced datum. </body>
        </ownedComment>
        <name>symmetrical_to</name>
      </ownedLiteral>
    </packagedElement>
