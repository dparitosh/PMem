    <packagedElement xmi:id="_18_4_1_af4021f_1601394052809_917828_100669" xmi:uuid="0858456c-985b-4048-969c-198ebe847f4b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606992017469_734427_93073" xmi:uuid="4c78040b-fc98-40b1-993b-48df5e2958a5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052809_917828_100669"/>
        <body>A ComponentPathShapeElement is a type of PartShapeElement of an assembly that identifies a PartShapeElement of an occurrence of a part within this assembly. The referenced part and its PartShapeElement might be defined locally or externally.</body>
      </ownedComment>
      <name>ComponentPathShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052909_114220_101618" xmi:uuid="3ee90fd0-107a-4dcf-95bc-d88c16375797" xmi:type="uml:Generalization">
