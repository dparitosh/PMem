      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052915_851699_101787"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052951_433682_102564"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052915_851699_101787" xmi:uuid="bc682cfc-da6a-40a1-8714-cf713b92da4e" xmi:type="uml:Property">
        <visibility>private</visibility>
