    <packagedElement xmi:id="_18_4_1_91401df_1609842258110_487292_91512" xmi:uuid="be64b6c1-b883-41aa-9157-ea6429c30f17" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1609842307945_589162_91535" xmi:uuid="52d689ca-6e72-47f3-a4a3-ae56de929ba1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1609842258110_487292_91512"/>
        <body>The DirectionFeatureApplicationType is a list of indicators that is used by DirectionFeatureToleranceZone to define how the direction feature is derived from the datum. Unless otherwise specified the rules governing direction feature defined in ISO 1101 shall apply. </body>
      </ownedComment>
      <name>DirectionFeatureApplicationTypeEnum</name>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609842339559_702021_91536" xmi:uuid="fdb7346e-85dd-43c2-ac8e-9e790afa6243" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609842362889_786343_91538" xmi:uuid="a6841c47-c3e2-4641-886f-0ea9f177bb4d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609842339559_702021_91536"/>
          <body>indicates that the direction feature is directed perpendicular to the referenced datum.</body>
        </ownedComment>
        <name>perpendicular</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609842364508_931261_91539" xmi:uuid="4e70ff68-1fa9-4738-afb5-2b04116207d7" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609842384168_361275_91541" xmi:uuid="f8c9b4a3-93ce-4af8-9b9b-9701e2cef490" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609842364508_931261_91539"/>
          <body>indicates that the direction feature is directed parallel to the referenced datum.</body>
        </ownedComment>
        <name>parallel</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609842389728_808189_91542" xmi:uuid="f6bc18cc-2cdc-4367-bd5d-7512ff319930" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609842400086_462891_91544" xmi:uuid="3d61feab-4baa-4d62-bb1d-282068c67ca2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609842389728_808189_91542"/>
          <body>indicates that the direction feature is inclined to the referenced datum.</body>
        </ownedComment>
        <name>inclined</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1609842406503_271292_91545" xmi:uuid="ffccba6a-ac39-46a4-a08d-656bf287d53d" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1609842429158_167509_91547" xmi:uuid="30e821ad-7e91-4e1f-b24a-ab69ef72bc1e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1609842406503_271292_91545"/>
          <body>indicates that the direction feature is given by the surface of the toleranced feature.</body>
        </ownedComment>
        <name>runout</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052939_469942_102094" xmi:uuid="be78c8d7-bb7a-41bf-9a46-ca8616a3013d" xmi:type="uml:Association">
