          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052857_233993_101036"/>
          <body>indicates that reciprocity requirement applies in accordance with ISO 2692 unless otherwise specified; &lt;note&gt;The symbol for reciprocity requirement is Ⓡ.&lt;/note&gt;</body>
        </ownedComment>
        <name>reciprocity_requirement</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052910_993421_101655" xmi:uuid="4c0a2b67-a47a-4e05-a5b5-a09f71b9524a" xmi:type="uml:EnumerationLiteral">
