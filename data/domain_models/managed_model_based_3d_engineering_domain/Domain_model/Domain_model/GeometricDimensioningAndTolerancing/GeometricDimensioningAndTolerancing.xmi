      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052955_39776_102686" xmi:uuid="a401d908-c2f7-4996-9dc5-3fc23deb5f3d" xmi:type="uml:EnumerationLiteral">
