      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052951_433682_102564" xmi:uuid="f4aaa98b-c7b5-4626-9e60-484712a7c745" xmi:type="uml:Property">
