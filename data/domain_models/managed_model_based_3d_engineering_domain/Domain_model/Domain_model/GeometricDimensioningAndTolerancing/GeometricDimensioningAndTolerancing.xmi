      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052883_233120_101246" xmi:uuid="902310ff-aa51-4987-9544-0772e13899ca" xmi:type="uml:EnumerationLiteral">
