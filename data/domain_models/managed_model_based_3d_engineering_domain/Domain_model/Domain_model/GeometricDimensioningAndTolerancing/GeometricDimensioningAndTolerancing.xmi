          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052947_140036_102400"/>
          <body>the path along which the ThicknessSize is applied or measured. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>UsedPath</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052814_844718_100815"/>
