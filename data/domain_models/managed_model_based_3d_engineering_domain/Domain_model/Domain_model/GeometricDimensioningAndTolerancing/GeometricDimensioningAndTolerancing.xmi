      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052815_19326_100828" xmi:uuid="465796ab-83fd-4e37-a2fe-a79d842c85f1" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608130555024_59715_90489" xmi:uuid="c6ef1345-f2ab-458c-a0fe-01039f344be1" xmi:type="uml:Comment">
