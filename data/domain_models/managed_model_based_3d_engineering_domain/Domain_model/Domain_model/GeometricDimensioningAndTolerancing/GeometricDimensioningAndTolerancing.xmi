    <packagedElement xmi:id="_18_4_1_af4021f_1601394052887_487184_101389" xmi:uuid="d98f580f-f981-46de-96f1-e13da312b158" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608106643496_351079_90364" xmi:uuid="da8f876b-20d0-4360-b6a1-2b4e22fe60e0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052887_487184_101389"/>
        <body>A FlatnessTolerance is a type of GeometricTolerance that constraints the form of a planar feature. Unless otherwise specified, the rules governing flatness tolerance defined in ISO 1101 shall apply. &lt;note&gt;Alternatively flatness tolerance can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>FlatnessTolerance</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052908_216980_101577" xmi:uuid="be0a7c59-ce70-4606-8b42-ccb490f89133" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052706_675762_100557" xmi:uuid="d99ee2a0-e0f3-45bb-85b6-c8877a40fb33" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606992415100_414713_93089" xmi:uuid="aff9bbba-ada1-4bb5-8a5e-630a15001bf1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052706_675762_100557"/>
        <body>A CompositeGroupShapeElement is a type of CompositeShapeElement in which the composite may be thought of as a group of individual ShapeElement in which any property that is applied to the CompositeGroupShapeElement is applied to each of the constituent ShapeElements on an individual basis.</body>
      </ownedComment>
      <name>CompositeGroupShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052941_882049_102149" xmi:uuid="70131bc2-bb91-49a0-990f-28fd87cd91fd" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052943_13523_102246"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1628685846590_355682_92571" xmi:uuid="da9a37b5-3cdd-48af-b41a-6b81bca3de5a" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_91401df_1628685846590_364523_92572"/>
