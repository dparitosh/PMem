      <ownedAttribute xmi:id="_18_4_1_91401df_1697100360943_938543_148916" xmi:uuid="99bbbeb0-4ed2-4642-809c-bd5dd3838569" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1697100360947_37442_148918" xmi:uuid="b2e74a19-63bf-43c2-abc2-28c2d1cf6dbb" xmi:type="uml:Comment">
