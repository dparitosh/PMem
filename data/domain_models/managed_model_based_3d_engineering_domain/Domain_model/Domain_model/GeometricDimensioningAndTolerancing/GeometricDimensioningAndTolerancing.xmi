        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052951_327171_102539"/>
        <body>The GeometricToleranceModifier is the list of modifiers that is used by GeometricTolerance. </body>
      </ownedComment>
      <name>GeometricToleranceModifierEnum</name>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052855_680730_100988" xmi:uuid="e2506a51-7f63-4944-8533-63f28472f6e8" xmi:type="uml:EnumerationLiteral">
