          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052944_201914_102282"/>
          <body>indicates that common zone applies in accordance with ISO 1101 unless otherwise specified; &lt;note&gt;The symbol for common zone is CZ.&lt;/note&gt;</body>
        </ownedComment>
        <name>common_zone</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052703_101460_100471" xmi:uuid="7f3acece-b81d-4c1e-b684-a2f3efef2b7a" xmi:type="uml:EnumerationLiteral">
