    <packagedElement xmi:id="_18_4_1_91401df_1628683389691_681760_92212" xmi:uuid="59732109-3799-4142-bdd6-3510ee1179b9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1628683486276_548553_92258" xmi:uuid="5defb982-b245-42e5-b72f-7318294f3bf4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1628683389691_681760_92212"/>
        <body>A DerivedShapeElement is a type of ShapeElement. It represents a shape element derived from one or more other ShapeElements. &lt;example&gt;The centre plane of an ideal slot is a DerivedShapeElement, that is derived from a symmetrical feature of the shape of a part. Its shape is uniquely specified without further geometric description.&lt;/example&gt;</body>
      </ownedComment>
      <name>DerivedShapeElement</name>
      <generalization xmi:id="_18_4_1_91401df_1628683410164_387238_92257" xmi:uuid="2b15841a-4daa-406d-982f-8e6487c25824" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
      </generalization>
      <generalization xmi:id="_18_4_1_91401df_1628683733389_401245_92380" xmi:uuid="46d49c88-79d8-4ab1-aac7-7b2050f7b876" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052948_181723_102443"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_91401df_1628683532684_164698_92259" xmi:uuid="2cf71f95-798c-41a3-a4fe-4e888e66b178" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1628683621121_841931_92264" xmi:uuid="f69d01d6-361d-47a5-9ed6-f035b3fdec04" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1628683532684_164698_92259"/>
          <body>the set of instances of ShapeElement from which the DerivedShapeElement is derived. &lt;note&gt;Cardinality of this set depends on the kind of derivation.&lt;/note&gt;</body>
        </ownedComment>
        <name>DerivedFrom</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
