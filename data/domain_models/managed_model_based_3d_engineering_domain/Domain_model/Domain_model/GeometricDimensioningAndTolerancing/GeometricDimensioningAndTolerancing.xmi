    <packagedElement xmi:id="_18_4_1_af4021f_1601394052907_429248_101554" xmi:uuid="9d6451cf-4c27-44d0-96cd-ff5a59b05580" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1607000054258_635805_93561" xmi:uuid="acac268e-e7fe-4217-bce1-81cf3f029f2f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052907_429248_101554"/>
        <body>A DatumReferenceModifierWithValue is an association between a ModifierType and a ModifierValue that defines the specific boundary size of the associated feature for establishing a datum. In the case of a circular, cylindrical, or spherical boundary type the value represents the diameter of the boundary. In the case of a distance the value represents the distance between two parallel planes. &lt;note&gt;When used for ASME Y14.5 a DatumReferenceModifierWithValue represents the datum feature simulator boundary.&lt;/note&gt;</body>
      </ownedComment>
      <name>DatumReferenceModifierWithValue</name>
      <ownedRule xmi:id="_18_4_1_91401df_1677072279032_223735_154020" xmi:uuid="3a459c05-d7cb-4268-b382-d0dab99a4c45" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1677072362307_559179_154027" xmi:uuid="752c3fd8-fa1c-477c-bc0e-ce50bb788bd0" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_91401df_1677072379792_21985_154028" xmi:uuid="d9ea2087-f30a-4c08-bd99-d26273ebff24" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//DatumReferenceModifierWithValue/ModifierValue"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='length'"&gt;(DatumReferenceModifierWithValue &lt;sch:value-of select="$uid"/&gt;) The unit of ModifierValue shall be a length measure unit. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1677072315211_974279_154024" xmi:uuid="b2507614-f5de-43f1-8fbc-d7bb6686719f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1677072279032_223735_154020"/>
          <body>the unit of ModifierValue shall be a length measure unit. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052907_429248_101554"/>
        <specification xmi:id="_18_4_1_91401df_1677072279032_146255_154021" xmi:uuid="3af5cdc0-57a3-46e6-8e52-ce33cbc9730e" xmi:type="uml:OpaqueExpression">
          <body>self.ModifierValue.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value='length' </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052937_284948_102049" xmi:uuid="f17bab1c-f2ab-43ef-9ad7-9fe716232b4e" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052859_588038_101072"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052948_596224_102428" xmi:uuid="1006cea4-47c7-45d7-9ff3-5252e8e97934" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1607000100074_199083_93562" xmi:uuid="3d1d3968-b672-4acd-a044-af082f82173a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052948_596224_102428"/>
          <body>specifies the role of the DatumReferenceModifierType for the DatumReferenceModifierWithValue.</body>
        </ownedComment>
        <name>ModifierType</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052704_848554_100499"/>
        <aggregation>composite</aggregation>
