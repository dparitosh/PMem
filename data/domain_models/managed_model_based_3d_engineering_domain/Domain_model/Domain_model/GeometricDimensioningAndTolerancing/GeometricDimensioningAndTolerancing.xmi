    <packagedElement xmi:id="_18_4_1_af4021f_1601394052811_522789_100710" xmi:uuid="b52df638-091f-48c7-8828-1317d295f950" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1608111577840_900922_95081" xmi:uuid="43065f6f-f2eb-45d2-85c6-ba6a66dfe735" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052811_522789_100710"/>
        <body>The AngleRelatorEnum type is an identification of an angle. This angle is one of a set of angles created by: &lt;ul&gt; &lt;li&gt;the intersection of two ShapeElements; &lt;/li&gt; &lt;li&gt;the virtual intersection formed by extensions of two ShapeElements; &lt;/li&gt; &lt;li&gt;the boundaries of a single angular ShapeElement. &lt;/li&gt; &lt;/ul&gt;</body>
      </ownedComment>
      <name>AngleRelatorEnum</name>
      <isAbstract>true</isAbstract>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052810_934937_100702" xmi:uuid="6bb4cc64-cd68-44f6-b444-e0217fcf368a" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608111556898_771352_95080" xmi:uuid="c952ad38-dea8-4ed4-9548-290b0ff8fde3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052810_934937_100702"/>
          <body>the numerical measure of the angles is equal at the point of intersection between two ShapeEements.</body>
        </ownedComment>
        <name>equal</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052733_216766_100617" xmi:uuid="06fe7e52-0c3c-4a60-9e40-50f86cb7e7bf" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608111592487_744976_95082" xmi:uuid="558a05b4-0b1b-4fbe-9c43-08962b60da1f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052733_216766_100617"/>
          <body>the numerical measure of the selected angle at the point of intersection between two ShapeElements is the larger absolute value.</body>
        </ownedComment>
        <name>large</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052855_501745_100981" xmi:uuid="0314baae-39ee-4e7a-b7e4-58743fcc8ce2" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608111635894_896593_95083" xmi:uuid="185e06df-4bd2-4348-8e9c-d2f18e07a2b7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052855_501745_100981"/>
          <body>the numerical measure of the selected angle at the point of intersection between two ShapeElements is the smaller absolute value. &lt;example&gt; The Figure &lt;caption&gt;Single angular shape element&lt;/caption&gt; illustrates a type of single angular ShapeElement. See Figure &lt;caption&gt;AngularLocation&lt;/caption&gt; for types of intersections of ShapeElements. &lt;/example&gt; &lt;figure&gt;&lt;name&gt;SingleAngularShapeElement.gif&lt;/name&gt;Single angular shape element&lt;/figure&gt;</body>
        </ownedComment>
        <name>small</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052852_453263_100898" xmi:uuid="b5487314-6ba4-441d-84c7-8b4863bc642f" xmi:type="uml:Class">
      <name>Nominal3dDerivedFeatureSelect</name>
