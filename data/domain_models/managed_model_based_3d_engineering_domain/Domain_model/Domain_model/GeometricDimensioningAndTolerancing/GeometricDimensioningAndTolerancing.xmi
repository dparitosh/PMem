      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052853_184655_100930" xmi:uuid="cd43b00e-e106-45e5-999c-700661d6063d" xmi:type="uml:EnumerationLiteral">
