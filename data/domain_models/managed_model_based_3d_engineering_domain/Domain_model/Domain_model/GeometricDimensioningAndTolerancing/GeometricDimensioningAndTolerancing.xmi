          <body>not (self.FirstUnitSize.oclIsUndefined()) implies ((self.FirstUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'length') or (self.FirstUnitSize.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'plane angle'))</body>
