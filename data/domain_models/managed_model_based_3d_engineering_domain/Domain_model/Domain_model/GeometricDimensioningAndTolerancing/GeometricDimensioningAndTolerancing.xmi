    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052884_552559_101290" xmi:uuid="9cac359d-9c6b-488e-86d2-508374787218" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606999811549_979286_93554" xmi:uuid="e486b37d-c2a6-46f2-ad28-7ab979555b33" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052884_552559_101290"/>
        <body>A DatumFeature is a type of ShapeElement on the boundary of the shape of a product. Unless otherwise specified, the rules governing datum feature defined in ISO 5459 shall apply. &lt;note&gt;Alternatively datum feature can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>DatumFeature</name>
      <ownedRule xmi:id="_18_4_1_91401df_1649680682638_852438_147232" xmi:uuid="2a2bddaf-4888-4a27-96dd-15440e4ebc43" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1651679042841_87808_147959" xmi:uuid="2cc6a4d7-ef1e-4b5a-b728-89b35cfd677b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651679094003_915614_147960" xmi:uuid="9fa5c201-5071-4261-82cc-f4378f5e0f02" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='DatumFeature']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="uidRef" value="./OfDatum/@uidRef"/&gt; &lt;sch:assert test=" not (($uidRef = following::ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum/@uidRef) or ($uidRef =preceding::ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum/@uidRef))"&gt; (DatumFeature &lt;sch:value-of select="$uid"/&gt;) The OfDatum shall be unique within a population of DatumFeature OfDatum=$uidRef. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1649680840270_765290_147240" xmi:uuid="9c9dacb0-6954-4d74-a270-0b1da41cada1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1649680682638_852438_147232"/>
          <body>the OfDatum shall be unique within a population of DatumFeature.</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052884_552559_101290"/>
        <specification xmi:id="_18_4_1_91401df_1649680682638_540848_147233" xmi:uuid="99d83ff0-5106-4b89-ab41-0c7156d725b0" xmi:type="uml:OpaqueExpression">
          <body>DatumFeature::allInstances()-&gt;isUnique(OfDatum)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052855_105112_100977" xmi:uuid="3fcd6865-24cb-4609-b46d-a9bf2bf7be4d" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052946_619052_102358" xmi:uuid="f7e23922-a019-41ef-ac19-5ff4654353c8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606999825435_875364_93555" xmi:uuid="bae070fc-f4c1-4067-9c6d-992f6d87ed12" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052946_619052_102358"/>
          <body>the Datum to which the DatumFeature belongs.</body>
        </ownedComment>
        <name>OfDatum</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052882_464614_101226"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052939_469942_102094"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052943_408434_102253" xmi:uuid="77b5f33e-18e7-4735-a157-0999b2ee583c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_af4021f_1601394052951_462794_102567" xmi:uuid="8f89767e-f5bd-4b26-bcd7-43b51798147c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052943_408434_102253"/>
          <body>defines if the ShapeElement is part to the definition of the overall shape of the AssemblyViewRelationship, BreakdownElementView, IndividualPartView, Occurrence, PartView, ProductConfiguration, ShapeFeatureDefinition or another ShapeElement. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>ProductDefinitional</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#BOOLEAN"/>
        <lowerValue xmi:id="_18_4_1_af4021f_1601394052912_572959_101700" xmi:uuid="937e1686-5fcc-4dd1-8843-b9842161073f" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <defaultValue xmi:id="_18_4_1_af4021f_1601394052932_950426_101848" xmi:uuid="df45cccf-12f7-433e-a63e-01be84d50283" xmi:type="uml:LiteralBoolean">
          <value>true</value>
        </defaultValue>
        <redefinedProperty href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417194056_640914_28908"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052950_739368_102529" xmi:uuid="9d5450fd-9ac3-4c70-867f-c84e3acb8915" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052702_529377_100453"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052910_951163_101640"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052702_529377_100453" xmi:uuid="04bdd015-48dc-4558-bffa-5b14db6bd833" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052882_464614_101226"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052950_739368_102529"/>
