    <packagedElement xmi:id="_18_4_1_af4021f_1601394052887_827542_101374" xmi:uuid="a28783b9-98fb-45c5-851f-cd0bfbc3d3ae" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608111152450_11678_95067" xmi:uuid="6409f507-2623-41b7-ba8e-4b5a877fb67e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052887_827542_101374"/>
        <body>A ToleranceZone is a type of ShapeElement that represents a tolerance zone as defined in ISO 1101. A ToleranceZone is the region within which the toleranced feature shall be defined. The characteristics of the region are specified by the way the toleranced feature is dimensioned. &lt;example&gt;A geometric location tolerance applied to a hole defines a ToleranceZoneType referenced by FormType.&lt;/example&gt;</body>
      </ownedComment>
      <name>ToleranceZone</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052811_493048_100735" xmi:uuid="308e0d50-fe9a-4957-88d5-030d4a4b089a" xmi:type="uml:Generalization">
        <general href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052931_523821_101841" xmi:uuid="242df489-d1c8-43de-be11-837d95080c52" xmi:type="uml:Property">
