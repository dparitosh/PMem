      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052705_476763_100551" xmi:uuid="c93f53b0-77af-4397-99a2-9fa769c52c5f" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052885_467261_101298"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052936_848409_102035"/>
