          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052858_344891_101056"/>
          <body>the occurrence of a part.</body>
        </ownedComment>
        <name>Location</name>
        <visibility>public</visibility>
        <type href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193154_583949_23682"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052730_495908_100570" xmi:uuid="f7ecb9fe-aadd-4d64-ae42-ac2f10cd213f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606992064324_930298_93075" xmi:uuid="8460d8eb-8b6d-44b7-abc6-3bbdc3ad0b90" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052730_495908_100570"/>
          <body>the locally or externally defined ShapeElement. In the case that it is externally defined, only the id of the externally defined ShapeElement is provided.</body>
        </ownedComment>
