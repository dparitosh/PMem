            <body>&lt;sch:rule context="//ShapeElement/StartFeatures/ShapeElement"&gt; &lt;sch:let name="uidRef" value="@uidRef"/&gt; &lt;sch:let name="uid" value="../../@uid"/&gt; &lt;sch:assert test=" //ShapeElement[@uid=$uidRef]/ProductDefinitional='true'"&gt; (BetweenShapeElement &lt;sch:value-of select="$uid"/&gt;) all StartFeatures shall be definitional &lt;sch:value-of select="$uidRef"/&gt;=&lt;sch:value-of select="//ShapeElement[@uid=$uidRef]/ProductDefinitional"/&gt;. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
