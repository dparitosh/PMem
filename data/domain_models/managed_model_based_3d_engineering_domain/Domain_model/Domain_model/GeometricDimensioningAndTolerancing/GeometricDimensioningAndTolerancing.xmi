    <packagedElement xmi:id="_18_4_1_af4021f_1601394052705_703252_100543" xmi:uuid="be7b4d65-267f-427d-9561-977a7d15aa09" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606986495409_679086_91038" xmi:uuid="ccb9ae2c-0ae9-424d-bf78-fb72f30744a7" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052705_703252_100543"/>
        <body>An AffectedPlaneToleranceZone is a type of DirectedOrOrientedToleranceZone whose geometric representation is included in a plane that intersects the feature being toleranced. The affected plane is the x-y plane of the placement. The line element in the tolerance zone is in the domain of the x-y plane of the placement. The x-y plane of the placement is perpendicular to the surface of the feature being toleranced along the line of intersection.</body>
      </ownedComment>
      <name>AffectedPlaneToleranceZone</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052907_170250_101547" xmi:uuid="f25b0a51-fb63-43d6-b134-e37a9280376a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052911_874476_101685"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052852_128571_100910" xmi:uuid="3d620871-1909-43fc-a444-37a01dc76935" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606986512903_506343_91039" xmi:uuid="b81df38e-11df-422f-9dc0-fd8a68697a98" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052852_128571_100910"/>
          <body>a plane which defines the elements to which the tolerance is applied.</body>
        </ownedComment>
        <name>AffectedPlane</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052953_23292_102622"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052817_925244_100863"/>
