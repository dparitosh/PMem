    <packagedElement xmi:id="_18_4_1_af4021f_1633943557216_15621_91474" xmi:uuid="ddf6e453-737d-42b7-b117-6b344db00995" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_af4021f_1633963474341_522893_91075" xmi:uuid="f9825a51-721e-4013-a728-760f44c8d487" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1633943557216_15621_91474"/>
        <body>A DatumSystemWithAssociatedModelCoordinateSystem is a type of Datum_system to represent the relation between a datum system and a model coordinate system as defined in ISO 16792. The model coordinate system is represented by an AxisPlacement that is referenced by the inherited attribute RepresentedGeometry.</body>
      </ownedComment>
      <name>DatumSystemWithAssociatedModelCoordinateSystem</name>
      <generalization xmi:id="_18_4_1_af4021f_1633943615851_820306_91519" xmi:uuid="27b3a32e-6a7d-4a66-bc3e-da0d6b2ce0d2" xmi:type="uml:Generalization">
        <ownedComment xmi:id="_18_4_1_af4021f_1633943714658_73548_91520" xmi:uuid="48c490ec-b419-454e-b67f-2ff4044b45ef" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1633943615851_820306_91519"/>
        </ownedComment>
        <general xmi:idref="_18_4_1_af4021f_1601394052887_745486_101391"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1633943753617_109297_91521" xmi:uuid="f8d5bc3e-960f-4e5a-abaf-81bce4f3d766" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_af4021f_1633943753632_944305_91523" xmi:uuid="9d2cd677-d275-4acd-ae82-102c6c40f1a5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1633943753617_109297_91521"/>
          <body> the AxisPlacement that defines the coordinate system.</body>
        </ownedComment>
        <name>RepresentedGeometry</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
        <redefinedProperty href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417194056_770309_28907"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052854_432424_100950" xmi:uuid="df999fd7-30d0-48e2-b72e-06dd485b99bf" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608109077388_283526_93897" xmi:uuid="41f6cde4-06ec-4981-81c5-4ba30d9a9c40" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052854_432424_100950"/>
        <body>A NonUniformZoneDefinition is a type of ToleranceZoneDefinition. The boundaries of a NonUniformZoneDefinition may have any shape. &lt;note&gt; Non-uniform zone is described in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>NonUniformZoneDefinition</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052909_159575_101611" xmi:uuid="898246d8-d528-4622-96b1-520544412498" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052701_467301_100423"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052934_818059_101933" xmi:uuid="e0ea5292-8003-4aab-b9fc-93d2affdd6db" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606992504032_35550_93090" xmi:uuid="91434dc8-3190-4786-a7a9-71e23f5bb443" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052934_818059_101933"/>
        <body>A CompositeUnitShapeElement is a type of CompositeShapeElement that is treated as a unit, as opposed to as a group of individual ShapeElement. &lt;example&gt;A SurfaceProfileTolerance is applied to a square cut-out that goes through a printed circuit board. The square cut-out is a CompositeUnitShapeElement that consists of the four constituent ShapeElements that correspond to the four surfaces of the cut-out.&lt;/example&gt; &lt;example&gt;A FlatnessTolerance may be applied to a CompositeUnitShapeElement to specify that the coplanar surfaces that make up the CompositeUnitShapeElement are required to fall within a common ToleranceZone. &lt;/example&gt; &lt;note&gt;Combined zone specification are described in ﻿8.2.2.1.2 of ISO 1101.&lt;/note&gt; </body>
      </ownedComment>
      <name>CompositeUnitShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052731_657805_100580" xmi:uuid="940a625b-4b7e-44ab-b90f-b2fe7c103db7" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052943_13523_102246"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1628686095828_257399_92666" xmi:uuid="e10e8103-62f7-49be-ba12-388d834e688c" xmi:type="uml:Association">
      <ownedComment xmi:id="_18_4_1_91401df_1628686138771_215136_92688" xmi:uuid="dc699156-3398-4793-a274-03076a31f650" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1628686095828_257399_92666"/>
      </ownedComment>
      <memberEnd xmi:idref="_18_4_1_91401df_1628686095828_903905_92667"/>
      <memberEnd xmi:idref="_18_4_1_91401df_1628686079837_452954_92656"/>
      <ownedEnd xmi:id="_18_4_1_91401df_1628686095828_903905_92667" xmi:uuid="3b1cdc7c-fe12-430f-b116-959ae6146f0d" xmi:type="uml:Property">
