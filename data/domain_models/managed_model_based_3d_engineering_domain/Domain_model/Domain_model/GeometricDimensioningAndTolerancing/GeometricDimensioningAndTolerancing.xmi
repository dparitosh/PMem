        <ownedComment xmi:id="_18_4_1_91401df_1628691195516_683828_93683" xmi:uuid="31e752c1-a621-4d76-90ea-6034a4533b5e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1628673616121_391752_96355"/>
          <body>the set of instances of Nominal3dFeature from which the Nominal3dDerivedFeature is derived. There shall exist at least one Nominal3dFeature for the Nominal3dDerivedFeature.</body>
        </ownedComment>
