      <ownedComment xmi:id="_18_4_1_91401df_1608111024309_923022_95051" xmi:uuid="0fb62017-3a74-4c91-8253-8c471c406f4d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052887_285449_101375"/>
        <body>A ThicknessSize is a type of DimensionalSize that represents a thickness. Use of ThicknessSize is user defined. &lt;example&gt;The remaining thickness below a blind hole might be specified as a ThicknessSize.&lt;/example&gt; &lt;example&gt;The thickness of a coating layer is a ThicknessSize.&lt;/example&gt;</body>
      </ownedComment>
      <name>ThicknessSize</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052817_686726_100879" xmi:uuid="a007cb04-8a7a-4b93-b2e1-fe91ff69741a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052703_184496_100462"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052947_140036_102400" xmi:uuid="295a2678-e461-46f4-a45a-2a1e3f30df02" xmi:type="uml:Property">
