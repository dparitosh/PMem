    <packagedElement xmi:id="_18_4_1_af4021f_1601394052947_829101_102382" xmi:uuid="26946be9-f038-46a4-9f62-9f019a2986c5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608110065131_997908_95011" xmi:uuid="7c530567-e7d2-4126-b3e8-49d20ecbe1e0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052947_829101_102382"/>
        <body>A ProjectedZoneDefinition is a type of ToleranceZoneDefinition. It specifies a condition where a ToleranceZone is projected from an element of a part. The projection is external to the part and made from one of the ends of the element for a specified length. Unless otherwise specified, the rules governing projected tolerance zone defined in ISO 1101 shall apply.</body>
      </ownedComment>
      <name>ProjectedZoneDefinition</name>
      <ownedRule xmi:id="_18_4_1_af4021f_1677162825230_208122_155072" xmi:uuid="caf51f49-e4c1-4c71-b892-a7f6dfe6ada2" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1677162867111_384835_155075" xmi:uuid="fe51a481-38c5-4f14-8b47-f6a955f1199a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1677162825230_208122_155072"/>
          <body> the unit of UnitLength shall be a length measure unit.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1677162906966_78986_155085" xmi:uuid="ff33844f-2200-452b-ab02-54eb8f213e30" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1677162921262_732074_155086" xmi:uuid="7539d895-6b6a-4d4e-8e88-69f5b61da1ea" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ToleranceZoneDefinition[substring-after(@xsi:type,':')='ProjectedZoneDefinition']/ProjectionLength"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='length'"&gt;(ProjectedZoneDefinition &lt;sch:value-of select="$uid"/&gt;) The unit of ProjectionLength shall be a length measure unit. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052947_829101_102382"/>
        <specification xmi:id="_18_4_1_af4021f_1677162825230_538031_155073" xmi:uuid="d7d33cf3-7a9b-4e8c-ab07-9593e45a66f6" xmi:type="uml:OpaqueExpression">
          <body>self.ProjectionLength.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value ='length'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052935_173539_101967" xmi:uuid="9b7117f5-7fde-4e88-abd1-ad9b9a4e85bd" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052701_467301_100423"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052907_872265_101545" xmi:uuid="c4c758c9-d6b9-4801-a235-2f8749c0005d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608110075051_295845_95012" xmi:uuid="815ce78e-4ead-4649-b9ab-87f7cafcb0df" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052907_872265_101545"/>
          <body>the ShapeElement from which the tolerance zone is projected.</body>
        </ownedComment>
        <name>ProjectionEnd</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
