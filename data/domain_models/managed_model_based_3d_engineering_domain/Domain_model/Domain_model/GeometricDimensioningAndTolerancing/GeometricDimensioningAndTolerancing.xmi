          <body>indicates that any cross section applies in accordance with ISO 1101 unless otherwise specified; &lt;note&gt;The symbol for any cross section is ACS.&lt;/note&gt;</body>
        </ownedComment>
        <name>any_cross_section</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052940_325340_102130" xmi:uuid="1950391b-bd6f-4423-8418-7e909dcabbd1" xmi:type="uml:EnumerationLiteral">
