    <packagedElement xmi:id="_18_4_1_91401df_1628686700983_934104_92881" xmi:uuid="3c83221a-54a7-4f7a-a909-63736f9cc5e9" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1628686854470_15768_92971" xmi:uuid="b82cfdc8-57ce-48b3-9500-a3ed73e974ad" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1628686700983_934104_92881"/>
        <body>A ParallelOffset is a type of DerivedShapeElement that is located at a constant distance from a related element. If the basis is two dimensional, then all associated ShapeElements (the parallel offset and the basis shape aspect) lie in some common plane. If the basis is a surface, then all ShapeElements are embedded in three-dimensional space. The ParallelOffset is formed by the offset of each point of the basis, in a direction perpendicular to the basis by the offset distance.</body>
      </ownedComment>
      <name>ParallelOffset</name>
      <generalization xmi:id="_18_4_1_91401df_1628686724288_749234_92926" xmi:uuid="b20bc5a2-9070-497d-a1a4-a629bbce14d4" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_91401df_1628683389691_681760_92212"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_91401df_1628686738743_469676_92927" xmi:uuid="4c23884b-33aa-41f1-b96f-c62b3ab04574" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1628686738743_730869_92929" xmi:uuid="24dedd4e-3c21-4296-b586-5b592de40e3f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1628686738743_469676_92927"/>
          <body>an attribute inherited from the DerivedShapeElement shall be redeclared as the ShapeElement for the ParallelOffset. There shall exist exactly one ShapeElement for the ParallelOffset.</body>
        </ownedComment>
        <name>DerivedFrom</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
        <association xmi:idref="_18_4_1_91401df_1628686748300_876436_92937"/>
        <redefinedProperty xmi:idref="_18_4_1_91401df_1628683532684_164698_92259"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052857_857139_101038" xmi:uuid="3d976038-ac8b-4d8f-94a6-c2b0ab8ee353" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606999682963_952812_93550" xmi:uuid="88057986-9e94-4217-84eb-cc6cc43740af" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052857_857139_101038"/>
        <body>A CurvedSize is a type of DimensionalSize that is the tolerance on a dimension for a curve measured along the entire path of a curve.</body>
      </ownedComment>
      <name>CurvedSize</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052701_351722_100433" xmi:uuid="8a62112e-3a88-43b8-a47a-4e665fb439c0" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052703_184496_100462"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052883_395739_101251" xmi:uuid="3f011583-9db3-43ee-9d9d-6ea8472f533d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606996510499_946527_93115" xmi:uuid="aa6542f1-bd85-4a30-b538-2b1b358f5059" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052883_395739_101251"/>
        <body>A ConnectedFaceSet is a type of DetailedGeometricModelItem that is a set of faces such that the domain of the faces together with their bounding edges and vertices is connected.</body>
      </ownedComment>
      <name>ConnectedFaceSet</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052916_197097_101829" xmi:uuid="92191cf8-88dd-4675-9c84-d49ffc9e20f3" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193072_543741_23516"/>
      </generalization>
      <generalization xmi:id="_18_4_1_af4021f_1601394052915_779445_101802" xmi:uuid="d2d6bebc-6801-4269-8e55-8603deecaa34" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052905_737518_101477"/>
      </generalization>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1628686445017_75211_92787" xmi:uuid="3f4af0d5-bf7c-4cbd-9294-ca8c35715ac6" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1628686543097_595879_92833" xmi:uuid="6a8f286d-07e5-4017-bd9c-e9cf7dd8f18c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1628686445017_75211_92787"/>
        <body>A GeometricContact is a type of DerivedShapeElement that represents the common contact region between two ShapeElements. The involved ShapeElements shall not intersect with each other.</body>
      </ownedComment>
      <name>GeometricContact</name>
      <generalization xmi:id="_18_4_1_91401df_1628686473660_609118_92832" xmi:uuid="3a802c53-4a7c-407a-bb26-45bc137e77ef" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_91401df_1628683389691_681760_92212"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_91401df_1628686569907_234359_92846" xmi:uuid="ce1db488-f63d-4fca-b80b-f400ddbd6aec" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1628686569907_769352_92848" xmi:uuid="1fb9de96-98d3-4615-8a48-f8b88619871a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1628686569907_234359_92846"/>
          <body>an attribute inherited from the DerivedShapeElement shall be redeclared as the ShapeElement for the GeometricContact. There shall exist exactly two ShapeElements for the GeometricContact.</body>
        </ownedComment>
        <name>DerivedFrom</name>
        <visibility>public</visibility>
        <type href="../ShapeAssociationAndStructure/ShapeAssociationAndStructure.xmi#_18_4_1_e120334_1499417193242_442446_23839"/>
