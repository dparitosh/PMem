    <packagedElement xmi:id="_18_4_1_af4021f_1601394052939_717975_102090" xmi:uuid="9b348e5e-83ab-4ca3-9071-e21bba866bb6" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608108682647_610708_93867" xmi:uuid="c29ffa6a-2051-47d2-8180-af4f53958499" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052939_717975_102090"/>
        <body>A LineProfileTolerance is a type of GeometricTolerance that specifies the definition of a uniform boundary along the true profile within which the elements of the toleranced surface shall lie. The tolerance zone established by a LineProfileTolerance is two-dimensional. Unless otherwise specified, the rules governing profile tolerance defined in ISO 1101 shall apply. &lt;note&gt;Alternatively profile tolerance of a line can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>LineProfileTolerance</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052955_587315_102684" xmi:uuid="5cdb715d-c0d5-4855-99ac-f8333fedfc26" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052936_895137_102029"/>
      </generalization>
      <generalization xmi:id="_18_4_1_af4021f_1601394052855_115870_100968" xmi:uuid="9d692307-46ab-48e4-b70a-0cc58970d588" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052854_124832_100951" xmi:uuid="0db87805-7e33-4b6f-bf47-976d1b6ea2c2" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608108712047_255474_93868" xmi:uuid="ed2f6d21-1e59-400c-9175-e2b466f2ddc8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052854_124832_100951"/>
          <body>specifies the role of the DatumSystem for the LineProfileTolerance. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>DatumSystem</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052887_745486_101391"/>
