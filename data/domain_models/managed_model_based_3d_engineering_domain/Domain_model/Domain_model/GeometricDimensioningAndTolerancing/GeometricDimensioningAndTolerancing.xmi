      <ownedComment xmi:id="_18_4_1_91401df_1614331228295_223613_90835" xmi:uuid="88ec8afc-a6ee-46a9-8ce7-2ea7f9d11ad7" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052816_963902_100853"/>
        <body>A Nominal3dDerivedFeature is a type of Nominal3dFeature that represents a three-dimensional nominal derived feature.</body>
      </ownedComment>
      <name>Nominal3dDerivedFeature</name>
