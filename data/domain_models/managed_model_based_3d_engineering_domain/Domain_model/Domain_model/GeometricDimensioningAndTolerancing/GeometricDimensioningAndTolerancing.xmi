      <ownedComment xmi:id="_18_4_1_91401df_1606986581001_227923_92053" xmi:uuid="166240fa-e48e-426a-b72c-46d85cf8fccd" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052940_915823_102139"/>
        <body>An AllAroundShapeElement is a type of CompositeShapeElement that represents the concept of "all around" as defined in ISO 1101. &lt;note&gt;Alternatively all around can be used according to the specifications given in ASME Y14.5&lt;/note&gt;</body>
      </ownedComment>
      <name>AllAroundShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052811_571917_100734" xmi:uuid="30d18312-1b90-4c70-9205-bc0cd7c8b07e" xmi:type="uml:Generalization">
