          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052940_325340_102130"/>
          <body>indicates that free state applies in accordance with ISO 10579 unless otherwise specified; &lt;note&gt;The symbol for free state is Ⓕ.&lt;/note&gt;</body>
        </ownedComment>
        <name>free_state</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_af4021f_1601394052944_201914_102282" xmi:uuid="45102a54-3047-46d4-82dd-8a275c387e03" xmi:type="uml:EnumerationLiteral">
