    <packagedElement xmi:id="_18_4_1_af4021f_1601394052883_104371_101243" xmi:uuid="a0bf0512-462b-4f1e-abfd-522eecd3871e" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606990625538_296172_93029" xmi:uuid="36f9f38f-a107-4f75-871b-f70b683d241a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052883_104371_101243"/>
        <body>A BetweenShapeElement is a type of ContinuousShapeElement where some of the composing members are marked as forming elements of the borders of the continuous region.</body>
      </ownedComment>
      <name>BetweenShapeElement</name>
      <ownedRule xmi:id="_18_4_1_91401df_1649682800640_626769_149241" xmi:uuid="45157f21-b276-46b5-a33e-9e7372df679b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1651656592752_927204_147676" xmi:uuid="251a82a2-0d01-4259-974d-0774586f309a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651656606128_328240_147677" xmi:uuid="fc0a917e-fc9f-44a8-bee3-cd190a82e715" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement/EndFeatures/ShapeElement"&gt; &lt;sch:let name="uidRef" value="@uidRef"/&gt; &lt;sch:let name="uid" value="../../@uid"/&gt; &lt;sch:assert test=" //ShapeElement[@uid=$uidRef]/ProductDefinitional='true'"&gt; (BetweenShapeElement &lt;sch:value-of select="$uid"/&gt;) all EndFeatures shall be definitional &lt;sch:value-of select="$uidRef"/&gt;=&lt;sch:value-of select="//ShapeElement[@uid=$uidRef]/ProductDefinitional"/&gt;. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_91401df_1649682822379_992100_149244" xmi:uuid="25380017-fc82-4e35-8333-59c5f223d272" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1649682800640_626769_149241"/>
          <body>all EndFeatures shall be definitional.</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052883_104371_101243"/>
