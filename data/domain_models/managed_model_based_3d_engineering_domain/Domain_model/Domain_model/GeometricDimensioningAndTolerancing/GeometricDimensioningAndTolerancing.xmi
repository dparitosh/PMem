    <packagedElement xmi:id="_18_4_1_af4021f_1601394052949_358758_102473" xmi:uuid="cda95e10-fe41-48d4-8095-fa1f838ba355" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052946_721255_102335"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052941_677415_102142"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052946_721255_102335" xmi:uuid="b717d368-47d9-49f3-91e5-4d8f0844832d" xmi:type="uml:Property">
