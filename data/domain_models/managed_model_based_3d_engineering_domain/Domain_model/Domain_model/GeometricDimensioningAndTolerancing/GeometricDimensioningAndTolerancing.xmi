        <annotatedElement xmi:idref="_18_4_1_91401df_1628685969158_484195_92609"/>
        <body>A GeometricAlignment is a type of DerivedShapeElement that defines a planar or linear feature that requires two or more features lying in the same plane or along the same line.</body>
      </ownedComment>
      <name>GeometricAlignment</name>
      <generalization xmi:id="_18_4_1_91401df_1628685993458_624561_92654" xmi:uuid="31482abc-232a-4463-9e0b-ded33b8c0b0f" xmi:type="uml:Generalization">
