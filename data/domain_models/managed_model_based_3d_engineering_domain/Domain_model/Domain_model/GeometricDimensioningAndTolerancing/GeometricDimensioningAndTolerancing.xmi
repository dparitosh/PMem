    <packagedElement xmi:id="_18_4_1_af4021f_1601394052885_749485_101322" xmi:uuid="06efa1c9-8786-43c4-8351-76c92c642a0e" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608109110334_139979_93898" xmi:uuid="7e5d58d9-d929-42e6-9525-87050f1d6764" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052885_749485_101322"/>
        <body>An OrientedToleranceZone is a type of ToleranceZoneWithDatum that represents an "orientation plane" for a geometric tolerance as defined in ISO 1101.</body>
      </ownedComment>
      <name>OrientedToleranceZone</name>
      <ownedRule xmi:id="_18_4_1_91401df_1614679337355_63448_91792" xmi:uuid="1c779ea0-8521-4d04-bd20-3d8cfa938a4b" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_91401df_1614679375881_284833_91796" xmi:uuid="3162be69-48a7-41f8-ba0a-e209b475b5f0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1614679337355_63448_91792"/>
          <body>an angle value shall only be specified if and only if the orientation is of type angular.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1651670028158_639295_147779" xmi:uuid="6e5502ef-36ff-4c51-bd11-decab84ebf8d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1651670038797_6310_147780" xmi:uuid="59043957-ff0f-41cd-8d79-965ca906c47b" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='OrientedToleranceZone']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="(./Orientation != 'angular' and not(./Angle)) or (./Orientation = 'angular' and ./Angle)"&gt; (OrientedToleranceZone &lt;sch:value-of select="$uid"/&gt;) An angle value shall only be specified if and only if the orientation is of type angular. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052885_749485_101322"/>
        <specification xmi:id="_18_4_1_91401df_1614679337355_166139_91793" xmi:uuid="4e889409-a155-4d72-b854-c3d361ef561a" xmi:type="uml:OpaqueExpression">
          <body>self.Orientation&lt;&gt;Application_protocols::AP242::Domain_model::GeometricDimensioningAndTolerancing::OrientedToleranceZoneTypeEnum::angular xor not(self.Angle.oclIsUndefined()) </body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_af4021f_1677159054721_639947_154301" xmi:uuid="b0a73d1d-d958-4488-99a2-f4b680e55841" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_af4021f_1677159099182_153687_154306" xmi:uuid="13d41fee-9749-4335-85ca-9ecb7d88d6ab" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1677159054721_639947_154301"/>
          <body>the unit of Angle shall be a plane angle measure unit.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_af4021f_1677159158545_154758_154318" xmi:uuid="c5af3b9a-5077-431b-9fc4-37a675697427" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_af4021f_1677159139928_980879_154313" xmi:uuid="32dbd336-6453-4368-8d26-3b912eb5fc90" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='OrientedToleranceZone']/Angle"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='plane angle'"&gt;(OrientedToleranceZone &lt;sch:value-of select="$uid"/&gt;) The unit of Angle shall be a plane angle measure unit. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052885_749485_101322"/>
        <specification xmi:id="_18_4_1_af4021f_1677159054723_815541_154302" xmi:uuid="a92add00-9b90-4350-bbec-d45e1ad0ded7" xmi:type="uml:OpaqueExpression">
          <body>self.Angle.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value ='plane angle'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_af4021f_1601394052911_56031_101677" xmi:uuid="2225f57b-c859-4ec5-9583-5afa73ee6e78" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052884_216443_101275"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052704_423325_100501" xmi:uuid="9eb87229-9019-4134-840a-596f5476bda6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608109129750_55957_93899" xmi:uuid="85a5c416-5693-45f7-a48f-fa9e2e738f7c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052704_423325_100501"/>
          <body>specified the orientation of the tolerance zone in respect to the referenced datum. It is either perpendicular, parallel or angular.</body>
        </ownedComment>
        <name>Orientation</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052858_410739_101058"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052939_516373_102083"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052952_840119_102584" xmi:uuid="065e034b-2972-4448-ac5c-7da870b82364" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608109139148_414294_93900" xmi:uuid="03067805-5e2c-468e-85d4-28615cfc4b65" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052952_840119_102584"/>
          <body>specified an additional angle of the tolerance zone orientation in respect to the referenced datum. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Angle</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193283_976319_23905"/>
        <lowerValue xmi:id="_18_4_1_af4021f_1601394052855_343165_100979" xmi:uuid="bce83ba6-5c89-4f1d-8c93-845f2d34b08f" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_af4021f_1601394052731_82868_100578"/>
      </ownedAttribute>
