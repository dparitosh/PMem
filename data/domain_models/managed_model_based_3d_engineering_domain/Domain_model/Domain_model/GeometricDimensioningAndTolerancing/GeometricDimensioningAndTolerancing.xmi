          <body>specifies the AxisPlacementShapeElement for the DatumReferenceCompartment. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>StraightLineSituationFeature</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052953_23292_102622"/>
