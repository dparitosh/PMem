    <packagedElement xmi:id="_18_4_1_af4021f_1601394052700_859891_100397" xmi:uuid="9ea2693f-0ee5-4790-8a7c-7bb02f403213" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052881_333793_101178"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052888_272661_101405"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052881_333793_101178" xmi:uuid="8eac6b66-1bdb-484f-b22c-2fe2d7264908" xmi:type="uml:Property">
