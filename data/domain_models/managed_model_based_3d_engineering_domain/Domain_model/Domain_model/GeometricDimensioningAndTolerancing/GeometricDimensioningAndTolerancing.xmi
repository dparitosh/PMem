        <ownedComment xmi:id="_18_4_1_91401df_1607000406292_161318_93966" xmi:uuid="7c09cb58-e73e-4c38-8296-88cd7e550a9e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052809_880462_100664"/>
          <body>specifies the Direction for the DatumTarget. The value of this attribute need not be specified.</body>
        </ownedComment>
