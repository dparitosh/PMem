      <ownedComment xmi:id="_18_4_1_91401df_1606992365496_21736_93088" xmi:uuid="8bd659d5-c815-46ef-b466-02923ee4a506" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052943_13523_102246"/>
        <body>A CompositeShapeElement is a type of ShapeElement that is composed of two or more constituent ShapeElements.</body>
      </ownedComment>
      <name>CompositeShapeElement</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052809_947120_100663" xmi:uuid="1ca75a43-7e78-4339-90ce-e289c6a52a52" xmi:type="uml:Generalization">
