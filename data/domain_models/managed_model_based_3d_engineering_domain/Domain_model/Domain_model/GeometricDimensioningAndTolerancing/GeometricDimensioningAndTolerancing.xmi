    <packagedElement xmi:id="_18_4_1_91401df_1606901724100_754235_91772" xmi:uuid="db466f6d-00d8-4027-84cd-f1f4c2805a04" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_4_1_91401df_1614264844846_90348_91314" xmi:uuid="0680d2ec-3270-4384-b4fc-eabe40f32c39" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_91401df_1606901724100_754235_91772"/>
        <body>The IndexTypeEnum is a list of alternate data types that allows for the designation of the index filter in accordance with ISO 1101 unless otherwise specified;</body>
      </ownedComment>
      <name>IndexTypeEnum</name>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606901743197_938418_91795" xmi:uuid="25d6ea23-7a32-4116-ad79-db13e761110a" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137344644_115066_90592" xmi:uuid="445fccbb-f53e-4258-8040-ce590267b772" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606901743197_938418_91795"/>
          <body>indicates that the cutoff length nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>cutoff_length</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606901765760_938945_91797" xmi:uuid="bbd654d5-5140-4e48-9471-1ae88935d72c" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137390872_150134_90593" xmi:uuid="b1abbca8-102b-4818-830c-8c9962e997ce" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606901765760_938945_91797"/>
          <body>indicates that the cutoff UPR nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>cutoff_upr</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606902254939_978003_91846" xmi:uuid="3cc33ebb-6b1e-4a0b-a873-4762127866c4" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137438541_668816_90594" xmi:uuid="e3ecd1eb-6a7a-4311-8035-51e70076c92e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606902254939_978003_91846"/>
          <body>indicates that the ball radius nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>ball_radius</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606902273779_142079_91848" xmi:uuid="e778dfc0-20f9-4245-9daa-ef02c7ed92ad" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137452430_195870_90595" xmi:uuid="db97e857-ab6d-477a-95ad-fc2918a22a79" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606902273779_142079_91848"/>
          <body>indicates that the segment length nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>segment_length</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606902289579_5074_91850" xmi:uuid="cf3751f8-b0b8-4503-8781-2d0b2db2494e" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137467446_700636_90596" xmi:uuid="9fe8b4af-36c4-48b9-8d77-83786b426843" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606902289579_5074_91850"/>
          <body>indicates that the disc radius nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>disc_radius</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606902435187_245262_91856" xmi:uuid="96846166-a147-4fc5-bab3-61adc966cc26" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137481477_885037_90597" xmi:uuid="e3784395-d33a-42ec-8d12-94e03a81f894" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606902435187_245262_91856"/>
          <body>indicates that the wavelenght nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>wavelength</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_91401df_1606902310219_79737_91852" xmi:uuid="bb75c196-aee7-40aa-a239-5901d13f6b47" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_4_1_91401df_1608137549704_199121_90598" xmi:uuid="a194832d-3ac1-4f8f-8d87-cb6c2b885d31" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_91401df_1606902310219_79737_91852"/>
          <body>indicates that the UPR number nesting index applies in accordance with ISO 1101 unless otherwise specified.</body>
        </ownedComment>
        <name>urp_number</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_91401df_1632844665912_773723_91944" xmi:uuid="dc512a42-7c0d-4e0e-aa50-cb06450f15e4" xmi:type="uml:Association">
