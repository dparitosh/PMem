        <association xmi:idref="_18_4_1_af4021f_1601394052915_319503_101812"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052947_124366_102372" xmi:uuid="565354d4-64d5-4d08-a65f-8e19921b9a94" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1608110664342_498310_95036" xmi:uuid="09144a81-ed83-4940-a30b-9e342cd40349" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052947_124366_102372"/>
        <body>A SymmetryTolerance is a type of GeometricTolerance that is a constraint on the amount of deviation a toleranced element may have from being symmetrical to a datum. Any edge or (median) plane of the part must lie in a tolerance zone limited by two parallel lines or planes, symmetrically located with respect to a datum. Unless otherwise specified, the rules governing symmetry tolerance defined in ISO 1101 shall apply. &lt;note&gt;Alternatively symmetry tolerance can be used according to the specifications given in ASME Y14.5.&lt;/note&gt;</body>
      </ownedComment>
      <name>SymmetryTolerance</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052912_798804_101702" xmi:uuid="069b0569-0a80-476a-90bf-3b801d85fdf7" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052936_895137_102029"/>
      </generalization>
      <generalization xmi:id="_18_4_1_af4021f_1601394052854_694512_100942" xmi:uuid="20214635-9ef7-47c1-af9d-71ee1b290d29" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052786_418916_100634"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052888_272661_101405" xmi:uuid="774f3dfe-9c8f-4a27-8b78-6b7fa06e9553" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1608110684446_406133_95037" xmi:uuid="ef87c799-5d97-4ed5-8801-4549d5377628" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052888_272661_101405"/>
          <body>specifies the role of the DatumSystem for the SymmetryTolerance.</body>
        </ownedComment>
        <name>DatumSystem</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_af4021f_1601394052887_745486_101391"/>
        <association xmi:idref="_18_4_1_af4021f_1601394052700_859891_100397"/>
      </ownedAttribute>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_af4021f_1601394052944_551869_102272" xmi:uuid="5680a150-f1ed-4193-8be0-a889a7c4bc23" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_91401df_1606999861470_611780_93556" xmi:uuid="036be1b2-baf6-498f-8962-26821ee93c7e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052944_551869_102272"/>
        <body>A DatumReferenceCompartment is a type of GeneralDatumReference that represents the compartment of either the primary, secondary or tertiary datum in a feature control frame</body>
      </ownedComment>
      <name>DatumReferenceCompartment</name>
      <generalization xmi:id="_18_4_1_af4021f_1601394052939_500878_102089" xmi:uuid="4eaf6899-bfd3-4b29-a3f9-5a706904ef44" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_af4021f_1601394052887_798517_101376"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_af4021f_1601394052941_717610_102153" xmi:uuid="55cc203c-54d3-431f-9dbd-de90b8949570" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_91401df_1606999885148_460110_93557" xmi:uuid="b6569c04-202b-4d01-8d4a-d5405ad8a6ca" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_af4021f_1601394052941_717610_102153"/>
          <body>specifies the PointShapeElement for the DatumReferenceCompartment. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>PointSituationFeature</name>
