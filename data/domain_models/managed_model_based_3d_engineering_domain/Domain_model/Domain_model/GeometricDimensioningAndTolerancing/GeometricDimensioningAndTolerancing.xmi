    <packagedElement xmi:id="_18_4_1_af4021f_1601394052700_458632_100395" xmi:uuid="05747403-6a18-4242-bf46-a49b4024b6cc" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052935_265931_101993"/>
      <memberEnd xmi:idref="_18_4_1_af4021f_1601394052912_339692_101710"/>
      <ownedEnd xmi:id="_18_4_1_af4021f_1601394052935_265931_101993" xmi:uuid="0d659fbc-51ff-4980-bea2-9c777fd8e6c1" xmi:type="uml:Property">
