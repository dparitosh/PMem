    <packagedElement xmi:id="_18_4_1_e120334_1499417193144_383007_23654" xmi:uuid="0aad2c81-a060-4add-acda-3f100ed024d7" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455117868261_59386_42563" xmi:uuid="b70e29c7-1f2f-4357-8c00-2219c815d8b2" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193144_383007_23654"/>
        <body>A MatedPartRelationship is a relationship between two MatedPartAssociation objects. This relationship specifies additional information about the mating of two specific items that go into a MatingDefinition. The two MatedPartAssociation objects that are referenced by the MatedPartRelationship shall refer to the same MatingDefinition.</body>
      </ownedComment>
      <name>MatedPartRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329980982_124423_42633" xmi:uuid="7d4ec2fe-7ecd-47f4-a61d-e1fced39212a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209122208_615358_163220" xmi:uuid="214cea99-4fb3-40d1-be27-902f888af315" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209122208_455187_163221" xmi:uuid="8edf7ad5-fde3-43bf-a9b1-cc64581b638e" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//MatedPartRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related MatedPart and the relating MatedPart shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:MatedPartRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330013376_57184_42635" xmi:uuid="8afe09ad-a7f8-4dc4-a0a8-97824815a36a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329980982_124423_42633"/>
          <body>the related MatedPartAssociation and the relating MatedPartAssociation shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209122208_415326_163222" xmi:uuid="fc31a8f1-4a14-4774-84e8-59ed7d836e92" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209122208_362662_163223" xmi:uuid="d1007d26-3388-4ee8-8742-344d6e353da0" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193144_383007_23654"/>
        <specification xmi:id="_18_4_1_271a0567_1509114859699_139123_31295" xmi:uuid="595d412d-ac96-4ab5-a7a1-2d11962ea040" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
