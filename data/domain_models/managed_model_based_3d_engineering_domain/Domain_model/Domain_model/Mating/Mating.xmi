  <sysml:NestedConnectorEnd xmi:id="_18_4_1_8db01ea_1516722436283_65796_169687" xmi:uuid="35216620-fa38-013a-0464-52540000fd3c">
    <propertyPath xmi:idref="_18_4_1_8db01ea_1516722392863_194310_169001"/>
