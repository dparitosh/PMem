      <ownedComment xmi:id="_18_0_5_45e01bd_1454500822427_670590_43322" xmi:uuid="9f9b670d-7b31-4d06-ae84-d26e7abbebe1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193264_822783_23872"/>
        <body>A SurfaceWithDirection is the specification of a Surface and a Direction. The Direction defines the side of the Surface that is the material side.</body>
      </ownedComment>
      <name>SurfaceWithDirection</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194090_72693_29060" xmi:uuid="d4d14474-6361-412a-89d5-4ab47783d7c0" xmi:type="uml:Property">
