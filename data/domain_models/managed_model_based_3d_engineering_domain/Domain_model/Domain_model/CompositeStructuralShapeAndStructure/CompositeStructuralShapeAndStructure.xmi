          <annotatedElement xmi:idref="_18_4_1_290014c_1536580014333_197110_90221"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>CastStockMaterialType</name>
        <ownedRule xmi:id="_18_4_1_290014c_1536580014355_575096_90223" xmi:uuid="230c1ccc-c5b9-4092-8a69-38cca1df90d3" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676045392546_853436_170147" xmi:uuid="c763a34e-af3e-4751-9edc-672d9af982bc" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1536580014355_575096_90223"/>
            <body>cast each input enumeration value to its counterpart in the ARM enumeration.</body>
          </ownedComment>
          <name>smt</name>
          <constrainedElement xmi:idref="_18_4_1_290014c_1536580014333_197110_90221"/>
          <specification xmi:id="_18_4_1_290014c_1536580014355_254286_90224" xmi:uuid="cee5adf0-3432-4aa9-9e1e-01273cd6c5fe" xmi:type="uml:OpaqueExpression">
            <body>castedStockMaterial = if stockMaterialType = StockCategoryEnum::anisotropic_material then Anisotropic_material() elseif stockMaterialType = StockCategoryEnum::braided_assembly then Braided_assembly() elseif stockMaterialType = StockCategoryEnum::discontinuous_fiber_assembly then Discontinuous_fiber_assembly() elseif stockMaterialType = StockCategoryEnum::filament_assembly then Filament_assembly() elseif stockMaterialType = StockCategoryEnum::discontinuous_fiber_assembly then Discontinuous_fiber_assembly() elseif stockMaterialType = StockCategoryEnum::isotropic_material then Isotropic_material() elseif stockMaterialType = StockCategoryEnum::stock_core then Stock_core() else Woven_assembly() endif</body>
            <language>English</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_290014c_1536580063185_212762_90227" xmi:uuid="22a26848-d6e0-41a9-a9e4-953c41fe3662" xmi:type="uml:Port">
