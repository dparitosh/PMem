    <packagedElement xmi:id="_18_4_1_2aed05bf_1515579095426_145468_91571" xmi:uuid="056a12a5-cd0e-413f-95b6-d6a2ce8d4ca5" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515579095426_622075_91572"/>
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515579095313_905561_91505"/>
      <ownedEnd xmi:id="_18_4_1_2aed05bf_1515579095426_622075_91572" xmi:uuid="80275e35-5cff-4f6b-8182-b272fc544561" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193256_75358_23861"/>
