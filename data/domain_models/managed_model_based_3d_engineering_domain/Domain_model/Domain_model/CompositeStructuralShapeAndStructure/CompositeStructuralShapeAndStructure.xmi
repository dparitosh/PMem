        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193302_777269_23940"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8db01ea_1516893026026_24009_59833"/>
      </ownedAttribute>
