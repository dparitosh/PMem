        <type xmi:idref="_18_4_1_e120334_1499417193115_404304_23600"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194884_969504_35889" xmi:uuid="2528620f-0147-461d-b9a1-53f241457d22" xmi:type="uml:LiteralInteger"/>
