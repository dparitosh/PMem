    <packagedElement xmi:id="_18_4_1_e120334_1499417193046_873312_23458" xmi:uuid="1771a39e-414a-4e9d-a9d0-ce29d79fb1a4" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454498106024_753394_43185" xmi:uuid="2c79c798-1cb8-4185-ba6f-cd2ae40d01d5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193046_873312_23458"/>
        <body>A CompositeAssemblySequenceDefinition is a single unique sequence or layer within a CompositeAssembly. The sequence or layer contains one or more constituent parts. When more than one constituent part resides in the same sequence or layer, the constituents must not overlap. &lt;note&gt;If constituents do overlap, they must be put on separate sequence or layers.&lt;/note&gt;</body>
      </ownedComment>
      <name>CompositeAssemblySequenceDefinition</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193516_407360_25583" xmi:uuid="7e65b250-48d3-421e-88de-180b16883168" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454498123189_942557_43186" xmi:uuid="2c914aa7-963a-4744-b783-b024f60ad231" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193516_407360_25583"/>
          <body> specifies the collection of components in a single unique sequence or layer in a part. The ComponentsInSequence shall be a collection of one or more of the ComponentClassForAssemblySelect types.</body>
        </ownedComment>
        <name>ComponentsInSequence</name>
        <visibility>public</visibility>
