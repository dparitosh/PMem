      <ownedAttribute xmi:id="_18_4_1_8db01ea_1533285302100_133142_100089" xmi:uuid="f91f0014-0c5e-428f-ad85-eb5f3dd4e66e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1536246375209_710606_94577" xmi:uuid="3717007f-48a2-4f5b-a131-954cad879a71" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1533285302100_133142_100089"/>
          <body>specifies that the LaminateTable is to be interpreted as left-hand rule. The left-hand rule LaminateTable Rosettes (where a Rosette is a term used to represent the coordinate frame specifying the fiber directions) are to be interpreted according to left-hand rule as are all associated ply orientation angles. If this value is specified, then the 22 or Y-axis is oriented in the opposite direction of a 22 axis in a right-hand rule Rosette, and therefore the 11 and 33 directions are unchanged. The value of this attribute need not be specified. If this attribute is not specified then the LaminateTable Rosettes and associated ply orientation angles are to be interpreted as right-hand rule. </body>
        </ownedComment>
        <name>Handedness</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#STRING"/>
        <lowerValue xmi:id="_18_4_1_8db01ea_1533285330267_874623_100092" xmi:uuid="8329f998-7028-476f-a498-5b8d987d098c" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
