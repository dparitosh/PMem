      <ownedComment xmi:id="_18_0_5_45e01bd_1454498724182_528502_43205" xmi:uuid="e5f58926-b127-4e8e-ae68-3c9b54428c97" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193084_818476_23536"/>
        <body>An EdgeZoneShape is a type of ZoneStructuralMakeupShapeRepresentation that depicts the outline of a zone or area of a part. &lt;note&gt;An EdgeZoneShape might not be a distinguishable physical edge. It could be where a smooth transition in thickness of the part starts or stops.&lt;/note&gt;</body>
      </ownedComment>
      <name>EdgeZoneShape</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193641_419205_26569" xmi:uuid="fb7c522f-d5ca-4943-a89a-7c07d0275926" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193294_526789_23925"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193641_338996_26570" xmi:uuid="e17e1ef0-092f-4e4c-bf27-d4002893b0d7" xmi:type="uml:Property">
