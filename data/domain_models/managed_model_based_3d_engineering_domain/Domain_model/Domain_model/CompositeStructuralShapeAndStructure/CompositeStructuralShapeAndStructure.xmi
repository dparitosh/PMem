      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193921_988915_28288" xmi:uuid="95965515-6ec7-4a7b-bb3d-cf3ddb201a5b" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500314090_327607_43290" xmi:uuid="e303e4c5-f65d-435a-9be8-72c3c0069adb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193921_988915_28288"/>
          <body> specifies the list of ply material such as stabilizer, potting compound, and adhesive, applied to a ProcessedCore. The Ply identifies the area where the addedMaterial is applied. There shall exist zero or more Ply for the ProcessedCore. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>AddedMaterial</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193181_537288_23738"/>
        <isOrdered>true</isOrdered>
        <isUnique>false</isUnique>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194685_432304_33885" xmi:uuid="d3b61561-75a7-40a6-9018-f6d8eefb2e47" xmi:type="uml:LiteralInteger"/>
