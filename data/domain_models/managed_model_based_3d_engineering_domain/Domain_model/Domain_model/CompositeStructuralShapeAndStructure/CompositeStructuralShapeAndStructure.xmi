          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194092_116208_29067"/>
          <body> specifies the ordered list of ThicknessLaminateTableComponentSelect entities that make up the zone. There shall exist not less than two ThicknessLaminateTableComponentSelect for the ThicknessLaminateTable.</body>
        </ownedComment>
        <name>TableComponents</name>
        <visibility>public</visibility>
