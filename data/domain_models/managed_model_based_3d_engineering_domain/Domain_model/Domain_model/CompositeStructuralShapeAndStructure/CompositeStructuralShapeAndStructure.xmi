    <packagedElement xmi:id="_18_4_1_e120334_1499417193046_393430_23457" xmi:uuid="0ea1f7a1-f32b-4b91-9c6b-51b96292a8b7" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454498052910_359256_43182" xmi:uuid="8a963b22-3337-4e23-8365-b01966309d4b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193046_393430_23457"/>
        <body>A CompositeAssembly is a type of ConstituentPart that is made of multiple materials that are bonded together. A CompositeAssembly may be made from any combination of materials. A completed CompositeAssembly need not be a rigid shape. A CompositeAssembly may also be used as a composite part.</body>
      </ownedComment>
      <name>CompositeAssembly</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193515_209961_25576" xmi:uuid="1ba921ee-8295-4826-976a-40853ce1eef5" xmi:type="uml:Generalization">
