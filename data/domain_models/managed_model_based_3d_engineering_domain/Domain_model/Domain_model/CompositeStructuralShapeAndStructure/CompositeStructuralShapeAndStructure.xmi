    <packagedElement xmi:id="_18_4_1_e120334_1499417193138_515676_23636" xmi:uuid="4f1ceb2d-eb3d-477b-9243-aeae781e395e" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454499218090_435955_43237" xmi:uuid="095806da-3c68-41df-b734-8f36d2c142bf" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193138_515676_23636"/>
        <body>A LaminateTable is a type of PartView. A LaminateTable defines the internal constituents or structural makeup of an overall part or a specific zone, area, or point on the part. A LaminateTable may be either a PlyLaminateTable, a ZoneStructuralMakeup or a CompositeAssemblyTable. &lt;note&gt;There are two functions provided by a LaminateTable. The first is to describe the order in which the physical constituents of a laminate are assembled. This is called a PlyLaminateTable or CompositeAssemblyTable. The second is to describe the structural makeup of a specific zone, area, or point within a laminate. This is called a ZoneStructuralMakeup.&lt;/note&gt;</body>
      </ownedComment>
      <name>LaminateTable</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329599839_872587_42619" xmi:uuid="2f93b03b-e970-4edc-8fd4-ecd30c04a7da" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714997368232_955491_151622" xmi:uuid="22170c03-ca96-4d4a-bf9c-79615b90cd58" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714997368232_668550_151623" xmi:uuid="8aae9cf7-d91d-4f42-b258-3627355cba71" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//PartView[@uid and local-fn:testXsiTypeLaminateTable(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="viewContextRef" value="InitialContext/@uidRef"/&gt; &lt;sch:let name="applicationDomainRef" value="//*[@uid=$viewContextRef]/ApplicationDomain/ApplicationDomain/@uidRef"/&gt; &lt;sch:let name="proxyRef" value="//*[@uid=$viewContextRef]/ApplicationDomain/Proxy/@uidRef"/&gt; &lt;sch:assert test="(//*[@uid=$viewContextRef]/ApplicationDomain/child::* eq 'composites') or (//*[@uid=$applicationDomainRef]/SameAs/Proxy/Individual/ProxyString eq 'composites') or (//*[@uid=$proxyRef]/Individual/ProxyString eq 'composites')"&gt;(LaminateTable.WR1 &lt;sch:value-of select="$uid"/&gt;) the application domain of a LaminateTable shall be 'composites'.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459329645005_857664_42621" xmi:uuid="4d6451fd-3111-4efa-bdbb-cbb8ed2bc003" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329599839_872587_42619"/>
          <body> the application domain of a LaminateTable shall be 'composites'.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671456179466_947873_163053" xmi:uuid="c3b67cb0-02af-4438-b7dd-e93b38a04332" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671456188897_645088_163054" xmi:uuid="555805b1-a8fa-42bb-966f-a74e98d6f18b" xmi:type="uml:Comment">
            <body>WR1: SELF.InitialContext.ApplicationDomain = 'composites';</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193138_515676_23636"/>
        <specification xmi:id="_18_4_1_271a0567_1509371618608_827824_31686" xmi:uuid="756a07e4-474b-42f9-85b8-b92ee57b2eb9" xmi:type="uml:OpaqueExpression">
          <body>self.InitialContext.ApplicationDomain.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ProxyStringProxy).value = 'composites' or self.InitialContext.ApplicationDomain.PredefinedApplicationDomainEnum = Application_protocols::AP242::Domain_model::ProductDataManagement::PredefinedApplicationDomainEnum::composites or self.InitialContext.ApplicationDomain.ApplicationDomain.SameAs.Proxy.Individual.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ProxyStringProxy).value = 'composites' or self.InitialContext.ApplicationDomain.Proxy.Individual.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ProxyStringProxy).value = 'composites'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193798_593365_27619" xmi:uuid="678b7d71-a425-454f-bd54-1d35897275be" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193171_931282_23716"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193798_157183_27623" xmi:uuid="8619ebf2-112a-4f8b-8e16-6e9d31e9bea8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499231562_962729_43238" xmi:uuid="28edcd6b-0727-40b8-b6cc-71a4d7b3c9ae" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193798_157183_27623"/>
          <body> specifies the SurfaceWithDirection used to define the lamination or layers. The layers or lamination are defined to start from the surface and to be laminated or layered in the specified direction and order.</body>
        </ownedComment>
        <name>BaseSurface</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193264_822783_23872"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193798_818782_27621"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193798_561305_27624" xmi:uuid="3671f433-8a6d-4575-86b9-6ca7a84f6afb" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499242725_520724_43239" xmi:uuid="ebd3fde9-61b9-429c-b1b6-3887fd18cfae" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193798_561305_27624"/>
          <body> specifies the orientation direction for the load carrying reinforcements within the LaminateTable.</body>
        </ownedComment>
        <name>Basis</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193219_682367_23805"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194584_18463_32891" xmi:uuid="4dc50f35-4872-46af-8643-5864a2a41958" xmi:type="uml:LiteralUnlimitedNatural">
