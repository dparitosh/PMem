    <packagedElement xmi:id="_18_4_1_2aed05bf_1515872711734_518050_84805" xmi:uuid="b9c08eb6-2e28-4fb8-9783-031365a9fd60" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515872711734_18997_84806"/>
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515872705628_323521_84365"/>
      <ownedEnd xmi:id="_18_4_1_2aed05bf_1515872711734_18997_84806" xmi:uuid="fef84da9-f71e-4cfa-8476-25d7442390f2" xmi:type="uml:Property">
