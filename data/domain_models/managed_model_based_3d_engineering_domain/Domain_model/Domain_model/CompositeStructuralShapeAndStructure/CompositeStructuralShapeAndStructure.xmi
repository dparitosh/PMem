    <packagedElement xmi:id="_18_4_1_e120334_1499417193025_756368_23414" xmi:uuid="18306522-c5bb-4550-98fc-7b66b0a9ab4b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454497926799_999114_43175" xmi:uuid="e5d5dea6-3e97-4c4d-add0-d3280f4c0d77" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193025_756368_23414"/>
        <body>A BeveledSheetRepresentation is a type of ConstituentShapeRepresentation that has a significant thickness, and whose edge is beveled at a constant angle around its entire perimeter. It is an extension of the concept of a thin sheet to products, such as honeycomb core, that have significant thickness but can be formed to mate with a curved surface.</body>
      </ownedComment>
      <name>BeveledSheetRepresentation</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459325478104_932983_42471" xmi:uuid="81a878a3-327b-4f61-9c5c-c1002584266d" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459325534206_637450_42473" xmi:uuid="10261f70-c2e0-47fb-80de-2bc65916acf7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325478104_932983_42471"/>
          <body> the unit quantity for BevelAngle shall be 'angle', the unit quantity for VerticalProfileHeight shall be 'length'.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714997368210_94394_151618" xmi:uuid="56d8963a-6708-4f4f-9804-60d9790334f5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714997368210_310870_151619" xmi:uuid="91239004-80ab-41ad-a510-f4d3914c00ba" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Representation[@uid and substring-after(@xsi:type,':')='BeveledSheetRepresentation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="BevelAngleuidRef" value="BevelAngle/Unit/@uidRef"/&gt; &lt;sch:let name="VerticalProfileHeightRef" value="VerticalProfileHeight/Unit/@uidRef"/&gt; &lt;sch:assert test="(//Unit[@uid=$BevelAngleuidRef]/Quantity/ClassString ='angle') and (//Unit[@uid=$VerticalProfileHeightRef]/Quantity/ClassString ='length')"&gt;(BeveledSheetRepresentation.WR1 &lt;sch:value-of select="$uid"/&gt;) the unit name for BevelAngle shall be 'angle', the unit name for VerticalProfileHeight shall be 'length'.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671446232380_542763_162903" xmi:uuid="6e12fee7-5131-4dad-a264-e2080f84adcf" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446240820_876399_162904" xmi:uuid="89d8f901-7228-4559-818e-30ad54c090b8" xmi:type="uml:Comment">
            <body>WR1: (SELF.VerticalProfileHeight.Unit.Quantity ='length') AND (SELF.BevelAngle.Unit.Quantity ='angle');</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_756368_23414"/>
        <specification xmi:id="_18_4_1_271a0567_1510238911977_468016_29557" xmi:uuid="b398125a-3bb4-4de3-9964-41c815974fdb" xmi:type="uml:OpaqueExpression">
          <body>not self.VerticalProfileHeight.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclIsUndefined() and not self.BevelAngle.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclIsUndefined() and (self.VerticalProfileHeight.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'length') and (self.BevelAngle.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'angle')</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193401_39091_24814" xmi:uuid="2f83514d-36fb-451c-ac06-30d0bb0012ae" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193055_645521_23479"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193401_147048_24815" xmi:uuid="b97ca71e-f2a3-4cba-b7e7-662627ad8b13" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193058_466009_23486"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193402_83765_24819" xmi:uuid="3d076ddd-02c5-4bec-a953-74296bb6ce2a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454497940068_862172_43176" xmi:uuid="e3674a66-9bfb-4532-b959-7d2d30ded3a1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193402_83765_24819"/>
          <body> specifies the angle from the plane normal to the defining surface of part's profile to the beveled surface.</body>
        </ownedComment>
