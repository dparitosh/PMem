      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193922_221594_28290" xmi:uuid="9322570b-9c08-4742-a80d-b360c281f7d9" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500354588_201576_43292" xmi:uuid="ec89344e-6ec4-471d-8e4c-3cd46ba2be64" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193922_221594_28290"/>
          <body> specifies a ProcessedCore that has another process performed on it. This is two or more ProcessedCore objects that are being assembled. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>MadeFromProcessedCore</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193187_326713_23756"/>
