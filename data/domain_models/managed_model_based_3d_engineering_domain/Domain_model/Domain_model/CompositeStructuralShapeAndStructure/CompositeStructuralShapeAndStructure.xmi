          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194090_72693_29060"/>
          <body> specifies the Surface that is used in the definition.</body>
        </ownedComment>
        <name>DefiningSurface</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193262_84138_23869"/>
        <association xmi:idref="_18_4_1_e120334_1499417194088_231918_29050"/>
