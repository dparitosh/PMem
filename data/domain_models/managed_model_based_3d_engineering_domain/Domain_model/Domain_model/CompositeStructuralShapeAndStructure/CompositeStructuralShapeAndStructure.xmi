    <packagedElement xmi:id="_18_4_1_e120334_1499417193115_404304_23600" xmi:uuid="6e9a71fb-6496-4d4c-a7b3-8aecdbd1ea7d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454499141207_329390_43232" xmi:uuid="020ea8c4-1ab3-4bea-9854-55863ba2d950" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193115_404304_23600"/>
        <body>A GeometricSheetRepresentation is a type of CompositeSheetRepresentation that is defined by a surface and a set of curves. These curves are related in the application to that surface. The curves define a closed area but are not necessarily restrained topologically.</body>
      </ownedComment>
      <name>GeometricSheetRepresentation</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193518_209396_25600" xmi:uuid="c246cc50-7a2f-4e03-9094-8c9ab9bd20f3" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193048_82605_23462"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193717_525360_27156" xmi:uuid="1e858b9f-945c-40c5-a161-9efc81a30077" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499153358_861726_43233" xmi:uuid="4bb8552f-4ba4-4979-89ab-39c685337939" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193717_525360_27156"/>
          <body> the external Surface used to define shape and having some known context to the part being represented. The surface may be the layup surface, inner-mold-line surface, outer-mold-line surface, or other.</body>
        </ownedComment>
        <name>BasisSurface</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193262_84138_23869"/>
        <association xmi:idref="_18_4_1_e120334_1499417193717_680672_27155"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193717_502819_27157" xmi:uuid="85e68b83-92e3-43a0-b8ef-ec4e1060e50d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499164993_675754_43234" xmi:uuid="59f19124-736a-453d-aa0e-2dfba4a8d646" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193717_502819_27157"/>
          <body> the cutouts specifies the sets of curves that define the areas to be removed from the interior of the part. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Cutouts</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193026_871851_23416"/>
