          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193517_937211_25595"/>
          <body> specifies the groups of constituents to be laid in sequence. There shall exist not less than two CompositeAssemblySequenceDefinitions for the CompositeAssemblyTable.</body>
        </ownedComment>
        <name>SequenceGroups</name>
