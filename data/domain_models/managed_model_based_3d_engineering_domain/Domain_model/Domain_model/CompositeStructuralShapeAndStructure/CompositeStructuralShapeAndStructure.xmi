        <lowerValue xmi:id="_18_4_1_e120334_1499417195082_232819_37979" xmi:uuid="116952a9-abda-4e86-8a2c-15a41727a8ca" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417195082_798013_37978" xmi:uuid="5b003679-9b43-4bea-ba39-7c9ed22e3e02" xmi:type="uml:LiteralUnlimitedNatural">
