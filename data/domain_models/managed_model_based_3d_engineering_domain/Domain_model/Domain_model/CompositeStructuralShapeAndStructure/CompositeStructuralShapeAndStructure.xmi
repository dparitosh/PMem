      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193895_488343_28149" xmi:uuid="f734d790-6f4c-47e1-b4b2-75e58cb44c96" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499471795_832205_43252" xmi:uuid="a1fd9e21-a090-4701-85da-a9dbcf28db1c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193895_488343_28149"/>
          <body> specifies the amount of volume the PercentagePly occupies relative to the total volume of the PercentageLaminateTable.</body>
