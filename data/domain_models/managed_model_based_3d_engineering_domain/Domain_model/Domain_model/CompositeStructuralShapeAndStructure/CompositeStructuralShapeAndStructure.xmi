      <ownedEnd xmi:id="_18_4_1_e120334_1499417194674_423174_33781" xmi:uuid="45709c5f-c0fe-4ea8-bba8-08faed51cc43" xmi:type="uml:Property">
        <type xmi:idref="_18_4_1_e120334_1499417193187_326713_23756"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417195081_419181_37965" xmi:uuid="a050e6d2-3abc-43ac-8af9-a1018e00dd6b" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417195081_454905_37964" xmi:uuid="db81d72f-5c54-49ae-8be3-e57dfdc65f60" xmi:type="uml:LiteralUnlimitedNatural">
