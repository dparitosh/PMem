      <ownedAttribute xmi:id="_18_4_1_8db01ea_1533284417438_963991_100058" xmi:uuid="a596acfc-d8c9-4404-a177-c4175a263d68" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8db01ea_1536246323753_959462_94576" xmi:uuid="b36f82e7-c46c-46fc-ba61-8143ff370dee" xmi:type="uml:Comment">
