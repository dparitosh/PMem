        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193590_549126_26176"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194082_512464_29022" xmi:uuid="102677f9-cd0f-4a43-8352-f35767dd1797" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500701895_908221_43318" xmi:uuid="2912f0bb-8333-4714-9244-aee4b9373859" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194082_512464_29022"/>
          <body> the identification or set of identifications of a specific version of the StockMaterial. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>VersionId</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194813_650700_35145" xmi:uuid="763bdda9-2c48-4ca5-91e4-b40df158fd54" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193742_665524_27285"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194082_221336_29023" xmi:uuid="cdda9de6-1c0a-43ef-a102-fefe4a83806f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500646685_338591_43315" xmi:uuid="68535451-9422-4cb7-854e-8e46056375fd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194082_221336_29023"/>
          <body>specifies the material type for the StockMaterial. A StockMaterial may be either an AnisotropicMaterial or a BraidedAssembly, or a DiscontinuousFiberAssembly, or a FilamentAssembly, or an IsotropicMaterial, or a StockCore, or a WovenAssembly.</body>
        </ownedComment>
