    <packagedElement xmi:id="_18_4_1_e120334_1499417193256_75358_23861" xmi:uuid="c1b03a41-e059-4d6e-813d-d52a1b8a5845" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454500562499_425005_43311" xmi:uuid="796d526c-ec6d-4ba1-8699-816848575d8e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193256_75358_23861"/>
        <body>A StockMaterial is the material typically procured from a material supplier to fabricate a Part. &lt;note&gt; The StockMaterial in this Part of 10303 is limited to the material types that physically become all or a portion of the finished part.&lt;/note&gt;</body>
      </ownedComment>
      <name>StockMaterial</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194081_752919_29019" xmi:uuid="ab857343-0586-45cd-b004-c8825a3c8dc1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500592256_49851_43312" xmi:uuid="1e6d7f82-7b4b-4b13-bd0e-662c5ed8c0cc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194081_752919_29019"/>
          <body> the identifier or set of identifiers for the StockMaterial. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193735_999273_27248"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194082_686823_29020" xmi:uuid="3ed5659c-47e8-4d9c-a48c-b9caf17c3b36" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500610139_326151_43313" xmi:uuid="3e2a37d9-18dd-4f83-afb1-f4085af43854" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194082_686823_29020"/>
          <body> the words or set of words by which the StockMaterial is known. &lt;note&gt; This attribute supports multiple names in different contexts as well as multi-linguism.&lt;/note&gt;</body>
        </ownedComment>
        <name>Name</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193597_799734_26217"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194082_270569_29021" xmi:uuid="8d7724a9-ff12-4f14-8d0b-dc922559b6a9" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454500628219_824499_43314" xmi:uuid="5fb190cf-4443-46ef-95d5-8eb2ff2bb931" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194082_270569_29021"/>
          <body> the text or the set of texts that provide further information about the StockMaterial. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
