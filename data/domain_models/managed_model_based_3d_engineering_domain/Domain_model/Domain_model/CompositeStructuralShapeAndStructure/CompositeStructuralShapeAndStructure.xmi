    <packagedElement xmi:id="_18_4_1_8db01ea_1533224150115_905683_98807" xmi:uuid="78370ebe-4110-415e-aa70-1b80d9a462d8" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1536246130157_872842_94574" xmi:uuid="099ea1e5-9f74-49c6-b29b-9560041bf190" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1533224150115_905683_98807"/>
        <body>A GeometricSet is a type of DetailedGeometricModelItem which is intended for the transfer of models when a topological structure is not available. </body>
      </ownedComment>
      <name>GeometricSet</name>
      <generalization xmi:id="_18_4_1_8db01ea_1533224778641_186600_99275" xmi:uuid="0a995fc0-909a-4aac-a6ca-4ad55ed8a87a" xmi:type="uml:Generalization">
