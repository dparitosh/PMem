    <packagedElement xmi:id="_18_4_1_2aed05bf_1509715794310_213481_33838" xmi:uuid="7ae52a82-35ea-468a-9133-f9ce471262c0" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1509715794310_472125_33839"/>
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1509715794259_731677_33805"/>
      <ownedEnd xmi:id="_18_4_1_2aed05bf_1509715794310_472125_33839" xmi:uuid="a608b31c-e016-4103-9fb1-91b62549c7d3" xmi:type="uml:Property">
