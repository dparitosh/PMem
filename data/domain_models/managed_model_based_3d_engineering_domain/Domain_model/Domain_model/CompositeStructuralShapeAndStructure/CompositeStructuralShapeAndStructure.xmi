    <packagedElement xmi:id="_18_4_1_e120334_1499417193055_357027_23478" xmi:uuid="a718182c-54ae-44b9-84d8-4376365c8853" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454498380393_366120_43192" xmi:uuid="86970a6a-8b63-4706-8662-7fb9cef3adfc" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193055_357027_23478"/>
        <body>A ConstituentPart is a type of PartView. It is a composite item that makes up a composite part. A ConstituentPart may, but need not be, defined in a component-assembly relationship. A ConstituentPart may be either a Ply or a PlyPiece, or a PlyLaminate, or a FilamentLaminate, or a ProcessedCore, or a CompositeAssembly. Several ConstituentParts are illustrated in the figure below. &lt;figure&gt;&lt;name&gt;ConstituentPart.png&lt;/name&gt;Illustration of several ConstituentParts&lt;/figure&gt;</body>
      </ownedComment>
      <name>ConstituentPart</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459326894394_442870_42525" xmi:uuid="7103ba8f-9ac6-4697-b191-0913d8ced92a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671446674221_823220_162937" xmi:uuid="559af60e-2241-490a-bfa7-938020f04642" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446680779_217277_162938" xmi:uuid="f45752d1-6ada-48fd-a96f-bf19e9813119" xmi:type="uml:Comment">
            <body>WR1: ((NOT(EXISTS(SELF.Weight))) OR ((EXISTS(SELF.Weight)) AND (SELF.Weight.Unit.Name='mass')));</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714997368239_675858_151624" xmi:uuid="e6a18689-e3d1-4c19-a973-092c809d0f6e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714997368239_594543_151625" xmi:uuid="bcbb44bb-7d49-4881-a6ef-f26e07784973" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//PartView[@uid and local-fn:testXsiTypeConstituentPart(@xsi:type)=true() and child::Weight]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="unitRef" value="child::Weight/Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Name/ClassString='mass'"&gt;(ConstituentPart.WR1 &lt;sch:value-of select="$uid"/&gt;) if the attribute Weight is given a value, the unit name shall be 'mass'.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459326945711_432959_42527" xmi:uuid="ef5d39a6-e1e1-4e8a-a39e-bd5e74a256bd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326894394_442870_42525"/>
          <body> if the attribute Weight is given a value, the unit name shall be 'mass'.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193055_357027_23478"/>
        <specification xmi:id="_18_4_1_271a0567_1510239301804_521346_29580" xmi:uuid="9785ab6d-aa19-401d-8977-da8da40f2139" xmi:type="uml:OpaqueExpression">
          <body>not(self.Weight.oclIsUndefined()) implies self.Weight.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Name.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'mass'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193541_109320_25825" xmi:uuid="803a22b0-d305-4d0c-a7c0-e13fb69c7864" xmi:type="uml:Generalization">
        <general href="../ProductDataManagement/ProductDataManagement.xmi#_18_4_1_e120334_1499417193171_931282_23716"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193541_60159_25831" xmi:uuid="13976546-7fc6-4f9b-ac88-1e352865f32f" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454498421776_13005_43193" xmi:uuid="72b120bf-f791-4677-afa5-bccc78e33417" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193541_60159_25831"/>
          <body> quantifies the mass of the ConstituentPart. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Weight</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193154_809191_23681"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194360_226287_31079" xmi:uuid="6c2e1b9b-8841-45d7-8e8d-5783f2cc14c9" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
