        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Reinforcement_orientation_basis-table"/>
        <body>LaminateTable.Basis provides the mapping of Reinforcement_orientation_basis.table because Table is an inverse attribute</body>
      </ownedComment>
      <name>ReinforcementOrientationBasis</name>
      <generalization xmi:id="_18_4_1_8db01ea_1533221246475_454723_97946" xmi:uuid="63f19d3f-8bcc-4317-ba39-fcde134a637a" xmi:type="uml:Generalization">
