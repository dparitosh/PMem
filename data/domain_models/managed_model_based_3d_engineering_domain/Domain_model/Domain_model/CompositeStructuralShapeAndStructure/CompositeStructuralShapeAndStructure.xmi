        <ownedComment xmi:id="_18_0_5_45e01bd_1454497949373_846431_43177" xmi:uuid="1efcffbc-d031-4143-b98c-844476b228ee" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193402_476914_24820"/>
          <body> specifies the base exterior boundary and defining surface of the part.</body>
        </ownedComment>
        <name>BoundarySurface</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193048_82605_23462"/>
        <association xmi:idref="_18_4_1_e120334_1499417193402_57753_24818"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193402_919830_24821" xmi:uuid="20640689-403c-4a8c-b2f3-aa0f37f83a2c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454497971221_264833_43178" xmi:uuid="c973420f-8369-4cc3-9325-ea5828af73dd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193402_919830_24821"/>
          <body> specifies the vertical height of the part's profile from the base boundary to where the bevel begins.</body>
        </ownedComment>
