    <packagedElement xmi:id="_18_4_1_e120334_1499417193182_666663_23740" xmi:uuid="228479bd-4ae1-49de-bb81-c927ffc3ec72" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454499723977_391965_43262" xmi:uuid="e59370b0-cee1-4eba-abd6-4c098ee3d42b" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193182_666663_23740"/>
        <body>A PlyLaminateSequenceDefinition is an illustration of a single unique sequence or layer within a PlyLaminate. The sequence or layer contains one or more plies. &lt;note&gt;When more than one ply resides in the same sequence or layer, the plies must not overlap. If plies do overlap, they must be put on separate sequence or layers.&lt;/note&gt;</body>
      </ownedComment>
      <name>PlyLaminateSequenceDefinition</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193912_323640_28232" xmi:uuid="f310ba50-8842-446b-9984-5f6f265cf06e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499740580_937443_43263" xmi:uuid="3970a233-027f-4b1b-a668-2ef3ce417b16" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193912_323640_28232"/>
          <body> specifies the set of Ply that are laminated at the sequence. There shall exist one or more Ply for the PlyLaminateSequenceDefinition.</body>
        </ownedComment>
        <name>PliesInSequence</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193181_537288_23738"/>
