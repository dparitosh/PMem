    <packagedElement xmi:id="_18_4_1_2aed05bf_1515572988789_69048_53405" xmi:uuid="560a23c7-f57f-41fb-ae12-ac5c15df0bdb" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515572988789_222938_53406"/>
      <memberEnd xmi:idref="_18_4_1_2aed05bf_1515572983059_60134_53125"/>
      <ownedEnd xmi:id="_18_4_1_2aed05bf_1515572988789_222938_53406" xmi:uuid="83286b63-b578-4898-b9e4-141bee83450b" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193256_75358_23861"/>
