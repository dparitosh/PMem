        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193266_59619_23875"/>
        <body>A ThicknessLaminateTable is a type of ZoneStructuralMakeup that is used to capture the ordered list of constituents that make up a zone.</body>
      </ownedComment>
      <name>ThicknessLaminateTable</name>
      <generalization xmi:id="_18_4_1_e120334_1499417194091_723437_29065" xmi:uuid="9b642a55-7a12-44ed-a643-ef03e68e52f1" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193294_729206_23924"/>
      </generalization>
