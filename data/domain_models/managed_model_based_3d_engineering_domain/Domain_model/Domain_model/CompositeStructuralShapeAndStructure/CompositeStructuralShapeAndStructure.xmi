      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193691_974515_26941" xmi:uuid="eb3917a4-8c96-4ddb-a6f7-494c8f52b786" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499123182_637987_43231" xmi:uuid="08fc57a0-c0be-4537-bc48-b5b95cbec4a2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193691_974515_26941"/>
          <body> specifies the geometry that defines the cross-sectional area of a FilamentLaminate. The value of this attribute need not be specified.</body>
        </ownedComment>
