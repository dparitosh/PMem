        <ownedComment xmi:id="_18_0_5_45e01bd_1454499253973_979007_43240" xmi:uuid="cc01a7cd-b6ed-4c9e-bc12-adbca215524c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193799_115865_27625"/>
          <body> specifies the opposing external Surface that forms from the physical material being placed on the BaseSurface. </body>
        </ownedComment>
