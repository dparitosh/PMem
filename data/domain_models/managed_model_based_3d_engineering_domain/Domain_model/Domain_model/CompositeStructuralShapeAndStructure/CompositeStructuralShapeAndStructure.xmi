    <packagedElement xmi:id="_18_4_1_8db01ea_1533118332505_166459_94651" xmi:uuid="7bdc97cb-442c-4922-8e12-6d1df4c96bc5" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8db01ea_1533283050593_119289_99846" xmi:uuid="6bad1cb7-2fd2-4195-9590-6f3ac526732d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8db01ea_1533118332505_166459_94651"/>
        <body>A Cartesian11 is a type of DetailedGeometricModelItem whose 11 component specifies the basis for the orientation angle of the major fiber direction, commonly known as a Rosette. The Cartesian11 is defined by a Cartesian coordinate frame (see following figure). A Cartesian11 is an AxisPlacement that is referenced by the ReinforcementOrientationBasis of a PlyOrientationAngle. There shall exist one AxisPlacement for a Cartesian11. &lt;figure&gt;&lt;name&gt;Cartesian_11.gif&lt;/name&gt;Cartesian11&lt;/figure&gt;</body>
      </ownedComment>
      <name>Cartesian11</name>
      <ownedRule xmi:id="_18_4_1_271a0567_1548346721478_42585_100086" xmi:uuid="eaaf6f95-fcdf-4b8a-8e6d-1bb5d327fb4e" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714997368217_795746_151620" xmi:uuid="9bca09bd-6442-408e-a88b-82a26d80d89b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714997368217_482957_151621" xmi:uuid="49b5c75f-2183-4864-ac84-8fb997308c18" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='Cartesian11']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="axisPlacementRef" value="child::Placement/@uidRef"/&gt; &lt;!-- assumption delimiter in AxisPlacement/Position is blank --&gt; &lt;sch:assert test="count(tokenize(normalize-space(//RepresentationItem[@uid=$axisPlacementRef]/Position) , ' '))=3"&gt;(Cartesian11.WR1 &lt;sch:value-of select="$uid"/&gt;) the dimensionality of the Placement shall be 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
