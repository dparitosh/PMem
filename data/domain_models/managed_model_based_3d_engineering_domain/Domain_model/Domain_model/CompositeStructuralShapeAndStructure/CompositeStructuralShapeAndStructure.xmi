        <general xmi:idref="_18_4_1_e120334_1499417193045_539261_23454"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193911_104958_28228" xmi:uuid="acc0d878-cd0b-43b0-a79a-52e874f55fcd" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454499683278_40135_43260" xmi:uuid="8a694ac0-611a-4e88-a516-3b4007ec498e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193911_104958_28228"/>
