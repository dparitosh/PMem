            <body>&lt;sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='Ply' ]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="PlyThickness/ValueComponent &gt;=0 "&gt;(Ply.WR1 &lt;sch:value-of select="$uid"/&gt;) the PlyThickness shall be greater or equal to zero.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671456389409_928595_163061" xmi:uuid="5c9af5f1-8911-4e91-9eb4-dac00d5d244a" xmi:type="uml:Comment">
