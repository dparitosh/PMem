    <packagedElement xmi:id="_18_4_1_65b021e_1719937007194_51420_147579" xmi:uuid="1eabe2ee-ffeb-4fb0-ba66-b1cabaf8dd02" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_65b021e_1719937008059_600733_147673"/>
      <memberEnd xmi:idref="_18_4_1_65b021e_1719937008043_755727_147648"/>
