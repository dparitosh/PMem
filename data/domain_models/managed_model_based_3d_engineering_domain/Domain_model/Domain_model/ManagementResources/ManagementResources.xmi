      <name>ProjectRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459331466180_419965_42697" xmi:uuid="76c80a7a-ae64-432d-83c3-575a87ec0aee" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121965_560169_163208" xmi:uuid="088ae474-3dad-42f2-ba0d-9cd3e8cfdbf5" xmi:type="uml:Comment">
