        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513939025887_800931_61063"/>
        <body>A ProductGroup is an identification of a set of ProductConcepts, Parts, ProductGroups, PartVersions or IndividualParts that have been grouped together. &lt;example&gt;All the aircraft sold to BigPlanes airways.&lt;/example&gt;</body>
      </ownedComment>
      <name>ProductGroup</name>
      <generalization xmi:id="_18_4_1_8e001ed_1513957708373_566648_87741" xmi:uuid="581210bd-912d-4d4e-9732-b2da169a1bbb" xmi:type="uml:Generalization">
