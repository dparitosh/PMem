        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513949223756_763571_61328"/>
        <body>A ProductGroupMembership is an identification of an instance of an entity defined in the type ProductGroupMembershipSelect that belongs to a ProductGroup.</body>
      </ownedComment>
      <name>ProductGroupMembership</name>
