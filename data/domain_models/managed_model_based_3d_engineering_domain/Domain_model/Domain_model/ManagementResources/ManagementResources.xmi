    <packagedElement xmi:id="_18_4_1_e120334_1499417193178_874694_23728" xmi:uuid="18e0a832-31de-4125-85a5-77801500b8ae" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455121332969_189885_42664" xmi:uuid="e3343161-2217-4363-95de-8f7ca7926f16" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193178_874694_23728"/>
        <body>A PersonInOrganizationRelationship is a mechanism that specifies a relationship between two persons in an organization. &lt;example&gt;The owner of important product data leaves a company and therefore has a successor. This relationship may be built up using the PersonInOrganizationRelationship mechanism. &lt;/example&gt;&lt;note&gt; The following additional data can be assigned to a PersonInOrganizationRelationship: Effectivity, and InformationUsageRight.&lt;/note&gt;</body>
      </ownedComment>
      <name>PersonInOrganizationRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330620584_414072_42660" xmi:uuid="a9478f3e-4b40-463d-b2b3-33ebe4888e04" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121954_39220_163196" xmi:uuid="39cf40cb-e44e-42a5-be72-055df93711af" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_505395_163197" xmi:uuid="8ff2e35f-d66c-47c6-886b-4555feec4aa8" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//PersonInOrganizationRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related PersonInOrganization and the relating PersonInOrganization shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:PersonInOrganizationRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_466802_163198" xmi:uuid="88ad31b1-c6b2-43e0-a540-1104471265ec" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_191258_163199" xmi:uuid="dffe349a-b308-4bad-a0f9-ad302de4e9c7" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330651916_940742_42662" xmi:uuid="b79ff777-9a28-4845-bfab-1ee83a792eb4" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330620584_414072_42660"/>
          <body>the related PersonInOrganization and the relating PersonInOrganization shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193178_874694_23728"/>
        <specification xmi:id="_18_4_1_271a0567_1509115889683_335244_31387" xmi:uuid="d6da2938-39c5-4851-add4-d44777e41a12" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193705_675580_27062" xmi:uuid="3cda1a42-0c42-44ce-8d02-43ff78f05d41" xmi:type="uml:Generalization">
