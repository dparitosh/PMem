      <generalization xmi:id="_18_4_1_8e001ed_1500554841387_221169_27845" xmi:uuid="eecd4eaa-9d37-474a-947a-be3155413c98" xmi:type="uml:Generalization">
        <general href="../DeltaChange/DeltaChange.xmi#_18_4_1_e120334_1499691165239_904252_31960"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193394_45032_24751" xmi:uuid="b3727d69-b5ae-49b1-b141-089f6d4d4848" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455119124679_775889_42607" xmi:uuid="966d01e2-2ba2-4d3e-9326-9fe74f94f162" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193394_45032_24751"/>
          <body> the identifier or set of identifiers for the AssignmentObjectRelationship. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
