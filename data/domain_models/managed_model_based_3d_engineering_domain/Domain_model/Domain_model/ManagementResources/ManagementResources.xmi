    <packagedElement xmi:id="_18_4_1_e120334_1499417193133_57201_23623" xmi:uuid="6ee656de-8a9d-4a8b-b1a8-8866ba8c5b16" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455111875997_428369_42353" xmi:uuid="4a67e062-70a8-49c7-b680-e1d9332361e0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193133_57201_23623"/>
        <body>An InformationUsageRightRelationship is a relationship of one InformationUsageRight to another. &lt;example&gt;Where one InformationUsageRight supersedes another, then the original right is pointed to by the relating attribute, its replacement by the related attribute, and the relationType attribute takes the value supersedes. &lt;/example&gt;&lt;note&gt; The following additional data can be assigned to an InformationUsageRightRelationship: Effectivity, and InformationUsageRight.&lt;/note&gt;</body>
      </ownedComment>
      <name>InformationUsageRightRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459329511415_944356_42611" xmi:uuid="197e4161-dd98-4a68-8b8f-4b4ba1ffc227" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121944_405872_163194" xmi:uuid="90df0827-96d8-4e15-ad3a-ae3e36ded7d3" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121944_209593_163195" xmi:uuid="b14fab76-b5af-42b5-bc45-ec653a349622" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459329540504_961381_42613" xmi:uuid="a1deff01-99d6-4799-8e9d-498236864c7a" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329511415_944356_42611"/>
          <body>the related InformationUsageRight and the relating InformationUsageRight shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121943_216235_163192" xmi:uuid="f7825a05-e3be-497c-9888-7ddb1acb02af" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121943_338356_163193" xmi:uuid="ffd7ada5-bd1a-4f3f-8fed-e45df9be6ccb" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//InformationUsageRightRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related InformationUsageRight and the relating InformationUsageRight shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:InformationUsageRightRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193133_57201_23623"/>
        <specification xmi:id="_18_4_1_271a0567_1511355417752_751879_33390" xmi:uuid="9ed244ae-f317-4b5e-97ef-476a6be9d4ac" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193651_947580_26670" xmi:uuid="4e72a93e-7b78-4e88-870c-6e3ed3361599" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193085_557055_23539"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193621_369724_26413" xmi:uuid="e1965b05-e08e-41e2-8df6-f520f6883210" xmi:type="uml:Generalization">
        <general href="../DocumentManagement/DocumentManagement.xmi#_18_4_1_e120334_1499417193076_372354_23525"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193777_60559_27502" xmi:uuid="ed7b3750-5bb4-4574-a15d-6ba416b63b41" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193131_678926_23622"/>
      </generalization>
      <generalization xmi:id="_18_4_1_65b021e_1721221107484_381328_148817" xmi:uuid="fed130cd-0b5a-4fd6-8cd9-0d5f7c84be97" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_65b021e_1719937007191_236673_147578"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193779_83087_27531" xmi:uuid="a2966942-df9f-4eef-86f4-01a4ee7ff9a8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455111899000_121244_42354" xmi:uuid="2cc1b3a8-eaeb-4867-a451-2c702dc40d8b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193779_83087_27531"/>
          <body> the identifier or set of identifiers for the InformationUsageRightRelationship. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
