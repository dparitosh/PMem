    <packagedElement xmi:id="_18_4_1_e120334_1499417193020_962240_23397" xmi:uuid="0c87651e-6be1-4813-a8bd-68287a05a2d4" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455707776473_422900_42749" xmi:uuid="442428f6-c135-4663-a47c-458b968110cc" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193020_962240_23397"/>
        <body>An ApprovalRelationship is a typed association between two Approval objects.</body>
      </ownedComment>
      <name>ApprovalRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459324322775_549624_42440" xmi:uuid="7fa60168-287a-4a81-9643-0c6c3d9f75cf" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459324674939_960757_42442" xmi:uuid="4897f4e4-41cc-47e7-9973-0b26150217e0" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324322775_549624_42440"/>
          <body>the related Approval and the relating Approval shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121961_628232_163204" xmi:uuid="943ee81c-498a-4345-bd9a-d33dccb4f28e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121961_224565_163205" xmi:uuid="70ec397d-c5b9-45f6-9373-0191f335d3cf" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ApprovalRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Approval and the relating Approval shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ApprovalRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121961_214464_163206" xmi:uuid="b921abc2-d2bc-4ae4-9052-ca42cb7e50d1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121961_850045_163207" xmi:uuid="d8dbf6be-5022-43e8-a243-ec7bbc4cf657" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193020_962240_23397"/>
        <specification xmi:id="_18_4_1_271a0567_1508945259126_63704_30499" xmi:uuid="5123a56d-69c3-4e86-9881-7977f5d1ac36" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193374_17952_24603" xmi:uuid="53b30d48-3462-4474-8696-5ceeb5a799c0" xmi:type="uml:Generalization">
