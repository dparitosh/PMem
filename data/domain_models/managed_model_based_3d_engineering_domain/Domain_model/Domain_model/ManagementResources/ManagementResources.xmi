        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193161_579062_23696"/>
        <body>An OrganizationInContract is a mechanism to associate the person who is signing a contract and the organization which the person is signing for, with a Contract.</body>
      </ownedComment>
      <name>OrganizationInContract</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193859_635816_27945" xmi:uuid="91e32d17-e777-4a72-8696-dbff444c0eb7" xmi:type="uml:Property">
