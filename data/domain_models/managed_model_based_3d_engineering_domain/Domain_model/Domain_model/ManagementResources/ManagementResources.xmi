          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193859_635816_27945"/>
          <body> the text or the set of texts that provide further information about the OrganizationInContract. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
