    <packagedElement xmi:id="_18_4_1_e120334_1499417193024_563443_23410" xmi:uuid="b00f6f3d-9e20-4431-920c-1c0d556da497" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455119102612_433919_42606" xmi:uuid="5df9f0d6-3ead-468f-a2d7-d2fa4a592b5f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193024_563443_23410"/>
        <body>An AssignmentObjectRelationship is a relationship between two assignment objects.</body>
      </ownedComment>
      <name>AssignmentObjectRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459325014949_504549_42457" xmi:uuid="f4433223-edad-4d1b-bd87-4351588a6387" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671446101624_800394_162887" xmi:uuid="3200a7a6-094f-453a-9429-55e2682e527b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446107743_203429_162888" xmi:uuid="96273d4b-6d8d-449f-ba30-a6caa58da7f3" xmi:type="uml:Comment">
            <body>WR1: TYPEOF(Relating) = TYPEOF(Related);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459325051586_798747_42459" xmi:uuid="47b62165-f2c1-46c1-9884-7141e0f55609" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325014949_504549_42457"/>
          <body>the related and the relating object shall be of same type.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721730196829_648592_153317" xmi:uuid="ced9886b-514c-4998-84d4-f612035a41b5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721730196829_626442_153318" xmi:uuid="48d0d59f-eb90-42c6-bccf-7b17488c766f" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//AssignmentObjectRelationship[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/&gt; &lt;sch:let name="reference_uidRef" value="Related/@uidRef"/&gt; &lt;sch:let name="reference" value="//*[@uid = $reference_uidRef]"/&gt; &lt;sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/&gt; &lt;sch:assert test="$relating_type = $related_type"&gt; The Related and the Relating object shall be of same type. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -relating_type:&lt;sch:value-of select="$relating_type"/&gt; -related_type:&lt;sch:value-of select="$related_type"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193024_563443_23410"/>
        <specification xmi:id="_18_4_1_271a0567_1509111672390_862072_30467" xmi:uuid="37537ee2-a004-45ea-b26e-a3732f9b3b29" xmi:type="uml:OpaqueExpression">
          <body>self.Relating.oclType() = self.Related.oclType()</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193394_895444_24750" xmi:uuid="9c169e22-8b2b-4e8a-ba5e-4040494a742c" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193085_557055_23539"/>
      </generalization>
      <generalization xmi:id="_18_4_1_65b021e_1675863857599_212812_164070" xmi:uuid="c0f353c5-3c24-4c48-8f51-8ad36cfdbe53" xmi:type="uml:Generalization">
