      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193903_37322_28186" xmi:uuid="9f750478-1cf1-496d-ade9-008db631c687" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455121375119_950808_42665" xmi:uuid="d68b673c-1ffa-4461-befd-350257dc8244" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193903_37322_28186"/>
          <body> the identifier or set of identifiers for the PersonInOrganizationRelationship. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
