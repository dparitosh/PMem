      <memberEnd xmi:idref="_18_4_1_271a0567_1513068303075_482106_350999"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1513068303000_531457_350932"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1513068303075_482106_350999" xmi:uuid="8841056d-780d-47c2-ab3d-4bafe7a13c09" xmi:type="uml:Property">
