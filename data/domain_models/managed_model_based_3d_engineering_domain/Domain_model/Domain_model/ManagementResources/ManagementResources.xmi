        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193085_557055_23539"/>
      </generalization>
      <generalization xmi:id="_18_4_1_65b021e_1705504974507_669830_151206" xmi:uuid="7ac66d4d-c6ac-48c5-8fc9-6c0f0ebab2c2" xmi:type="uml:Generalization">
