    <packagedElement xmi:id="_18_4_1_e120334_1499417193176_725943_23726" xmi:uuid="4c809417-cd4a-446b-86d1-2ee325353e51" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455120945132_317282_42639" xmi:uuid="75a745d9-5689-41e2-b4df-8afbe3d97e35" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193176_725943_23726"/>
        <body>A Person is an individual human being who has some relationship to product data. The Person shall always be identified in the context of one or more organizations. &lt;note&gt; The following additional data can be assigned to a Person: ActivityMethod, DateTimeString, Document, DocumentVersion, DocumentDefinition, File, InformationUsageRight, PropertyValue, ExternalPropertyDefinition, PropertyDefinition, and WorkRequest.&lt;/note&gt;</body>
      </ownedComment>
      <name>Person</name>
      <generalization xmi:id="_18_4_1_65b021e_1675863858120_18438_164115" xmi:uuid="2219b17d-a65d-4371-aeed-5d95cda72bfc" xmi:type="uml:Generalization">
