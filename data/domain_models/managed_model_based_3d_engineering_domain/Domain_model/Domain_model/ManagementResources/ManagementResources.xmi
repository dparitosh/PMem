    <packagedElement xmi:id="_18_4_1_e120334_1499417193162_98936_23699" xmi:uuid="29ac4603-6b4a-4617-af05-9d24b2b3d3e6" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455120579136_343553_42632" xmi:uuid="b936e5dc-2e35-414f-a960-0db9c9a8ba94" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193162_98936_23699"/>
        <body>An OrganizationRelationship is a relationship between two Organization objects. &lt;example&gt; A team belongs to a department which itself belongs to a company. This organizational structure may be built up using the OrganizationRelationship mechanism. &lt;/example&gt;&lt;note&gt; The following additional data can be assigned to an OrganizationRelationship: Document, DocumentVersion, DocumentDefinition, File, Effectivity, InformationUsageRight, PropertyValue, ExternalPropertyDefinition, and PropertyDefinition.&lt;/note&gt;</body>
      </ownedComment>
      <name>OrganizationRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330310036_967107_42648" xmi:uuid="05edfb2b-77f6-401c-9444-9259de13b0c3" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121960_32371_163202" xmi:uuid="01f35c14-ae7b-438a-9f84-820cf955439d" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121960_998015_163203" xmi:uuid="634a7dfa-ed57-4e8c-bb38-56f6b259da55" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121959_706217_163200" xmi:uuid="12286886-e2f3-4476-8cec-055c1dee5d06" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121959_529553_163201" xmi:uuid="6d75aef3-c93d-4b45-8192-918acad99809" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//OrganizationRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Organization and the relating Organization shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:OrganizationRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330342276_956957_42650" xmi:uuid="b4c7d778-73cc-4b9e-b7a7-a3e079f7fa14" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330310036_967107_42648"/>
          <body>the related Organization and the relating Organization shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193162_98936_23699"/>
        <specification xmi:id="_18_4_1_271a0567_1509115020911_714886_31324" xmi:uuid="32e43aa9-ba0d-4ec7-8598-ffb7cb26d370" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
