      <ownedEnd xmi:id="_18_4_1_271a0567_1522311874024_884710_85765" xmi:uuid="f1aa87a1-fcac-40aa-a92e-adb8350531c1" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193065_368295_23508"/>
        <association xmi:idref="_18_4_1_271a0567_1522311874024_760876_85764"/>
