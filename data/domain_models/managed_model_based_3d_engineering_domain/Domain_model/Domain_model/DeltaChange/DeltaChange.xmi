    <packagedElement xmi:id="_18_4_1_e120334_1499417193150_611193_23670" xmi:uuid="198e96b8-5bb8-4727-ba07-54691b032635" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454506638230_540174_43385" xmi:uuid="180a12cf-87e3-4332-9ec9-ffc52db8b68d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193150_611193_23670"/>
        <body>A ModifySingleElement is a type of DeltaChangeActivity that identifies an object that has been modified. &lt;example&gt;The mass value of a part has been modified from version A to version B of a part. This change can be described by referencing with the attribute PreviousDesignObject of ModifySingleElement a PropertyValue representing the original mass value of version A, and with the attribute CurrentDesignObject of ModifySingleElement a PropertyValue representing the new mass value of version B. The ModifySingleElement object is referenced by a DeltaChange object via ChangeActivities. Finally, DeltaChange is referencing (via DescribedChange) a PartVersionRelationship where the &lt;a&gt;&lt;path&gt;./4_info_reqs_ProductDataManagement.htm#PartVersionRelationship.Relating&lt;/path&gt; Relating&lt;/a&gt; PartVersion represents version A of the part and the &lt;a&gt;&lt;path&gt;./4_info_reqs_ProductDataManagement.htm#PartVersionRelationship.Related&lt;/path&gt; Related&lt;/a&gt; PartVersion represents version B of the part.&lt;/example&gt;</body>
      </ownedComment>
      <name>ModifySingleElement</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459330097504_637935_42639" xmi:uuid="5ce92a0d-25ef-41b9-932f-727899971bd3" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671456236591_782922_163055" xmi:uuid="936d20df-3aab-4ad2-9d2e-02ce097e63f6" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671456243844_314580_163056" xmi:uuid="597a51e2-19f0-4469-ada2-3e85d295eb90" xmi:type="uml:Comment">
            <body>WR1: CurrentDesignObject :&lt;&gt;: PreviousDesignObject;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459330144365_221463_42641" xmi:uuid="960e6a08-412f-476c-89ba-becda43f85c2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330097504_637935_42639"/>
          <body> the PreviousDesignObject and CurrentDesignObject shall refer to different objects.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295760088_656091_151366" xmi:uuid="ab028dcc-cf4d-49f9-9af7-068ca32a4c40" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295760088_702340_151367" xmi:uuid="851e0f6d-897b-4e15-8c1b-0ac11ab8e6c7" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ModifySingleElement']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(PreviousDesignObject/@uidRef = CurrentDesignObject/@uidRef)"&gt; The PreviousDesignObject and CurrentDesignObject shall refer to different objects. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193150_611193_23670"/>
        <specification xmi:id="_18_4_1_271a0567_1509095053076_154196_30357" xmi:uuid="2a4dda14-1080-4cb6-847c-bcde6765c1c7" xmi:type="uml:OpaqueExpression">
          <body>self.CurrentDesignObject &lt;&gt; self.PreviousDesignObject</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193573_206552_26065" xmi:uuid="187f3a2e-b70f-4b15-93dc-80e8adcfd950" xmi:type="uml:Generalization">
