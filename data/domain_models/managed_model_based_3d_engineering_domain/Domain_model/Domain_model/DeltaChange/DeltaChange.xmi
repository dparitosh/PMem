    <packagedElement xmi:id="_19_0_4_b1702d9_1702999985772_264060_59952" xmi:uuid="cc3ab767-32f0-498e-ae71-3afbe8b1eed5" xmi:type="uml:Class">
      <ownedComment xmi:id="_19_0_4_b1702d9_1702999986297_938243_60056" xmi:uuid="68c7e368-0115-471f-be9b-12e3c12b5656" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_19_0_4_b1702d9_1702999985772_264060_59952"/>
        <body> A DeltaChangeRelationship is a relationship between two DeltaChange objects the meaning of which is defined by the attribute RelationType.</body>
      </ownedComment>
      <name>DeltaChangeRelationship</name>
      <ownedRule xmi:id="_19_0_4_b1702d9_1702999985774_352026_59953" xmi:uuid="4662b5ff-7926-4b1e-b916-c24c6c5d5275" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_19_0_4_b1702d9_1703001711796_326119_62706" xmi:uuid="5d4ebf01-ee23-4e84-a7a5-9f51e68079bb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_b1702d9_1702999985774_352026_59953"/>
        </ownedComment>
        <ownedComment xmi:id="_19_0_4_b1702d9_1702999986301_298799_60099" xmi:uuid="7c98920e-2aed-4410-8544-ca1c4e8f06be" xmi:type="uml:Comment">
          <ownedComment xmi:id="_19_0_4_b1702d9_1702999986326_71987_60310" xmi:uuid="291a9f71-5f1c-4dfb-90ed-f3b3fe38a1f3" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//DeltaChangeRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related DeltaChange and the relating DeltaChange shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:DeltaChangeRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_19_0_4_b1702d9_1702999986301_884624_60100" xmi:uuid="aeaf5b4a-566a-4464-9472-31f8b8693fd5" xmi:type="uml:Comment">
