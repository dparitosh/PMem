    <packagedElement xmi:id="_18_4_1_e120334_1499417193197_101410_23772" xmi:uuid="a76805b0-aa9a-41cc-97ae-5eb78ae3526a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455721411137_78184_43097" xmi:uuid="34fcc33a-49d6-4156-a226-b2fcfecff83f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193197_101410_23772"/>
        <body> A ProductConfigurationRelationship is a relationship between two ProductConfiguration objects. The meaning of this relationship is specified further by the attribute RelationType.</body>
      </ownedComment>
      <name>ProductConfigurationRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459331404528_445160_42694" xmi:uuid="1bae68e3-f83e-4c3e-b0ab-ac3f40335a36" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459331441706_211028_42696" xmi:uuid="5dcce95f-3e65-4fa3-b7c3-d3cc01880670" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331404528_445160_42694"/>
          <body>the related ProductConfiguration and the relating ProductConfiguration shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121700_666375_163122" xmi:uuid="9a105a5a-1320-4cbf-ad79-d41dc029e6cf" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121700_460903_163123" xmi:uuid="2efb49ab-f3e7-44af-a053-29024dbdabb3" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121699_829189_163120" xmi:uuid="be78450b-2963-403a-86de-724705007075" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121699_128603_163121" xmi:uuid="a27c0e1c-25e6-4e9a-9ee4-1dc28258ab39" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ProductConfigurationRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related ProductConfiguration and the relating ProductConfiguration shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ProductConfigurationRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193197_101410_23772"/>
        <specification xmi:id="_18_4_1_271a0567_1509116207442_704358_31449" xmi:uuid="e9e9d723-03c4-47ed-b0c6-c0341cd95453" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1669375106815_691461_163650" xmi:uuid="083870c7-030c-4f87-b22d-e3ecb99e42ed" xmi:type="uml:Generalization">
