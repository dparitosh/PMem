    <packagedElement xmi:id="_19_0_4_b1702d9_1704206924639_932921_60129" xmi:uuid="1844979f-bca0-42ec-8328-94968384c081" xmi:type="uml:Class">
      <ownedComment xmi:id="_19_0_4_b1702d9_1704206925788_553121_60254" xmi:uuid="a97d4930-aa07-4e21-9924-4df3c31e17bb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_19_0_4_b1702d9_1704206924639_932921_60129"/>
        <body>An EffectivityControlledProductConfiguration is a type of ProductConfiguration who is controlled by an Effectivity. &lt;example&gt; A ProductConfiguration may apply to a given Serialnumber(-interval), a given Lot, a given Date(-interval), a given Event(-interval), ..., or a conditional combination of them.&lt;/example&gt;</body>
      </ownedComment>
      <name>EffectivityControlledProductConfiguration</name>
      <ownedRule xmi:id="_19_0_4_b1702d9_1704208979768_709430_63846" xmi:uuid="326bc5e4-31e3-4d84-ab95-e76edf8577ce" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_19_0_4_b1702d9_1704209144410_161972_63848" xmi:uuid="163ecff7-fe5f-4303-8753-b5b5df98e7af" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_b1702d9_1704208979768_709430_63846"/>
          <body>The attribute DefiningSpecifications should not be used for this subtype. &lt;note&gt; Specifications can be defined by referencing the subtype ConditionalEffectivity. &lt;/note&gt;</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759007_803551_151298" xmi:uuid="3f8b334d-f586-48b2-87a0-33a0810b0faa" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759007_217334_151299" xmi:uuid="e6a55e86-c4f4-4362-8bf0-4ca01f586165" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='EffectivityControlledProductConfiguration']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(DefiningSpecifications)"&gt; The attribute DefiningSpecifications should not be used for this subtype. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_19_0_4_b1702d9_1704206924639_932921_60129"/>
        <specification xmi:id="_19_0_4_b1702d9_1704208979768_967248_63847" xmi:uuid="a80829b7-f459-420c-9e7a-d134373a2d03" xmi:type="uml:OpaqueExpression">
          <body>self.DefiningSpecifications.oclIsUndefined()</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_19_0_4_b1702d9_1704207353499_14939_63533" xmi:uuid="ffcdcf30-d0cb-4a6f-86b3-b796dda5f545" xmi:type="uml:Generalization">
