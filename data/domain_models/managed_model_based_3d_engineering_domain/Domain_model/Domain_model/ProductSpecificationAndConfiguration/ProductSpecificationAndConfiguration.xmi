      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194070_26393_28969" xmi:uuid="4e3a6565-e2e4-423c-9627-014c90200873" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455723452221_915976_43128" xmi:uuid="3d866ade-3d99-4f96-91cc-c6cc1ed2eb64" xmi:type="uml:Comment">
