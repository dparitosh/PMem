        </ownedAttribute>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1554391705540_613238_116664" xmi:uuid="158c6b40-8a7e-49e9-beba-7d1b4fc75c24" xmi:type="uml:Port">
