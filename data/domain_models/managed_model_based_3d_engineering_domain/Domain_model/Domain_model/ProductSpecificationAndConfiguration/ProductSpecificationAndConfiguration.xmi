    <packagedElement xmi:id="_18_4_1_e120334_1499417193251_39618_23853" xmi:uuid="469887e4-93de-40cc-8f53-4cbd5319291d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455723686045_840244_43132" xmi:uuid="a38cedde-eaf6-4bfd-95e5-449c113f45b2" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193251_39618_23853"/>
        <body>A SpecificationCategory is a definition of a set of Specification objects serving the same purpose. &lt;example&gt; The category 'kind of drive' for the Specification objects 'front wheel drive' and 'rear wheel drive' or the category 'level of equipment' for the Specification objects 'standard', 'comfortable', and 'luxurious' are examples for SpecificationCategory objects. &lt;/example&gt;</body>
      </ownedComment>
      <name>SpecificationCategory</name>
      <generalization xmi:id="_18_4_1_8e001ed_1500554918402_901708_27893" xmi:uuid="198b3b05-101c-434e-b170-90c5b813cf09" xmi:type="uml:Generalization">
