    <packagedElement xmi:id="_18_4_1_e120334_1499417193048_5039_23464" xmi:uuid="11374f00-89d3-4b57-8cb0-c0b9d489005d" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455718014525_833366_42983" xmi:uuid="39125023-742a-40e0-8e0f-a8082f52c508" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193048_5039_23464"/>
        <body>A ConditionalConfiguration is a type of ConditionalEffectivity and represents an association of a SpecificationConditionAssignment or a SpecificationAssignment object with a design or with a process in order to define a valid usage of it in the context of a certain ProductClass. &lt;note&gt; The semantics of the kind of association is defined by the attributes ConfigurationType and InheritanceType. &lt;/note&gt;</body>
      </ownedComment>
      <name>ConditionalConfiguration</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193522_500640_25639" xmi:uuid="17c6a0f7-9dab-4605-9146-7fdfdac0eec5" xmi:type="uml:Generalization">
