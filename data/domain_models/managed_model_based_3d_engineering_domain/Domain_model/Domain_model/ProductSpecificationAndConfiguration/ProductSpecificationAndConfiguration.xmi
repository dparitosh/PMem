    <packagedElement xmi:id="_18_4_1_271a0567_1521732169405_156489_121050" xmi:uuid="11b900eb-e5e4-4b2d-9890-cc532e115a05" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1521732169405_837909_121051"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1521732169374_25191_121017"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1521732169405_837909_121051" xmi:uuid="af81b607-6bce-43a3-bf2f-d99f3c907601" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193250_722937_23852"/>
        <association xmi:idref="_18_4_1_271a0567_1521732169405_156489_121050"/>
