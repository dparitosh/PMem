    <packagedElement xmi:id="_18_4_1_271a0567_1554391645439_14494_115639" xmi:uuid="b475b090-1664-4079-9a64-e5393b0e5158" xmi:type="uml:Package">
      <name>Constraints</name>
      <packagedElement xmi:id="_18_4_1_271a0567_1591804407107_137441_96568" xmi:uuid="7e6bf140-3209-4acd-bc37-c9379cc4a4d6" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_271a0567_1591804407121_148227_96571" xmi:uuid="28909bd9-d0e4-4756-b3de-d2aa7b9c4bc8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1591804407107_137441_96568"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ConvertConditionToSpecificationExpression</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1591804407114_743738_96569" xmi:uuid="61b63958-2f1e-4e41-981c-58e801826b39" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676133511410_706004_173879" xmi:uuid="cea645d0-6435-4cea-b9d3-a2999fd7e738" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1591804407114_743738_96569"/>
            <body>convert a Condition into a Specification_expression.</body>
          </ownedComment>
          <name>output</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1591804407107_137441_96568"/>
          <specification xmi:id="_18_4_1_271a0567_1591804407130_59491_96575" xmi:uuid="9a2d50c1-0781-47fc-a8b8-9362406d9df2" xmi:type="uml:OpaqueExpression">
            <body>def convert (param: condition_parameter_item):specification_operand_select = if param.oclIsTypeOf(SysML_ARM::Specification) then param else if param.oclIsTypeOf(SysML_ARM::Condition) then SysML_ARM::Specification_expression(operation=param.name,operands=param.condition_parameter-&gt;collect(p:Condition_parameter; convert(p.parameter))) else if param.oclIsOfType(SysML::Condition_relationship) then SysML_ARM::Specification_expression(operation=param.name,operands=Set(convert(param.relating_condition),convert(param.related_condition))) else null endif endif endif output = SysML_ARM::Specification_expression(operation=input.name,operands=input.condition_parameter-&gt;collect(p:Condition_parameter; convert(p.parameter)))</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1591804407121_182315_96572" xmi:uuid="b7e53bb4-a97c-448c-9f18-515c65e069c8" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1676133358269_896527_173875" xmi:uuid="b375aa71-dc59-4e80-8c16-7d2fc5d597e6" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1591804407121_182315_96572"/>
            <body>the input condition to be converted.</body>
          </ownedComment>
          <name>input</name>
          <visibility>private</visibility>
          <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Condition"/>
          <aggregation>composite</aggregation>
        </ownedAttribute>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1591804407126_250908_96573" xmi:uuid="b37cd685-2a03-46fa-8f1b-b82599610297" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1676133366017_299549_173876" xmi:uuid="a69eb511-cd73-4cf0-a5e1-88231eb73d9f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1591804407126_250908_96573"/>
            <body>the output Specification_expression from the conversion.</body>
          </ownedComment>
          <name>output</name>
          <visibility>private</visibility>
          <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Specification_expression"/>
          <isReadOnly>true</isReadOnly>
          <aggregation>composite</aggregation>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:id="_18_4_1_271a0567_1554391705521_822068_116659" xmi:uuid="e2a69cc6-094b-4f90-b541-cdefa59adbad" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_271a0567_1554391705527_98517_116661" xmi:uuid="9b0a498d-9be9-4aeb-86cc-1890d0fa9e98" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1554391705521_822068_116659"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ChooseEffectivity</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1554391705526_563930_116660" xmi:uuid="99ec481c-1f35-4169-82ef-872ce56c0fdd" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1675676796533_148136_164312" xmi:uuid="44845d8e-b5c9-43a7-a1f0-88cdefb4b7b5" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1554391705526_563930_116660"/>
            <body>f in1 is undefined then set effectivity to in2 otherwise set to in1. </body>
          </ownedComment>
          <name>out</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1554391705521_822068_116659"/>
          <specification xmi:id="_18_4_1_271a0567_1554391705545_208116_116666" xmi:uuid="ce9729b9-8b8a-42c6-ad34-c24055e0ff3b" xmi:type="uml:OpaqueExpression">
            <body>out = if in1.oclIsUndefined () then in2 else in1 endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1554391705527_255516_116662" xmi:uuid="40400eb0-1cee-4722-8a81-96e42d3e62fc" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1675676770471_790507_164309" xmi:uuid="879bb56e-5d82-4922-a3a7-d86ee52d6bcf" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1554391705527_255516_116662"/>
            <body>the first Effectivity input. The value of this parameter need not be specified. </body>
          </ownedComment>
          <name>in1</name>
          <visibility>private</visibility>
          <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Effectivity"/>
          <lowerValue xmi:id="_18_4_1_271a0567_1554391705551_959780_116669" xmi:uuid="0909d513-e2e9-4b93-bec2-3d36df82e9af" xmi:type="uml:LiteralInteger"/>
          <aggregation>composite</aggregation>
        </ownedAttribute>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1554391705533_310651_116663" xmi:uuid="fb4e237c-00cc-45d7-870a-a602d837ee1b" xmi:type="uml:Port">
