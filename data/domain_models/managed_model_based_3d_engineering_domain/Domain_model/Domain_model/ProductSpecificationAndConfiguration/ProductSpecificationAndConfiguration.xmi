            <annotatedElement xmi:idref="_18_4_1_271a0567_1554391705533_310651_116663"/>
            <body>the second Effectivity input. The value of this parameter need not be specified. </body>
          </ownedComment>
          <name>in2</name>
          <visibility>private</visibility>
          <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Effectivity"/>
