    <packagedElement xmi:id="_18_4_1_e120334_1499417193195_739043_23769" xmi:uuid="70fdc7a8-b853-4201-b4c5-9ca119ded5fb" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455720490348_709980_43074" xmi:uuid="f0e64869-da82-4da2-bfb2-e591e374d9f5" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193195_739043_23769"/>
        <body>A ProductClassRelationship is a relationship between two ProductClass objects. The meaning of this relationship is specified further by the attribute RelationType.</body>
      </ownedComment>
      <name>ProductClassRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459331331716_671582_42691" xmi:uuid="bd596a4d-ad06-46db-ab0b-1074925c2e70" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121703_862386_163126" xmi:uuid="438feb40-2e91-4814-839f-efb64c911893" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121703_588779_163127" xmi:uuid="939af823-f140-452c-8e2b-0ffa16377b9b" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121702_147808_163124" xmi:uuid="a7a97db4-4537-4b51-a765-fb652cfa8069" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121703_838224_163125" xmi:uuid="1f470e82-7d26-4553-ae7e-faf78c6ae7b0" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ProductClassRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related ProductClass and the relating ProductClass shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ProductClassRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459331364513_597471_42693" xmi:uuid="faaf171c-e352-46b3-80e0-6d89fd12de32" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331331716_671582_42691"/>
          <body>the related ProductClass and the relating ProductClass shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193195_739043_23769"/>
        <specification xmi:id="_18_4_1_271a0567_1509116099956_502715_31439" xmi:uuid="22da7680-1e45-498e-a50c-d4187934db37" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
