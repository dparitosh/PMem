      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193635_469825_26535" xmi:uuid="dde3064f-5e1f-483c-bf00-97e5f12311e8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454507820847_496871_43428" xmi:uuid="054ec8a5-fc88-47d5-b735-c66e767f26fa" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193635_469825_26535"/>
