    <packagedElement xmi:id="_18_4_1_e120334_1499417193080_702146_23528" xmi:uuid="b29dfef2-1ce1-4503-bff3-e93b44f5a235" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454507342978_679838_43412" xmi:uuid="20896d6b-5f7a-4d74-895a-3c1838fc57ae" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193080_702146_23528"/>
        <body>A DocumentRelationship is a relationship between two Document objects. &lt;note&gt; The following additional data can be assigned to a DocumentRelationship: PropertyValue, ExternalPropertyDefinition, and PropertyDefinition.&lt;/note&gt;</body>
      </ownedComment>
      <ownedComment xmi:id="_18_4_1_271a0567_1551186431371_937607_110305" xmi:uuid="24a55144-bb7a-4030-afe8-e53f01a333aa" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <name>DocumentRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459327466711_68021_42547" xmi:uuid="533128eb-128b-4316-9afd-c59ac3454655" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121773_700168_163134" xmi:uuid="e50e5752-b3d7-4131-9dec-65a9146d5ae3" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121773_359644_163135" xmi:uuid="d1f34f32-73fb-48a3-a27f-bfcc52b5155f" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459327511193_696459_42549" xmi:uuid="e9898fbf-d75b-4fac-b1c0-de695dee4de8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327466711_68021_42547"/>
          <body>the related Document and the relating Document shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121773_814535_163132" xmi:uuid="fd2b295e-182e-43c1-8c83-de9d005c5986" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121773_694524_163133" xmi:uuid="15998ece-fe78-4eb9-b34b-7c1b9a9364b1" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//DocumentRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Document and the relating Document shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:DocumentRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193080_702146_23528"/>
        <specification xmi:id="_18_4_1_271a0567_1509113431290_454068_31120" xmi:uuid="8ae3036d-3507-4ed8-9a27-a2e4e8626364" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193630_174881_26500" xmi:uuid="24935f6d-9902-4d56-9ce1-4d210774dfff" xmi:type="uml:Generalization">
