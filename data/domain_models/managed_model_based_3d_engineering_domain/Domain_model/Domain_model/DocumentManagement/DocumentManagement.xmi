    <packagedElement xmi:id="_18_4_1_e120334_1499417193055_216634_23480" xmi:uuid="8b4caf31-0582-41d5-b6a1-b006b8ba3ff1" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_290014c_1536313097352_662964_225460" xmi:uuid="054e67d0-73b2-426b-ae88-c34d4019e3ad" xmi:type="uml:Comment">
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Assigned_document_property-described_element"/>
        <body>Entity Assigned_document_property has its described_element property unmapped in the mapping specification since they have to be completed where used.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1454510426854_236378_43447" xmi:uuid="53ab6454-81d2-45d0-9dbf-6d5fbdbacb55" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193055_216634_23480"/>
        <body>A ContentProperty is the specification of characteristics making the content of a File or of a DocumentDefinition more precise. At least one of the optional attributes shall be specified for each instance of this object. In the case where a ContentProperty is referred by a DocumentDefinition, the characteristics apply to all individual File objects, whereas in the case where it is referred by a File, the characteristics apply on an individual basis.</body>
      </ownedComment>
      <name>ContentProperty</name>
      <ownedRule xmi:id="_18_4_1_290014c_1533808039761_69566_95614" xmi:uuid="7599a366-e9ce-4124-bd32-1abac44a9b62" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1721295759815_609267_151358" xmi:uuid="18730f08-564a-483a-8f44-c532a8c8a53f" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1721295759816_434870_151359" xmi:uuid="89beec3a-314d-4f38-9b14-67822ccdb18e" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ContentProperty']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="xsitype" value="@xsi:type"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="RWS_name" value="RealWorldScale/Name/CharacterString/text()"/&gt; &lt;sch:assert test="$RWS_name = 'real world scale'"&gt; The attribute Name of RealWorldScale attribute shall be a string with the value 'real world scale'. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -attribute_name:&lt;sch:value-of select="RealWorldScale/Name/name()"/&gt; -attribute_value:&lt;sch:value-of select="$RWS_name"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_290014c_1536327500561_792789_248581" xmi:uuid="1d5c39d1-4bb2-43e2-a1bd-8def8c48c9a5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_290014c_1533808039761_69566_95614"/>
          <body>the RealWorldScale attribute shall be a string with the value "real world scale".</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193055_216634_23480"/>
        <specification xmi:id="_18_4_1_290014c_1533808039765_35843_95615" xmi:uuid="95a72ee1-3bf7-45fa-bc2b-43e2d013e4e4" xmi:type="uml:OpaqueExpression">
          <body>self.RealWorldScale.Name = 'real world scale'</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193543_86670_25841" xmi:uuid="9646d1ec-f21a-4f4a-b902-120b65b85756" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454510439229_701934_43448" xmi:uuid="bbc4a79d-91c5-4224-9279-5c78ebcf87ce" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193543_86670_25841"/>
          <body> the text or the set of texts that provide further information about the ContentProperty. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194361_255117_31087" xmi:uuid="aad4b398-f33e-47a6-857d-0d641c334f55" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193542_213805_25836"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193543_906572_25842" xmi:uuid="bf5da0ea-c64d-4e51-895a-be3eb560b658" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454510472126_612210_43449" xmi:uuid="671f488f-d404-4720-9da5-6340f7ba1e82" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193543_906572_25842"/>
          <body> the level of detail that the File or the DocumentDefinition provides. Where applicable, the following values shall be used: &lt;ul&gt;&lt;li&gt;'rough 3d shape': three-dimensional shape model without edge rounds and fillets; &lt;/li&gt;&lt;li&gt;'rounded edges': three-dimensional shape model with edge rounds and fillets.&lt;/li&gt;&lt;/ul&gt; The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>DetailLevel</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194361_505757_31090" xmi:uuid="a0efa36b-6fc4-41fc-9365-85345972c8bc" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193542_736349_25840"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193543_990236_25843" xmi:uuid="df1ab680-a291-4faa-a5d3-efd0cef8e1c1" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454510521914_594058_43450" xmi:uuid="4ff7d30b-2bcd-4cc0-af30-0356dd421f4f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193543_990236_25843"/>
          <body> the kind or kinds of geometry that an object contains. Where applicable, the following values shall be used: &lt;ul&gt;&lt;li&gt;'3D wireframe model': The document contains a three-dimensional shape model in wireframe representation; &lt;/li&gt;&lt;li&gt;'2D shape': The document contains a two-dimensional shape model or contours only; &lt;/li&gt;&lt;li&gt;'surface model': The document contains a three-dimensional shape model in surface representation; &lt;/li&gt;&lt;li&gt;'closed volume': The document contains a three-dimensional shape model in closed body topological surface representation; &lt;/li&gt;&lt;li&gt;'solid model': The document contains a three-dimensional shape model in advanced boundary representation; &lt;/li&gt;&lt;li&gt;'solid and surface model': The document contains a three-dimensional shape model in surface and advanced boundary representation; &lt;/li&gt;&lt;li&gt;'assembly': The document contains an assembly structure with reference to the assembled components and their transformation matrices; &lt;/li&gt;&lt;li&gt;'assembly with mating elements': The document contains an assembly structure including the mating components only, such as screws or rivets, with exact positioning information. This assembly representation is intended to be overlayed with the assembly structure for the main components; &lt;/li&gt;&lt;li&gt;'2D drawing': The document contains a technical drawing without three-dimensional shape representation; &lt;/li&gt;&lt;li&gt;'drawing derived from 3D data': The document contains a technical drawing that has been derived from a three-dimensional shape model; &lt;/li&gt;&lt;li&gt;'drawing related to 3D data': The document contains a technical drawing that visualizes a three-dimensional shape model and possibly establishes associative left to the three-dimensional shape model. &lt;/li&gt;&lt;/ul&gt;The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>GeometryTypes</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194362_774132_31093" xmi:uuid="d7b32d3b-b5bc-490e-bb25-7c02da483d10" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194362_859074_31092" xmi:uuid="ac4cccd3-9395-409b-b6c7-d29423a493dc" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_e120334_1499417193483_577050_25378"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193543_723814_25844" xmi:uuid="0e4ca23f-018f-44d6-9407-fb024f2862b0" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454510562986_123452_43451" xmi:uuid="f7e982b9-eb6d-4b85-b7a9-62dc578ff9cc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193543_723814_25844"/>
          <body> the language or languages which are used in the characterized objects. &lt;example&gt;'Japanese' and 'German' are examples for the fact that annotation on a drawing is provided in the language 'Japanese' or 'German' respectively. &lt;/example&gt;The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>Languages</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193138_351083_23637"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194362_625478_31096" xmi:uuid="8093618d-4fb7-4b01-b22e-21abe31d9303" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194362_94191_31095" xmi:uuid="b4de8103-d1a2-4384-83a1-1d328bc1d874" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417201541_172769_38279"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193543_393814_25845" xmi:uuid="b0a86bdb-f3d4-4ded-874e-a590e4756108" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454510576331_347265_43452" xmi:uuid="1d3f60e3-e254-4b17-ad4e-dba34ab6e555" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193543_393814_25845"/>
          <body> the scale that is used in the File or in the DocumentDefinition the ContentProperty is referred by. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>RealWorldScale</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193154_809191_23681"/>
