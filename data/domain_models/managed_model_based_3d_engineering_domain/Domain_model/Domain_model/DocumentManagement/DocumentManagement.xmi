        <ownedComment xmi:id="_18_0_5_45e01bd_1454510740763_383142_43456" xmi:uuid="d5b2fadb-1e90-49d9-a311-1bf9b0e506a2" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193554_847878_25929"/>
          <body>the computer application or the machine that was used to generate the DocumentDefinition, or File.</body>
        </ownedComment>
