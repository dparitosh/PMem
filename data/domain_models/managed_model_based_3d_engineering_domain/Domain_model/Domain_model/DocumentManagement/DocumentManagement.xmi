        <association xmi:idref="_18_4_1_e120334_1499417193628_114983_26487"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193629_704464_26494" xmi:uuid="2a3e0037-7ad5-4eb1-9d82-6794f2a04d07" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454511158120_502609_43475" xmi:uuid="66fd96ff-aa6c-4d00-940c-dc2a743ad084" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193629_704464_26494"/>
          <body> the text or the set of texts that provide further information about the DocumentDefinitionRelationship. The value of this attribute need not be specified.</body>
