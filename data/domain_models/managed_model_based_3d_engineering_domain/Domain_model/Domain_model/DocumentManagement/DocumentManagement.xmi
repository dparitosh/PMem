    <packagedElement xmi:id="_18_4_1_e120334_1499417193179_268697_23730" xmi:uuid="e1e8229a-605b-41e6-bd19-5315c743f656" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454512396821_15119_43521" xmi:uuid="36aec28d-eb98-46e3-aa61-470961f8496f" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193179_268697_23730"/>
        <body>A PhysicalDocumentDefinition is a type of DocumentDefinition describing a piece of product data that is archived in a non-digital form. &lt;example&gt;Paper plots of technical drawings, micro fiche, or paper documents such as calculations or test reports are examples for a PhysicalDocumentDefinition.&lt;/example&gt;</body>
      </ownedComment>
      <name>PhysicalDocumentDefinition</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193625_975324_26470" xmi:uuid="0f1f6ebf-8a86-423b-815c-9be251bd95ca" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193078_811987_23526"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193904_650805_28194" xmi:uuid="bde5785f-95a1-4f2d-8024-b913388465cf" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454512410193_606246_43522" xmi:uuid="e77febce-8538-450a-b3c6-1677b69df346" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193904_650805_28194"/>
          <body> the physical realization of the PhysicalDocumentDefinition. The value of this attribute need not be specified.</body>
        </ownedComment>
