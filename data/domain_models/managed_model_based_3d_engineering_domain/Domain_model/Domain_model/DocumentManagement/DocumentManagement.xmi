      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193635_526035_26534" xmi:uuid="687e6bf8-c649-4fce-9d08-bfe42037eec9" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454507807547_52421_43427" xmi:uuid="47485dd3-3a33-419a-b6cd-96b983dd1607" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193635_526035_26534"/>
          <body> the identifier or set of identifiers for the DocumentVersionRelationship. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
