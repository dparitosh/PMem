    <packagedElement xmi:id="_18_4_1_e120334_1499417193105_572504_23579" xmi:uuid="ba975f38-aacb-4de7-9a88-98dc41e73aca" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454511680587_614873_43498" xmi:uuid="bf1a4599-83e0-4529-a64c-4094523048b3" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193105_572504_23579"/>
        <body>A FileRelationship is a relationship between two File objects. &lt;note&gt; The following additional data can be assigned to a FileRelationship: Effectivity, InformationUsageRight, PropertyValue, ExternalPropertyDefinition, and PropertyDefinition.&lt;/note&gt;</body>
      </ownedComment>
      <name>FileRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459328443976_564160_42570" xmi:uuid="73f7dbf7-4b1f-4f3d-89c9-bbf0dff3c1e5" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_0_5_45e01bd_1459328473552_711036_42572" xmi:uuid="0ffa1f36-7fd9-4d02-b5a1-a8ff683437ee" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459328443976_564160_42570"/>
          <body>the related File and the relating File shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121776_875560_163138" xmi:uuid="e34380f7-8297-40bf-9dcb-8a3034696218" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121776_784703_163139" xmi:uuid="24722cdb-0339-446a-8683-4863bb922c39" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121776_712143_163136" xmi:uuid="fe19045a-c25a-4294-9689-896e18929f47" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121776_471709_163137" xmi:uuid="3f6e5994-d1e4-4e80-a27b-ef2eb0d6aef2" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//FileRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related File and the relating File shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:FileRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193105_572504_23579"/>
        <specification xmi:id="_18_4_1_271a0567_1509114035904_872029_31188" xmi:uuid="35c23992-20ab-4d1b-8509-0cac07dff59f" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
