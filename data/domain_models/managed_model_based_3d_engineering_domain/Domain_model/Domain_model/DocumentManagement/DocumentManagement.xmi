        <aggregation>composite</aggregation>
        <defaultValue xmi:id="_18_4_1_271a0567_1516873626927_90814_306189" xmi:uuid="49fcf9fd-9582-4e91-ac49-e94a512bfbb2" xmi:type="uml:LiteralString">
