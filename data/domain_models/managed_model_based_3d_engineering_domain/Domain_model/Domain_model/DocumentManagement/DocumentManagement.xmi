          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ConcatenateLanguageAttributes</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1542990284030_331888_183985" xmi:uuid="0634110e-dc2f-4af9-8ca6-c02cfd79ea51" xmi:type="uml:Constraint">
