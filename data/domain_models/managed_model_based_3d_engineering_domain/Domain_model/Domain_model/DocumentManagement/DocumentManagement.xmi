      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193696_989859_26972" xmi:uuid="58f5126f-3ca1-491a-bb37-c595a422f32b" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454511816593_301002_43501" xmi:uuid="db160d16-375a-4374-8a2b-55c18593d5d3" xmi:type="uml:Comment">
