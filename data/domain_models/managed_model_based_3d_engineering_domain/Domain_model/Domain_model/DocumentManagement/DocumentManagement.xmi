    <packagedElement xmi:id="_18_4_1_e120334_1499417193248_922103_23849" xmi:uuid="18a14162-1c8e-4ebe-a20f-8f7e092d2ee0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454512487750_237252_43527" xmi:uuid="aca5eafd-8c80-4002-8fb6-2b91ac700dfb" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193248_922103_23849"/>
        <body>A SizeProperty is the specification of the size of a File or of a DocumentDefinition object. At least one of the optional attributes shall be specified for each instance of this object. In the case where a SizeProperty is referred by a DocumentDefinition, the size information is the sum of the sizes of all individual objects that are collected by this object, whereas in the case it is referred by a File, the size information is the one of the individual objects that is referenced.</body>
      </ownedComment>
      <name>SizeProperty</name>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194065_353540_28950" xmi:uuid="306c024e-04f7-44f5-b19c-99fbf94657d6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454512501379_603027_43528" xmi:uuid="b80b33dd-c59a-483b-9ca6-97edc55feadc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194065_353540_28950"/>
          <body> the text or the set of texts that provide further information about the SizeProperty. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194799_952770_34992" xmi:uuid="7a8918df-e243-4718-8edb-2c47e9600f5a" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417193582_126279_26133"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194065_638944_28951" xmi:uuid="4c177f90-aa06-4677-89e6-b758b5baa388" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454512531367_282984_43529" xmi:uuid="fc12e3a8-e0da-4cdb-bedb-e1d443e51c86" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194065_638944_28951"/>
          <body> the ValueWithUnit that represents the size of a digitally stored document. The value of this attribute need not be specified. The FileSize shall only be applied in cases where the SizeProperty is referred by a DigitalDocumentDefinition or a File. &lt;example&gt; '15021 Bytes' and 'less than 500 Bytes' are examples for a FileSize. &lt;/example&gt;The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>FileSize</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193283_976319_23905"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194799_583331_34995" xmi:uuid="f6c533fe-8edd-4cf1-8a7c-bf54c5a67e2e" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417194064_889018_28948"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194066_614372_28952" xmi:uuid="18704f06-3eaf-4a38-b34d-4aa8f322af9c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454512563779_290009_43530" xmi:uuid="2d54ba61-38c1-40e7-b0da-d74aae54de84" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194066_614372_28952"/>
          <body> the number of pages of the business object the SizeProperty is referred by. The value of this attribute need not be specified. The PageCount shall only be used in cases where the SizeProperty is referred by a Hardcopy or a PhysicalDocumentDefinition. &lt;example&gt; '42 pages' and 'more than 1 page' are examples of a PageCount. &lt;/example&gt;The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>PageCount</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193283_976319_23905"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194799_151673_34998" xmi:uuid="97f2edfc-9eeb-4608-8f3e-8905f36f1f02" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_e120334_1499417194065_48507_28949"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_271a0567_1516893901742_360279_380850" xmi:uuid="b6ce7723-7a05-4345-baa4-25d73977696d" xmi:type="uml:Property">
        <name>theName</name>
