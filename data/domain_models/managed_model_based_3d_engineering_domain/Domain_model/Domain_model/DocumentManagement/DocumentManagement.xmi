      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193636_353328_26536" xmi:uuid="0e5b6431-8bed-4788-8244-c1f0488df0a6" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454507835802_749707_43429" xmi:uuid="3335a6b8-7425-49cc-b5b9-ec791f3520c7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193636_353328_26536"/>
