        <name>ClassifiedAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194433_937116_31616" xmi:uuid="40ebeae6-9592-499a-9a9e-8e25d496f55e" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194433_674154_31615" xmi:uuid="f23076c7-b798-436a-ac3a-c4aa9bc777e4" xmi:type="uml:LiteralUnlimitedNatural">
