    <packagedElement xmi:id="_18_4_1_e120334_1499417193081_99909_23530" xmi:uuid="b91ea335-44be-4f56-9dd2-07738607658c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1551187071069_528044_111322" xmi:uuid="29bfad3d-e8e8-46d1-b248-4e2c7ce6561b" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847743191_208266_98071"/>
        <body>These flowports are not bound to the ARM target because only a product definition property type can be assigned to it.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1454507784818_574946_43426" xmi:uuid="f308a235-6902-44b0-a41c-0d3be0cbc679" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193081_99909_23530"/>
        <body>A DocumentVersionRelationship is a relationship between two DocumentVersion objects. &lt;note&gt; The following additional data can be assigned to a DocumentVersionRelationship: ActivityMethod, Approval, DateTimeString, Document, DocumentVersion, DocumentDefinition, File, Effectivity, PropertyValue, ExternalPropertyDefinition, and PropertyDefinition.&lt;/note&gt;</body>
      </ownedComment>
      <name>DocumentVersionRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459327614408_519135_42550" xmi:uuid="6367f732-21b7-4146-85b0-3633c9d360df" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121781_416646_163142" xmi:uuid="84539fe8-bbb8-46ba-99ca-f620fd380e59" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121781_650388_163143" xmi:uuid="6b86dd3c-c7b4-413a-bd9c-92dc7c9c6b15" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121781_983787_163140" xmi:uuid="d176c80b-f52c-4f44-be43-ab047bf0dbc5" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121781_702789_163141" xmi:uuid="25e96c63-3dee-4a07-a6bb-f31e908fca9d" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//DocumentVersionRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related DocumentVersion and the relating DocumentVersion shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:DocumentVersionRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459327653235_429264_42552" xmi:uuid="d2af261b-39e8-4150-8617-3d3300ea5d44" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327614408_519135_42550"/>
          <body>the related DocumentVersion and the relating DocumentVersion shall be different.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193081_99909_23530"/>
        <specification xmi:id="_18_4_1_271a0567_1509113469930_380861_31135" xmi:uuid="0e4c6272-9b79-4b71-8eb5-cdd40ec11fff" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
