        <lowerValue xmi:id="_18_4_1_e120334_1499417194443_384946_31692" xmi:uuid="ee42c5cb-b1d2-437c-a1c8-208eb5163b6c" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194443_908258_31691" xmi:uuid="534130db-ee4e-420b-832d-73ea4985d36e" xmi:type="uml:LiteralUnlimitedNatural">
