      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193629_160250_26495" xmi:uuid="1795a344-4052-416e-a61e-ef65adc7c439" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454511190453_170106_43476" xmi:uuid="1372cb11-08ee-4e36-b498-85d767cd9bac" xmi:type="uml:Comment">
