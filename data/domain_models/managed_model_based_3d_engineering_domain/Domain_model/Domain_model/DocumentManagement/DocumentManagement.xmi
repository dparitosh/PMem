      <ownedEnd xmi:id="_18_4_1_e120334_1499417194440_746297_31665" xmi:uuid="4fcd350f-b49b-4143-a9da-53f91232b392" xmi:type="uml:Property">
        <type xmi:idref="_18_4_1_e120334_1499417193079_200378_23527"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417195004_425078_37183" xmi:uuid="4cd66d49-f1d9-40ca-9363-71e5d9cbb880" xmi:type="uml:LiteralInteger"/>
