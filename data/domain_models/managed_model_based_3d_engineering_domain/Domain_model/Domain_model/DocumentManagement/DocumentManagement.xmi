      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193628_273826_26493" xmi:uuid="e1b4e9ad-3237-4dac-bce7-a9c103034f91" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454511136369_421113_43474" xmi:uuid="263cdb7e-8164-4d72-b343-bcccde0a4314" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193628_273826_26493"/>
          <body> the identifier or set of identifiers for the DocumentDefinitionRelationship. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
