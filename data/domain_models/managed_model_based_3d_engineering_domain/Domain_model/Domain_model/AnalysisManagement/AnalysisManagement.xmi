    <packagedElement xmi:id="_18_4_1_2aed05bf_1516784805788_520454_63524" xmi:uuid="b8af19d4-a6cb-41d9-a880-a6f801f966c4" xmi:type="uml:Package">
      <name>Constraints</name>
      <packagedElement xmi:id="_18_4_1_2aed05bf_1516784839583_999624_63529" xmi:uuid="c12dfde3-b626-45ce-9ed5-e2667e44cb1c" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_290014c_1527251696635_909303_73894" xmi:uuid="2f047496-257e-4d36-836d-658b6dffb1dd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_2aed05bf_1516784839583_999624_63529"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>AnalysisModelItemSelector</name>
        <ownedRule xmi:id="_18_4_1_2aed05bf_1516784839598_760441_63531" xmi:uuid="6842525a-6ed3-4433-bbdf-b3e3ed1ecd0e" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676019016150_404173_169466" xmi:uuid="299348e1-8e9b-4cfe-8e02-e25f3c0f78e7" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_2aed05bf_1516784839598_760441_63531"/>
            <body>if the input is a DocumentVersion then the docVer output is this input, otherwise the docVer is null. </body>
          </ownedComment>
          <name>docVer</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1516784839583_999624_63529"/>
          <specification xmi:id="_18_4_1_2aed05bf_1516784839598_561710_63532" xmi:uuid="73708c28-bb2c-425e-a73c-2e2fd43922da" xmi:type="uml:OpaqueExpression">
            <body>docVer = if input.oclIsUndefined () then null else if input.oclIsTypeOf(DocumentVersion) then input.documentVersion else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_271a0567_1516889770934_36068_356976" xmi:uuid="db0abf0a-daa2-4c53-b0bc-8298067f9e4e" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676019051667_467124_169468" xmi:uuid="5d01183c-eaf1-40a5-ae53-467503972c78" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1516889770934_36068_356976"/>
            <body>if the input is a StateDefinitionTransition then the stateDefTrans output is this input, otherwise the stateDefTrans is null. </body>
          </ownedComment>
          <name>stateDefTrans</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1516784839583_999624_63529"/>
          <specification xmi:id="_18_4_1_271a0567_1516889770934_397964_356977" xmi:uuid="5007dac6-fac0-492e-9b77-ce7dd65cf463" xmi:type="uml:OpaqueExpression">
            <body>stateDefTrans = if input.oclIsUndefined () then null else if input.oclIsTypeOf(StateDefinitionTransition) then input.documentVersion else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_271a0567_1516889703992_23620_356974" xmi:uuid="f20a0209-a3ec-4a31-911b-a8f6ce597058" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676019045963_888350_169467" xmi:uuid="7b32ac17-005f-46ef-a28d-f98ffcca946c" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1516889703992_23620_356974"/>
            <body>if the input is a StateDefinition then the stateDef output is this input, otherwise the stateDef is null. </body>
          </ownedComment>
          <name>stateDef</name>
          <constrainedElement xmi:idref="_18_4_1_2aed05bf_1516784839583_999624_63529"/>
          <specification xmi:id="_18_4_1_271a0567_1516889703992_990205_356975" xmi:uuid="c482c012-c98f-4cf8-96ae-0133670e2794" xmi:type="uml:OpaqueExpression">
            <body>stateDef = if input.oclIsUndefined () then null else if input.oclIsTypeOf(StateDefinition) then input.stateDefinition else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_2aed05bf_1516784927653_826948_63533" xmi:uuid="12af0555-5b56-4d42-9622-f1201b14ec78" xmi:type="uml:Port">
