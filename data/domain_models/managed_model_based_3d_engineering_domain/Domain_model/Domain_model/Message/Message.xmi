    <packagedElement xmi:id="_18_4_1_8e001ed_1513937662078_223320_60682" xmi:uuid="94ff1190-925e-45be-9fd0-f18630b31f2a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_8e001ed_1513937960155_535558_60761" xmi:uuid="5f592ddb-3fc2-4af3-bc88-5fae5139c069" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937662078_223320_60682"/>
        <body>An Envelope is an historical record of the transmission of a Message. It is used to record the audit data for sending and acknowledging a Message. Each Envelope is only used once because it is an historical record and is not versioned.</body>
      </ownedComment>
      <name>Envelope</name>
      <generalization xmi:id="_18_4_1_271a0567_1548254413787_92730_370836" xmi:uuid="082b15a7-0e10-4fbb-af4c-b83d662f30d2" xmi:type="uml:Generalization">
        <general href="../Activity/Activity.xmi#_18_4_1_e120334_1499417193010_433732_23374"/>
      </generalization>
