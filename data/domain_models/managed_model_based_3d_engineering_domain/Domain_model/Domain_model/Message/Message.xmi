  <uml:Package xmi:id="_18_4_1_8e001ed_1516284410450_795911_56355" xmi:uuid="61d43b8c-ac2a-4c12-8297-6f6914a03902" xmi:type="uml:Package">
    <ownedComment xmi:id="_18_4_1_8e001ed_1516284484373_245063_56635" xmi:uuid="93cce01d-567c-41a3-87d2-68706af90212" xmi:type="uml:Comment">
      <annotatedElement xmi:idref="_18_4_1_8e001ed_1516284410450_795911_56355"/>
      <body>This capability is for the representation of the data that identify a Message and an Envelope.&lt;br&gt; Message as a collection of information, brought together by an originator (the message definer) for some specific purpose, generally the fulfilment of a process.&lt;br&gt; An Envelope is the historical record of the transmission of a Message.</body>
    </ownedComment>
    <name>Message</name>
