      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513937677967_190884_60725" xmi:uuid="d82d214c-18c1-4ac1-86cc-783b9edd6175" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513937734600_78525_60733" xmi:uuid="c5a9ba67-b4be-42e9-93a1-ab7b38dd137e" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937677967_190884_60725"/>
          <body>the identifier or set of identifiers for the Envelope. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; </body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8e001ed_1513937684287_276020_60728"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513937736846_404649_60734" xmi:uuid="00ac2463-5ff5-4bb0-9308-6a71e98c73ed" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513937761913_256354_60742" xmi:uuid="1e229be0-5327-44bd-ba0b-d3a244c150d7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937736846_404649_60734"/>
          <body>the text or the set of texts that provide further information about the Envelope. The value of this attribute need not be specified. </body>
        </ownedComment>
        <name>Description</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193068_300298_23514"/>
        <lowerValue xmi:id="_18_4_1_8e001ed_1513937749084_272455_60740" xmi:uuid="f283134f-d33e-48fc-ab1c-9435591d83bc" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8e001ed_1513937746713_156433_60737"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513937763707_587266_60743" xmi:uuid="56749570-e02b-4111-bdc2-da0b74784c59" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513937798027_275614_60751" xmi:uuid="f47d937b-bdb8-455f-bd92-822abb03bc56" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937763707_587266_60743"/>
          <body>the classifications of the Envelope. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>ClassifiedAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_8e001ed_1513937776349_909952_60749" xmi:uuid="60f55ac9-3dd9-4d4e-b0b6-9fa2cdee3144" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_8e001ed_1513937776349_775543_60750" xmi:uuid="89da920e-ea83-4156-86cf-6993acbdd738" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_8e001ed_1513937774131_308441_60746"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513937802166_868376_60752" xmi:uuid="1a4f59b2-4b98-4330-979a-39d0a58c2177" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513937943494_54312_60760" xmi:uuid="b48ae860-8a5e-4443-81d8-3fde0d46bc36" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937802166_868376_60752"/>
          <body>the request for an acknowledgement of receipt of the Envelope. The value of this attribute need not be specified. On transmission of a Message this attribute shall take one of the values "" (blank), "ask message arrival" or "ask message read". A blank value expects no reply. A value of "ask message arrival" asks if the Message arrived at the recipients' mailbox and requires the reply Envelope to have values "acknowledge arrival" if the Message arrives at the destination, or "delivery failure" if failure of the delivery is detected. &lt;note&gt; Envelope is used to provide an audit trail. There is no assumption that the transmission system has any knowledge of Envelope or its usage. However, if it reports some failure, this can then be recorded in the way described.&lt;/note&gt; A value of "ask message read" asks if the recipient has actually opened the Message to read it and expects the reply "acknowledge read" on success, or "contents corrupt" if it is not possible to for it to be read. &lt;note&gt; For any single Envelope, there should be an acknowledgement per recipient. The acknowledgement will not contain a Message.&lt;/note&gt; &lt;note&gt; The Envelope being acknowledged is referenced using an EnvelopeRelationship.&lt;/note&gt;</body>
        </ownedComment>
        <name>Acknowledge</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193151_806926_23674"/>
        <lowerValue xmi:id="_18_4_1_8e001ed_1513937816405_477426_60755" xmi:uuid="56d8b304-002f-4da7-973e-9dabfce5facc" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
        <association xmi:idref="_18_4_1_8e001ed_1513937858162_605268_60757"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_8e001ed_1513937971105_981337_60762" xmi:uuid="2a5c836b-d276-4be1-9101-c40b1505e01e" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_4_1_8e001ed_1513938014290_74632_60767" xmi:uuid="c82166a5-9c9e-4369-9f3b-f03092b11e73" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513937971105_981337_60762"/>
          <body>the Message that the Envelope is wrapping. A Message should be present unless the Envelope is being used to carry an acknowledgement. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Wrapping</name>
        <visibility>public</visibility>
