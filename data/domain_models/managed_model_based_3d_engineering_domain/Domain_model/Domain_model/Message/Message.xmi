          <annotatedElement xmi:idref="_18_4_1_8e001ed_1513938096827_66900_60844"/>
          <body>the identifier or set of identifiers for the EnvelopeRelationship. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt; </body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
