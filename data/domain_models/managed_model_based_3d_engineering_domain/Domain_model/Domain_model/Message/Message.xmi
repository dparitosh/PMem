      <ownedComment xmi:id="_18_4_1_8e001ed_1513938095111_560698_60843" xmi:uuid="e10b6bfa-a454-46dd-872d-bdc427caebd2" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_8e001ed_1513938062986_923528_60800"/>
        <body>An EnvelopeRelationship is an association of one Envelope with another. &lt;note&gt; The most obvious use of the association is to link an Envelope to its acknowledgements.&lt;/note&gt; </body>
      </ownedComment>
      <name>EnvelopeRelationship</name>
      <generalization xmi:id="_18_4_1_65b021e_1721221107387_315709_148808" xmi:uuid="c6304785-a8a4-4b64-85c4-aa457bd66001" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_65b021e_1719937007191_236673_147578"/>
      </generalization>
