    <packagedElement xmi:id="_18_4_1_e120334_1499417193013_136303_23380" xmi:uuid="55f8e7d5-00f8-4fc9-854e-b2379f8aea26" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_271a0567_1551279295850_708159_95871" xmi:uuid="c1f3f30c-8f1e-4e73-a193-230c595a77f9" xmi:type="uml:Comment">
        <annotatedElement href="../CommonResources/CommonResources.xmi#_18_4_1_290014c_1550847735853_401544_98065"/>
        <body>These flowports are not bound to the ARM target because only an activity property type can be assigned to it.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1454484150653_775557_42863" xmi:uuid="f9511cbb-0af6-4e71-8cc5-5499c60ed38e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193013_136303_23380"/>
        <body> An ActivityRelationship is a relationship between two Activity objects. &lt;example&gt; The activity required to complete a work order, may be decomposed into a series of activities. Their corresponding instances would be Related using instances of the ActivityRelationship entity.&lt;/example&gt;</body>
      </ownedComment>
      <name>ActivityRelationship</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459324024621_880229_42429" xmi:uuid="f374e722-21dd-4975-ae41-b34c5863f07f" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121532_575788_163104" xmi:uuid="a987eebc-f16b-4aba-a78b-2bab8ba7b846" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121532_126911_163105" xmi:uuid="6960d1a3-4886-47a2-873a-acf917b7cf00" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ActivityRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Activity and the relating Activity shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ActivityRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121532_211308_163106" xmi:uuid="e7190b15-aa12-4bdf-a021-a88076cceaa2" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121532_490507_163107" xmi:uuid="14d418d5-3c54-454d-b9da-e413fe9cab6f" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459324061928_410059_42431" xmi:uuid="f2cff370-a7f2-4814-af36-fecb39399f29" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324024621_880229_42429"/>
          <body> the related Activity and the relating Activity shall be different. </body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193013_136303_23380"/>
        <specification xmi:id="_18_4_1_271a0567_1508941681400_967838_33249" xmi:uuid="a37a2cee-2e03-4923-9809-90a5c1b1c7f8" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193341_933624_24301" xmi:uuid="04e8dd1e-7b5c-47ed-92cb-389302670d55" xmi:type="uml:Generalization">
