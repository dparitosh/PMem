      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193342_15661_24310" xmi:uuid="47ce1566-6f39-4c47-933b-8f11dba26e81" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484271379_280446_42865" xmi:uuid="c52c6e4b-49ed-47f2-bfb2-f19060fefca5" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193342_15661_24310"/>
