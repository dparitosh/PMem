    <packagedElement xmi:id="_18_4_1_e120334_1499417193014_295867_23381" xmi:uuid="99575201-fb1b-4ced-adc6-a5b688db00c0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1454484788907_577042_42870" xmi:uuid="57b1c4fd-e0ea-4f87-8eff-4babe8b3fb65" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193014_295867_23381"/>
        <body> An ActualActivity is a type of Activity that is a record of the occurrence of an Activity. The ActualActivity is related through an ActivityHappeningRelationship to the PlannedActivity of which it is an occurrence. The existence of an ActualActivity instance means that the ActualActivity has commenced. &lt;example&gt;The replacement of the tyres of my bicycle, frame number ZH002342, on October 25, 2011.&lt;/example&gt;</body>
      </ownedComment>
      <name>ActualActivity</name>
      <generalization xmi:id="_18_4_1_8e001ed_1513786908244_868563_48237" xmi:uuid="50da51e7-b8ff-43cc-8352-653e8b699a02" xmi:type="uml:Generalization">
        <general href="../RequirementManagementAndVAndV/RequirementManagementAndVAndV.xmi#_18_4_1_8e001ed_1513262749828_373119_62494"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193312_769480_23988" xmi:uuid="cba111b9-dbd6-4c62-8e32-fc4ce314ca2d" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193008_117706_23372"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193343_556392_24317" xmi:uuid="b046e6a4-ac8e-46c9-bcb9-dcaebe5b4a44" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484826366_587359_42871" xmi:uuid="0b094194-25b7-4e3b-b14b-3cb9653bc77f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193343_556392_24317"/>
          <body> the DateTimeString when the ActualActivity finished. The value of this attribute need not be specified. &lt;note&gt; In general, the absence of this date cannot be used to infer that the activity is continuing, only that the end of the activity has not yet been recorded.&lt;/note&gt; &lt;note&gt; A more detailed history of the progress of an activity may be recorded by applying states to the activity, but the meaning of these states must be defined through local business rules.&lt;/note&gt;</body>
        </ownedComment>
        <name>ActualEndDate</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193305_36375_23947"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194191_872210_29682" xmi:uuid="1b64f8f5-e7c4-4214-abed-9258dc8c0dc8" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193343_844707_24318" xmi:uuid="2e6b5ddf-97a2-4a48-82dc-6aae90f39daf" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484841067_517584_42872" xmi:uuid="1da0d6d9-ef95-4d2b-8d2b-aacb0393a44f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193343_844707_24318"/>
          <body> the DateTimeString when the ActualActivity started. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>ActualStartDate</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193305_36375_23947"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194191_969083_29685" xmi:uuid="894c2638-d917-4552-b003-00099f38b8cc" xmi:type="uml:LiteralInteger"/>
        <aggregation>composite</aggregation>
      </ownedAttribute>
