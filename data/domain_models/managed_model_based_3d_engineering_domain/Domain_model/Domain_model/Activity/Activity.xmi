      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193342_29843_24311" xmi:uuid="ad616768-29fa-436c-883f-fa0b059e6788" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484285568_593729_42866" xmi:uuid="0ca04979-0921-40ca-8a0d-cdf0fcc5eea8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193342_29843_24311"/>
          <body> the classifications of the ActivityRelationship. The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>ClassifiedAs</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193038_880755_23447"/>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194190_71455_29670" xmi:uuid="8d6be45b-fe8b-4d8a-97cd-709a93a21b2f" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194190_283498_29669" xmi:uuid="e0673886-5e27-40e8-8101-6bf31312d9fb" xmi:type="uml:LiteralUnlimitedNatural">
          <value>*</value>
        </upperValue>
        <association xmi:idref="_18_4_1_e120334_1499417193341_101663_24307"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193342_787068_24312" xmi:uuid="c49996f3-0a4d-4633-9a31-c529829475b3" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484310616_10950_42867" xmi:uuid="6a8690e1-53ef-4e04-8d7e-b8e72674ee85" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193342_787068_24312"/>
          <body> the meaning of the relationship. Where applicable, the following class names shall be used: &lt;ul&gt;&lt;li&gt;'alternative': The business object defines a relationship where the Related Activity may be used alternatively instead of the relating Activity;&lt;/li&gt; &lt;li&gt;'decomposition': The business object defines a relationship where the Related Activity is one of potentially more sub-activities into which the Relating Activity is broken down;&lt;/li&gt; &lt;li&gt;'derivation': The business object defines a relationship where the Related Activity is derived from the Relating Activity;&lt;/li&gt; &lt;example&gt; An Activity that is controlled by a WorkOrder with OrderType 'manufacturing release' may be derived from (is based on) another Activity controlled by another WorkOrder with OrderType 'design release'..&lt;/example&gt; &lt;li&gt;'exclusiveness': The business object defines a relationship where the Relating and the Related Activity shall not have any overlap in time of execution;&lt;/li&gt; &lt;li&gt;'precedence': The business object defines a relationship where the Related Activity has higher priority than the Relating Activity;&lt;/li&gt; &lt;li&gt;'sequence': The business object defines a relationship where the Relating Activity shall be completed before the Related Activity starts;&lt;/li&gt; &lt;li&gt;'simultaneity': The business object defines a relationship that establishes that both the Relating and Related Activity are considered as occurring during the same time period or shall be performed together in order to ensure consistency and enhance efficiency.&lt;/li&gt;&lt;/ul&gt;</body>
        </ownedComment>
        <name>RelationType</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193042_855579_23449"/>
        <association xmi:idref="_18_4_1_e120334_1499417193341_879809_24308"/>
      </ownedAttribute>
