      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193341_972155_24309" xmi:uuid="efcde8ae-a242-40a0-919f-e5d289f75b0c" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1454484208152_828926_42864" xmi:uuid="30b578de-3333-4073-9fb8-5c692c216090" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193341_972155_24309"/>
          <body> the identifier or set of identifiers for the ActivityRelationship. The value of this attribute need not be specified. &lt;note&gt; This attribute supports multi-identification in different contexts as described in Fundamental concepts and assumptions.&lt;/note&gt;</body>
        </ownedComment>
        <name>Id</name>
        <visibility>public</visibility>
        <type href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193119_518292_23608"/>
