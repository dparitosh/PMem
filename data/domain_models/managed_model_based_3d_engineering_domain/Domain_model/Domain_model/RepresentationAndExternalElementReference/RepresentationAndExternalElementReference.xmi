        <body>A PositiveLengthMeasure is a positive number that represents a length quantity.</body>
      </ownedComment>
      <name>PositiveLengthMeasure</name>
      <ownedRule xmi:id="_18_4_1_8db01ea_1505833453172_80196_29699" xmi:uuid="c598738b-dfc3-473d-8a9b-e6b3ca2e83d6" xmi:type="uml:Constraint">
