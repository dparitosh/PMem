      <ownedConnector xmi:id="_18_4_1_290014c_1535016935181_248156_82461" xmi:uuid="f5095d39-d32c-457f-acff-a9e02fcaa8ef" xmi:type="uml:Connector">
        <visibility>public</visibility>
        <end xmi:id="_18_4_1_290014c_1535016935181_144788_82462" xmi:uuid="4425ddba-c02c-473a-8a52-68f77f2ee7ba" xmi:type="uml:ConnectorEnd">
