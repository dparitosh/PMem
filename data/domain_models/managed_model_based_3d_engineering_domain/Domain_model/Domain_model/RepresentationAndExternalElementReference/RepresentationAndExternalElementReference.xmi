    <packagedElement xmi:id="_18_4_1_e120334_1499417193114_827577_23597" xmi:uuid="182b098d-d00c-4833-b576-adb5d632d2b7" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456304152912_499388_43031" xmi:uuid="a23b46ae-542a-438b-ab4b-9bdc09affddd" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193114_827577_23597"/>
        <body>A GeometricRepresentationRelationshipWithPlacementTransformation is a type of GeometricRepresentationRelationship that specifies a placement transformation by associating two AxisPlacements of the referenced GeometricModels onto each other.</body>
      </ownedComment>
      <name>GeometricRepresentationRelationshipWithPlacementTransformation</name>
      <ownedRule xmi:id="_18_4_1_290014c_1536247906355_834448_191985" xmi:uuid="0548cb73-f29f-40c4-a3c5-0327e53138d7" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943794_143341_151504" xmi:uuid="0f204b0f-58fa-49ef-a00d-2dfa81d91a67" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943794_872574_151505" xmi:uuid="757874eb-53bc-47fe-8fbf-fa90d6009138" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatedUid" value="child::Related/@uidRef"/&gt; &lt;sch:assert test="not(parent::*/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'] is //*[@uid=$relatedUid]/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'])" &gt;(GeometricRepresentationRelationshipWithPlacementTransformation.WR1 &lt;sch:value-of select="$uid"/&gt;) the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671447162744_289029_162989" xmi:uuid="1deac8e5-980b-449b-a734-7cde0f3267ae" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671447162745_217274_162990" xmi:uuid="1325c739-e41d-4ce0-84ef-77bc7b04b497" xmi:type="uml:Comment">
            <body>WR1: SELF\GeometricRepresentationRelationship.Relating.ContextOfItems :&lt;&gt;: SELF\GeometricRepresentationRelationship.Related.ContextOfItems;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_290014c_1536247948892_782420_191987" xmi:uuid="2337212b-735c-41e2-9251-9f2cabdfcbd1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539620855728_930454_104014" xmi:uuid="08a70850-79db-4e81-abc4-a6a8a270216d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1536247948892_782420_191987"/>
            <body>SELF\GeometricRepresentationRelationship.relating.contextOfItems :&lt;&gt;: SELF\GeometricRepresentationRelationship.related.contextOfItems</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_290014c_1536247906355_834448_191985"/>
          <body>the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_827577_23597"/>
        <specification xmi:id="_18_4_1_290014c_1536247906356_101807_191986" xmi:uuid="24e39baa-8ea2-40bc-ad6d-d596eedb83c5" xmi:type="uml:OpaqueExpression">
          <body>self.Relating.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems &lt;&gt; self.Related.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
