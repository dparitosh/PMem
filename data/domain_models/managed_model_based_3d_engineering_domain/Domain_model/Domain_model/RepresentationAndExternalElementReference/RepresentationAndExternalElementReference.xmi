    <packagedElement xmi:id="_18_4_1_e120334_1499417193083_591081_23535" xmi:uuid="d202aea2-f95b-41f4-be04-09942d419c67" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1455200042359_579148_42533" xmi:uuid="0fc98d91-2a94-432e-b241-af437501ac2e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193083_591081_23535"/>
        <body>An EdgeBoundedCurveWithLength is a type of EdgeCurve in which the EdgeStart and EdgeEnd are of type VertexPoint and the EdgeGeometry is of type BoundedCurveWithLength. The VertexGeometry for the EdgeStart and EdgeEnd is constrained to be of type Point and not any subtype of it. If the attribute SameSense is TRUE, then the EdgeStart specifies the start point and the EdgeEnd specifies the end point of the BoundedCurveWithLength.If the attribute is FALSE, then the EdgeStart specifies the end point and the EdgeEnd specifies the start point of the BoundedCurveWithLength.</body>
      </ownedComment>
      <name>EdgeBoundedCurveWithLength</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193639_929266_26553" xmi:uuid="ae67dc93-f261-4eec-9e35-7d09afbe2e75" xmi:type="uml:Generalization">
