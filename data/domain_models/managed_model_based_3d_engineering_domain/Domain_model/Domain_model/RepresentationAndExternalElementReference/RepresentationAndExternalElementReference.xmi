    <packagedElement xmi:id="_18_4_1_e120334_1499417193114_134812_23595" xmi:uuid="04b2e39e-89cb-4158-b928-cef17bd49872" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456304060213_31848_43029" xmi:uuid="e086e68f-0352-4d35-96d4-818aad3ecfc0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193114_134812_23595"/>
        <body>A GeometricRepresentationRelationshipWithCartesianTransformation is a type of GeometricRepresentationRelationship that specifies a CartesianTransformation between the two GeometricCoordinateSpaces of the referenced GeometricModels.</body>
      </ownedComment>
      <name>GeometricRepresentationRelationshipWithCartesianTransformation</name>
      <ownedRule xmi:id="_18_4_1_290014c_1536247632996_474730_191950" xmi:uuid="c6ff733d-49c5-40bc-a625-a76109ac11d5" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671447074730_424480_162985" xmi:uuid="36791c8e-b89e-4661-9b77-0285ba8a50cc" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671447080468_366065_162986" xmi:uuid="5e4e6739-2ce0-41a0-8c9a-dbff93002616" xmi:type="uml:Comment">
            <body>WR1: SELF\GeometricRepresentationRelationship.Relating.ContextOfItems :&lt;&gt;: SELF\GeometricRepresentationRelationship.Related.ContextOfItems;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_290014c_1536247750920_817270_191954" xmi:uuid="b14f1112-4c2c-4fb9-b77a-5b684fddefff" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539620800673_136849_103996" xmi:uuid="2d731e6f-1415-4d4f-a063-5f23f7439dfe" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1536247750920_817270_191954"/>
            <body>SELF\GeometricRepresentationRelationship.relating.contextOfItems :&lt;&gt;: SELF\GeometricRepresentationRelationship.related.contextOfItems</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_290014c_1536247632996_474730_191950"/>
          <body>the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943621_649451_151464" xmi:uuid="cac26105-709f-4dea-86a9-f40dfb980479" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943621_423870_151465" xmi:uuid="eddcfac9-2724-4f39-b46b-853a8f49ee7f" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatedUid" value="child::Related/@uidRef"/&gt; &lt;sch:assert test="not(parent::*/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'] is //*[@uid=$relatedUid]/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'])" &gt;(GeometricRepresentationRelationshipWithCartesianTransformation.WR1 &lt;sch:value-of select="$uid"/&gt;) the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_134812_23595"/>
        <specification xmi:id="_18_4_1_290014c_1536247632997_627507_191951" xmi:uuid="8afb90dd-bdd6-4580-97a7-e02bcad7618f" xmi:type="uml:OpaqueExpression">
          <body>self.Relating.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems &lt;&gt; self.Related.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193714_176087_27132" xmi:uuid="33cd5a82-7c25-4f39-b310-4f740e5c7bfa" xmi:type="uml:Generalization">
