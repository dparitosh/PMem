    <packagedElement xmi:id="_18_4_1_e120334_1499417193112_722991_23591" xmi:uuid="cfed2fcf-59e6-4b8c-9058-831b00315d7a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456303685772_290156_43017" xmi:uuid="872bdd9f-c3a6-4923-9824-373815829717" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193112_722991_23591"/>
        <body>A GeometricCoordinateSpace is a type of RepresentationContext in which geometric elements may be defined. It is either two-dimensional or three-dimensional. An origin for coordinate values is implicitly defined.</body>
      </ownedComment>
      <name>GeometricCoordinateSpace</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459328509752_290653_42573" xmi:uuid="82a762f8-0b10-455b-8c06-f758cc75a449" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943610_693143_151462" xmi:uuid="1475eb3b-d5da-445f-b581-e276b35b92ee" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943610_772260_151463" xmi:uuid="8dd4c6cf-b119-4147-8922-f27aa5166f9c" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="DimensionCount &gt; 0"&gt;(GeometricCoordinateSpace.WR1 &lt;sch:value-of select="$uid"/&gt;) the dimensionality of the GeometricCoordinateSpace shall be greater than 0.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459328541916_833753_42575" xmi:uuid="201997af-39f0-4fbb-87bd-a7f7e2a12fb9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459328509752_290653_42573"/>
          <body> the dimensionality of the GeometricCoordinateSpace shall be greater than 0.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671446903888_304337_162963" xmi:uuid="f6174145-e1c0-4224-877a-67b0fb679f4b" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671446914707_9055_162964" xmi:uuid="0a53a68c-e4a6-4f9f-8319-ab96378c7dfa" xmi:type="uml:Comment">
            <body>WR1: DimensionCount &gt; 0;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193112_722991_23591"/>
        <specification xmi:id="_18_4_1_271a0567_1509037208774_563746_30632" xmi:uuid="03b389ab-65fa-4715-9959-de9b803d9ba3" xmi:type="uml:OpaqueExpression">
          <body>self.DimensionCount &gt; 0</body>
          <language>OCL2.0</language>
