    <packagedElement xmi:id="_18_4_1_e120334_1499417193115_388803_23598" xmi:uuid="64b92d7f-e4fe-4c52-bda3-310326938d35" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456304208817_569327_43034" xmi:uuid="5734c892-af7b-40ff-8a7c-c7351de07211" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193115_388803_23598"/>
        <body>A GeometricRepresentationRelationshipWithSameCoordinateSpace is a type of GeometricRepresentationRelationship without a geometry transformation between the Related and the Relating GeometricModels.</body>
      </ownedComment>
      <name>GeometricRepresentationRelationshipWithSameCoordinateSpace</name>
      <ownedRule xmi:id="_18_4_1_290014c_1536248198474_300676_192256" xmi:uuid="9142fafb-d920-40b6-9a1b-97705e07ead2" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_290014c_1536248231323_125269_192258" xmi:uuid="0d9b677a-5857-4d9d-ab56-c40fe26a41f1" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_271a0567_1539620869696_12057_104017" xmi:uuid="007f8708-5476-4e9b-bcf7-f014ff011d55" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_290014c_1536248231323_125269_192258"/>
            <body>SELF\GeometricRepresentationRelationship.relating.contextOfItems :=: SELF\GeometricRepresentationRelationship.related.contextOfItems</body>
          </ownedComment>
          <annotatedElement xmi:idref="_18_4_1_290014c_1536248198474_300676_192256"/>
          <body>the related and relating GeometricModels shall share the same instance of GeometricCoordinateSpace.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671447194766_190416_162993" xmi:uuid="cec3c5ea-a9eb-4e15-99b5-4388fca86cbc" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671447210111_812592_162994" xmi:uuid="d60b5495-60fe-4357-b025-da350d0b854f" xmi:type="uml:Comment">
            <body>WR1: SELF\RepresentationRelationship.Relating.ContextOfItems :=: SELF\RepresentationRelationship.Related.ContextOfItems;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943786_332946_151502" xmi:uuid="d09231ab-fe01-4489-a4eb-fcc7eab6fc28" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943787_226973_151503" xmi:uuid="75015975-268c-405c-a80f-1206ad33d2ae" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithSameCoordinateSpace']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatedUid" value="child::Related/@uidRef"/&gt; &lt;sch:assert test="parent::*/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'] is //*[@uid=$relatedUid]/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace']" &gt;(GeometricRepresentationRelationshipWithSameCoordinateSpace.WR1 &lt;sch:value-of select="$uid"/&gt;) the related and relating GeometricModels shall share the same instance of GeometricCoordinateSpace.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193115_388803_23598"/>
        <specification xmi:id="_18_4_1_290014c_1536248198474_811096_192257" xmi:uuid="d5e36a8c-33cb-429c-a56a-30036d81f9f2" xmi:type="uml:OpaqueExpression">
          <body>self.Relating.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems = self.Related.oclAsType(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::GeometricModel).ContextOfItems</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193714_753242_27137" xmi:uuid="4506c7d1-c523-40f0-be58-5bef1f7034fe" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193113_402655_23594"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_290014c_1509635359163_254882_31213" xmi:uuid="0113c610-2363-423e-926c-9e9cdd01b57a" xmi:type="uml:Port">
        <name>geometricRepresentationRelationshipWithSameCoordinateSpace</name>
        <visibility>public</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-Definitional_representation_relationship"/>
        <aggregation>composite</aggregation>
