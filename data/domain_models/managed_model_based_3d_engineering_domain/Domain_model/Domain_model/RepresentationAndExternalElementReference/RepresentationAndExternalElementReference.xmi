    <packagedElement xmi:id="_18_4_1_290014c_1542202168630_617202_140004" xmi:uuid="33bbbb3f-36dc-423e-995b-4dbcc8a7c9df" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_290014c_1542202168630_163698_140005"/>
      <memberEnd xmi:idref="_18_4_1_290014c_1542202165624_526862_139938"/>
      <ownedEnd xmi:id="_18_4_1_290014c_1542202168630_163698_140005" xmi:uuid="4ffe33c2-1aea-45bd-b298-6890f1db68e6" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_8db01ea_1539010334484_146949_120037"/>
        <association xmi:idref="_18_4_1_290014c_1542202168630_617202_140004"/>
