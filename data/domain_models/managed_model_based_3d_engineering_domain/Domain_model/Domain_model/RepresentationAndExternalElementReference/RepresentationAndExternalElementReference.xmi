      <ownedEnd xmi:id="_18_4_1_271a0567_1512753391976_591601_210164" xmi:uuid="eb46cd6e-47ab-42ce-a0d7-10a8fb898273" xmi:type="uml:Property">
        <visibility>private</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193222_666164_23810"/>
        <association xmi:idref="_18_4_1_271a0567_1512753391976_693964_210163"/>
      </ownedEnd>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193114_970653_23596" xmi:uuid="a277b2dc-fee4-4b3c-9bf1-85e22eb1fa1e" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_2_8db01ea_1456217844297_543106_42986" xmi:uuid="2dba4c56-e9e0-4e9c-a8b0-15a7e028a3b4" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193114_970653_23596"/>
        <body>&lt;note&gt; &lt;ul&gt;&lt;li&gt;For users and implementers, note that the structure is not intended for Geometric Modeling. It is intended for traceability and verification purposes of the structure of the electrical wiring harness.&lt;/li&gt; &lt;li&gt;To support wiring harness design requirements, the entities GeometryToTopologyModelAssociation and TopologyToGeometryModelAssociation, which are subtypes of RepresentationRelationship, are based on WiringHarnessAssemblyDesign, which is a subtype of AssemblyDefinition. GeometryToTopologyModelAssociation and TopologyToGeometryModelAssociation are referenced by an AssemblyOccurrenceRelationship. The design intent of the information model is to create one or more pairwise allocation associations between geometric elements and topological elements specific to electrical wire harness design. This specific usage of AssemblyOccurrenceRelationship is restricted to WiringHarnessAssemblyDesign.&lt;/li&gt;&lt;/ul&gt; &lt;/note&gt; A TopologyToGeometryModelAssociation is a type of RepresentationRelationship that defines a set of binary associations between a topological origin item and a geometric target item. This association is not definitional and therefore will not bring the definition of the source into the target model. This set of binary associations is realized by a list of origin items and a list of target items that are coordinated so that the first origin item corresponds to the first target item, the second to the second and so on. The number of items on the origin and target sides shall be the same. </body>
      </ownedComment>
      <name>TopologyToGeometryModelAssociation</name>
      <ownedRule xmi:id="_18_4_1_45e01bd_1597350719025_25701_88481" xmi:uuid="0c0982bd-ec3a-4ce0-a761-0a4906d1bc45" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943770_581072_151498" xmi:uuid="4030a0de-668d-4d57-b873-96eb50c3eac4" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943770_997889_151499" xmi:uuid="de54c32f-81af-454f-845a-a278faf05d2d" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="child::Definitional='false'"&gt;(TopologyToGeometryModelAssociation.WR3 &lt;sch:value-of select="$uid"/&gt;) a TopologyToGeometryModelAssociation shall not be definitional.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_45e01bd_1597350735820_971167_88489" xmi:uuid="d2a5ca38-3e3b-4d01-b7c9-a298807fdef6" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_45e01bd_1597350719025_25701_88481"/>
          <body>a TopologyToGeometryModelAssociation shall not be definitional.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671463062774_499135_163102" xmi:uuid="fb7bbd77-fdc9-4ec7-9165-8656e114ff82" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463062774_917358_163103" xmi:uuid="947627a9-bb64-4d10-98ae-a47418be6f38" xmi:type="uml:Comment">
            <body>WR3: SELF\RepresentationRelationship.Definitional = FALSE;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR3</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_970653_23596"/>
        <specification xmi:id="_18_4_1_45e01bd_1597350719026_812555_88482" xmi:uuid="1d157b47-a616-49c5-850c-42ede047ce98" xmi:type="uml:OpaqueExpression">
          <body>self.Definitional = DataTypes::Boolean::False</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_45e01bd_1597350684982_225122_88474" xmi:uuid="84377aa6-c313-4382-ad1c-538c6bdf9b18" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943754_505539_151494" xmi:uuid="00fd1e47-d607-4388-9aa2-5f9c90febf5e" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943754_857587_151495" xmi:uuid="e75ed6a2-d138-40d9-9213-daa68a3adc8d" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="assemblyContext" value="//*[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true() and child::Placement/child::TopologyToGeometryModelAssociation/@uidRef = $uid]"/&gt; &lt;sch:assert test="count($assemblyContext)=0 or (every $i in $assemblyContext satisfies substring-after($i/parent::*/@xsi:type,':')='WiringHarnessAssemblyDesign')"&gt;(TopologyToGeometryModelAssociation.WR2 &lt;sch:value-of select="$uid"/&gt;) a TopologyToGeometryModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_45e01bd_1597350710212_666343_88480" xmi:uuid="743b0663-a74b-4dba-831a-6beed4cf5030" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_45e01bd_1597350684982_225122_88474"/>
          <body>a TopologyToGeometryModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671463058221_208868_163100" xmi:uuid="a80920cb-221d-487f-93bb-df5e88f421ba" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463058223_932515_163101" xmi:uuid="6fb20c65-3c49-4604-9343-6f5b689ea24a" xmi:type="uml:Comment">
            <body>WR2: SIZEOF(QUERY( ac &lt;* AssemblyContext | NOT (SCHEMA_NAME + '.' + 'WiringHarnessAssemblyDesign' IN TYPEOF(ac\AssemblyOccurrenceRelationship.Relating)))) = 0;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR2</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_970653_23596"/>
        <specification xmi:id="_18_4_1_45e01bd_1597350684983_984585_88475" xmi:uuid="744df284-df5d-4d23-8f56-80d5f32e9e8e" xmi:type="uml:OpaqueExpression">
          <body>self.AssemblyContext-&gt;reject(ac | ac.Relating.oclIsKindOf(Application_protocols::AP242::Domain_model::ElectricalHarness::WiringHarnessAssemblyDesign))-&gt;size() = 0</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_18_4_1_271a0567_1551271605441_248105_94419" xmi:uuid="bcd77e2d-6d02-4bc8-a421-9fcb5e407600" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943762_540136_151496" xmi:uuid="3005e7d5-05c0-4b5d-953a-addb98c55caf" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943763_642959_151497" xmi:uuid="00a51727-8094-47ac-90c9-1d5243cf89dc" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="count(child::Target/child::*) = count(child::Origin/child::*)"&gt;(TopologyToGeometryModelAssociation.WR1 &lt;sch:value-of select="$uid"/&gt;) the size of Target list shall be the same as the size of the Origin list.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_271a0567_1551272182395_535938_94421" xmi:uuid="6dcbfe91-52b2-44dc-b719-e23796e8f0bd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1551271605441_248105_94419"/>
          <body>the size of Target list shall be the same as the size of the Origin list.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671463053063_182043_163098" xmi:uuid="743a4b36-1759-4192-a1e8-e4bc98eb8efb" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463053075_818515_163099" xmi:uuid="2a73f370-f79d-46d8-8cf6-d56a1ce669ba" xmi:type="uml:Comment">
            <body>WR1: SIZEOF(Origin) = SIZEOF(Target);</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_970653_23596"/>
        <specification xmi:id="_18_4_1_271a0567_1551271605457_181129_94420" xmi:uuid="6c8bcc59-3897-4d1a-8805-ffad76b11650" xmi:type="uml:OpaqueExpression">
          <body>self.Origin-&gt;size() = self.Target-&gt;size()</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193714_931479_27133" xmi:uuid="90370f37-20d2-4f78-b8bd-0055c9e7945c" xmi:type="uml:Generalization">
