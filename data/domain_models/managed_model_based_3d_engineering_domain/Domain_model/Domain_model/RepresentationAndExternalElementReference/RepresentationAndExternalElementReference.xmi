    <packagedElement xmi:id="_18_4_1_e120334_1499417193113_402655_23594" xmi:uuid="d633b378-6983-4431-ae77-7f5671d71960" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456303957509_861443_43022" xmi:uuid="88878bdb-58c4-456e-a078-cd4293803559" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193113_402655_23594"/>
        <body>A GeometricRepresentationRelationship is a type of RepresentationRelationship that specifies an association between two GeometricRepresentation objects. A GeometricRepresentationRelationship is either a GeneralGeometricRepresentationRelationship, a GeometricRepresentationRelationshipWithCartesianTransformation, a GeometricRepresentationRelationshipWithPlacementTransformation or a GeometricRepresentationRelationshipWithSameCoordinateSpace.</body>
      </ownedComment>
      <name>GeometricRepresentationRelationship</name>
