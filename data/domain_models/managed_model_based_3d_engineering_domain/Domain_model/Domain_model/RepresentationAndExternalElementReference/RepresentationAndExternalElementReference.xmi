        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_8db01ea_1505833409534_836596_29694"/>
        <specification xmi:id="_18_4_1_8db01ea_1505833453172_29557_29700" xmi:uuid="c9d5e3ec-a4cf-4e1c-9701-5683d1fbc332" xmi:type="uml:OpaqueExpression">
