    <packagedElement xmi:id="_18_4_1_e120334_1499417193275_475364_23890" xmi:uuid="354cc4b1-69eb-450a-840b-84913d6d0621" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456304540730_1219_43041" xmi:uuid="fc266ed5-aa56-4f8b-8187-7e4686a18115" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193275_475364_23890"/>
        <body>A TransformedGeometricModel is a type of GeometricModel that is the transformation result of another GeometricModel.</body>
      </ownedComment>
      <name>TransformedGeometricModel</name>
      <ownedRule xmi:id="_18_0_5_45e01bd_1459333302905_353739_42761" xmi:uuid="38913396-59e5-40fe-a4c9-d3f71282ad0a" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671463087310_923802_163104" xmi:uuid="723a0a93-ecf5-4bd4-8dce-b265de0c67cd" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671463100170_167286_163105" xmi:uuid="bb6718dd-3588-484a-8956-476510a0246a" xmi:type="uml:Comment">
            <body>WR1: (SCHEMA_NAME + '.' + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHOPERATORTRANSFORMATION' IN TYPEOF(DerivedFrom)) OR (SCHEMA_NAME + '.' + 'GEOMETRICREPRESENTATIONRELATIONSHIPWITHPLACEMENTTRANSFORMATION' IN TYPEOF(DerivedFrom));</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_0_5_45e01bd_1459333437481_806142_42763" xmi:uuid="80cb7b3d-6cdb-4e9a-9317-5416290ccd1c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333302905_353739_42761"/>
          <body> the value of DerivedFrom shall either be of type GeometricRepresentationRelationshipWithCartesianTransformation or GeometricRepresentationRelationshipWithPlacementTransformation.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943838_515217_151516" xmi:uuid="ab0e8664-5503-4648-b1bb-db80cdde89f9" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943839_221319_151517" xmi:uuid="8f1fa0ae-5d45-4c4e-b8e4-551a8124d21d" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Representation[@uid and substring-after(@xsi:type,':')='TransformedGeometricModel']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatedRepresentationRelationships" value="//RepresentationRelationship[child::Related[@uidRef= $uid]]"/&gt; &lt;sch:assert test="count($relatedRepresentationRelationships)&gt;0 and (every $i in $relatedRepresentationRelationships satisfies ( (substring-after($i/@xsi:type,':')= 'GeometricRepresentationRelationshipWithCartesianTransformation') or (substring-after($i/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation')))"&gt;(TransformedGeometricModel.WR1 &lt;sch:value-of select="$uid"/&gt;) the value of DerivedFrom shall either be of type GeometricRepresentationRelationshipWithCartesianTransformation or GeometricRepresentationRelationshipWithPlacementTransformation.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193275_475364_23890"/>
        <specification xmi:id="_18_4_1_271a0567_1509354928046_297430_30700" xmi:uuid="90c755f1-32dd-4cfe-8fbd-8d6c933451d4" xmi:type="uml:OpaqueExpression">
          <body>self.DerivedFrom.oclIsTypeOf(GeometricRepresentationRelationshipWithCartesianTransformation) or self.DerivedFrom.oclIsTypeOf(GeometricRepresentationRelationshipWithPlacementTransformation)</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193711_273203_27112" xmi:uuid="c5f677ef-b9e9-42d1-9d4a-d381a27695e7" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193112_285418_23592"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417194102_819416_29118" xmi:uuid="1c1a52dc-9be7-4850-946f-1b7f8de69625" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456304554108_814583_43042" xmi:uuid="28b58b49-da70-4503-9f2d-f9d97265eceb" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194102_819416_29118"/>
          <body> the set of AxisPlacements or CartesianTransformations that are needed to transform the source model or to transform this model further.</body>
