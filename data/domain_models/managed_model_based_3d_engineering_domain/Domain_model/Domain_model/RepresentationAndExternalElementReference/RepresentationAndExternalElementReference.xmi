          <annotatedElement xmi:idref="_18_4_1_271a0567_1550496671464_449459_171039"/>
          <body>if TRUE makes the related Representation part of the definition of the relating Representation. </body>
        </ownedComment>
        <name>Definitional</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#BOOLEAN"/>
        <aggregation>composite</aggregation>
