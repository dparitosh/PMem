        <general xmi:idref="_18_4_1_e120334_1499417193025_982067_23413"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193397_930999_24787" xmi:uuid="d3432852-8431-457b-abf1-725b18432c0a" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193072_543741_23516"/>
      </generalization>
      <generalization xmi:id="_18_4_1_91401df_1619775426776_296856_98431" xmi:uuid="d7e8c75f-ce4b-44af-8353-0adc5b50355a" xmi:type="uml:Generalization">
        <general href="../AnnotatedModelPresentation/AnnotatedModelPresentation.xmi#_18_4_1_91401df_1619773323940_321835_97984"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193399_414383_24805" xmi:uuid="ba94ca37-8bfe-4b3e-92e7-ede739daf7c2" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456498273689_233860_42684" xmi:uuid="839b3d65-8eef-429f-b2cd-a4c35c83cb0b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193399_414383_24805"/>
          <body> the relative x, y and optionally z value specifying the direction of the local Z-axis of the AxisPlacement. The value of this attribute need not be specified. If Axis is not provided and the size of Position is 3, then Axis shall be assumed to have the value (0, 0, 1).</body>
        </ownedComment>
        <name>Axis</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193306_113204_23949"/>
        <isOrdered>true</isOrdered>
        <isUnique>false</isUnique>
        <lowerValue xmi:id="_18_4_1_e120334_1499417194234_64919_30103" xmi:uuid="b4118f5d-06e6-40d0-9f0b-905137d4efd8" xmi:type="uml:LiteralInteger"/>
        <upperValue xmi:id="_18_4_1_e120334_1499417194234_478355_30102" xmi:uuid="2f3fcd5a-effb-4424-a337-debc84095b9d" xmi:type="uml:LiteralUnlimitedNatural">
          <value>3</value>
        </upperValue>
        <aggregation>composite</aggregation>
