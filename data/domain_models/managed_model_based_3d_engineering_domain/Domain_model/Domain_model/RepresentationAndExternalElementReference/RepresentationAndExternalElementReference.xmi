        <ownedComment xmi:id="_18_4_1_8db01ea_1539359182219_441874_98115" xmi:uuid="2da30cae-fa71-4bbc-8637-aab9079ed4cd" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_8db01ea_1539073444017_42392_170230"/>
          <body> the DigitalFile that contains the externally defined geometry information.</body>
        </ownedComment>
        <name>ExternalFile</name>
        <visibility>public</visibility>
        <type href="../DocumentManagement/DocumentManagement.xmi#_18_4_1_e120334_1499417193073_781747_23518"/>
