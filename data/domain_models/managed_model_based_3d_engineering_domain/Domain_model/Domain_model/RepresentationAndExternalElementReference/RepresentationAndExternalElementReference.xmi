    <packagedElement xmi:id="_18_4_1_e120334_1499417193098_672769_23564" xmi:uuid="de4cb6ac-9cef-40b4-9b93-6a5fd4290ae3" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_4_1_290014c_1538398337592_304112_88950" xmi:uuid="1e8b8852-39fc-4160-ba52-fc9b91be3114" xmi:type="uml:Comment">
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Assigned_document_property-described_element"/>
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-Classification_assignment-items"/>
        <annotatedElement href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_2_attr_SYSML_ARM-External_source_identification-item"/>
        <body>Entities like Description_text_assignment, Classification_assignment, Identification_assignment, etc. have their items property unmapped in the mapping specification since they have to be completed where used.</body>
      </ownedComment>
      <ownedComment xmi:id="_18_0_5_45e01bd_1456303566851_367693_43000" xmi:uuid="4c07f139-6f6c-480f-9698-59fc7dc44129" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193098_672769_23564"/>
        <body>An ExternalItem is an item that is not included in the data exchange file and is defined in an external library or document.</body>
      </ownedComment>
      <name>ExternalItem</name>
      <ownedRule xmi:id="_18_4_1_e120334_1499417193680_997208_26873" xmi:uuid="a2b403a5-a757-442d-b522-2d2aab25dd75" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671466517034_459443_163135" xmi:uuid="6d767ebf-4b3d-4494-9f61-7f3f87db6d8a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671466530756_600530_163136" xmi:uuid="a8c24db7-37b2-4ff8-b226-810c6ecbb1ab" xmi:type="uml:Comment">
            <body>UR1: Id, Source;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_8db01ea_1513613209580_389408_44249" xmi:uuid="9fac09be-2e8d-474d-9dc5-374b5d7bcf99" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193680_997208_26873"/>
          <body>the combination of id and source shall be unique. </body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943803_344391_151506" xmi:uuid="ecab6aa2-ff8d-4dc7-a571-fd932c0f612a" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943803_654992_151507" xmi:uuid="82b1b4a6-f128-41a8-88ae-865453df12f1" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//External[@uid] |//ExternalItem[@uid]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="id" value="if (Id/@id) then (Id/@id) else (concat(Id/Identifier/@id, Id/Identifier/@idRoleRef, Id/Identifier/@idContextRef)) "/&gt; &lt;sch:let name="source" value="if (Source/*/@uidRef) then (Source/*/@uidRef) else ( if (Source/Identifier) then (concat(Source/Identifier/@id, Source/Identifier/@idRoleRef, Source/Identifier/@idContextRef)) else Source/IdentifierString)"/&gt; &lt;sch:assert test="every $i in (//External[@uid != $uid] |//ExternalItem[@uid != $uid]) satisfies not($id = ( if ($i/Id/@id) then ($i/Id/@id) else (concat($i/Id/Identifier/@id, $i/Id/Identifier/@idRoleRef, $i/Id/Identifier/@idContextRef))) and $source = ( if ($i/Source/*/@uidRef) then ($i/Source/*/@uidRef) else ( if ($i/Source/Identifier) then (concat($i/Source/Identifier/@id, $i/Source/Identifier/@idRoleRef, $i/Source/Identifier/@idContextRef)) else $i/Source/IdentifierString)) )"&gt;(ExternalItem.WR1 &lt;sch:value-of select="$uid"/&gt;) the combination of id and source shall be unique.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193098_672769_23564"/>
        <specification xmi:id="_18_4_1_e120334_1499417194484_372454_32051" xmi:uuid="ef46a849-05f9-479f-8e07-75789bec58dd" xmi:type="uml:OpaqueExpression">
          <body>ExternalItem::allInstances()-&gt;isUnique(Sequence{Id, Source})</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_e120334_1499417193652_625240_26688" xmi:uuid="15fb1a7d-7559-41ff-8574-d20215afac20" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193085_557055_23539"/>
