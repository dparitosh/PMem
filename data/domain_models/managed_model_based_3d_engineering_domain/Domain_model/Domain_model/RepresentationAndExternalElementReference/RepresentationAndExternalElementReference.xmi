    <packagedElement xmi:id="_18_4_1_e120334_1499417193098_342130_23563" xmi:uuid="3e782382-c846-4524-b574-611faaa84a5a" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456303491088_761695_42996" xmi:uuid="332a1e06-dc63-490e-ab67-57a997ed2285" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193098_342130_23563"/>
        <body>An ExternalGeometricModel is a type of GeometricModel that contains geometry in a three-dimensional context only.</body>
      </ownedComment>
      <name>ExternalGeometricModel</name>
      <ownedRule xmi:id="_18_4_1_65b021e_1701270829918_685511_160525" xmi:uuid="79213bd6-01d3-47a2-9f1a-8fbca9b08408" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1701270829921_697_160527" xmi:uuid="18be0e0c-7bdf-4416-b2fe-e2f98c21befe" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1701270829918_685511_160525"/>
          <body>each DetailedGeometricModelItem shall be either an axis placement or externally defined. &lt;note&gt;In case of an axis placement, the axis placement can be externally defined.&lt;/note&gt;</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1714741943778_552248_151500" xmi:uuid="4e8adb1d-ea34-44ff-b432-c6210ae123c7" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1714741943778_117892_151501" xmi:uuid="13743891-7716-462d-bc35-1df8b2bec6e5" xmi:type="uml:Comment">
            <body>&lt;sch:rule context="//Representation[@uid and local-fn:testXsiTypeExternalGeometricModel(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="every $i in Items/*/@uidRef satisfies ( substring-after(//*[@uid=$i]/@xsi:type,':')='AxisPlacement' or (count(//*[@uid=$i]/External) &gt; 0) or (count(//ExternalRefBaseObject[@uid = $i]) &gt; 0))"&gt; (ExternalGeometricModel.WR1 &lt;sch:value-of select="$uid"/&gt;) each DetailedGeometricModelItem shall be either an axis placement or externally defined.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193098_342130_23563"/>
        <specification xmi:id="_18_4_1_65b021e_1701270829920_972311_160526" xmi:uuid="4fdd47d4-9041-47cc-ad8f-a49468215360" xmi:type="uml:OpaqueExpression">
          <body>self.Items-&gt;forAll(item | item.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::AxisPlacement) or not(item.External.oclIsUndefined()))</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_8db01ea_1513348650085_551720_85693" xmi:uuid="75437a3d-5757-4f3e-ab76-cdd0fb172ce5" xmi:type="uml:Generalization">
        <general href="../Kinematics/Kinematics.xmi#_18_4_1_8db01ea_1513348505077_452992_85560"/>
      </generalization>
      <generalization xmi:id="_18_4_1_e120334_1499417193675_738197_26847" xmi:uuid="ba6f1429-747f-4ae7-8be4-a4d7487c581b" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193112_285418_23592"/>
      </generalization>
