      <ownedRule xmi:id="_19_0_4_2840147_1723210572690_355707_60680" xmi:uuid="6aa93631-4531-4605-843d-c236947057f9" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_19_0_4_2840147_1723210585919_584157_60682" xmi:uuid="40ba1faa-f317-4d5c-87fe-202464627171" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_2840147_1723210572690_355707_60680"/>
          <body>in case of Kind is 'gear_pair', 'linear_flexible_and_pinion_pair', 'rack_and_pinion_pair', 'composed_homokinetic_pair': only two Pairs and one CouplingRatio or one Radius are involved.</body>
        </ownedComment>
