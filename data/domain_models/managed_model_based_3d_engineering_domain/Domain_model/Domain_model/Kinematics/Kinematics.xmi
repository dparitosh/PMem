          <value xmi:id="_18_4_1_271a0567_1522152586650_614280_200297" xmi:uuid="5953c0ac-b36c-4bdf-9d19-0dfbf9ae5911" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-curve_transition_code-continuous"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194167_238802_29469" xmi:uuid="14e7b4b3-1073-4da6-827f-de77c1c00498" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299871223_24218_42918" xmi:uuid="db6f0f22-6543-4687-95b9-12894e6ea453" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194167_238802_29469"/>
          <body> the motion segments do not join; the motion is interrupted.</body>
        </ownedComment>
        <name>discontinuous</name>
        <slot xmi:id="_18_4_1_271a0567_1522152608035_199789_200300" xmi:uuid="ba1c43e8-21d3-47c7-ad6d-097a2a2b2bb0" xmi:type="uml:Slot">
