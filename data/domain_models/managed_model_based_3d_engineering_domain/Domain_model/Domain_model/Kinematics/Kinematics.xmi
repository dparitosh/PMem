        <name>LowOrderKinematicPairCombinator</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1537962028248_544292_110398" xmi:uuid="1ec8ff1e-0a10-4870-ab86-bb965fe8d4c5" xmi:type="uml:Constraint">
