        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193139_596819_23641"/>
        <body>A LinkMotionAlongPath is a type of GeometricRepresentation for the definition of parameter or time coordinated movements of one or several links along paths in space.</body>
      </ownedComment>
      <name>LinkMotionAlongPath</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193712_453377_27123" xmi:uuid="447c0f88-6b39-49cb-9d24-7051b9a21c47" xmi:type="uml:Generalization">
