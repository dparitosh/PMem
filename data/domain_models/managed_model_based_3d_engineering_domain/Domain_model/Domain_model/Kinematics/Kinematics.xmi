          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193782_790662_27546"/>
          <body> the kind of interpolation from this segment to the next segment in the sequence, or in the case this segment is the last in the sequence to the first segment.</body>
        </ownedComment>
        <name>Interpolation</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193297_295524_23932"/>
