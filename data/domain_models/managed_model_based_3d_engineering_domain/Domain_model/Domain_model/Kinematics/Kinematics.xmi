    <packagedElement xmi:id="_18_4_1_271a0567_1540284672574_446980_127378" xmi:uuid="7f23843e-88c1-4f09-b399-e53510b032b1" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_271a0567_1540284672575_60493_127379"/>
      <memberEnd xmi:idref="_18_4_1_271a0567_1540284672415_866305_127374"/>
      <ownedEnd xmi:id="_18_4_1_271a0567_1540284672575_60493_127379" xmi:uuid="ea792c53-a5f0-4f79-af27-1a18827cedff" xmi:type="uml:Property">
