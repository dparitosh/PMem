        <name>HighOrderKinematicPairCombinator</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1536756571651_116030_170009" xmi:uuid="7f596a40-3ef4-40b5-994a-dbdb0cd5a1dd" xmi:type="uml:Constraint">
