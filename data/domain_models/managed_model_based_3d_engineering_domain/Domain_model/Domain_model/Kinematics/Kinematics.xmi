      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193781_842048_27541" xmi:uuid="d58db3f5-aec7-4f3e-a87e-197270979f28" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455112516963_909516_42398" xmi:uuid="2356ff04-1962-4f5b-b56d-c499fd7c21e8" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193781_842048_27541"/>
          <body> the set of InterpolatedConfigurationSequences that define the InterpolatedConfigurationModel.</body>
        </ownedComment>
