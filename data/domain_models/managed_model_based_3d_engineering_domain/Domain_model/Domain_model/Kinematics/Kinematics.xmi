      <ownedAttribute xmi:id="_19_0_4_2840147_1722866674300_380605_60222" xmi:uuid="31c429ae-e55a-4274-9a55-10da3c3258c5" xmi:type="uml:Property">
        <ownedComment xmi:id="_19_0_4_2840147_1722867121045_329626_60234" xmi:uuid="a226f2e9-f8da-4ad2-8f9e-55704607a110" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_2840147_1722866674300_380605_60222"/>
          <body>the displacement speed of one pair relatively to the other pairs within a coupler of Kind 'two_joint_coupler' or 'three_joint_coupler'. It is a decimal value without unit and can be positive (the movement is in Z axis direction of the joint) or negative (the movement is against the Z axis direction of the joint). The value of this attribute need not be specified.</body>
        </ownedComment>
        <name>Scales</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#REAL"/>
        <isOrdered>true</isOrdered>
        <isUnique>false</isUnique>
        <lowerValue xmi:id="_19_0_4_2840147_1722866717106_295535_60225" xmi:uuid="d5108827-c1b5-4b03-b1b2-82f640cc158a" xmi:type="uml:LiteralInteger"/>
