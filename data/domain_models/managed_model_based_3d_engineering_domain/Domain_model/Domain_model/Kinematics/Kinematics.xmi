    <packagedElement xmi:id="_18_4_1_e120334_1499417193297_295524_23932" xmi:uuid="3db1aa10-6943-4a2e-96ac-afe8a13b6bcd" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456299496466_733813_42894" xmi:uuid="dcc42605-0514-47df-b05c-b9d4ec692703" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193297_295524_23932"/>
        <body>An InterpolationTypeEnum type lists the possible types of an InterpolatedConfigurationSegment.</body>
      </ownedComment>
      <name>InterpolationTypeEnum</name>
      <ownedAttribute xmi:id="_18_4_1_8db01ea_1516289641693_449810_79137" xmi:uuid="20f8303e-9de4-43b4-85e7-28e17ea4636c" xmi:type="uml:Property">
        <name>arm_mapping</name>
        <visibility>private</visibility>
        <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-interpolation_type"/>
        <isReadOnly>true</isReadOnly>
      </ownedAttribute>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_668663_29303" xmi:uuid="e5a71a29-e840-4c9d-b90d-101c856bca9d" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299509542_895278_42895" xmi:uuid="ab06039a-a6ad-4789-901f-c0edd163b28f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_668663_29303"/>
          <body> an interpolation in which all pair parameters shall match the set of pair parameter values defined in the next configuration definition.</body>
        </ownedComment>
        <name>undefined_interpolation_type</name>
        <slot xmi:id="_18_4_1_8db01ea_1516289725589_784589_79138" xmi:uuid="be031964-06f8-4245-ac64-ba27752b93cb" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
          <value xmi:id="_18_4_1_8db01ea_1516289725636_154660_79139" xmi:uuid="9f26c6cc-b03e-4789-8587-baa26374343d" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-undefined_interpolation_type"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_454658_29304" xmi:uuid="ac1cdfbd-3e99-40bf-b9ab-3f7fb9073611" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299519069_690909_42896" xmi:uuid="069fc58b-4829-41ba-92cd-3adeb48fa421" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_454658_29304"/>
          <body> the pair parameters are changing abruptly.</body>
        </ownedComment>
        <name>discontinuous_interpolation_type</name>
        <slot xmi:id="_18_4_1_8db01ea_1516289738521_531121_79140" xmi:uuid="abc63930-5c0a-4899-887b-461d44b692f2" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
          <value xmi:id="_18_4_1_8db01ea_1516289738537_478841_79141" xmi:uuid="d0caae0d-2723-4683-b7dc-6dff9ef7661e" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-discontinuous_interpolation_type"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_493508_29305" xmi:uuid="f264b3c7-afac-4786-a96b-51538847c58c" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299528539_330192_42897" xmi:uuid="23b080d2-2b6f-4b32-8871-98fe2599ef9c" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_493508_29305"/>
          <body> an interpolation in which all pair parameters are interpolated such that the pair parameters pass from one value to the next one at the same rate. The rate may vary proportionally among the pairs.</body>
        </ownedComment>
        <name>synchronous_interpolation_type</name>
        <slot xmi:id="_18_4_1_8db01ea_1516289760564_908400_79142" xmi:uuid="b57a23ae-8d2e-41b9-8ce5-f31db450e16f" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
          <value xmi:id="_18_4_1_8db01ea_1516289760580_721083_79143" xmi:uuid="c7801367-7749-4fde-9abf-abb9159792e8" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-synchronous_interpolation_type"/>
          </value>
        </slot>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_839892_29306" xmi:uuid="4f93c44f-672d-458a-b547-183b26d7435c" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299539029_374915_42898" xmi:uuid="b92e9cfc-1a6e-4741-8d91-915b7ee0110b" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_839892_29306"/>
          <body> an interpolation in which all pair parameters are interpolated such that the pair parameters pass from one value to the next one at the same rate. The rate remains constant.</body>
        </ownedComment>
        <name>linear_interpolation_type</name>
        <slot xmi:id="_18_4_1_8db01ea_1516289775540_259887_79144" xmi:uuid="529e2fd4-b529-43a7-afa0-6f3585b47884" xmi:type="uml:Slot">
          <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
          <value xmi:id="_18_4_1_8db01ea_1516289775540_713416_79145" xmi:uuid="cacee56e-44df-48f2-b414-30de91e06c7a" xmi:type="uml:InstanceValue">
            <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-linear_interpolation_type"/>
          </value>
        </slot>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_8db01ea_1516633118225_926599_103975" xmi:uuid="3e185e9d-a185-49bc-b75e-f787e1dc3936" xmi:type="uml:Association">
      <memberEnd xmi:idref="_18_4_1_8db01ea_1516633118225_265332_103976"/>
      <memberEnd xmi:idref="_18_4_1_8db01ea_1516633116005_384376_103741"/>
      <ownedEnd xmi:id="_18_4_1_8db01ea_1516633118225_265332_103976" xmi:uuid="9283dbd7-97dc-41f8-853e-de04439baaa9" xmi:type="uml:Property">
