        <name>KinematicPairValueCombinator</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1540297243998_139490_128341" xmi:uuid="b7808a82-ee86-4e2b-8b8a-5130e3fd2939" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676051736374_714051_173729" xmi:uuid="8b382f82-0059-4d14-a64e-9a4d58074345" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1540297243998_139490_128341"/>
            <body>return the defined input.</body>
          </ownedComment>
          <name>kinematicPairValueCombinator</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1540297243985_887175_128339"/>
          <specification xmi:id="_18_4_1_271a0567_1540297244140_161042_128369" xmi:uuid="ebe48b7f-d29d-4d8d-8085-d7bab97edac5" xmi:type="uml:OpaqueExpression">
            <body>output = if not inLinearFlexibleAndPlanarCurvePair.oclIsUndefined() then inLinearFlexibleAndPlanarCurvePair else if not inPlanarCurvePair.oclIsUndefined() then inPlanarCurvePair else if not inPointOnPlanarCurvePair.oclIsUndefined() then inPointOnPlanarCurvePair else if not inSurfacePair.oclIsUndefined() then inSurfacePair else if not inRollingCurvePair.oclIsUndefined() then inRollingCurvePair else if not inSlidingCurvePair.oclIsUndefined() then inSlidingCurvePair else if not inRollingSurfacePair.oclIsUndefined() then inRollingSurfacePair else if not inSlidingSurfacePair.oclIsUndefined() then inSlidingSurfacePair else if not inSurfacePair.oclIsUndefined() then inSurfacePair else if not inRollingCurvePair.oclIsUndefined() then inRollingCurvePair else if not inSlidingCurvePair.oclIsUndefined() then inSlidingCurvePair else if not inRollingSurfacePair.oclIsUndefined() then inRollingSurfacePair else if not inSlidingSurfacePair.oclIsUndefined() then inSlidingSurfacePair else inSurfacePair endif endif endif endif endif endif endif endif endif endif endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
