    <packagedElement xmi:id="_18_4_1_e120334_1499417193137_921331_23634" xmi:uuid="a891b79e-3118-4a6d-ad73-a20a14bd64b0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455113340264_830633_42437" xmi:uuid="673d49fd-6935-46fd-9365-f84d982d06ec" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193137_921331_23634"/>
        <body>A KinematicPathDefinedByNodes is a type of RepresentationItem that is a parameter or time coordinated path in space along which motion shall take place. The path is defined by a start position and orientation in space at a specific parameter or time and a list of segments to traverse through. The segments in the list must have increasing time or parameter values that are greater than the start value.</body>
      </ownedComment>
      <name>KinematicPathDefinedByNodes</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193795_146773_27607" xmi:uuid="85c5dc96-95c2-48bb-9de6-6552094f81be" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193072_543741_23516"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193796_570640_27611" xmi:uuid="2ee8b8ea-3fef-4c40-8005-6501d98f1393" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455113356877_171387_42438" xmi:uuid="ff574618-1403-42bc-8888-82bf0092d47d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193796_570640_27611"/>
          <body> the AxisPlacement that defines the reference coordinate system and, thus, the location and orientation of the start-point of the KinematicPathDefinedByNodes.</body>
        </ownedComment>
        <name>PlacementStart</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
        <association xmi:idref="_18_4_1_e120334_1499417193398_639853_24794"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193796_216025_27612" xmi:uuid="df427832-ee38-4bf1-9110-6fdd8572ee5a" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455113368709_808134_42439" xmi:uuid="2abe3394-a322-4411-b805-494d343c9215" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193796_216025_27612"/>
          <body> the ordered list of PathSegment objects that the KinematicPathDefinedByNodes consists of. The travel along the KinematicPathDefinedByNodes starts at the first element in the list.</body>
        </ownedComment>
        <name>Segments</name>
        <visibility>public</visibility>
