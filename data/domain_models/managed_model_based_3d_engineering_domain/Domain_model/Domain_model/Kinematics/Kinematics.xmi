    <packagedElement xmi:id="_18_4_1_e120334_1499417193136_744353_23632" xmi:uuid="845b2a10-dd67-4965-9d19-3f7abc68d004" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455113135378_282040_42417" xmi:uuid="a4817a00-3be6-43d3-9a57-fb8cfabd8765" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193136_744353_23632"/>
        <body>A KinematicPair is a type of RepresentationItem that specifies a motion constraint between two adjacent KinematicLinks coinciding at a joint. Each KinematicPair is either a LowOrderKinematicPair, LowOrderKinematicPairWithMotionCoupling or a HighOrderKinematicPair.</body>
      </ownedComment>
      <name>KinematicPair</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193790_287852_27582" xmi:uuid="72549c23-2de5-4566-bcdb-2f2eaa01d95b" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193072_543741_23516"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193790_841066_27585" xmi:uuid="d77a8ecf-cfce-4306-a7a2-36d204c41325" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455113150128_235831_42418" xmi:uuid="211f4ffd-db15-42dc-a210-b3c65d3870e9" xmi:type="uml:Comment">
