        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193148_796946_23664"/>
        <body> A Mechanism is a type of GeometricRepresentation that is a collection of KinematicLinks that are constraint by KinematicPairs.</body>
      </ownedComment>
      <name>Mechanism</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193712_565956_27120" xmi:uuid="14171092-35ef-4374-80d2-029e41e849f2" xmi:type="uml:Generalization">
