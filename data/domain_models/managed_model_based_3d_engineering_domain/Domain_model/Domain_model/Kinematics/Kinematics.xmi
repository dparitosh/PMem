      </generalization>
      <ownedAttribute xmi:id="_19_0_4_b1702d9_1702978920947_368963_64086" xmi:uuid="bf57af2a-908c-4775-937c-123d0a627158" xmi:type="uml:Property">
        <ownedComment xmi:id="_19_0_4_b1702d9_1702978920969_110281_64223" xmi:uuid="434e319e-b7a9-4b8b-a34b-c99c949aceed" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_b1702d9_1702978920947_368963_64086"/>
          <body>the gear ratio of each pair. The value of this attribute need not be specified.&lt;note&gt;For 'rack_and_pinion_pair,' it is the rack translation distance per turn of the pinion. For 'gear_pair', it is the rotation ratio of Pair[2].Link2 per turn of the Pair[1].Link2. For linear_flexible_and_pinion_pair, it is the relative translation speed of Pairs[2] relatively to Pairs[1].&lt;/note&gt;</body>
        </ownedComment>
        <name>CouplingRatios</name>
        <visibility>public</visibility>
        <type href="../../../../DataTypes.xmi#REAL"/>
        <isOrdered>true</isOrdered>
        <isUnique>false</isUnique>
