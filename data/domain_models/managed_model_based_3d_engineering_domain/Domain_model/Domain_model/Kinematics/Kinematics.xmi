      <packagedElement xmi:id="_18_4_1_271a0567_1539610421807_525071_182759" xmi:uuid="ed3cfcfd-f9f2-4f0a-ad65-9fe935cff80f" xmi:type="uml:Class">
        <ownedComment xmi:id="_18_4_1_271a0567_1539610421814_673582_182762" xmi:uuid="7e9fa573-ec2a-479c-8456-5e383f03dc8d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_271a0567_1539610421807_525071_182759"/>
          <body>A transformation to enable the mapping from the Domain to the ARM. The transformation is defined in the OCL constraint code.</body>
        </ownedComment>
        <name>ExternalCurveOrSurfaceSelector</name>
        <ownedRule xmi:id="_18_4_1_271a0567_1539610421813_675603_182761" xmi:uuid="81cc99a6-857e-4db8-a59f-1649383cfd1c" xmi:type="uml:Constraint">
          <ownedComment xmi:id="_18_4_1_65b021e_1676049532984_543871_172065" xmi:uuid="24853e0d-c2cd-4477-8f6f-0d9d6c2a40b0" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1539610421813_675603_182761"/>
            <body>if the input is a Curve then return input.curve else return null.</body>
          </ownedComment>
          <name>outCurve</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1539610421807_525071_182759"/>
          <specification xmi:id="_18_4_1_271a0567_1539610421831_847450_182768" xmi:uuid="1d13f88d-31e1-46f1-bc82-01a054c79c30" xmi:type="uml:OpaqueExpression">
            <body>outCurve = if input.oclIsUndefined () then null else if input.oclIsTypeOf(Curve) then input.curve else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedRule xmi:id="_18_4_1_271a0567_1539610421813_541572_182760" xmi:uuid="84acf9b4-c2cd-4c54-82f3-0f37bbc02b16" xmi:type="uml:Constraint">
