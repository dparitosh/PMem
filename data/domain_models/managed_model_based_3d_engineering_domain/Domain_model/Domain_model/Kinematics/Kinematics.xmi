            <annotatedElement xmi:idref="_18_4_1_271a0567_1539610421813_541572_182760"/>
            <body>if the input is a Surface then return input.surface else return null.</body>
          </ownedComment>
          <name>outSurface</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1539610421807_525071_182759"/>
          <specification xmi:id="_18_4_1_271a0567_1539610421831_248760_182767" xmi:uuid="40843ba8-18a8-44d5-bfb9-472cfc8817a0" xmi:type="uml:OpaqueExpression">
            <body>outSurface = if input.oclIsUndefined () then null else if input.oclIsTypeOf(Surface) then input.surface else null endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
        <ownedAttribute xmi:id="_18_4_1_271a0567_1539610421814_669838_182763" xmi:uuid="990c266b-dd70-4b86-821b-fe149934787a" xmi:type="uml:Port">
          <ownedComment xmi:id="_18_4_1_65b021e_1676048743185_36369_171663" xmi:uuid="d16c51e7-f1e4-4ef1-8a35-8bda16f7d817" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_271a0567_1539610421814_669838_182763"/>
            <body>the ExternalCurveOrSurfaceSelect input. The value of this parameter need not be specified. </body>
          </ownedComment>
