      </ownedEnd>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193174_466578_23721" xmi:uuid="490722cf-a222-4f88-89da-3c9182f58a5b" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455116463001_218912_42508" xmi:uuid="4366bf9f-797f-4808-8eed-9ec4a932d78d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193174_466578_23721"/>
        <body>A PathSegment is a portion of a complete kinematic path and describes the movement of a link from a previous position and orientation to a new position and orientation in space. A PathSegment is either a CircularPath, a LinearPath or a PointToPointPath. &lt;note&gt;Linear and circular types of paths are continuous motions, point-to-point paths are discontinuous motions.&lt;/note&gt;</body>
      </ownedComment>
      <name>PathSegment</name>
      <generalization xmi:id="_18_4_1_65b021e_1669375106344_283162_163602" xmi:uuid="628f26a8-0776-4908-a6d6-bb4984656dac" xmi:type="uml:Generalization">
        <general href="../CommonResources/CommonResources.xmi#_18_4_1_e120334_1499417193203_213100_23783"/>
      </generalization>
      <isAbstract>true</isAbstract>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193892_900671_28133" xmi:uuid="75f840f9-36f4-4366-bf32-b7a06bd393d2" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455116493615_818649_42509" xmi:uuid="8841d8ac-3d64-4533-a34d-f5494ac835b3" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193892_900671_28133"/>
          <body> the AxisPlacement to which the parameters of the PathSegment refer. It is the location and orientation of the end-point of the PathSegment.</body>
        </ownedComment>
        <name>PlacementEnd</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193025_577371_23412"/>
