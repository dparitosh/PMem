            <annotatedElement xmi:idref="_18_4_1_271a0567_1537962028248_544292_110398"/>
            <body>return the defined input.</body>
          </ownedComment>
          <name>lowOrderKinematicPairCombinator</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1537962028248_321418_110397"/>
          <specification xmi:id="_18_4_1_271a0567_1537962028297_843173_110407" xmi:uuid="e8d22c41-e4d6-4ac0-b887-b83d3fa5cdb7" xmi:type="uml:OpaqueExpression">
            <body>output = if not inSphericalPair.oclIsUndefined() then inSphericalPair else if not inSphericalPairWithPin.oclIsUndefined() then inSphericalPairWithPin else if not inCylindricalPair.oclIsUndefined() then inCylindricalPair else if not inRevolutePair.oclIsUndefined() then inRevolutePair else if not inPlanarPair.oclIsUndefined() then inPlanarPair else if not inFullyConstrainedPair.oclIsUndefined() then inFullyConstrainedPair else if not inUnconstrainedPair.oclIsUndefined() then inUnconstrainedPair else if not inUniversalPairWithRange.oclIsUndefined() then inUniversalPairWithRange else inPrismaticPair endif endif endif endif endif endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
