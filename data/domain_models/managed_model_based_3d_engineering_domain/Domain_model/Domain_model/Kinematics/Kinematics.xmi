    <packagedElement xmi:id="_19_0_4_2840147_1723463729739_128787_61540" xmi:uuid="450363a4-d702-4b6d-9304-e5d58fbdb993" xmi:type="uml:Association">
      <memberEnd xmi:idref="_19_0_4_2840147_1723463729756_970809_61542"/>
      <memberEnd xmi:idref="_19_0_4_2840147_1723463729751_968103_61541"/>
      <ownedEnd xmi:id="_19_0_4_2840147_1723463729756_970809_61542" xmi:uuid="6d560d6d-a368-47e6-b540-df7259e8745b" xmi:type="uml:Property">
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193014_29456_23382"/>
        <association xmi:idref="_19_0_4_2840147_1723463729739_128787_61540"/>
