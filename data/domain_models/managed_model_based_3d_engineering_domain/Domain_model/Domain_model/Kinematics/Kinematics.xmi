    <packagedElement xmi:id="_18_4_1_e120334_1499417193134_842125_23626" xmi:uuid="0181a413-cbdf-4db7-ad32-361922be3cd0" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455112952174_757544_42404" xmi:uuid="1855febd-99dd-4081-8819-f5ec86cceb4e" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193134_842125_23626"/>
        <body>An InterpolatedConfigurationSequence is a type of RepresentationItem that specifies a sequence of InterpolatedConfigurationSegments, each consisting of a referenced MechanismState at a specific parameter value or time and an interpolation type to the next or in the case of the last one to the first InterpolatedConfigurationSegment.</body>
      </ownedComment>
      <name>InterpolatedConfigurationSequence</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193783_932599_27550" xmi:uuid="d7aa94bf-a87c-4bdb-953e-7b0898f9d8ba" xmi:type="uml:Generalization">
        <general href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193072_543741_23516"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193783_883061_27551" xmi:uuid="91a9164c-4356-4f1b-a4b9-4caa48cf022d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455112977738_433853_42405" xmi:uuid="a38c2d93-1568-4ef9-aea2-b3b6d4417381" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193783_883061_27551"/>
          <body> the list of InterpolatedConfigurationSegments for the InterpolatedConfigurationSequence. There shall exist at least one InterpolatedConfigurationSegment.</body>
        </ownedComment>
        <name>Segments</name>
