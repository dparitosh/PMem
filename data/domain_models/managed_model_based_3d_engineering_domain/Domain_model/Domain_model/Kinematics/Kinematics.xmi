    <packagedElement xmi:id="_18_4_1_e120334_1499417193037_840650_23444" xmi:uuid="f4319f5c-5b9b-4504-aef2-dd31063ed43c" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455112170745_984606_42380" xmi:uuid="44426c33-9c51-4175-a371-93e7542b5e5d" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193037_840650_23444"/>
        <body>A CircularPath is a type of PathSegment that describes a direction of travel along a circular arc that is defined by the start position, the end position and an intermediate position to pass through between the start and end position. While doing so a link that is traversing along the path is continuously rotating from the start orientation to the end orientation. The path shall be traversed in linear speed, which is given by the previous time or parameter value and the new time or parameter value.</body>
      </ownedComment>
      <name>CircularPath</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193460_726448_25235" xmi:uuid="5292dd9a-f654-4236-95df-6aeaa7ca08cb" xmi:type="uml:Generalization">
        <general xmi:idref="_18_4_1_e120334_1499417193174_466578_23721"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193460_309325_25236" xmi:uuid="71131b4b-66e1-43ec-8647-dc5daf8dcae8" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455112185730_2339_42381" xmi:uuid="58632741-10cb-4462-9dd2-cb93a8a8fa79" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193460_309325_25236"/>
          <body> an intermediate CartesianPoint through which the CircularPath passes.</body>
        </ownedComment>
        <name>ViaPoint</name>
        <visibility>public</visibility>
        <type href="../RepresentationAndExternalElementReference/RepresentationAndExternalElementReference.xmi#_18_4_1_e120334_1499417193035_360707_23436"/>
