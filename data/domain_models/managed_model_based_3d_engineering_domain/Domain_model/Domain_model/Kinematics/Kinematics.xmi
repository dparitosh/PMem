          <name>highOrderKinematicPairCombinator</name>
          <constrainedElement xmi:idref="_18_4_1_271a0567_1536756571585_953590_170008"/>
          <specification xmi:id="_18_4_1_271a0567_1536756571760_830089_170017" xmi:uuid="c0edc406-a16b-4e51-a3b3-dc0a37f614c6" xmi:type="uml:OpaqueExpression">
            <body>output = if not inLinearFlexibleAndPlanarCurvePair.oclIsUndefined() then inLinearFlexibleAndPlanarCurvePair else if not inPlanarCurvePair.oclIsUndefined() then inPlanarCurvePair else if not inPointOnPlanarCurvePair.oclIsUndefined() then inPointOnPlanarCurvePair else if not inSurfacePair.oclIsUndefined() then inSurfacePair else if not inRollingCurvePair.oclIsUndefined() then inRollingCurvePair else if not inSlidingCurvePair.oclIsUndefined() then inSlidingCurvePair else inSurfacePair endif endif endif endif endif endif</body>
            <language>OCL2.0</language>
          </specification>
        </ownedRule>
