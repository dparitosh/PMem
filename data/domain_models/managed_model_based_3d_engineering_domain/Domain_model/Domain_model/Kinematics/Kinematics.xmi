    <packagedElement xmi:id="_18_4_1_e120334_1499417193298_400715_23934" xmi:uuid="f4690f6f-1a28-4a1f-9492-16668ae65046" xmi:type="uml:Enumeration">
      <ownedComment xmi:id="_18_0_5_45e01bd_1456299725945_643100_42909" xmi:uuid="c30666f2-0272-4408-b46a-53165f6881aa" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193298_400715_23934"/>
        <body>A LowOrderKinematicPairWithMotionCouplingTypeEnum type lists the possible types of a LowOrderKinematicPairWithMotionCoupling. The constraints of these pair types shall follow the mathematical definition provided in ISO 10303-105.</body>
      </ownedComment>
      <name>LowOrderKinematicPairWithMotionCouplingTypeEnum</name>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_607290_29318" xmi:uuid="a58475c5-9643-4280-873d-17eba9ea3f92" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299741066_682660_42910" xmi:uuid="3f76b30e-8bfd-4549-9bd9-4dc67ef8d0c9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_607290_29318"/>
          <body> a pair that constrains the motion between two adjacent links to a rolling (and potentially sliding) motion of the second link along the first link. To measure the motion of the second link with respect to the first link, a frame is defined on each of the links such that the origin lies in the centre of the rolling circle of the respective link.</body>
        </ownedComment>
        <name>gear_pair</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194147_412767_29319" xmi:uuid="05c03b50-24ca-4b38-b54f-34917263c74e" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299751939_122175_42911" xmi:uuid="75bbeca0-eccf-498e-95e7-00a12dc5444d" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194147_412767_29319"/>
          <body> a pair that consists of a linear flexible link that moves around a rolling pinion where the rotation axis of the pinion is perpendicular to the direction of the linear flexible link.</body>
        </ownedComment>
        <name>linear_flexible_and_pinion_pair</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194147_379645_29320" xmi:uuid="462aa369-e65e-4027-a81e-86ba57fa6c7b" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299762099_985703_42912" xmi:uuid="8714fb8b-72cf-4033-a85e-1809c486d4b9" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194147_379645_29320"/>
          <body> a pair that describes a pinion rolling on a rack where the rotation axis of the pinion is perpendicular to the direction of the rack.</body>
        </ownedComment>
        <name>rack_and_pinion_pair</name>
      </ownedLiteral>
      <ownedLiteral xmi:id="_18_4_1_e120334_1499417194147_643479_29321" xmi:uuid="9c0a8793-2d0b-46e2-a4d8-5cf7b3f18c67" xmi:type="uml:EnumerationLiteral">
        <ownedComment xmi:id="_18_0_5_45e01bd_1456299775674_763837_42913" xmi:uuid="f48c9e3a-d186-49da-a6cf-d4f401ba3433" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417194147_643479_29321"/>
          <body> a pair that constrains the motion between two adjacent links to a rotation about, and translation along, a common axis, where the translation is proportional to the rotation. The factor of proportionality is given by pitch which defines the translational displacement for one full rotation. The frames are defined on each of the links such that the z-axes coincide and the positive directions agree.</body>
        </ownedComment>
        <name>screw_pair</name>
      </ownedLiteral>
    </packagedElement>
    <packagedElement xmi:id="_18_4_1_e120334_1499417193135_8501_23630" xmi:uuid="f47cce28-f404-4035-af4b-69d78206ced6" xmi:type="uml:Class">
      <ownedComment xmi:id="_18_0_5_45e01bd_1455113036419_718836_42409" xmi:uuid="fd486f47-450e-4a0c-85a7-03b9b1727c92" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193135_8501_23630"/>
        <body>A KinematicLinkToOccurrenceAssociation is an association between a KinematicLink within a Mechanism and an Occurrence within an AssemblyDefinition.</body>
      </ownedComment>
      <name>KinematicLinkToOccurrenceAssociation</name>
      <ownedRule xmi:id="_19_0_4_2840147_1725021054205_302931_60324" xmi:uuid="57d302a0-f100-4757-b552-e9d81a863b76" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_19_0_4_2840147_1725021054223_761427_60327" xmi:uuid="b3087b8e-38de-4ddb-b45b-dfde8e2f2b45" xmi:type="uml:Comment">
          <ownedComment xmi:id="_19_0_4_2840147_1725021054223_980087_60328" xmi:uuid="61fb7d7b-776d-4438-886e-86caa892d1dd" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//KinematicLinkToOccurrenceAssociation[@uid]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="associatedTo_uid" value="../@uid"/&gt; &lt;sch:let name="upperUsage" value="local-fn:MainUpperUsage(//DataContainer, Substructure/@uidRef)"/&gt; &lt;sch:assert test="$associatedTo_uid = $upperUsage"&gt; The attribute SubStructure that points to a SpecifiedOccurrence, shall belong with their attributes UpperUsage in a recursive way to an Occurrence that is called out by AssociatedTo. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -upperUsage:&lt;sch:value-of select="$upperUsage"/&gt; -associatedTo_uid:&lt;sch:value-of select="$associatedTo_uid"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <ownedComment xmi:id="_19_0_4_2840147_1725021054221_983459_60326" xmi:uuid="cc7876b4-87bf-4859-b849-241df6e131e1" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_2840147_1725021054205_302931_60324"/>
          <body>the attribute SubStructure that points to a SpecifiedOccurrence, shall belong with their attributes UpperUsage in a recursive way to the Occurrence that is called out by AssociatedTo.</body>
        </ownedComment>
        <name>WR1</name>
        <specification xmi:id="_19_0_4_2840147_1725021054217_173340_60325" xmi:uuid="6e6b813e-c4c8-4a01-8581-9057809fbaf4" xmi:type="uml:OpaqueExpression">
          <body>self.Substructure-&gt;closure(UpperUsage)-&gt;select(e | e.UpperUSage.oclIsUndefined()) = self.AssociatedTo.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
      <ownedRule xmi:id="_19_0_4_2840147_1723455169717_767544_60842" xmi:uuid="9c4bf960-0a4f-4022-87c3-ad72f9af61e3" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_19_0_4_2840147_1723455224843_27128_60844" xmi:uuid="b406b8cd-a089-4efc-abcf-6bc219a1105f" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_2840147_1723455169717_767544_60842"/>
          <body>an Occurrence shall be referenced by at most one associated KinematicLinkToOccurrenceAssociation.</body>
        </ownedComment>
        <name>UR1</name>
        <constrainedElement xmi:idref="_18_4_1_e120334_1499417193135_8501_23630"/>
        <specification xmi:id="_19_0_4_2840147_1723455169726_839633_60843" xmi:uuid="411353b1-ab61-41a4-bda9-e6b30cf327f3" xmi:type="uml:OpaqueExpression">
          <body>KinematicLinkToOccurrenceAssociation::allInstances()-&gt;isUnique(AssociatedTo)</body>
          <language>English</language>
        </specification>
      </ownedRule>
      <generalization xmi:id="_18_4_1_65b021e_1721221107001_931576_148775" xmi:uuid="5b4e8cda-4910-45e9-a5c0-143fe190a984" xmi:type="uml:Generalization">
        <general href="../ManagementResources/ManagementResources.xmi#_18_4_1_65b021e_1719937607582_594298_150024"/>
      </generalization>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193787_170128_27571" xmi:uuid="ffdf5c16-c633-4bd0-be66-4ecc48625b8d" xmi:type="uml:Property">
        <ownedComment xmi:id="_18_0_5_45e01bd_1455113049531_883769_42410" xmi:uuid="bd745fb3-04b8-4534-8b05-70995368f9fc" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_e120334_1499417193787_170128_27571"/>
          <body> the KinematicLink of the association.</body>
        </ownedComment>
        <name>AssociatedLink</name>
        <visibility>public</visibility>
        <type xmi:idref="_18_4_1_e120334_1499417193135_720622_23629"/>
        <association xmi:idref="_18_4_1_e120334_1499417193786_703498_27564"/>
      </ownedAttribute>
      <ownedAttribute xmi:id="_18_4_1_e120334_1499417193788_211168_27572" xmi:uuid="15d30c1f-2f45-4d36-860c-d19dd7f126d5" xmi:type="uml:Property">
