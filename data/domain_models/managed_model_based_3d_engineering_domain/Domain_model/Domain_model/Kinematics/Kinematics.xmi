      <ownedComment xmi:id="_18_0_5_45e01bd_1455112503037_522273_42397" xmi:uuid="7e115bc8-ad23-4da9-aba2-c7955e777bf3" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_e120334_1499417193133_237554_23624"/>
        <body>An InterpolatedConfigurationModel is a type of GeometricRepresentation that specifies a motion (forward analysis) of a Mechanism where the motion is defined by different states of the KinematicPairs at different parameter values or times.</body>
      </ownedComment>
      <name>InterpolatedConfigurationModel</name>
      <generalization xmi:id="_18_4_1_e120334_1499417193781_909696_27540" xmi:uuid="c154b05a-c058-4819-a4fc-a42700afa49b" xmi:type="uml:Generalization">
