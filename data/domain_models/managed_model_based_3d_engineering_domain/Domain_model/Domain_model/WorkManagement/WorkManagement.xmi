    <packagedElement xmi:id="_19_0_4_b1702d9_1651595261926_577498_88424" xmi:uuid="28361257-0539-48be-a6b3-c5892fd44dac" xmi:type="uml:Class">
      <ownedComment xmi:id="_19_0_4_b1702d9_1651595262485_782597_88520" xmi:uuid="331193ff-450a-48dc-a56e-c1a01d1507a1" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_19_0_4_b1702d9_1651595261926_577498_88424"/>
        <body>An ObservationRelationship is a relationship between two Observation objects.</body>
      </ownedComment>
      <name>ObservationRelationship</name>
      <ownedRule xmi:id="_19_0_4_b1702d9_1651595261927_893265_88428" xmi:uuid="891e0e08-fe6a-4295-bcec-42a13b0ab12f" xmi:type="uml:Constraint">
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121683_112013_163114" xmi:uuid="a5f651b8-f1f5-4c61-aadc-7b5d90fba281" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121683_65128_163115" xmi:uuid="a8595235-cdb8-4c40-a722-27641be7f5a8" xmi:type="uml:Comment">
            <body>WR1: Relating :&lt;&gt;: Related;</body>
          </ownedComment>
          <body>EXPRESS</body>
        </ownedComment>
        <ownedComment xmi:id="_19_0_4_b1702d9_1651595262489_399318_88559" xmi:uuid="c043053c-db23-46b6-be84-02a7ef56fbc7" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_19_0_4_b1702d9_1651595261927_893265_88428"/>
          <body>the related Observation and the relating Observation shall be different.</body>
        </ownedComment>
        <ownedComment xmi:id="_18_4_1_65b021e_1671209121682_863389_163112" xmi:uuid="ee2fb9a5-84cd-4dc8-95ec-a2c72af2e852" xmi:type="uml:Comment">
          <ownedComment xmi:id="_18_4_1_65b021e_1671209121683_898272_163113" xmi:uuid="50e4e937-c964-4f0e-84db-f881df4f4c64" xmi:type="uml:Comment">
            <body> &lt;sch:rule context="//ObservationRelationship[@uid]"&gt;&#13; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#13; &lt;sch:let name="uid" value="@uid"/&gt;&#13; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#13; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#13; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#13; The related Observation and the relating Observation shall be different. &#13; {&#13; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#13; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#13; -rule_name:ObservationRelationship.WR1&#13; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#13; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#13; }&#13; &lt;/sch:assert&gt;&#13; &lt;/sch:rule&gt;</body>
          </ownedComment>
          <body>Schematron</body>
        </ownedComment>
        <name>WR1</name>
        <constrainedElement xmi:idref="_19_0_4_b1702d9_1651595261926_577498_88424"/>
        <specification xmi:id="_19_0_4_b1702d9_1651595262489_473419_88558" xmi:uuid="cd0256d4-dbd4-4945-b189-d5e783084fd9" xmi:type="uml:OpaqueExpression">
          <body>self.Relating &lt;&gt; self.Related</body>
          <language>OCL2.0</language>
        </specification>
      </ownedRule>
