   <!--ToleranceZone set of rules-->
   <!--(Reference to Select) ToleranceZone.ZoneFor : SET[1:unbounded] OF ToleranceZoneTargetSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
