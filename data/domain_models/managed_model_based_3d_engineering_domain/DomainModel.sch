   <!--(Rule WireOccurrence.WR2)-->
   <sch:pattern id="WireOccurrence_WR2"><sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='WireOccurrence']"> <sch:let name="uid" value="@uid"/> <sch:let name="part" value="ancestor::Part"/> <sch:assert test="$part/PartTypes[PartCategoryEnum ='wire']">(WireOccurrence.WR1: <sch:value-of select="$uid"/>) a WireOccurrence shall belong to a Part that contains wire as one of its PartTypes.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule WireOccurrence.WR1)-->
   <sch:pattern id="WireOccurrence_WR1"><sch:rule context="//Occurrence[@uid and substring-after(@xsi:type,':')='WireOccurrence']"> <sch:let name="uid" value="@uid"/> <sch:let name="part" value="ancestor::Part"/> <sch:assert test="$part/PartTypes[PartCategoryEnum ='raw_material_by_length']">(WireOccurrence.WR1: <sch:value-of select="$uid"/>) a WireOccurrence shall belong to a Part that contains raw material by length as one of its PartTypes.</sch:assert> </sch:rule></sch:pattern>
