   <!--DatumReferenceElement set of rules-->
   <!--(Reference to Entity) GeneralDatumReference.Base : OPTIONAL Datum (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumReferenceElement_Base">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumReferenceElement') or (self::GeneralDatumReference and substring-after(@xsi:type,':')='DatumReferenceElement'))]/Base">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Datum ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumReferenceElement : <sch:value-of select="$uid"/>) The DatumReferenceElement.Base contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Datum.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DatumReferenceModifierWithValue set of rules-->
   <!--(Rule DatumReferenceModifierWithValue.WR1)-->
   <sch:pattern id="DatumReferenceModifierWithValue_WR1"><sch:rule context="//DatumReferenceModifierWithValue/ModifierValue"> <sch:let name="uid" value="../@uid"/> <sch:let name="unitRef" value="./Unit/@uidRef"/> <sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='length'">(DatumReferenceModifierWithValue <sch:value-of select="$uid"/>) The unit of ModifierValue shall be a length measure unit. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DatumSystem set of rules-->
   <!--(Default Value) DatumSystem.ProductDefinitional : OPTIONAL Boolean = 'false' (kind=SINGLE - redefined=ShapeElement.ProductDefinitional)-->
   <sch:pattern id="DatumSystem_ProductDefinitional">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumSystem') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumSystem'))]/ProductDefinitional">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="text() = 'false'">(DatumSystem : <sch:value-of select="$uid"/>) The value of ProductDefinitional shall be 'false'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="DatumSystem_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumSystem') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumSystem'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(DatumSystem : <sch:value-of select="$uid"/>) The DatumSystem.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="DatumSystem_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumSystem') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumSystem'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(DatumSystem : <sch:value-of select="$uid"/>) The DatumSystem.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
