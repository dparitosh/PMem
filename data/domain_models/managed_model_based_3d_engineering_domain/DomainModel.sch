   <!--DeltaChangeActivity set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DeltaChangeRelationship set of rules-->
   <!--(Rule specific to Id construct) DeltaChangeRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="DeltaChangeRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DeltaChangeRelationship') or (self::DeltaChangeRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(DeltaChangeRelationship : <sch:value-of select="$uid"/>) The DeltaChangeRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DeltaChangeRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="DeltaChangeRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DeltaChangeRelationship') or (self::DeltaChangeRelationship and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(DeltaChangeRelationship : <sch:value-of select="$uid"/>) The DeltaChangeRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DeltaChangeRelationship.Related : DeltaChange (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="DeltaChangeRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DeltaChangeRelationship') or (self::DeltaChangeRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DeltaChange ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DeltaChange ',concat(' ',substring-after(@xsi:type,':'),' '))] or //DeltaChange[@uid = $uidRef]">(DeltaChangeRelationship : <sch:value-of select="$uid"/>) The DeltaChangeRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DeltaChange.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) DeltaChangeRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="DeltaChangeRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DeltaChangeRelationship') or (self::DeltaChangeRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(DeltaChangeRelationship : <sch:value-of select="$uid"/>) The DeltaChangeRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule DeltaChangeRelationship.WR1)-->
   <sch:pattern id="DeltaChangeRelationship_WR1"> <sch:rule context="//DeltaChangeRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related DeltaChange and the relating DeltaChange shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:DeltaChangeRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DerivedShapeElement set of rules-->
   <!--(Reference to Entity) DerivedShapeElement.DerivedFrom : SET[1:unbounded] OF ShapeElement (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
