oncat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ThreeDGeometrySet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalAdvancedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalCsgShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalCurveSweptSolidShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalElementaryBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalFacetedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalTessellatedShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ThreeDGeometrySet ',concat(' ',substring-after(@xsi:type,':'),' '))]">(PlyShape : <sch:value-of select="$uid"/>) The PlyShape.DefiningModel contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PlyLaminateShapeSelect.</sch:assert>
