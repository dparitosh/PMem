   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--WiringHarnessAssemblyDesign set of rules-->
   <!--(Reference to Entity) WiringHarnessAssemblyDesign.Topology : OPTIONAL EdgeBasedTopologicalRepresentationWithLengthConstraint (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="WiringHarnessAssemblyDesign_Topology">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign') or (self::PartView and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign'))]/Topology">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(WiringHarnessAssemblyDesign : <sch:value-of select="$uid"/>) The WiringHarnessAssemblyDesign.Topology contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type EdgeBasedTopologicalRepresentationWithLengthConstraint.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) AssemblyDefinition.AssemblyType : OPTIONAL ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="WiringHarnessAssemblyDesign_AssemblyType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign') or (self::PartView and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign'))]/AssemblyType/*">
