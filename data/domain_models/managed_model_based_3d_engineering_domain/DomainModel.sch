   <!--(Rule specific to Id construct) GeometricDimension.Id : IdentifierSelect-->
   <sch:pattern id="CurvedDistance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CurvedDistance') or (self::GeometricDimension and substring-after(@xsi:type,':')='CurvedDistance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(CurvedDistance : <sch:value-of select="$uid"/>) The CurvedDistance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricDimension.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
