   <!--CrossSectionalGroupShapeElementWithTubularCover set of rules-->
   <!--(Reference to Select) CrossSectionalGroupShapeElementWithTubularCover.Cover : CrossSectionalConstituentElementSelect (kind=SINGLE - cardinality= - redefined=false)-->
