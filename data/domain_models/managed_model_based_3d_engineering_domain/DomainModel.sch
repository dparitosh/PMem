         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TimeIntervalWithId : <sch:value-of select="$uid"/>) The TimeIntervalWithId.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) TimeInterval.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="TimeIntervalWithId_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TimeIntervalWithId') or (self::TimeIntervalWithId or (self::AssignedTimeInterval and substring-after(@xsi:type,':')='TimeIntervalWithId')))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TimeIntervalWithId : <sch:value-of select="$uid"/>) The TimeIntervalWithId.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
