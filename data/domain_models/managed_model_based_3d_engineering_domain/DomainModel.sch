-after(@xsi:type,':'),' '))]) or (self::PointOnCurve and //RepresentationItem[@uid = $uidRef and contains(' PointOnCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PointOnSurface and //RepresentationItem[@uid = $uidRef and contains(' PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))])">(GeometricPlaceholderSet : <sch:value-of select="$uid"/>) The GeometricPlaceholderSet.Elements contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricPlaceholderSetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--GeometricRepresentation set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--GeometricRepresentationRelationship set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--GeometricRepresentationRelationshipWithCartesianTransformation set of rules-->
   <!--(Reference to Select) GeometricRepresentationRelationship.Related : GeometricRepresentationSelect (kind=SINGLE - cardinality= - redefined=RepresentationRelationship.Related)-->
   <sch:pattern id="GeometricRepresentationRelationshipWithCartesianTransformation_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' EdgeBasedTopologicalRepresentationWithLengthConstraint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',substring-after(@xsi:type,':'),' '))]">(GeometricRepresentationRelationshipWithCartesianTransformation : <sch:value-of select="$uid"/>) The GeometricRepresentationRelationshipWithCartesianTransformation.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricRepresentationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) RepresentationRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="GeometricRepresentationRelationshipWithCartesianTransformation_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(GeometricRepresentationRelationshipWithCartesianTransformation : <sch:value-of select="$uid"/>) The GeometricRepresentationRelationshipWithCartesianTransformation.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) RepresentationRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="GeometricRepresentationRelationshipWithCartesianTransformation_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(GeometricRepresentationRelationshipWithCartesianTransformation : <sch:value-of select="$uid"/>) The GeometricRepresentationRelationshipWithCartesianTransformation.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule GeometricRepresentationRelationshipWithCartesianTransformation.WR1)-->
   <sch:pattern id="GeometricRepresentationRelationshipWithCartesianTransformation_WR1"><sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']"> <sch:let name="uid" value="@uid"/> <sch:let name="relatedUid" value="child::Related/@uidRef"/> <sch:assert test="not(parent::*/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'] is //*[@uid=$relatedUid]/parent::Representations/parent::RepresentationContext[@uid and substring-after(@xsi:type,':')='GeometricCoordinateSpace'])" >(GeometricRepresentationRelationshipWithCartesianTransformation.WR1 <sch:value-of select="$uid"/>) the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--GeometricRepresentationRelationshipWithPlacementTransformation set of rules-->
   <!--(Reference to Entity) GeometricRepresentationRelationshipWithPlacementTransformation.Origin : AxisPlacement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="GeometricRepresentationRelationshipWithPlacementTransformation_Origin">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation'))]/Origin">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]">(GeometricRepresentationRelationshipWithPlacementTransformation : <sch:value-of select="$uid"/>) The GeometricRepresentationRelationshipWithPlacementTransformation.Origin contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AxisPlacement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricRepresentationRelationshipWithPlacementTransformation.Target : AxisPlacement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="GeometricRepresentationRelationshipWithPlacementTransformation_Target">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation'))]/Target">
