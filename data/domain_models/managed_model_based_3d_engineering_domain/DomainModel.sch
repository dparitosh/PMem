   <!--(Reference to Entity) PartView.AdditionalContexts : OPTIONAL SET[1:unbounded] OF ViewContext (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CollectionDefinition_AdditionalContexts">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectionDefinition') or (self::PartView and substring-after(@xsi:type,':')='CollectionDefinition'))]/AdditionalContexts/ViewContext">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ViewContext ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ViewContext ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ViewContext[@uid = $uidRef]">(CollectionDefinition : <sch:value-of select="$uid"/>) The CollectionDefinition.AdditionalContexts contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ViewContext.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartView.AuxiliaryGeometry : OPTIONAL SET[1:unbounded] OF GeometricModel (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CollectionDefinition_AuxiliaryGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectionDefinition') or (self::PartView and substring-after(@xsi:type,':')='CollectionDefinition'))]/AuxiliaryGeometry/GeometricModel">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CollectionDefinition : <sch:value-of select="$uid"/>) The CollectionDefinition.AuxiliaryGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type GeometricModel.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartView.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CollectionDefinition_ClassifiedAs">
