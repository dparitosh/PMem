   <!--HarnessNode set of rules-->
   <!--(Reference to Entity) HarnessNode.AttachedFeature : OPTIONAL OccurrenceShapeFeature (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HarnessNode_AttachedFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessNode') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessNode'))]/AttachedFeature">
         <sch:let name="uid" value="../@uid"/>
