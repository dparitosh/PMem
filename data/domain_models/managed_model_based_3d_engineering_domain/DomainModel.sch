   </sch:pattern>
   <!--(Rule specific to Id construct) PartViewRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PromissoryAssemblyViewUsage_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyViewUsage') or (self::PartViewRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyViewUsage'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(PromissoryAssemblyViewUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyViewUsage.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
