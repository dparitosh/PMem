   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--PointToPointPath set of rules-->
   <!--(Reference to Entity) PathSegment.PlacementEnd : AxisPlacement (kind=SINGLE - cardinality= - redefined=false)-->
