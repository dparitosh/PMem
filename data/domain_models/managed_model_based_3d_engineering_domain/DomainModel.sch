   <!--(Reference to Entity) Effectivity.ConcernedOrganizations : OPTIONAL SET[1:unbounded] OF Organization (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="DatedEffectivity_ConcernedOrganizations">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatedEffectivity') or (self::Effectivity and substring-after(@xsi:type,':')='DatedEffectivity'))]/ConcernedOrganizations/Organization">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Organization ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Organization ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Organization[@uid = $uidRef]">(DatedEffectivity : <sch:value-of select="$uid"/>) The DatedEffectivity.ConcernedOrganizations contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Organization.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Effectivity.ConfigurationType : OPTIONAL ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatedEffectivity_ConfigurationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatedEffectivity') or (self::Effectivity and substring-after(@xsi:type,':')='DatedEffectivity'))]/ConfigurationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(DatedEffectivity : <sch:value-of select="$uid"/>) The DatedEffectivity.ConfigurationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Effectivity.EffectivityContext : OPTIONAL EffectivityContextSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatedEffectivity_EffectivityContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatedEffectivity') or (self::Effectivity and substring-after(@xsi:type,':')='DatedEffectivity'))]/EffectivityContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Activity  ActualActivity  DirectedActualActivity  PlannedActivity  DirectedPlannedActivity ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Contract ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Organization ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PersonInOrganization ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ProductClass ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ProductConfiguration  EffectivityControlledProductConfiguration ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Project ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Activity  ActualActivity  DirectedActualActivity  PlannedActivity  DirectedPlannedActivity ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Contract ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Organization ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PersonInOrganization ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ProductClass ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ProductConfiguration  EffectivityControlledProductConfiguration ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Project ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Activity[@uid = $uidRef] or //Contract[@uid = $uidRef] or //Organization[@uid = $uidRef] or //PersonInOrganization[@uid = $uidRef] or //ProductConcept[@uid = $uidRef and contains(' ProductClass ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ProductConfiguration[@uid = $uidRef] or //Project[@uid = $uidRef]">(DatedEffectivity : <sch:value-of select="$uid"/>) The DatedEffectivity.EffectivityContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of EffectivityContextSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Effectivity.InheritanceType : OPTIONAL ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatedEffectivity_InheritanceType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatedEffectivity') or (self::Effectivity and substring-after(@xsi:type,':')='DatedEffectivity'))]/InheritanceType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(DatedEffectivity : <sch:value-of select="$uid"/>) The DatedEffectivity.InheritanceType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule DatedEffectivity.WR1)-->
   <sch:pattern id="DatedEffectivity_WR1"> <sch:rule context="//Effectivity[@uid and substring-after(@xsi:type,':')='DatedEffectivity']"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:assert test="StartDefinition or EndDefinition"> At least one of the attributes StartDefinition or EndDefinition shall be set. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Datum set of rules-->
   <!--(Reference to Entity) Datum.Targets : OPTIONAL SET[1:unbounded] OF DatumTarget (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Datum_Targets">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]/Targets/DatumTarget">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]">(Datum : <sch:value-of select="$uid"/>) The Datum.Targets contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumTarget.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) Datum.Name : String = '' (kind=SINGLE - redefined=ShapeElement.Name)-->
   <sch:pattern id="Datum_Name">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:assert test="count(Name) = 1">(Datum : <sch:value-of select="$uid"/>) The Datum.Name attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(Name) != 1 or Name/CharacterString and not(Name/CharacterString/text())">(Datum : <sch:value-of select="$uid"/>) The value of Name shall be ''.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) Datum.ProductDefinitional : Boolean = 'false' (kind=SINGLE - redefined=ShapeElement.ProductDefinitional)-->
   <sch:pattern id="Datum_ProductDefinitional">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:assert test="count(ProductDefinitional) = 1">(Datum : <sch:value-of select="$uid"/>) The Datum.ProductDefinitional attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(ProductDefinitional) != 1 or ProductDefinitional/text() = 'false'">(Datum : <sch:value-of select="$uid"/>) The value of ProductDefinitional shall be 'false'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="Datum_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Datum : <sch:value-of select="$uid"/>) The Datum.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Datum_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(Datum : <sch:value-of select="$uid"/>) The Datum.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="Datum_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Datum') or (self::ShapeElement and substring-after(@xsi:type,':')='Datum'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(Datum : <sch:value-of select="$uid"/>) The Datum.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule Datum.UR1)-->
   <sch:pattern id="Datum_UR1"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='Datum']"> <sch:let name="uid" value="@uid"/> <sch:let name="id" value="./Identification/IdentifierString"/> <sch:let name="followingIds" value="(following-sibling::ShapeElement[substring-after(@xsi:type,':')='Datum']/Identification/IdentifierString)"/> <sch:let name="precedingIds" value="(preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='Datum']/Identification/IdentifierString)"/> <sch:assert test="not (($id = $followingIds) or ($id = $precedingIds))"> (Datum <sch:value-of select="$uid"/>) The combination of Identification and ElementOf shall be unique within a population of datum. </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule Datum.WR1)-->
   <sch:pattern id="Datum_WR1"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='Datum']"> <sch:let name="uid" value="@uid"/> <sch:assert test="(count (./Targets) ge 1) or (count(//ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum[@uidRef=$uid]) = 1)"> (Datum <sch:value-of select="$uid"/>) A datum shall be related to one or more DatumTargets or related to one DatumFeature. </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule Datum.UR2)-->
   <sch:pattern id="Datum_UR2"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='Datum']/Targets/DatumTarget"> <sch:let name="uid" value="../../@uid"/> <sch:let name="uidRef" value="./@uidRef"/> <sch:let name="targetId" value="//ShapeElement[@uid=$uidRef]/TargetId/IdentifierString"/> <sch:let name="following" value="(following-sibling::DatumTarget)/@uidRef"/> <sch:let name="preceding" value="(preceding-sibling::DatumTarget)/@uidRef"/> <sch:let name="targetIds" value="//ShapeElement[@uid=$following or @uid=$preceding ]/TargetId/IdentifierString"/> <sch:assert test="not ($targetId = $targetIds)"> (Datum <sch:value-of select="$uid"/>) TargetId (<sch:value-of select="$targetId"/>) shall be unique within a population of Targets. </sch:assert> </sch:rule> </sch:pattern>
   <!--(Rule Datum.WR2)-->
   <sch:pattern id="Datum_WR2"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='Datum']"> <sch:let name="uid" value="@uid"/> <sch:assert test="count(//ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum[@uidRef=$uid]) le 1"> (Datum <sch:value-of select="$uid"/>) There shall be at most one DatumFeature related to the Datum. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DatumFeature set of rules-->
   <!--(Reference to Entity) DatumFeature.OfDatum : Datum (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="DatumFeature_OfDatum">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumFeature'))]/OfDatum">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Datum ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumFeature : <sch:value-of select="$uid"/>) The DatumFeature.OfDatum contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Datum.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) DatumFeature.ProductDefinitional : OPTIONAL Boolean = 'true' (kind=SINGLE - redefined=ShapeElement.ProductDefinitional)-->
   <sch:pattern id="DatumFeature_ProductDefinitional">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumFeature'))]/ProductDefinitional">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="text() = 'true'">(DatumFeature : <sch:value-of select="$uid"/>) The value of ProductDefinitional shall be 'true'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="DatumFeature_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumFeature'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(DatumFeature : <sch:value-of select="$uid"/>) The DatumFeature.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="DatumFeature_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumFeature'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(DatumFeature : <sch:value-of select="$uid"/>) The DatumFeature.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumFeature_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumFeature'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumFeature : <sch:value-of select="$uid"/>) The DatumFeature.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule DatumFeature.UR1)-->
   <sch:pattern id="DatumFeature_UR1"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='DatumFeature']"> <sch:let name="uid" value="@uid"/> <sch:let name="uidRef" value="./OfDatum/@uidRef"/> <sch:assert test=" not (($uidRef = following::ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum/@uidRef) or ($uidRef =preceding::ShapeElement[substring-after(@xsi:type,':')='DatumFeature']/OfDatum/@uidRef))"> (DatumFeature <sch:value-of select="$uid"/>) The OfDatum shall be unique within a population of DatumFeature OfDatum=$uidRef. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DatumReferenceCompartment set of rules-->
   <!--(Reference to Entity) DatumReferenceCompartment.PlaneSituationFeature : OPTIONAL PlaneShapeElement (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumReferenceCompartment_PlaneSituationFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumReferenceCompartment') or (self::GeneralDatumReference and substring-after(@xsi:type,':')='DatumReferenceCompartment'))]/PlaneSituationFeature">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PlaneShapeElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PlaneShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PlaneShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumReferenceCompartment : <sch:value-of select="$uid"/>) The DatumReferenceCompartment.PlaneSituationFeature contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PlaneShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DatumReferenceCompartment.PointSituationFeature : OPTIONAL PointShapeElement (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumReferenceCompartment_PointSituationFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumReferenceCompartment') or (self::GeneralDatumReference and substring-after(@xsi:type,':')='DatumReferenceCompartment'))]/PointSituationFeature">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PointShapeElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PointShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PointShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumReferenceCompartment : <sch:value-of select="$uid"/>) The DatumReferenceCompartment.PointSituationFeature contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PointShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DatumReferenceCompartment.StraightLineSituationFeature : OPTIONAL AxisPlacementShapeElement (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumReferenceCompartment_StraightLineSituationFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumReferenceCompartment') or (self::GeneralDatumReference and substring-after(@xsi:type,':')='DatumReferenceCompartment'))]/StraightLineSituationFeature">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacementShapeElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AxisPlacementShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' AxisPlacementShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumReferenceCompartment : <sch:value-of select="$uid"/>) The DatumReferenceCompartment.StraightLineSituationFeature contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AxisPlacementShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeneralDatumReference.Base : OPTIONAL Datum (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DatumReferenceCompartment_Base">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumReferenceCompartment') or (self::GeneralDatumReference and substring-after(@xsi:type,':')='DatumReferenceCompartment'))]/Base">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Datum ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' Datum ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DatumReferenceCompartment : <sch:value-of select="$uid"/>) The DatumReferenceCompartment.Base contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Datum.</sch:assert>
      </sch:rule>
   </sch:pattern>
