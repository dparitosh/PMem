      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PercentagePly.StrengthOrientation : OPTIONAL PlyOrientationAngle (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="PercentagePly_StrengthOrientation">
