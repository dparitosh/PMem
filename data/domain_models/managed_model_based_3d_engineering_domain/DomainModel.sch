      </sch:rule>
   </sch:pattern>
   <!--(Rule ObservationRelationship.WR1)-->
   <sch:pattern id="ObservationRelationship_WR1"> <sch:rule context="//ObservationRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related Observation and the relating Observation shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:ObservationRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
