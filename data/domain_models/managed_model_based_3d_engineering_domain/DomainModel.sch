   <!--Certification set of rules-->
   <!--(Rule specific to Id construct) Certification.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="Certification_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Certification') or (self::Certification and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
