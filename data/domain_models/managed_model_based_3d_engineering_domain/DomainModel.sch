      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ActivityRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ActivityRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityRelationship') or (self::ActivityRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
