   <!--(Rule DirectedToleranceZone.WR1)-->
   <sch:pattern id="DirectedToleranceZone_WR1"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='DirectedToleranceZone']"> <sch:let name="uid" value="@uid"/> <sch:let name="unitRef" value="child::Angle/Unit/@uidRef"/> <sch:assert test="not (Angle) or //Unit[@uid=$unitRef]/Quantity[(ClassString ='plane angle')]">(DirectedToleranceZone.WR1 <sch:value-of select="$uid"/>) if Angle is defined, the unit of Angle shall be a plane angle measure unit.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Direction set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DirectionFeatureToleranceZone set of rules-->
   <!--(Reference to Entity) ToleranceZoneWithDatum.DatumReference : DatumSystem (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="DirectionFeatureToleranceZone_DatumReference">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DirectionFeatureToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='DirectionFeatureToleranceZone'))]/DatumReference">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DirectionFeatureToleranceZone : <sch:value-of select="$uid"/>) The DirectionFeatureToleranceZone.DatumReference contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) DirectedOrOrientedToleranceZone.ZoneFor : SET[1:unbounded] OF DirectedOrOrientedGeometricToleranceSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=ToleranceZone.ZoneFor)-->
   <sch:pattern id="DirectionFeatureToleranceZone_ZoneFor">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DirectionFeatureToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='DirectionFeatureToleranceZone'))]/ZoneFor/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::DimensionalLocation and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))]) or (self::DimensionalSize and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))]) or (self::LineProfileTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',@typeRef,' '))]) or (self::ParallelismTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',@typeRef,' '))]) or (self::PerpendicularityTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',@typeRef,' '))]) or (self::PositionTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',@typeRef,' '))]) or (self::StraightnessTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',@typeRef,' '))]) or (self::SymmetryTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',@typeRef,' '))]) or (self::DimensionalLocation and //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::DimensionalSize and //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::LineProfileTolerance and //SubObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ParallelismTolerance and //SubObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PerpendicularityTolerance and //SubObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PositionTolerance and //SubObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StraightnessTolerance and //SubObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::SymmetryTolerance and //SubObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DirectionFeatureToleranceZone : <sch:value-of select="$uid"/>) The DirectionFeatureToleranceZone.ZoneFor contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of DirectedOrOrientedGeometricToleranceSelect.</sch:assert>
