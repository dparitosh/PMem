   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ComponentPlacement set of rules-->
   <!--(Reference to Entity) ComponentPlacement.PlacedComponent : BreakdownElementView (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ComponentPlacement_PlacedComponent">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComponentPlacement') or (self::ComponentPlacement and not(@xsi:type)))]/PlacedComponent">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',substring-after(@xsi:type,':'),' '))] or //BreakdownElementView[@uid = $uidRef]">(ComponentPlacement : <sch:value-of select="$uid"/>) The ComponentPlacement.PlacedComponent contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type BreakdownElementView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ComponentPlacement.Placement : TransformationSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ComponentPlacement_Placement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComponentPlacement') or (self::ComponentPlacement and not(@xsi:type)))]/Placement/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::GeometricRepresentationRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //SubObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianTransformation) or (self::GeometricRepresentationRelationship and //RepresentationRelationship[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))])">(ComponentPlacement : <sch:value-of select="$uid"/>) The ComponentPlacement.Placement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of TransformationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ComponentPlacement.ReferenceComponent : BreakdownElementView (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ComponentPlacement_ReferenceComponent">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComponentPlacement') or (self::ComponentPlacement and not(@xsi:type)))]/ReferenceComponent">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',substring-after(@xsi:type,':'),' '))] or //BreakdownElementView[@uid = $uidRef]">(ComponentPlacement : <sch:value-of select="$uid"/>) The ComponentPlacement.ReferenceComponent contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type BreakdownElementView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ComponentPlacement.WR1)-->
   <sch:pattern id="ComponentPlacement_WR1"> <sch:rule context="//ComponentPlacement[@uid]"> <sch:let name="uid" value="@uid"/> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="reference_uidRef" value="Placement/*/@uidRef"/> <sch:assert test="not(substring-after(//*[@uid=$reference_uidRef]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $reference_uidRef]/Definitional=true()"> Either the Placement is of type CartesianTransformation or it is of type GeometricRepresentationRelationshipWithPlacementTransformation and the inherited attribute definitional has the value TRUE. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -reference:<sch:value-of select="$reference_uidRef"/> -attribute_value:<sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ComposedGeometricModel set of rules-->
   <!--(Reference to Select) ComposedGeometricModel.Items : SET[1:unbounded] OF AxisPlacementOrTransformationSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=Representation.Items)-->
   <sch:pattern id="ComposedGeometricModel_Items">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComposedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='ComposedGeometricModel'))]/Items/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::AxisPlacement and //ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::AxisPlacement and //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' ')))) and @uid = $uidRef]">(ComposedGeometricModel : <sch:value-of select="$uid"/>) The ComposedGeometricModel.Items contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of AxisPlacementOrTransformationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of GeometricCoordinateSpace.Representations :: PartProperty) GeometricRepresentation.ContextOfItems : GeometricCoordinateSpace => no rule needed when PartProperty or Optional-->
   <!--(Rule specific to Id construct) Representation.Id : IdentifierSelect-->
   <sch:pattern id="ComposedGeometricModel_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComposedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='ComposedGeometricModel'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ComposedGeometricModel : <sch:value-of select="$uid"/>) The ComposedGeometricModel.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Representation.VersionId : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ComposedGeometricModel_VersionId">
