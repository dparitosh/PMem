         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(CentreOfMass : <sch:value-of select="$uid"/>) The CentreOfMass.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
