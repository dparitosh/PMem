   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--RoundnessTolerance set of rules-->
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="RoundnessTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='RoundnessTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='RoundnessTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(RoundnessTolerance : <sch:value-of select="$uid"/>) The RoundnessTolerance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="RoundnessTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='RoundnessTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='RoundnessTolerance'))]/AppliedTo">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(RoundnessTolerance : <sch:value-of select="$uid"/>) The RoundnessTolerance.AppliedTo contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricToleranceTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="RoundnessTolerance_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='RoundnessTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='RoundnessTolerance'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
