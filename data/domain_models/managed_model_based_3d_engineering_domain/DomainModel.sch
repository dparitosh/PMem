   <sch:pattern id="PercentageLaminateTable_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PercentageLaminateTable') or (self::PartView and substring-after(@xsi:type,':')='PercentageLaminateTable'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(PercentageLaminateTable : <sch:value-of select="$uid"/>) The PercentageLaminateTable.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartView.DefiningGeometry : OPTIONAL GeometricModel (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="PercentageLaminateTable_DefiningGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PercentageLaminateTable') or (self::PartView and substring-after(@xsi:type,':')='PercentageLaminateTable'))]/DefiningGeometry">
         <sch:let name="uid" value="../@uid"/>
