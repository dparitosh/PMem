   <!--(Inverse of PartVersion.Views :: PartProperty) PartView.ViewOf : PartVersion => no rule needed when PartProperty or Optional-->
   <!--(Rule LaminateTable.WR1)-->
   <sch:pattern id="LaminateTable_WR1"><sch:rule context="//PartView[@uid and local-fn:testXsiTypeLaminateTable(@xsi:type)=true()]"> <sch:let name="uid" value="@uid"/> <sch:let name="viewContextRef" value="InitialContext/@uidRef"/> <sch:let name="applicationDomainRef" value="//*[@uid=$viewContextRef]/ApplicationDomain/ApplicationDomain/@uidRef"/> <sch:let name="proxyRef" value="//*[@uid=$viewContextRef]/ApplicationDomain/Proxy/@uidRef"/> <sch:assert test="(//*[@uid=$viewContextRef]/ApplicationDomain/child::* eq 'composites') or (//*[@uid=$applicationDomainRef]/SameAs/Proxy/Individual/ProxyString eq 'composites') or (//*[@uid=$proxyRef]/Individual/ProxyString eq 'composites')">(LaminateTable.WR1 <sch:value-of select="$uid"/>) the application domain of a LaminateTable shall be 'composites'.</sch:assert> </sch:rule></sch:pattern>
