      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OrientedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='OrientedToleranceZone'))]/DatumReference">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OrientedToleranceZone : <sch:value-of select="$uid"/>) The OrientedToleranceZone.DatumReference contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) DirectedOrOrientedToleranceZone.ZoneFor : SET[1:unbounded] OF DirectedOrOrientedGeometricToleranceSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=ToleranceZone.ZoneFor)-->
   <sch:pattern id="OrientedToleranceZone_ZoneFor">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OrientedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='OrientedToleranceZone'))]/ZoneFor/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::DimensionalLocation and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))]) or (self::DimensionalSize and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))]) or (self::LineProfileTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',@typeRef,' '))]) or (self::ParallelismTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',@typeRef,' '))]) or (self::PerpendicularityTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',@typeRef,' '))]) or (self::PositionTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',@typeRef,' '))]) or (self::StraightnessTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',@typeRef,' '))]) or (self::SymmetryTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',@typeRef,' '))]) or (self::DimensionalLocation and //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::DimensionalSize and //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::LineProfileTolerance and //SubObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ParallelismTolerance and //SubObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PerpendicularityTolerance and //SubObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PositionTolerance and //SubObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StraightnessTolerance and //SubObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::SymmetryTolerance and //SubObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OrientedToleranceZone : <sch:value-of select="$uid"/>) The OrientedToleranceZone.ZoneFor contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of DirectedOrOrientedGeometricToleranceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="OrientedToleranceZone_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OrientedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='OrientedToleranceZone'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(OrientedToleranceZone : <sch:value-of select="$uid"/>) The OrientedToleranceZone.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="OrientedToleranceZone_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OrientedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='OrientedToleranceZone'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(OrientedToleranceZone : <sch:value-of select="$uid"/>) The OrientedToleranceZone.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="OrientedToleranceZone_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OrientedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='OrientedToleranceZone'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OrientedToleranceZone : <sch:value-of select="$uid"/>) The OrientedToleranceZone.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule OrientedToleranceZone.WR1)-->
   <sch:pattern id="OrientedToleranceZone_WR1"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='OrientedToleranceZone']"> <sch:let name="uid" value="@uid"/> <sch:assert test="(./Orientation != 'angular' and not(./Angle)) or (./Orientation = 'angular' and ./Angle)"> (OrientedToleranceZone <sch:value-of select="$uid"/>) An angle value shall only be specified if and only if the orientation is of type angular. </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule OrientedToleranceZone.WR2)-->
   <sch:pattern id="OrientedToleranceZone_WR2"><sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='OrientedToleranceZone']/Angle"> <sch:let name="uid" value="../@uid"/> <sch:let name="unitRef" value="./Unit/@uidRef"/> <sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='plane angle'">(OrientedToleranceZone <sch:value-of select="$uid"/>) The unit of Angle shall be a plane angle measure unit. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--OverRidingStyledElement set of rules-->
   <!--(Reference to Entity) OverRidingStyledElement.OverRiddenElement : StyledElement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="OverRidingStyledElement_OverRiddenElement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OverRidingStyledElement') or (self::RepresentationItem and substring-after(@xsi:type,':')='OverRidingStyledElement'))]/OverRiddenElement">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OverRidingStyledElement : <sch:value-of select="$uid"/>) The OverRidingStyledElement.OverRiddenElement contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type StyledElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) StyledElement.Element : StyledElementTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="OverRidingStyledElement_Element">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OverRidingStyledElement') or (self::RepresentationItem and substring-after(@xsi:type,':')='OverRidingStyledElement'))]/Element">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef] or //RepresentationItem[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OverRidingStyledElement : <sch:value-of select="$uid"/>) The OverRidingStyledElement.Element contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of StyledElementTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule OverRidingStyledElement.WR1)-->
   <sch:pattern id="OverRidingStyledElement_WR1"> <sch:rule context="//RepresentationItem[@uid and local-fn:testXsiTypeOverRidingStyledElement(@xsi:type)=true()]"> <sch:let name="uid" value="@uid"/> <sch:assert test="child::Appearance or child::Invisible">(OverRidingStyledElement.WR1 <sch:value-of select="$uid"/>) the Appearance shall be defined or the Invisible shall be defined.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ParallelOffset set of rules-->
   <!--(Reference to Entity) ParallelOffset.DerivedFrom : ShapeElement (kind=SINGLE - cardinality= - redefined=DerivedShapeElement.DerivedFrom)-->
   <sch:pattern id="ParallelOffset_DerivedFrom">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelOffset') or (self::ShapeElement and substring-after(@xsi:type,':')='ParallelOffset'))]/DerivedFrom">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="count(../DerivedFrom/ShapeElement) = 1">(ParallelOffset : <sch:value-of select="$uid"/>) The ParallelOffset.DerivedFrom contains wrong number of element must be 1.</sch:assert>
      </sch:rule>
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelOffset') or (self::ShapeElement and substring-after(@xsi:type,':')='ParallelOffset'))]/DerivedFrom/ShapeElement">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef]">(ParallelOffset : <sch:value-of select="$uid"/>) The ParallelOffset.DerivedFrom contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ParallelOffset_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelOffset') or (self::ShapeElement and substring-after(@xsi:type,':')='ParallelOffset'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ParallelOffset : <sch:value-of select="$uid"/>) The ParallelOffset.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ParallelOffset_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelOffset') or (self::ShapeElement and substring-after(@xsi:type,':')='ParallelOffset'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ParallelOffset : <sch:value-of select="$uid"/>) The ParallelOffset.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ParallelOffset_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelOffset') or (self::ShapeElement and substring-after(@xsi:type,':')='ParallelOffset'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ParallelOffset : <sch:value-of select="$uid"/>) The ParallelOffset.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ParallelismTolerance set of rules-->
   <!--(Reference to Entity) ParallelismTolerance.DatumSystem : DatumSystem (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ParallelismTolerance_DatumSystem">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelismTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='ParallelismTolerance'))]/DatumSystem">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ParallelismTolerance : <sch:value-of select="$uid"/>) The ParallelismTolerance.DatumSystem contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ParallelismTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelismTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='ParallelismTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ParallelismTolerance : <sch:value-of select="$uid"/>) The ParallelismTolerance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ParallelismTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelismTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='ParallelismTolerance'))]/AppliedTo">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(ParallelismTolerance : <sch:value-of select="$uid"/>) The ParallelismTolerance.AppliedTo contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricToleranceTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ParallelismTolerance_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelismTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='ParallelismTolerance'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ParallelismTolerance : <sch:value-of select="$uid"/>) The ParallelismTolerance.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.GeometricToleranceContext : OPTIONAL PartView (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ParallelismTolerance_GeometricToleranceContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ParallelismTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='ParallelismTolerance'))]/GeometricToleranceContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(ParallelismTolerance : <sch:value-of select="$uid"/>) The ParallelismTolerance.GeometricToleranceContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PartView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Part set of rules-->
   <!--(Rule specific to Id construct) Part.Id : IdentifierSelect-->
   <sch:pattern id="Part_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Part') or (self::Part and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Part : <sch:value-of select="$uid"/>) The Part.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Part.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Part_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Part') or (self::Part and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(Part : <sch:value-of select="$uid"/>) The Part.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Part.PartTypes : SET[1:unbounded] OF PartClassSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Part_PartTypes">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Part') or (self::Part and not(@xsi:type)))]/PartTypes/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef]) or (self::PartCategoryEnum)">(Part : <sch:value-of select="$uid"/>) The Part.PartTypes contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PartClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--PartConnectivityDefinition set of rules-->
   <!--(Reference to Select) PartConnectivityDefinition.ConnectedTerminals : SET[2:unbounded] OF ConnectedTerminalSelect (kind=AGGREGATE - cardinality=SET[2:unbounded] OF  - redefined=false)-->
   <sch:pattern id="PartConnectivityDefinition_ConnectedTerminals">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PartConnectivityDefinition') or (self::ShapeElement and substring-after(@xsi:type,':')='PartConnectivityDefinition'))]/ConnectedTerminals/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::OccurrenceTerminal and //ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',@typeRef,' '))]) or (self::PartTerminal and //ExternalRefBaseObject[@uid = $uidRef and contains(' PartTerminal ',concat(' ',@typeRef,' '))]) or (self::OccurrenceTerminal and //SubObject[@uid = $uidRef and contains(' OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PartTerminal and //SubObject[@uid = $uidRef and contains(' PartTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::OccurrenceTerminal and //ShapeElement[@uid = $uidRef and contains(' OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PartTerminal and //ShapeElement[@uid = $uidRef and contains(' PartTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))])">(PartConnectivityDefinition : <sch:value-of select="$uid"/>) The PartConnectivityDefinition.ConnectedTerminals contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ConnectedTerminalSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) PartShapeElement.PartDefinition : OPTIONAL PartShapeElementDefinitionSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="PartConnectivityDefinition_PartDefinition">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PartConnectivityDefinition') or (self::ShapeElement and substring-after(@xsi:type,':')='PartConnectivityDefinition'))]/PartDefinition">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinition[@uid = $uidRef] or //ShapeElement[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinitionRelationship[@uid = $uidRef]">(PartConnectivityDefinition : <sch:value-of select="$uid"/>) The PartConnectivityDefinition.PartDefinition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PartShapeElementDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PartConnectivityDefinition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PartConnectivityDefinition') or (self::ShapeElement and substring-after(@xsi:type,':')='PartConnectivityDefinition'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(PartConnectivityDefinition : <sch:value-of select="$uid"/>) The PartConnectivityDefinition.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="PartConnectivityDefinition_ClassifiedAs">
