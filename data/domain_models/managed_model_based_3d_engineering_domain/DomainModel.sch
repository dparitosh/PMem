      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Class.Source : OPTIONAL ExternalSourceSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="Class_Source">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Class') or (self::Class and not(@xsi:type)))]/Source/*">
         <sch:let name="uid" value="../../@uid"/>
