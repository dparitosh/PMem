   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Id set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Identifier set of rules-->
   <!--(Rule specific to Id construct) Identifier.Id : IdentifierString-->
   <sch:pattern id="Identifier_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Identifier') or (self::Identifier and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Identifier : <sch:value-of select="$uid"/>) The Identifier.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Identifier.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Identifier_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Identifier') or (self::Identifier and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(Identifier : <sch:value-of select="$uid"/>) The Identifier.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference specific) Identifier.IdentificationContext : OPTIONAL IdentificationContextSelect-->
   <!--(Reference specific) Identifier.Role : ClassSelect-->
   <sch:pattern id="Identifier_IdentificationContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Identifier') or self::Identifier)]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="idContextRef" value="@idContextRef"/>
         <sch:let name="idRoleRef" value="@idRoleRef"/>
         <sch:assert test="count($idContextRef) = 0 or (count($idContextRef) = 1 and (//Identifier[@uid = $idContextRef] or //Organization[@uid = $idContextRef]))">(Identifier : <sch:value-of select="$uid"/>) The Identifier.IdentificationContext contains a bad reference (<sch:value-of select="$idContextRef"/>).</sch:assert>
         <sch:assert test="//Class[@uid = $idRoleRef] or //ExternalOwlClass[@uid = $idRoleRef]">(Identifier : <sch:value-of select="$uid"/>) The Identifier.Role contains a bad reference (<sch:value-of select="$idRoleRef"/>).</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
