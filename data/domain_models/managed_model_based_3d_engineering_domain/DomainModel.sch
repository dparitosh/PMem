   <!--OccurrencePlacement set of rules-->
   <!--(Reference to Entity) OccurrencePlacement.PlacedInstance : SingleOccurrence (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="OccurrencePlacement_PlacedInstance">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OccurrencePlacement') or (self::OccurrencePlacement and not(@xsi:type)))]/PlacedInstance">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' SingleOccurrence ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Occurrence[@uid = $uidRef and contains(' SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))]">(OccurrencePlacement : <sch:value-of select="$uid"/>) The OccurrencePlacement.PlacedInstance contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type SingleOccurrence.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) OccurrencePlacement.Placement : TransformationSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="OccurrencePlacement_Placement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OccurrencePlacement') or (self::OccurrencePlacement and not(@xsi:type)))]/Placement/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::GeometricRepresentationRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //SubObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianTransformation) or (self::GeometricRepresentationRelationship and //RepresentationRelationship[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))])">(OccurrencePlacement : <sch:value-of select="$uid"/>) The OccurrencePlacement.Placement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of TransformationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) OccurrencePlacement.ReferenceComponent : BreakdownElementView (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="OccurrencePlacement_ReferenceComponent">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OccurrencePlacement') or (self::OccurrencePlacement and not(@xsi:type)))]/ReferenceComponent">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',substring-after(@xsi:type,':'),' '))] or //BreakdownElementView[@uid = $uidRef]">(OccurrencePlacement : <sch:value-of select="$uid"/>) The OccurrencePlacement.ReferenceComponent contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type BreakdownElementView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule OccurrencePlacement.WR1)-->
   <sch:pattern id="OccurrencePlacement_WR1"> <sch:rule context="//OccurrencePlacement[@uid]"> <sch:let name="uid" value="@uid"/> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="reference_uidRef" value="Placement/*/@uidRef"/> <sch:assert test="not(substring-after(//*[@uid=$reference_uidRef]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $reference_uidRef]/Definitional=true()"> Either the Placement is of type CartesianTransformation or it is of type GeometricRepresentationRelationshipWithPlacementTransformation and the inherited attribute definitional has the value TRUE. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -reference:<sch:value-of select="$reference_uidRef"/> -attribute_value:<sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/> } </sch:assert> </sch:rule></sch:pattern>
