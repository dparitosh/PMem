      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.GeometricToleranceContext : OPTIONAL PartView (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="CoaxialityTolerance_GeometricToleranceContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CoaxialityTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='CoaxialityTolerance'))]/GeometricToleranceContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(CoaxialityTolerance : <sch:value-of select="$uid"/>) The CoaxialityTolerance.GeometricToleranceContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PartView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CollectedPartRelationship set of rules-->
   <!--(Default Value) CollectedPartRelationship.RelationType : String = 'collected part view' (kind=SINGLE - redefined=ViewOccurrenceRelationship.RelationType)-->
   <sch:pattern id="CollectedPartRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectedPartRelationship') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='CollectedPartRelationship'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'collected part view'">(CollectedPartRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'collected part view'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ViewOccurrenceRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="CollectedPartRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectedPartRelationship') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='CollectedPartRelationship'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(CollectedPartRelationship : <sch:value-of select="$uid"/>) The CollectedPartRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ViewOccurrenceRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CollectedPartRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectedPartRelationship') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='CollectedPartRelationship'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(CollectedPartRelationship : <sch:value-of select="$uid"/>) The CollectedPartRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ViewOccurrenceRelationship.Related : DefinitionBasedOccurrence (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="CollectedPartRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectedPartRelationship') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='CollectedPartRelationship'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Occurrence[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CollectedPartRelationship : <sch:value-of select="$uid"/>) The CollectedPartRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DefinitionBasedOccurrence.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ViewOccurrenceRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="CollectedPartRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectedPartRelationship') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='CollectedPartRelationship'))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(CollectedPartRelationship : <sch:value-of select="$uid"/>) The CollectedPartRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CollectionDefinition set of rules-->
   <!--(Rule specific to Id construct) PartView.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="CollectionDefinition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CollectionDefinition') or (self::PartView and substring-after(@xsi:type,':')='CollectionDefinition'))]/Id">
         <sch:let name="uid" value="../@uid"/>
