   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Descriptor set of rules-->
   <!--(Rule specific to Id construct) Descriptor.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="Descriptor_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Descriptor') or (self::Descriptor and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Descriptor : <sch:value-of select="$uid"/>) The Descriptor.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Descriptor.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Descriptor_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Descriptor') or (self::Descriptor and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(Descriptor : <sch:value-of select="$uid"/>) The Descriptor.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Descriptor.DescriptionContext : OPTIONAL SET[1:unbounded] OF IdentificationContextSelect (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Descriptor_DescriptionContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Descriptor') or (self::Descriptor and not(@xsi:type)))]/DescriptionContext/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Identifier and //ExternalRefBaseObject[@uid = $uidRef and contains(' Identifier ',concat(' ',@typeRef,' '))]) or (self::Organization and //ExternalRefBaseObject[@uid = $uidRef and contains(' Organization ',concat(' ',@typeRef,' '))]) or (self::Identifier and //SubObject[@uid = $uidRef and contains(' Identifier ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Organization and //SubObject[@uid = $uidRef and contains(' Organization ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Identifier and //Identifier[@uid = $uidRef]) or (self::Organization and //Organization[@uid = $uidRef])">(Descriptor : <sch:value-of select="$uid"/>) The Descriptor.DescriptionContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of IdentificationContextSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
