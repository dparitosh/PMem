      </sch:rule>
   </sch:pattern>
   <!--(Inverse of PartVersion.Views :: PartProperty) PartView.ViewOf : PartVersion => no rule needed when PartProperty or Optional-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--PercentagePly set of rules-->
   <!--(Reference to Entity) PercentagePly.MakeupAndProperties : OPTIONAL ZoneStructuralMakeup (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="PercentagePly_MakeupAndProperties">
