      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionAssignment') or (self::ConditionAssignment and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
