   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--WorkRequestAssignment set of rules-->
   <!--(Rule specific to Id construct) WorkRequestAssignment.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="WorkRequestAssignment_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestAssignment') or (self::WorkRequestAssignment and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(WorkRequestAssignment : <sch:value-of select="$uid"/>) The WorkRequestAssignment.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) WorkRequestAssignment.AssignedWorkRequest : WorkRequest (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="WorkRequestAssignment_AssignedWorkRequest">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestAssignment') or (self::WorkRequestAssignment and not(@xsi:type)))]/AssignedWorkRequest">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' WorkRequest ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' WorkRequest ',concat(' ',substring-after(@xsi:type,':'),' '))] or //WorkRequest[@uid = $uidRef]">(WorkRequestAssignment : <sch:value-of select="$uid"/>) The WorkRequestAssignment.AssignedWorkRequest contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type WorkRequest.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) WorkRequestAssignment.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="WorkRequestAssignment_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestAssignment') or (self::WorkRequestAssignment and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(WorkRequestAssignment : <sch:value-of select="$uid"/>) The WorkRequestAssignment.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) WorkRequestAssignment.Role : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="WorkRequestAssignment_Role">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestAssignment') or (self::WorkRequestAssignment and not(@xsi:type)))]/Role/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(WorkRequestAssignment : <sch:value-of select="$uid"/>) The WorkRequestAssignment.Role contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--WorkRequestRelationship set of rules-->
   <!--(Rule specific to Id construct) WorkRequestRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="WorkRequestRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestRelationship') or (self::WorkRequestRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(WorkRequestRelationship : <sch:value-of select="$uid"/>) The WorkRequestRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) WorkRequestRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="WorkRequestRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestRelationship') or (self::WorkRequestRelationship and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(WorkRequestRelationship : <sch:value-of select="$uid"/>) The WorkRequestRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) WorkRequestRelationship.Related : WorkRequest (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="WorkRequestRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestRelationship') or (self::WorkRequestRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' WorkRequest ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' WorkRequest ',concat(' ',substring-after(@xsi:type,':'),' '))] or //WorkRequest[@uid = $uidRef]">(WorkRequestRelationship : <sch:value-of select="$uid"/>) The WorkRequestRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type WorkRequest.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) WorkRequestRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="WorkRequestRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WorkRequestRelationship') or (self::WorkRequestRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(WorkRequestRelationship : <sch:value-of select="$uid"/>) The WorkRequestRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule WorkRequestRelationship.WR1)-->
   <sch:pattern id="WorkRequestRelationship_WR1"> <sch:rule context="//WorkRequestRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related WorkRequest and the relating WorkRequest shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:WorkRequestRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ZonalBreakdown set of rules-->
   <!--(Default Value) ZonalBreakdown.BreakdownType : String = 'zonal' (kind=SINGLE - redefined=Breakdown.BreakdownType)-->
   <sch:pattern id="ZonalBreakdown_BreakdownType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ZonalBreakdown') or (self::Breakdown and substring-after(@xsi:type,':')='ZonalBreakdown'))]/BreakdownType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'zonal'">(ZonalBreakdown : <sch:value-of select="$uid"/>) The value of BreakdownType shall be 'zonal'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Breakdown.Id : IdentifierSelect-->
   <sch:pattern id="ZonalBreakdown_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ZonalBreakdown') or (self::Breakdown and substring-after(@xsi:type,':')='ZonalBreakdown'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ZonalBreakdown : <sch:value-of select="$uid"/>) The ZonalBreakdown.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Breakdown.BreakdownType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ZonalBreakdown_BreakdownType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ZonalBreakdown') or (self::Breakdown and substring-after(@xsi:type,':')='ZonalBreakdown'))]/BreakdownType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ZonalBreakdown : <sch:value-of select="$uid"/>) The ZonalBreakdown.BreakdownType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Breakdown.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ZonalBreakdown_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ZonalBreakdown') or (self::Breakdown and substring-after(@xsi:type,':')='ZonalBreakdown'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ZonalBreakdown : <sch:value-of select="$uid"/>) The ZonalBreakdown.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ZoneStructuralMakeup set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ZoneStructuralMakeupShapeRepresentation set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--(Function testXsiTypeAssemblyDefinition)--><xsl:function name="local-fn:testXsiTypeAssemblyDefinition"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'AssemblyDefinition' or substring-after($xsiType,':') = 'MatingDefinition' or substring-after($xsiType,':') = 'WiringHarnessAssemblyDesign'"/></xsl:function><!--(Function testXsiTypeAssemblyOccurrenceRelationship)--><xsl:function name="local-fn:testXsiTypeAssemblyOccurrenceRelationship"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'AssemblyOccurrenceRelationship' or substring-after($xsiType,':') = 'NextAssemblyOccurrenceUsage' or substring-after($xsiType,':') = 'MatedPartAssociation' or substring-after($xsiType,':') = 'PromissoryAssemblyOccurrenceUsage'"/></xsl:function><!--(Function testXsiTypeConstituentPart)--><xsl:function name="local-fn:testXsiTypeConstituentPart"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'ConstituentPart' or substring-after($xsiType,':') = 'CompositeAssembly' or substring-after($xsiType,':') = 'FilamentLaminate' or substring-after($xsiType,':') = 'Ply' or substring-after($xsiType,':') = 'PlyLaminate' or substring-after($xsiType,':') = 'PlyPiece' or substring-after($xsiType,':') = 'ProcessedCore'"/></xsl:function><!--(Function testXsiTypeExternalGeometricModel)--><xsl:function name="local-fn:testXsiTypeExternalGeometricModel"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'ExternalGeometricModel' or substring-after($xsiType,':') = 'ExternalAdvancedBrepShapeRepresentation' or substring-after($xsiType,':') = 'ExternalCsgShapeRepresentation' or substring-after($xsiType,':') = 'ExternalCurveSweptSolidShapeRepresentation' or substring-after($xsiType,':') = 'ExternalEdgeBasedWireframeShapeRepresentation' or substring-after($xsiType,':') = 'ExternalElementaryBrepShapeRepresentation' or substring-after($xsiType,':') = 'ExternalFacetedBrepShapeRepresentation' or substring-after($xsiType,':') = 'ExternalGeometricallyBoundedSurfaceShapeRepresentation' or substring-after($xsiType,':') = 'ExternalGeometricallyBoundedWireframeShapeRepresentation' or substring-after($xsiType,':') = 'ExternalManifoldSurfaceShapeRepresentation' or substring-after($xsiType,':') = 'ExternalShellBasedWireframeShapeRepresentation' or substring-after($xsiType,':') = 'ExternalTessellatedShapeRepresentation'"/></xsl:function><!--(Function testXsiTypeLaminateTable)--><xsl:function name="local-fn:testXsiTypeLaminateTable"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'LaminateTable' or substring-after($xsiType,':') = 'CompositeAssemblyTable' or substring-after($xsiType,':') = 'PlyLaminateTable' or substring-after($xsiType,':') = 'ZoneStructuralMakeup' or substring-after($xsiType,':') = 'PercentageLaminateTable' or substring-after($xsiType,':') = 'SmearedMaterial' or substring-after($xsiType,':') = 'ThicknessLaminateTable'"/></xsl:function><!--(Function testXsiTypeOccurrenceShapeElement)--><xsl:function name="local-fn:testXsiTypeOccurrenceShapeElement"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'OccurrenceShapeElement' or substring-after($xsiType,':') = 'OccurrenceShapeFeature' or substring-after($xsiType,':') = 'CrossSectionalOccurrenceShapeElement' or substring-after($xsiType,':') = 'OccurrenceContactFeature' or substring-after($xsiType,':') = 'OccurrenceTerminal' or substring-after($xsiType,':') = 'CableOccurrenceTerminal' or substring-after($xsiType,':') = 'CableOccurrenceTerminalLocationGroup' or substring-after($xsiType,':') = 'WireOccurrenceTerminal' or substring-after($xsiType,':') = 'OccurrenceTransportFeature' or substring-after($xsiType,':') = 'WireOccurrenceIdentification'"/></xsl:function><!--(Function testXsiTypeOccurrenceShapeFeature)--><xsl:function name="local-fn:testXsiTypeOccurrenceShapeFeature"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'OccurrenceShapeFeature' or substring-after($xsiType,':') = 'CrossSectionalOccurrenceShapeElement' or substring-after($xsiType,':') = 'OccurrenceContactFeature' or substring-after($xsiType,':') = 'OccurrenceTerminal' or substring-after($xsiType,':') = 'CableOccurrenceTerminal' or substring-after($xsiType,':') = 'CableOccurrenceTerminalLocationGroup' or substring-after($xsiType,':') = 'WireOccurrenceTerminal' or substring-after($xsiType,':') = 'OccurrenceTransportFeature' or substring-after($xsiType,':') = 'WireOccurrenceIdentification'"/></xsl:function><!--(Function testXsiTypeOverRidingStyledElement)--><xsl:function name="local-fn:testXsiTypeOverRidingStyledElement"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'OverRidingStyledElement' or substring-after($xsiType,':') = 'ContextDependentOverRidingStyledElement'"/></xsl:function><!--(Function testXsiTypePartFeature)--><xsl:function name="local-fn:testXsiTypePartFeature"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'PartFeature' or substring-after($xsiType,':') = 'CrossSectionalPartShapeElement' or substring-after($xsiType,':') = 'CrossSectionalAlternativePartShapeElement' or substring-after($xsiType,':') = 'CrossSectionalGroupShapeElement' or substring-after($xsiType,':') = 'CrossSectionalGroupShapeElementWithLacing' or substring-after($xsiType,':') = 'CrossSectionalGroupShapeElementWithTubularCover' or substring-after($xsiType,':') = 'TwistedCrossSectionalGroupShapeElement' or substring-after($xsiType,':') = 'PartContactFeature' or substring-after($xsiType,':') = 'PartTerminal' or substring-after($xsiType,':') = 'PartTransportFeature' or substring-after($xsiType,':') = 'WirePartIdentification'"/></xsl:function><!--(Function testXsiTypeShapeFeatureDefinitionElement)--><xsl:function name="local-fn:testXsiTypeShapeFeatureDefinitionElement"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'ShapeFeatureDefinitionElement' or substring-after($xsiType,':') = 'ShapeFeatureDefinitionOccurrenceElement'"/></xsl:function><!--(Function testXsiTypeShapeFeatureDefinitionElementRelationship)--><xsl:function name="local-fn:testXsiTypeShapeFeatureDefinitionElementRelationship"><xsl:param name="xsiType"/><xsl:value-of select="substring-after($xsiType,':') = 'ShapeFeatureDefinitionElementRelationship' or substring-after($xsiType,':') = 'ShapeFeatureDefinitionOccurrenceElementRelationship'"/></xsl:function><!--(Function MainUpperUsage : The MainUpperUsage function determines the final instance of a potential list of instances of entity data type SpecifiedOccurrence that are linked by the attribute UpperUsage. The function returns the final Occurrence that is not of type SpecifiedOccurrence.)--><xsl:function name="local-fn:MainUpperUsage"> <xsl:param name="dataContainer"/> <xsl:param name="occurrenceUID"/> <xsl:variable name="occurrence" select="$dataContainer/descendant::*[@uid =$occurrenceUID]"/> <xsl:choose> <xsl:when test="count ($occurrence/UpperUsage) = 1"> <xsl:value-of select="local-fn:MainUpperUsage($dataContainer , $occurrence/UpperUsage/@uidRef)"/> </xsl:when> <xsl:otherwise> <xsl:value-of select="$occurrenceUID"/> </xsl:otherwise> </xsl:choose> </xsl:function><!--(Function UsingRepresentations : The function UsingRepresentations returns the set of Representations in which a RepresentationItem is used. A RepresentationItem is used in a Representation if it is: - referenced in the set of items of the Representation, or - referenced by a RepresentationItem used in the Representation. A RepresentationItem is used in a Representation if it is referenced directly, or indirectly, by a Representation_item in the set of items of the Representation.)--><xsl:function name="local-fn:UsingRepresentations"> <xsl:param name="dataContainer"/> <xsl:param name="repItem"/> <xsl:variable name="directRep" select="$dataContainer/descendant::Representation[child::Items/RepresentationItem[@uidRef=$repItem/@uid]]/@uid"/> <xsl:variable name="indirectRep" select= "for $i in $dataContainer/descendant::RepresentationItem[descendant::*[@uidRef=$repItem/@uid]] return local-fn:UsingRepresentations($dataContainer,$i)"/> <xsl:sequence select="$directRep union $indirectRep"/> </xsl:function><!--(Function AcyclicOccurrenceShapeElement : The AcyclicOccurrenceShapeElement function determines whether the graph of instances of the entity data type OccurrenceShapeElement established by the attribute definition contains a cycle. The function returns TRUE if no cycle has been detected. Otherwise, it returns FALSE.)--><xsl:function name="local-fn:AcyclicOccurrenceShapeElement"> <xsl:param name="dataContainer"/> <xsl:param name="occurrenceShapeElementUIDList"/> <xsl:variable name="occurrenceShapeElementUID" select="$occurrenceShapeElementUIDList[1]"/> <xsl:variable name="occurrence" select="$dataContainer/descendant::*[@uid =$occurrenceShapeElementUID]"/> <xsl:choose> <xsl:when test="count($occurrence/Definition)=0"> <xsl:value-of select="true()"/> </xsl:when> <xsl:otherwise> <xsl:choose> <xsl:when test="some $i in $occurrenceShapeElementUIDList satisfies $i eq $occurrence/Definition/@uidRef"> <xsl:value-of select="false()"/> </xsl:when> <xsl:otherwise> <xsl:value-of select="local-fn:AcyclicOccurrenceShapeElement($dataContainer , insert-before($occurrenceShapeElementUIDList, 0, $occurrence/Definition/@uidRef))"/> </xsl:otherwise> </xsl:choose> </xsl:otherwise> </xsl:choose> </xsl:function></sch:schema>
