   <!--(Rule ViewContext.UR1)-->
   <sch:pattern id="ViewContext_UR1"> <sch:rule context="//ViewContext[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="adRef" value="if(ApplicationDomain/ApplicationDomain/@uidRef and //ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString) then //ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString else ApplicationDomain/ApplicationDomain/@uidRef"/> <sch:let name="lcsRef" value="if(LifeCycleStage/LifeCycleStage/@uidRef and //LifeCycleStage[@uid and @uid = LifeCycleStage/LifeCycleStage/@uidRef]/SameAs/Proxy/Individual/ProxyString) then //LifeCycleStage[@uid and @uid = LifeCycleStage/LifeCycleStage/@uidRef]/SameAs/Proxy/Individual/ProxyString else LifeCycleStage/LifeCycleStage/@uidRef"/> <sch:let name="ad" value="if(ApplicationDomain/ProxyString) then ApplicationDomain/ProxyString else if(if(ApplicationDomain/ApplicationDomain/@uidRef and //ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString) then //ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString else ApplicationDomain/ApplicationDomain/@uidRef) then if(ApplicationDomain/ApplicationDomain/@uidRef and //ApplicationDomain/ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString) then //ApplicationDomain/ApplicationDomain[@uid and @uid = ApplicationDomain/ApplicationDomain/@uidRef]/SameAs/Proxy/Individual/ProxyString else ApplicationDomain/ApplicationDomain/@uidRef else ()"/> <sch:let name="lcs" value="if(LifeCycleStage/ProxyString) then LifeCycleStage/ProxyString else if(if(LifeCycleStage/LifeCycleStage/@uidRef and //LifeCycleStage[@uid and @uid = LifeCycleStage/LifeCycleStage/@uidRef]/SameAs/Proxy/Individ