         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(DescriptorRelationship : <sch:value-of select="$uid"/>) The DescriptorRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DescriptorRelationship.Related : Descriptor (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="DescriptorRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DescriptorRelationship') or (self::DescriptorRelationship and not(@xsi:type)))]/Related">
