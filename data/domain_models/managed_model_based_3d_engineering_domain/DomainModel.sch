   <!--(Reference to Select) RelationshipObjectRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="RelationshipObjectRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='RelationshipObjectRelationship') or (self::RelationshipObjectRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(RelationshipObjectRelationship : <sch:value-of select="$uid"/>) The RelationshipObjectRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule RelationshipObjectRelationship.WR1)-->
   <sch:pattern id="RelationshipObjectRelationship_WR1"> <sch:rule context="//RelationshipObjectRelationship[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/> <sch:let name="reference_uidRef" value="Related/@uidRef"/> <sch:let name="reference" value="//*[@uid = $reference_uidRef]"/> <sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/> <sch:assert test="$relating_type = $related_type"> The Related and the Relating object shall be of same type. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -relating_type:<sch:value-of select="$relating_type"/> -related_type:<sch:value-of select="$related_type"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ReplacedPartViewRelationship set of rules-->
   <!--(Default Value) ReplacedPartViewRelationship.RelationType : String = 'replaced part view' (kind=SINGLE - redefined=PartViewRelationship.RelationType)-->
   <sch:pattern id="ReplacedPartViewRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ReplacedPartViewRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ReplacedPartViewRelationship'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'replaced part view'">(ReplacedPartViewRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'replaced part view'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) PartViewRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ReplacedPartViewRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ReplacedPartViewRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ReplacedPartViewRelationship'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ReplacedPartViewRelationship : <sch:value-of select="$uid"/>) The ReplacedPartViewRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartViewRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ReplacedPartViewRelationship_ClassifiedAs">
