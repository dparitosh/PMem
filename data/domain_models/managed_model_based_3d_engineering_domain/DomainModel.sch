   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--PointShapeElement set of rules-->
   <!--(Reference to Entity) PointShapeElement.RepresentedGeometry : Point (kind=SINGLE - cardinality= - redefined=ShapeElement.RepresentedGeometry)-->
   <sch:pattern id="PointShapeElement_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PointShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='PointShapeElement'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="RepresentedGeometry/@uidRef"/>
         <sch:assert test="count(RepresentedGeometry) = 1">(PointShapeElement : <sch:value-of select="$uid"/>) The PointShapeElement.RepresentedGeometry attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(RepresentedGeometry) != 1 or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]">(PointShapeElement : <sch:value-of select="$uid"/>) The PointShapeElement.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Point.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PointShapeElement_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PointShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='PointShapeElement'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(PointShapeElement : <sch:value-of select="$uid"/>) The PointShapeElement.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="PointShapeElement_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PointShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='PointShapeElement'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(PointShapeElement : <sch:value-of select="$uid"/>) The PointShapeElement.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
