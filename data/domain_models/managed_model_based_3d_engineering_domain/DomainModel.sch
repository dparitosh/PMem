   <!--Observation set of rules-->
   <!--(Rule specific to Id construct) Observation.Id : IdentifierSelect-->
   <sch:pattern id="Observation_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Observation') or (self::Observation and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Observation : <sch:value-of select="$uid"/>) The Observation.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
