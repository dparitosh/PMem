   <!--AssemblyShapeConstraintItemRelationship set of rules-->
   <!--(Reference to Entity) AssemblyShapeConstraintItemRelationship.Related : OccurrenceShapeFeature (kind=SINGLE - cardinality= - redefined=ShapeElementRelationship.Related)-->
