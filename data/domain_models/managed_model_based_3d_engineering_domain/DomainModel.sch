   <!--PromissoryAssemblyOccurrenceUsage set of rules-->
   <!--(Default Value) PromissoryAssemblyOccurrenceUsage.RelationType : String = 'promissory assembly occurrence' (kind=SINGLE - redefined=ViewOccurrenceRelationship.RelationType)-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'promissory assembly occurrence'">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The value of RelationType shall be 'promissory assembly occurrence'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) AssemblyOccurrenceRelationship.Placement : OPTIONAL SET[1:unbounded] OF TransformationAndAssociationSelect (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_Placement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/Placement/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::GeometricRepresentationRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',@typeRef,' '))]) or (self::GeometryToTopologyModelAssociation and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometryToTopologyModelAssociation ',concat(' ',@typeRef,' '))]) or (self::TopologyToGeometryModelAssociation and //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologyToGeometryModelAssociation ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //SubObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometryToTopologyModelAssociation and //SubObject[@uid = $uidRef and contains(' GeometryToTopologyModelAssociation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::TopologyToGeometryModelAssociation and //SubObject[@uid = $uidRef and contains(' TopologyToGeometryModelAssociation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianTransformation) or (self::GeometricRepresentationRelationship and //RepresentationRelationship[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometryToTopologyModelAssociation and //RepresentationRelationship[@uid = $uidRef and contains(' GeometryToTopologyModelAssociation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::TopologyToGeometryModelAssociation and //RepresentationRelationship[@uid = $uidRef and contains(' TopologyToGeometryModelAssociation ',concat(' ',substring-after(@xsi:type,':'),' '))])">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyOccurrenceUsage.Placement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of TransformationAndAssociationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ViewOccurrenceRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyOccurrenceUsage.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ViewOccurrenceRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyOccurrenceUsage.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ViewOccurrenceRelationship.Related : DefinitionBasedOccurrence (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Occurrence[@uid = $uidRef and contains(' DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))]">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyOccurrenceUsage.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DefinitionBasedOccurrence.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ViewOccurrenceRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="PromissoryAssemblyOccurrenceUsage_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage') or (self::ViewOccurrenceRelationship and substring-after(@xsi:type,':')='PromissoryAssemblyOccurrenceUsage'))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(PromissoryAssemblyOccurrenceUsage : <sch:value-of select="$uid"/>) The PromissoryAssemblyOccurrenceUsage.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
