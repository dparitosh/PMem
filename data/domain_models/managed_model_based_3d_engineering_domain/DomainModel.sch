   <!--(Reference to Entity) ActivityMethodRelationship.Related : ActivityMethod (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ActivityMethodRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityMethodRelationship') or (self::ActivityMethodRelationship and not(@xsi:type)))]/Related">
