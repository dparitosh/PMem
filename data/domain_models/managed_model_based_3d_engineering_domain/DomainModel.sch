   </sch:pattern>
   <!--(Reference to Entity) ObservationRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ObservationRelationship_ClassifiedAs">
