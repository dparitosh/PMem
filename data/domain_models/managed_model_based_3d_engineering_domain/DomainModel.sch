         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.AttachedFeature contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type OccurrenceShapeFeature.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) HarnessNode.RepresentedGeometry : Vertex (kind=SINGLE - cardinality= - redefined=ShapeElement.RepresentedGeometry)-->
   <sch:pattern id="HarnessNode_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessNode') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessNode'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="RepresentedGeometry/@uidRef"/>
         <sch:assert test="count(RepresentedGeometry) = 1">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.RepresentedGeometry attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(RepresentedGeometry) != 1 or //ExternalRefBaseObject[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Vertex.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) PartShapeElement.PartDefinition : OPTIONAL PartShapeElementDefinitionSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HarnessNode_PartDefinition">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessNode') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessNode'))]/PartDefinition">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinition[@uid = $uidRef] or //ShapeElement[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinitionRelationship[@uid = $uidRef]">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.PartDefinition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PartShapeElementDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="HarnessNode_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessNode') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessNode'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="HarnessNode_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessNode') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessNode'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(HarnessNode : <sch:value-of select="$uid"/>) The HarnessNode.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule HarnessNode.UR1)-->
   <sch:pattern id="HarnessNode_UR1"><sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign']/ShapeElement[@uid or substring-after(@xsi:type,':')='HarnessNode']"> <sch:let name="uid" value="@uid"/> <sch:let name="vertex" value="child::RepresentedGeometry/@uidRef"/> <sch:let name="followingAndPrecedingHarnessNodeVertices" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessNode']/child::RepresentedGeometry/@uidRef union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessNode']/child::RepresentedGeometry/@uidRef"/> <sch:assert test="not(some $i in $followingAndPrecedingHarnessNodeVertices satisfies ($i eq $vertex))">(HarnessNode.UR1: <sch:value-of select="$uid"/>) A Vertex shall be used at most once by a HarnessNode within a WiringHarnessAssemblyDesign.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule HarnessNode.WR1)-->
   <sch:pattern id="HarnessNode_WR1"><sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='HarnessNode']"> <sch:let name="uid" value="@uid"/> <sch:let name="vertexRef" value="child::RepresentedGeometry/@uidRef"/> <sch:let name="topologyRef" value="parent::*/Topology/@uidRef"/> <sch:let name="reps" value="local-fn:UsingRepresentations(//DataContainer,//RepresentationItem[@uid=$vertexRef])"/> <sch:assert test="some $j in $reps satisfies ($j eq $topologyRef)">(HarnessNode.WR1: <sch:value-of select="$uid"/>) the RepresentedGeometry (<sch:value-of select="$vertexRef"/>) shall be found in the ElementOf.Topology (<sch:value-of select="$topologyRef"/>). (<sch:value-of select="$vertexRef"/>) is used in the following Representations:(<sch:value-of select="$reps"/>)</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--HarnessSegment set of rules-->
   <!--(Reference to Select) HarnessSegment.CrossSection : OPTIONAL CrossSectionalConstituentElementSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HarnessSegment_CrossSection">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessSegment') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessSegment'))]/CrossSection">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CrossSectionalOccurrenceShapeElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CrossSectionalOccurrenceShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CrossSectionalOccurrenceShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.CrossSection contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of CrossSectionalConstituentElementSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) HarnessSegment.RepresentedGeometry : Edge (kind=SINGLE - cardinality= - redefined=ShapeElement.RepresentedGeometry)-->
   <sch:pattern id="HarnessSegment_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessSegment') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessSegment'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="RepresentedGeometry/@uidRef"/>
         <sch:assert test="count(RepresentedGeometry) = 1">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.RepresentedGeometry attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(RepresentedGeometry) != 1 or //ExternalRefBaseObject[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Edge.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) PartShapeElement.PartDefinition : OPTIONAL PartShapeElementDefinitionSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HarnessSegment_PartDefinition">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessSegment') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessSegment'))]/PartDefinition">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionRelationship  ShapeFeatureDefinitionFitRelationship  ContactFeatureDefinitionFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinition[@uid = $uidRef] or //ShapeElement[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElementRelationship[@uid = $uidRef and contains(' ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinitionRelationship[@uid = $uidRef]">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.PartDefinition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PartShapeElementDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="HarnessSegment_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessSegment') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessSegment'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="HarnessSegment_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HarnessSegment') or (self::ShapeElement and substring-after(@xsi:type,':')='HarnessSegment'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(HarnessSegment : <sch:value-of select="$uid"/>) The HarnessSegment.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule HarnessSegment.UR1)-->
   <sch:pattern id="HarnessSegment_UR1"><sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='WiringHarnessAssemblyDesign']/ShapeElement[@uid or substring-after(@xsi:type,':')='HarnessSegment']"> <sch:let name="uid" value="@uid"/> <sch:let name="edge" value="child::RepresentedGeometry/@uidRef"/> <sch:let name="followingAndPrecedingHarnessNodeEdges" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessSegment']/child::RepresentedGeometry/@uidRef union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='HarnessSegment']/child::RepresentedGeometry/@uidRef"/> <sch:assert test="not(some $i in $followingAndPrecedingHarnessNodeEdges satisfies ($i eq $edge))">(HarnessSegment.UR1: <sch:value-of select="$uid"/>) An Edge shall be used at most once by a HarnessSegment within a WiringHarnessAssemblyDesign</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule HarnessSegment.WR1)-->
   <sch:pattern id="HarnessSegment_WR1"><sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='HarnessSegment']"> <sch:let name="uid" value="@uid"/> <sch:let name="edgeRef" value="child::RepresentedGeometry/@uidRef"/> <sch:let name="topologyRef" value="parent::*/Topology/@uidRef"/> <sch:let name="reps" value="local-fn:UsingRepresentations(//DataContainer,//RepresentationItem[@uid=$edgeRef])"/> <sch:assert test="some $j in $reps satisfies ($j eq $topologyRef)">(HarnessSegment.WR1: <sch:value-of select="$uid"/>) the RepresentedGeometry (<sch:value-of select="$edgeRef"/>) shall be found in the ElementOf.Topology (<sch:value-of select="$topologyRef"/>). (<sch:value-of select="$edgeRef"/>) is used in the following Representations:(<sch:value-of select="$reps"/>)</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--HierarchicalInterfaceConnection set of rules-->
   <!--(Rule specific to Id construct) InterfaceConnection.Id : IdentifierSelect-->
   <sch:pattern id="HierarchicalInterfaceConnection_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection') or (self::InterfaceConnection and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(HierarchicalInterfaceConnection : <sch:value-of select="$uid"/>) The HierarchicalInterfaceConnection.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) InterfaceConnection.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="HierarchicalInterfaceConnection_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection') or (self::InterfaceConnection and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(HierarchicalInterfaceConnection : <sch:value-of select="$uid"/>) The HierarchicalInterfaceConnection.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) InterfaceConnection.Connected : ConnectionSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="HierarchicalInterfaceConnection_Connected">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection') or (self::InterfaceConnection and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection'))]/Connected">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' InterfaceConnectorOccurrence ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartViewRelationship  AssemblyViewRelationship  NextAssemblyViewUsage  PromissoryAssemblyViewUsage  DefinitionalPartViewUsage  GeometricalRelationship  MakeFromRelationship  ProcessStateRelationship  ReplacedPartViewRelationship  ToolPartRelationship ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' InterfaceConnectorOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartViewRelationship  AssemblyViewRelationship  NextAssemblyViewUsage  PromissoryAssemblyViewUsage  DefinitionalPartViewUsage  GeometricalRelationship  MakeFromRelationship  ProcessStateRelationship  ReplacedPartViewRelationship  ToolPartRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //InterfaceConnectorOccurrence[@uid = $uidRef] or //PartView[@uid = $uidRef] or //PartViewRelationship[@uid = $uidRef]">(HierarchicalInterfaceConnection : <sch:value-of select="$uid"/>) The HierarchicalInterfaceConnection.Connected contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ConnectionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) InterfaceConnection.RelationType : OPTIONAL ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HierarchicalInterfaceConnection_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection') or (self::InterfaceConnection and substring-after(@xsi:type,':')='HierarchicalInterfaceConnection'))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(HierarchicalInterfaceConnection : <sch:value-of select="$uid"/>) The HierarchicalInterfaceConnection.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--HighOrderKinematicPair set of rules-->
   <!--(Reference to Select) HighOrderKinematicPair.CurveOrSurface1 : ExternalCurveOrSurfaceSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="HighOrderKinematicPair_CurveOrSurface1">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HighOrderKinematicPair') or (self::RepresentationItem and substring-after(@xsi:type,':')='HighOrderKinematicPair'))]/CurveOrSurface1">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HighOrderKinematicPair : <sch:value-of select="$uid"/>) The HighOrderKinematicPair.CurveOrSurface1 contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ExternalCurveOrSurfaceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) HighOrderKinematicPair.PointOrCurveOrSurface2 : OPTIONAL ExternalPointOrCurveOrSurfaceSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HighOrderKinematicPair_PointOrCurveOrSurface2">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HighOrderKinematicPair') or (self::RepresentationItem and substring-after(@xsi:type,':')='HighOrderKinematicPair'))]/PointOrCurveOrSurface2">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HighOrderKinematicPair : <sch:value-of select="$uid"/>) The HighOrderKinematicPair.PointOrCurveOrSurface2 contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ExternalPointOrCurveOrSurfaceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) HighOrderKinematicPair.Range1 : OPTIONAL ExternalTrimmedCurveOrSurfaceSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HighOrderKinematicPair_Range1">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HighOrderKinematicPair') or (self::RepresentationItem and substring-after(@xsi:type,':')='HighOrderKinematicPair'))]/Range1">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HighOrderKinematicPair : <sch:value-of select="$uid"/>) The HighOrderKinematicPair.Range1 contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ExternalTrimmedCurveOrSurfaceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) HighOrderKinematicPair.Range2 : OPTIONAL ExternalTrimmedCurveOrSurfaceSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="HighOrderKinematicPair_Range2">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='HighOrderKinematicPair') or (self::RepresentationItem and substring-after(@xsi:type,':')='HighOrderKinematicPair'))]/Range2">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]">(HighOrderKinematicPair : <sch:value-of select="$uid"/>) The HighOrderKinematicPair.Range2 contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ExternalTrimmedCurveOrSurfaceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) KinematicPair.Link1 : KinematicLink (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="HighOrderKinematicPair_Link1">
