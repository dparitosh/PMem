   <sch:pattern id="AssemblyOccurrenceRelationship_WR1"> <sch:rule context="//ViewOccurrenceRelationship[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true()]"> <sch:let name="uid" value="@uid"/> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="reference_uidRef" value="Placement/*/@uidRef"/> <sch:let name="reference_xsitype" value="//*[@uid = $reference_uidRef]/@xsi:type"/> <sch:assert test="every $i in $reference_uidRef satisfies (not(substring-after(//*[@uid=$i]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $i]/Definitional=true())"> If the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to true. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -attribute_name:<sch:value-of select="//*[@uid = $reference_uidRef]/Definitional/name()"/> -attribute_value:<sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/> } </sch:assert> </sch:rule></sch:pattern>
