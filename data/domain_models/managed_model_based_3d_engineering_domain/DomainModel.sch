   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--EvaluatedCharacteristic set of rules-->
   <!--(Rule specific to Id construct) EvaluatedCharacteristic.Id : IdentifierSelect-->
   <sch:pattern id="EvaluatedCharacteristic_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='EvaluatedCharacteristic') or (self::EvaluatedCharacteristic and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(EvaluatedCharacteristic : <sch:value-of select="$uid"/>) The EvaluatedCharacteristic.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) EvaluatedCharacteristic.ActualCharacteristic : MeasuredCharacteristic (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="EvaluatedCharacteristic_ActualCharacteristic">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='EvaluatedCharacteristic') or (self::EvaluatedCharacteristic and not(@xsi:type)))]/ActualCharacteristic">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' MeasuredCharacteristic ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' MeasuredCharacteristic ',concat(' ',substring-after(@xsi:type,':'),' '))] or //MeasuredCharacteristic[@uid = $uidRef]">(EvaluatedCharacteristic : <sch:value-of select="$uid"/>) The EvaluatedCharacteristic.ActualCharacteristic contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type MeasuredCharacteristic.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) EvaluatedCharacteristic.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="EvaluatedCharacteristic_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='EvaluatedCharacteristic') or (self::EvaluatedCharacteristic and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(EvaluatedCharacteristic : <sch:value-of select="$uid"/>) The EvaluatedCharacteristic.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) EvaluatedCharacteristic.PlannedCharacteristic : PlannedCharacteristic (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="EvaluatedCharacteristic_PlannedCharacteristic">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='EvaluatedCharacteristic') or (self::EvaluatedCharacteristic and not(@xsi:type)))]/PlannedCharacteristic">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PlannedCharacteristic ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PlannedCharacteristic ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PlannedCharacteristic[@uid = $uidRef]">(EvaluatedCharacteristic : <sch:value-of select="$uid"/>) The EvaluatedCharacteristic.PlannedCharacteristic contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PlannedCharacteristic.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule EvaluatedCharacteristic.WR1)-->
   <sch:pattern id="EvaluatedCharacteristic_WR1"> <sch:rule context="//EvaluatedCharacteristic[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="planned_reference_uidRef" value="PlannedCharacteristic/@uidRef"/> <sch:let name="planned_reference" value="//*[@uid = $planned_reference_uidRef]"/> <sch:let name="planned_def" value="$planned_reference/PlannedCharacteristics/Definition/PropertyDefinition/@uidRef"/> <sch:let name="measured_reference_uidRef" value="ActualCharacteristic/@uidRef"/> <sch:let name="measured_reference" value="//*[@uid = $measured_reference_uidRef]"/> <sch:let name="measured_def" value="$measured_reference/MeasuredCharacteristics/Definition/PropertyDefinition/@uidRef"/> <sch:assert test="$measured_def = $planned_def"> The PropertyValue or set of PropertyValue of PlannedCharacteristic and MeasuredCharacteristic shall refer to the same PropertyDefinition. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -planned_def:<sch:value-of select="$planned_def"/> -measured_def:<sch:value-of select="$measured_def"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--EvaluatedRequirement set of rules-->
