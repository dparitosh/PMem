      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ContactingFeature set of rules-->
   <!--(Default Value) ContactingFeature.ProductDefinitional : OPTIONAL Boolean = 'false' (kind=SINGLE - redefined=ShapeElement.ProductDefinitional)-->
   <sch:pattern id="ContactingFeature_ProductDefinitional">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContactingFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='ContactingFeature'))]/ProductDefinitional">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="text() = 'false'">(ContactingFeature : <sch:value-of select="$uid"/>) The value of ProductDefinitional shall be 'false'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ContactingFeature_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContactingFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='ContactingFeature'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ContactingFeature : <sch:value-of select="$uid"/>) The ContactingFeature.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ContactingFeature_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContactingFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='ContactingFeature'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ContactingFeature : <sch:value-of select="$uid"/>) The ContactingFeature.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ContactingFeature_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContactingFeature') or (self::ShapeElement and substring-after(@xsi:type,':')='ContactingFeature'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ContactingFeature : <sch:value-of select="$uid"/>) The ContactingFeature.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ContentProperty set of rules-->
   <!--(Reference to Entity) ContentProperty.GeometryTypes : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ContentProperty_GeometryTypes">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContentProperty') or (self::ContentProperty or (self::DocumentContent and substring-after(@xsi:type,':')='ContentProperty') or (self::FileContent and substring-after(@xsi:type,':')='ContentProperty')))]/GeometryTypes/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ContentProperty : <sch:value-of select="$uid"/>) The ContentProperty.GeometryTypes contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ContentProperty.WR1)-->
   <sch:pattern id="ContentProperty_WR1"> <sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ContentProperty']"> <sch:let name="uid" value="@uid"/> <sch:let name="xsitype" value="@xsi:type"/> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="RWS_name" value="RealWorldScale/Name/CharacterString/text()"/> <sch:assert test="$RWS_name = 'real world scale'"> The attribute Name of RealWorldScale attribute shall be a string with the value 'real world scale'. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -attribute_name:<sch:value-of select="RealWorldScale/Name/name()"/> -attribute_value:<sch:value-of select="$RWS_name"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ContextDependentOverRidingStyledElement set of rules-->
   <!--(Reference to Select) ContextDependentOverRidingStyledElement.ContextDefinition : LIST[1:unbounded] OF OverridingStyleContextSelect (kind=AGGREGATE - cardinality=LIST[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ContextDependentOverRidingStyledElement_ContextDefinition">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement') or (self::RepresentationItem and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement'))]/ContextDefinition/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::DetailedGeometricModelItem and //ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))]) or (self::GeometricRepresentationRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',@typeRef,' '))]) or (self::StyledModel and //ExternalRefBaseObject[@uid = $uidRef and contains(' StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',@typeRef,' '))]) or (self::DetailedGeometricModelItem and //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //SubObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StyledModel and //SubObject[@uid = $uidRef and contains(' StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::DetailedGeometricModelItem and //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //RepresentationRelationship[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StyledModel and //Representation[@uid = $uidRef and contains(' StyledModel  AnnotatedModelPresentation  ExternalStyledModel ',concat(' ',substring-after(@xsi:type,':'),' '))])">(ContextDependentOverRidingStyledElement : <sch:value-of select="$uid"/>) The ContextDependentOverRidingStyledElement.ContextDefinition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of OverridingStyleContextSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) OverRidingStyledElement.OverRiddenElement : StyledElement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ContextDependentOverRidingStyledElement_OverRiddenElement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement') or (self::RepresentationItem and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement'))]/OverRiddenElement">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ContextDependentOverRidingStyledElement : <sch:value-of select="$uid"/>) The ContextDependentOverRidingStyledElement.OverRiddenElement contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type StyledElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) StyledElement.Element : StyledElementTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ContextDependentOverRidingStyledElement_Element">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement') or (self::RepresentationItem and substring-after(@xsi:type,':')='ContextDependentOverRidingStyledElement'))]/Element">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef] or //RepresentationItem[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ContextDependentOverRidingStyledElement : <sch:value-of select="$uid"/>) The ContextDependentOverRidingStyledElement.Element contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of StyledElementTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ContinuousShapeElement set of rules-->
   <!--(Reference to Entity) CompositeShapeElement.Components : SET[2:unbounded] OF ShapeElement (kind=AGGREGATE - cardinality=SET[2:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ContinuousShapeElement_Components">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContinuousShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='ContinuousShapeElement'))]/Components/ShapeElement">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef]">(ContinuousShapeElement : <sch:value-of select="$uid"/>) The ContinuousShapeElement.Components contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ContinuousShapeElement_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ContinuousShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='ContinuousShapeElement'))]/Id">
         <sch:let name="uid" value="../@uid"/>
