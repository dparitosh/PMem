   <!--AxisPlacement set of rules-->
   <!--(Rule AxisPlacement.WR1)-->
   <sch:pattern id="AxisPlacement_WR1"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(RefDirection) or (count(tokenize(normalize-space(RefDirection), ' '))= count(tokenize(normalize-space(Position), ' ')))"> (AxisPlacement_WR1 <sch:value-of select="$uid"/>) if RefDirection is defined, its dimensionality shall be the same than the dimensionality of Position.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.RefDirectionLowerBound)-->
   <sch:pattern id="AxisPlacement_RefDirectionLowerBound"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(RefDirection) or (count(tokenize(normalize-space(RefDirection), ' '))=2) or (count(tokenize(normalize-space(RefDirection), ' '))=3)"> (AxisPlacement_RefDirectionLowerBound <sch:value-of select="$uid"/>) if RefDirection is defined, its dimensionality shall be 2 or 3.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.NoAxisDefinedFor2DAxisPlacement)-->
   <sch:pattern id="AxisPlacement_NoAxisDefinedFor2DAxisPlacement"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(count(tokenize(normalize-space(Position), ' '))=2) or not(Axis)"> (AxisPlacement_NoAxisDefinedFor2DAxisPlacement <sch:value-of select="$uid"/>) the attribute Axis shall be unset in the 2D case because it defines the z-Direction of the local coordinate system.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.WR3)-->
   <sch:pattern id="AxisPlacement_WR3"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(Position) or count(tokenize(normalize-space(Position), ' '))= 2 or count(tokenize(normalize-space(Position), ' '))=3"> (AxisPlacement_WR3 <sch:value-of select="$uid"/>) Position shall be either undefined or its size shall be 2 or 3.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.WR4)-->
   <sch:pattern id="AxisPlacement_WR4"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="External and not(Position) or not(External) and Position"> (AxisPlacement_WR4 <sch:value-of select="$uid"/>) an AxisPlacement shall be either externally or locally defined.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.AxisLowerBound)-->
   <sch:pattern id="AxisPlacement_AxisLowerBound"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(Axis) or count(tokenize(normalize-space(Axis), ' '))=3"> (AxisPlacement_AxisLowerBound <sch:value-of select="$uid"/>) if Axis is defined, its dimensionality shall be 3.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AxisPlacement.WR2)-->
   <sch:pattern id="AxisPlacement_WR2"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(Axis) or (count(tokenize(normalize-space(Axis), ' '))= 3 and count(tokenize(normalize-space(Position), ' '))=3)"> (AxisPlacement_WR2 <sch:value-of select="$uid"/>) if Axis is defined, its dimensionality and the dimensionality of Position shall be 3.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AxisPlacementShapeElement set of rules-->
   <!--(Reference to Entity) AxisPlacementShapeElement.RepresentedGeometry : AxisPlacement (kind=SINGLE - cardinality= - redefined=ShapeElement.RepresentedGeometry)-->
   <sch:pattern id="AxisPlacementShapeElement_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AxisPlacementShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='AxisPlacementShapeElement'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="RepresentedGeometry/@uidRef"/>
         <sch:assert test="count(RepresentedGeometry) = 1">(AxisPlacementShapeElement : <sch:value-of select="$uid"/>) The AxisPlacementShapeElement.RepresentedGeometry attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(RepresentedGeometry) != 1 or //ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]">(AxisPlacementShapeElement : <sch:value-of select="$uid"/>) The AxisPlacementShapeElement.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AxisPlacement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="AxisPlacementShapeElement_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AxisPlacementShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='AxisPlacementShapeElement'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(AxisPlacementShapeElement : <sch:value-of select="$uid"/>) The AxisPlacementShapeElement.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AxisPlacementShapeElement_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AxisPlacementShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='AxisPlacementShapeElement'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(AxisPlacementShapeElement : <sch:value-of select="$uid"/>) The AxisPlacementShapeElement.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
