   </sch:pattern>
   <!--(Reference to Select) IdentifierRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="IdentifierRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='IdentifierRelationship') or (self::IdentifierRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(IdentifierRelationship : <sch:value-of select="$uid"/>) The IdentifierRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule IdentifierRelationship.WR1)-->
   <sch:pattern id="IdentifierRelationship_WR1"> <sch:rule context="//IdentifierRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related Identifier and the relating Identifier shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:IdentifierRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
