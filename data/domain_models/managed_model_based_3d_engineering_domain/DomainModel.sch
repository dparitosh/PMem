   <!--(Rule PartFeature.WR1)-->
   <sch:pattern id="PartFeature_WR1"><sch:rule context="//ShapeElement[@uid and local-fn:testXsiTypePartFeature(@xsi:type)=true()]"> <sch:let name="uid" value="@uid"/> <sch:assert test="count(child::ProductDefinitional) = 0">PartFeature.WR1 <sch:value-of select="$uid"/>) the inherited attribute ProductDefinitional must not be explicitly provided. It is implicitly set to TRUE.</sch:assert> </sch:rule></sch:pattern>
