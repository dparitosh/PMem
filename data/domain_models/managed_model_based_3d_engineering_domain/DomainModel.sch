   <!--(Inverse of DeltaChange.ChangeActivities :: PartProperty) DeltaChangeActivity.ChangeSet : DeltaChange => no rule needed when PartProperty or Optional-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Address set of rules-->
   <!--(Rule specific to Id construct) Address.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="Address_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Address') or (self::Address and not(@xsi:type)))]/Id">
