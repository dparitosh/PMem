      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ContractAssignment.AssignedContract : Contract (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ContractAssignment_AssignedContract">
