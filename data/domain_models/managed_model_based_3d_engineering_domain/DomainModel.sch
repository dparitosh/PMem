   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ToleranceZoneWithDatum_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToleranceZoneWithDatum') or (self::ShapeElement and substring-after(@xsi:type,':')='ToleranceZoneWithDatum'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ToleranceZoneWithDatum : <sch:value-of select="$uid"/>) The ToleranceZoneWithDatum.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ToleranceZoneWithDatum_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToleranceZoneWithDatum') or (self::ShapeElement and substring-after(@xsi:type,':')='ToleranceZoneWithDatum'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ToleranceZoneWithDatum : <sch:value-of select="$uid"/>) The ToleranceZoneWithDatum.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ToleranceZoneWithDatum_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToleranceZoneWithDatum') or (self::ShapeElement and substring-after(@xsi:type,':')='ToleranceZoneWithDatum'))]/RepresentedGeometry">
