   <!--WireOccurrenceTerminal set of rules-->
   <!--(Reference to Entity) WireOccurrenceTerminal.AssociatedTransportFeature : WireOccurrenceIdentification (kind=SINGLE - cardinality= - redefined=OccurrenceTerminal.AssociatedTransportFeature)-->
   <sch:pattern id="WireOccurrenceTerminal_AssociatedTransportFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='WireOccurrenceTerminal') or (self::ShapeElement and substring-after(@xsi:type,':')='WireOccurrenceTerminal'))]">
         <sch:let name="uid" value="@uid"/>
