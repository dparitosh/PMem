         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ProxyRelationship : <sch:value-of select="$uid"/>) The ProxyRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ProxyRelationship.Related : Proxy (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ProxyRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ProxyRelationship') or (self::ProxyRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Proxy ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Proxy ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Proxy[@uid = $uidRef] or //*[@uid = $uidRef and (self::SameAs or self::SameAs or self::SameAs)]">(ProxyRelationship : <sch:value-of select="$uid"/>) The ProxyRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Proxy.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ProxyRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ProxyRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ProxyRelationship') or (self::ProxyRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ProxyRelationship : <sch:value-of select="$uid"/>) The ProxyRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ProxyRelationship.WR1)-->
   <sch:pattern id="ProxyRelationship_WR1"> <sch:rule context="//ProxyRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related Proxy and the relating Proxy shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:ProxyRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--QualitativeUncertainty set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--QuantifiedOccurrence set of rules-->
