      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AnnotationToAnnotationLeaderLine set of rules-->
