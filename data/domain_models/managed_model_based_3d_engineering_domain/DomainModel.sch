         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ContactFeatureDefinition ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeFeatureDefinition[@uid = $uidRef and contains(' ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement ',concat(' ',substring-after(@xsi:type,':'),' '))]">(PartTerminal : <sch:value-of select="$uid"/>) The PartTerminal.PartDefinition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of PartContactFeatureDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PartTerminal_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PartTerminal') or (self::ShapeElement and substring-after(@xsi:type,':')='PartTerminal'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(PartTerminal : <sch:value-of select="$uid"/>) The PartTerminal.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
