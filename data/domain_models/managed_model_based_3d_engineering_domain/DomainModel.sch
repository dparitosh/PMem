   <!--ConditionAssignment set of rules-->
   <!--(Rule specific to Id construct) ConditionAssignment.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ConditionAssignment_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionAssignment') or (self::ConditionAssignment and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ConditionAssignment : <sch:value-of select="$uid"/>) The ConditionAssignment.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ConditionAssignment.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
