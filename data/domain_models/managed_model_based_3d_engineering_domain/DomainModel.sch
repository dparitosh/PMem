      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="LineProfileTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='LineProfileTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='LineProfileTolerance'))]/AppliedTo">
