   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SpecificationInclusionAssignment set of rules-->
   <!--(Reference to Entity) SpecificationInclusionAssignment.AssignedInclusion : SpecificationInclusion (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="SpecificationInclusionAssignment_AssignedInclusion">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SpecificationInclusionAssignment') or (self::SpecificationInclusionAssignment and not(@xsi:type)))]/AssignedInclusion">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' SpecificationInclusion ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' SpecificationInclusion ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SpecificationInclusion[@uid = $uidRef]">(SpecificationInclusionAssignment : <sch:value-of select="$uid"/>) The SpecificationInclusionAssignment.AssignedInclusion contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type SpecificationInclusion.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) SpecificationInclusionAssignment.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="SpecificationInclusionAssignment_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SpecificationInclusionAssignment') or (self::SpecificationInclusionAssignment and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(SpecificationInclusionAssignment : <sch:value-of select="$uid"/>) The SpecificationInclusionAssignment.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SpecifiedOccurrence set of rules-->
   <!--(Reference to Entity) SpecifiedOccurrence.UpperUsage : Occurrence (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="SpecifiedOccurrence_UpperUsage">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SpecifiedOccurrence') or (self::Occurrence and substring-after(@xsi:type,':')='SpecifiedOccurrence'))]/UpperUsage">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Occurrence  DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence  SpecifiedOccurrence ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Occurrence  DefinitionBasedOccurrence  QuantifiedOccurrence  CableOccurrence  WireOccurrence  SingleOccurrence  SpecifiedOccurrence ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Occurrence[@uid = $uidRef]">(SpecifiedOccurrence : <sch:value-of select="$uid"/>) The SpecifiedOccurrence.UpperUsage contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Occurrence.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Occurrence.Id : IdentifierSelect-->
   <sch:pattern id="SpecifiedOccurrence_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SpecifiedOccurrence') or (self::Occurrence and substring-after(@xsi:type,':')='SpecifiedOccurrence'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(SpecifiedOccurrence : <sch:value-of select="$uid"/>) The SpecifiedOccurrence.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
