   </sch:pattern>
   <!--(Reference to Entity) PartView.InitialContext : ViewContext (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="FilamentLaminate_InitialContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FilamentLaminate') or (self::PartView and substring-after(@xsi:type,':')='FilamentLaminate'))]/InitialContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ViewContext ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ViewContext ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ViewContext[@uid = $uidRef]">(FilamentLaminate : <sch:value-of select="$uid"/>) The FilamentLaminate.InitialContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ViewContext.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of PartVersion.Views :: PartProperty) PartView.ViewOf : PartVersion => no rule needed when PartProperty or Optional-->
   <!--(Rule FilamentLaminate.WR1)-->
   <sch:pattern id="FilamentLaminate_WR1"><sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='FilamentLaminate' ]"> <sch:let name="uid" value="@uid"/> <sch:let name="stockMaterialRef" value="MadeFrom/@uidRef"></sch:let> <sch:assert test="//*[@uid=$stockMaterialRef]/StockMaterialType eq 'filament_assembly'">(FilamentLaminate.WR1 <sch:value-of select="$uid"/>) the stock material shall be of type filament assembly.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--File set of rules-->
   <!--(Rule File.WR1)-->
   <sch:pattern id="File_WR1"> <sch:rule context="//File[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:assert test="(Locations and not(FileLocations)) or (not(Locations) and FileLocations)"> Either Locations or FileLocations shall be defined. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--FileLocationIdentification set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--FileRelationship set of rules-->
   <!--(Rule specific to Id construct) FileRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="FileRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FileRelationship') or (self::FileRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(FileRelationship : <sch:value-of select="$uid"/>) The FileRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) FileRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="FileRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FileRelationship') or (self::FileRelationship and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(FileRelationship : <sch:value-of select="$uid"/>) The FileRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) FileRelationship.Related : File (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="FileRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FileRelationship') or (self::FileRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' File  DigitalFile  Hardcopy ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' File  DigitalFile  Hardcopy ',concat(' ',substring-after(@xsi:type,':'),' '))] or //File[@uid = $uidRef]">(FileRelationship : <sch:value-of select="$uid"/>) The FileRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type File.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) FileRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="FileRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FileRelationship') or (self::FileRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(FileRelationship : <sch:value-of select="$uid"/>) The FileRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule FileRelationship.WR1)-->
   <sch:pattern id="FileRelationship_WR1"> <sch:rule context="//FileRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related File and the relating File shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:FileRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Filter set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--FilterNestingIndex set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--FinalSolution set of rules-->
   <!--(Reference to Select) FinalSolution.Specifications : SET[1:unbounded] OF FinalDefinitionSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="FinalSolution_Specifications">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/Specifications/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::IndividualPartView and //ExternalRefBaseObject[@uid = $uidRef and contains(' IndividualPartView ',concat(' ',@typeRef,' '))]) or (self::PartView and //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))]) or (self::RequirementView and //ExternalRefBaseObject[@uid = $uidRef and contains(' RequirementView ',concat(' ',@typeRef,' '))]) or (self::IndividualPartView and //SubObject[@uid = $uidRef and contains(' IndividualPartView ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PartView and //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::RequirementView and //SubObject[@uid = $uidRef and contains(' RequirementView ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::IndividualPartView and //IndividualPartView[@uid = $uidRef]) or (self::PartView and //PartView[@uid = $uidRef]) or (self::RequirementView and //RequirementView[@uid = $uidRef])">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.Specifications contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of FinalDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) FinalSolution.Status : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="FinalSolution_Status">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/Status/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.Status contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) AlternativeSolution.Id : IdentifierSelect-->
   <sch:pattern id="FinalSolution_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) AlternativeSolution.VersionId : OPTIONAL IdentifierSelect-->
   <sch:pattern id="FinalSolution_VersionId">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/VersionId">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.VersionId shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) AlternativeSolution.BaseElement : BreakdownElementOrAlternativeSolutionSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="FinalSolution_BaseElement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/BaseElement">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AlternativeSolution  FinalSolution  SupplierSolution  TechnicalSolution ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AlternativeSolution  FinalSolution  SupplierSolution  TechnicalSolution ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' BreakdownElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //AlternativeSolution[@uid = $uidRef] or //BreakdownElement[@uid = $uidRef]">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.BaseElement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of BreakdownElementOrAlternativeSolutionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) AlternativeSolution.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="FinalSolution_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FinalSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='FinalSolution'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(FinalSolution : <sch:value-of select="$uid"/>) The FinalSolution.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--FlatnessTolerance set of rules-->
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="FlatnessTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FlatnessTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='FlatnessTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(FlatnessTolerance : <sch:value-of select="$uid"/>) The FlatnessTolerance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="FlatnessTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='FlatnessTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='FlatnessTolerance'))]/AppliedTo">
         <sch:let name="uid" value="../@uid"/>
