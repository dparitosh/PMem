   <sch:pattern id="QuantifiedOccurrence_WR1"> <sch:rule context="//Occurrence[substring-after(@xsi:type,':')= 'QuantifiedOccurrence']"> <sch:let name="uid" value="@uid"/> <sch:assert test="Quantity or Criterion"> QuantifiedOccurrence WR1 Error on entity <sch:value-of select="$uid"/>: either Quantity or Criterion or both shall be defined. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
