   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SuppliedObjectRelationship set of rules-->
   <!--(Rule specific to Id construct) SuppliedObjectRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="SuppliedObjectRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SuppliedObjectRelationship') or (self::SuppliedObjectRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
