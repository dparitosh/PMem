   <!--(Reference to Entity) ElementDelivery.Destination : Organization (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ElementDelivery_Destination">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ElementDelivery') or (self::ElementDelivery and not(@xsi:type)))]/Destination">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Organization ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Organization ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Organization[@uid = $uidRef]">(ElementDelivery : <sch:value-of select="$uid"/>) The ElementDelivery.Destination contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Organization.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ElementDelivery.Role : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ElementDelivery_Role">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ElementDelivery') or (self::ElementDelivery and not(@xsi:type)))]/Role/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ElementDelivery : <sch:value-of select="$uid"/>) The ElementDelivery.Role contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Envelope set of rules-->
   <!--(Rule specific to Id construct) Envelope.Id : IdentifierSelect-->
   <sch:pattern id="Envelope_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Envelope') or (self::Envelope and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(Envelope : <sch:value-of select="$uid"/>) The Envelope.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Envelope.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="Envelope_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Envelope') or (self::Envelope and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(Envelope : <sch:value-of select="$uid"/>) The Envelope.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Envelope.Wrapping : OPTIONAL Message (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
