   <!--DatumSystemWithAssociatedModelCoordinateSystem set of rules-->
   <!--(Reference to Entity) DatumSystemWithAssociatedModelCoordinateSystem.RepresentedGeometry : AxisPlacement (kind=SINGLE - cardinality= - redefined=ShapeElement.RepresentedGeometry)-->
   <sch:pattern id="DatumSystemWithAssociatedModelCoordinateSystem_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DatumSystemWithAssociatedModelCoordinateSystem') or (self::ShapeElement and substring-after(@xsi:type,':')='DatumSystemWithAssociatedModelCoordinateSystem'))]">
         <sch:let name="uid" value="@uid"/>
