ntView and //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElementView ',concat(' ',@typeRef,' '))]) or (self::BreakdownElementViewRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElementViewRelationship ',concat(' ',@typeRef,' '))]) or (self::BreakdownVersion and //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownVersion ',concat(' ',@typeRef,' '))]) or (self::BreakdownVersionAssignment and //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownVersionAssignment ',concat(' ',@typeRef,' '))]) or (self::CertificationAssignment and //ExternalRefBaseObject[@uid = $uidRef and contains(' CertificationAssignment ',concat(' ',@typeRef,' '))]) or (self::Classification and //ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))]) or (*[(self::Condition or (self::AssignedCondition and contains(' Condition  AndCondition  EqualsCondition  NotCondition  NotEqualsCondition  OneOfCondition  OrCondition ',concat(' ',substring-after(@xsi:type,':'),' '))) or (self::AssignedCondition and contains(' Condition  AndCondition  EqualsCondition  NotCondition  NotEqualsCondition  OneOfCondition  OrCondition ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' Condition  AndCondition  EqualsCondition  NotCondition  NotEqualsCondition  OneOfCondition  OrCondition ',concat(' ',@typeRef,' '))]) or (self::ConditionAssignment and //ExternalRefBaseObject[@uid = $uidRef and contains(' ConditionAssignment ',concat(' ',@typeRef,' '))]) or (self::ConditionRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' ConditionRelationship ',concat(' ',@typeRef,' '))]) or (self::ContractAssignment and //ExternalRefBaseObject[@uid = $uidRef and contains(' ContractAssignment ',concat(' ',@typeRef,' '))]) or (self::DateAndPersonAssignment and //ExternalRefBaseObject[@uid = $uidRef and contains(' DateAndPersonAssignment ',concat(' ',@typ