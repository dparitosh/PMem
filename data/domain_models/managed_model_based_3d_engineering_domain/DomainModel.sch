) then //LifeCycleStage/LifeCycleStage[@uid and @uid = LifeCycleStage/LifeCycleStage/@uidRef]/SameAs/Proxy/Individual/ProxyString else LifeCycleStage/LifeCycleStage/@uidRef else ()) = $lcs and @uid != $uid])"> The combination of the ApplicationDomain and the LifeCycleStage shall be unique. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:UR1 -attribute_name:ApplicationDomain, LifeCycleStage -attribute_values:<sch:value-of select="$ad"/>, <sch:value-of select="$lcs"/> -references:<sch:value-of select="$adRef"/>, <sch:value-of select="$lcsRef"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule ViewContext.WR1)-->
   <sch:pattern id="ViewContext_WR1"> <sch:rule context="//ViewContext[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:assert test="(count(//*/InitialContext[@uidRef = $uid]) != 0) or (count(//*/AdditionalContexts/ViewContext[@uidRef = $uid]) != 0)"> A ViewContext shall be used at least once by a PartView through either of the attributes AdditionalView or InitialView. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 } </sch:assert> </sch:rule></sch:pattern>
