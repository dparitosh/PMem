   <!--(Inverse of DeltaChange.ChangeActivities :: PartProperty) DeltaChangeActivity.ChangeSet : DeltaChange => no rule needed when PartProperty or Optional-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--DeltaChange set of rules-->
   <!--(Rule specific to Id construct) DeltaChange.Id : IdentifierSelect-->
   <sch:pattern id="DeltaChange_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DeltaChange') or (self::DeltaChange and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
