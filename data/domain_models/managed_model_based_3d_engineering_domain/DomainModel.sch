         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ShapeElement : <sch:value-of select="$uid"/>) The ShapeElement.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ShapeElementRelationship set of rules-->
   <!--(Rule specific to Id construct) ShapeElementRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ShapeElementRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeElementRelationship') or (self::ShapeElementRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ShapeElementRelationship : <sch:value-of select="$uid"/>) The ShapeElementRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElementRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ShapeElementRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeElementRelationship') or (self::ShapeElementRelationship and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ShapeElementRelationship : <sch:value-of select="$uid"/>) The ShapeElementRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElementRelationship.Related : ShapeElement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ShapeElementRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeElementRelationship') or (self::ShapeElementRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef]">(ShapeElementRelationship : <sch:value-of select="$uid"/>) The ShapeElementRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ShapeElementRelationship.RelationType : OPTIONAL ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ShapeElementRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeElementRelationship') or (self::ShapeElementRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ShapeElementRelationship : <sch:value-of select="$uid"/>) The ShapeElementRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElementRelationship.RepresentedGeometry : OPTIONAL RepresentationItem (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ShapeElementRelationship_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeElementRelationship') or (self::ShapeElementRelationship and not(@xsi:type)))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' RepresentationItem  Callout  DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem  ExternalRepresentationItem  ExternalTessellatedAnnotation  StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement  StyledModelReplication  TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint  UserDefined11 ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' RepresentationItem  Callout  DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem  ExternalRepresentationItem  ExternalTessellatedAnnotation  StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement  StyledModelReplication  TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint  UserDefined11 ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef]">(ShapeElementRelationship : <sch:value-of select="$uid"/>) The ShapeElementRelationship.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type RepresentationItem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ShapeElementRelationship.WR1)-->
   <sch:pattern id="ShapeElementRelationship_WR1"> <sch:rule context="//ShapeElementRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related ShapeElement and the relating ShapeElement shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:ShapeElementRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--(Rule ShapeElementRelationship.WR2)-->
   <sch:pattern id="ShapeElementRelationship_WR2"><sch:rule context="//ShapeElementRelationship[@uid and child::RepresentedGeometry]"> <sch:let name="uid" value="@uid"/> <sch:assert test="parent::ShapeElement/parent::*/DefiningGeometry">(ShapeElementRelationship_WR2 <sch:value-of select="$uid"/>) if RepresentedGeometry is set then the object pointed out by the ElementOf of the Relating ShapeElement shall have a DefiningGeometry.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ShapeFeatureDefinition set of rules-->
   <!--(Rule specific to Id construct) ShapeFeatureDefinition.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ShapeFeatureDefinition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeFeatureDefinition') or (self::ShapeFeatureDefinition and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ShapeFeatureDefinition : <sch:value-of select="$uid"/>) The ShapeFeatureDefinition.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeFeatureDefinition.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ShapeFeatureDefinition_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeFeatureDefinition') or (self::ShapeFeatureDefinition and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ShapeFeatureDefinition : <sch:value-of select="$uid"/>) The ShapeFeatureDefinition.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeFeatureDefinition.DefiningGeometry : OPTIONAL GeometricModel (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ShapeFeatureDefinition_DefiningGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeFeatureDefinition') or (self::ShapeFeatureDefinition and not(@xsi:type)))]/DefiningGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ShapeFeatureDefinition : <sch:value-of select="$uid"/>) The ShapeFeatureDefinition.DefiningGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type GeometricModel.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ShapeFeatureDefinitionElement set of rules-->
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ShapeFeatureDefinitionElement_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ShapeFeatureDefinitionElement') or (self::ShapeElement and substring-after(@xsi:type,':')='ShapeFeatureDefinitionElement'))]/Id">
         <sch:let name="uid" value="../@uid"/>
