   <!--(Rule Ply.WR2)-->
   <sch:pattern id="Ply_WR2"><sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='Ply' ]"> <sch:let name="uid" value="@uid"/> <sch:let name="unitRef" value="child::PlyThickness/Unit/@uidRef"/> <sch:assert test="//Unit[@uid=$unitRef]/Name/ClassString='length'">(Ply.WR2 <sch:value-of select="$uid"/>) the unit name for PlyThickness shall be 'length'.</sch:assert> </sch:rule></sch:pattern>
