odel ',concat(' ',substring-after(@xsi:type,':'),' '))]">(PercentageLaminateTable : <sch:value-of select="$uid"/>) The PercentageLaminateTable.DefiningGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type GeometricModel.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartView.InitialContext : ViewContext (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="PercentageLaminateTable_InitialContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PercentageLaminateTable') or (self::PartView and substring-after(@xsi:type,':')='PercentageLaminateTable'))]/InitialContext">
