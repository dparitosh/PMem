   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TargetPoint set of rules-->
   <!--(Reference to Entity) PlacedTarget.DefinedIn : GeometricCoordinateSpace (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="TargetPoint_DefinedIn">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]/DefinedIn">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationContext[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]">(TargetPoint : <sch:value-of select="$uid"/>) The TargetPoint.DefinedIn contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type GeometricCoordinateSpace.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PlacedTarget.ParameterReference : AxisPlacement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="TargetPoint_ParameterReference">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]/ParameterReference">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]">(TargetPoint : <sch:value-of select="$uid"/>) The TargetPoint.ParameterReference contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AxisPlacement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DatumTarget.MovementDirection : OPTIONAL Direction (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="TargetPoint_MovementDirection">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]/MovementDirection">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Direction ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Direction ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Direction ',concat(' ',substring-after(@xsi:type,':'),' '))]">(TargetPoint : <sch:value-of select="$uid"/>) The TargetPoint.MovementDirection contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Direction.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) DatumTarget.TargetFeature : OPTIONAL ShapeElement (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="TargetPoint_TargetFeature">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]/TargetFeature">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef]">(TargetPoint : <sch:value-of select="$uid"/>) The TargetPoint.TargetFeature contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ShapeElement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) DatumTarget.ProductDefinitional : Boolean = 'true' (kind=SINGLE - redefined=ShapeElement.ProductDefinitional)-->
   <sch:pattern id="TargetPoint_ProductDefinitional">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:assert test="count(ProductDefinitional) = 1">(TargetPoint : <sch:value-of select="$uid"/>) The TargetPoint.ProductDefinitional attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(ProductDefinitional) != 1 or ProductDefinitional/text() = 'true'">(TargetPoint : <sch:value-of select="$uid"/>) The value of ProductDefinitional shall be 'true'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="TargetPoint_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TargetPoint') or (self::ShapeElement and substring-after(@xsi:type,':')='TargetPoint'))]/Id">
