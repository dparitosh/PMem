   <!--(Rule GeometryToTopologyModelAssociation.WR2)-->
   <sch:pattern id="GeometryToTopologyModelAssociation_WR2"><sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometryToTopologyModelAssociation']"> <sch:let name="uid" value="@uid"/> <sch:let name="assemblyContext" value="//*[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true() and child::Placement/child::GeometryToTopologyModelAssociation/@uidRef = $uid]"/> <sch:assert test="count($assemblyContext)=0 or (every $i in $assemblyContext satisfies substring-after($i/parent::*/@xsi:type,':')='WiringHarnessAssemblyDesign')">(GeometryToTopologyModelAssociation.WR2 <sch:value-of select="$uid"/>) a GeometryToTopologyModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.</sch:assert> </sch:rule></sch:pattern>
