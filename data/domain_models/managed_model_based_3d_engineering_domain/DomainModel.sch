         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Callout ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Callout ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Callout ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CalloutRelationship : <sch:value-of select="$uid"/>) The CalloutRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Callout.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CameraModel3D set of rules-->
   <!--(Reference to Entity) CameraModel3D.Clipping : OPTIONAL ClippingOperator (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="CameraModel3D_Clipping">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CameraModel3D') or (self::RepresentationItem and substring-after(@xsi:type,':')='CameraModel3D'))]/Clipping">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ClippingOperator ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ClippingOperator ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ClippingOperator ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CameraModel3D : <sch:value-of select="$uid"/>) The CameraModel3D.Clipping contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ClippingOperator.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) CameraModel3D.Sources : OPTIONAL SET[1:unbounded] OF LightSource (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CameraModel3D_Sources">
