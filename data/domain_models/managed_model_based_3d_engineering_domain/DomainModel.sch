         <sch:assert test="ClassString/text() = 'make from'">(MakeFromRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'make from'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) PartViewRelationship.Id : OPTIONAL IdentifierSelect-->
