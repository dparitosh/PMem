   <!--(Rule ExternalClassSystem.UR1)-->
   <sch:pattern id="ExternalClassSystem_UR1"> <sch:rule context="//ExternalClassSystem[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="id" value="if (Id/@id) then (Id/@id) else (concat(Id/Identifier/@id, Id/Identifier/@idRoleRef, Id/Identifier/@idContextRef)) "/> <sch:let name="source" value="if (Source/*/@uidRef) then (Source/*/@uidRef) else if (Source/Identifier) then (concat(Source/Identifier/@id, Source/Identifier/@idRoleRef, Source/Identifier/@idContextRef)) else Source/IdentifierString"/> <sch:assert test="not(//ExternalClassSystem[@uid and (if (Id/@id) then (Id/@id) else (concat(Id/Identifier/@id, Id/Identifier/@idRoleRef, Id/Identifier/@idContextRef))) = $id and (if (Source/*/@uidRef) then (Source/*/@uidRef) else if (Source/Identifier) then (concat(Source/Identifier/@id, Source/Identifier/@idRoleRef, Source/Identifier/@idContextRef)) else Source/IdentifierString) = $source and @uid != $uid])"> The combination of id and source shall be unique. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:UR1 -attribute_name:Id,Source -attribute_value:<sch:value-of select="$id"/>,<sch:value-of select="$source"/> } </sch:assert> </sch:rule></sch:pattern>
