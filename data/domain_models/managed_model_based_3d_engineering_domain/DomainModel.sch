   </sch:pattern>
   <!--(Reference to Entity) Representation.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ComposedGeometricModel_ClassifiedAs">
