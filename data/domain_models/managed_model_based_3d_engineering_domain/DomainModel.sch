   <!--(Reference to Select) DirectedOrOrientedToleranceZone.ZoneFor : SET[1:unbounded] OF DirectedOrOrientedGeometricToleranceSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=ToleranceZone.ZoneFor)-->
   <sch:pattern id="DirectedToleranceZone_ZoneFor">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DirectedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='DirectedToleranceZone'))]/ZoneFor/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::DimensionalLocation and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))]) or (self::DimensionalSize and //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))]) or (self::LineProfileTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',@typeRef,' '))]) or (self::ParallelismTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',@typeRef,' '))]) or (self::PerpendicularityTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',@typeRef,' '))]) or (self::PositionTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',@typeRef,' '))]) or (self::StraightnessTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',@typeRef,' '))]) or (self::SymmetryTolerance and //ExternalRefBaseObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',@typeRef,' '))]) or (self::DimensionalLocation and //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::DimensionalSize and //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::LineProfileTolerance and //SubObject[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ParallelismTolerance and //SubObject[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PerpendicularityTolerance and //SubObject[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::PositionTolerance and //SubObject[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StraightnessTolerance and //SubObject[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::SymmetryTolerance and //SubObject[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' LineProfileTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' ParallelismTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PerpendicularityTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' PositionTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' StraightnessTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricTolerance[@uid = $uidRef and contains(' SymmetryTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DirectedToleranceZone : <sch:value-of select="$uid"/>) The DirectedToleranceZone.ZoneFor contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of DirectedOrOrientedGeometricToleranceSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeElement.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="DirectedToleranceZone_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DirectedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='DirectedToleranceZone'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(DirectedToleranceZone : <sch:value-of select="$uid"/>) The DirectedToleranceZone.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ShapeElement.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
