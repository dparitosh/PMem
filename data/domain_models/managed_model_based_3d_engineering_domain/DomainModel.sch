 $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ToleranceZoneWithDatum : <sch:value-of select="$uid"/>) The ToleranceZoneWithDatum.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ToolAttachmentPointFrame set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ToolCentrePointFrame set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ToolPartRelationship set of rules-->
   <!--(Reference to Select) ToolPartRelationship.Placement : OPTIONAL TransformationSelect (kind=AGGREGATE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="ToolPartRelationship_Placement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/Placement/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::GeometricRepresentationRelationship and //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::GeometricRepresentationRelationship and //SubObject[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianTransformation) or (self::GeometricRepresentationRelationship and //RepresentationRelationship[@uid = $uidRef and contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))])">(ToolPartRelationship : <sch:value-of select="$uid"/>) The ToolPartRelationship.Placement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of TransformationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) ToolPartRelationship.RelationType : String = 'tool part' (kind=SINGLE - redefined=PartViewRelationship.RelationType)-->
   <sch:pattern id="ToolPartRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'tool part'">(ToolPartRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'tool part'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) PartViewRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ToolPartRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ToolPartRelationship : <sch:value-of select="$uid"/>) The ToolPartRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartViewRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ToolPartRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ToolPartRelationship : <sch:value-of select="$uid"/>) The ToolPartRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) PartViewRelationship.Related : PartView (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ToolPartRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(ToolPartRelationship : <sch:value-of select="$uid"/>) The ToolPartRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PartView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) PartViewRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ToolPartRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ToolPartRelationship') or (self::PartViewRelationship and substring-after(@xsi:type,':')='ToolPartRelationship'))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ToolPartRelationship : <sch:value-of select="$uid"/>) The ToolPartRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ToolPartRelationship.WR1)-->
   <sch:pattern id="ToolPartRelationship_WR1"> <sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ToolPartRelationship']"> <sch:let name="uid" value="@uid"/> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="reference_uidRef" value="Placement/*/@uidRef"/> <sch:assert test="not(substring-after(//*[@uid=$reference_uidRef]/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation') or //*[@uid = $reference_uidRef]/Definitional=false()"> In the case that Placement is of type GeometricRepresentationRelationshipWithPlacementTransformation this relationship should not be definitional. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -reference:<sch:value-of select="$reference_uidRef"/> -attribute_value:<sch:value-of select="//*[@uid = $reference_uidRef]/Definitional"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TopologicalRepresentationItem set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TopologyToGeometryModelAssociation set of rules-->
   <!--(Reference to Select) TopologyToGeometryModelAssociation.Origin : LIST[1:unbounded] OF TopologyAssociationItemSelect (kind=AGGREGATE - cardinality=LIST[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_Origin">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation'))]/Origin/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Edge and //ExternalRefBaseObject[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',@typeRef,' '))]) or (self::Path and //ExternalRefBaseObject[@uid = $uidRef and contains(' Path ',concat(' ',@typeRef,' '))]) or (self::Vertex and //ExternalRefBaseObject[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',@typeRef,' '))]) or (self::Edge and //SubObject[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Path and //SubObject[@uid = $uidRef and contains(' Path ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Vertex and //SubObject[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Edge and //RepresentationItem[@uid = $uidRef and contains(' Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Path and //RepresentationItem[@uid = $uidRef and contains(' Path ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Vertex and //RepresentationItem[@uid = $uidRef and contains(' Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))])">(TopologyToGeometryModelAssociation : <sch:value-of select="$uid"/>) The TopologyToGeometryModelAssociation.Origin contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of TopologyAssociationItemSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) TopologyToGeometryModelAssociation.Target : LIST[1:unbounded] OF GeometryAssociationItemSelect (kind=AGGREGATE - cardinality=LIST[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_Target">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation'))]/Target/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::AxisPlacement and //ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))]) or (self::CartesianPoint and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',@typeRef,' '))]) or (self::Curve and //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))]) or (self::EdgeCurve and //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))]) or (self::ExternalRepresentationItem and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalRepresentationItem  ExternalTessellatedAnnotation ',concat(' ',@typeRef,' '))]) or (self::VertexPoint and //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))]) or (self::AxisPlacement and //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianPoint and //SubObject[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Curve and //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::EdgeCurve and //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalRepresentationItem and //SubObject[@uid = $uidRef and contains(' ExternalRepresentationItem  ExternalTessellatedAnnotation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::VertexPoint and //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::AxisPlacement and //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CartesianPoint and //RepresentationItem[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Curve and //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::EdgeCurve and //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalRepresentationItem and //RepresentationItem[@uid = $uidRef and contains(' ExternalRepresentationItem  ExternalTessellatedAnnotation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::VertexPoint and //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))])">(TopologyToGeometryModelAssociation : <sch:value-of select="$uid"/>) The TopologyToGeometryModelAssociation.Target contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometryAssociationItemSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) RepresentationRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="TopologyToGeometryModelAssociation_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TopologyToGeometryModelAssociation : <sch:value-of select="$uid"/>) The TopologyToGeometryModelAssociation.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) RepresentationRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(TopologyToGeometryModelAssociation : <sch:value-of select="$uid"/>) The TopologyToGeometryModelAssociation.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) RepresentationRelationship.Related : Representation (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation') or (self::RepresentationRelationship and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Representation  GeometricRepresentation  ConstituentShapeRepresentation  BeveledSheetRepresentation  CompositeSheetRepresentation  FaceBasedSheetRepresentation  GeometricSheetRepresentation  ThreeDGeometrySet  EdgeBasedTopologicalRepresentationWithLengthConstraint  GeometricModel  ComposedGeometricModel  ExternalGeometricModel  ExternalAdvancedBrepShapeRepresentation  ExternalCsgShapeRepresentation  ExternalCurveSweptSolidShapeRepresentation  ExternalEdgeBasedWireframeShapeRepresentation  ExternalElementaryBrepShapeRepresentation  ExternalFacetedBrepShapeRepresentation  ExternalGeometricallyBoundedSurfaceShapeRepresentation  ExternalGeometricallyBoundedWireframeShapeRepresentation  ExternalManifoldSurfaceShapeRepresentation  ExternalShellBasedWireframeShapeRepresentation  ExternalTessellatedShapeRepresentation  TransformedGeometricModel  InterpolatedConfigurationModel  KinematicLink  LinkMotionAlongPath  Mechanism  MechanismState  StyledModel  AnnotatedModelPresentation  ExternalStyledModel  PlyAngleRepresentation  ReinforcementOrientationBasis ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef]">(TopologyToGeometryModelAssociation : <sch:value-of select="$uid"/>) The TopologyToGeometryModelAssociation.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Representation.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule TopologyToGeometryModelAssociation.WR3)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_WR3"><sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"> <sch:let name="uid" value="@uid"/> <sch:assert test="child::Definitional='false'">(TopologyToGeometryModelAssociation.WR3 <sch:value-of select="$uid"/>) a TopologyToGeometryModelAssociation shall not be definitional.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule TopologyToGeometryModelAssociation.WR2)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_WR2"><sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"> <sch:let name="uid" value="@uid"/> <sch:let name="assemblyContext" value="//*[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true() and child::Placement/child::TopologyToGeometryModelAssociation/@uidRef = $uid]"/> <sch:assert test="count($assemblyContext)=0 or (every $i in $assemblyContext satisfies substring-after($i/parent::*/@xsi:type,':')='WiringHarnessAssemblyDesign')">(TopologyToGeometryModelAssociation.WR2 <sch:value-of select="$uid"/>) a TopologyToGeometryModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule TopologyToGeometryModelAssociation.WR1)-->
   <sch:pattern id="TopologyToGeometryModelAssociation_WR1"><sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='TopologyToGeometryModelAssociation']"> <sch:let name="uid" value="@uid"/> <sch:assert test="count(child::Target/child::*) = count(child::Origin/child::*)">(TopologyToGeometryModelAssociation.WR1 <sch:value-of select="$uid"/>) the size of Target list shall be the same as the size of the Origin list.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TotalRunoutTolerance set of rules-->
   <!--(Reference to Entity) TotalRunoutTolerance.DatumSystem : DatumSystem (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="TotalRunoutTolerance_DatumSystem">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TotalRunoutTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='TotalRunoutTolerance'))]/DatumSystem">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(TotalRunoutTolerance : <sch:value-of select="$uid"/>) The TotalRunoutTolerance.DatumSystem contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="TotalRunoutTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TotalRunoutTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='TotalRunoutTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TotalRunoutTolerance : <sch:value-of select="$uid"/>) The TotalRunoutTolerance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="TotalRunoutTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TotalRunoutTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='TotalRunoutTolerance'))]/AppliedTo">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(TotalRunoutTolerance : <sch:value-of select="$uid"/>) The TotalRunoutTolerance.AppliedTo contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricToleranceTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TotalRunoutTolerance_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TotalRunoutTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='TotalRunoutTolerance'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(TotalRunoutTolerance : <sch:value-of select="$uid"/>) The TotalRunoutTolerance.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.GeometricToleranceContext : OPTIONAL PartView (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="TotalRunoutTolerance_GeometricToleranceContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TotalRunoutTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='TotalRunoutTolerance'))]/GeometricToleranceContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(TotalRunoutTolerance : <sch:value-of select="$uid"/>) The TotalRunoutTolerance.GeometricToleranceContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PartView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule TotalRunoutTolerance.WR1)-->
   <sch:pattern id="TotalRunoutTolerance_WR1"><sch:rule context="//GeometricTolerance[substring-after(@xsi:type,':')='TotalRunoutTolerance']/Angle"> <sch:let name="uid" value="../@uid"/> <sch:let name="unitRef" value="./Unit/@uidRef"/> <sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='plane angle'">(TotalRunoutTolerance <sch:value-of select="$uid"/>) The unit of Angle shall be a plane angle measure unit. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TransformedGeometricModel set of rules-->
   <!--(Reference to Select) TransformedGeometricModel.Items : SET[1:unbounded] OF AxisPlacementOrTransformationSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=Representation.Items)-->
   <sch:pattern id="TransformedGeometricModel_Items">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]/Items/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::AxisPlacement and //ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',@typeRef,' '))]) or (self::AxisPlacement and //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))))] and //SubObject[@uid = $uidRef and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //*[(self::CartesianTransformation or (self::Transformation and contains(' CartesianTransformation ',concat(' ',substring-after(@xsi:type,':'),' ')))) and @uid = $uidRef]">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.Items contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of AxisPlacementOrTransformationSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule for inverse of GeometricRepresentationRelationship.Related :: ReferenceProperty) TransformedGeometricModel.DerivedFrom : GeometricRepresentationRelationship-->
   <sch:pattern id="TransformedGeometricModel_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:assert test="//RepresentationRelationship[contains(' GeometricRepresentationRelationship  GeneralGeometricRepresentationRelationship  GeometricRepresentationRelationshipWithCartesianTransformation  GeometricRepresentationRelationshipWithPlacementTransformation  GeometricRepresentationRelationshipWithSameCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]/Related[@uidRef = $uid]">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.DerivedFrom inverse rule must be referenced by GeometricRepresentationRelationship.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of GeometricCoordinateSpace.Representations :: PartProperty) GeometricRepresentation.ContextOfItems : GeometricCoordinateSpace => no rule needed when PartProperty or Optional-->
   <!--(Rule specific to Id construct) Representation.Id : IdentifierSelect-->
   <sch:pattern id="TransformedGeometricModel_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Representation.VersionId : OPTIONAL IdentifierSelect-->
   <sch:pattern id="TransformedGeometricModel_VersionId">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]/VersionId">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.VersionId shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Representation.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TransformedGeometricModel_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Representation.RepresentationTypes : OPTIONAL SET[1:unbounded] OF ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TransformedGeometricModel_RepresentationTypes">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TransformedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='TransformedGeometricModel'))]/RepresentationTypes/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(TransformedGeometricModel : <sch:value-of select="$uid"/>) The TransformedGeometricModel.RepresentationTypes contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of RepresentationContext.Representations :: PartProperty) Representation.ContextOfItems : RepresentationContext => no rule needed when PartProperty or Optional-->
   <!--(Rule TransformedGeometricModel.WR1)-->
   <sch:pattern id="TransformedGeometricModel_WR1"><sch:rule context="//Representation[@uid and substring-after(@xsi:type,':')='TransformedGeometricModel']"> <sch:let name="uid" value="@uid"/> <sch:let name="relatedRepresentationRelationships" value="//RepresentationRelationship[child::Related[@uidRef= $uid]]"/> <sch:assert test="count($relatedRepresentationRelationships)>0 and (every $i in $relatedRepresentationRelationships satisfies ( (substring-after($i/@xsi:type,':')= 'GeometricRepresentationRelationshipWithCartesianTransformation') or (substring-after($i/@xsi:type,':')='GeometricRepresentationRelationshipWithPlacementTransformation')))">(TransformedGeometricModel.WR1 <sch:value-of select="$uid"/>) the value of DerivedFrom shall either be of type GeometricRepresentationRelationshipWithCartesianTransformation or GeometricRepresentationRelationshipWithPlacementTransformation.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TrimmedCurve set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TwistedCrossSectionalGroupShapeElement set of rules-->
   <!--(Reference to Select) CrossSectionalGroupShapeElement.Items : SET[1:unbounded] OF CrossSectionalConstituentElementSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="TwistedCrossSectionalGroupShapeElement_Items">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='TwistedCrossSectionalGroupShapeElement') or (self::ShapeElement and substring-after(@xsi:type,':')='TwistedCrossSectionalGroupShapeElement'))]/Items/*">
