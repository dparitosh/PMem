   <!--(Reference to Entity) PartView.AdditionalContexts : OPTIONAL SET[1:unbounded] OF ViewContext (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="CompositeAssembly_AdditionalContexts">
