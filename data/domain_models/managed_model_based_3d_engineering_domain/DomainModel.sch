   <!--(Reference to Select) ShapeElement.RepresentedGeometry : OPTIONAL ShapeElementRepresentedGeometrySelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="DirectedToleranceZone_RepresentedGeometry">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DirectedToleranceZone') or (self::ShapeElement and substring-after(@xsi:type,':')='DirectedToleranceZone'))]/RepresentedGeometry">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' DetailedGeometricModelItem  AdvancedFace  AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame  CameraModel3D  Cartesian11  ClippingOperator  ConnectedFaceSet  Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve  Curve11  Cylindrical11  Direction  EdgeLoop  GeometricPlaceholderSet  GeometricSet  GeometricCurveSet  BoundaryCurveSet  InterpolatedConfigurationSequence  KinematicPair  HighOrderKinematicPair  LowOrderKinematicPair  LowOrderKinematicPairWithMotionCoupling  KinematicPairValue  KinematicPairWithMotionCoupling  KinematicPathDefinedByNodes  LightSource  Loop  PlanarBox  Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface  PointAndVector  PointArray  Polar11  RotationAboutDirection  Surface  OrientedSurface  Plane  RectangularTrimmedSurface  TessellatedItem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Curve  BoundedCurve  BoundedCurveWithLength  CompositeCurveOnSurface  Pcurve  SurfaceCurve  TrimmedCurve ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Point  CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface  DegeneratePcurve  PointOnCurve  PointOnSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Surface  OrientedSurface  Plane  RectangularTrimmedSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AdvancedFace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' ConnectedFaceSet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeCurve  EdgeBoundedCurveWithLength ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' EdgeLoop ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' TopologicalRepresentationItem  ConnectedEdgeSet  ConnectedEdgeSubSet  Edge  EdgeCurve  EdgeBoundedCurveWithLength  SubEdge  FaceSurface  Path  Vertex  VertexPoint ',concat(' ',substring-after(@xsi:type,':'),' '))]">(DirectedToleranceZone : <sch:value-of select="$uid"/>) The DirectedToleranceZone.RepresentedGeometry contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ShapeElementRepresentedGeometrySelect.</sch:assert>
      </sch:rule>
