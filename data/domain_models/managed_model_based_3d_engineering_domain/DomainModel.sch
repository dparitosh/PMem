   <sch:pattern id="SurfaceCondition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SurfaceCondition') or (self::SurfaceCondition and not(@xsi:type)))]/Id">
