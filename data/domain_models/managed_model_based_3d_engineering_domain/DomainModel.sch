         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(AngularityTolerance : <sch:value-of select="$uid"/>) The AngularityTolerance.DatumSystem contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="AngularityTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AngularityTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='AngularityTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(AngularityTolerance : <sch:value-of select="$uid"/>) The AngularityTolerance.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) GeometricTolerance.AppliedTo : GeometricToleranceTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="AngularityTolerance_AppliedTo">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AngularityTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='AngularityTolerance'))]/AppliedTo">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef and contains(' DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(AngularityTolerance : <sch:value-of select="$uid"/>) The AngularityTolerance.AppliedTo contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of GeometricToleranceTargetSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AngularityTolerance_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AngularityTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='AngularityTolerance'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(AngularityTolerance : <sch:value-of select="$uid"/>) The AngularityTolerance.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) GeometricTolerance.GeometricToleranceContext : OPTIONAL PartView (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="AngularityTolerance_GeometricToleranceContext">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AngularityTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='AngularityTolerance'))]/GeometricToleranceContext">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //PartView[@uid = $uidRef]">(AngularityTolerance : <sch:value-of select="$uid"/>) The AngularityTolerance.GeometricToleranceContext contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PartView.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AnnotatedModelItemAssociation set of rules-->
   <!--(Reference to Select) AnnotatedModelItemAssociation.Definition : AnnotatedModelItemDefinitionSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="AnnotatedModelItemAssociation_Definition">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelItemAssociation') or (self::AnnotatedModelItemAssociation and not(@xsi:type)))]/Definition">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricDimension  DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance  DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricTolerance  AngularityTolerance  CircularRunoutTolerance  CoaxialityTolerance  ConcentricityTolerance  CylindricityTolerance  FlatnessTolerance  LineProfileTolerance  ParallelismTolerance  PerpendicularityTolerance  PositionTolerance  RoundnessTolerance  StraightnessTolerance  SurfaceProfileTolerance  SymmetryTolerance  TotalRunoutTolerance ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PropertyDefinition  MaterialPropertyDefinition  WireColourBasedIdentificationCode ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' PropertyValueAssignment ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeElementRelationship  AssemblyShapeConstraintItemRelationship  AssemblyShapeJointItemRelationship  PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship  ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' GeometricDimension  DimensionalLocation  AngularLocation  CurvedDistance  LinearDistance  DimensionalSize  AngularSize  CurvedSize  DiameterSize  EdgeOfUndefinedShapeSize  RadialSize  ThicknessSize ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' GeometricTolerance  AngularityTolerance  CircularRunoutTolerance  CoaxialityTolerance  ConcentricityTolerance  CylindricityTolerance  FlatnessTolerance  LineProfileTolerance  ParallelismTolerance  PerpendicularityTolerance  PositionTolerance  RoundnessTolerance  StraightnessTolerance  SurfaceProfileTolerance  SymmetryTolerance  TotalRunoutTolerance ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PartView  AssemblyDefinition  MatingDefinition  WiringHarnessAssemblyDesign  CollectionDefinition  ConstituentPart  CompositeAssembly  FilamentLaminate  Ply  PlyLaminate  PlyPiece  ProcessedCore  LaminateTable  CompositeAssemblyTable  PlyLaminateTable  ZoneStructuralMakeup  PercentageLaminateTable  SmearedMaterial  ThicknessLaminateTable ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PropertyDefinition  MaterialPropertyDefinition  WireColourBasedIdentificationCode ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' PropertyValueAssignment ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElement  AxisPlacementShapeElement  CoatingLayer  CompositeShapeElement  CompositeGroupShapeElement  CompositeUnitShapeElement  ContinuousShapeElement  AllAroundShapeElement  AllAroundShapeElementAlongCollectionPlane  BetweenShapeElement  ContactingFeature  Datum  DatumFeature  DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem  DatumTarget  PlacedTarget  TargetCircle  TargetCircularCurve  TargetPoint  TargetRectangle  TargetStraightLine  TargetArea  TargetCurve  DerivedShapeElement  Apex  CentreOfSymmetry  Extension  GeometricAlignment  GeometricContact  GeometricIntersection  ParallelOffset  PerpendicularTo  Tangent  OccurrenceShapeElement  OccurrenceShapeFeature  CrossSectionalOccurrenceShapeElement  OccurrenceContactFeature  OccurrenceTerminal  CableOccurrenceTerminal  CableOccurrenceTerminalLocationGroup  WireOccurrenceTerminal  OccurrenceTransportFeature  WireOccurrenceIdentification  PartShapeElement  AssemblyShapeConstraint  AssemblyShapeJoint  ComponentPathShapeElement  HarnessNode  HarnessSegment  Nominal3dFeature  Nominal3dDerivedFeature  Nominal3dIntegralFeature  Nominal3dEdge  PartConnectivityDefinition  PartFeature  CrossSectionalPartShapeElement  CrossSectionalAlternativePartShapeElement  CrossSectionalGroupShapeElement  CrossSectionalGroupShapeElementWithLacing  CrossSectionalGroupShapeElementWithTubularCover  TwistedCrossSectionalGroupShapeElement  PartContactFeature  PartTerminal  PartTransportFeature  WirePartIdentification  PlaneShapeElement  PointShapeElement  ShapeFeatureDefinitionElement  ShapeFeatureDefinitionOccurrenceElement  ToleranceZone  DirectedOrOrientedToleranceZone  AffectedPlaneToleranceZone  ToleranceZoneWithDatum  DirectedToleranceZone  DirectionFeatureToleranceZone  OrientedToleranceZone ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeElementRelationship  AssemblyShapeConstraintItemRelationship  AssemblyShapeJointItemRelationship  PartShapeElementRelationship  PartFeatureFitRelationship  PartContactFeatureFitRelationship  ShapeFeatureDefinitionElementRelationship  ShapeFeatureDefinitionOccurrenceElementRelationship ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ShapeFeatureDefinition  ContactFeatureDefinition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //GeometricDimension[@uid = $uidRef] or //GeometricTolerance[@uid = $uidRef] or //PartView[@uid = $uidRef] or //PropertyDefinition[@uid = $uidRef] or //PropertyValueAssignment[@uid = $uidRef] or //ShapeElement[@uid = $uidRef] or //ShapeElementRelationship[@uid = $uidRef] or //ShapeFeatureDefinition[@uid = $uidRef]">(AnnotatedModelItemAssociation : <sch:value-of select="$uid"/>) The AnnotatedModelItemAssociation.Definition contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of AnnotatedModelItemDefinitionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) AnnotatedModelItemAssociation.UsedModel : AnnotatedModelPresentation (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="AnnotatedModelItemAssociation_UsedModel">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelItemAssociation') or (self::AnnotatedModelItemAssociation and not(@xsi:type)))]/UsedModel">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AnnotatedModelPresentation ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AnnotatedModelPresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' AnnotatedModelPresentation ',concat(' ',substring-after(@xsi:type,':'),' '))]">(AnnotatedModelItemAssociation : <sch:value-of select="$uid"/>) The AnnotatedModelItemAssociation.UsedModel contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AnnotatedModelPresentation.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AnnotatedModelPresentation set of rules-->
   <!--(Reference to Select) AnnotatedModelPresentation.Items : SET[1:unbounded] OF AnnotatedModelItemSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=Representation.Items)-->
   <sch:pattern id="AnnotatedModelPresentation_Items">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/Items/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::AxisPlacement and //ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))]) or (self::Callout and //ExternalRefBaseObject[@uid = $uidRef and contains(' Callout ',concat(' ',@typeRef,' '))]) or (self::CameraModel3D and //ExternalRefBaseObject[@uid = $uidRef and contains(' CameraModel3D ',concat(' ',@typeRef,' '))]) or (self::StyledElement and //ExternalRefBaseObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',@typeRef,' '))]) or (self::StyledModelReplication and //ExternalRefBaseObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',@typeRef,' '))]) or (self::AxisPlacement and //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Callout and //SubObject[@uid = $uidRef and contains(' Callout ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::CameraModel3D and //SubObject[@uid = $uidRef and contains(' CameraModel3D ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StyledElement and //SubObject[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::StyledModelReplication and //SubObject[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))]) or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' Callout ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' CameraModel3D ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' StyledElement  AnnotationElement  AnnotationPlaceholderOccurrence  AnnotationPlane  TessellatedAnnotation  OverRidingStyledElement  ContextDependentOverRidingStyledElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' StyledModelReplication ',concat(' ',substring-after(@xsi:type,':'),' '))]">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.Items contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of AnnotatedModelItemSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) AnnotatedModelPresentation.PresentationType : SET[1:unbounded] OF ClassSelect (kind=AGGREGATE - cardinality=SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AnnotatedModelPresentation_PresentationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/PresentationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.PresentationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of GeometricCoordinateSpace.Representations :: PartProperty) GeometricRepresentation.ContextOfItems : GeometricCoordinateSpace => no rule needed when PartProperty or Optional-->
   <!--(Rule specific to Id construct) Representation.Id : IdentifierSelect-->
   <sch:pattern id="AnnotatedModelPresentation_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Representation.VersionId : OPTIONAL IdentifierSelect-->
   <sch:pattern id="AnnotatedModelPresentation_VersionId">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/VersionId">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.VersionId shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Representation.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AnnotatedModelPresentation_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Representation.RepresentationTypes : OPTIONAL SET[1:unbounded] OF ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AnnotatedModelPresentation_RepresentationTypes">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AnnotatedModelPresentation') or (self::Representation and substring-after(@xsi:type,':')='AnnotatedModelPresentation'))]/RepresentationTypes/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(AnnotatedModelPresentation : <sch:value-of select="$uid"/>) The AnnotatedModelPresentation.RepresentationTypes contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of RepresentationContext.Representations :: PartProperty) Representation.ContextOfItems : RepresentationContext => no rule needed when PartProperty or Optional-->
   <!--(Rule AnnotatedModelPresentation.WR2)-->
   <sch:pattern id="AnnotatedModelPresentation_WR2"><sch:rule context="//Representation[ @uid and substring-after(@xsi:type,':')='AnnotatedModelPresentation' and ./PresentationType/ClassString='Saved View']"> <sch:let name="uid" value="@uid"/> <sch:let name="uidRef" value="./Items/RepresentationItem/@uidRef"/> <sch:assert test=" count (//RepresentationItem[substring-after(@xsi:type,':')='CameraModel3D' and @uid=$uidRef]) = 1 "> (AnnotatedModelPresentation.WR2: <sch:value-of select="$uid"/>) If the PresentationType is 'Saved View', the Items shall contain exactly one CameraModel3D. </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule AnnotatedModelPresentation.WR1)-->
   <sch:pattern id="AnnotatedModelPresentation_WR1"><sch:rule context="//Representation[ @uid and substring-after(@xsi:type,':')='AnnotatedModelPresentation']"> <sch:let name="uid" value="@uid"/> <sch:let name="name" value="./Name/CharacterString"/> <sch:assert test="not($name = following-sibling::Representation[substring-after(@xsi:type,':')='AnnotatedModelPresentation']/Name/CharacterString or $name = preceding-sibling::Representation[substring-after(@xsi:type,':')='AnnotatedModelPresentation']/Name/CharacterString)"> (AnnotatedModelPresentation.WR1 <sch:value-of select="$uid"/>) the name should be unique within a population of the AnnotatedModelPresentation/> </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AnnotationElement set of rules-->
   <!--(Reference to Select) StyledElement.Element : StyledElementTargetSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="AnnotationElement_Element">
