   <sch:pattern id="TimeIntervalWithBounds_WR1"> <sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:assert test="not(Duration) or not(SecondaryBound)"> Either a Duration or a SecondaryBound can be specified. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 } </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule TimeIntervalWithBounds.WR2)-->
   <sch:pattern id="TimeIntervalWithBounds_WR2"> <sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:assert test="PrimaryBound or SecondaryBound"> At least one bound has to be specified. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--TimeIntervalWithId set of rules-->
   <!--(Rule specific to Id construct) TimeIntervalWithId.Id : IdentifierSelect-->
