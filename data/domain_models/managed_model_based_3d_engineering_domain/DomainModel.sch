<?xml version="1.0" encoding="UTF-8"?>
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron"
            xmlns:fn="http://www.w3.org/2005/xpath-functions"
            xmlns:local-fn="functions:1.0"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
            queryBinding="xslt2"
            version="N11494;2024-12-03">
   <sch:ns uri="http://www.w3.org/2001/XMLSchema-instance" prefix="xsi"/>
   <sch:ns uri="functions:1.0" prefix="local-fn"/>
   <sch:title>STEP AP242 Domain model schematron</sch:title>
   <!--Activity set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ActivityAssignment set of rules-->
   <!--(Rule specific to Id construct) ActivityAssignment.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ActivityAssignment_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityAssignment') or (self::ActivityAssignment and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ActivityAssignment : <sch:value-of select="$uid"/>) The ActivityAssignment.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ActivityAssignment.AssignedActivity : Activity (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ActivityAssignment_AssignedActivity">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityAssignment') or (self::ActivityAssignment and not(@xsi:type)))]/AssignedActivity">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Activity  ActualActivity  DirectedActualActivity  PlannedActivity  DirectedPlannedActivity ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Activity  ActualActivity  DirectedActualActivity  PlannedActivity  DirectedPlannedActivity ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Activity[@uid = $uidRef]">(ActivityAssignment : <sch:value-of select="$uid"/>) The ActivityAssignment.AssignedActivity contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Activity.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ActivityAssignment.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ActivityAssignment_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityAssignment') or (self::ActivityAssignment and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ActivityAssignment : <sch:value-of select="$uid"/>) The ActivityAssignment.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ActivityAssignment.Role : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ActivityAssignment_Role">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityAssignment') or (self::ActivityAssignment and not(@xsi:type)))]/Role/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ActivityAssignment : <sch:value-of select="$uid"/>) The ActivityAssignment.Role contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ActivityHappeningRelationship set of rules-->
   <!--(Reference to Entity) ActivityHappeningRelationship.Related : ActualActivity (kind=SINGLE - cardinality= - redefined=ActivityRelationship.Related)-->
   <sch:pattern id="ActivityHappeningRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityHappeningRelationship') or (self::ActivityRelationship and substring-after(@xsi:type,':')='ActivityHappeningRelationship'))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ActualActivity  DirectedActualActivity ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ActualActivity  DirectedActualActivity ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Activity[@uid = $uidRef and contains(' ActualActivity  DirectedActualActivity ',concat(' ',substring-after(@xsi:type,':'),' '))]">(ActivityHappeningRelationship : <sch:value-of select="$uid"/>) The ActivityHappeningRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type ActualActivity.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Default Value) ActivityHappeningRelationship.RelationType : String = 'happening' (kind=SINGLE - redefined=ActivityRelationship.RelationType)-->
   <sch:pattern id="ActivityHappeningRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityHappeningRelationship') or (self::ActivityRelationship and substring-after(@xsi:type,':')='ActivityHappeningRelationship'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'happening'">(ActivityHappeningRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'happening'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ActivityRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ActivityHappeningRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityHappeningRelationship') or (self::ActivityRelationship and substring-after(@xsi:type,':')='ActivityHappeningRelationship'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ActivityHappeningRelationship : <sch:value-of select="$uid"/>) The ActivityHappeningRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ActivityRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ActivityHappeningRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityHappeningRelationship') or (self::ActivityRelationship and substring-after(@xsi:type,':')='ActivityHappeningRelationship'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ActivityHappeningRelationship : <sch:value-of select="$uid"/>) The ActivityHappeningRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ActivityRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ActivityHappeningRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ActivityHappeningRelationship') or (self::ActivityRelationship and substring-after(@xsi:type,':')='ActivityHappeningRelationship'))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ActivityHappeningRelationship : <sch:value-of select="$uid"/>) The ActivityHappeningRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
