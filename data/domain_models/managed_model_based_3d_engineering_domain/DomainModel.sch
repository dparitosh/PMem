         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' PlanarBox ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' PlanarBox ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' PlanarBox ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CameraModel3D : <sch:value-of select="$uid"/>) The CameraModel3D.ViewWindow contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type PlanarBox.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule CameraModel3D.WR1)-->
   <sch:pattern id="CameraModel3D_WR1"><sch:rule context="//RepresentationItem[ @uid and substring-after(@xsi:type,':')='CameraModel3D' and not(.//HiddenLineRemoval)]"> <sch:let name="uid" value="@uid"/> <sch:assert test="not(./HiddenElementAppearance)">(CameraModel3D : <sch:value-of select="$uid"/>) If the HiddenLineRemoval is not set, then the HiddenElementAppearance shall not be set as well.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--Cartesian11 set of rules-->
   <!--(Reference to Entity) Cartesian11.Placement : AxisPlacement (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="Cartesian11_Placement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='Cartesian11') or (self::RepresentationItem and substring-after(@xsi:type,':')='Cartesian11'))]/Placement">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' AxisPlacement  ToolAttachmentPointFrame  ToolCentrePointFrame ',concat(' ',substring-after(@xsi:type,':'),' '))]">(Cartesian11 : <sch:value-of select="$uid"/>) The Cartesian11.Placement contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type AxisPlacement.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule Cartesian11.WR1)-->
   <sch:pattern id="Cartesian11_WR1"><sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='Cartesian11']"> <sch:let name="uid" value="@uid"/> <sch:let name="axisPlacementRef" value="child::Placement/@uidRef"/> <!-- assumption delimiter in AxisPlacement/Position is blank --> <sch:assert test="count(tokenize(normalize-space(//RepresentationItem[@uid=$axisPlacementRef]/Position) , ' '))=3">(Cartesian11.WR1 <sch:value-of select="$uid"/>) the dimensionality of the Placement shall be 3.</sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CartesianPoint set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CartesianTransformation set of rules-->
   <!--(Rule CartesianTransformation.WR2)-->
   <sch:pattern id="CartesianTransformation_WR2"><sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "> <sch:let name="uid" value="@uid"/> <sch:assert test="not(Scale) or (number(Scale) gt 0.0) ">(CartesianTransformation.WR2 <sch:value-of select="$uid"/>) the value of Scale shall be greater than zero. </sch:assert> </sch:rule></sch:pattern>
   <!--(Rule CartesianTransformation.WR3)-->
   <sch:pattern id="CartesianTransformation_WR3"><sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "> <sch:let name="uid" value="@uid"/> <sch:assert test="count(tokenize(normalize-space(RotationMatrix), ' '))=9 and count(tokenize(normalize-space(TranslationVector), ' '))=3 or count(tokenize(normalize-space(RotationMatrix), ' '))=4 and count(tokenize(normalize-space(TranslationVector), ' '))=2" >(CartesianTransformation.WR3 <sch:value-of select="$uid"/>) the dimensionality of the TranslationVector shall be the same as for the RotationMatrix.</sch:assert> </sch:rule></sch:pattern>
   <!--(Rule CartesianTransformation.WR1)-->
   <sch:pattern id="CartesianTransformation_WR1"><sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "> <sch:let name="uid" value="@uid"/> <sch:assert test="every $i in tokenize(normalize-space(RotationMatrix), ' ') satisfies (number($i) ge -1 and number($i) le 1) ">(CartesianTransformation.WR1 <sch:value-of select="$uid"/>) the values of the RotationMatrix shall be in the interval [-1.0,+1.0]. </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CentreOfMass set of rules-->
   <!--(Reference to Entity) CentreOfMass.CentrePoint : CartesianPoint (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="CentreOfMass_CentrePoint">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CentreOfMass') or (self::ShapeDependentProperty and substring-after(@xsi:type,':')='CentreOfMass'))]/CentrePoint">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationItem[@uid = $uidRef and contains(' CartesianPoint  LeaderLinePoint  LeaderLinePointWithSurface ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CentreOfMass : <sch:value-of select="$uid"/>) The CentreOfMass.CentrePoint contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type CartesianPoint.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) CentreOfMass.DefinedIn : GeometricCoordinateSpace (kind=SINGLE - cardinality= - redefined=ShapeDependentProperty.DefinedIn)-->
   <sch:pattern id="CentreOfMass_DefinedIn">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CentreOfMass') or (self::ShapeDependentProperty and substring-after(@xsi:type,':')='CentreOfMass'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="DefinedIn/@uidRef"/>
         <sch:assert test="count(DefinedIn) = 1">(CentreOfMass : <sch:value-of select="$uid"/>) The CentreOfMass.DefinedIn attribute cardinality is redefined as [1].</sch:assert>
         <sch:assert test="count(DefinedIn) != 1 or //ExternalRefBaseObject[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))] or //RepresentationContext[@uid = $uidRef and contains(' GeometricCoordinateSpace ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CentreOfMass : <sch:value-of select="$uid"/>) The CentreOfMass.DefinedIn contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type GeometricCoordinateSpace.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) ShapeDependentProperty.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="CentreOfMass_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CentreOfMass') or (self::ShapeDependentProperty and substring-after(@xsi:type,':')='CentreOfMass'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
