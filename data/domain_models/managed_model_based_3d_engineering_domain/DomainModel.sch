      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Representation.RepresentationTypes : OPTIONAL SET[1:unbounded] OF ClassSelect (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ComposedGeometricModel_RepresentationTypes">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ComposedGeometricModel') or (self::Representation and substring-after(@xsi:type,':')='ComposedGeometricModel'))]/RepresentationTypes/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ComposedGeometricModel : <sch:value-of select="$uid"/>) The ComposedGeometricModel.RepresentationTypes contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Inverse of RepresentationContext.Representations :: PartProperty) Representation.ContextOfItems : RepresentationContext => no rule needed when PartProperty or Optional-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--CompositeAssembly set of rules-->
   <!--(Reference to Select) CompositeAssembly.CompositeAssemblyShape : OPTIONAL CompositeAssemblyShapeSelect (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="CompositeAssembly_CompositeAssemblyShape">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='CompositeAssembly') or (self::PartView and substring-after(@xsi:type,':')='CompositeAssembly'))]/CompositeAssemblyShape">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalAdvancedBrepShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalEdgeBasedWireframeShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalFacetedBrepShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalGeometricallyBoundedSurfaceShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalGeometricallyBoundedWireframeShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalManifoldSurfaceShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalShellBasedWireframeShapeRepresentation ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' ThreeDGeometrySet ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' ExternalAdvancedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalEdgeBasedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalFacetedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalGeometricallyBoundedSurfaceShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalGeometricallyBoundedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalManifoldSurfaceShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ExternalShellBasedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' ThreeDGeometrySet ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalAdvancedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalEdgeBasedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalFacetedBrepShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalGeometricallyBoundedSurfaceShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalGeometricallyBoundedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalManifoldSurfaceShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ExternalShellBasedWireframeShapeRepresentation ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Representation[@uid = $uidRef and contains(' ThreeDGeometrySet ',concat(' ',substring-after(@xsi:type,':'),' '))]">(CompositeAssembly : <sch:value-of select="$uid"/>) The CompositeAssembly.CompositeAssemblyShape contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of CompositeAssemblyShapeSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) CompositeAssembly.LayupPart : CompositeAssemblyTable (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="CompositeAssembly_LayupPart">
