   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ConditionRelationship set of rules-->
   <!--(Rule specific to Id construct) ConditionRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="ConditionRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionRelationship') or (self::ConditionRelationship and not(@xsi:type)))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(ConditionRelationship : <sch:value-of select="$uid"/>) The ConditionRelationship.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ConditionRelationship.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="ConditionRelationship_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionRelationship') or (self::ConditionRelationship and not(@xsi:type)))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(ConditionRelationship : <sch:value-of select="$uid"/>) The ConditionRelationship.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) ConditionRelationship.Related : Condition (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="ConditionRelationship_Related">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionRelationship') or (self::ConditionRelationship and not(@xsi:type)))]/Related">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Condition  AndCondition  EqualsCondition  NotCondition  NotEqualsCondition  OneOfCondition  OrCondition ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Condition  AndCondition  EqualsCondition  NotCondition  NotEqualsCondition  OneOfCondition  OrCondition ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Condition[@uid = $uidRef] or //*[@uid = $uidRef and (self::AssignedCondition or self::AssignedCondition)]">(ConditionRelationship : <sch:value-of select="$uid"/>) The ConditionRelationship.Related contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Condition.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) ConditionRelationship.RelationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="ConditionRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionRelationship') or (self::ConditionRelationship and not(@xsi:type)))]/RelationType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(ConditionRelationship : <sch:value-of select="$uid"/>) The ConditionRelationship.RelationType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule ConditionRelationship.WR1)-->
   <sch:pattern id="ConditionRelationship_WR1"> <sch:rule context="//ConditionRelationship[@uid]">&#xD; <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/>&#xD; <sch:let name="uid" value="@uid"/>&#xD; <sch:let name="uidRelating" value="../@uid"/>&#xD; <sch:let name="uidRelated" value="Related/@uidRef"/>&#xD; <sch:assert test="not(../@uid = Related/@uidRef)">&#xD; The related Condition and the relating Condition shall be different. &#xD; {&#xD; -entity_name:<sch:value-of select="$entity_name"/>&#xD; -entity_uid:<sch:value-of select="$uid"/> &#xD; -rule_name:ConditionRelationship.WR1&#xD; -relating:<sch:value-of select="$uidRelating"/>&#xD; -related:<sch:value-of select="$uidRelated"/>&#xD; }&#xD; </sch:assert>&#xD; </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--ConditionalConfiguration set of rules-->
   <!--(Reference to Select) ConditionalConfiguration.ConfigurationType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=Effectivity.ConfigurationType)-->
   <sch:pattern id="ConditionalConfiguration_ConfigurationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='ConditionalConfiguration') or (self::Effectivity and substring-after(@xsi:type,':')='ConditionalConfiguration'))]">
         <sch:let name="uid" value="@uid"/>
         <sch:let name="uidRef" value="ConfigurationType/@uidRef"/>
         <sch:assert test="count(ConfigurationType) = 1">(ConditionalConfiguration : <sch:value-of select="$uid"/>) The ConditionalConfiguration.ConfigurationType attribute cardinality is redefined as [1].</sch:assert>
