   <!--AlternatePartRelationship set of rules-->
   <!--(Default Value) AlternatePartRelationship.RelationType : String = 'alternate' (kind=SINGLE - redefined=PartRelationship.RelationType)-->
   <sch:pattern id="AlternatePartRelationship_RelationType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AlternatePartRelationship') or (self::PartRelationship and substring-after(@xsi:type,':')='AlternatePartRelationship'))]/RelationType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'alternate'">(AlternatePartRelationship : <sch:value-of select="$uid"/>) The value of RelationType shall be 'alternate'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) PartRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="AlternatePartRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='AlternatePartRelationship') or (self::PartRelationship and substring-after(@xsi:type,':')='AlternatePartRelationship'))]/Id">
