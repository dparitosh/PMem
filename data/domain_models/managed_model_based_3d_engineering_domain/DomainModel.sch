   <sch:pattern id="CableOccurrenceTerminalLocationGroup_UR1"><sch:rule context="//ShapeElement[@uid and substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']"> <sch:let name="uid" value="@uid"/> <sch:let name="names" value="child::Name/descendant::*[self::CharacterString or self::LocalizedString]"/> <sch:let name="followingAndPrecedingNames" value="following-sibling::ShapeElement[substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']/Name/descendant::*[self::CharacterString or self::LocalizedString] union preceding-sibling::ShapeElement[substring-after(@xsi:type,':')='CableOccurrenceTerminalLocationGroup']/Name/descendant::*[self::CharacterString or self::LocalizedString]"/> <sch:assert test="count($names) = 0 or not(some $i in $names, $j in $followingAndPrecedingNames satisfies ($i eq $j))">(CableOccurrenceTerminalLocationGroup.UR1: <sch:value-of select="$uid"/>) the Names (<sch:value-of select="$names"/>) of CableOccurrenceTerminalLocationGroup shall be unique for a CableOccurrence.</sch:assert> </sch:rule></sch:pattern>
