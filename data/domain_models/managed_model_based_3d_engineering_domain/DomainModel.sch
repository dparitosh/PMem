   <!--RealValue set of rules-->
   <!--(Reference to Entity) PropertyValue.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="RealValue_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='RealValue') or (self::PropertyValue and substring-after(@xsi:type,':')='RealValue'))]/ClassifiedAs/Classification">
