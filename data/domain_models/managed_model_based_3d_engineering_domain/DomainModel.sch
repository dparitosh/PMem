      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SurfaceCurve set of rules-->
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SurfaceProfileTolerance set of rules-->
   <!--(Reference to Entity) SurfaceProfileTolerance.DatumSystem : OPTIONAL DatumSystem (kind=SINGLE - cardinality=OPTIONAL  - redefined=false)-->
   <sch:pattern id="SurfaceProfileTolerance_DatumSystem">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SurfaceProfileTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='SurfaceProfileTolerance'))]/DatumSystem">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))] or //ShapeElement[@uid = $uidRef and contains(' DatumSystem  DatumSystemWithAssociatedModelCoordinateSystem ',concat(' ',substring-after(@xsi:type,':'),' '))]">(SurfaceProfileTolerance : <sch:value-of select="$uid"/>) The SurfaceProfileTolerance.DatumSystem contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type DatumSystem.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) GeometricTolerance.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="SurfaceProfileTolerance_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SurfaceProfileTolerance') or (self::GeometricTolerance and substring-after(@xsi:type,':')='SurfaceProfileTolerance'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
