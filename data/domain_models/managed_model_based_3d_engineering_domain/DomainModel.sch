   <!--(Rule SuppliedObjectRelationship.WR1)-->
   <sch:pattern id="SuppliedObjectRelationship_WR1"> <sch:rule context="//SuppliedObjectRelationship[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/> <sch:let name="reference_uidRef" value="Related/@uidRef"/> <sch:let name="reference" value="//*[@uid = $reference_uidRef]"/> <sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/> <sch:assert test="$relating_type = $related_type"> The Related and the Relating object shall be of same type. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:WR1 -relating_type:<sch:value-of select="$relating_type"/> -related_type:<sch:value-of select="$related_type"/> } </sch:assert> </sch:rule></sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--SupplierSolution set of rules-->
   <!--(Reference to Entity) SupplierSolution.Supplier : Organization (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="SupplierSolution_Supplier">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SupplierSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='SupplierSolution'))]/Supplier">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Organization ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Organization ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Organization[@uid = $uidRef]">(SupplierSolution : <sch:value-of select="$uid"/>) The SupplierSolution.Supplier contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Organization.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) AlternativeSolution.Id : IdentifierSelect-->
   <sch:pattern id="SupplierSolution_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SupplierSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='SupplierSolution'))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(SupplierSolution : <sch:value-of select="$uid"/>) The SupplierSolution.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) AlternativeSolution.VersionId : OPTIONAL IdentifierSelect-->
   <sch:pattern id="SupplierSolution_VersionId">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SupplierSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='SupplierSolution'))]/VersionId">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(SupplierSolution : <sch:value-of select="$uid"/>) The SupplierSolution.VersionId shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) AlternativeSolution.BaseElement : BreakdownElementOrAlternativeSolutionSelect (kind=SINGLE - cardinality= - redefined=false)-->
   <sch:pattern id="SupplierSolution_BaseElement">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SupplierSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='SupplierSolution'))]/BaseElement">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' AlternativeSolution  FinalSolution  SupplierSolution  TechnicalSolution ',concat(' ',@typeRef,' '))] or //ExternalRefBaseObject[@uid = $uidRef and contains(' BreakdownElement ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' AlternativeSolution  FinalSolution  SupplierSolution  TechnicalSolution ',concat(' ',substring-after(@xsi:type,':'),' '))] or //SubObject[@uid = $uidRef and contains(' BreakdownElement ',concat(' ',substring-after(@xsi:type,':'),' '))] or //AlternativeSolution[@uid = $uidRef] or //BreakdownElement[@uid = $uidRef]">(SupplierSolution : <sch:value-of select="$uid"/>) The SupplierSolution.BaseElement contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of BreakdownElementOrAlternativeSolutionSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) AlternativeSolution.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="SupplierSolution_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='SupplierSolution') or (self::AlternativeSolution and substring-after(@xsi:type,':')='SupplierSolution'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(SupplierSolution : <sch:value-of select="$uid"/>) The SupplierSolution.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
