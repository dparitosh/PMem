   <!--(Rule specific to Id construct) DocumentDefinition.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="DigitalDocumentDefinition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='DigitalDocumentDefinition') or (self::DocumentDefinition and substring-after(@xsi:type,':')='DigitalDocumentDefinition'))]/Id">
