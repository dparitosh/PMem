   <!--PartRelationship set of rules-->
   <!--(Rule specific to Id construct) PartRelationship.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="PartRelationship_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='PartRelationship') or (self::PartRelationship and not(@xsi:type)))]/Id">
