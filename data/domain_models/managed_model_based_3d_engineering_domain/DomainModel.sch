   <!--LifeCycleStage set of rules-->
   <!--(Rule LifeCycleStage.UR1)-->
   <sch:pattern id="LifeCycleStage_UR1"> <sch:rule context="//LifeCycleStage[@uid]"> <sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/> <sch:let name="uid" value="@uid"/> <sch:let name="sameAsExternalItem" value="if(SameAs/Proxy/Individual/ExternalItem/@uidRef) then SameAs/Proxy/Individual/ExternalItem/@uidRef else ()"/> <sch:let name="sameAsExternalOwlObject" value="if(SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()"/> <sch:let name="sameAsProxyString" value="if(SameAs/Proxy/Individual/ProxyString) then SameAs/Proxy/Individual/ProxyString else ()"/> <sch:let name="sameAs" value="$sameAsExternalItem union $sameAsExternalOwlObject union $sameAsProxyString"/> <sch:let name="followingAndPrecedingExternalItem" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalItem/@uidRef else ())"/> <sch:let name="followingAndPrecedingExternalOwlObject" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ExternalOwlObject/@uidRef else ())"/> <sch:let name="followingAndPrecedingProxyString" value="(if(following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString) then following-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString else ()) union (if(preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString) then preceding-sibling::LifeCycleStage/SameAs/Proxy/Individual/ProxyString else ())"/> <sch:let name="followingAndPreceding" value="$followingAndPrecedingExternalItem union $followingAndPrecedingExternalOwlObject union $followingAndPrecedingProxyString"/> <sch:assert test="not(some $i in $sameAs, $j in $followingAndPreceding satisfies ($i eq $j))"> The attribute SameAs shall be unique. { -entity_name:<sch:value-of select="$entity_name"/> -entity_uid:<sch:value-of select="$uid"/> -rule_name:UR1 -attribute_name:SameAs -attribute_value:<sch:value-of select="$sameAs"/> } </sch:assert> </sch:rule></sch:pattern>
