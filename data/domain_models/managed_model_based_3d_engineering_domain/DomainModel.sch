   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--OneOfCondition set of rules-->
   <!--(Default Value) OneOfCondition.ConditionType : String = 'one of' (kind=SINGLE - redefined=Condition.ConditionType)-->
   <sch:pattern id="OneOfCondition_ConditionType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OneOfCondition') or (self::Condition and substring-after(@xsi:type,':')='OneOfCondition'))]/ConditionType">
         <sch:let name="uid" value="../@uid"/>
         <sch:assert test="ClassString/text() = 'one of'">(OneOfCondition : <sch:value-of select="$uid"/>) The value of ConditionType shall be 'one of'.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Rule specific to Id construct) Condition.Id : OPTIONAL IdentifierSelect-->
   <sch:pattern id="OneOfCondition_Id">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OneOfCondition') or (self::OneOfCondition or (self::AssignedCondition and substring-after(@xsi:type,':')='OneOfCondition') or (self::AssignedCondition and substring-after(@xsi:type,':')='OneOfCondition')))]/Id">
         <sch:let name="uid" value="../@uid"/>
         <sch:let name="directId" value="@id"/>
         <sch:assert test="(count($directId) != 0 or count(Identifier/@id) != 0) and (count($directId) != 1 or count(Identifier/@id) = 0)">(OneOfCondition : <sch:value-of select="$uid"/>) The OneOfCondition.Id shall be defined with exactly one of the following construct Id/@id or Identifier/@id.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Entity) Condition.ClassifiedAs : OPTIONAL SET[1:unbounded] OF Classification (kind=AGGREGATE - cardinality=OPTIONAL SET[1:unbounded] OF  - redefined=false)-->
   <sch:pattern id="OneOfCondition_ClassifiedAs">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OneOfCondition') or (self::Condition and substring-after(@xsi:type,':')='OneOfCondition'))]/ClassifiedAs/Classification">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="//ExternalRefBaseObject[@uid = $uidRef and contains(' Classification ',concat(' ',@typeRef,' '))] or //SubObject[@uid = $uidRef and contains(' Classification ',concat(' ',substring-after(@xsi:type,':'),' '))] or //Classification[@uid = $uidRef]">(OneOfCondition : <sch:value-of select="$uid"/>) The OneOfCondition.ClassifiedAs contains a bad reference (<sch:value-of select="$uidRef"/>) must be of type Classification.</sch:assert>
      </sch:rule>
   </sch:pattern>
   <!--(Reference to Select) Condition.ConditionType : ClassSelect (kind=AGGREGATE - cardinality= - redefined=false)-->
   <sch:pattern id="OneOfCondition_ConditionType">
      <sch:rule context="//*[@uid and ((self::SubObject and substring-after(@xsi:type,':')='OneOfCondition') or (self::Condition and substring-after(@xsi:type,':')='OneOfCondition'))]/ConditionType/*">
         <sch:let name="uid" value="../../@uid"/>
         <sch:let name="uidRef" value="@uidRef"/>
         <sch:assert test="(self::Class and //ExternalRefBaseObject[@uid = $uidRef and contains(' Class ',concat(' ',@typeRef,' '))]) or (self::ExternalOwlClass and //ExternalRefBaseObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',@typeRef,' '))]) or (self::Class and //SubObject[@uid = $uidRef and contains(' Class ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::ExternalOwlClass and //SubObject[@uid = $uidRef and contains(' ExternalOwlClass ',concat(' ',substring-after(@xsi:type,':'),' '))]) or (self::Class and //Class[@uid = $uidRef]) or (self::ClassString) or (self::ExternalOwlClass and //ExternalOwlClass[@uid = $uidRef])">(OneOfCondition : <sch:value-of select="$uid"/>) The OneOfCondition.ConditionType contains a bad reference (<sch:value-of select="$uidRef"/>) must be an element of ClassSelect.</sch:assert>
      </sch:rule>
   </sch:pattern>
