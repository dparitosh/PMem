      </sch:rule>
   </sch:pattern>
   <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
   <!--AnnotationToModelLeaderLine set of rules-->
   <!--(Reference to Select) LeaderLine.GeometricElements : LIST[2:unbounded] OF LeaderLinePointSelect (kind=AGGREGATE - cardinality=LIST[2:unbounded] OF  - redefined=false)-->
   <sch:pattern id="AnnotationToModelLeaderLine_GeometricElements">
