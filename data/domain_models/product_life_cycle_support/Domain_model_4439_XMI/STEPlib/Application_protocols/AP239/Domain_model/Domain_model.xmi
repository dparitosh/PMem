            <ownedComment xmi:id="_18_4_1_65b021e_1677491378110_109674_157484" xmi:uuid="66749cac-c2c8-4437-8c01-fbb64906d840" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491303619_330235_108239"/>
              <body> the first valid serial number.</body>
