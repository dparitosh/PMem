        <packagedElement xmi:id="_18_4_1_65b021e_1677491291888_891582_97037" xmi:uuid="05bfc779-955c-4be1-bed0-2dce1e5846f7" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491349503_945745_137076" xmi:uuid="41c71c4b-fbe4-48d5-9ffb-b87e3518f0d1" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291888_891582_97037"/>
            <body>A RequirementCollectionRelationship is a type of RequirementViewRelationship. It identifies a collection relationship that is used to relate a parent (collection) requirement to its member requirements. This provides a method for collecting together a set of requirements and treating them as a single requirement, whilst still being able to refer to individual requirements. </body>
          </ownedComment>
          <name>RequirementCollectionRelationship</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491348211_899596_136455" xmi:uuid="0e66dcb0-6538-43e5-ad7e-ce8211a66c2b" xmi:type="uml:Generalization">
