              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491310744_998453_114203"/>
              <body>the related TimeInterval and the relating TimeInterval shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287333_680464_92651"/>
            <specification xmi:id="_18_4_1_65b021e_1677491387554_685328_165045" xmi:uuid="871087a1-8d11-415c-8064-4fadd748bce7" xmi:type="uml:OpaqueExpression">
