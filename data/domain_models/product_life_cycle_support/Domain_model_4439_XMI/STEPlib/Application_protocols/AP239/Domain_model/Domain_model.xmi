              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329092_770479_126009"/>
              <body>the related Envelope and the relating Envelope shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289435_832029_94712"/>
            <specification xmi:id="_18_4_1_65b021e_1677491409620_181126_181907" xmi:uuid="8baa91e8-8a6d-4b83-968a-a9651b1d64c0" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298330_368077_103690" xmi:uuid="1e38483d-5a7e-4aa5-8118-ade7a0fc5904" xmi:type="uml:Generalization">
