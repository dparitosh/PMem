              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491365795_225148_144502"/>
              <body>the related WorkOrder and the relating WorkOrder shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491293605_567456_98383"/>
            <specification xmi:id="_18_4_1_65b021e_1677491461340_158732_207377" xmi:uuid="b1dba4d6-22b4-4937-af10-ca6bb8709c12" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
