              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491328806_276470_125884"/>
              <body>the related Assumption and the relating Assumption shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289324_659604_94565"/>
            <specification xmi:id="_18_4_1_65b021e_1677491409423_500339_181779" xmi:uuid="0ad2e386-c920-4fd1-9ca5-3cec5d908ee2" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
