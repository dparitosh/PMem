          <ownedComment xmi:id="_18_4_1_65b021e_1677491335483_735304_129633" xmi:uuid="e7d12c4f-1a58-466c-943a-ad3c42a095a5" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290178_778548_95350"/>
            <body>A TypeOfPersonDefinitionRequiredAttributesAssociation is an association between a TypeOfPersonDefinition and the attributes required to define that type of person. &lt;example&gt; The type of person "van driver" is required to possess the qualification named "commercial driving license" or the experience level "3 years of driving more than 10,000 miles per year".&lt;/example&gt;</body>
          </ownedComment>
          <name>TypeOfPersonDefinitionRequiredAttributesAssociation</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491301317_752988_105495" xmi:uuid="01000b24-3235-4ef7-8de6-17add2ceadaa" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286712_923582_91912"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491298330_701213_103689" xmi:uuid="6ea9d549-c5f5-43bf-a3c1-e1eda293292f" xmi:type="uml:Generalization">
