            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491288764_885032_94177"/>
            <body>A LocatorRelationship is a relationship between two Locator objects. </body>
          </ownedComment>
          <name>LocatorRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491321061_491927_120929" xmi:uuid="064ddada-2a03-4673-b27d-5f7ad5f575a0" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491399549_761817_174709" xmi:uuid="46df7de3-eb10-4690-ab29-5f5fda652eb1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491321061_491927_120929"/>
              <body>the related Locator and the relating Locator shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491288764_885032_94177"/>
            <specification xmi:id="_18_4_1_65b021e_1677491399549_892240_174708" xmi:uuid="093447ac-e87f-4cae-8c56-e98310ec1dcb" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_434204_106805" xmi:uuid="32a97adf-62e7-4276-bb27-b6ce5c560906" xmi:type="uml:Generalization">
