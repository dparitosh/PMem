        <packagedElement xmi:id="_18_4_1_65b021e_1677491289457_346404_94714" xmi:uuid="a46a6041-c9de-4048-aaff-5edb9d55645e" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491329394_217570_126215" xmi:uuid="23664ef3-ded5-47ce-9fed-9419e82bccdd" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289457_346404_94714"/>
            <body>An Envelope is an historical record of the transmission of a Message. It is used to record the audit data for sending and acknowledging a Message. Each Envelope is only used once because it is a historical record and is not versioned.</body>
          </ownedComment>
          <name>Envelope</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491329309_641116_126155" xmi:uuid="292aa359-1129-4f73-86ba-f618b0e9d253" xmi:type="uml:Generalization">
