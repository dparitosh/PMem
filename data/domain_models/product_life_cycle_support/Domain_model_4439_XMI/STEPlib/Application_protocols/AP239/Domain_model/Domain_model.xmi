          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491346290_655293_135497" xmi:uuid="98635306-f64a-4d80-9b6a-a95673e081f8" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438572_476262_194673" xmi:uuid="72d43606-b711-498f-a5e2-7f83b85bb6c9" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346290_655293_135497"/>
              <body> the 2D or 3D rotation matrix. The RotationMatrix shall not be used for shearing.</body>
