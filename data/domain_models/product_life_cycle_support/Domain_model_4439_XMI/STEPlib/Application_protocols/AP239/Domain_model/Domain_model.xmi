            <body>A PartViewRelationship is a relationship between two PartView objects. </body>
          </ownedComment>
          <name>PartViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491339613_496159_131923" xmi:uuid="bf41b5f2-376e-4d27-abd9-30f640ebb45d" xmi:type="uml:Constraint">
