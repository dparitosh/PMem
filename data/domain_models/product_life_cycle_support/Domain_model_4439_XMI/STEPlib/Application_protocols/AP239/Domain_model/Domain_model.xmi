          <ownedComment xmi:id="_18_4_1_65b021e_1677491365928_27674_144566" xmi:uuid="285d3f2f-5e2b-4c09-bcee-996ad4109576" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293605_567456_98383"/>
            <body>A WorkOrderRelationship is a relationship between two WorkOrder objects. </body>
          </ownedComment>
          <name>WorkOrderRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491365795_225148_144502" xmi:uuid="eb12523a-de46-4635-b82f-a8c8af19f1b4" xmi:type="uml:Constraint">
