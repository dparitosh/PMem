        <packagedElement xmi:id="_18_4_1_65b021e_1677491292933_728435_97854" xmi:uuid="b803153d-90de-4e38-b3ef-4b5fd152111f" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491359866_652280_141746" xmi:uuid="e802f062-d963-497b-b4ac-c17606169cff" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292933_728435_97854"/>
            <body>An ItemInSlot is an association between a Slot and an item that connects on this Slot. The purpose is to be able to keep record of what can be or is connected in a particular slot. </body>
          </ownedComment>
          <name>ItemInSlot</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491301318_951935_105508" xmi:uuid="e970e5b8-f46f-4aba-8a03-64bfdcc278f2" xmi:type="uml:Generalization">
