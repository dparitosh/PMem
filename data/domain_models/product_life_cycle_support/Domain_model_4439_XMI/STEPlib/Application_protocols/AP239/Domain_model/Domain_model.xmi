              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491322336_492045_121824"/>
              <body>one object of PersonInOrganization that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491289117_301494_94414"/>
