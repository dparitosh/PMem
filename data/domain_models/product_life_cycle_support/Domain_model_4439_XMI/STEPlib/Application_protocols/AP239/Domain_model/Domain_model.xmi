            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293373_367969_98212"/>
            <body>A TaskMethodVersionRelationship that is a relationship between two TaskMethodVersion objects. </body>
          </ownedComment>
          <name>TaskMethodVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491363254_511111_143199" xmi:uuid="ee7306f7-10dd-4b5b-9d0a-05e73bf6e317" xmi:type="uml:Constraint">
