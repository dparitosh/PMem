              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491326813_709570_124516"/>
              <body>the related Project and the relating Project shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289166_129471_94427"/>
            <specification xmi:id="_18_4_1_65b021e_1677491406885_482170_180063" xmi:uuid="8c15fbb5-2c82-4323-9ea2-8f1b57c6131f" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
