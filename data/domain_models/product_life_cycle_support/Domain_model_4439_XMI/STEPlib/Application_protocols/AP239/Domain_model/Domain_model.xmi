        <packagedElement xmi:id="_18_4_1_65b021e_1677491290770_338314_95955" xmi:uuid="744d0663-313c-481f-ab0f-82146c38cbf6" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491340085_227409_132156" xmi:uuid="07e984ff-feca-476f-92f4-b89e793fe6a5" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290770_338314_95955"/>
            <body>A CollectionDefinition is a type of PartView that is the definition of a PartVersion that serves as a collector for Occurrence objects. &lt;example&gt;Objects that are mounted in the same vehicle but cannot be assembled together.&lt;/example&gt; &lt;example&gt;Brake pads on the left and right front brake from same supplier, locks and keys of the car all from one supplier, wooden panels in the interior from the same supplier (to ensure common structure of the wood) are examples for collections.&lt;/example&gt;</body>
          </ownedComment>
          <name>CollectionDefinition</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491337502_385932_130833" xmi:uuid="40589dac-5428-4fd7-adee-4986436923e6" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491290639_364398_95940"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491340085_970395_132157" xmi:uuid="64dfb725-8980-4f3b-8460-8282c1a90b06" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491431766_751500_190007" xmi:uuid="321b9971-e771-4751-b45a-f69bd8217b7b" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491340085_970395_132157"/>
              <body>the text that describes the rationale behind the CollectionDefinition. The value of this attribute need not be specified.</body>
            </ownedComment>
            <name>Purpose</name>
