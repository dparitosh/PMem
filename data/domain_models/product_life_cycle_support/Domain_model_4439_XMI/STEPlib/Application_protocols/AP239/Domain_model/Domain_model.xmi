        </packagedElement>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491287296_45082_92620" xmi:uuid="bc5478ba-d115-49a5-afaf-6fb8388dc5bd" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491310069_636611_113613" xmi:uuid="da1b8688-9d7b-4d16-97ef-0f9f606d2e5f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287296_45082_92620"/>
            <body>A SerialEffectivity is a type of Effectivity for which the domain of applicability is defined as a possibly open-ended interval of serial numbers. A 'start' value shall always be specified for SerialEffectivity, an 'end' value can be specified.</body>
          </ownedComment>
          <name>SerialEffectivity</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491305755_875573_110076" xmi:uuid="3ed1c5aa-da60-43d4-a01e-f586bb1a5e58" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491287059_187609_92450"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491303616_170912_108237" xmi:uuid="63a3ad90-6f85-4c60-9413-50d38e9674d2" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491378109_423331_157478" xmi:uuid="75115642-b889-44b0-884a-6f2f311ad472" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491303616_170912_108237"/>
              <body>the last valid serial number. The value of this attribute need not be specified. If the value for this attribute is not specified, the interval of applicability has no upper bound or it is implicitly defined via an EffectivityRelationship with &lt;a&gt;&lt;path&gt;./4_info_reqs_CommonResources.htm#EffectivityRelationship.RelationType&lt;/path&gt; RelationType&lt;/a&gt; 'inheritance'.</body>
            </ownedComment>
            <name>EndId</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286883_83887_92129"/>
