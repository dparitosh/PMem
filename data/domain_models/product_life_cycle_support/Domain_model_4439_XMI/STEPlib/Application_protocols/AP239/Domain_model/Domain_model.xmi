            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292656_100657_97677"/>
            <body>A RiskRelationship is a relationship between two Risk objects. </body>
          </ownedComment>
          <name>RiskRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491356447_210312_140250" xmi:uuid="04395778-3c2b-456b-b665-7f12b25f4cc9" xmi:type="uml:Constraint">
