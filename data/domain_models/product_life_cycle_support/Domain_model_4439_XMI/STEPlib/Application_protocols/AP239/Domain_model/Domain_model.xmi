              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491307063_2097_111123"/>
              <body>the related State and the relating State shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287111_933409_92475"/>
