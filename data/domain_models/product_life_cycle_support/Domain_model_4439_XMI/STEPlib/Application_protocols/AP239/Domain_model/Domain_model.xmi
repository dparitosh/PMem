          <ownedComment xmi:id="_18_4_1_65b021e_1677491346557_387332_135662" xmi:uuid="000bc259-9f08-490b-a8dd-6af17dc9097c" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291504_655439_96730"/>
            <body>An ExternalGeometricModel is a type of GeometricModel that contains geometry in a three-dimensional context only.</body>
          </ownedComment>
          <name>ExternalGeometricModel</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1702397643764_945648_129544" xmi:uuid="06fff9a3-f84e-4c35-9447-219bf6ac4624" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1702397722181_594258_129562" xmi:uuid="2bfd42a8-fc20-4261-bdee-952b09820874" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1702397643764_945648_129544"/>
              <body>each DetailedGeometricModelItem shall be either an axis placement or externally defined. &lt;note&gt;In case of an axis placement, the axis placement can be externally defined.&lt;/note&gt;</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291504_655439_96730"/>
            <specification xmi:id="_18_4_1_65b021e_1702397643766_95755_129545" xmi:uuid="12f68d77-6bac-4c1b-b11f-fbe5d85232a2" xmi:type="uml:OpaqueExpression">
              <body>self.Items-&gt;forAll(item | item.oclIsTypeOf(Application_protocols::AP239::Domain_model::RepresentationAndExternalElementReference::AxisPlacement) or not(item.External.oclIsUndefined()))</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491346465_333715_135605" xmi:uuid="692d084f-9400-4d02-bd9a-f732d8198915" xmi:type="uml:Generalization">
