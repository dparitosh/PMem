            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287024_412753_92419"/>
            <body>A ConditionRelationship is a relationship between two Condition objects. </body>
          </ownedComment>
          <name>ConditionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491305105_72080_109525" xmi:uuid="c762c2fd-47a6-4330-b092-dd8ee4a3ae3e" xmi:type="uml:Constraint">
