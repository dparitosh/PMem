            <ownedComment xmi:id="_18_4_1_65b021e_1677491399963_418228_174980" xmi:uuid="c4691627-6815-4117-911a-26676ba36553" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491321357_80429_121108"/>
              <body> the localized string value defining one address component.</body>
            </ownedComment>
