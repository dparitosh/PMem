            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285617_973629_90414"/>
            <body>A BreakdownElementVersionRelationship is a relationship between two BreakdownElementVersion objects. &lt;note&gt;Such a relationship can exist between two BreakdownElementVersion instances of the same BreakdownElement instance or of different BreakdownElement instances.&lt;/note&gt;</body>
          </ownedComment>
          <name>BreakdownElementVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491295819_576271_100910" xmi:uuid="72fc2862-e657-4005-88ab-07af6803be5d" xmi:type="uml:Constraint">
