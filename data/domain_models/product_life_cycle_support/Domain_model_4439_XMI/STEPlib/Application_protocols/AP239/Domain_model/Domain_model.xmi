            <aggregation>composite</aggregation>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677509523013_415313_172672" xmi:uuid="c7989c8d-6677-4a6f-af6d-93208d49f8e7" xmi:type="uml:Property">
