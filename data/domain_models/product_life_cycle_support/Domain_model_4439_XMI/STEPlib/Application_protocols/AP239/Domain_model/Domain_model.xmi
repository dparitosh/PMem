        <packagedElement xmi:id="_18_4_1_65b021e_1677491285874_852225_90777" xmi:uuid="e8ab0f53-dae5-4896-abbb-b853a779e200" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491298591_65977_104117" xmi:uuid="e21a62c2-3174-4a41-a214-84fbf2ffa217" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285874_852225_90777"/>
            <body>A CollectionMembershipRelationship is a relationship between two CollectionMembership objects. &lt;example&gt;Part "smart speaker" replaces part "encyclopaedia Britannia" in the "2019 version" of the consumer price index basket.&lt;/example&gt;</body>
          </ownedComment>
          <name>CollectionMembershipRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491298495_702642_104028" xmi:uuid="17719693-3ff5-4037-ac98-61267c29dc6e" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491374115_2229_152048" xmi:uuid="81df5165-e1e6-4d67-a072-c7c2d88a7bfb" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491298495_702642_104028"/>
              <body>the related CollectionMembership and the relating CollectionMembership shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285874_852225_90777"/>
            <specification xmi:id="_18_4_1_65b021e_1677491374115_529554_152047" xmi:uuid="5bc16bd8-119c-4a74-a86c-0d27eb7115cd" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298495_231207_104026" xmi:uuid="022be764-ba3c-46aa-97ff-3b5499731c29" xmi:type="uml:Generalization">
