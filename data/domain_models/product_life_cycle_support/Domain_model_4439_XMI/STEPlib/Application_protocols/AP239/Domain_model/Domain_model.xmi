            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287501_291597_92838"/>
            <body>A FileRelationship is a relationship between two File objects. </body>
          </ownedComment>
          <name>FileRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491312129_717636_115244" xmi:uuid="3b370c95-29e8-498b-9aa7-6a095a8033e1" xmi:type="uml:Constraint">
