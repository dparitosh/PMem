          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491312577_373252_115577" xmi:uuid="7d546e02-5fb4-4707-b533-c56e284c3b4a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491389799_665441_166753" xmi:uuid="f1f9ab14-765f-4704-9bee-dab431adfd80" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491312577_373252_115577"/>
              <body> one object of Document that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute relationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287527_873324_92844"/>
