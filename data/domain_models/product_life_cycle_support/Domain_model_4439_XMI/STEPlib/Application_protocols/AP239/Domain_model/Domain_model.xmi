          <ownedComment xmi:id="_18_4_1_65b021e_1677491363836_394789_143522" xmi:uuid="be7904b4-0c40-45fa-8cf7-34f3a6c14bbe" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293396_61453_98225"/>
            <body>A TaskObjectiveStateAssociation is an association between a state (specified by StateOrStateDefinitionSelect) and a TaskObjective.</body>
          </ownedComment>
