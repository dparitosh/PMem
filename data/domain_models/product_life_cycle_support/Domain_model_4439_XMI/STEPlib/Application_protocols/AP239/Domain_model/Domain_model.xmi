        <packagedElement xmi:id="_18_4_1_65b021e_1677491293115_818055_97982" xmi:uuid="84875145-f51c-4871-b3c7-f200db578b6b" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491361907_22313_142578" xmi:uuid="5ea1c29a-e9b8-44cb-9205-b3b3c2b7fc2f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293115_818055_97982"/>
            <body>A SystemVersionRelationship is a relationship between two SystemVersion objects. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
          </ownedComment>
          <name>SystemVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491361768_488866_142509" xmi:uuid="b3c38b5b-b920-4e27-9bcf-7785f2303b7f" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491457391_991592_205295" xmi:uuid="ea24a7b9-3c92-4fb2-ad9e-95513a33a841" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491361768_488866_142509"/>
              <body>the related SystemVersion and the relating SystemVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491293115_818055_97982"/>
            <specification xmi:id="_18_4_1_65b021e_1677491457390_434913_205294" xmi:uuid="b9579e3c-dc71-48ac-bf6d-53a648e9851e" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
