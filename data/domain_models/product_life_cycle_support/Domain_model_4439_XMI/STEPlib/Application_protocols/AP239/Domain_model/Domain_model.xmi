              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491298000_996003_103226"/>
              <body>the related CollectionVersion and the relating CollectionVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285829_214175_90700"/>
            <specification xmi:id="_18_4_1_65b021e_1677491373430_876894_151418" xmi:uuid="17c75dcc-2f0f-4f43-94ea-45457efe6e15" xmi:type="uml:OpaqueExpression">
