          <ownedComment xmi:id="_18_4_1_65b021e_1677491337965_427365_131054" xmi:uuid="5fe9a38c-3eae-4e20-ae0e-8925ada8b73a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290660_567651_95941"/>
            <body>A PartVersionRelationship is a relationship between two PartVersion objects. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
          </ownedComment>
          <name>PartVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491337818_672670_130978" xmi:uuid="7c18b66a-0a5b-432d-aaa6-5bcf640e5bc8" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491428922_311059_188224" xmi:uuid="3343e716-6806-4d8e-b950-13db579de9f6" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491337818_672670_130978"/>
              <body>the related PartVersion and the relating PartVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290660_567651_95941"/>
            <specification xmi:id="_18_4_1_65b021e_1677491428922_500862_188223" xmi:uuid="f26f3340-6454-45f8-98c0-9cfdf84eadba" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491337818_147237_130975" xmi:uuid="2bf7eacb-5115-4b3d-8f5e-c4720e85d196" xmi:type="uml:Generalization">
