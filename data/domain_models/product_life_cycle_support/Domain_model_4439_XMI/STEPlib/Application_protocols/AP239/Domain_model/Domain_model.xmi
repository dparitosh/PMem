    <packagedElement xmi:id="_18_4_1_65b021e_1677491285001_418838_89822" xmi:uuid="4d278ef4-6761-4916-88aa-bbec0e7b7533" xmi:type="uml:Package">
      <ownedComment xmi:id="_18_4_1_65b021e_1677491285093_781681_89903" xmi:uuid="205b887d-af9e-4efe-950c-340850a6259c" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285001_418838_89822"/>
        <body>This capability is for the representation of resources required to achieve a specified objective. &lt;example&gt; Examples of required resources are: &lt;ul&gt;&lt;li&gt;Spare parts;&lt;/li&gt;&lt;li&gt;Materials;&lt;/li&gt;&lt;li&gt;Persons with known skills;&lt;/li&gt;&lt;li&gt;Facilities;&lt;/li&gt;&lt;li&gt;Technical documentation;&lt;/li&gt;&lt;li&gt;Transportation services.&lt;/li&gt;&lt;/ul&gt;&lt;/example&gt; &lt;br/&gt;The figure below provides an overview of the capability.&lt;figuresysml&gt;&lt;id&gt;_18_4_1_65b021e_1677491292117_273000_97269&lt;/id&gt;Block Definition Diagram of the Resources CTC&lt;/figuresysml&gt; </body>
      </ownedComment>
      <name>Resources</name>
      <packagedElement xmi:id="_18_4_1_65b021e_1677491285090_544961_89901" xmi:uuid="37dfd906-d37b-45ec-aa62-361996a65938" xmi:type="uml:Package">
        <name>ModelElements</name>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491292392_531578_97472" xmi:uuid="0310687f-d9e9-4228-aa75-3214480cb174" xmi:type="uml:Class">
