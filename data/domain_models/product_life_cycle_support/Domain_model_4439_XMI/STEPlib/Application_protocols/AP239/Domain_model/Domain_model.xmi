            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292904_194926_97841"/>
            <body>A SlotDefinitionRelationship is a relationship between two SlotDefinition objects. </body>
          </ownedComment>
          <name>SlotDefinitionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491359203_815027_141430" xmi:uuid="dbec8801-5820-40e9-a054-b7ce969f718d" xmi:type="uml:Constraint">
