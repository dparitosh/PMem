            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293357_755984_98204"/>
            <body>A TaskMethodRelationship is a specialization of ActivityMethodRelationship that is a relationship between two TaskMethod objects. </body>
          </ownedComment>
          <name>TaskMethodRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491362958_368176_142999" xmi:uuid="5df52e6e-4adf-4882-ae95-05000bd82fe6" xmi:type="uml:Constraint">
