        <packagedElement xmi:id="_18_4_1_65b021e_1677491291546_548847_96738" xmi:uuid="3d38a1f5-0877-4b30-b288-97b57c140b67" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491347320_150624_136068" xmi:uuid="484ff771-cc06-4e46-a2d5-bd19dc7b7478" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291546_548847_96738"/>
            <body>A GeometricRepresentationRelationshipWithCartesianTransformation is a type of GeometricRepresentationRelationship that specifies a CartesianTransformation between the two GeometricCoordinateSpaces of the referenced GeometricModels.</body>
          </ownedComment>
          <name>GeometricRepresentationRelationshipWithCartesianTransformation</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491347292_851453_136044" xmi:uuid="a21e39f5-8c0d-4563-a4a9-c5a5dd03386a" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439648_65580_195378" xmi:uuid="a9201f6a-ee63-4322-9e0e-f30814b80dc6" xmi:type="uml:Comment">
              <ownedComment xmi:id="_18_4_1_65b021e_1677491492826_935838_219670" xmi:uuid="6fa028c2-f117-44c5-a817-06bb12b4052d" xmi:type="uml:Comment">
                <annotatedElement xmi:idref="_18_4_1_65b021e_1677491439648_65580_195378"/>
                <body>SELF\GeometricRepresentationRelationship.relating.contextOfItems :&lt;&gt;: SELF\GeometricRepresentationRelationship.related.contextOfItems</body>
              </ownedComment>
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347292_851453_136044"/>
              <body>the related and relating GeometricModels shall have different GeometricCoordinateSpace instances.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291546_548847_96738"/>
            <specification xmi:id="_18_4_1_65b021e_1677491439648_819672_195377" xmi:uuid="c0ba2b12-9857-4bfe-ba99-a98eb15d9180" xmi:type="uml:OpaqueExpression">
              <body>self.Relating.oclAsType(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricModel).ContextOfItems &lt;&gt; self.Related.oclAsType(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricModel).ContextOfItems</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491345382_45781_134957" xmi:uuid="8186ab04-f764-4e43-882c-e177f24988cf" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491291442_468899_96709"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491347320_153683_136069" xmi:uuid="218ae9c8-b42d-4e75-b7f0-4e54cf4f098d" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439673_954066_195388" xmi:uuid="8694e0d5-69d7-4896-b95f-300a9bdf81d2" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347320_153683_136069"/>
              <body> specifies the CartesianTransformation between the GeometricCoordinateSpaces of the Related and Relating GeometricModels.</body>
            </ownedComment>
