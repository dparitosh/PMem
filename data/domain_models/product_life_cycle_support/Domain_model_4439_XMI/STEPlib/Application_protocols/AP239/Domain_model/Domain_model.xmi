          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491338797_859287_131482" xmi:uuid="5f1efe54-8b56-4232-b9bb-886a96d4c2da" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491430149_129869_188962" xmi:uuid="abee5764-7c66-41b2-95d7-2b7d1654d345" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491338797_859287_131482"/>
              <body> the meaning of the relationship. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for PartRelationship. The value of RelationType shall not be 'alternate'.</body>
            </ownedComment>
            <name>RelationType</name>
