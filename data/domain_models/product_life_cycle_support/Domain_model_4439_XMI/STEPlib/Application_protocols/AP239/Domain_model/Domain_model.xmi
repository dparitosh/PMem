              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491353355_780899_138872"/>
              <body>the related ManagedResource and the relating ManagedResource shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292344_869811_97456"/>
            <specification xmi:id="_18_4_1_65b021e_1677491446777_964496_199649" xmi:uuid="46928328-359c-4dbb-9836-4e1375c61c50" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
