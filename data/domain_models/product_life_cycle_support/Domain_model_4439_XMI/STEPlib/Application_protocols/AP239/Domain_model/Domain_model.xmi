            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290066_301259_95305"/>
            <body>A PositionRelationship is a relationship between two Position objects. </body>
          </ownedComment>
          <name>PositionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491333257_294541_128347" xmi:uuid="450b2dd7-8286-4be3-b59e-44c024e37a9e" xmi:type="uml:Constraint">
