              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491305105_72080_109525"/>
              <body>the related Condition and the relating Condition shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287024_412753_92419"/>
            <specification xmi:id="_18_4_1_65b021e_1677491380221_862491_159304" xmi:uuid="37f64299-71a2-466f-b278-db0de0d6c1e9" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
