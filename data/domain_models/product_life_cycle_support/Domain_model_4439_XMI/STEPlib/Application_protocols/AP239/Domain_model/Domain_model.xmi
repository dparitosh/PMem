        <packagedElement xmi:id="_18_4_1_65b021e_1677491286980_723816_92405" xmi:uuid="d0444e62-344f-4743-a635-3e8e4f524221" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491304209_670986_108823" xmi:uuid="709c6a64-5d8a-4aaf-aea8-6aef858d7510" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286980_723816_92405"/>
            <body>An EnvironmentDefinitionViewRelationship is a relationship between two EnvironmentDefinitionView objects. </body>
          </ownedComment>
          <name>EnvironmentDefinitionViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491304143_401572_108760" xmi:uuid="4272c9ee-8f41-45e0-903f-76ce728b2a5a" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491378746_590155_158242" xmi:uuid="8f870ab0-9f62-474a-ab7d-f7573884e821" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491304143_401572_108760"/>
              <body>the related EnvironmentDefinitionView and the relating EnvironmentDefinitionView shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491286980_723816_92405"/>
            <specification xmi:id="_18_4_1_65b021e_1677491378746_288740_158241" xmi:uuid="8adcfa4b-59b0-442f-9be1-6a7d0c992516" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491304143_697774_108759" xmi:uuid="057ec12e-9ce8-4855-9b21-44a368def235" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491287541_422424_92845"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491302562_638643_106828" xmi:uuid="734aa3bf-c1f7-437b-b718-b7edf4350af4" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491301445_399186_105629" xmi:uuid="143e2fed-f634-4a17-bf9a-e1602f02c6cb" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491376235_836945_154544" xmi:uuid="724fb3bd-a445-46c4-b336-d23b3999c015" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491301445_399186_105629"/>
              <body>the other object of EnvironmentDefinitionView that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one EnvironmentDefinitionView in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
            <name>Related</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286757_863095_92015"/>
            <association xmi:idref="_18_4_1_65b021e_1677491286730_630038_91946"/>
