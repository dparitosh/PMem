        <packagedElement xmi:id="_18_4_1_65b021e_1677491289094_3468_94401" xmi:uuid="cf4cbaf3-6e29-4bc5-8b1f-a72c58365f8f" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491325786_149379_123884" xmi:uuid="838e5353-d77f-46cf-9fad-9c90a75713a3" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289094_3468_94401"/>
            <body>An OrganizationRelationship is a relationship between two Organization objects. &lt;example&gt; A team belongs to a department which itself belongs to a company. Such an organizational structure can be described using instances of OrganizationRelationship. &lt;/example&gt;</body>
          </ownedComment>
          <name>OrganizationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491325680_81693_123815" xmi:uuid="b1b26502-fbe5-42d0-91ac-941e3089ac6a" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491405244_663916_179032" xmi:uuid="a046c306-d161-496a-8617-c94373ba314a" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491325680_81693_123815"/>
              <body>the related Organization and the relating Organization shall be different.</body>
            </ownedComment>
