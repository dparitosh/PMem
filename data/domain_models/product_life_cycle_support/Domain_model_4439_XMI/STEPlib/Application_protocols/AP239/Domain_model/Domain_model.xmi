            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491288140_677297_93482"/>
            <body>An InterfaceSpecificationRelationship is a relationship between two InterfaceSpecification objects. </body>
          </ownedComment>
          <name>InterfaceSpecificationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491318600_355630_119812" xmi:uuid="fc1a984a-39da-46da-b90b-e5f31c75201f" xmi:type="uml:Constraint">
