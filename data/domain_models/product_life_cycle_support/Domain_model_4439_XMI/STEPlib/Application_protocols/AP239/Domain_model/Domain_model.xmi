        <packagedElement xmi:id="_18_4_1_65b021e_1677491289435_832029_94712" xmi:uuid="7435d2e4-84b7-4dea-ad14-ea74916f6d7c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491329198_482636_126077" xmi:uuid="279b5ced-5022-4e4d-9dad-ee2989e10efd" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289435_832029_94712"/>
            <body>An EnvelopeRelationship is a relationship between two Envelope objects. &lt;note&gt; The most obvious use of the association is to link an Envelope to its acknowledgements.&lt;/note&gt; </body>
          </ownedComment>
          <name>EnvelopeRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491329092_770479_126009" xmi:uuid="2d5fabde-5b45-448e-84b3-924d08b37ab6" xmi:type="uml:Constraint">
