        <packagedElement xmi:id="_18_4_1_65b021e_1677491290784_526522_95961" xmi:uuid="45ba8861-fe25-4bde-bd94-c0fd5c5a7834" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491340435_536817_132379" xmi:uuid="ab14620a-f570-46ec-9695-4aea40a78de8" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290784_526522_95961"/>
            <body>An AssemblyOccurrenceRelationshipSubstitution is a relationship that indicates that one AssemblyOccurrenceRelationship can be substituted for another AssemblyOccurrenceRelationship. The subjects of the substitution are the related Occurrence objects of both AssemblyOccurrenceRelationship objects. The Relating AssemblyDefinition shall be the same in both AssemblyOccurrenceRelationship objects.</body>
          </ownedComment>
          <name>AssemblyOccurrenceRelationshipSubstitution</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491340303_149213_132305" xmi:uuid="ef6ea11a-59a5-4b44-8024-1b5e60b7ce35" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491431969_482834_190166" xmi:uuid="368b04ec-26c9-4268-b525-5a54d06bcd6f" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491340303_149213_132305"/>
              <body>the related AssemblyOccurrenceRelationship and the relating AssemblyOccurrenceRelationship shall be different.</body>
            </ownedComment>
