        <packagedElement xmi:id="_18_4_1_65b021e_1677491291490_176154_96726" xmi:uuid="1f124396-9cfb-4fa2-bf12-0a0c5dfb7c58" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491346290_777820_135496" xmi:uuid="90ce289a-6179-48ee-90c2-9cb476209f80" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291490_176154_96726"/>
            <body>A CartesianTransformation defines a transformation matrix that is supporting rotation, translation, scaling and mirroring.</body>
          </ownedComment>
          <name>CartesianTransformation</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346209_149664_135456" xmi:uuid="59e2d5df-14db-4dcd-87cf-9fa17f2f3a8e" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438442_508254_194615" xmi:uuid="a88d4c32-f92f-4ce2-bb4b-1032d4b2a80d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346209_149664_135456"/>
              <body>the values of the RotationMatrix shall be in the interval [-1.0,+1.0]</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291490_176154_96726"/>
            <specification xmi:id="_18_4_1_65b021e_1677491438442_282567_194614" xmi:uuid="c8c9b262-1aa0-4367-aff8-d64a7a8765f9" xmi:type="uml:OpaqueExpression">
              <body>self.RotationMatrix-&gt;forAll(lr | lr.elements-&gt;forAll(e | (e &gt;= -1.0) and (e &lt;= 1.0) ))</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346211_770591_135457" xmi:uuid="5b2f75d4-b21c-4b87-ab07-34fe1286d467" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438445_190150_194618" xmi:uuid="bf667808-1ed8-40e6-a004-3e2859bd81f4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346211_770591_135457"/>
              <body>the value of Scale shall be greater than zero.</body>
            </ownedComment>
            <name>WR2</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291490_176154_96726"/>
            <specification xmi:id="_18_4_1_65b021e_1677491438445_982936_194617" xmi:uuid="e51831f7-96e6-43ae-bb3e-13e823e21d2b" xmi:type="uml:OpaqueExpression">
              <body>self.Scale &gt; 0</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346213_512724_135458" xmi:uuid="9945b0a2-01b9-4237-8ca6-2ccdc6a31c4c" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438448_762910_194621" xmi:uuid="550c64e2-2865-436d-8088-c897e9e246f1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346213_512724_135458"/>
              <body>the dimensionality of the TranslationVector shall be the same as for the RotationMatrix.</body>
            </ownedComment>
            <name>WR3</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291490_176154_96726"/>
            <specification xmi:id="_18_4_1_65b021e_1677491438448_941820_194620" xmi:uuid="56236246-27e2-45f9-a4f3-fcdced6f9f66" xmi:type="uml:OpaqueExpression">
              <body>self.TranslationVector-&gt;size() = self.RotationMatrix-&gt;size()</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346207_465227_135455" xmi:uuid="b1c03668-8e82-46c8-acb0-3d398115fabc" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438442_713338_194613" xmi:uuid="4af466f6-7d5c-40e3-9e32-e2ef79184025" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346207_465227_135455"/>
              <body>The RotationMatrix shall not be used for shearing.</body>
            </ownedComment>
            <name>IP1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291490_176154_96726"/>
            <specification xmi:id="_18_4_1_65b021e_1677491438441_722313_194612" xmi:uuid="38110a1f-7bbc-4676-9991-4498fa4f648e" xmi:type="uml:OpaqueExpression">
              <body>The RotationMatrix shall not be used for shearing.</body>
              <language>English</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491336528_997391_130268" xmi:uuid="23431fa2-4808-43c9-9d00-5afaa31c9360" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491290582_990778_95929"/>
          </generalization>
