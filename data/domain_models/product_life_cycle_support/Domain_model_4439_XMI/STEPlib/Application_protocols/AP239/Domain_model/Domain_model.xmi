              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491298103_374497_103366"/>
              <body>the CollectionView shall be unique for a CollectionVersion in the same InitialContext.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285833_154009_90706"/>
            <specification xmi:id="_18_4_1_65b021e_1677491373571_393913_151548" xmi:uuid="391a749d-7654-4d03-900d-134fe6a1df29" xmi:type="uml:OpaqueExpression">
              <body>CollectionView::allInstances()-&gt;isUnique(Sequence{ViewOf, InitialContext})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
