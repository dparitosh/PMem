            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285827_831645_90699"/>
            <body>A CollectionRelationship is a relationship between two Collection objects. </body>
          </ownedComment>
          <name>CollectionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491297924_900024_103139" xmi:uuid="49cb9f48-0664-4146-a349-8f23ccfca0e7" xmi:type="uml:Constraint">
