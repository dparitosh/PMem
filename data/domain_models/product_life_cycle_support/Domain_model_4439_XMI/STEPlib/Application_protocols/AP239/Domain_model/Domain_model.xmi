              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491309300_925862_113029"/>
              <body>the related PropertyValue and the relating PropertyValue shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287253_728761_92591"/>
            <specification xmi:id="_18_4_1_65b021e_1677491385583_958052_163634" xmi:uuid="a89cb236-9d97-4405-a20a-5f8c6f1faa93" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
