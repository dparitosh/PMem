        <packagedElement xmi:id="_18_4_1_65b021e_1677491291512_738834_96732" xmi:uuid="874e6c58-ee44-4e29-b373-45cd5d523358" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491346786_633283_135778" xmi:uuid="97045061-4b69-42fc-9676-8bda14e00d42" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291512_738834_96732"/>
            <body>A RepresentationRelationship is a relationship between two Representation objects. </body>
          </ownedComment>
          <name>RepresentationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346695_754195_135736" xmi:uuid="45ae2744-8692-4669-ac78-5fbac6b7076c" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491438913_263517_194922" xmi:uuid="d67b5388-a7a7-4d38-a33b-0fe9252588bd" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346695_754195_135736"/>
              <body>the related Representation and the relating Representation shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291512_738834_96732"/>
            <specification xmi:id="_18_4_1_65b021e_1677491438913_134356_194921" xmi:uuid="49f39246-2049-43eb-90f5-454892854e51" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298330_15690_103687" xmi:uuid="24896b09-ee5b-4f1f-a2d4-280abe9918a9" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491285842_938547_90711"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491302563_176021_106840" xmi:uuid="d4602d84-409e-4560-bdcd-e15641a2625b" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <isAbstract>true</isAbstract>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491346787_471182_135779" xmi:uuid="df2a87a6-22c6-45d2-8725-9f58928e8960" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439081_813493_194986" xmi:uuid="18ff7f5a-7c1b-4059-ab5e-cf8209c87252" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346787_471182_135779"/>
              <body>one object of Representation that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; </body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491291529_874651_96736"/>
            <association xmi:idref="_18_4_1_65b021e_1677491291547_426350_96739"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491346790_392099_135780" xmi:uuid="24f8dfec-245a-4db2-94f0-775f0a37b909" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439083_850276_194990" xmi:uuid="8f68b256-05cc-43cc-9fd2-0781384e6420" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346790_392099_135780"/>
              <body>the other object of Representation that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one Representation in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
            <name>Related</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491291529_874651_96736"/>
            <association xmi:idref="_18_4_1_65b021e_1677491291567_42266_96771"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491346793_364512_135781" xmi:uuid="ab5b3cc3-4ed7-4ba2-bf5b-5903cd4ac4fb" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439085_242274_194994" xmi:uuid="023eba24-6328-451f-8700-c759d37542a6" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346793_364512_135781"/>
              <body>if TRUE makes the related Representation part of the definition of the relating Representation. </body>
            </ownedComment>
            <name>Definitional</name>
            <visibility>public</visibility>
            <type href="../../../DataTypes.xmi#BOOLEAN"/>
            <aggregation>composite</aggregation>
