          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329400_979069_126219" xmi:uuid="c12111bf-591f-4633-a937-d2011e472705" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491409914_3066_182081" xmi:uuid="1787c043-29b9-45b3-b9ec-ade466e89941" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329400_979069_126219"/>
              <body> the Message that the Envelope is wrapping. A Message should be present unless the Envelope is being used to carry just an acknowledgment. The value of this attribute need not be specified.</body>
            </ownedComment>
            <name>Wrapping</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491289462_154266_94715"/>
