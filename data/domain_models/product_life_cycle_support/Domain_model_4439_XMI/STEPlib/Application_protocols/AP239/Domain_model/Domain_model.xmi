            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291917_979290_97040"/>
            <body>A RequirementVersionRelationship is a relationship between two RequirementVersion objects. </body>
          </ownedComment>
          <name>RequirementVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491349892_701797_137243" xmi:uuid="680f25cd-8ce9-4124-9d62-9ec0249bb69c" xmi:type="uml:Constraint">
