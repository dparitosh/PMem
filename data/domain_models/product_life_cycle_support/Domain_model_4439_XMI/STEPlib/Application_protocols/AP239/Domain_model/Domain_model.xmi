            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291053_941822_96280"/>
            <body> A ProductConfigurationRelationship is a relationship between two ProductConfiguration objects.</body>
          </ownedComment>
          <name>ProductConfigurationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491342364_196742_133426" xmi:uuid="03f0e5aa-c238-471e-bc3a-134a9e4f6399" xmi:type="uml:Constraint">
