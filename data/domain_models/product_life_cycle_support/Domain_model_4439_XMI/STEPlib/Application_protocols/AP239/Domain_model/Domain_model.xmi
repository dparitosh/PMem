        <packagedElement xmi:id="_18_4_1_65b021e_1677491287116_529975_92481" xmi:uuid="9a44d1dc-a9cf-462e-a5fc-cd5ce2b66975" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491307258_582473_111292" xmi:uuid="4adb241c-0f03-400f-ad6e-9dcc97b5df27" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287116_529975_92481"/>
            <body>An Identifier is a mechanism to provide the identifying name or code for the activity or product data.</body>
          </ownedComment>
          <name>Identifier</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491307175_770705_111222" xmi:uuid="6adef52c-75c7-4d77-8627-27c02e547146" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491382776_522112_161389" xmi:uuid="126f34f1-ebc1-444f-b8a7-edacf399e6d7" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491307175_770705_111222"/>
              <body>the combination of Id, Role and IdentificationContext shall be unique.</body>
            </ownedComment>
            <name>UR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287116_529975_92481"/>
            <specification xmi:id="_18_4_1_65b021e_1677491382776_94134_161388" xmi:uuid="0eb99ae7-bffe-4746-9705-e9cbfac1129e" xmi:type="uml:OpaqueExpression">
              <body>Identifier::allInstances()-&gt;isUnique(Sequence{Id, Role, IdentificationContext})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491307174_858369_111221" xmi:uuid="f7bab44b-d6c8-44fa-beb1-8adb690cd1ee" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491382776_676794_161387" xmi:uuid="8cffb0cd-213c-42b6-852d-239591c0c661" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491307174_858369_111221"/>
              <body>the IdentificationContext is only optional if the Identifier is used for the identification of an Organization.</body>
            </ownedComment>
            <name>ContextlessForOrganizationOnly</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287116_529975_92481"/>
            <specification xmi:id="_18_4_1_65b021e_1677491382776_829150_161386" xmi:uuid="c6d25c80-e864-49f4-b334-b307a0dc95e6" xmi:type="uml:OpaqueExpression">
              <body>not(self.IdentificationContext.oclIsUndefined() and not(Core_model::ManagementResources::ModelElements::Organization::allInstances()-&gt;exists(o | o.Id = self)))</body>
              <language>OCL2.0</language>
