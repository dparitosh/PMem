        <packagedElement xmi:id="_18_4_1_65b021e_1677491286816_227271_92104" xmi:uuid="1df4c3c1-abeb-4e98-beca-dbfb20a33cf3" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491302785_476571_107115" xmi:uuid="e88d1b70-06af-44a4-877d-aa6cd6a56a15" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286816_227271_92104"/>
            <body>The Language is a proxy specifying a language.</body>
          </ownedComment>
          <name>Language</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491302747_451180_107066" xmi:uuid="a35f3a31-f8ce-4d09-a156-8f3f22fd352b" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491377698_843_156195" xmi:uuid="d0c913e1-3691-4d18-8e9d-ab5caafe0e82" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491302747_451180_107066"/>
              <body>the Language code shall be two or three characters.</body>
            </ownedComment>
            <name>WR1</name>
            <specification xmi:id="_18_4_1_65b021e_1677491377697_175562_156194" xmi:uuid="04a5548c-a645-434f-876b-22890efcc3ee" xmi:type="uml:OpaqueExpression">
              <body>2 &lt;= LanguageCode.size() and LanguageCode.size() &lt;= 3</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491302747_45928_107065" xmi:uuid="f0935833-4485-45e8-a6f2-4070affbdd24" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491377697_687951_156193" xmi:uuid="12c6e682-9dea-4308-9db1-d5a88429a1fb" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491302747_45928_107065"/>
              <body>the combination of LanguageCode and CountryCode shall be unique.</body>
            </ownedComment>
            <name>UR1</name>
            <specification xmi:id="_18_4_1_65b021e_1677491377697_501832_156192" xmi:uuid="47d7fdd8-cdba-4176-9db0-964c25149944" xmi:type="uml:OpaqueExpression">
              <body> Language::allInstances()-&gt;isUnique(Sequence{LanguageCode, CountryCode})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298334_999129_103758" xmi:uuid="be6ef280-657d-4fc3-ae8c-8c1a3cd6c95c" xmi:type="uml:Generalization">
