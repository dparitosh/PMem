              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491356447_210312_140250"/>
              <body>the related Risk and the relating Risk shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292656_100657_97677"/>
            <specification xmi:id="_18_4_1_65b021e_1677491450654_119511_201844" xmi:uuid="4815e959-2cbe-4f45-be75-5ff5729d91f0" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
