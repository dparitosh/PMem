            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287111_933409_92475"/>
            <body>A StateRelationship is a relationship between two State objects. </body>
          </ownedComment>
          <name>StateRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491307063_2097_111123" xmi:uuid="1692f915-9753-4ca8-beef-905e175e26b9" xmi:type="uml:Constraint">
