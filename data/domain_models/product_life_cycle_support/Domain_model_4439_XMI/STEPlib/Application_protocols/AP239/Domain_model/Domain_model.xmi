              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491348211_131066_136456"/>
              <body>the related RequirementView and the relating RequirementView shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291806_315875_97030"/>
