    <packagedElement xmi:id="_18_4_1_65b021e_1677491284996_718855_89810" xmi:uuid="c1b8601f-09e3-4a58-bead-a06197afbde6" xmi:type="uml:Package">
      <ownedComment xmi:id="_18_4_1_65b021e_1677491285045_514497_89855" xmi:uuid="b35d9154-6e85-4094-aaa5-f5d645639b9a" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_65b021e_1677491284996_718855_89810"/>
        <body>This capability provides the ability to represent information about physically realized parts, assembly structures of physically realized parts and results gained by testing physically realized parts of assemblies. &lt;br/&gt;The figure below provides an overview of the capability. &lt;figuresysml&gt;&lt;id&gt;_18_4_1_65b021e_1677491287638_608684_92958&lt;/id&gt;Block Definition Diagram of the Individual Part CTC&lt;/figuresysml&gt;</body>
      </ownedComment>
      <name>IndividualPart</name>
