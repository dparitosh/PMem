        <packagedElement xmi:id="_18_4_1_65b021e_1677491289180_38458_94452" xmi:uuid="b7cc40fc-feef-4ce2-be79-0c814f302004" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491327087_103636_124690" xmi:uuid="d4558826-57df-41a1-8b97-f33aacde0da0" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289180_38458_94452"/>
            <body>A SuppliedObjectRelationship is a relationship between two objects of the SuppliedObjectSelect list representing the same object in different organizational contexts. &lt;note&gt; The different organizational contexts can be represented by different OrganizationOrPersonInOrganizationAssignments. &lt;/note&gt; The concept of multi-identification can also be used to distinguish objects in different organizational contexts. However, SuppliedObjectRelationship shall be used if the related object corresponds to an object at the supplier's site and if a distinction of additional information management is required. &lt;example&gt;Usually, PartVersions that are provided by suppliers have at the supplier's site an id different from the one at the contractor's site: a PartVersion that is identified in a company by the identifier 'C425' and the version id 'V2.0' can correspond to the PartVersion that the supplier identifies as '2X45' with the version id 'V3.2'.&lt;/example&gt; </body>
          </ownedComment>
          <name>SuppliedObjectRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491326975_910080_124618" xmi:uuid="e2dbf4f6-1f43-47f3-9fac-2cf0323db0b0" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491407063_381522_180215" xmi:uuid="88fcbf80-3686-4c58-93d8-0daf1c1db585" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491326975_910080_124618"/>
              <body> the Related and the Relating object shall be of same type.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289180_38458_94452"/>
            <specification xmi:id="_18_4_1_65b021e_1677491407062_961951_180214" xmi:uuid="7d0b7d50-d22f-40a1-9001-41553d99a08c" xmi:type="uml:OpaqueExpression">
              <body>self.Relating.oclType() = self.Related.oclType()</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491321738_27627_121363" xmi:uuid="170fc32a-32c2-4663-ab0e-e1139584e7e8" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491288814_615872_94197"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491302558_773431_106768" xmi:uuid="c0ec5ab4-e782-4683-8dcc-afe78bab0077" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491322485_950537_121915" xmi:uuid="48b5c274-d6f9-464a-a1d3-cebc6c063388" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491400889_98001_176115" xmi:uuid="30466097-8382-484f-aa6c-2b322a01762e" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491322485_950537_121915"/>
              <body> one object, specified by SuppliedObjectSelect, that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491288830_2027_94200"/>
