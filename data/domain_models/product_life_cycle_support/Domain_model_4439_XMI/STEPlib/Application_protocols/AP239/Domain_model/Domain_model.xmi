          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491315405_752160_117672" xmi:uuid="f67eb7e9-22bf-4412-a3f2-6fe2ff599319" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491393410_460116_169741" xmi:uuid="f2144e54-eab8-4c36-8f9a-48eeed6ec1b7" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491315405_752160_117672"/>
              <body> the other object, specified by IndividualOrPartViewSelect, that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one IndividualPartView in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
            <name>Related</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287837_228318_93179"/>
            <association xmi:idref="_18_4_1_65b021e_1677491287798_897694_93063"/>
