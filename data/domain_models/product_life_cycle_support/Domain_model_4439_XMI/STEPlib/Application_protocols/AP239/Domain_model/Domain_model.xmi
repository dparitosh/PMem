            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291529_874651_96736"/>
            <body>A Representation is a collection of one or more instances of RepresentationItem that are related in the specified RepresentationContext. </body>
          </ownedComment>
          <name>Representation</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346979_934878_135894" xmi:uuid="d08c7ed0-b967-4260-84c0-771472b0f2b5" xmi:type="uml:Constraint">
