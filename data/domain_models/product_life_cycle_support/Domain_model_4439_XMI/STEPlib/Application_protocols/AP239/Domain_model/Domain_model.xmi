            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291522_29585_96734"/>
            <body>A CartesianPoint is a type of Point. A CartesianPoint is a point that is defined by its coordinates in a rectangular Cartesian coordinate system.</body>
          </ownedComment>
          <name>CartesianPoint</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491345843_287212_135249" xmi:uuid="ce5daacf-2ff3-4a34-b544-1bb9b06f5b95" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491291470_74170_96720"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491346896_451895_135847" xmi:uuid="a39daaa0-fd20-473c-b209-8f3d0581c422" xmi:type="uml:Property">
