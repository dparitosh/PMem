            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491288944_494585_94335"/>
            <body>An ApprovalRelationship is a relationship between two Approval objects. </body>
          </ownedComment>
          <name>ApprovalRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491323110_266826_122305" xmi:uuid="d6b73fc2-8342-4c6d-b82b-f904322707bd" xmi:type="uml:Constraint">
