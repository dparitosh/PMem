            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291114_331044_96286"/>
            <body>A ProductClassRelationship is a relationship between two ProductClass objects. </body>
          </ownedComment>
          <name>ProductClassRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491343612_658042_134033" xmi:uuid="ed62c04e-45c1-4d23-8eec-33e23d2ba24d" xmi:type="uml:Constraint">
