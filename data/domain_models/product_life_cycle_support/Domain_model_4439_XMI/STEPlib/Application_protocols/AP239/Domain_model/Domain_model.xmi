              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491363610_411144_143418"/>
              <body>the related TaskElement and the relating TaskElement shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491293393_692747_98222"/>
