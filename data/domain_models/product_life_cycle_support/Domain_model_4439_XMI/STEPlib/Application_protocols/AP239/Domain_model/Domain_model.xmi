        <packagedElement xmi:id="_18_4_1_65b021e_1677491286788_509592_92074" xmi:uuid="239eccb2-ada7-4a35-9772-825d73e6341c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491302435_932663_106642" xmi:uuid="aea466b5-6fc2-43d2-96a4-ef689c497d8d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286788_509592_92074"/>
            <body>A StateDefinitionRelationship is an association between two StateDefinition objects. &lt;note&gt;Relationships between StateDefinition entities can be used to support fault diagnosis.&lt;/note&gt;</body>
          </ownedComment>
          <name>StateDefinitionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491302357_683419_106568" xmi:uuid="c14fe00b-0088-40a5-be8a-bc86cfdb6746" xmi:type="uml:Constraint">
