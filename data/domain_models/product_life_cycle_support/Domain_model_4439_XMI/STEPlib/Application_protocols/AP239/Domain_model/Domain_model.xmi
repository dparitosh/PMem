        <packagedElement xmi:id="_18_4_1_65b021e_1677491290582_990778_95929" xmi:uuid="b3d32f56-70e9-41bc-aac9-6c4d88cc5f07" xmi:type="uml:Class">
          <name>TransformationSelect</name>
          <isAbstract>true</isAbstract>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677509420561_141198_73292" xmi:uuid="d9cf0e13-2943-49c8-8763-267b0ccf8d32" xmi:type="uml:Port">
