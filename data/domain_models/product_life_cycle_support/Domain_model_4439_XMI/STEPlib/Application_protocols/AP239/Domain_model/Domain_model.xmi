          <memberEnd xmi:idref="_18_4_1_65b021e_1677491347379_14992_136192"/>
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491346290_655293_135497"/>
          <ownedEnd xmi:id="_18_4_1_65b021e_1677491347379_14992_136192" xmi:uuid="41505a10-411b-4568-9f39-9120634a5db0" xmi:type="uml:Property">
