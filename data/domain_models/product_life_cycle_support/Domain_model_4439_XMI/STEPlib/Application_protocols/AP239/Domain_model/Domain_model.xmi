          <name>CollectionVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491298000_996003_103226" xmi:uuid="d8e4db56-be8c-402d-91d4-3c9d0e5d702e" xmi:type="uml:Constraint">
