              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491313635_682524_116450"/>
              <body>the related DocumentDefinition and the relating DocumentDefinition shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287593_390460_92851"/>
            <specification xmi:id="_18_4_1_65b021e_1677491391145_730887_167913" xmi:uuid="9c7578e0-6b48-4eb6-b9c1-d4d35f03c3c9" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
