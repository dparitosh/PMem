              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491315432_261350_117684"/>
              <body>the related IndividualPart and the relating IndividualPart shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287779_469793_93052"/>
            <specification xmi:id="_18_4_1_65b021e_1677491393421_810845_169776" xmi:uuid="f87c485e-8536-44c2-83eb-4913ca4ac58b" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
