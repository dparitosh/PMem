          <isAbstract>true</isAbstract>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677509420611_811127_73334" xmi:uuid="fcb09f65-a0b7-4829-91d8-f89439442ad4" xmi:type="uml:Port">
