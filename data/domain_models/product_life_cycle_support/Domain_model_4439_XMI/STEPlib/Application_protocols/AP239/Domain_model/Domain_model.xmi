            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291519_985935_96733"/>
            <body>A GeometricCoordinateSpace is a type of RepresentationContext in which geometric elements can be defined. It is either two-dimensional or three-dimensional. An origin for coordinate values is implicitly defined.</body>
          </ownedComment>
          <name>GeometricCoordinateSpace</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491346827_763553_135793" xmi:uuid="01f79747-d8ef-41f5-ab6f-31bc8eb1891b" xmi:type="uml:Constraint">
