          <name>IndividualPartViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491314083_211047_116780" xmi:uuid="cbf704c9-da29-4bee-aad1-3b3ad91a99ba" xmi:type="uml:Constraint">
