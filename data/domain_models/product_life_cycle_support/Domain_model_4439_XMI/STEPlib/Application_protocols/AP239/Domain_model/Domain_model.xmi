        <packagedElement xmi:id="_18_4_1_65b021e_1677491293460_919720_98254" xmi:uuid="82517f9f-4597-4f55-9db2-1183278292ac" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491364863_919802_144130" xmi:uuid="a05175fd-1622-41fb-be54-b36674e08d66" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293460_919720_98254"/>
            <body>A DecisionPoint is a type of StructuredTaskElement. It requires a decision that determines which further TaskElement is to be followed. &lt;note&gt;The condition on which the decision is based optionally allows a further TaskElement to be invoked to provide the basis for the decision.&lt;/note&gt;</body>
          </ownedComment>
          <name>DecisionPoint</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491363567_510010_143390" xmi:uuid="f1860a92-9dad-4d1f-9861-9f38b8d25e9c" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491293390_196948_98221"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491364864_187347_144132" xmi:uuid="8f862efb-8bb2-4dc3-b559-bc0ca94fca4f" xmi:type="uml:Property">
