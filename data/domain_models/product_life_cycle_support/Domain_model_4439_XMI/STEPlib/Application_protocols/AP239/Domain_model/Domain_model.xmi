            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287705_180220_93042"/>
            <body>An IndividualPartVersionRelationship is a relationship between two IndividualPartVersion objects. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
          </ownedComment>
          <name>IndividualPartVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491313950_890627_116689" xmi:uuid="8aee6b14-1507-488e-b7b7-5d21d6b15b3f" xmi:type="uml:Constraint">
