              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491350428_947352_137519"/>
              <body>the related Verification and the relating Verification shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291969_58660_97088"/>
