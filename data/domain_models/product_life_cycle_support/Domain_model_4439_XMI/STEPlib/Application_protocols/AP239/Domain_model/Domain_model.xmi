        <packagedElement xmi:id="_18_4_1_65b021e_1677491289772_835471_95002" xmi:uuid="c5087f82-87a3-428f-ba5b-b23d062fc5fa" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491331630_675026_127497" xmi:uuid="9b7f88ee-2694-42ce-ad05-135e3eede712" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289772_835471_95002"/>
            <body>A SchemeRelationship is a specialization of ActivityMethodRelationship that is a relationship between two Scheme objects. &lt;note&gt;The SchemeRelationship provides the facility to relate Plans or Schedules, represented by the Scheme entity, in different ways. Classifications can be applied to different SchemeRelationships to indicate their use for different purposes.&lt;/note&gt; &lt;example&gt;Decomposition, based-on, alternative, and version are different kinds of relationships between Schemes.&lt;/example&gt;</body>
          </ownedComment>
          <name>SchemeRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491331603_528814_127472" xmi:uuid="c5258090-d928-4696-b3a5-9bb2ba391ad9" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491412015_945648_183525" xmi:uuid="53c9afdf-f1f8-4cb7-9353-93ece4bda38a" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491331603_528814_127472"/>
              <body>the related Scheme and the relating Scheme shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289772_835471_95002"/>
            <specification xmi:id="_18_4_1_65b021e_1677491412014_754753_183524" xmi:uuid="8dfceb6e-6b63-4fef-aeca-392d75e44623" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
