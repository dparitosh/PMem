        <packagedElement xmi:id="_18_4_1_65b021e_1677491290729_457448_95947" xmi:uuid="e61a2c3c-efb3-4908-a8af-812c1ae87523" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491339333_908207_131737" xmi:uuid="807f3cb9-8b6c-4773-bade-4a93cdc6a593" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290729_457448_95947"/>
            <body>An AssemblyViewRelationshipSubstitution is a relationship that indicates that one AssemblyViewRelationship can be substituted for another AssemblyViewRelationship. The subjects of the substitution are the related Occurrence objects of both AssemblyViewRelationship objects. The Relating AssemblyDefinition shall be the same in both AssemblyViewRelationship objects.</body>
          </ownedComment>
          <name>AssemblyViewRelationshipSubstitution</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491339204_452371_131663" xmi:uuid="372f5e86-a746-4468-b13f-dc1c044716b3" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491430677_978332_189341" xmi:uuid="1a1f9f50-cb4c-4d97-8087-248ff90426ef" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491339204_452371_131663"/>
              <body>the related AssemblyViewRelationship and the relating AssemblyViewRelationship shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290729_457448_95947"/>
            <specification xmi:id="_18_4_1_65b021e_1677491430677_166367_189340" xmi:uuid="f956769b-c636-43e0-b1dc-81ac1ab72320" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491321741_361658_121401" xmi:uuid="1e0fdf45-da9e-4fd4-ac3e-e37be8bcee8a" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491288814_615872_94197"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_857352_106795" xmi:uuid="47df2ba0-c38a-479a-9084-6e01d549ecb3" xmi:type="uml:Generalization">
