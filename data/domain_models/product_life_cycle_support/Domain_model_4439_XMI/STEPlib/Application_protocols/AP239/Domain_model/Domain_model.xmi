            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289254_985127_94541"/>
            <body>A JustificationRelationship is a relationship between two Justification objects. </body>
          </ownedComment>
          <name>JustificationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491327907_651382_125267" xmi:uuid="082f50bf-4012-4363-ac24-15430b05f5ac" xmi:type="uml:Constraint">
