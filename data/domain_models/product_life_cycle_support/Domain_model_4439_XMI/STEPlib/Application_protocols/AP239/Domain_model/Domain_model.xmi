          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491339600_853270_131912" xmi:uuid="2918844a-0109-4751-8ff3-8e36ff4d6f7a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491431143_943647_189614" xmi:uuid="5e6f5e04-1b80-4dbb-aad0-7c8d6af0349e" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491339600_853270_131912"/>
              <body> the meaning of the relationship. This information is defined by Reference Data. </body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287100_139156_92467"/>
            <isReadOnly>true</isReadOnly>
            <defaultValue xmi:id="_18_4_1_65b021e_1677491431144_289200_189616" xmi:uuid="a80015d3-9ff2-43b0-8f68-07f7000121ce" xmi:type="uml:InstanceValue">
              <instance xmi:idref="_18_4_1_65b021e_1677491290976_398313_96234"/>
