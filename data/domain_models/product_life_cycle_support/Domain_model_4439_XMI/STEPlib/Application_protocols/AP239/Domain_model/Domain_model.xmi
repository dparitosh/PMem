          <ownedComment xmi:id="_18_4_1_65b021e_1677491302699_2360_106980" xmi:uuid="f29cee96-cf65-4b2c-bf2e-2b46f729e83b" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286811_950678_92095"/>
            <body>The DateTimeString is a string to specify a date and an optional time of day. The representation of date and time shall be according to ISO 8601. </body>
          </ownedComment>
          <name>DateTimeString</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491302700_327175_106981" xmi:uuid="3930a6fe-a176-42ae-884f-647f8d9c1a7b" xmi:type="uml:Generalization">
            <general href="../../../DataTypes.xmi#STRING"/>
          </generalization>
        </packagedElement>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491287090_308464_92461" xmi:uuid="dd3317aa-100a-44e1-97f1-a77dc41a4ea9" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491306674_160458_110781" xmi:uuid="6c4da780-9545-4ba6-a9b4-cba82815d457" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287090_308464_92461"/>
            <body>An EventRelationship is a relationship between two Event objects. &lt;example&gt;An instance of this entity data type with RelationType 'sequence' can be used to specify that an event shall end before another event starts.&lt;/example&gt;</body>
          </ownedComment>
          <name>EventRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491306586_121107_110715" xmi:uuid="92b04a93-b922-4089-b8d9-7391c8320391" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491382103_577684_160823" xmi:uuid="dbdf2dc1-cecd-495e-b1a5-a88dc569ca0d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491306586_121107_110715"/>
              <body>the related Event and the relating Event shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287090_308464_92461"/>
            <specification xmi:id="_18_4_1_65b021e_1677491382103_404964_160822" xmi:uuid="939a9973-c5ad-4e97-ba89-59d905b4ad68" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302558_336494_106764" xmi:uuid="1c53d1f4-cecb-4605-9bc1-2b9391978a7f" xmi:type="uml:Generalization">
