            <body>An InterfaceConnectorViewRelationship is a relationship between two InterfaceConnectorView objects. </body>
          </ownedComment>
          <name>InterfaceConnectorViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491319248_978709_120275" xmi:uuid="3ac26518-fd3d-420f-8edc-dfdaeeea064e" xmi:type="uml:Constraint">
