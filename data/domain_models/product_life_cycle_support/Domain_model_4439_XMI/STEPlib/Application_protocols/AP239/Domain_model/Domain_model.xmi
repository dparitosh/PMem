        <packagedElement xmi:id="_18_4_1_65b021e_1677491289492_748525_94755" xmi:uuid="892629c0-e8ca-4fb9-b9a3-7cf2c16b8d22" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491329861_662695_126518" xmi:uuid="d08f9629-58b4-44b3-88c1-2b30c9785ed6" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289492_748525_94755"/>
            <body>An ExchangeContext provides a context for Reference Data used in the message. This complies with the requirements of ISO 8000-110 Clause 6, namely representing the provenance (traceability, context, governance) of data used. It also provides the ability to specify a default language, default unit and default identification context to enable optimization of the message size, allowing strings to be used as opposed to the explicit objects.</body>
          </ownedComment>
          <name>ExchangeContext</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491321654_695322_121334" xmi:uuid="531934ca-55d6-4238-827b-94ed99b43558" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491288807_933763_94195"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491329743_350510_126445" xmi:uuid="d07b3f96-e80e-404e-b423-25fa3d53c176" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491289637_3891_94862"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491329226_324155_126103" xmi:uuid="ef33b82e-1688-4b7f-bb1a-674d83adf8d8" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491289440_207140_94713"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329861_743899_126519" xmi:uuid="08a409e5-4f9c-4a3a-92a2-da260f55c54b" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410533_763481_182484" xmi:uuid="c3c47bff-01ef-4688-be45-e82b291877f0" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329861_743899_126519"/>
              <body> the universal resource identifier for the OWL reference-data library that provides the context for a message. This attribute is defaulted to the Core model reference data to provide a minimal context. The value of this attribute need not be specified. &lt;note&gt;Each message has a context that includes a single OWL class library that references any other OWL libraries that are required.&lt;/note&gt;</body>
            </ownedComment>
            <name>ClassLibrary</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286813_7358_92099"/>
