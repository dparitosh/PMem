        <packagedElement xmi:id="_18_4_1_65b021e_1677491287521_201200_92841" xmi:uuid="05cf26e9-7c00-43cb-bcb0-3a1c429fd379" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491312575_264849_115575" xmi:uuid="c4550642-5453-40ad-a3db-1b44eef5d84b" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287521_201200_92841"/>
            <body>A DocumentRelationship is a relationship between two Document objects. </body>
          </ownedComment>
          <name>DocumentRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491312490_251044_115509" xmi:uuid="d193bd0a-6d52-41f0-93c0-6145d452c56f" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491389664_215283_166675" xmi:uuid="da395957-6df7-455e-8917-50e30a7dcf7c" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491312490_251044_115509"/>
              <body>the related Document and the relating Document shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287521_201200_92841"/>
            <specification xmi:id="_18_4_1_65b021e_1677491389663_573994_166674" xmi:uuid="9d367e59-4a69-4d54-9229-c89b35ea66d6" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491303023_760260_107541" xmi:uuid="8f9c303a-c984-4277-874c-5adff2a06cef" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286864_939778_92126"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_721839_106802" xmi:uuid="b4303c1a-b6a2-4ab6-89e1-849b5e146c36" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491312575_547422_115576" xmi:uuid="df333c6d-f8f6-42ae-88a9-d7043943ed3a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491389798_750703_166749" xmi:uuid="2a4f3dd4-68a5-462a-b15f-c4729aa349c4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491312575_547422_115576"/>
              <body> the meaning of the relationship. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for DocumentRelationship. </body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286823_588879_92112"/>
            <association xmi:idref="_18_4_1_65b021e_1677491287603_271573_92862"/>
