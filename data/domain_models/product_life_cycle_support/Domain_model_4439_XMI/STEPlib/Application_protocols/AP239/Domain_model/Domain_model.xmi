          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491315403_706988_117671" xmi:uuid="2a15ba2e-1843-494d-bb2e-600f60739f42" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491393409_955577_169737" xmi:uuid="142f3a70-e081-4641-91ed-1098b20d5fa6" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491315403_706988_117671"/>
              <body> one object of IndividualPartView that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287721_450026_93046"/>
