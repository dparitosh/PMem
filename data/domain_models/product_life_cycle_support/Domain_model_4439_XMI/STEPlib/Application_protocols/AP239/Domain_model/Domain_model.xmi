            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291524_849681_96735"/>
            <body>A GeometricModel is a type of GeometricRepresentation that represents the geometric shape of a product.</body>
          </ownedComment>
          <name>GeometricModel</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491346908_684627_135852" xmi:uuid="6c3ccdd3-ac8d-46a0-9d5a-7fe907c60735" xmi:type="uml:Generalization">
