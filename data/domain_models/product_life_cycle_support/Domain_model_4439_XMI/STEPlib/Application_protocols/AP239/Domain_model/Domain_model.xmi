          <isAbstract>true</isAbstract>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677509423926_71297_76974" xmi:uuid="3bebc41a-0c11-4ecd-bdb9-52c677475952" xmi:type="uml:Port">
