        <packagedElement xmi:id="_18_4_1_65b021e_1677491292705_468046_97740" xmi:uuid="cfc8e619-4dfd-489d-b30a-af837e4f8d38" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491357009_249280_140579" xmi:uuid="07b3ca04-ed7b-428e-9874-b264cd599eba" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292705_468046_97740"/>
            <body>A CausalConsequence is a relationship that identifies secondary effects related to or resulting from a particular RiskConsequence. &lt;note&gt;The related is considered an after effect of the relating.&lt;/note&gt;</body>
          </ownedComment>
          <name>CausalConsequence</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491356880_625377_140517" xmi:uuid="188b42dd-1a62-48e7-b782-a3d662db9a55" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491451390_87655_202093" xmi:uuid="0f34fa0a-a9c4-4805-b0c2-ca45c76a53c1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491356880_625377_140517"/>
              <body>the related RiskConsequence and the relating RiskConsequence shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292705_468046_97740"/>
            <specification xmi:id="_18_4_1_65b021e_1677491451389_455518_202092" xmi:uuid="0b64468f-5262-46d4-b64b-b015ac4e3a2d" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302559_610290_106790" xmi:uuid="15bc15e5-9132-4137-8db2-784d5daa187c" xmi:type="uml:Generalization">
