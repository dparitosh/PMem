            <ownedComment xmi:id="_18_4_1_65b021e_1677491416593_584761_186571" xmi:uuid="b29317b4-8663-4e8d-8de4-179f135ea1ba" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491335486_456843_129635"/>
              <body>the required attributes of a person. The value of this attribute need not be specified. &lt;example&gt; 'Must have a degree'.&lt;/example&gt; &lt;example&gt; 'Must have 10 years experience'.&lt;/example&gt;</body>
            </ownedComment>
