              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346827_763553_135793"/>
              <body> the dimensionality of the GeometricCoordinateSpace shall be greater than 0.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291519_985935_96733"/>
            <specification xmi:id="_18_4_1_65b021e_1677491439101_451196_195029" xmi:uuid="93bdb360-95b2-44bd-ae31-4eedae5b52e9" xmi:type="uml:OpaqueExpression">
