        <packagedElement xmi:id="_18_4_1_65b021e_1677491293560_965321_98379" xmi:uuid="8ae17b49-0e56-480e-a366-076f5ae80e60" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491365152_416400_144269" xmi:uuid="5d9d1d98-55fb-4c64-a7ae-420ba597cbf6" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293560_965321_98379"/>
            <body>A WorkRequestRelationship is a relationship between two WorkRequest objects. </body>
          </ownedComment>
          <name>WorkRequestRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491365017_663363_144203" xmi:uuid="58e63347-68aa-4a5d-b514-1daa5c4ea8a0" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491460385_949482_206866" xmi:uuid="a2359824-15a3-4812-8365-dbc56205b58e" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491365017_663363_144203"/>
              <body>the related WorkRequest and the relating WorkRequest shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491293560_965321_98379"/>
            <specification xmi:id="_18_4_1_65b021e_1677491460384_989410_206865" xmi:uuid="38e4d226-b4b5-4b7c-9c76-c8d9a552dd46" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_384102_106806" xmi:uuid="079924c5-8efe-4fdd-abf5-34c742eabaf0" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491303023_52906_107534" xmi:uuid="4442767c-2b5c-4643-8272-10850b171b24" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286864_939778_92126"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491365153_551899_144270" xmi:uuid="b33e95f1-877b-4435-a945-cc8ecd54dabf" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491460571_6564_206940" xmi:uuid="d81f2e7c-5704-4be8-9ceb-dd02ae2a8b26" xmi:type="uml:Comment">
