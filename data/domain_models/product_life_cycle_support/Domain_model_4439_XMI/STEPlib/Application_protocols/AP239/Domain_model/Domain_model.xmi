              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491364864_187347_144132"/>
              <body>the criterion to be tested in order to make a decision. </body>
            </ownedComment>
            <name>Condition</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287003_820546_92413"/>
