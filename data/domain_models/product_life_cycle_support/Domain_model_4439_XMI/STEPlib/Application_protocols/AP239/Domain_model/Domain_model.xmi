              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491301650_79562_105818"/>
              <body> the string that specifies the identifier of the country. The value of this attribute shall conform to an alpha-2 code of ISO 3166-1. The value of this attribute need not be specified.</body>
            </ownedComment>
            <name>CountryCode</name>
            <visibility>public</visibility>
            <type href="../../../DataTypes.xmi#STRING"/>
