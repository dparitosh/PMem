              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491357031_538254_140588"/>
              <body>the related RiskPerception and the relating RiskPerception shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292712_670335_97744"/>
            <specification xmi:id="_18_4_1_65b021e_1677491451544_616757_202171" xmi:uuid="a69f856e-24fe-4d4c-a7a4-6795023e9e25" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
