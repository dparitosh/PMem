            <upperValue xmi:id="_18_4_1_65b021e_1677491436169_285551_193008" xmi:uuid="6249bf4f-0acf-4caa-a803-14c34c9790a2" xmi:type="uml:LiteralUnlimitedNatural">
              <value>*</value>
