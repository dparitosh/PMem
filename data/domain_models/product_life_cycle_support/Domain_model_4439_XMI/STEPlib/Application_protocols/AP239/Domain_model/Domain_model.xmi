                <annotatedElement xmi:idref="_18_4_1_65b021e_1677491439232_541235_195123"/>
                <body>EXISTS(Name) OR (TYPEOF(SELF\Representation) &lt;&gt; TYPEOF(SELF))</body>
              </ownedComment>
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346979_934878_135894"/>
              <body>if SELF is exact instance of Representation, then Name shall be provided.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291529_874651_96736"/>
            <specification xmi:id="_18_4_1_65b021e_1677491439232_917273_195122" xmi:uuid="b59b5fbe-144e-4853-99e1-50b430d221c4" xmi:type="uml:OpaqueExpression">
              <body>self.oclIsTypeOf(Core_model::ManagementResources::ModelElements::Organization) implies not self.Name.oclIsUndefined()</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
