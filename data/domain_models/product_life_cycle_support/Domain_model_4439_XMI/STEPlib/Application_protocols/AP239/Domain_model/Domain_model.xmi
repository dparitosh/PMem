              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491303361_768673_107996"/>
              <body> one object of Effectivity that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287059_187609_92450"/>
