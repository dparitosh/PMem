            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293154_124969_98040"/>
            <body>A SystemViewRelationship is a relationship between two instances of SystemView. Unless specified in a specialization of this object, this relationship does not involve inheritance of data between the two related objects.</body>
          </ownedComment>
          <name>SystemViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491361946_849002_142642" xmi:uuid="f8b261f5-f879-4d46-9e0e-dbc619ceaa89" xmi:type="uml:Constraint">
