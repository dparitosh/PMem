            <ownedComment xmi:id="_18_4_1_65b021e_1677491438803_358775_194834" xmi:uuid="4a06ccce-564c-4965-bc0a-e8dd0333e9e4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491346558_295238_135664"/>
              <body> the DigitalFile that contains the externally defined geometry information.</body>
