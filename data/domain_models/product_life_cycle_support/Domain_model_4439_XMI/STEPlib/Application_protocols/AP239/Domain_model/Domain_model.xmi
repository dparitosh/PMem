            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491288168_428540_93501"/>
            <body>An InterfaceConnectorVersionRelationship is a relationship between two InterfaceConnectorVersion objects. </body>
          </ownedComment>
          <name>InterfaceConnectorVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491319118_630278_120178" xmi:uuid="255c53bd-0c20-4c1c-a06f-9d1e15fb3d81" xmi:type="uml:Constraint">
