        <packagedElement xmi:id="_18_4_1_65b021e_1677491285393_281861_89991" xmi:uuid="b78c9df6-7290-4805-8392-868205a1d6c7" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491294505_744540_99354" xmi:uuid="6b0fd05c-d906-4ca3-b90f-bf7fdd2e7b08" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285393_281861_89991"/>
            <body>An ActivityRelationship is a relationship between two Activity objects. &lt;example&gt;The activity required to complete a work order, can be decomposed into a series of activities. Their corresponding instances would be related using instances of the ActivityRelationship entity.&lt;/example&gt;</body>
          </ownedComment>
          <name>ActivityRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491294435_33258_99279" xmi:uuid="0be34fba-fd60-428a-a6e3-695266822604" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491367745_36989_145978" xmi:uuid="0ac46107-3334-4557-bdc6-e8e094174359" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491294435_33258_99279"/>
              <body> the related Activity and the relating Activity shall be different. </body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285393_281861_89991"/>
            <specification xmi:id="_18_4_1_65b021e_1677491367743_902516_145977" xmi:uuid="79ca6ced-9d68-40b8-9b66-0bd63a7539b3" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
