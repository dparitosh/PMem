              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491313493_611672_116335"/>
              <body>the related DocumentVersion and the relating DocumentVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287587_58277_92849"/>
            <specification xmi:id="_18_4_1_65b021e_1677491390977_252094_167776" xmi:uuid="ae7cfc0f-f157-4934-a2ba-0056aaa47db1" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
