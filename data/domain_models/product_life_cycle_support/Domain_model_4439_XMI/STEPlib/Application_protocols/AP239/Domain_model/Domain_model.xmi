              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491323110_266826_122305"/>
              <body>the related Approval and the relating Approval shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491288944_494585_94335"/>
            <specification xmi:id="_18_4_1_65b021e_1677491401736_441348_176733" xmi:uuid="5ca77d5a-0400-47af-ad67-a99f7d407fbb" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
