        <packagedElement xmi:id="_18_4_1_65b021e_1677491291456_910663_96715" xmi:uuid="1dcc30b2-4fff-4e77-a5c0-e9b459063473" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491345620_42787_135118" xmi:uuid="d3d8dd54-0b19-4418-89cf-8da34bb54b48" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291456_910663_96715"/>
            <body>A GeometricRepresentationRelationshipWithSameCoordinateSpace is a type of GeometricRepresentationRelationship without a geometry transformation between the Related and the Relating GeometricModels.</body>
          </ownedComment>
          <name>GeometricRepresentationRelationshipWithSameCoordinateSpace</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491345596_322172_135096" xmi:uuid="3bcf2602-3cad-47f1-b3c5-07559241de94" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491437826_963415_194186" xmi:uuid="4fa7b07d-c187-4889-9784-af58ac2fcd92" xmi:type="uml:Comment">
              <ownedComment xmi:id="_18_4_1_65b021e_1677491491976_879490_219305" xmi:uuid="532f1bf3-6e66-4f02-b3da-42c2d95d86e6" xmi:type="uml:Comment">
                <annotatedElement xmi:idref="_18_4_1_65b021e_1677491437826_963415_194186"/>
                <body>SELF\GeometricRepresentationRelationship.relating.contextOfItems :=: SELF\GeometricRepresentationRelationship.related.contextOfItems</body>
              </ownedComment>
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491345596_322172_135096"/>
              <body>the related and relating GeometricModels shall share the same instance of GeometricCoordinateSpace.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291456_910663_96715"/>
            <specification xmi:id="_18_4_1_65b021e_1677491437826_198879_194185" xmi:uuid="5d2d190d-e064-4e96-8f1b-77017d7a796d" xmi:type="uml:OpaqueExpression">
              <body>self.Relating.oclAsType(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricModel).ContextOfItems = self.Related.oclAsType(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricModel).ContextOfItems</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491345382_328551_134956" xmi:uuid="58652abc-2807-43fe-9f01-d0cd01be09f2" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491291442_468899_96709"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491345621_142720_135120" xmi:uuid="75da7ed5-0ca5-46fa-b471-6c23c409fb0a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491437835_850812_194190" xmi:uuid="2f1c71ac-0d3a-4831-93b6-938c27e6eb1e" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491345621_142720_135120"/>
              <body>if TRUE makes the related Representation part of the definition of the relating Representation. </body>
            </ownedComment>
            <name>Definitional</name>
            <visibility>public</visibility>
            <type href="../../../DataTypes.xmi#BOOLEAN"/>
            <aggregation>composite</aggregation>
