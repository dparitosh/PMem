        <packagedElement xmi:id="_18_4_1_65b021e_1677491289058_552809_94382" xmi:uuid="f905c015-5523-4309-9120-6ce245984297" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491325245_981062_123553" xmi:uuid="53292180-a349-4c91-a1b2-f454e8095df7" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289058_552809_94382"/>
            <body>An InformationUsageRightRelationship is a relationship between two InformationUsageRight objects. &lt;example&gt;Where one InformationUsageRight supersedes another, then the original right is pointed to by the relating attribute, its replacement by the related attribute, and the relationType attribute takes the value supersedes. &lt;/example&gt;&lt;note&gt; The following additional data can be assigned to an InformationUsageRightRelationship: Effectivity, and InformationUsageRight.&lt;/note&gt;</body>
          </ownedComment>
          <name>InformationUsageRightRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491325135_764591_123482" xmi:uuid="af4babfc-5a72-480f-97d8-85dc10338f88" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491404455_118490_178513" xmi:uuid="60fc178e-0159-49f5-9cb5-78c9d1dce2d1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491325135_764591_123482"/>
              <body>the related InformationUsageRight and the relating InformationUsageRight shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289058_552809_94382"/>
            <specification xmi:id="_18_4_1_65b021e_1677491404455_235459_178512" xmi:uuid="5bf0a68d-c471-44ed-a6ad-a1b984ace1d5" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491321739_306685_121379" xmi:uuid="28195935-a057-442d-8f49-1d02549d3bed" xmi:type="uml:Generalization">
