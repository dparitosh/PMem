            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291969_58660_97088"/>
            <body>A VerificationRelationship is a relationship between two Verification objects. </body>
          </ownedComment>
          <name>VerificationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491350428_947352_137519" xmi:uuid="66e13f2b-f554-4bfa-bf29-cc1f009075da" xmi:type="uml:Constraint">
