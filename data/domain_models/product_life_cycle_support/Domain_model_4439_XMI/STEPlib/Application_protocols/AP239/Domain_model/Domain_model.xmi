            <type xmi:idref="_18_4_1_65b021e_1677491291529_874651_96736"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491439700_177908_195450" xmi:uuid="94ef6c0d-6ec0-492e-80a2-d81663064a6f" xmi:type="uml:LiteralInteger"/>
