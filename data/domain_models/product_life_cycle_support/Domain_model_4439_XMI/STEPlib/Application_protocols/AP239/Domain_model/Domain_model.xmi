        <packagedElement xmi:id="_18_4_1_65b021e_1677491287336_188607_92653" xmi:uuid="8bc78fe6-0a6a-4099-80dd-51d98a3b103d" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491310872_541294_114307" xmi:uuid="c29afcb5-50cc-4e37-8f29-baeec49014e7" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287336_188607_92653"/>
            <body>A TimeIntervalWithBounds is a type of TimeInterval. A TimeIntervalWithBounds is bounded either on one side or both sides. &lt;note&gt; If neither SecondaryBound nor Duration are specified, the time interval begins at the point in time identified by PrimaryBound and has no specified end point.&lt;/note&gt;</body>
          </ownedComment>
          <name>TimeIntervalWithBounds</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491310839_969346_114278" xmi:uuid="250a4984-1e70-40f6-bbbc-65b48f7d35be" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491387694_557074_165136" xmi:uuid="47bbbbac-cb0f-4f0e-af76-c48cd69946d7" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491310839_969346_114278"/>
              <body> either a Duration or a SecondaryBound can be specified.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287336_188607_92653"/>
            <specification xmi:id="_18_4_1_65b021e_1677491387694_572984_165135" xmi:uuid="61f8f014-068a-43cb-bac3-62309358b554" xmi:type="uml:OpaqueExpression">
              <body>self.SecondaryBound.oclIsUndefined() or self.Duration.oclIsUndefined()</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491310840_532139_114279" xmi:uuid="46f09598-cccb-4117-9d04-790c0ca9f39d" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491387695_313510_165138" xmi:uuid="4604dc99-21cd-42e3-8ac9-951d404471f6" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491310840_532139_114279"/>
              <body> at least one bound has to be specified.</body>
            </ownedComment>
            <name>WR2</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287336_188607_92653"/>
            <specification xmi:id="_18_4_1_65b021e_1677491387695_259611_165137" xmi:uuid="c671c9c9-fbe6-4b4c-af8b-3ad4cf4080b0" xmi:type="uml:OpaqueExpression">
              <body>not(self.PrimaryBound.oclIsUndefined()) or not(self.SecondaryBound.oclIsUndefined())</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491310494_124797_114009" xmi:uuid="fd19538f-1c3e-4d62-97b5-5be6abd3aafb" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491287322_1785_92648"/>
          </generalization>
