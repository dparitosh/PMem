            <upperValue xmi:id="_18_4_1_65b021e_1677491452316_801029_202555" xmi:uuid="7f3fe9da-eeaf-4fb6-8f5b-cfc02e7203a6" xmi:type="uml:LiteralUnlimitedNatural">
