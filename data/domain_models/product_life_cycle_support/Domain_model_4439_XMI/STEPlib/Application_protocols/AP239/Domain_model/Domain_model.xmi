        <packagedElement xmi:id="_18_4_1_65b021e_1677491291933_914693_97052" xmi:uuid="bbf9455d-e09d-4dee-b1bd-38a01ea292ad" xmi:type="uml:Association">
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491350104_815436_137361"/>
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491349793_683377_137212"/>
          <ownedEnd xmi:id="_18_4_1_65b021e_1677491350104_815436_137361" xmi:uuid="11160553-16a2-4935-b03b-ba92abcf5ffc" xmi:type="uml:Property">
            <type xmi:idref="_18_4_1_65b021e_1677491291895_880430_97039"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491442786_598604_197373" xmi:uuid="0e474902-2791-4fa2-8cbb-740b765ac369" xmi:type="uml:LiteralInteger"/>
