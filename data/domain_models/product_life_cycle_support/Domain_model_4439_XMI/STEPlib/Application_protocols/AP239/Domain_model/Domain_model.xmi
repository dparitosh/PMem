          <generalization xmi:id="_18_4_1_65b021e_1677491329225_752049_126097" xmi:uuid="f732637a-e083-445c-bfd4-b81621fd5629" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491289440_207140_94713"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329551_659340_126307" xmi:uuid="0e2d3ed3-c8ca-48e6-b73a-388c3a6c641c" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410118_632339_182213" xmi:uuid="23712541-c6ac-45f5-8868-125345778129" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329551_659340_126307"/>
              <body> the actual references (specified by MessageContentSelect) to the contents of the Message. The value of this attribute need not be specified. </body>
            </ownedComment>
            <name>Contains</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491289440_207140_94713"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491410118_249248_182214" xmi:uuid="f6f26bef-9df8-480d-955e-c80709eb93b0" xmi:type="uml:LiteralInteger"/>
            <upperValue xmi:id="_18_4_1_65b021e_1677491410117_79437_182212" xmi:uuid="e06260ff-d9c3-4c84-828f-79d4571ef601" xmi:type="uml:LiteralUnlimitedNatural">
