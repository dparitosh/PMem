        <packagedElement xmi:id="_18_4_1_65b021e_1677491289781_286357_95005" xmi:uuid="b8251d3d-2abc-45da-890e-e8c093637abd" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491331724_61838_127577" xmi:uuid="2e0c0d18-1c57-4ce6-83c9-b9ee92cbbb62" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289781_286357_95005"/>
            <body>A SchemeVersionRelationship is a specialization of ActivityMethodRelationship that is a relationship between two SchemeVersion objects. &lt;note&gt;The SchemeVersionRelationship provides the facility to relate versions of Plans or Schedules, represented by the SchemeVersion entity, in different ways. Classifications can be applied to different SchemeVersionRelationships to indicate their use for different purposes.&lt;/note&gt;</body>
          </ownedComment>
          <name>SchemeVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491331696_222563_127552" xmi:uuid="179a8f3a-c6ac-46c0-8ede-e5ca7cfb962e" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491412086_461627_183578" xmi:uuid="238a320f-b08d-4bc8-891a-ee441aa365dc" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491331696_222563_127552"/>
              <body>the related SchemeVersion and the relating SchemeVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289781_286357_95005"/>
            <specification xmi:id="_18_4_1_65b021e_1677491412085_221599_183577" xmi:uuid="6b1e67a5-cf7a-4563-9177-92256e3cfc62" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
