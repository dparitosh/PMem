        <packagedElement xmi:id="_18_4_1_65b021e_1677491290739_345812_95950" xmi:uuid="a70b9a68-8006-42b4-bf99-de73d838d052" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491339414_119523_131798" xmi:uuid="74c5609a-85b9-411e-8647-95ee8272c1f4" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290739_345812_95950"/>
            <body>A PromissoryAssemblyOccurrenceUsage is a type of AssemblyOccurrenceRelationship. A PromissoryAssemblyOccurrenceUsage is a relationship between the occurrence of a constituent of an assembly and a view of the assembly itself. The relationship describes the intention to use the occurrence of a constituent of an assembly in an assembly. The constituent or the assembly that is associated by a PromissoryAssemblyOccurrenceUsage can have no geometric information. &lt;example&gt;In early design stages, the PromissoryAssemblyOccurrenceUsage can be used to create preliminary BOMs for prototyping.&lt;/example&gt;</body>
          </ownedComment>
          <name>PromissoryAssemblyOccurrenceUsage</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491336561_120105_130301" xmi:uuid="6f10e0ff-3365-4fcc-9f5c-c4ad63d576f0" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491290586_83602_95932"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491339415_124735_131800" xmi:uuid="64c3c19b-11ad-401f-9985-d7d4daa3556e" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491430911_584179_189484" xmi:uuid="9f5245a1-cf0e-488d-ad34-f8c43c39afe4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491339415_124735_131800"/>
              <body>the meaning of the relationship. This information is defined by Reference Data. </body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287100_139156_92467"/>
            <isReadOnly>true</isReadOnly>
