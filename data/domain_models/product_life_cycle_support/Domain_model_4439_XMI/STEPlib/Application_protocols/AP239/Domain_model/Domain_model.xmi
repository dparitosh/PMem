        <packagedElement xmi:id="_18_4_1_65b021e_1677491287072_240512_92453" xmi:uuid="66a543d2-a98d-48e6-ad74-8883c32b31da" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491306159_923082_110405" xmi:uuid="c0a2f322-f671-41b3-ade7-75f57a357a2d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287072_240512_92453"/>
            <body> An EffectivityRelationship is a relationship between two Effectivity objects. The meaning of the relationship is represented by the RelationType attribute. &lt;note&gt; Sometimes effectivity is not dependent on specific dates or serial numbers, but on the effectivity of other items. In this case end values are not instantiated but are derived via an EffectivityRelationship to the reference Effectivity.&lt;/note&gt; </body>
          </ownedComment>
          <name>EffectivityRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491306076_542643_110336" xmi:uuid="65eb0d49-5dd9-4684-a5c7-d5f7ae15acc2" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491381544_809068_160381" xmi:uuid="372db9bd-40a2-4be4-a80c-f93430a708ab" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491306076_542643_110336"/>
              <body>the related Effectivity and the relating Effectivity shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287072_240512_92453"/>
            <specification xmi:id="_18_4_1_65b021e_1677491381544_41545_160380" xmi:uuid="6be7ccf2-29b3-492e-8dc2-baa6f4c7a7a0" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302563_906011_106837" xmi:uuid="43acb444-d2e0-42c9-bafa-b0623bc603df" xmi:type="uml:Generalization">
