            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287253_728761_92591"/>
            <body>A PropertyValueRelationship is a relation between two PropertyValue objects. </body>
          </ownedComment>
          <name>PropertyValueRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491309300_925862_113029" xmi:uuid="81ddb879-c50f-4125-94e5-3b739681cd97" xmi:type="uml:Constraint">
