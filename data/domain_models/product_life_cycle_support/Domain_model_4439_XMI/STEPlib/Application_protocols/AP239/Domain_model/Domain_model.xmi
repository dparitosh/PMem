        <packagedElement xmi:id="_18_4_1_65b021e_1677491287797_506776_93060" xmi:uuid="16b81d6f-7adf-43b8-b3a5-4ebda8ffced3" xmi:type="uml:Association">
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491315903_613311_118009"/>
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491314875_16840_117316"/>
          <ownedEnd xmi:id="_18_4_1_65b021e_1677491315903_613311_118009" xmi:uuid="3f3a5041-d395-4321-b019-3451d949e741" xmi:type="uml:Property">
            <type xmi:idref="_18_4_1_65b021e_1677491287749_243656_93048"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491393998_38425_170222" xmi:uuid="68d2290a-2f72-45ad-b60e-2d7f46c21db4" xmi:type="uml:LiteralInteger"/>
            <upperValue xmi:id="_18_4_1_65b021e_1677491393998_9162_170221" xmi:uuid="06aa87b3-991a-4f3f-a9a4-d6d1d2291d1c" xmi:type="uml:LiteralUnlimitedNatural">
              <value>*</value>
