        <packagedElement xmi:id="_18_4_1_65b021e_1677491285673_530622_90463" xmi:uuid="db74c74b-68fa-4171-b592-b3f6ac381fdf" xmi:type="uml:Association">
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491297154_977332_102411"/>
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491296708_775210_101937"/>
          <ownedEnd xmi:id="_18_4_1_65b021e_1677491297154_977332_102411" xmi:uuid="70e8ed00-ef63-4912-989d-709ca3e4085b" xmi:type="uml:Property">
            <type xmi:idref="_18_4_1_65b021e_1677491285648_532032_90424"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491372367_398463_150391" xmi:uuid="926a811b-9b51-46a0-8da5-9a430aaa4151" xmi:type="uml:LiteralInteger"/>
