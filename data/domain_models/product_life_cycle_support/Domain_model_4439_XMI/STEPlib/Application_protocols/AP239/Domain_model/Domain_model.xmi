              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491312129_717636_115244"/>
              <body>the related File and the relating File shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287501_291597_92838"/>
