              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491330403_470987_126748"/>
              <body>the related Observation and the relating Observation shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289612_818098_94858"/>
            <specification xmi:id="_18_4_1_65b021e_1677491410980_484740_182855" xmi:uuid="f1753420-7329-422d-8780-b77d9528f413" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
