        <packagedElement xmi:id="_18_4_1_65b021e_1677491289471_612504_94717" xmi:uuid="5a7e3d5d-68d3-40a7-b094-0a4ff81bc5ba" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491329710_418183_126397" xmi:uuid="b43827d1-44b2-4a65-a3f2-7892fa3c6ee8" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289471_612504_94717"/>
            <body>A MessageRelationship is a relationship between two Message objects. &lt;example&gt;If messageB replaces messageA, then MessageRelationship.Related points to messageB and MessageRelationship.Relating points to messageA with MessageRelationship.RelationType set to 'replaces' either as a string or standard reference data.&lt;/example&gt;</body>
          </ownedComment>
          <name>MessageRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491329604_379487_126329" xmi:uuid="234f441d-ed7a-42b0-9151-44ebfe9b6de6" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410143_704786_182276" xmi:uuid="0e8c6690-8592-4a07-a2bd-0a74dd56dfa5" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329604_379487_126329"/>
              <body>the related Message and the relating Message shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289471_612504_94717"/>
            <specification xmi:id="_18_4_1_65b021e_1677491410142_861504_182275" xmi:uuid="357e3187-d6fe-4285-b4d3-7f199e39b0d4" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302563_677784_106834" xmi:uuid="33cd4f0b-f33e-4f57-902b-4daf81abd710" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491298332_151742_103741" xmi:uuid="b412812a-f7a7-41bb-b31e-74220baa5572" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491285842_938547_90711"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329710_402027_126398" xmi:uuid="d977a9e8-c51f-4f88-becf-e9e08be4736c" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410301_267007_182356" xmi:uuid="69243e05-d70a-4a6c-81e5-d40abc4d7452" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329710_402027_126398"/>
              <body>one object of Message that is part of the relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491289462_154266_94715"/>
            <association xmi:idref="_18_4_1_65b021e_1677491289480_11683_94729"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329713_61419_126399" xmi:uuid="55ee9014-7590-4740-b58f-bd7fd1f3f98b" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410303_410090_182360" xmi:uuid="f7f136a7-a07f-4cb9-bcae-9995f3e29ab2" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329713_61419_126399"/>
              <body> the other object of Message that is part of this relationship. &lt;note&gt; The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one Message in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
