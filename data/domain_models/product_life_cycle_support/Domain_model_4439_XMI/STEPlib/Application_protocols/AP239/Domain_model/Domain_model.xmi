        <packagedElement xmi:id="_18_4_1_65b021e_1677491286815_736229_92102" xmi:uuid="a9fdfe5f-fd6d-4313-ac35-9c0be5d24b4c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491302744_651242_107054" xmi:uuid="c53fcfb8-a50d-4301-8da4-ef7842461c31" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286815_736229_92102"/>
            <body>A model artefact that allows a generic data type to be used as a class object for a select. The IdentifierStringProxy allows for the representation of an identifier as a string. &lt;note&gt;As it is a modelling artefact, it cannot be represented in the implementation form if the implementation languages have more efficient representation of the type in the select.&lt;/note&gt;</body>
          </ownedComment>
          <name>IdentifierStringProxy</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491302744_360006_107053" xmi:uuid="d4077e92-8ecf-442b-9d3e-992ff319f7ef" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286883_83887_92129"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491302744_920581_107055" xmi:uuid="44e3b0d4-acd4-45ad-9989-016c1df7cc2a" xmi:type="uml:Property">
            <name>value</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286811_193903_92096"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491287227_743309_92585" xmi:uuid="aa932900-8800-479b-9412-75886f419f5a" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491308951_156880_112745" xmi:uuid="fddc380b-39bc-495d-b6ca-93f0259040da" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287227_743309_92585"/>
            <body>A PropertyDefinitionRelationship is a relationship between two PropertyDefinition objects. &lt;example&gt; A PropertyDefinitionRelationship can be used to indicate that the value of one PropertyDefinition can be derived from the value of another PropertyDefinition.&lt;/example&gt;</body>
          </ownedComment>
          <name>PropertyDefinitionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491308858_103782_112670" xmi:uuid="2d9bb748-b435-43e6-a6ce-33d0b17a763f" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491384900_136783_163141" xmi:uuid="56cc3d70-06f5-4d79-bf47-4867425d0e3e" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491308858_103782_112670"/>
              <body>the related PropertyDefinitionSelect and the relating PropertyDefinitionSelect shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287227_743309_92585"/>
            <specification xmi:id="_18_4_1_65b021e_1677491384899_112582_163140" xmi:uuid="4809f918-3b52-4cf9-ad6c-df646847b691" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
