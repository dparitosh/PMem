            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289324_659604_94565"/>
            <body>An AssumptionRelationship is a relationship between two Assumption objects. </body>
          </ownedComment>
          <name>AssumptionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491328806_276470_125884" xmi:uuid="689e5c5e-183c-4c57-b61e-71c904167c12" xmi:type="uml:Constraint">
