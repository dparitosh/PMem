          <ownedComment xmi:id="_18_4_1_65b021e_1677491301547_904159_105715" xmi:uuid="266f227d-f567-404f-a18f-17ac824627fd" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286731_700767_91950"/>
            <body>A ConditionEvaluationRelationship is a relationship between two ConditionEvaluation objects. </body>
          </ownedComment>
          <name>ConditionEvaluationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491301455_79233_105637" xmi:uuid="0fc7cdfa-1361-4ed5-91dd-ec5df7341814" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491376239_712069_154564" xmi:uuid="58aec851-3583-4b50-bf38-0a8af8368790" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491301455_79233_105637"/>
              <body>the related ConditionEvaluation and the relating ConditionEvaluation shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491286731_700767_91950"/>
            <specification xmi:id="_18_4_1_65b021e_1677491376239_234469_154563" xmi:uuid="8b9ee701-599a-4745-83e5-b13b2c72c3a3" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491301455_285063_105636" xmi:uuid="c5566d2d-766f-42dc-bdaa-0f83a5aa0943" xmi:type="uml:Generalization">
