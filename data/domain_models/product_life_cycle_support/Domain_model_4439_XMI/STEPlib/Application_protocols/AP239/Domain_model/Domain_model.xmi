              <value>http://standards.iso.org/iso/10303/tech/refdata/core_rd</value>
            </defaultValue>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329864_953924_126520" xmi:uuid="ed2edf7d-d087-4cd6-ba5d-51717a9da66f" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491410535_401710_182489" xmi:uuid="cd69647b-3f84-4550-bc40-cd278aad4a9d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329864_953924_126520"/>
              <body> the default context allowing identifiers to be specified as strings in the message and assuming a standard id role. The value of this attribute need not be specified.</body>
