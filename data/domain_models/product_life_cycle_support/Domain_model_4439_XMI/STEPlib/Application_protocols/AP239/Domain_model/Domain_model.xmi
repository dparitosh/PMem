              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491359203_815027_141430"/>
              <body>the related SlotDefinition and the relating SlotDefinition shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292904_194926_97841"/>
            <specification xmi:id="_18_4_1_65b021e_1677491454269_43072_203611" xmi:uuid="7b5c2517-7a87-46a7-a6ea-fac3d725612b" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
