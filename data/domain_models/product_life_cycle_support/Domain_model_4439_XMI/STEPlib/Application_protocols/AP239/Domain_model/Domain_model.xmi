            <end xmi:id="_18_4_1_65b021e_1677512636156_193667_251070" xmi:uuid="0383043a-8211-47aa-8667-32eb11d76844" xmi:type="uml:ConnectorEnd">
              <role xmi:idref="_18_4_1_65b021e_1677509429161_78106_81639"/>
            </end>
            <end xmi:id="_18_4_1_65b021e_1677512636156_559461_251071" xmi:uuid="429459da-d81b-44fe-8417-ea4dd8b4dc4e" xmi:type="uml:ConnectorEnd">
              <role xmi:idref="_18_4_1_65b021e_1677509423305_511413_76120"/>
