        <packagedElement xmi:id="_18_4_1_65b021e_1677491290746_741096_95952" xmi:uuid="21ef71fa-f3db-4d03-811d-5b5cc5a69104" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491339600_607730_131910" xmi:uuid="a4f0fa0f-5bf0-46dd-a09f-e2e8bf1818dd" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290746_741096_95952"/>
            <body>A ReplacedUsageRelationship is a type of OccurrenceRelationship that is a relationship between two Occurrence objects where the relating Occurrence is replaced by the related Occurrence.</body>
          </ownedComment>
          <name>ReplacedUsageRelationship</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491338557_67313_131336" xmi:uuid="1d051220-3db7-4af3-b4a9-2c652d8de057" xmi:type="uml:Generalization">
