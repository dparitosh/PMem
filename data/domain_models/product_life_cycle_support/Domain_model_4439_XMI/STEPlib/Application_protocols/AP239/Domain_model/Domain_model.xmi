            <upperValue xmi:id="_18_4_1_65b021e_1677491451541_906893_202167" xmi:uuid="f8a3b82f-a05b-4d26-a39a-2dc7c4e8d15d" xmi:type="uml:LiteralUnlimitedNatural">
