        <packagedElement xmi:id="_18_4_1_65b021e_1677491291453_370973_96714" xmi:uuid="9128a902-6525-471c-8ad1-53b0a7969684" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491345575_594768_135087" xmi:uuid="b541148b-7808-46c6-914d-1e75318970da" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291453_370973_96714"/>
            <body>A TransformedGeometricModel is a type of GeometricModel that is the transformation result of another GeometricModel.</body>
          </ownedComment>
          <name>TransformedGeometricModel</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491345529_909923_135060" xmi:uuid="8d17f36c-a170-41b0-ad53-52f6a5c62b5e" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491437766_276119_194144" xmi:uuid="33f53a0b-cad1-4607-a953-7d77fb16bf11" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491345529_909923_135060"/>
              <body> the value of DerivedFrom shall either be of type GeometricRepresentationRelationshipWithCartesianTransformation or GeometricRepresentationRelationshipWithPlacementTransformation.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291453_370973_96714"/>
            <specification xmi:id="_18_4_1_65b021e_1677491437765_335977_194143" xmi:uuid="68235e75-03a6-4410-af28-df8bba77e09c" xmi:type="uml:OpaqueExpression">
              <body>self.DerivedFrom.oclIsTypeOf(GeometricRepresentationRelationshipWithCartesianTransformation) or self.DerivedFrom.oclIsTypeOf(GeometricRepresentationRelationshipWithPlacementTransformation)</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491345529_674624_135059" xmi:uuid="aaa73e08-bf18-4e1a-a905-8c8ffa8df843" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491291524_849681_96735"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491345576_59857_135089" xmi:uuid="bb104e0e-09d7-4cea-92ec-dfade842dcd3" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491437817_581999_194164" xmi:uuid="c43dcea5-fa73-49d8-a69b-24d6f4df7e5b" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491345576_59857_135089"/>
              <body> the set of transformations (specified by AxisPlacementOrTransformationSelect) that are needed to transform the source model or to transform this model further.</body>
            </ownedComment>
            <name>Items</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491291480_471763_96724"/>
            <upperValue xmi:id="_18_4_1_65b021e_1677491437817_469598_194163" xmi:uuid="f2639936-7d3a-4d6a-93f3-5fe93229d509" xmi:type="uml:LiteralUnlimitedNatural">
              <value>*</value>
            </upperValue>
