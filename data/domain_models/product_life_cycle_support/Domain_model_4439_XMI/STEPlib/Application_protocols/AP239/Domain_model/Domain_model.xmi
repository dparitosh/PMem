            <body>An AssignmentObjectRelationship is a relationship between two Assignment objects. </body>
          </ownedComment>
          <name>AssignmentObjectRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491304014_352372_108628" xmi:uuid="09fe0c6b-68eb-4f2c-8431-5461b6370bdb" xmi:type="uml:Constraint">
