          </ownedComment>
          <name>LISTREAL</name>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491345525_186157_135057" xmi:uuid="735a1552-31cc-4138-a357-7111039d5851" xmi:type="uml:Property">
