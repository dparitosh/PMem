            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491288162_833235_93496"/>
            <body>An InterfaceConnectorRelationship is a relationship between two InterfaceConnector objects. </body>
          </ownedComment>
          <name>InterfaceConnectorRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491319000_699278_120089" xmi:uuid="303f44da-7b43-4c88-b852-0a971a7e93a3" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491397830_39934_173293" xmi:uuid="d5c4110e-714c-46aa-9072-cfc75459f96c" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491319000_699278_120089"/>
              <body>the related InterfaceConnector and the relating InterfaceConnector shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <specification xmi:id="_18_4_1_65b021e_1677491397830_831476_173292" xmi:uuid="83c10eb6-d47a-484d-a934-a5c4e36b4063" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
