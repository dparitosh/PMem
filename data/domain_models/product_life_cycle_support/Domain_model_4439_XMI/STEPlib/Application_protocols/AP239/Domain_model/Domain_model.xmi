        </packagedElement>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491290740_72565_95951" xmi:uuid="b3f3ab92-7ac3-47ca-af56-f91c04b5f99a" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491339560_874010_131881" xmi:uuid="5050f03a-2f68-4c73-a9cd-e83ae976524d" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290740_72565_95951"/>
            <body>A DefinitionalPartViewUsage is a type of PartViewRelationship where all the elements of the Related PartView are then available to the Relating PartView. These elements are specifically all PartShapeElements, properties and NextAssemblyOccurrenceUsages on the Related PartView. These elements are either direct or indirect. A direct element references explicitly a PartView. An indirect element is available to a PartView via a DefinitionalPartViewUsage of another PartView. &lt;note&gt; A related PartView can be a definitional constituent of the relating PartView only once. &lt;/note&gt; All DefinitionalPartViewUsages shall describe an acyclic graph.</body>
          </ownedComment>
          <name>DefinitionalPartViewUsage</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491339419_835115_131803" xmi:uuid="9b0a5fa5-0f7e-4530-9d71-f6b2ae5bc8fc" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491430913_397852_189489" xmi:uuid="321c0e36-6a18-4d74-9f3a-c80ca6465718" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491339419_835115_131803"/>
              <body>the combination of Related and Relating shall be unique within a population of DefinitionalPartViewUsages. </body>
            </ownedComment>
            <name>UR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290740_72565_95951"/>
            <specification xmi:id="_18_4_1_65b021e_1677491430912_431915_189488" xmi:uuid="adfdd3d0-369d-4617-89f3-05f0833baed5" xmi:type="uml:OpaqueExpression">
              <body>DefinitionalPartViewUsage::allInstances()-&gt;isUnique(Sequence{Relating, Related})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491337182_451757_130625" xmi:uuid="b8003ccc-16e8-4b5a-af56-883282e0f92f" xmi:type="uml:Generalization">
