              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491319118_630278_120178"/>
              <body>the related InterfaceConnectorVersion and the relating InterfaceConnectorVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <specification xmi:id="_18_4_1_65b021e_1677491398017_416443_173406" xmi:uuid="fc6ef75e-0288-4208-a329-3e2f9e67dca3" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
