        <packagedElement xmi:id="_18_4_1_65b021e_1677491291789_157664_97028" xmi:uuid="3062a0b1-56db-405a-bc5e-6c59874dab2d" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491347977_198098_136341" xmi:uuid="f45048a3-b5bd-4c13-91b0-ce429c42a0e1" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291789_157664_97028"/>
            <body>A RequirementRelationship is a relationship between two Requirement objects. </body>
          </ownedComment>
          <name>RequirementRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491347854_801510_136273" xmi:uuid="016696b7-8dbc-43c8-afc0-939b6ea807ce" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491439902_111615_195657" xmi:uuid="744cd445-3131-458f-b2db-2bef00616156" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347854_801510_136273"/>
              <body>the related Requirement and the relating Requirement shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291789_157664_97028"/>
            <specification xmi:id="_18_4_1_65b021e_1677491439901_848999_195656" xmi:uuid="db4d34d4-d84a-4bdf-90d4-9927fe09bf59" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302558_857067_106762" xmi:uuid="8ce73853-654b-474f-ba6e-8c2b466ab03f" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491303025_595797_107566" xmi:uuid="a60d6b02-5cf7-4bdf-a43c-2fbf43fd919d" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286864_939778_92126"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491347977_70763_136342" xmi:uuid="c3f6110a-bc46-4997-afb8-d23f5c130ae0" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491440089_585084_195737" xmi:uuid="9110ce04-45a7-493f-8be7-17e4fb2810ad" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347977_70763_136342"/>
              <body> the meaning of the relationship. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for RequirementRelationship.</body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286823_588879_92112"/>
            <association xmi:idref="_18_4_1_65b021e_1677491291939_874850_97064"/>
            <redefinedProperty xmi:idref="_18_4_1_65b021e_1677491300521_872679_104723"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491347981_893649_136343" xmi:uuid="5aae19f5-0062-449c-84ec-dce1d62f7e4d" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491440091_250927_195741" xmi:uuid="c2bad679-ff6f-4a4b-8db9-7cf1f8884647" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347981_893649_136343"/>
              <body>one object of Requirement that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491291895_880430_97039"/>
            <association xmi:idref="_18_4_1_65b021e_1677491291942_272074_97070"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491347983_788271_136344" xmi:uuid="d93b355c-1b5e-462d-adee-24e01cfc6d6a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491440093_523088_195745" xmi:uuid="f808aee4-ac41-4de6-a2a5-a5355861a2c3" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491347983_788271_136344"/>
              <body>the other object of Requirement that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one Requirement in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
            <name>Related</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491291895_880430_97039"/>
