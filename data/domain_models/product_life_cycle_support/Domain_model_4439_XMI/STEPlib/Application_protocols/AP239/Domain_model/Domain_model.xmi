          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491312579_147962_115578" xmi:uuid="08576845-7f46-4eca-9647-b2f5667787c8" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491389800_743499_166757" xmi:uuid="2c3e3b64-92e4-4232-982e-6def7c7db1f9" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491312579_147962_115578"/>
              <body> the other object of Document that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt; If one Document in the relationship is dependent upon the other, this attribute shall be the dependent one.</body>
            </ownedComment>
