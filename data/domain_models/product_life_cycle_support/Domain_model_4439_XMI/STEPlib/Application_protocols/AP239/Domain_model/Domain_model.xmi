            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292712_670335_97744"/>
            <body>A RiskPerceptionRelationship is a relationship between two RiskPerception objects. </body>
          </ownedComment>
          <name>RiskPerceptionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491357031_538254_140588" xmi:uuid="aa499986-e38e-4ebc-8cb0-9fba8e8ee5b9" xmi:type="uml:Constraint">
