            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289166_129471_94427"/>
            <body>A ProjectRelationship is a relationship between two Project objects. </body>
          </ownedComment>
          <name>ProjectRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491326813_709570_124516" xmi:uuid="a50b3ee9-7431-4ec5-9b2f-e4b11865924e" xmi:type="uml:Constraint">
