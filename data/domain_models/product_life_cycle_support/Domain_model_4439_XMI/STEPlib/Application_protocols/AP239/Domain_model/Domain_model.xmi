        <packagedElement xmi:id="_18_4_1_65b021e_1677491293393_692747_98222" xmi:uuid="30f6c6e8-ab90-4c5c-a90a-fe021056f066" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491363656_350258_143443" xmi:uuid="a528939a-18d9-4e23-9bf9-656f6c88206f" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293393_692747_98222"/>
            <body>A TaskElementRelationship is a relationship between two TaskElement objects. &lt;example&gt;A TaskElementRelationship can be used to capture a time dependency that cuts across the structure of the method.&lt;/example&gt;</body>
          </ownedComment>
          <name>TaskElementRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491363610_411144_143418" xmi:uuid="7427f403-e832-4f02-a68d-dbfa9cc1aa91" xmi:type="uml:Constraint">
