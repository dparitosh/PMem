            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287786_359110_93055"/>
            <body>A ProductPlannedToRealized is a type of IndividualPartVersionRelationship that establishes that an actual artefact, represented by RealizedIndividualPart, has been realized as a version of a planned artefact, represented by PlannedIndividualPart.</body>
          </ownedComment>
          <name>ProductPlannedToRealized</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491313949_763410_116683" xmi:uuid="103381c3-361e-4247-b79c-618eaf3d4f2f" xmi:type="uml:Generalization">
