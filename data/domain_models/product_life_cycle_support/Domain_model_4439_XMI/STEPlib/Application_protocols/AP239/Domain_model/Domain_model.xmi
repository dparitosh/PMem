        <packagedElement xmi:id="_18_4_1_65b021e_1677491290913_436594_96166" xmi:uuid="fe3af0bf-ea55-498e-a64a-6fb2f7c58999" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491341268_857516_132933" xmi:uuid="81a109f6-ab6a-43f8-82f8-0946ba2a8149" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290913_436594_96166"/>
            <body>A ProductGroupRelationship is a relationship between two ProductGroup objects. &lt;note&gt; A subset is a common type of relationship. It indicates that one ProductGroup is a subset of another. &lt;/note&gt; </body>
          </ownedComment>
          <name>ProductGroupRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491341149_614640_132866" xmi:uuid="0640c974-62c3-4a9f-89aa-5f5e2aaf3c23" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491432926_383882_190890" xmi:uuid="99e0fcd5-e758-4239-ad1b-84410fe9c0a5" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491341149_614640_132866"/>
              <body>the related ProductGroup and the relating ProductGroup shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290913_436594_96166"/>
            <specification xmi:id="_18_4_1_65b021e_1677491432925_740448_190889" xmi:uuid="d795410c-da55-4acc-8f99-053954b815be" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
