    <packagedElement xmi:id="_18_4_1_65b021e_1677491284999_81147_89816" xmi:uuid="07abdf6e-678c-4f70-aa43-8c5745521b52" xmi:type="uml:Package">
      <ownedComment xmi:id="_18_4_1_65b021e_1677491285068_831896_89876" xmi:uuid="0591ee33-419c-48d5-a4dc-b1095652c2f0" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_65b021e_1677491284999_81147_89816"/>
        <body>The PositionAndSkills capability represents information concerning positions in organizations, skills required for a given position and skills of persons or organizations. &lt;br/&gt;The two figures below provides an overview of the capability, respectively for the modeling of positions and for the modeling of skills. &lt;figuresysml&gt;&lt;id&gt;_18_4_1_65b021e_1677491289793_202669_95033&lt;/id&gt;Position Block Definition Diagram of the PositionAndSkills CTC&lt;/figuresysml&gt; &lt;figuresysml&gt;&lt;id&gt;_18_4_1_65b021e_1677491289819_980578_95054&lt;/id&gt;Skills Block Definition Diagram of the PositionAndSkills CTC&lt;/figuresysml&gt;</body>
      </ownedComment>
      <name>PositionsAndSkills</name>
      <packagedElement xmi:id="_18_4_1_65b021e_1677491285063_298316_89873" xmi:uuid="0342fe79-5bd9-4b54-9f99-4e4afd64c65c" xmi:type="uml:Package">
        <name>Diagrams</name>
      </packagedElement>
      <packagedElement xmi:id="_18_4_1_65b021e_1677491285063_916921_89874" xmi:uuid="0cdbc2af-104a-49ed-ae0c-ddd2e8d5cf25" xmi:type="uml:Package">
        <name>ModelElements</name>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491290127_66012_95338" xmi:uuid="00442c94-a17d-4f1b-b540-d044c38ffce4" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491334408_604059_129028" xmi:uuid="63e4c7f8-202a-4730-8f7a-02dab5b90460" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290127_66012_95338"/>
            <body>A QualificationTypeRelationship is a relationship between two QualificationType objects. &lt;example&gt;Qualification X is a prerequisite for qualification Y.&lt;/example&gt; &lt;example&gt;Qualification X is equivalent to qualification Y.&lt;/example&gt;</body>
          </ownedComment>
          <name>QualificationTypeRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491334305_640385_128962" xmi:uuid="5641faeb-4dbe-4e61-9144-023dddd0771d" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491415112_807010_185605" xmi:uuid="a99ebcbc-1918-4a0c-aa2c-3b164c8f80ba" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491334305_640385_128962"/>
              <body>the related QualificationType and the relating QualificationType shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290127_66012_95338"/>
            <specification xmi:id="_18_4_1_65b021e_1677491415111_962052_185604" xmi:uuid="e302d62c-055c-4fb3-ac85-70bdad8b301e" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
