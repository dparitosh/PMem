          <ownedComment xmi:id="_18_4_1_65b021e_1677491308847_496456_112656" xmi:uuid="27b62f5c-ed5f-464d-9228-54c9aae7e453" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287222_793887_92581"/>
            <body>A PropertyDefinitionAssignmentRelationship is a relationship between two PropertyDefinitionAssignment objects. </body>
          </ownedComment>
          <name>PropertyDefinitionAssignmentRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491308771_599409_112593" xmi:uuid="015d0f33-f8b0-4bd0-b2dc-469bae6c1de8" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491384786_42511_163061" xmi:uuid="2c9e4f4d-24ea-4fb6-8f65-662f51d468b4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491308771_599409_112593"/>
              <body>the related PropertyDefinitionAssignment and the relating PropertyDefinitionAssignment shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287222_793887_92581"/>
            <specification xmi:id="_18_4_1_65b021e_1677491384786_490577_163060" xmi:uuid="87544a16-cdd8-4728-9a0c-1042c6b3cb22" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302559_380246_106785" xmi:uuid="bceb9e7b-fe30-49db-9415-1d0dd29ada49" xmi:type="uml:Generalization">
