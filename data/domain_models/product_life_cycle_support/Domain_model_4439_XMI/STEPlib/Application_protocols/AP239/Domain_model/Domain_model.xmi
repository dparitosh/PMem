        <packagedElement xmi:id="_18_4_1_65b021e_1677491287773_407528_93051" xmi:uuid="632c0237-efa0-4f46-9b58-c3a0c726c74e" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491315402_463230_117669" xmi:uuid="e126cf7e-171c-4899-b0e6-1f449a622a67" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287773_407528_93051"/>
            <body>An IndividualAssemblyRelationship is either a relation between two IndividualPartView objects representing a view of the assembly (both related objects shall share at least one ViewContext) or a relation between an IndividualPartView and a PartView with an optional quantity. &lt;example&gt;An individual vehicle can be represented as being filled with fuel using a PartView for the grade or supplier part of fuel and a Quantity to specify how much fuel has been used.&lt;/example&gt;</body>
          </ownedComment>
          <name>IndividualAssemblyRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491315289_293946_117596" xmi:uuid="81a76339-1a56-4b8c-b4cf-369859562628" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491393245_859842_169642" xmi:uuid="d791c85c-3723-496a-aa06-77c6287f960d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491315289_293946_117596"/>
              <body>the related IndividualPartView and the relating IndividualPartView shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287773_407528_93051"/>
            <specification xmi:id="_18_4_1_65b021e_1677491393245_519874_169641" xmi:uuid="485e939e-0806-4f3d-82e4-b98dfdd8a92a" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491315291_711217_117597" xmi:uuid="e4ac48f9-642d-4fa3-86e6-069692677a24" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491393247_968848_169645" xmi:uuid="ddb31f5f-0835-4815-b2d0-ebe8b85d780d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491315291_711217_117597"/>
              <body>either the quantity is undefined or the related is of type PartView.</body>
            </ownedComment>
            <name>WR2</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287773_407528_93051"/>
            <specification xmi:id="_18_4_1_65b021e_1677491393247_160286_169644" xmi:uuid="844de888-9e33-4bfa-9da8-e7ef45ee38c0" xmi:type="uml:OpaqueExpression">
              <body>Quantity.oclIsUndefined() or Related.oclIsTypeOf(PartView)</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_551467_106801" xmi:uuid="0ca94fa4-4001-42a6-8a37-882db864aca9" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
