        <packagedElement xmi:id="_18_4_1_65b021e_1677491289132_400704_94415" xmi:uuid="966e4102-ef5f-459c-85aa-2f30e3e03b3c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491326320_872264_124213" xmi:uuid="4a4a302c-46e9-4eca-9cc8-4fa69352b729" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289132_400704_94415"/>
            <body>A PersonInOrganizationRelationship is a relationship between two PersonInOrganization objects. &lt;example&gt;The owner of important product data leaves a company and therefore has a successor. This relationship can be built up using the PersonInOrganizationRelationship. &lt;/example&gt;</body>
          </ownedComment>
          <name>PersonInOrganizationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491326216_321989_124147" xmi:uuid="223d4cd7-6f56-4c5c-bf9a-3a053b50d965" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491406074_249086_179546" xmi:uuid="e8b02afe-92bf-4676-af3c-cebffc279f7d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491326216_321989_124147"/>
              <body>the related PersonInOrganization and the relating PersonInOrganization shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289132_400704_94415"/>
            <specification xmi:id="_18_4_1_65b021e_1677491406074_979986_179545" xmi:uuid="47bc8339-c16c-4747-93ac-948c0e884830" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302557_335598_106759" xmi:uuid="a04fc022-a46c-4cd6-b755-96df183afff2" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286797_646183_92084"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491321742_912784_121408" xmi:uuid="e7ecf86b-a120-4ab6-881a-0ce371506cb5" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491288814_615872_94197"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491322333_829754_121822" xmi:uuid="8e580452-730c-4e76-8eec-57ea413fdae7" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491400755_51743_175913" xmi:uuid="e507eda7-7c77-475a-9241-3c5f2c4a5353" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491322333_829754_121822"/>
              <body>the meaning of the PersonInOrganizationRelationship. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for PersonInOrganizationRelationship.</body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286823_588879_92112"/>
            <association xmi:idref="_18_4_1_65b021e_1677491288893_31354_94293"/>
