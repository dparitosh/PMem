          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329415_954874_126226" xmi:uuid="441e600a-a94d-4be8-949f-b53ca6d58299" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491409921_206543_182101" xmi:uuid="912cd3ed-d57b-4b9f-ab36-07a9b6a4065d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329415_954874_126226"/>
              <body> the object or set of objects external to the exchange file for which this object is a proxy. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for Envelope. The value of this attribute need not be specified.</body>
            </ownedComment>
            <name>SameAs</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287264_283355_92595"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491409921_422731_182102" xmi:uuid="4650e979-1b22-4bb4-b90c-0cc59e9757ab" xmi:type="uml:LiteralInteger"/>
            <upperValue xmi:id="_18_4_1_65b021e_1677491409921_2907_182100" xmi:uuid="f5d09bbc-5bba-456a-abbb-fa5aed79871e" xmi:type="uml:LiteralUnlimitedNatural">
              <value>*</value>
