          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491303360_879030_107994" xmi:uuid="e43a52cb-a002-4a1e-933b-f5cccddb756b" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491377970_682120_156796" xmi:uuid="604633a9-3d38-43f7-8208-9a57b9b34d9a" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491303360_879030_107994"/>
              <body> the meaning of the relationship. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for EffectivityRelationship.</body>
            </ownedComment>
            <name>RelationType</name>
            <visibility>public</visibility>
