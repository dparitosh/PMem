            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285839_133884_90708"/>
            <body>A CollectionMembership is an association of a CollectionView with an item (specified in CollectionMemberSelect) that represents a member of the collection. </body>
          </ownedComment>
          <name>CollectionMembership</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491298243_988969_103497" xmi:uuid="beb776a4-eea4-4244-a6f5-1a3c603fd5f1" xmi:type="uml:Constraint">
