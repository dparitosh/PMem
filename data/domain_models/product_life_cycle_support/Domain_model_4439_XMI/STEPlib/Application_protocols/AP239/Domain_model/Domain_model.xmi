        <packagedElement xmi:id="_18_4_1_65b021e_1677491292278_49695_97431" xmi:uuid="9915d84b-2a5f-4225-926c-3e6e359a1f4a" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491352257_930444_138364" xmi:uuid="f3be979f-6722-4dcb-8efb-78a98ccd40fa" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292278_49695_97431"/>
            <body>A RequiredResourceRelationship is a relationship between two RequiredResource objects. &lt;example&gt;"alternative" and "realized by" are examples of required resource relationship.&lt;/example&gt;</body>
          </ownedComment>
          <name>RequiredResourceRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491352117_504773_138289" xmi:uuid="e957025b-75d0-41b8-abfe-9880074964ed" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491445145_829451_198784" xmi:uuid="f7713802-c971-4e55-8d0e-55fa66f553c1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491352117_504773_138289"/>
              <body>the related RequiredResource and the relating RequiredResource shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292278_49695_97431"/>
            <specification xmi:id="_18_4_1_65b021e_1677491445144_102837_198783" xmi:uuid="424951b0-920b-4d87-8dc4-2ae4371869dc" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491312892_813503_115899" xmi:uuid="08d867c4-4846-455f-ad22-008c6fc0d686" xmi:type="uml:Generalization">
