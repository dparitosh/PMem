    <packagedElement xmi:id="_18_4_1_65b021e_1677491284994_708843_89807" xmi:uuid="4d0bd326-a586-4d26-9fad-fa0654f68346" xmi:type="uml:Package">
      <ownedComment xmi:id="_18_4_1_65b021e_1677491285021_482402_89842" xmi:uuid="615ac080-72b5-4f4c-a9e4-7be5143e5596" xmi:type="uml:Comment">
        <annotatedElement xmi:idref="_18_4_1_65b021e_1677491284994_708843_89807"/>
        <body>The Collection capability represents information concerning the management of sets of data. The capability allows the identification of a set of data and the items contained in the set; the relationships to other sets of data; and the assignment of the set of data to something to which it has relevance.&lt;br/&gt;The figure below provides an overview of the capability. &lt;figuresysml&gt;&lt;id&gt;_18_4_1_65b021e_1677491285724_747720_90633&lt;/id&gt;Block Definition Diagram of the Collection CTC&lt;/figuresysml&gt;</body>
      </ownedComment>
      <name>Collection</name>
      <packagedElement xmi:id="_18_4_1_65b021e_1677491285019_836611_89841" xmi:uuid="a04cc5e8-409b-4b4c-9845-c65f47b0d87b" xmi:type="uml:Package">
        <ownedComment xmi:id="_18_4_1_65b021e_1677491285886_390974_90799" xmi:uuid="c7b1ed6e-21de-4361-9715-9f3c5e4ca268" xmi:type="uml:Comment">
          <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285019_836611_89841"/>
          <body>A CollectionVersion is a revision of a Collection.</body>
        </ownedComment>
        <name>ModelElements</name>
        <packagedElement xmi:id="_18_4_1_65b021e_1677491285855_876038_90712" xmi:uuid="010359d2-561a-4483-b8b9-d29296ea4e9b" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491298455_900951_103883" xmi:uuid="109f660a-8a79-49e5-b915-54020d9da155" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285855_876038_90712"/>
            <body>A CollectionAssignment is an assignment of a CollectionView to an item (specified by CollectionMemberSelect) to which the CollectionView has relevance. </body>
          </ownedComment>
          <name>CollectionAssignment</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491298382_118779_103810" xmi:uuid="2a4288d9-fafa-40b3-8902-4c21c89c02f6" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491373963_954409_151914" xmi:uuid="ac05968f-12ac-45b0-804c-b336346a59d0" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491298382_118779_103810"/>
              <body>the AssignedCollection and the AssignedTo item shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285855_876038_90712"/>
            <specification xmi:id="_18_4_1_65b021e_1677491373962_332524_151913" xmi:uuid="a5b71a60-6c92-47cd-91c2-93ac4fcaea32" xmi:type="uml:OpaqueExpression">
              <body>self.AssignedCollection &lt;&gt; self.AssignedTo</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298382_339845_103809" xmi:uuid="3e48a388-e05a-4552-8123-40f21bbdcc8c" xmi:type="uml:Generalization">
