          <ownedEnd xmi:id="_18_4_1_65b021e_1677491340765_873816_132687" xmi:uuid="e58324ac-7f2f-4a95-87d0-62f4c2b6a424" xmi:type="uml:Property">
            <visibility>private</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491290877_145891_96142"/>
