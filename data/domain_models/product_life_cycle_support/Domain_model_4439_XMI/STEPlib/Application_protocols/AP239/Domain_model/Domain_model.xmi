        <packagedElement xmi:id="_18_4_1_65b021e_1677491290586_83602_95932" xmi:uuid="f6188067-3324-4d0f-947b-c689852713b9" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491336666_924938_130369" xmi:uuid="3b2c001e-eca5-4f7c-9bdc-3b40f769b8ed" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290586_83602_95932"/>
            <body>An AssemblyOccurrenceRelationship is a relationship between an AssemblyDefinition and a DefinitionBasedOccurrence representing a constituent of the assembly. The AssemblyDefinition and the PartView that serves as 'definition' of the DefinitionBasedOccurrence shall share at least one ViewContext. &lt;note&gt; The constituent can also be an assembly.&lt;/note&gt; An AssemblyOccurrenceRelationship is a type of ViewOccurrenceRelationship. Each AssemblyOccurrenceRelationship is a NextAssemblyOccurrenceUsage or a PromissoryAssemblyOccurrenceUsage. </body>
          </ownedComment>
          <name>AssemblyOccurrenceRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491336561_130479_130303" xmi:uuid="1ae8525a-3304-41dc-9111-a31afc12fe98" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491417509_60862_187151" xmi:uuid="b48390dd-6c8c-4bac-90aa-d13a40237400" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491336561_130479_130303"/>
              <body> if the placement references a GeometricRepresentationRelationshipWithPlacementTransformation, the attribute definitional shall evaluate to true.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290586_83602_95932"/>
            <specification xmi:id="_18_4_1_65b021e_1677491417509_942947_187150" xmi:uuid="4290e015-9ca4-44f4-90dd-d4ad8c4fb961" xmi:type="uml:OpaqueExpression">
              <body>self.Placement-&gt;forAll(p | p.oclIsTypeOf(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricRepresentationRelationshipWithPlacementTransformation) implies p.oclAsType(Core_model::RepresentationAndExternalElementReference::ModelElements::GeometricRepresentationRelationshipWithPlacementTransformation).Definitional = DataTypes::Boolean::True)</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491336561_166301_130300" xmi:uuid="2f648541-e9ec-47e6-b6e9-8480d96649a8" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491291817_334384_97032"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491336561_152445_130302" xmi:uuid="5b2b70ee-7d65-4daf-951b-a0e65ecc44ae" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491290594_167747_95933"/>
          </generalization>
          <generalization xmi:id="_18_4_1_65b021e_1677491303070_342380_107667" xmi:uuid="afee6c00-8740-4783-9e73-8067ece08966" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491286876_500521_92128"/>
          </generalization>
          <isAbstract>true</isAbstract>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491336667_204115_130371" xmi:uuid="683152b0-e84a-4b82-8953-9c284a66240a" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491417698_994226_187226" xmi:uuid="365c3e65-7066-4c98-bd09-4ce7ca982ae5" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491336667_204115_130371"/>
              <body>one object of AssemblyDefinition that is part of the relationship. &lt;note&gt;The semantics of this attribute are defined by the attribute RelationType.&lt;/note&gt;</body>
            </ownedComment>
            <name>Relating</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491290580_402114_95928"/>
            <association xmi:idref="_18_4_1_65b021e_1677491290802_667115_95979"/>
            <redefinedProperty xmi:idref="_18_4_1_65b021e_1677491336840_972663_130467"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491336670_132266_130372" xmi:uuid="4c29364a-fa47-4fc3-b6ba-ac31b51c3cb1" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491417699_981098_187230" xmi:uuid="6dc554cf-2e86-4ab5-a9cd-db3ff162abc1" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491336670_132266_130372"/>
              <body>the transformation information (specified by TransformationSelect) which are used to locate and orient the constituent in the coordinate space of the AssemblyDefinitions. In the case of a CartesianTransformation, the scale factor shall be omitted or set to 1.0. The value of this attribute need not be specified. &lt;example&gt;the set of GeometricModels that provide additional shapes for the PartView. These additional shapes do not define the primary geometry of a PartView. In the context of electrical wiring harness, a single GeometricModel of the definition of an Occurrence can be map to several models of a WiringHarnessAssemblyDesign:&lt;ul&gt;&lt;li&gt;GeometricModels for the 3D representation, &lt;/li&gt;&lt;li&gt;GeometricModels for the 2D representation (Formboard), &lt;/li&gt;&lt;li&gt;ConnectedEdgeWithLengthSetRepresentation for the topological structure of a harness.&lt;/li&gt;&lt;/ul&gt;&lt;/example&gt;</body>
            </ownedComment>
            <name>Placement</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491290582_990778_95929"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491417699_519738_187231" xmi:uuid="52da96f0-dd5b-433e-9793-71918387f475" xmi:type="uml:LiteralInteger"/>
            <association xmi:idref="_18_4_1_65b021e_1677491290820_426362_96016"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677509422760_472895_75448" xmi:uuid="fc5fcacb-4362-49b8-a4a8-6ab6b918326e" xmi:type="uml:Port">
