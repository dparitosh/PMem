              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491302357_683419_106568"/>
              <body>the related StateDefinition and the relating StateDefinition shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491286788_509592_92074"/>
            <specification xmi:id="_18_4_1_65b021e_1677491377186_783935_155702" xmi:uuid="44473cfe-a38d-4e21-8dde-fbb669a7476f" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
