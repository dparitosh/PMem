            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290700_56024_95945"/>
            <body>A PartRelationship is a relationship between two Part objects. </body>
          </ownedComment>
          <name>PartRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491338680_231337_131410" xmi:uuid="7ebfe60c-cd1a-4484-89df-aa115cc33012" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491429973_576419_188873" xmi:uuid="c6c91d55-1149-4fbd-9af6-97a400441d39" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491338680_231337_131410"/>
              <body>the related Part and the relating Part shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290700_56024_95945"/>
            <specification xmi:id="_18_4_1_65b021e_1677491429973_215988_188872" xmi:uuid="1695460d-3265-4754-a70f-327af00667b6" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491321631_564734_121295" xmi:uuid="2c58708c-b0b9-4f2a-9790-f1d370daaae6" xmi:type="uml:Generalization">
