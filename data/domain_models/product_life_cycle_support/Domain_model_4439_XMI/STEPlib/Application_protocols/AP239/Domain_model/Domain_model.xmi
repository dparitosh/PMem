            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285620_651151_90416"/>
            <body>A BreakdownElementViewRelationship is a relationship between two BreakdownElementView objects. &lt;note&gt; Such a relationship can exist between two BreakdownElementView instances of the same BreakdownElementVersion instance or of different BreakdownElementVersion instances.&lt;/note&gt;</body>
          </ownedComment>
          <name>BreakdownElementViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491295901_615726_101025" xmi:uuid="c57295ff-7405-4182-b8a8-23f073249d59" xmi:type="uml:Constraint">
