        <packagedElement xmi:id="_18_4_1_65b021e_1677491285833_154009_90706" xmi:uuid="261d026c-8549-41f8-8145-9b53d53fcb2a" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491298214_234867_103467" xmi:uuid="72c3c6ea-9427-4c20-bb38-e4c9f056ce1b" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491285833_154009_90706"/>
            <body>A CollectionView represents a characterization of a CollectionVersion relevant in one or more application domains and for one or more life-cycle stages. &lt;example&gt;A set of data relevant to the design of the SS Titanic and a set of data relevant to the as-built description of the SS Titanic might be represented as two instances of CollectionView.&lt;/example&gt;</body>
          </ownedComment>
          <name>CollectionView</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491298103_374497_103366" xmi:uuid="6a54c6be-8c17-41e7-a658-37fe922747fa" xmi:type="uml:Constraint">
