              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491333257_294541_128347"/>
              <body>the related Position and the relating Position shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290066_301259_95305"/>
