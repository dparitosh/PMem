          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491329413_605884_126225" xmi:uuid="9dfb7074-352b-4e33-9d75-d67594028af3" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491409919_943844_182097" xmi:uuid="695cba98-c139-4aa9-b3c4-2fe34e75cc14" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491329413_605884_126225"/>
              <body> the classifications of the Envelope. This information is defined by reference data. The ReferenceData tab provides definitions of the Reference Data currently standardized for Envelope. The value of this attribute need not be specified.</body>
