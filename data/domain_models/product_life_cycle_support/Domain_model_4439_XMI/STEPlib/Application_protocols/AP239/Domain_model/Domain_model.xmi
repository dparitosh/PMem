        <packagedElement xmi:id="_18_4_1_65b021e_1677491289760_840893_94998" xmi:uuid="5d43373a-432f-4345-973d-9cc106d49674" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491331531_631961_127409" xmi:uuid="1ec15c95-cd0c-422d-af5d-4ecc6bef26f7" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289760_840893_94998"/>
            <body>A SequencingRelationship is a specialization of SchemeEntryRelationship. It defines a specific type of sequencing and relative timing for two SchemeEntry objects. &lt;example&gt;Specific types of sequencing could include start-start or finish-start.&lt;/example&gt;</body>
          </ownedComment>
          <name>SequencingRelationship</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491331501_414927_127382" xmi:uuid="e85ae31a-f332-4c40-824c-ffd960286d4c" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491289762_926961_94999"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491331531_256578_127410" xmi:uuid="ad65d2ec-0608-4c8f-bf2f-312acc63e5a4" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491411964_161557_183472" xmi:uuid="23fa814e-4910-47d1-adf7-58559688cb87" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491331531_256578_127410"/>
              <body>the amount of time, either positive or negative, between the Related attribute and the Relating attribute in the sequence. The value of this attribute need not be specified. &lt;note&gt;For a positive timeLag, the Relating attribute is the later entry in time.&lt;/note&gt;</body>
            </ownedComment>
            <name>TimeLag</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491287322_1785_92648"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491411965_208153_183473" xmi:uuid="9e85ebe0-8905-4228-a7be-68ebddb123dd" xmi:type="uml:LiteralInteger"/>
          </ownedAttribute>
