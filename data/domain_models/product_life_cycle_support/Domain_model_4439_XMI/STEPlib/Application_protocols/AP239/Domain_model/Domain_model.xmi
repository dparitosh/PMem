        <packagedElement xmi:id="_18_4_1_65b021e_1677491291191_759223_96333" xmi:uuid="ff56e9b9-b05c-4bfa-a7f1-d9d1ae58e715" xmi:type="uml:Association">
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491344969_183274_134697"/>
          <memberEnd xmi:idref="_18_4_1_65b021e_1677491342676_381588_133589"/>
          <ownedEnd xmi:id="_18_4_1_65b021e_1677491344969_183274_134697" xmi:uuid="abc00f70-1d3b-4506-9c99-67b6a65535e1" xmi:type="uml:Property">
            <type xmi:idref="_18_4_1_65b021e_1677491291060_176136_96281"/>
