        <packagedElement xmi:id="_18_4_1_65b021e_1677491292334_417081_97453" xmi:uuid="1569ecc5-176e-47eb-8cfd-444e38f541bd" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491353317_130750_138859" xmi:uuid="38b2b0e0-0cca-4815-a471-a6d7902c654a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292334_417081_97453"/>
            <body>A ResourceEventRelationship is a relationship between two ResourceEvent objects. &lt;example&gt;A managed resource relationship can be classified as "realized by" or "replaces".&lt;/example&gt;</body>
          </ownedComment>
          <name>ResourceEventRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491353169_906263_138782" xmi:uuid="b64942c5-fd6e-4dbb-8f45-8b48c8a5ea93" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491446521_47982_199508" xmi:uuid="936b6196-ba92-4f60-9510-23f52329fe76" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491353169_906263_138782"/>
              <body>the related ResourceEvent and the relating ResourceEvent shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292334_417081_97453"/>
            <specification xmi:id="_18_4_1_65b021e_1677491446521_263036_199507" xmi:uuid="ec25fd53-473d-4191-a9c3-88e860e8d735" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
