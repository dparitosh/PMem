        <packagedElement xmi:id="_18_4_1_65b021e_1677491292425_104584_97481" xmi:uuid="1a75d969-86d4-4fc4-aea9-a70afe0be9fc" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491354893_504750_139583" xmi:uuid="bebfad03-e4b2-4413-a301-149fb7195891" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292425_104584_97481"/>
            <body>A ResourceItemRelationship is a relationship between two ResourceItem objects. &lt;example&gt;The relationship between a product and a package can be classified as "Preferred".&lt;/example&gt; </body>
          </ownedComment>
          <name>ResourceItemRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491354728_252934_139502" xmi:uuid="367c718f-d61b-4691-a2f8-c661e8f20062" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491448625_393121_200649" xmi:uuid="35cf9f4f-fd68-4f06-b10e-5d99f233d4ea" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491354728_252934_139502"/>
              <body>the related ResourceItem and the relating ResourceItem shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491292425_104584_97481"/>
            <specification xmi:id="_18_4_1_65b021e_1677491448625_931989_200648" xmi:uuid="18bf0076-6602-431c-9ad3-541aa2d059ab" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
