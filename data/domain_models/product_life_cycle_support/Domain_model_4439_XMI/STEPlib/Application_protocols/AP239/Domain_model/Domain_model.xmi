              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491304014_352372_108628"/>
              <body>the related and the relating object shall be of same type.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491286975_25783_92398"/>
            <specification xmi:id="_18_4_1_65b021e_1677491378612_844304_158123" xmi:uuid="fe07d09c-e5ff-4881-862f-417ef3a062df" xmi:type="uml:OpaqueExpression">
              <body>self.Relating.oclType() = self.Related.oclType()</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
