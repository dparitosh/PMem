        <packagedElement xmi:id="_18_4_1_65b021e_1677491287331_22926_92650" xmi:uuid="db446a62-3dfd-40a3-ad94-48d89a76d69c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491310741_689548_114198" xmi:uuid="e4e1201e-c3ca-4fbf-8ff9-8100ae78776c" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287331_22926_92650"/>
            <body>A TimeIntervalEffectivity is a type of Effectivity for which the domain of applicability is defined as a Duration. Depending on which of the StartDefinition and EndDefinition inherited attributes are specified, the actual domain of time defined by a TimeIntervalEffectivity is: &lt;ul&gt;&lt;li&gt;the time interval that starts at the start date or event;&lt;/li&gt; &lt;li&gt;the time interval that ends at the end date or event.&lt;/li&gt;&lt;/ul&gt;</body>
          </ownedComment>
          <name>TimeIntervalEffectivity</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491310705_286555_114169" xmi:uuid="8588f64f-8494-41c6-b66b-46401153519d" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491387500_541873_165018" xmi:uuid="9286c47b-c138-4274-a4d0-c5ba92600741" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491310705_286555_114169"/>
              <body> one of the inherited attributes startDefinition or endDefinition shall be set.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287331_22926_92650"/>
            <specification xmi:id="_18_4_1_65b021e_1677491387500_976047_165017" xmi:uuid="75e0d40c-15f4-4c7e-a6e3-c6483f44d02b" xmi:type="uml:OpaqueExpression">
              <body>not(self.StartDefinition.oclIsUndefined()) xor not(self.EndDefinition.oclIsUndefined())</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491305239_255379_109638" xmi:uuid="c4fe56d2-8db8-4b12-9e55-38994699c68e" xmi:type="uml:Generalization">
            <general xmi:idref="_18_4_1_65b021e_1677491287032_806271_92429"/>
          </generalization>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491303647_350777_108268" xmi:uuid="38ba2cca-5c3b-4de8-8702-0aaaad377be9" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491378127_581811_157565" xmi:uuid="5db7e605-f5d4-406e-b082-6d521178760d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491303647_350777_108268"/>
              <body> the Duration that defines the domain of validity.</body>
            </ownedComment>
