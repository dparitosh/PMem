            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289612_818098_94858"/>
            <body>An ObservationRelationship is a relationship between two Observation objects. </body>
          </ownedComment>
          <name>ObservationRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491330403_470987_126748" xmi:uuid="cfa4da10-a256-4f28-9024-09fcf18ddeb6" xmi:type="uml:Constraint">
