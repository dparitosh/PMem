            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287587_58277_92849"/>
            <body>A DocumentVersionRelationship is a relationship between two DocumentVersion objects. </body>
          </ownedComment>
          <name>DocumentVersionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491313493_611672_116335" xmi:uuid="70d6a488-e5b7-40e3-9e25-66b9b6724ff9" xmi:type="uml:Constraint">
