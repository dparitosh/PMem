            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287779_469793_93052"/>
            <body>An IndividualPartRelationship is a relationship between two IndividualPart objects. </body>
          </ownedComment>
          <name>IndividualPartRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491315432_261350_117684" xmi:uuid="c11ab416-df7a-4d67-aaa1-0905f39758e3" xmi:type="uml:Constraint">
