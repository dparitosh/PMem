          <ownedComment xmi:id="_18_4_1_65b021e_1677491313843_954092_116661" xmi:uuid="ac2a9dc9-e1ab-4a4c-ac64-f7a96e0ad1ae" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287632_477674_92948"/>
            <body>A PartialDocumentAssignment is an assignment of an identified portion of a document to an item (specified by DocumentAssignmentSelect). &lt;example&gt;Clause 5 of a Contract document, dealing with project administration, can be assigned to a Project.&lt;/example&gt;</body>
          </ownedComment>
          <name>PartialDocumentAssignment</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491312946_964901_115955" xmi:uuid="5f396905-4ebd-4c51-b0a2-46eb81f7c821" xmi:type="uml:Generalization">
