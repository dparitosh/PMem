              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491327907_651382_125267"/>
              <body>the related Justification and the relating Justification shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289254_985127_94541"/>
