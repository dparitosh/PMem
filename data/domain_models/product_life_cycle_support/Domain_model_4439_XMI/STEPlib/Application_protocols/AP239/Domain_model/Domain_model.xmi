              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491361946_849002_142642"/>
              <body>the related SystemView and the relating SystemView shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491293154_124969_98040"/>
