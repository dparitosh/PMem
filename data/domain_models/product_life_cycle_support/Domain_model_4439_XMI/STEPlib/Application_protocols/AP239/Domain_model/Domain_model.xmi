        <packagedElement xmi:id="_18_4_1_65b021e_1677491293455_230698_98252" xmi:uuid="f27a41f8-fdbd-4fed-8bad-9a23f64b2691" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491364762_376741_144069" xmi:uuid="7476446a-cb8a-44ab-a9cf-45a50adcd20b" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293455_230698_98252"/>
            <body>A RepeatUntil is a type of LoopingElement. It invokes repetitions of the RepeatedElement inherited from LoopingElement until the specified condition is satisfied. The element being repeated shall be executed at least once and the condition tested after the first execution. </body>
          </ownedComment>
          <name>RepeatUntil</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491364598_913330_143956" xmi:uuid="869ab5bb-cd38-4001-acee-776d94fefeb6" xmi:type="uml:Generalization">
