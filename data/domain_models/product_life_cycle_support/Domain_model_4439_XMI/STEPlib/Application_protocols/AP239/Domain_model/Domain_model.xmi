        <packagedElement xmi:id="_18_4_1_65b021e_1677491289762_926961_94999" xmi:uuid="ac9e49b7-c600-439b-8b53-f885711a9106" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491331573_331548_127442" xmi:uuid="67d53f64-d950-41fd-83b8-534f210c4aa6" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289762_926961_94999"/>
            <body>A SchemeEntryRelationship is a specialization of ActivityMethodRelationship that is a relationship between two SchemeEntry objects. A SchemeEntryRelationship can exist between SchemeEntry objects that relate to different Schemes or between different SchemeEntry objects of the same Scheme. &lt;note&gt; The SchemeEntryRelationship provides the facility to relate entries included in Plans or Schedules in different ways. By applying classifications on the SchemeEntryRelationship it can be used for different purposes.&lt;/note&gt; &lt;example&gt;Decomposition, Dependency, and sequencing are examples of kinds of relationships possible between schema entries.&lt;/example&gt;</body>
          </ownedComment>
          <name>SchemeEntryRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491331546_696208_127417" xmi:uuid="7624e466-6e92-4036-8e23-ff872488f285" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491411974_187924_183493" xmi:uuid="a56b5b02-7dbb-4144-961b-674ae16574eb" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491331546_696208_127417"/>
              <body>the related SchemeEntry and the relating SchemeEntry shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289762_926961_94999"/>
            <specification xmi:id="_18_4_1_65b021e_1677491411974_179750_183492" xmi:uuid="9040886e-f1d0-43bd-8bfe-4b37bef849d7" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
