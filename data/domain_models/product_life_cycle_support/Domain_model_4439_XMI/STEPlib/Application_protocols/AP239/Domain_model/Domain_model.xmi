              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491297924_900024_103139"/>
              <body>the related Collection and the relating Collection shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491285827_831645_90699"/>
