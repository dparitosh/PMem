            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290695_242608_95944"/>
            <body>An OccurrenceRelationship is a relationship between two Occurrence objects. </body>
          </ownedComment>
          <name>OccurrenceRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491338557_783103_131337" xmi:uuid="ea4e90d3-c148-43c4-bb80-97d081f44e07" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491429816_947920_188781" xmi:uuid="1040cf08-1282-4a0e-b679-fec69d18d32d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491338557_783103_131337"/>
              <body>the related Occurrence and the relating Occurrence shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290695_242608_95944"/>
            <specification xmi:id="_18_4_1_65b021e_1677491429816_167216_188780" xmi:uuid="992ac9ff-0cbd-44d9-bb95-49a0f0a499cf" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491303024_336349_107556" xmi:uuid="1f6cab13-4fdb-4a4e-a50e-e85f7367fd2e" xmi:type="uml:Generalization">
