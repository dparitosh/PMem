        <packagedElement xmi:id="_18_4_1_65b021e_1677491293453_862143_98251" xmi:uuid="f5d9431b-38dd-44de-b204-122c4c9ebe00" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491364719_191147_144040" xmi:uuid="bc69dbb8-01f1-4e4f-9efd-a3419ab0ed33" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491293453_862143_98251"/>
            <body>A RepeatWhile is a type of LoopingElement. It invokes repetitions of the RepeatedElement inherited from LoopingElement while the specified condition is satisfied. The test condition shall be evaluated prior to invoking the method and can result in the LoopingElement not being executed at all. </body>
          </ownedComment>
          <name>RepeatWhile</name>
          <generalization xmi:id="_18_4_1_65b021e_1677491364598_240185_143955" xmi:uuid="a35f2d8e-b7a3-4803-9f91-36707b7111d5" xmi:type="uml:Generalization">
