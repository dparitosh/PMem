        <packagedElement xmi:id="_18_4_1_65b021e_1677491290669_727583_95942" xmi:uuid="9cf4a71d-ea97-4037-be3a-3749443e09af" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491338246_55291_131197" xmi:uuid="e0687a5c-abc5-4969-b5c2-9f50b3e7318a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290669_727583_95942"/>
            <body>A ViewContext is a grouping of an application domain and a life-cycle stage. It identifies a universe of discourse suitable for the description of parts. &lt;note&gt; Requirements and vocabularies vary among the industrial activity fields. This entity intends to identify such domains. &lt;/note&gt;</body>
          </ownedComment>
          <name>ViewContext</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491337995_293543_131063" xmi:uuid="76c6a63a-d58c-45ad-8b6b-c5454897724e" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491429133_648934_188353" xmi:uuid="680f1fce-cfe0-4d47-9bfe-f25d55d13531" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491337995_293543_131063"/>
              <body>the combination of the ApplicationDomain and the LifeCycleStage shall be unique. </body>
            </ownedComment>
            <name>UR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290669_727583_95942"/>
            <specification xmi:id="_18_4_1_65b021e_1677491429133_629603_188352" xmi:uuid="a0577a17-2417-4b5d-98a8-497a7bfc79ca" xmi:type="uml:OpaqueExpression">
              <body>ViewContext::allInstances()-&gt;isUnique(Sequence{ApplicationDomain, LifeCycleStage})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
