              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491305539_491280_109869"/>
              <body>the related Descriptor and the relating Descriptor shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287050_70475_92437"/>
            <specification xmi:id="_18_4_1_65b021e_1677491380840_675538_159817" xmi:uuid="ced58170-da2b-4955-aa36-7ebb73edac3e" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
