            <redefinedProperty xmi:idref="_18_4_1_65b021e_1677491338662_582256_131404"/>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491339604_428158_131913" xmi:uuid="40b6dff0-c3ed-4f1b-8e90-b2813601b6c1" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491431145_535875_189619" xmi:uuid="f392fefc-fc65-46a4-a9b1-f0790dafe81d" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491339604_428158_131913"/>
              <body> the object (specified by OccurrenceUsageContextSelect) that identifies the context in which the replacement is applicable. In the case where the usageContext refers to a ProcessOperationInputOrOutput, the relating Occurrence shall be referred by the element attribute of the ProcessOperationInputOrOutput. In the case where usageContext refers to a ViewOccurrenceRelationship, the relating Occurrence shall be referred by the related attribute of the ViewOccurrenceRelationship. In the case where usageContext refers to a BreakdownElementRealization, the relating Occurrence object of the ReplacedUsageRelationship shall be referred to as related by the BreakdownElementRealization.</body>
            </ownedComment>
            <name>UsageContext</name>
            <visibility>public</visibility>
