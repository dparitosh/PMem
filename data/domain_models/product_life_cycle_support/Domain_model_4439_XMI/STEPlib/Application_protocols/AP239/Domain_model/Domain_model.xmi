            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287271_316020_92597"/>
            <body>A ProxyRelationship is a relationship between two Proxy objects. </body>
          </ownedComment>
          <name>ProxyRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491309492_243983_113181" xmi:uuid="51d8629f-14bd-48de-9745-b489f01ecd97" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491385817_861985_163803" xmi:uuid="ca6bc489-34e8-433d-bce1-240c445f3527" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491309492_243983_113181"/>
              <body>the related Proxy and the relating Proxy shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287271_316020_92597"/>
            <specification xmi:id="_18_4_1_65b021e_1677491385817_320898_163802" xmi:uuid="255db398-09fd-4c67-b63e-bf5436d107dc" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302561_985792_106820" xmi:uuid="3f4444fc-b101-4e91-b6cb-ee5393e585b8" xmi:type="uml:Generalization">
