            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287333_680464_92651"/>
            <body>A TimeIntervalRelationship is a relationship between two TimeInterval objects.</body>
          </ownedComment>
          <name>TimeIntervalRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491310744_998453_114203" xmi:uuid="cb459ed7-ae9c-4e7a-a356-788146391006" xmi:type="uml:Constraint">
