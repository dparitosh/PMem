          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491294565_596251_99425" xmi:uuid="d3a6cf88-f382-476e-bfe5-ee7c10db4ea4" xmi:type="uml:Property">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491367959_728210_146156" xmi:uuid="7467a123-da81-4be0-ac7c-2eb419303d6c" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491294565_596251_99425"/>
              <body> the DateTimeString when the ActualActivity finished. The value of this attribute need not be specified. &lt;note&gt;In general, the absence of this date cannot be used to infer that the activity is continuing, only that the end of the activity has not yet been recorded.&lt;/note&gt; A more detailed history of the progress of an activity can be recorded by applying states to the activity, in this case the meaning of these states should be defined through local business rules.</body>
            </ownedComment>
            <name>ActualEndDate</name>
            <visibility>public</visibility>
            <type xmi:idref="_18_4_1_65b021e_1677491286811_950678_92095"/>
            <lowerValue xmi:id="_18_4_1_65b021e_1677491367959_8054_146157" xmi:uuid="ed677df9-d2ed-4d50-a835-3f4538ae2a2d" xmi:type="uml:LiteralInteger"/>
            <aggregation>composite</aggregation>
          </ownedAttribute>
          <ownedAttribute xmi:id="_18_4_1_65b021e_1677491294566_626750_99426" xmi:uuid="63d425d3-1241-4cc5-9dd0-fc88b0d36012" xmi:type="uml:Property">
