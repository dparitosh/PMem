              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491349892_701797_137243"/>
              <body>the related RequirementVersion and the relating RequirementVersion shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491291917_979290_97040"/>
            <specification xmi:id="_18_4_1_65b021e_1677491442497_895724_197220" xmi:uuid="01e230ab-6e12-402f-8415-fc0ab84df1ff" xmi:type="uml:OpaqueExpression">
