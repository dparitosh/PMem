            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287593_390460_92851"/>
            <body>A DocumentDefinitionRelationship is a relationship between two DocumentDefinition objects. </body>
          </ownedComment>
          <name>DocumentDefinitionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491313635_682524_116450" xmi:uuid="7d9a043e-0ee4-4ace-af5d-e6f138b7f9af" xmi:type="uml:Constraint">
