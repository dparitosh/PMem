            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287050_70475_92437"/>
            <body>A DescriptorRelationship is a relationship between two Descriptor objects. </body>
          </ownedComment>
          <name>DescriptorRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491305539_491280_109869" xmi:uuid="5b0c7192-0e16-44ba-80d1-0a0ddc7d10d7" xmi:type="uml:Constraint">
