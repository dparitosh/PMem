              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491318600_355630_119812"/>
              <body>the related InterfaceSpecification and the relating InterfaceSpecification shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <specification xmi:id="_18_4_1_65b021e_1677491397294_105195_172911" xmi:uuid="73a20fae-2c4d-44f0-bdf9-b1a4167aba1a" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
