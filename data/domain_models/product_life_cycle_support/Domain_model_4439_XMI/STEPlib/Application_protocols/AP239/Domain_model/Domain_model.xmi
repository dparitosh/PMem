        <packagedElement xmi:id="_18_4_1_65b021e_1677491289000_147574_94352" xmi:uuid="937a2eaa-77b0-4a0a-8886-acd56ced2d08" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491324300_885236_122967" xmi:uuid="826c156a-cb78-4d6b-80ea-daa226b3e928" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491289000_147574_94352"/>
            <body>A ContractRelationship is a relationship between two different Contract objects. &lt;example&gt;A sub-contract can be related to the main contract with the customer.&lt;/example&gt;</body>
          </ownedComment>
          <name>ContractRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491324178_247392_122894" xmi:uuid="8ac1b049-6380-4d01-b35f-817deb732f48" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491403128_311108_177625" xmi:uuid="cf66ccba-5af0-46c5-b9c0-21842ca1fcef" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491324178_247392_122894"/>
              <body>the related Contract and the relating Contract shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491289000_147574_94352"/>
            <specification xmi:id="_18_4_1_65b021e_1677491403127_457641_177624" xmi:uuid="5d3e522e-b940-4e95-89ae-8623b9aafe57" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302562_951830_106827" xmi:uuid="43d284ef-ffd8-4077-8fc5-dede167d3b4c" xmi:type="uml:Generalization">
