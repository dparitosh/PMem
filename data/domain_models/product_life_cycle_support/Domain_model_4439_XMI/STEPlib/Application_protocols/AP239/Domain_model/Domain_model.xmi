        <packagedElement xmi:id="_18_4_1_65b021e_1677491287249_771293_92590" xmi:uuid="a526de3d-3213-49fe-8890-12f3a93d7865" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491309287_310611_113021" xmi:uuid="d01f65dc-584f-4b32-84ef-e659842683c0" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491287249_771293_92590"/>
            <body>A PropertyValueAssignmentRelationship is a relation between two PropertyValueAssignment objects. </body>
          </ownedComment>
          <name>PropertyValueAssignmentRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491309202_483041_112954" xmi:uuid="1d862971-f5c5-42a0-b440-e6918a7530b6" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491385455_425320_163543" xmi:uuid="d7d76bae-5d39-43d1-ace9-ff6a98f63291" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491309202_483041_112954"/>
              <body>the related PropertyValueAssignment and the relating PropertyValueAssignment shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287249_771293_92590"/>
            <specification xmi:id="_18_4_1_65b021e_1677491385455_237548_163542" xmi:uuid="eeb88644-e9cc-42ad-b517-7285a8f98231" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491302560_661406_106804" xmi:uuid="1ec947b2-616d-41f5-853c-99019b941cb5" xmi:type="uml:Generalization">
