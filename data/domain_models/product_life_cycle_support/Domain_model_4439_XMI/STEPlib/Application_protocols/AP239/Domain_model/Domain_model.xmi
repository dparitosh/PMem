            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491291806_315875_97030"/>
            <body>A RequirementViewRelationship is a relationship between two RequirementView objects. </body>
          </ownedComment>
          <name>RequirementViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491348211_131066_136456" xmi:uuid="5d11d667-acf3-49f4-b4f5-7bb29f1a7908" xmi:type="uml:Constraint">
