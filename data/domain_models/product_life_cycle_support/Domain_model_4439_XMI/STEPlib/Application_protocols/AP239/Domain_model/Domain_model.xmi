              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491308645_794594_112506"/>
              <body>the combination of the AssignedPropertyDefinition and the AssignedTo shall be unique.</body>
            </ownedComment>
            <name>UR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491287213_943790_92579"/>
            <specification xmi:id="_18_4_1_65b021e_1677491384593_776829_162931" xmi:uuid="cb5d5079-71ef-43fd-a7b6-52e002dee132" xmi:type="uml:OpaqueExpression">
              <body>PropertyDefinitionAssignment::allInstances()-&gt;isUnique(Sequence{AssignedTo, AssignedPropertyDefinition})</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
