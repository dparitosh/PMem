        <packagedElement xmi:id="_18_4_1_65b021e_1677491290162_898708_95346" xmi:uuid="2270d48a-aeb3-4072-92e5-3ebd27490e2c" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491335088_341262_129401" xmi:uuid="28cc6a08-ac74-4619-b08a-4de6b07387c1" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290162_898708_95346"/>
            <body>A TypeOfPersonDefinitionRelationship is a relationship between two TypeOfPersonDefinition objects. &lt;example&gt;"alternate" and "superseded by" are examples of TypeOfPersonDefinitionRelationships.&lt;/example&gt;</body>
          </ownedComment>
          <name>TypeOfPersonDefinitionRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491334986_971852_129334" xmi:uuid="7a421e54-d618-4318-82a9-76228d86ba12" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491415939_73807_186179" xmi:uuid="ce442cc2-577b-4403-b6bb-aa0b290bc0b4" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491334986_971852_129334"/>
              <body>the related TypeOfPersonDefinition and the relating TypeOfPersonDefinition shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290162_898708_95346"/>
            <specification xmi:id="_18_4_1_65b021e_1677491415939_406457_186178" xmi:uuid="be84d9c0-8223-4e9b-816e-ed583b3c50ab" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
