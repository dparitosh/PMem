        <packagedElement xmi:id="_18_4_1_65b021e_1677491290168_281491_95348" xmi:uuid="01b29d40-cc88-48d2-9194-4bc6c84233a9" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491335221_397912_129478" xmi:uuid="458fc5f6-d97f-47f7-88c9-e7d2bf763505" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491290168_281491_95348"/>
            <body>An ExperienceTypeRelationship is a relationship between two ExperienceType objects. &lt;example&gt;Ten years programming experience made up of five years C++ programming experience and five years Java programming experience.&lt;/example&gt;</body>
          </ownedComment>
          <name>ExperienceTypeRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491335116_741147_129412" xmi:uuid="35712575-5e8b-4bdc-9b02-79fa5f234cea" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491416106_686056_186284" xmi:uuid="732dcaff-96f9-4b34-a7aa-78b718fc1682" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491335116_741147_129412"/>
              <body>the related ExperienceType and the relating ExperienceType shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491290168_281491_95348"/>
            <specification xmi:id="_18_4_1_65b021e_1677491416106_749854_186283" xmi:uuid="5e6c8a85-1b39-42a9-a7ab-9bfa13261fc2" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
          <generalization xmi:id="_18_4_1_65b021e_1677491298331_838921_103707" xmi:uuid="3b90daab-4ac0-489c-a0a8-c6f12593bcef" xmi:type="uml:Generalization">
