            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491286675_642503_91856"/>
            <body>An ObservedEnvironmentViewRelationship is a relationship between two ObservedEnvironmentView objects. </body>
          </ownedComment>
          <name>ObservedEnvironmentViewRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491300597_116799_104806" xmi:uuid="e835babf-4f91-4518-b3e1-4e7a4358cd33" xmi:type="uml:Constraint">
            <ownedComment xmi:id="_18_4_1_65b021e_1677491375204_157399_153353" xmi:uuid="e4abb3b1-994c-447d-bf3f-db7dc2443029" xmi:type="uml:Comment">
              <annotatedElement xmi:idref="_18_4_1_65b021e_1677491300597_116799_104806"/>
              <body>the related ObservedEnvironmentView and the relating ObservedEnvironmentView shall be different.</body>
            </ownedComment>
            <name>WR1</name>
            <constrainedElement xmi:idref="_18_4_1_65b021e_1677491286675_642503_91856"/>
            <specification xmi:id="_18_4_1_65b021e_1677491375203_650932_153352" xmi:uuid="3d672360-320c-4a65-8d72-29bd77207cad" xmi:type="uml:OpaqueExpression">
              <body>self.Relating &lt;&gt; self.Related</body>
              <language>OCL2.0</language>
            </specification>
          </ownedRule>
