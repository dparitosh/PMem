        <packagedElement xmi:id="_18_4_1_65b021e_1677491292344_869811_97456" xmi:uuid="2691ad68-884a-404c-b755-7f2072f22f3f" xmi:type="uml:Class">
          <ownedComment xmi:id="_18_4_1_65b021e_1677491353500_905380_138946" xmi:uuid="e6cf874b-fdec-4544-8600-d3b161e5005a" xmi:type="uml:Comment">
            <annotatedElement xmi:idref="_18_4_1_65b021e_1677491292344_869811_97456"/>
            <body>A ManagedResourceRelationship is a relationship between two ManagedResource objects. &lt;example&gt;A managed resource relationship can be classified as "Alternative" or "Preferred".&lt;/example&gt;</body>
          </ownedComment>
          <name>ManagedResourceRelationship</name>
          <ownedRule xmi:id="_18_4_1_65b021e_1677491353355_780899_138872" xmi:uuid="7d08dbb1-0682-436e-97f4-dc789a3eebdc" xmi:type="uml:Constraint">
