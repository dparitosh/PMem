# Copy to .env.local or configure through your process manager. Never commit secrets.
# Use a customer-managed, least-privilege role; do not use PostgreSQL's postgres administrator.
DEPO_DATABASE_URL=postgresql://depo_app:<password>@<postgres-host>:5432/<database>?sslmode=require
DEPO_MAX_INGEST_BYTES=524288000
# Absolute durable path shared by every DEPO service and worker on this VM.
ARTIFACT_STORAGE=C:\DEPO\data\artifacts
# Optional trusted-internal token mode only; do not use for Entra deployments.
# API_TOKEN=
# API_ACTOR=ui-user
DEPO_DATABASE_SCHEMA=semantic
# Bound remote PostgreSQL VM connection attempts; accepted range is 1-60 seconds.
DEPO_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
# external: customer-managed database; service: exact Windows service name;
# portable: explicit initialized cluster paths. No automatic service selection.
DEPO_POSTGRES_MODE=external
DEPO_POSTGRES_SERVICE_NAME=
DEPO_POSTGRES_BIN_DIR=
DEPO_POSTGRES_DATA_DIR=
# API-key authentication for bootstrap and production. Generate distinct keys
# for reading and approval. `disabled` is loopback-only.
AUTH_MODE=token
# Optional UTC deadline; per-key <KEY>_EXPIRES_AT overrides this value.
DEPO_TOKEN_EXPIRES_AT=
# true requires server-assigned <KEY>_ACTOR for read/approval identities.
DEPO_REQUIRE_TOKEN_ACTOR=false
# Optional unified routing: local or gateway. Blank preserves explicit URLs.
DEPO_ROUTING_MODE=local
# Reachable application VM hostname/IP; loopback is for browsing on that VM.
DEPO_LOCAL_SERVICE_HOST=127.0.0.1
# Gateway API root, without a service suffix or /api/v1.
DEPO_API_GATEWAY_URL=
# Optional server APIM subscription credential; never compile into frontend.
DEPO_APIM_SUBSCRIPTION_KEY=
# Optional custom suffix, e.g. DEPO_GATEWAY_GRAPH_PATH=engineering/graph
DEPO_ALLOW_INSECURE_LOCAL_AUTH=false
# Required when AUTH_MODE=entra: comma-separated private IP addresses of the
# API gateway/reverse proxy that is permitted to forward identity headers.
DEPO_TRUSTED_GATEWAY_IPS=<gateway-private-ip>
# API-key profile. Generate distinct long random values and keep this file
# outside source control. Never compile keys into browser environment variables.
DATA_PRODUCT_APPROVAL_TOKEN=<long-random-secret>
AGENTIC_APPROVAL_TOKEN=<long-random-secret>
ARTIFACT_RETENTION_APPROVAL_TOKEN=<long-random-secret>
DATA_JOB_EXECUTION_TOKEN=<long-random-secret>
DATA_JOB_APPROVAL_TOKEN=<long-random-secret>
CEIM_PUBLISH_APPROVAL_TOKEN=<long-random-secret>
GRAPH_PUBLICATION_TOKEN=<different-long-random-secret>
INGESTION_WRITE_TOKEN=<different-long-random-secret>
CATALOG_SERVICE_TOKEN=<different-long-random-secret>
CEIM_RESOLUTION_APPROVAL_TOKEN=<long-random-secret>
SPEED_PATH_APPROVAL_TOKEN=<long-random-secret>
SPEED_EVENT_TOKEN=<long-random-secret>
SPARQL_FEDERATION_APPROVAL_TOKEN=<long-random-secret>
VOCABULARY_APPROVAL_TOKEN=<long-random-secret>
ONTOLOGY_APPROVAL_TOKEN=<long-random-secret>
GRAPH_READ_TOKEN=<long-random-secret>
ALLOWED_ORIGINS=https://<customer-frontend-host>
OSLC_BASE_URL=https://<customer-api-host>
# HTTP is also supported, e.g. http://10.10.12.21:8015 for direct OSLC access.
# Use the API base; OSLC resource paths append /oslc automatically.
# TRS change events use the PostgreSQL control plane by default. File mode is
# only for isolated development/tests and is not suitable for scaled services.
OSLC_TRS_STORE=postgres
# Bind to a private network interface behind the gateway, or retain 127.0.0.1 for local use.
DEPO_SERVICE_HOST=127.0.0.1
# Customer-managed graph store. TLS is the production default. A trusted private
# on-premises deployment may deliberately set TLS mode and encryption to disabled.
NEO4J_URI=neo4j+s://<neo4j-host>
NEO4J_AUTH_MODE=token
NEO4J_TLS_MODE=required
NEO4J_ENCRYPTED=true
NEO4J_TLS_VERIFY=true
NEO4J_USER=depo_graph
NEO4J_PASS=<password>
NEO4J_DATABASE=ontology
# Maximum seconds allowed for a canonical Neo4j publication request.
GRAPH_PUBLICATION_TIMEOUT_SECONDS=180

# Run governed jobs outside the HTTP API in the durable pipeline worker.
# `inline` is retained only for isolated developer compatibility.
DEPO_PIPELINE_EXECUTION_MODE=worker
DEPO_PIPELINE_LEASE_SECONDS=300
DEPO_PIPELINE_POLL_SECONDS=5
DEPO_PIPELINE_WORKER_STALE_SECONDS=60
# Spark is optional. The durable worker remains enabled when this is false and
# continues to execute approved non-Spark jobs through PostgreSQL leases.
DEPO_SPARK_ENABLED=false
DEPO_SPARK_NEO4J_ENABLED=false
DEPO_SPARK_POSTGRES_ENABLED=false
DEPO_PIPELINE_SCHEDULER_ENABLED=false
DEPO_SPARK_POSTGRES_DRIVER_JAR=C:\DEPO\drivers\postgresql-42.7.13.jar

# Agentic service: launcher supplies local /api/v1 URLs for token-mode bootstrap.
# For Entra, set ALL ten *_SERVICE_URL / DATA_CATALOG_URL values to the matching
# HTTPS APIM API bases including /api/v1; the gateway must preserve Authorization.
# AGENTIC_SERVICE_URL=https://<gateway>/agentic/api/v1
# GRAPH_SERVICE_URL=https://<gateway>/graph/api/v1
AGENTIC_TOOL_TIMEOUT_SECONDS=30
AGENTIC_RUN_TIMEOUT_SECONDS=300
LLM_REQUEST_TIMEOUT_SECONDS=30
# Server-owned companion sessions: idle expiry and fixed maximum lifetime.
AGENT_SESSION_IDLE_SECONDS=1800
AGENT_SESSION_MAX_SECONDS=86400
COMPANION_RETRIEVAL_TIMEOUT_SECONDS=15
AGENTIC_MAX_UPLOAD_BYTES=26214400
# Governed document OCR. `auto` uses an available Tesseract runtime first and
# otherwise an installed EasyOCR provider. Raw OCR evidence is never rewritten.
DOCUMENT_OCR_PROVIDER=auto
DOCUMENT_OCR_LANGUAGES=en
DOCUMENT_MAX_OCR_PAGES=100
DOCUMENT_EASYOCR_MODEL_DIR=C:\DEPO\models\easyocr
DOCUMENT_EASYOCR_ALLOW_DOWNLOAD=false
DOCUMENT_OCR_GPU=false
# Ontology agents are deterministic by default. Enable only for review-only
# suggestions after configuring the existing Ollama or Azure provider.
ONTOLOGY_AGENT_LLM_ENABLED=false
# Offline Ollama server and exact installed model name; no automatic downloads.
USE_LLM=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Alternatively set OLLAMA_API_URL to the API root or full /api/chat URL.
# Remove OLLAMA_BASE_URL if OLLAMA_API_URL points to a different server.
# OLLAMA_API_URL=http://ollama-server:11434/api/chat
# APIM proxies use Ocp-Apim-Subscription-Key; leave blank for host-based selection.
OLLAMA_API_KEY=
OLLAMA_API_KEY_HEADER=
EMBED_MODEL_NAME=nomic-embed-text:latest
LLM_MODEL_NAME=llama3:latest
COMPANION_LLM_ENABLED=false
ONTOLOGY_AGENT_ALLOWED_ROOTS=data;ontology;backend/test_data;ontology_uploads
ONTOLOGY_AGENT_MAX_BYTES=26214400
# Optional graph-native conversation and approved-mapping memory. Assign a
# unique customer/project scope whenever Neo4j is shared.
DEPO_TENANT_ID=<customer-id>
DEPO_PROJECT_ID=<project-id>
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_SCOPE=<customer-id>:<project-id>
AGENT_MEMORY_QUERY_TIMEOUT=5
AGENT_MEMORY_RETENTION_DAYS=30
AGENT_PROMPT_VERSION=1
AGENT_FAILURE_RATE_ALERT_THRESHOLD=0.2
AGENT_STUCK_RUN_SECONDS=900
DT_AGENT_ENABLED=false
DT_AGENT_GATEWAY_URL=
DT_AGENT_GATEWAY_TOKEN=
OSLC_REMOTE_ENABLED=false
OSLC_REMOTE_BASE_URL=
OSLC_REMOTE_TOKEN=
OSLC_CLIENT_TIMEOUT_SECONDS=20

# Maximum RDF/OWL registration upload bytes (25 MiB).
ONTOLOGY_MAX_UPLOAD_BYTES=26214400

# New CEIM publications use tenant/project/source-system scoped IDs.
# legacy is an explicit compatibility option; never mix unrelated source systems.
DEPO_CEIM_IDENTITY_MODE=scoped

# Frontend listener defaults to DEPO_SERVICE_HOST when this is blank.
# Explicit start-depo-frontend.ps1 -BindHost/-Port arguments override these.
DEPO_FRONTEND_HOST=
DEPO_FRONTEND_PORT=3000

# Central incoming API-key validation. Schema setup bootstraps missing keys once.
# Existing keys are never reset by reinstall. environment retains legacy mode.
DEPO_CREDENTIAL_STORE=postgres
