# Optional Apache Spark settings: merge the required values into .env.local.
# This example is not loaded automatically. Do not overwrite existing credentials.
# Current bounded jobs execute synchronously in the dedicated pipeline service;
# the Spark session is initialized lazily, not in unrelated API services.
DEPO_SPARK_ENABLED=false
# Optional read-side integration. Neo4j Spark connector 6.0 requires Spark
# 4.0–4.1 and Scala 2.13. Use the official coordinate below only with that
# supported runtime; do not put credentials in source control.
DEPO_SPARK_NEO4J_ENABLED=false
DEPO_SPARK_NEO4J_PACKAGE=org.neo4j.connectors:spark:6.0.0-s_2.13
# Optional read-only Spark JDBC path to the same PostgreSQL VM configured by
# DEPO_DATABASE_URL. Provision and verify the official JDBC driver separately.
DEPO_SPARK_POSTGRES_ENABLED=false
# Windows example: C:\DEPO\drivers\postgresql-42.7.13.jar
# Linux example: /opt/depo/drivers/postgresql-42.7.13.jar
DEPO_SPARK_POSTGRES_DRIVER_JAR=<absolute-path-to-postgresql-jdbc-jar>
# DEPO_HADOOP_HOME is required only for native Windows Spark. Do not set it on Linux.
DEPO_HADOOP_HOME=<windows-only-absolute-path-to-approved-hadoop-helpers>
# Windows: C:\DEPO\runtime\spark-4.1.2-bin-hadoop3
# Linux: /opt/depo/runtime/spark-4.1.2-bin-hadoop3
DEPO_SPARK_HOME=<absolute-path-to-spark-4.1.2-bin-hadoop3>
# Windows: C:\Program Files\Java\jdk-21; Linux: /usr/lib/jvm/java-21-openjdk-amd64
DEPO_JAVA_HOME=<absolute-path-to-jdk-21>
DEPO_SPARK_MASTER=local[2]
# Windows: C:\DEPO\data\spark-output; Linux: /var/lib/depo/spark-output
DEPO_SPARK_OUTPUT_ROOT=<absolute-path-to-spark-output>
DEPO_PIPELINE_SCHEDULER_ENABLED=false
DEPO_PIPELINE_EXECUTION_MODE=worker
DEPO_PIPELINE_LEASE_SECONDS=300
DEPO_PIPELINE_POLL_SECONDS=5
DEPO_PIPELINE_WORKER_STALE_SECONDS=60
